@using System.Security.Claims
@using HRM.Services
@inherits LayoutComponentBase
@implements IDisposable
@inject AuthenticationStateProvider AuthStateProvider
@inject MenuStateService MenuService
@inject JsonLocalizationService L
@inject LanguageState LangState
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor

<link href="~/bootstrap/bootstrap.min.css" rel="stylesheet">
<link href="css/app.css" rel="stylesheet">
@* Required *@
<MudThemeProvider Theme="HumanOkTheme.Theme" />
<MudPopoverProvider />

@* Needed for dialogs *@
<MudDialogProvider />

@* Needed for snackbars *@
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@(() => _drawerOpen = !_drawerOpen)" />
        <MudLink Href="/" Class="d-flex align-center text-decoration-none ml-2">
            <MudImage Src="images/humanok3_small.jpg" Alt="HumanOk Logo" Height="36" Class="rounded" />
            <MudText Typo="Typo.h6" Class="ml-3" Style="color:inherit;">HumanOk</MudText>
        </MudLink>
        <MudSpacer />
        @if (L.AvailableLanguages.Count > 1)
        {
            <MudMenu Icon="@Icons.Material.Filled.Language" Color="Color.Inherit" Class="mr-2"
                Label="@LanguageCatalog.AllLabels.GetValueOrDefault(L.CurrentLanguage, L.CurrentLanguage)">
                @foreach (var code in L.AvailableLanguages)
                {
                    <MudMenuItem OnClick="@(() => L.SetLanguageAsync(code))">@LanguageCatalog.AllLabels.GetValueOrDefault(code, code)</MudMenuItem>
                }
            </MudMenu>
        }
        @if (_isAuthenticated)
        {
            <MudText Typo="Typo.body2" Class="mr-3" Style="opacity:.85;">@_userName</MudText>
            <MudButton Href="/logout" Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Logout">@L.Translate("Logout")</MudButton>
        }
        else
        {
            <MudButton Href="/login" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Login">@L.Translate("Login")</MudButton>
        }
    </MudAppBar>

