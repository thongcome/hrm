@using System.Security.Claims
@using HRM.Services
@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthStateProvider
@inject MenuStateService MenuService
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor

<link href="~/bootstrap/bootstrap.min.css" rel="stylesheet">
<link href="css/app.css" rel="stylesheet">
@* Required *@
<MudThemeProvider Theme="HumanOkTheme.Theme" />
<MudPopoverProvider />

@* Needed for dialogs *@
<MudDialogProvider />

@* Needed for snackbars *@
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@(() => _drawerOpen = !_drawerOpen)" />
        <MudLink Href="/" Class="d-flex align-center text-decoration-none ml-2">
            <MudImage Src="images/humanok3_small.jpg" Alt="HumanOk Logo" Height="36" Class="rounded" />
            <MudText Typo="Typo.h6" Class="ml-3" Style="color:inherit;">HumanOk</MudText>
        </MudLink>
        <MudSpacer />
        @if (_isAuthenticated)
        {
            <MudText Typo="Typo.body2" Class="mr-3" Style="opacity:.85;">@_userName</MudText>
            <MudButton Href="/logout" Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Logout">ออกจากระบบ</MudButton>
        }
        else
        {
            <MudButton Href="/login" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Login">เข้าสู่ระบบ</MudButton>
        }
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="0" Variant="DrawerVariant.Responsive" ClipMode="DrawerClipMode.Always">
        <MudNavMenu>
            <MudNavLink Href="/dev/pages" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.ListAlt" IconColor="Color.Error">
                รวมลิงก์ทั้งหมด (ชั่วคราว)
            </MudNavLink>

            @if (MenuService.AllowedMenus.Any())
            {
                <MudNavGroup Title="เมนูตามสิทธิ์" Icon="@Icons.Material.Filled.VerifiedUser" Expanded="true">
                    @foreach (var menu in MenuService.AllowedMenus.OrderBy(m => m.menuorder))
                    {
                        <MudNavLink Href="@menu.url" Icon="@(string.IsNullOrEmpty(menu.icon) ? Icons.Material.Filled.ChevronRight : menu.icon)">
                            @menu.menuname
                        </MudNavLink>
                    }
                </MudNavGroup>
            }

            <MudNavGroup Title="เงินเดือน (Payroll)" Icon="@Icons.Material.Filled.Payments" Expanded="true">
                <MudNavLink Href="/hrpayrolldasboard" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>
                <MudNavLink Href="/hremployees" Icon="@Icons.Material.Filled.People">พนักงาน (payrolls)</MudNavLink>
                <MudNavLink Href="/pay/employees" Icon="@Icons.Material.Filled.Badge">ข้อมูลพนักงาน / จัดการพนักงาน (Payroll)</MudNavLink>
                <MudNavLink Href="/payrollprocess" Icon="@Icons.Material.Filled.PlaylistPlay">ประมวลผลเงินเดือน</MudNavLink>
                <MudNavLink Href="/AIpayrollprocess" Icon="@Icons.Material.Filled.AutoAwesome">AI ประมวลผลเงินเดือน</MudNavLink>
                <MudNavLink Href="/pay/runs" Icon="@Icons.Material.Filled.RequestQuote">เงินเดือน (ใหม่)</MudNavLink>
                <MudNavLink Href="/pay/adhoc" Icon="@Icons.Material.Filled.PostAdd">รายการเฉพาะกิจ</MudNavLink>
                <MudNavLink Href="/pay/admin/payslip-settings" Icon="@Icons.Material.Filled.Receipt">ตั้งค่าสลิป</MudNavLink>
                <MudNavLink Href="/pay/admin/periods" Icon="@Icons.Material.Filled.CalendarMonth">จัดการงวดเงินเดือน</MudNavLink>
                <MudNavLink Href="/pay/reports/labor-cost-trend" Icon="@Icons.Material.Filled.TrendingUp">แนวโน้มต้นทุนแรงงาน</MudNavLink>
                <MudNavLink Href="/pay/reports/pay-item-breakdown" Icon="@Icons.Material.Filled.PieChart">สัดส่วนรายรับ-รายหัก</MudNavLink>
            </MudNavGroup>

            <MudNavGroup Title="เวลาเข้างาน (Attendance)" Icon="@Icons.Material.Filled.AccessTime" Expanded="false">
                <MudNavLink Href="/att/settings" Icon="@Icons.Material.Filled.Tune">ตั้งค่าเวลาเข้างาน</MudNavLink>
                <MudNavLink Href="/att/shifts" Icon="@Icons.Material.Filled.Schedule">จัดการกะ</MudNavLink>
                <MudNavLink Href="/att/import" Icon="@Icons.Material.Filled.UploadFile">นำเข้า Log เครื่องสแกน</MudNavLink>
                <MudNavLink Href="/att/report" Icon="@Icons.Material.Filled.Assessment">รายงานเวลาเข้างาน</MudNavLink>
            </MudNavGroup>

            <MudNavGroup Title="ระบบ / อื่นๆ (เก่า)" Icon="@Icons.Material.Filled.Settings" Expanded="false">
                <MudNavLink Href="/income" Icon="@Icons.Material.Filled.AttachMoney">Income Mng.</MudNavLink>
                <MudNavLink Href="/masterdata" Icon="@Icons.Material.Filled.Storage">Master Data</MudNavLink>
                <MudNavLink Href="/ot" Icon="@Icons.Material.Filled.MoreTime">OT</MudNavLink>
                <MudNavLink Href="/sc_users" Icon="@Icons.Material.Filled.ManageAccounts">User Mng</MudNavLink>
                <MudNavLink Href="/onlinereport" Icon="@Icons.Material.Filled.Description">report</MudNavLink>
                <MudNavLink Href="/hrpayrolls" Icon="@Icons.Material.Filled.Folder">hrpayrolls</MudNavLink>
                <MudNavLink Href="/admin/audit-log" Icon="@Icons.Material.Filled.History">Audit Log ระบบ</MudNavLink>
            </MudNavGroup>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="content px-4 py-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<footer>
    <p>© 2025 HumanOk. All rights reserved.</p>
</footer>

@code {
    private bool _drawerOpen = true;
    private bool _isAuthenticated;
    private string _userName = "";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        _isAuthenticated = user.Identity?.IsAuthenticated ?? false;
        _userName = user.Identity?.Name ?? "";
    }
}
