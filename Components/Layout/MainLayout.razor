@inherits LayoutComponentBase

<link href="~/bootstrap/bootstrap.min.css" rel="stylesheet">
<link href="css/app.css" rel="stylesheet">

<div class="page">
    <main>
        <!-- แถบ Header -->
        <div class="container-fluid py-2" style="background-color:aqua;">
            <div class="row align-items-center">
                <!-- โลโก้อยู่ซ้าย -->
                <div class="col-auto">
                    <a href="/" class="d-flex align-items-center text-decoration-none">
                        <img src="images/humanok3_small.jpg" alt="HumanOk Logo" class="me-2" height="40">
                        <span class="text-dark fw-bold fs-5">HumanOk</span>
                    </a>
                </div>

                <!-- เมนูนำทางอยู่ขวา -->
                <div class="col text-end">
                    <nav class="d-inline-flex gap-4">
                        <NavLink class="nav-link custom-nav text-dark fw-bold" href="/sc_roles">Role</NavLink>
                        <NavLink class="nav-link custom-nav text-dark fw-bold" href="/employees">Employee Management</NavLink>
                        <NavLink class="nav-link custom-nav text-dark fw-bold" href="/payroll">Payroll</NavLink>
                        <NavLink class="nav-link custom-nav text-dark fw-bold" href="/attendance">Attendance</NavLink>
                        <NavLink class="nav-link custom-nav text-dark fw-bold" href="/leave">Leave Management</NavLink>
                        <NavLink class="nav-link custom-nav text-dark fw-bold" href="/training">Training</NavLink>
                        <NavLink class="nav-link custom-nav text-dark fw-bold" href="/reports">Reports</NavLink>
                        <NavLink class="nav-link custom-nav text-dark fw-bold" href="/logout">Log Out</NavLink>
                    </nav>
                </div>
            </div>
        </div>

        <!-- เนื้อหาหลัก -->
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<footer class="bg-gray-900 text-black text-center py-4 mt-10">
    <p>© 2025 HumanOk. All rights reserved.</p>
</footer>
