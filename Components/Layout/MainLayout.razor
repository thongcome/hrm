@using System.Security.Claims
@using HRM.Services
@inherits LayoutComponentBase
@implements IDisposable
@inject AuthenticationStateProvider AuthStateProvider
@inject JsonLocalizationService L
@inject LanguageState LangState
@inject HRM.Services.ThemeService ThemeSvc
@inject HRM.Services.ThemeState ThemeStateNotifier
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@using HRM.Components.Layout

<link href="~/bootstrap/bootstrap.min.css" rel="stylesheet">
<link href="css/app.css" rel="stylesheet">
@* Required *@
<MudThemeProvider Theme="ThemeSvc.CurrentTheme.Theme" IsDarkMode="ThemeSvc.IsDarkMode" />
<MudPopoverProvider />

@* Needed for dialogs *@
<MudDialogProvider />

@* Needed for snackbars *@
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@(() => _drawerOpen = !_drawerOpen)" />
        <MudLink Href="/" Class="d-flex align-center text-decoration-none ml-2">
            <MudImage Src="images/humanok3_small.jpg" Alt="HumanOk Logo" Height="36" Class="rounded" />
            <MudText Typo="Typo.h6" Class="ml-3" Style="color:inherit;">HumanOk</MudText>
        </MudLink>
        <MudSpacer />
        <MudMenu Icon="@Icons.Material.Filled.Palette" Color="Color.Inherit" Class="mr-1"
            Label="@ThemeSvc.CurrentTheme.Label">
            @foreach (var option in ThemeCatalog.Options)
            {
                <MudMenuItem OnClick="@(() => ThemeSvc.SetThemeAsync(option.Id))">@option.Label</MudMenuItem>
            }
        </MudMenu>
        <MudIconButton Icon="@(ThemeSvc.IsDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
            Color="Color.Inherit" Class="mr-2" Title="@(ThemeSvc.IsDarkMode ? "โหมดสว่าง" : "โหมดมืด")"
            OnClick="@(() => ThemeSvc.SetDarkModeAsync(!ThemeSvc.IsDarkMode))" />
        @if (L.AvailableLanguages.Count > 1)
        {
            <MudMenu Icon="@Icons.Material.Filled.Language" Color="Color.Inherit" Class="mr-2"
                Label="@LanguageCatalog.AllLabels.GetValueOrDefault(L.CurrentLanguage, L.CurrentLanguage)">
                @foreach (var code in L.AvailableLanguages)
                {
                    <MudMenuItem OnClick="@(() => L.SetLanguageAsync(code))">@LanguageCatalog.AllLabels.GetValueOrDefault(code, code)</MudMenuItem>
                }
            </MudMenu>
        }
        @if (_isAuthenticated)
        {
            <MudText Typo="Typo.body2" Class="mr-3" Style="opacity:.85;">@_userName</MudText>
            <MudButton Href="/logout" Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Logout">@L.Translate("Logout")</MudButton>
        }
        else
        {
            <MudButton Href="/login" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Login">@L.Translate("Login")</MudButton>
        }
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="0" Variant="DrawerVariant.Responsive" ClipMode="DrawerClipMode.Always">
        <DbNavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="content px-4 py-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<footer>
    <p>© @DateTime.Now.Year HumanOk. All rights reserved.</p>
</footer>

@code {
    private bool _drawerOpen = true;
    private bool _isAuthenticated;
    private bool _hasEssAccess;
    private string _userName = "";
    private HashSet<string> _allowedMenuCodes = new();

    // Menucodes come from the "menu" claims ScUserClaimsPrincipalFactory
    // attaches at sign-in (sc_user_role -> sc_role_menu -> sc_menu, refreshed
    // fresh from the DB every login) — the same claim [Authorize(Policy =
    // "Menu:XXX")] checks on every page. Gating each nav link against the
    // identical claim set means the sidebar never shows a link the click
    // itself would then block.
    private bool Has(string menuCode) => _allowedMenuCodes.Contains(menuCode);
    private bool HasAny(params string[] menuCodes) => menuCodes.Any(_allowedMenuCodes.Contains);

    // MainLayout can't inherit LocalizedComponentBase (already inherits
    // LayoutComponentBase — C# allows only one base class), so it wires the
    // same subscribe/re-render/dispose directly here instead.
    protected override void OnInitialized()
    {
        LangState.OnLanguageChangedAsync += HandleLanguageChangedAsync;
        ThemeStateNotifier.OnThemeChangedAsync += HandleLanguageChangedAsync;
    }

    private Task HandleLanguageChangedAsync() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        LangState.OnLanguageChangedAsync -= HandleLanguageChangedAsync;
        ThemeStateNotifier.OnThemeChangedAsync -= HandleLanguageChangedAsync;
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        _isAuthenticated = user.Identity?.IsAuthenticated ?? false;
        // Prefer the real first+last name (fullname claim, added by
        // ScUserClaimsPrincipalFactory from sc_user) over Identity.Name,
        // which is the ApplicationUser's UserName/email — often a synthetic
        // "{loginname}@local.humanok" placeholder that means nothing to the
        // person looking at the screen.
        _userName = user.FindFirstValue("fullname");
        if (string.IsNullOrWhiteSpace(_userName))
            _userName = user.Identity?.Name ?? "";
        _hasEssAccess = user.HasClaim("menu", "ESS_ACCESS");
        _allowedMenuCodes = user.FindAll("menu").Select(c => c.Value).ToHashSet();
    }
}
