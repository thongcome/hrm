@code {
    private bool _drawerOpen = true;
    private bool _isAuthenticated;
    private bool _hasEssAccess;
    private string _userName = "";
    private HashSet<string> _allowedMenuCodes = new();

    // Menucodes come from the "menu" claims ScUserClaimsPrincipalFactory
    // attaches at sign-in (sc_user_role -> sc_role_menu -> sc_menu, refreshed
    // fresh from the DB every login) — the same claim [Authorize(Policy =
    // "Menu:XXX")] checks on every page. Gating each nav link against the
    // identical claim set means the sidebar never shows a link the click
    // itself would then block.
    private bool Has(string menuCode) => _allowedMenuCodes.Contains(menuCode);
    private bool HasAny(params string[] menuCodes) => menuCodes.Any(_allowedMenuCodes.Contains);

    // MainLayout can't inherit LocalizedComponentBase (already inherits
    // LayoutComponentBase — C# allows only one base class), so it wires the
    // same subscribe/re-render/dispose directly here instead.
    protected override void OnInitialized() => LangState.OnLanguageChangedAsync += HandleLanguageChangedAsync;

    private Task HandleLanguageChangedAsync() => InvokeAsync(StateHasChanged);

    public void Dispose() => LangState.OnLanguageChangedAsync -= HandleLanguageChangedAsync;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        _isAuthenticated = user.Identity?.IsAuthenticated ?? false;
        // Prefer the real first+last name (fullname claim, added by
        // ScUserClaimsPrincipalFactory from sc_user) over Identity.Name,
        // which is the ApplicationUser's UserName/email — often a synthetic
        // "{loginname}@local.humanok" placeholder that means nothing to the
        // person looking at the screen.
        _userName = user.FindFirstValue("fullname");
        if (string.IsNullOrWhiteSpace(_userName))
            _userName = user.Identity?.Name ?? "";
        _hasEssAccess = user.HasClaim("menu", "ESS_ACCESS");
        _allowedMenuCodes = user.FindAll("menu").Select(c => c.Value).ToHashSet();
    }
}
