@* DbNavMenu — database-driven drawer navigation.
   Renders the sidebar from sc_menu rows (isactive && isshow), gated by the
   "menu" claims that ScUserClaimsPrincipalFactory stamps at sign-in from
   sc_role_menu. Same claim set [Authorize(Policy = "Menu:XXX")] checks on
   every page, so the drawer never shows a link the click itself would block.

   Lifecycle note: this component initializes once per circuit, and a circuit
   is always created AFTER login (the /login endpoint does a full HTTP
   redirect, which tears down the old circuit), so no re-query on auth-state
   change is needed — a fresh login always gets a fresh OnInitializedAsync. *@
@using System.Reflection
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using HRM.Models
@using HRM.Services
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject JsonLocalizationService L
@inject LanguageState LangState
@inject ThemeService ThemeSvc
@inject ThemeState ThemeSt
@implements IDisposable

@if (_isAuthenticated)
{
    <!-- data-menu-style picks which of the 3 spacing/grouping treatments in
         DbNavMenu.razor.css applies — a live switcher (MainLayout's "รูปแบบเมนู"
         menu), not a single hardcoded fix, per CEO preference (13 ก.ย. 2569)
         for offering style variants rather than picking one. -->
    <div data-menu-style="@ThemeSvc.MenuStyleId">
        <MudNavMenu>
            @foreach (var node in _tree)
            {
                @if (node.Children.Count > 0)
                {
                    @* Group row: rendered as a MudNavGroup. If the row also has a
                       url it is ignored — a row with children is always a group. *@
                    @if (HasVisibleContent(node))
                    {
                        <!-- hrm-nav-toplevel (CEO, 12 ก.ย. 2569: "เมนูหลักต้องเห็นชัด") —
                             bolds + colors every top-level row so the drawer reads as
                             two tiers at a glance instead of one flat list; see
                             DbNavMenu.razor.css. Sub-items inside a group stay plain. -->
                        @* เงินเดือนคือหัวใจของผลิตภัณฑ์ (CEO, 20 ก.ย. 2569) จึงกางไว้ตั้งแต่เปิด กลุ่มอื่นพับไว้
                           กลุ่มย่อยวาดซ้อนลงไปได้ไม่จำกัดชั้นตามต้นไม้ uppermenucode (CEO, 26 ก.ย. 2569) — จำนวนชั้นที่ควรใช้เป็นเรื่องของ AD.Menu ไม่ใช่ของตัววาด *@
                        <MudNavGroup Title="@DisplayName(node.Row)" Icon="@ResolveIcon(node.Row.icon)"
                                     Expanded="@IsPrimaryGroup(node.Row)" Class="hrm-nav-toplevel">
                            @RenderChildren(node, 1)
                        </MudNavGroup>
                    }
                }
                else if (IsLeafVisible(node))
                {
                    <MudNavLink Href="@node.Row.url" Icon="@ResolveIcon(node.Row.icon)" Class="hrm-nav-toplevel">@DisplayName(node.Row)</MudNavLink>
                }
            }
        </MudNavMenu>
    </div>
}

@code {
    private bool _isAuthenticated;
    private HashSet<string> _allowedMenuCodes = new();
    private List<MenuNode> _tree = new();

    private sealed class MenuNode
    {
        public required sc_menu Row { get; init; }
        public List<MenuNode> Children { get; } = new();
    }

    protected override async Task OnInitializedAsync()
    {
        // Live language switch (th <-> en) only needs a re-render, not a
        // re-query — DisplayName() picks the right column at render time.
        LangState.OnLanguageChangedAsync += HandleLanguageChangedAsync;

        // Same reasoning for menu-style: only the data-menu-style attribute
        // needs to change, no re-query of sc_menu.
        ThemeSt.OnThemeChangedAsync += HandleLanguageChangedAsync;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        _isAuthenticated = user.Identity?.IsAuthenticated ?? false;
        if (!_isAuthenticated)
            return; // fail closed: no auth, no menu, no DB query

        _allowedMenuCodes = user.FindAll("menu").Select(c => c.Value).ToHashSet(StringComparer.OrdinalIgnoreCase);
        _isManager = user.HasClaim(c => c.Type == HRM.Services.Shared.ManagerScopeService.HeadedOrgClaim);

        await using var db = await DbFactory.CreateDbContextAsync();
        var rows = await db.sc_menus
            .AsNoTracking()
            .Where(m => m.isactive && m.isshow)
            .OrderBy(m => m.menuorder)
            .ThenBy(m => m.menuid)
            .ToListAsync();

        _tree = BuildTree(rows);
    }

    // ---- tree building -------------------------------------------------

    private static List<MenuNode> BuildTree(List<sc_menu> rows)
    {
        // Multiple rows may legitimately share a menucode (menucode is the
        // permission gate, not a unique key). For parent resolution we take
        // the FIRST row (in menuorder) carrying each menucode.
        var byCode = new Dictionary<string, MenuNode>(StringComparer.OrdinalIgnoreCase);
        var nodes = new List<MenuNode>();
        foreach (var row in rows)
        {
            var node = new MenuNode { Row = row };
            nodes.Add(node);
            if (!string.IsNullOrWhiteSpace(row.menucode) && !byCode.ContainsKey(row.menucode))
                byCode[row.menucode] = node;
        }

        var topLevel = new List<MenuNode>();
        foreach (var node in nodes)
        {
            if (string.IsNullOrWhiteSpace(node.Row.uppermenucode))
            {
                topLevel.Add(node);
                continue;
            }

            // ผูกกับพ่อโดยตรงเสมอเมื่อหาเจอ — ลึกกี่ชั้นก็ได้ (เมนูไม่จำกัดระดับ, CEO 26 ก.ย. 2569)
            if (byCode.TryGetValue(node.Row.uppermenucode, out var parent) && !ReferenceEquals(parent, node))
            {
                parent.Children.Add(node);
                continue;
            }

            var ancestor = FindTopLevelAncestor(node, byCode);
            if (ancestor is not null)
                ancestor.Children.Add(node);
            else
                topLevel.Add(node); // orphan (parent missing/hidden): show at top level rather than silently dropping it
        }

        return topLevel;
    }

    private static MenuNode? FindTopLevelAncestor(MenuNode node, Dictionary<string, MenuNode> byCode)
    {
        var visited = new HashSet<string>(StringComparer.OrdinalIgnoreCase); // cycle guard on bad data
        var current = node;
        while (!string.IsNullOrWhiteSpace(current.Row.uppermenucode))
        {
            if (!visited.Add(current.Row.uppermenucode))
                return null;
            if (!byCode.TryGetValue(current.Row.uppermenucode, out var parent) || ReferenceEquals(parent, node))
                return null;
            if (string.IsNullOrWhiteSpace(parent.Row.uppermenucode))
                return parent; // reached a top-level row
            current = parent;
        }
        return null;
    }

    // ---- visibility (fail-closed, claim-based, no per-check DB query) ---

    // A LEAF is visible when it has a url to go to AND either its menucode
    // is empty (open to any logged-in user) or the user holds the matching
    // "menu" claim. Rows with neither url nor children render nothing.
    // กลุ่มมีของให้เห็นไหม — นับทั้งเมนูตรง ๆ และเมนูในกลุ่มย่อย
    private bool HasVisibleContent(MenuNode node)
        => node.Children.Any(c => c.Children.Count > 0 ? HasVisibleContent(c) : IsLeafVisible(c));

    // ลูกของกลุ่มหนึ่ง วาดซ้ำลงไปทีละชั้น — ต้นไม้ที่ผูกจาก uppermenucode ไม่มีวงวน (แต่ละแถวมีพ่อเดียว และแถวที่วนกันไม่มีทางถึงราก)
    // MaxDepth เป็นแค่ราวกันตกของข้อมูลเสีย ไม่ใช่ขีดจำกัดของเมนู
    private const int MaxDepth = 64;

    private RenderFragment RenderChildren(MenuNode group, int depth) => @<text>
        @foreach (var child in group.Children)
        {
            @if (child.Children.Count > 0)
            {
                @if (depth < MaxDepth && HasVisibleContent(child))
                {
                    <MudNavGroup Title="@DisplayName(child.Row)" Icon="@ResolveIcon(child.Row.icon)" Expanded="false">
                        @RenderChildren(child, depth + 1)
                    </MudNavGroup>
                }
            }
            else if (IsLeafVisible(child))
            {
                <MudNavLink Href="@child.Row.url" Icon="@ResolveIcon(child.Row.icon)">@DisplayName(child.Row)</MudNavLink>
            }
        }
    </text>;

    // กลุ่มหลักของผลิตภัณฑ์ — กางไว้ตั้งแต่เปิด ไม่ต้องกดหา
    private static bool IsPrimaryGroup(sc_menu row)
        => string.Equals(row.menucode, "GRP_PAYROLL", StringComparison.OrdinalIgnoreCase);

    // ลิงก์ในกลุ่ม MSS ไม่มีรหัสเมนู (หน้าเห็นเฉพาะข้อมูลทีมตัวเอง) จึงเคยโชว์ให้ทุกคน — ตอนนี้โชว์เฉพาะคนที่ผังองค์กรบอกว่าเป็นหัวหน้า
    private bool _isManager;

    private bool IsLeafVisible(MenuNode node)
        => !string.IsNullOrWhiteSpace(node.Row.url)
           && (_isManager || !string.Equals(node.Row.uppermenucode, "GRP_MSS", StringComparison.OrdinalIgnoreCase))
           && (string.IsNullOrWhiteSpace(node.Row.menucode) || _allowedMenuCodes.Contains(node.Row.menucode));

    // ---- display name (th/en) ------------------------------------------

    // Same language source the rest of the app uses: JsonLocalizationService
    // reads the hrm_lang cookie per circuit and updates on live switch.
    private string DisplayName(sc_menu row)
        => L.CurrentLanguage == "en" && !string.IsNullOrWhiteSpace(row.menuname_en)
            ? row.menuname_en
            : row.menuname;

    // ---- icon resolution ------------------------------------------------

    // sc_menu.icon stores strings like "Icons.Material.Filled.EventBusy".
    // Reflect once over MudBlazor's Icons.Material.Filled constants into a
    // static dictionary keyed by the final name segment.
    private static readonly Dictionary<string, string> _iconLookup = BuildIconLookup();

    private static Dictionary<string, string> BuildIconLookup()
    {
        var dict = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var field in typeof(Icons.Material.Filled).GetFields(BindingFlags.Public | BindingFlags.Static))
        {
            if (field.FieldType == typeof(string) && field.GetValue(null) is string svg)
                dict[field.Name] = svg;
        }
        return dict;
    }

    private static string ResolveIcon(string? icon)
    {
        if (string.IsNullOrWhiteSpace(icon))
            return Icons.Material.Filled.Circle;
        var name = icon.Trim();
        var lastDot = name.LastIndexOf('.');
        if (lastDot >= 0)
            name = name[(lastDot + 1)..];
        return _iconLookup.TryGetValue(name, out var svg) ? svg : Icons.Material.Filled.Circle;
    }

    // ---- language change re-render --------------------------------------

    private Task HandleLanguageChangedAsync() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        LangState.OnLanguageChangedAsync -= HandleLanguageChangedAsync;
        ThemeSt.OnThemeChangedAsync -= HandleLanguageChangedAsync;
    }
}
