@using System.Reflection
@using HRM.Models
@using HRM.Services.Workflow
@using Microsoft.AspNetCore.Components
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject WorkflowEngineService Engine

@*
    WorkflowDocumentSlot — the "pluggable document" slot of the generic
    workflow detail template (epms model).

    Given a job (by JobMasterId) it shows that workflow's SOURCE DOCUMENT in
    one of three ways, in priority order:

      1. A registered Blazor component for this workflow/level, rendered via
         Blazor's built-in <DynamicComponent>. This is the rich, in-page view
         of the originating document (e.g. a leave-request summary card).
      2. Otherwise, a LINK to the source document, built from the
         admin-configured route template on wf_workflow.url — the exact same
         fallback mechanism WfMyInboxDetail.BuildDocumentLink already uses.
      3. Otherwise, a small muted note that no source document is wired.

    ── How a module registers its document component ─────────────────────────
    A module plugs its own document view into this slot WITHOUT editing this
    file's rendering logic. Register a component Type against a KEY, where the
    key is (case-insensitive) either:

        "{controller}/{action}"   — from the current level's
                                     wf_sub_workflow_master.controller/action, or
        the workflow's workflowcode

    Do it once at app startup (e.g. in Program.cs, a module's DI setup, or a
    static ctor of the module) via the public static Register(...) method:

        WorkflowDocumentSlot.Register("Leave/Summary",
            typeof(HRM.Components.Shared.SomeLeaveDocView));
        // or by workflow code:
        WorkflowDocumentSlot.Register("LEAVE_REQ",
            typeof(HRM.Components.Shared.SomeLeaveDocView));

    Each registered document component MUST accept these two parameters:

        [Parameter] public string RefId { get; set; }      // job_master.refid
        [Parameter] public long   JobMasterId { get; set; } // this job's id

    (Registrations are process-wide and idempotent — re-registering the same
    key just overwrites it, which keeps hot-reload / repeated startup safe.)
*@

<div class="mt-2">
    <MudText Typo="Typo.subtitle2">เอกสาร</MudText>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Class="mt-1" />
    }
    else if (_job is null)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">ไม่พบงาน</MudText>
    }
    else if (_docType is not null)
    {
        @* 1. The level's own view(s). controller = the document being
             approved; ApproveController = an optional second view giving the
             approver supporting context (both are routes to real pages). *@
        <DynamicComponent Type="_docType" Parameters="_params" />

        @if (_docType2 is not null)
        {
            <div class="mt-3">
                <DynamicComponent Type="_docType2" Parameters="_params2" />
            </div>
        }
    }
    else if (_docLink is not null)
    {
        @* 2. Fallback link to the admin-configured source-document route. *@
        <MudButton Href="@_docLink" Target="_blank"
                   Variant="Variant.Outlined" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.OpenInNew" Class="mt-1">
            ดูเอกสารต้นทาง (@_job.reftable #@_job.refid)
        </MudButton>
    }
    else
    {
        @* 3. Nothing wired. *@
        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">ไม่มีเอกสารต้นทางที่เชื่อมไว้</MudText>
    }
</div>

@code {
    [Parameter, EditorRequired] public long JobMasterId { get; set; }

    // ── Static component registry ─────────────────────────────────────────
    // Empty by default; modules add their document components via Register(...)
    // (see the header comment for the contract). Keyed case-insensitively by
    // "{controller}/{action}" or by workflowcode.
    private static readonly Dictionary<string, Type> _registry =
        new(StringComparer.OrdinalIgnoreCase)
        {
            // Modules register here, e.g.:
            // ["Leave/Summary"] = typeof(HRM.Components.Shared.SomeLeaveDocView),
        };

    // Register (or overwrite) the document component for a given key. Call once
    // at startup from module DI/setup — process-wide and idempotent.
    public static void Register(string key, Type componentType)
    {
        if (string.IsNullOrWhiteSpace(key) || componentType is null) return;
        _registry[key] = componentType;
    }

    private job_master? _job;
    private Type? _docType;
    private Type? _docType2;
    private string? _docLink;
    private Dictionary<string, object> _params = new();
    private Dictionary<string, object> _params2 = new();
    private bool _loading = true;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _job = null;
        _docType = null;
        _docType2 = null;
        _docLink = null;
        _params = new();
        _params2 = new();

        try
        {
            // GetJobDetailAsync loads the wf_workflow nav (Include(j => j.workflow)),
            // so job.workflow?.url is available for the fallback link.
            var job = await Engine.GetJobDetailAsync(JobMasterId);
            _job = job;
            if (job is null) return;

            // Whatever renders here is always a read-only VIEW: the document
            // must stay frozen while it travels the approval chain, or the
            // approvals already given no longer match what's on screen
            // (CEO: "ที่ใช้ View เพราะจะไม่ให้คนแก้ระหว่างทาง"). Editing is a
            // separate action — wf_sub_workflow_master.actionEdit.
            string? controller = null;
            string? action = null;
            string? approveController = null;
            await using (var context = await DbFactory.CreateDbContextAsync())
            {
                var cur = await context.wf_sub_workflow_masters
                    .Where(s => s.workflowid == job.workflowid && s.wlevel == (job.lastLevel ?? 0))
                    .Select(s => new { s.controller, s.action, s.ApproveController })
                    .FirstOrDefaultAsync();
                if (cur is not null)
                {
                    controller = cur.controller;
                    action = cur.action;
                    approveController = cur.ApproveController;
                }
            }

            // ONE field decides which screen is embedded:
            // wf_sub_workflow_master.controller — the route of the module's own
            // view page for THIS level, e.g. "/leave-requests/detail/{refid}".
            // Chosen over a workflow-level field because per-level covers both
            // cases (a single-screen workflow just repeats the same route on
            // every level) while the reverse cannot express per-step screens —
            // and epms itself fills controller/action on every level row rather
            // than relying on any workflow-wide fallback.
            // Resolved against the app's real route table, so wiring a module
            // into a workflow is a config change only, no code.
            if (!string.IsNullOrWhiteSpace(controller))
            {
                var resolvedUrl = controller!.Replace("{refid}", job.refid ?? "", StringComparison.OrdinalIgnoreCase);
                var (routeType, routeParams) = MatchRoute(resolvedUrl);
                if (routeType is not null)
                {
                    AddOptionalParameter(routeType, routeParams, "RefId", job.refid ?? "");
                    AddOptionalParameter(routeType, routeParams, "JobMasterId", JobMasterId);
                    _docType = routeType;
                    _params = routeParams;

                    // Optional SECOND view for the same level (CEO,
                    // 2026-09-08: "จะออกแบบให้แนบได้ 2 view ก็ได้") — supporting
                    // context for the approver, e.g. the requester's remaining
                    // leave balance next to the leave request itself. Same
                    // resolution rules, same {refid} substitution.
                    if (!string.IsNullOrWhiteSpace(approveController))
                    {
                        var secondUrl = approveController!.Replace("{refid}", job.refid ?? "", StringComparison.OrdinalIgnoreCase);
                        var (type2, params2) = MatchRoute(secondUrl);
                        if (type2 is not null)
                        {
                            AddOptionalParameter(type2, params2, "RefId", job.refid ?? "");
                            AddOptionalParameter(type2, params2, "JobMasterId", JobMasterId);
                            _docType2 = type2;
                            _params2 = params2;
                        }
                    }
                    return;
                }
                // Route didn't match a page — fall through to the link tier
                // using the configured url itself, so a mistyped route still
                // gives the approver something to click rather than nothing.
                _docLink = resolvedUrl;
                return;
            }

            _docType = ResolveComponentType(controller, action, job.workflow?.c_detail, job.workflow?.workflowcode);
            if (_docType is not null)
            {
                _params = new Dictionary<string, object>
                {
                    ["RefId"] = job.refid ?? "",
                    ["JobMasterId"] = JobMasterId,
                };
            }
            else
            {
                _docLink = BuildDocumentLink(job);
            }
        }
        finally
        {
            _loading = false;
        }
    }

    // The app's own route table, built once: every routable component with
    // its @page template split into segments. This is what lets workflow
    // config name a plain route ("/leave-requests/detail/{refid}") instead of
    // registering component types by hand.
    private static readonly Lazy<List<(string[] Segments, Type Type)>> _routeTable = new(() =>
        typeof(WorkflowDocumentSlot).Assembly.GetTypes()
            .Where(t => typeof(IComponent).IsAssignableFrom(t) && !t.IsAbstract)
            .SelectMany(t => t.GetCustomAttributes<RouteAttribute>().Select(a => (Template: a.Template, Type: t)))
            .Select(x => (Segments: x.Template.Trim('/').Split('/'), x.Type))
            .ToList());

    // Matches a concrete url against the route table, binding route
    // parameters (with :long / :int constraints converted) as it goes.
    private static (Type? Type, Dictionary<string, object> Parameters) MatchRoute(string url)
    {
        var path = url.Split('?')[0].Trim('/');
        var parts = path.Split('/');

        foreach (var (segments, type) in _routeTable.Value)
        {
            if (segments.Length != parts.Length) continue;

            var parameters = new Dictionary<string, object>();
            var matched = true;

            for (var i = 0; i < segments.Length; i++)
            {
                var segment = segments[i];
                if (segment.StartsWith('{') && segment.EndsWith('}'))
                {
                    var name = segment.Trim('{', '}');
                    var constraint = "";
                    var colon = name.IndexOf(':');
                    if (colon >= 0)
                    {
                        constraint = name[(colon + 1)..];
                        name = name[..colon];
                    }

                    object? value = constraint switch
                    {
                        "long" => long.TryParse(parts[i], out var l) ? l : null,
                        "int" => int.TryParse(parts[i], out var n) ? n : null,
                        "guid" => Guid.TryParse(parts[i], out var g) ? g : null,
                        _ => parts[i],
                    };
                    if (value is null) { matched = false; break; }
                    parameters[name] = value;
                }
                else if (!string.Equals(segment, parts[i], StringComparison.OrdinalIgnoreCase))
                {
                    matched = false;
                    break;
                }
            }

            if (matched) return (type, parameters);
        }

        return (null, new());
    }

    // DynamicComponent throws on a parameter the target doesn't declare, so
    // the slot's own RefId/JobMasterId are only supplied to pages that
    // actually accept them (a page that does can tell it's embedded and skip
    // re-rendering the status/history the shell already shows).
    private static void AddOptionalParameter(Type componentType, Dictionary<string, object> parameters, string name, object value)
    {
        if (parameters.ContainsKey(name)) return;
        var prop = componentType.GetProperty(name);
        if (prop is not null && prop.GetCustomAttribute<ParameterAttribute>() is not null)
            parameters[name] = value;
    }

    // Resolution order, most specific first:
    //   1. this level's "{controller}/{action}"  (per-step screen)
    //   2. wf_workflow.c_detail                   (workflow-wide default screen)
    //   3. wf_workflow.workflowcode               (coarse catch-all)
    // Returns null if none is registered, and the caller falls back to a link.
    private static Type? ResolveComponentType(string? controller, string? action, string? cDetail, string? workflowcode)
    {
        if (!string.IsNullOrWhiteSpace(controller) || !string.IsNullOrWhiteSpace(action))
        {
            var key = $"{controller}/{action}";
            if (_registry.TryGetValue(key, out var t)) return t;
        }
        if (!string.IsNullOrWhiteSpace(cDetail) && _registry.TryGetValue(cDetail!, out var ct))
            return ct;
        if (!string.IsNullOrWhiteSpace(workflowcode) && _registry.TryGetValue(workflowcode!, out var wt))
            return wt;
        return null;
    }

    // Ported from WfMyInboxDetail.BuildDocumentLink: wf_workflow.url is an
    // admin-configured route template (e.g. "/pay/adhoc-detail/{refid}") for the
    // page that shows the document that started this job. job_master.reftable/refid
    // are the generic (table, id) pair recorded at StartJobAsync time. No {refid}
    // placeholder (or no template/refid) means routing isn't configured -> null.
    private static string? BuildDocumentLink(job_master? job)
    {
        var template = job?.workflow?.url;
        if (string.IsNullOrWhiteSpace(template) || string.IsNullOrWhiteSpace(job?.refid))
            return null;
        return template.Contains("{refid}") ? template.Replace("{refid}", job.refid) : template;
    }
}
