@using HRM.Models
@using HRM.Services.Workflow
@using MudBlazor
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<HRMContext> DbFactory
@inject WorkflowEngineService Engine

@* Reusable, self-contained approval-progress timeline. Drop
   <WorkflowStepper JobMasterId="..." /> anywhere a job's approval path should
   be shown — it resolves everything from the job-master id alone.

   Rebuilt 2026-09-08 (CEO: "progress คุณทำให้สวยและฉลาดกว่านี้ได้ เช่นแสดง
   ชื่อคนอนุมัติ") from the flat same-colour blocks ported off epms:
     - done / in-progress / upcoming / rejected are now visually distinct
       (the old version painted "approved" and "pending" the same blue, so a
       reader couldn't tell what was finished from what was still waiting)
     - every stage shows WHO — actual approvers on stages already reached,
       and the predicted approver on the next one (PreviewNextApproversAsync)
     - each stage shows how long it took, or how long it has been waiting,
       from the per-level starttime/endtime stamps
*@

@if (_job is null)
{
    <MudText Typo="Typo.caption">ไม่พบข้อมูล</MudText>
}
else
{
    var steps = BuildSteps();

    <MudText Typo="Typo.subtitle2" Class="mb-2">เส้นทางอนุมัติ</MudText>

    @* Horizontal stepper (CEO's pick: "หน้าตาแบบ B แต่รายละเอียดแบบ C/A") —
       node + connector rail across the top, full per-step detail underneath.
       Responsive with no JS and one set of markup: wide screens lay the steps
       out left-to-right (scrolling sideways rather than squeezing text when a
       workflow has many levels — epms's RFQ has 8); at ≤700px the same
       elements fold into a vertical timeline, which is what actually reads on
       a phone. *@
    <style>
        .wf-stepper { display: flex; overflow-x: auto; padding-bottom: 4px; }
        .wf-step { flex: 1 0 170px; min-width: 170px; text-align: center; padding: 0 4px; }
        .wf-rail { display: flex; align-items: center; }
        .wf-rail-line { flex: 1; height: 2px; }
        .wf-detail { margin-top: 6px; }

        @@media (max-width: 700px) {
            .wf-stepper { flex-direction: column; overflow-x: visible; }
            .wf-step { flex: none; min-width: 0; text-align: left; display: flex; gap: 12px; padding: 0; }
            .wf-rail { flex-direction: column; width: 32px; flex: none; }
            .wf-rail-line { width: 2px; height: auto; flex: 1; min-height: 12px; }
            .wf-detail { margin-top: 0; padding-bottom: 16px; flex: 1; min-width: 0; }
        }
    </style>

    <div class="wf-stepper">
        @for (var i = 0; i < steps.Count; i++)
        {
            var s = steps[i];
            var isFirst = i == 0;
            var isLast = i == steps.Count - 1;

            <div class="wf-step">
                @* Rail: connector · node · connector (row on desktop, column on mobile) *@
                <div class="wf-rail">
                    <div class="wf-rail-line" style="background:@(isFirst ? "transparent" : RailColor(steps[i - 1].State));"></div>
                    <div style="@DotStyle(s.State)">
                        @if (s.State == "approved")
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Check" Style="font-size:17px;color:#fff;" />
                        }
                        else if (s.State == "rejected")
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Close" Style="font-size:17px;color:#fff;" />
                        }
                        else if (s.State == "pending")
                        {
                            <MudIcon Icon="@Icons.Material.Filled.HourglassEmpty" Style="font-size:16px;color:#fff;" />
                        }
                        else
                        {
                            <span style="font-size:13px;font-weight:600;">@s.Level</span>
                        }
                    </div>
                    <div class="wf-rail-line" style="background:@(isLast ? "transparent" : RailColor(s.State));"></div>
                </div>

                @* Detail under the node *@
                <div style="margin-top:6px;">
                    <div style="font-weight:600;font-size:0.9rem;line-height:1.3;">@s.Title</div>

                    @if (!string.IsNullOrWhiteSpace(s.Approvers))
                    {
                        <div style="font-size:0.82rem;line-height:1.35;margin-top:2px;">@s.Approvers</div>
                    }

                    <div style="margin-top:3px;">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@ChipColor(s.State)" Class="ma-0">@StatusLabel(s.State)</MudChip>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(s.TimeLine))
                    {
                        <div style="font-size:0.75rem;opacity:0.7;line-height:1.3;margin-top:1px;">@s.TimeLine</div>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public long JobMasterId { get; set; }

    private long _loadedJobId = -1;
    private job_master? _job;
    private Dictionary<long, string> _approverNames = new();
    private List<(int Level, string Label)> _stageDefs = new();
    private Dictionary<int, (DateTime? Start, DateTime? End)> _stageTimes = new();
    private List<WorkflowEngineService.LevelApproverPlan> _plan = new();

    protected override async Task OnParametersSetAsync()
    {
        if (JobMasterId == _loadedJobId) return;
        _loadedJobId = JobMasterId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _job = null;
        _approverNames = new();
        _stageDefs = new();
        _stageTimes = new();
        _plan = new();

        var job = await Engine.GetJobDetailAsync(JobMasterId);
        if (job is null) return;
        _job = job;

        await LoadApproverNamesAsync();
        await LoadStageDefsAsync();
        // The config plan is the skeleton — every level and who is SET to
        // approve it. Runtime rows are overlaid on top in BuildSteps.
        _plan = await Engine.GetApproverPlanAsync(job.workflowid);
    }

    // sc_user by userid -> empid -> Hremployee EmpName+EmpSurname, falling back
    // to loginname then "#id" so a name is never blank.
    private async Task LoadApproverNamesAsync()
    {
        if (_job is null) return;

        var userIds = _job.job_user_lists.Where(a => a.userid.HasValue).Select(a => a.userid!.Value).ToList();
        if (_job.createuserid is long ruid) userIds.Add(ruid);
        userIds = userIds.Distinct().ToList();
        if (userIds.Count == 0) return;

        await using var context = await DbFactory.CreateDbContextAsync();
        var users = await context.sc_users
            .Where(u => userIds.Contains(u.userid))
            .Select(u => new { u.userid, u.empid, u.loginname })
            .ToListAsync();

        var empIds = users.Where(u => u.empid != null).Select(u => u.empid!).Distinct().ToList();
        var emps = await context.Hremployee
            .Where(e => empIds.Contains(e.EmpNo))
            .Select(e => new { e.EmpNo, e.EmpName, e.EmpSurname })
            .ToListAsync();
        var nameByEmpNo = emps.ToDictionary(e => e.EmpNo, e => $"{e.EmpName} {e.EmpSurname}".Trim());

        foreach (var u in users)
        {
            _approverNames[u.userid] = u.empid != null && nameByEmpNo.TryGetValue(u.empid, out var n) && !string.IsNullOrWhiteSpace(n)
                ? n
                : (!string.IsNullOrWhiteSpace(u.loginname) ? u.loginname! : $"#{u.userid}");
        }
    }

    private string ApproverName(long? userid)
        => userid is long id && _approverNames.TryGetValue(id, out var n) ? n : "(ยังไม่มีผู้อนุมัติ)";

    // Full ordered stage list from the workflow definition (so upcoming stages
    // show too), plus the per-level start/end stamps recorded on this job.
    private async Task LoadStageDefsAsync()
    {
        if (_job is null) return;

        await using var context = await DbFactory.CreateDbContextAsync();
        var defs = await context.wf_sub_workflow_masters
            .Where(s => s.workflowid == _job.workflowid)
            .OrderBy(s => s.wlevel)
            .Select(s => new { s.wlevel, s.subject })
            .ToListAsync();
        _stageDefs = defs.Select(d => (d.wlevel, d.subject ?? "")).ToList();

        var times = await context.job_subworkflow_masters
            .Where(s => s.jobmasterid == JobMasterId)
            .Select(s => new { s.wlevel, s.starttime, s.endtime })
            .ToListAsync();
        // หนึ่งระดับมีได้หลายรอยเท้าเมื่องานตีกลับแล้ววนกลับมา — แสดงการมาถึงครั้งล่าสุด
        _stageTimes = times
            .GroupBy(t => t.wlevel)
            .ToDictionary(g => g.Key, g => (g.Max(t => t.starttime), g.Max(t => t.endtime)));
    }

    private record StepInfo(int Level, string Title, string Approvers, string State, string TimeLine, bool Predicted);

    private List<StepInfo> BuildSteps()
    {
        var steps = new List<StepInfo>();
        if (_job is null) return steps;

        var current = _job.lastLevel ?? 0;

        // แต่ละขั้นแสดง "รอบที่ออกใบงานล่าสุด" ของขั้นนั้น (jobseq สูงสุดในขั้น) — ห้ามกรองด้วย job.jobseq
        // ปัจจุบัน เพราะ engine ใหม่ขยับ jobseq ทุกครั้งที่ใครกด ผู้อนุมัติร่วมขั้นที่ยังไม่กดจะหายจากภาพ (audit M7)
        var byLevel = _job.job_user_lists
            .GroupBy(a => a.wlevel ?? 0)
            .ToDictionary(g => g.Key, g =>
            {
                var latest = g.Max(a => a.jobseq ?? 0);
                return g.Where(a => (a.jobseq ?? 0) == latest).ToList();
            });

        var levels = _stageDefs.Count > 0
            ? _stageDefs.Select(d => d.Level).ToList()
            : byLevel.Keys.OrderBy(k => k).ToList();

        foreach (var lvl in levels)
        {
            var label = _stageDefs.FirstOrDefault(d => d.Level == lvl).Label;
            var title = string.IsNullOrWhiteSpace(label) ? $"ระดับ {lvl}" : label;
            _stageTimes.TryGetValue(lvl, out var times);

            if (byLevel.TryGetValue(lvl, out var rows) && rows.Count > 0)
            {
                // "ชื่อ (empno)" — CEO, 10 ก.ย. 2569: ชื่อซ้ำกันได้ในองค์กรใหญ่ ใส่รหัสพนักงานกำกับเสมอ
                var names = string.Join(" / ", rows.Select(r =>
                    (!string.IsNullOrWhiteSpace(r.username) ? r.username! : ApproverName(r.userid))
                    + (string.IsNullOrWhiteSpace(r.empid) ? "" : $" ({r.empid})")).Distinct());

                string state;
                if (rows.Any(r => r.jobstatus == WorkflowEngineService.StatusRejected)) state = "rejected";
                else if (rows.All(r => r.jobstatus == WorkflowEngineService.StatusApproved)) state = "approved";
                else state = "pending";

                steps.Add(new StepInfo(lvl, title, names, state, BuildTimeLine(state, times.Start, times.End), false));
            }
            else
            {
                var state = lvl < current ? "approved" : (lvl == current ? "pending" : "waiting");

                // Not reached yet — no job_user_list row exists, so show who
                // the CONFIG says approves this level (exact, straight from
                // wf_custom_user/wf_custom_role/the level's strategy flags),
                // never a runtime guess.
                var configured = _plan.FirstOrDefault(p => p.Level == lvl)?.ApproverText ?? "";
                steps.Add(new StepInfo(lvl, title, configured, state, BuildTimeLine(state, times.Start, times.End), !string.IsNullOrWhiteSpace(configured)));
            }
        }

        return steps;
    }

    // "อนุมัติแล้ว · 08/09 14:30 · ใช้เวลา 2 วัน 3 ชม." for finished stages,
    // "กำลังพิจารณา · รอมาแล้ว 5 ชม." for the open one, blank for upcoming.
    private static string BuildTimeLine(string state, DateTime? start, DateTime? end)
    {
        if (state == "waiting") return "";

        if (end is not null)
        {
            var took = start is not null ? $" · ใช้เวลา {Humanize(end.Value - start.Value)}" : "";
            return $"{end.Value:dd/MM/yyyy HH:mm}{took}";
        }

        if (start is not null && state == "pending")
            return $"เริ่ม {start.Value:dd/MM/yyyy HH:mm} · รอมาแล้ว {Humanize(DateTime.Now - start.Value)}";

        return start is not null ? $"เริ่ม {start.Value:dd/MM/yyyy HH:mm}" : "";
    }

    private static string Humanize(TimeSpan span)
    {
        if (span.TotalMinutes < 1) return "ไม่ถึงนาที";
        if (span.TotalHours < 1) return $"{(int)span.TotalMinutes} นาที";
        if (span.TotalDays < 1) return $"{(int)span.TotalHours} ชม.";
        var days = (int)span.TotalDays;
        var hours = span.Hours;
        return hours > 0 ? $"{days} วัน {hours} ชม." : $"{days} วัน";
    }

    private static string StateColor(string state) => state switch
    {
        "approved" => "var(--mud-palette-success)",
        "pending" => "var(--mud-palette-primary)",
        "rejected" => "var(--mud-palette-error)",
        _ => "var(--mud-palette-text-disabled)",
    };

    private static Color ChipColor(string state) => state switch
    {
        "approved" => Color.Success,
        "pending" => Color.Primary,
        "rejected" => Color.Error,
        _ => Color.Default,
    };

    private static string StatusLabel(string state) => state switch
    {
        "approved" => "อนุมัติแล้ว",
        "pending" => "กำลังพิจารณา",
        "rejected" => "ไม่อนุมัติ",
        _ => "รอถึงคิว",
    };

    private static string DotStyle(string state)
    {
        var color = StateColor(state);
        var filled = state != "waiting";
        return $"width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex:none;"
             + (filled
                ? $"background:{color};color:#fff;"
                : $"background:transparent;border:2px solid {color};color:{color};");
    }

    // Connector between two nodes: coloured once the step behind it is done,
    // muted while the flow hasn't reached it.
    private static string RailColor(string state)
        => state is "waiting" or "pending" ? "var(--mud-palette-lines-default)" : StateColor(state);
}
