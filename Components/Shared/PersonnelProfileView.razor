@using HRM.Models
@using HRM.Services
@using HRM.Services.Audit
@using HRM.Services.Hr
@using HRM.Services.Pay
@using HRM.Services.Shared
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inherits HRM.Components.Shared.LocalizedComponentBase
@inject IDbContextFactory<HRMContext> DbFactory
@inject IAuditLogger AuditLogger
@inject PrivateFileStorage FileStorage
@inject ISnackbar Snackbar
@inject JsonLocalizationService L
@inject AuthenticationStateProvider AuthProvider

@* Reusable "ข้อมูลบุคลากร" display — the header + tab body extracted verbatim
   from Components/Pages/Employee/EmployeePersonnelProfile.razor so the same
   rich view can be reused by both the HR-facing search page (any employee,
   picked from a search box) and the ESS-facing page (always the logged-in
   user's own record, resolved from claims — see Components/Pages/Ess/
   EssPersonnelProfile.razor). This component owns no authorization of its
   own and does no employee search/pick of its own — whoever hosts it decides
   which HremployeeId it is allowed to load. Data loading, tab content, PDPA
   audit logging, and the committee-history query are unchanged from the
   original page — this is a pure extraction, not a redesign. *@

@if (_notFound)
{
    <MudAlert Severity="Severity.Warning" Class="ma-4">ไม่พบข้อมูลพนักงาน</MudAlert>
}
else if (_emp is null)
{
    <MudProgressCircular Indeterminate="true" Class="ma-4" />
}
else
{
    <MudPaper Class="pa-4 mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
            <MudText Typo="Typo.h6">@_emp.PrenameCode @_emp.EmpName @_emp.EmpSurname</MudText>
            <MudChip T="string" Color="Color.Warning" Size="Size.Small">PDPA</MudChip>
        </MudStack>
        <MudGrid>
            <MudItem xs="6" sm="3"><MudTextField Value="@_emp.EmpNo" Label="รหัสพนักงาน" ReadOnly="true" /></MudItem>
            <MudItem xs="6" sm="3"><MudTextField Value="@(_orgName ?? "-")" Label="กลุ่มงาน/สังกัด" ReadOnly="true" /></MudItem>
            <MudItem xs="6" sm="3"><MudTextField Value="@(_currentSlot?.Name ?? "— ไม่ได้ผูกกับเลขที่อัตราใด —")" Label="ตำแหน่ง" ReadOnly="true" /></MudItem>
            <MudItem xs="6" sm="3"><MudTextField Value="@(_emp.EmptypeCode ?? "-")" Label="ประเภทบุคลากร" ReadOnly="true" /></MudItem>
            <MudItem xs="6" sm="3"><MudTextField Value="@(SexLabel(_emp.Sex))" Label="เพศ" ReadOnly="true" /></MudItem>
            <MudItem xs="6" sm="3"><MudTextField Value="@(_emp.Nation ?? "-")" Label="เชื้อชาติ" ReadOnly="true" /></MudItem>
            <MudItem xs="6" sm="3"><MudTextField Value="@TenureText()" Label="อายุงาน" ReadOnly="true" /></MudItem>
            <MudItem xs="6" sm="3"><MudTextField Value="@(_emp.IdCard ?? "-")" Label="เลขบัตรประชาชน" ReadOnly="true" /></MudItem>
            <MudItem xs="6" sm="3"><MudTextField Value="@(_emp.ContractNo ?? "-")" Label="เลขที่สัญญาจ้าง" ReadOnly="true" /></MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4">
        @* KeepPanelsAlive is the fix for "คลิกแท็บแล้วค้าง": with 11 data-heavy
           panels, the MudTabs default disposes/re-renders a panel on every
           click — a full server-circuit render each time. Alive panels render
           once and switch instantly. Data was already loaded up-front, so
           this costs one heavier first render only. *@
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" KeepPanelsAlive="true"
                 Color="Color.Primary" SliderColor="Color.Secondary" ActiveTabClass="mud-primary-text">
            <MudTabPanel Text="ข้อมูลทั่วไป" Icon="@Icons.Material.Filled.Badge">
                <MudGrid Class="pa-2">
                    <MudItem xs="12" md="8">
                        <MudText Typo="Typo.subtitle1" Class="mb-2">ข้อมูลทั่วไป</MudText>
                        <MudGrid>
                            <MudItem xs="6"><MudTextField Value="@(_emp.EmpEname ?? "-")" Label="ชื่อ (Eng)" ReadOnly="true" /></MudItem>
                            <MudItem xs="6"><MudTextField Value="@(_emp.EmpEsurname ?? "-")" Label="นามสกุล (Eng)" ReadOnly="true" /></MudItem>
                            <MudItem xs="6"><MudTextField Value="@(_emp.EmpNickname ?? "-")" Label="ชื่อเล่น" ReadOnly="true" /></MudItem>
                            <MudItem xs="6"><MudTextField Value="@(_emp.BirthDate?.ToString("dd/MM/yyyy") ?? "-")" Label="วันเกิด" ReadOnly="true" /></MudItem>
                            <MudItem xs="6"><MudTextField Value="@(_emp.Nation ?? "-")" Label="สัญชาติ" ReadOnly="true" /></MudItem>
                            <MudItem xs="6"><MudTextField Value="@(_emp.Religion ?? "-")" Label="ศาสนา" ReadOnly="true" /></MudItem>
                            <MudItem xs="6"><MudTextField Value="@(_emp.BloodtypeCode ?? "-")" Label="กรุ๊ปเลือด" ReadOnly="true" /></MudItem>
                            <MudItem xs="6"><MudTextField Value="@(_emp.Weight?.ToString("0.#") ?? "-")" Label="น้ำหนัก (กก.)" ReadOnly="true" /></MudItem>
                            <MudItem xs="6"><MudTextField Value="@(_emp.Height?.ToString("0.#") ?? "-")" Label="ส่วนสูง (ซม.)" ReadOnly="true" /></MudItem>
                            <MudItem xs="12"><MudTextField Value="@(_emp.EmpSpecial ?? "-")" Label="ความสามารถพิเศษ" ReadOnly="true" Lines="2" /></MudItem>
                        </MudGrid>
                    </MudItem>
                    <MudItem xs="12" md="4" Class="d-flex justify-center align-start">
                        @if (!string.IsNullOrEmpty(_emp.PhotoStoragePath))
                        {
                            <MudImage Src="@($"/org/files/employee-photo/{_emp.id}")" Width="180" Class="rounded" />
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Size="Size.Large" Style="font-size:120px;" />
                        }
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-3" />
                <MudText Typo="Typo.subtitle1" Class="mb-2">ที่อยู่ปัจจุบัน</MudText>
                @if (_currentAddress is null)
                {
                    <MudText Typo="Typo.body2">ยังไม่มีข้อมูลที่อยู่ปัจจุบัน</MudText>
                }
                else
                {
                    <MudText Typo="Typo.body2">@AddressText(_currentAddress)</MudText>
                    <MudText Typo="Typo.body2">โทรศัพท์: @(_currentAddress.tel ?? _currentAddress.mobileno ?? "-") &nbsp; E-mail: @(_currentAddress.email ?? "-")</MudText>
                }

                <MudDivider Class="my-3" />
                <MudText Typo="Typo.subtitle1" Class="mb-2">ที่อยู่ตามทะเบียนบ้าน</MudText>
                @if (_registeredAddress is null)
                {
                    <MudText Typo="Typo.body2">ยังไม่มีข้อมูลที่อยู่ตามทะเบียนบ้าน</MudText>
                }
                else
                {
                    <MudText Typo="Typo.body2">@AddressText(_registeredAddress)</MudText>
                }
            </MudTabPanel>

            <MudTabPanel Text="ข้อมูลเพิ่มเติม" Icon="@Icons.Material.Filled.Info">
                <MudGrid Class="pa-2">
                    <MudItem xs="6"><MudTextField Value="@(_emp.ContractNo ?? "-")" Label="เลขที่สัญญาจ้าง" ReadOnly="true" /></MudItem>
                    <MudItem xs="6"><MudTextField Value="@(_emp.ContractDate?.ToString("dd/MM/yyyy") ?? "-")" Label="วันที่สัญญาจ้าง" ReadOnly="true" /></MudItem>
                    <MudItem xs="6"><MudTextField Value="@(_emp.LevelCode ?? "-")" Label="ระดับ" ReadOnly="true" /></MudItem>
                    <MudItem xs="6"><MudTextField Value="@(_emp.LeaveBf?.ToString("0.#") ?? "-")" Label="วันลายกมาสะสม" ReadOnly="true" /></MudItem>
                </MudGrid>
                <MudDivider Class="my-3" />
                <MudText Typo="Typo.subtitle1" Class="mb-2">บุคคลติดต่อในยามฉุกเฉิน</MudText>
                <MudTable Items="_contactPersons" Dense="true">
                    <HeaderContent>
                        <MudTh>ชื่อ</MudTh><MudTh>ความสัมพันธ์</MudTh><MudTh>โทรศัพท์</MudTh><MudTh>ที่อยู่</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Name</MudTd><MudTd>@context.Relation</MudTd><MudTd>@context.Phone</MudTd><MudTd>@context.Address</MudTd>
                    </RowTemplate>
                    <NoRecordsContent><MudText Typo="Typo.body2">ยังไม่มีข้อมูล — จัดการที่ <MudLink Href="@($"/employee/{HremployeeId}/contact-person")">บุคคลติดต่อในยามฉุกเฉิน</MudLink></MudText></NoRecordsContent>
                </MudTable>
            </MudTabPanel>

            <MudTabPanel Text="ประวัติครอบครัว" Icon="@Icons.Material.Filled.FamilyRestroom">
                <MudTable Items="_family" Dense="true">
                    <HeaderContent>
                        <MudTh>ความสัมพันธ์</MudTh><MudTh>ชื่อ-สกุล</MudTh><MudTh>วันเกิด</MudTh><MudTh>อาชีพ</MudTh><MudTh>สถานะ</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.FamilyType</MudTd>
                        <MudTd>@context.PrenameCode @context.FirstName @context.LastName</MudTd>
                        <MudTd>@(context.BirthDate?.ToString("dd/MM/yyyy") ?? "-")</MudTd>
                        <MudTd>@(context.Career ?? "-")</MudTd>
                        <MudTd>@(context.IsAlive ? "มีชีวิตอยู่" : "เสียชีวิต")</MudTd>
                    </RowTemplate>
                    <NoRecordsContent><MudText Typo="Typo.body2">ยังไม่มีข้อมูล — จัดการที่ <MudLink Href="@($"/employee/{HremployeeId}/family")">บุคคลในครอบครัว</MudLink></MudText></NoRecordsContent>
                </MudTable>
            </MudTabPanel>

            <MudTabPanel Text="ข้อมูลบุตร" Icon="@Icons.Material.Filled.ChildCare">
                <MudTable Items="_children" Dense="true">
                    <HeaderContent>
                        <MudTh>ชื่อ-สกุล</MudTh><MudTh>วันเกิด</MudTh><MudTh>กำลังศึกษา</MudTh><MudTh>ใช้สิทธิลดหย่อน</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.PrenameCode @context.FirstName @context.LastName</MudTd>
                        <MudTd>@(context.BirthDate?.ToString("dd/MM/yyyy") ?? "-")</MudTd>
                        <MudTd>@(context.ChildStudying ? "กำลังศึกษา" : "-")</MudTd>
                        <MudTd>@(context.ChildDeductionEligible ? "ใช้สิทธิ" : "-")</MudTd>
                    </RowTemplate>
                    <NoRecordsContent><MudText Typo="Typo.body2">ยังไม่มีข้อมูลบุตร — จัดการที่ <MudLink Href="@($"/employee/{HremployeeId}/family")">บุคคลในครอบครัว</MudLink></MudText></NoRecordsContent>
                </MudTable>
            </MudTabPanel>

            <MudTabPanel Text="ประวัติการทำงาน" Icon="@Icons.Material.Filled.WorkHistory">
                <MudText Typo="Typo.body2" Class="mb-2">เหตุการณ์สำคัญของการจ้างงาน (จากข้อมูลพนักงานโดยตรง)</MudText>
                <MudSimpleTable Dense="true">
                    <tbody>
                        <tr><td>วันที่เริ่มงาน</td><td>@(_emp.WorkDate?.ToString("dd/MM/yyyy") ?? "-")</td></tr>
                        <tr><td>วันที่ผ่านทดลองงาน</td><td>@(_emp.ProbationConfirmedDate?.ToString("dd/MM/yyyy") ?? "ยังไม่ผ่าน/ไม่มีข้อมูล")</td></tr>
                        <tr><td>วันที่บรรจุ</td><td>@(_emp.ContainDate?.ToString("dd/MM/yyyy") ?? "-")</td></tr>
                        @if (_emp.ResignDate is not null)
                        {
                            <tr><td>วันที่ลาออก/สิ้นสุดสัญญา</td><td>@_emp.ResignDate?.ToString("dd/MM/yyyy")</td></tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </MudTabPanel>

            <MudTabPanel Text="ประวัติวุฒิการศึกษา" Icon="@Icons.Material.Filled.School">
                <MudTable Items="_education" Dense="true">
                    <HeaderContent>
                        <MudTh>ระดับ</MudTh><MudTh>วุฒิ/สาขา</MudTh><MudTh>สถาบัน</MudTh><MudTh>ปีที่จบ</MudTh><MudTh>เกรดเฉลี่ย</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Level @(context.IsHighestDegree ? "(สูงสุด)" : "")</MudTd>
                        <MudTd>@context.Degree @context.Major</MudTd>
                        <MudTd>@context.Institute</MudTd>
                        <MudTd>@(context.FinishedDate?.ToString("yyyy") ?? "-")</MudTd>
                        <MudTd>@(context.Gpa?.ToString("0.00") ?? "-")</MudTd>
                    </RowTemplate>
                    <NoRecordsContent><MudText Typo="Typo.body2">ยังไม่มีข้อมูล — จัดการที่ <MudLink Href="@($"/employee/{HremployeeId}/education")">ประวัติการศึกษา</MudLink></MudText></NoRecordsContent>
                </MudTable>
            </MudTabPanel>

            <MudTabPanel Text="ประสบการณ์ทำงาน" Icon="@Icons.Material.Filled.Work">
                <MudTable Items="_experience" Dense="true">
                    <HeaderContent>
                        <MudTh>ตำแหน่ง</MudTh><MudTh>บริษัท</MudTh><MudTh>ช่วงเวลา</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Position</MudTd>
                        <MudTd>@context.Company</MudTd>
                        <MudTd>@context.StartDate?.ToString("MM/yyyy") - @(context.EndDate?.ToString("MM/yyyy") ?? "ปัจจุบัน")</MudTd>
                    </RowTemplate>
                    <NoRecordsContent><MudText Typo="Typo.body2">ยังไม่มีข้อมูล — จัดการที่ <MudLink Href="@($"/employee/{HremployeeId}/experience")">ประสบการณ์ก่อนเข้าทำงาน</MudLink></MudText></NoRecordsContent>
                </MudTable>
            </MudTabPanel>

            <MudTabPanel Text="ประเมินการทำงาน" Icon="@Icons.Material.Filled.Assessment">
                <MudTable Items="_evaluations" Dense="true" Hover="true">
                    <HeaderContent>
                        <MudTh>รอบประเมิน</MudTh><MudTh>คะแนนรวม</MudTh><MudTh>เกรด</MudTh><MudTh>สถานะ</MudTh><MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.EvaluationPeriod?.Name</MudTd>
                        <MudTd>@(context.FinalScorePercent?.ToString("0.##") + "%" ?? "-")</MudTd>
                        <MudTd>@(context.FinalGrade ?? "-")</MudTd>
                        <MudTd>@context.Status</MudTd>
                        <MudTd><MudButton Size="Size.Small" Variant="Variant.Text" Href="@($"/perf/instances/{context.Id}")">ดูรายละเอียด</MudButton></MudTd>
                    </RowTemplate>
                    <NoRecordsContent><MudText Typo="Typo.body2">ยังไม่มีผลการประเมิน</MudText></NoRecordsContent>
                </MudTable>
            </MudTabPanel>

            <MudTabPanel Text="ประวัติการโยกย้ายตำแหน่ง" Icon="@Icons.Material.Filled.SwapHoriz">
                <MudTable Items="_positionHistory" Dense="true">
                    <HeaderContent>
                        <MudTh>วันที่</MudTh><MudTh>ประเภท</MudTh><MudTh>ตำแหน่งเดิม</MudTh><MudTh>ตำแหน่งใหม่</MudTh><MudTh>เหตุผล</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.ChangedDate.ToString("dd/MM/yyyy")</MudTd>
                        <MudTd>@ChangeTypeLabel(context.ChangeType)</MudTd>
                        <MudTd>@(context.OldPositionName ?? "-")</MudTd>
                        <MudTd>@(context.NewPositionName ?? "-")</MudTd>
                        <MudTd>@(context.Reason ?? "-")</MudTd>
                    </RowTemplate>
                    <NoRecordsContent><MudText Typo="Typo.body2">ยังไม่มีประวัติการโยกย้ายตำแหน่ง/ปรับเงินเดือน</MudText></NoRecordsContent>
                </MudTable>
            </MudTabPanel>

            @if (_committeeHistory.Any())
            {
                <MudTabPanel Text="ประวัติทำงานในคณะทำงาน" Icon="@Icons.Material.Filled.Groups">
                    <MudTable Items="_committeeHistory" Dense="true">
                        <HeaderContent>
                            <MudTh>วันที่มีผล</MudTh><MudTh>ตำแหน่ง/คณะ</MudTh><MudTh>สังกัด</MudTh><MudTh>สถานะ</MudTh><MudTh>เหตุผล/หมายเหตุ</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@(context.EffectiveDate?.ToString("dd/MM/yyyy") ?? "-")</MudTd>
                            <MudTd>@(context.NewPositionName ?? "-")</MudTd>
                            <MudTd>@(context.NewOrganizationName ?? "-")</MudTd>
                            <MudTd>@(context.PositionStatus ?? "-")</MudTd>
                            <MudTd>@(context.Reason ?? "-")</MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudTabPanel>
            }

            <MudTabPanel Text="@L.Translate("EmpDocSectionTitle")" Icon="@Icons.Material.Filled.Folder">
                @if (!ReadOnlyDocuments)
                {
                    @* Upload form: document type is mandatory (CEO order — every
                       attachment is classified), remark optional. Picking the file
                       starts the upload immediately, so the guard lives in
                       UploadDocAsync rather than a submit button. *@
                    <MudGrid Class="align-center">
                        <MudItem xs="12" sm="4">
                            <MudSelect T="long?" @bind-Value="_uploadTypeId" Label="@L.Translate("EmpDocType")" Clearable="true" Dense="true">
                                @foreach (var t in _docTypes)
                                {
                                    <MudSelectItem T="long?" Value="@((long?)t.id)">@DocTypeLabel(t)</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="5">
                            <MudTextField @bind-Value="_uploadRemark" Label="@L.Translate("EmpDocRemark")" />
                        </MudItem>
                        <MudItem xs="12" sm="3">
                            <MudFileUpload T="IBrowserFile" FilesChanged="UploadDocAsync">
                                <ActivatorContent>
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.UploadFile">@L.Translate("EmpDocUpload")</MudButton>
                                </ActivatorContent>
                            </MudFileUpload>
                        </MudItem>
                    </MudGrid>
                    <MudDivider Class="my-3" />
                }

                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4" Class="mb-2" Wrap="Wrap.Wrap">
                    <MudSelect T="long?" @bind-Value="_filterTypeId" Label="@L.Translate("EmpDocFilterByType")" Clearable="true" Dense="true" Style="max-width: 280px;">
                        <MudSelectItem T="long?" Value="@((long?)null)">@L.Translate("EmpDocTypeAll")</MudSelectItem>
                        @foreach (var t in _docTypes)
                        {
                            <MudSelectItem T="long?" Value="@((long?)t.id)">@DocTypeLabel(t)</MudSelectItem>
                        }
                    </MudSelect>
                    @if (!ReadOnlyDocuments)
                    {
                        @* CEO: multiple documents of a type stay active side by side;
                           deactivation is a manual per-row choice, never automatic.
                           This switch reveals the superseded versions (history). *@
                        <MudSwitch T="bool" @bind-Value="_showHistory" Color="Color.Primary" Label="@L.Translate("EmpDocShowHistory")" />
                    }
                </MudStack>

                <MudTable Items="VisibleDocuments" Dense="true" Class="mt-1">
                    <HeaderContent>
                        <MudTh>@L.Translate("EmpDocType")</MudTh>
                        <MudTh>@L.Translate("EmpDocFile")</MudTh>
                        <MudTh>@L.Translate("EmpDocAttachedDate")</MudTh>
                        <MudTh>@L.Translate("EmpDocAttachedBy")</MudTh>
                        <MudTh>@L.Translate("EmpDocRemark")</MudTh>
                        <MudTh>@L.Translate("EmpDocStatus")</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@(context.mas_doc_type is null ? L.Translate("EmpDocTypeUnspecified") : DocTypeLabel(context.mas_doc_type))</MudTd>
                        <MudTd><MudLink Href="@($"{DocumentDownloadRoute}/{context.id}")" Target="_blank">@context.files</MudLink></MudTd>
                        <MudTd>@(context.moddate?.ToString("dd/MM/yyyy HH:mm") ?? "-")</MudTd>
                        <MudTd>@(context.modby ?? "-")</MudTd>
                        <MudTd>@(context.remark ?? "-")</MudTd>
                        <MudTd>
                            @if (context.isActive == true)
                            {
                                <MudChip T="string" Color="Color.Success" Size="Size.Small">@L.Translate("EmpDocActive")</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Color="Color.Default" Size="Size.Small">@L.Translate("EmpDocInactive")</MudChip>
                            }
                        </MudTd>
                        <MudTd>
                            @if (!ReadOnlyDocuments)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text"
                                           Color="@(context.isActive == true ? Color.Warning : Color.Success)"
                                           OnClick="@(() => ToggleDocActiveAsync(context))">
                                    @(context.isActive == true ? L.Translate("EmpDocDeactivate") : L.Translate("EmpDocReactivate"))
                                </MudButton>
                            }
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent><MudText Typo="Typo.body2">@L.Translate("EmpDocNoFiles")</MudText></NoRecordsContent>
                </MudTable>
            </MudTabPanel>
        </MudTabs>
    </MudPaper>
}

@code {
    [Parameter] public long HremployeeId { get; set; }

    // ESS mode (employee viewing their own record): active documents only,
    // no upload form, no active/superseded toggle — read-only list per CEO
    // order. HR mode (default) gets the full manage view.
    [Parameter] public bool ReadOnlyDocuments { get; set; }

    // Download route prefix for document rows. The default is the HR route
    // (Menu:PAY_ADMIN); the ESS host page passes "/ess/files/profile-doc"
    // (Endpoints/EssFileEndpoints.cs), which checks self-ownership instead.
    [Parameter] public string DocumentDownloadRoute { get; set; } = "/employee/files/doc";

    private Hremployee? _emp;
    private bool _notFound;

    private Pos_PositionSlot? _currentSlot;
    private string? _orgName;
    private address? _currentAddress;
    private address? _registeredAddress;
    private List<Hrd_Family> _family = new();
    private List<Hrd_Family> _children = new();
    private List<Hrd_Education> _education = new();
    private List<Hrd_Experience> _experience = new();
    private List<Hrd_ContactPerson> _contactPersons = new();
    private List<Perf_EvaluationInstance> _evaluations = new();
    private List<Pay_PositionSalaryHistory> _positionHistory = new();
    private List<Hrd_EmploymentHistory> _committeeHistory = new();
    private List<doc_center> _documents = new();
    private List<mas_doc_type> _docTypes = new();
    private long? _uploadTypeId;
    private string? _uploadRemark;
    private long? _filterTypeId;
    private bool _showHistory;

    // Filter/history are applied in memory over the already-loaded rows —
    // the per-employee document count is small, and this keeps the toggle
    // and filter instant. ESS loads active rows only (see the query below),
    // so _showHistory can never leak superseded versions there.
    private IEnumerable<doc_center> VisibleDocuments => _documents
        .Where(d => _showHistory || d.isActive == true)
        .Where(d => _filterTypeId == null || d.mas_doc_type_id == _filterTypeId);

    protected override async Task OnParametersSetAsync()
    {
        if (HremployeeId == 0) { _emp = null; return; }

        await using var context = await DbFactory.CreateDbContextAsync();
        _emp = await context.Hremployee.FirstOrDefaultAsync(e => e.id == HremployeeId);
        if (_emp is null) { _notFound = true; return; }
        _notFound = false;

        _currentSlot = await context.Pos_PositionSlots.FirstOrDefaultAsync(s => s.HremployeeId == HremployeeId && s.IsActive);
        if (_currentSlot?.OrganizationId is not null)
        {
            var org = await context.com_organizations.FirstOrDefaultAsync(o => o.id == _currentSlot.OrganizationId);
            _orgName = org is null ? null : $"{org.code} — {org.name}";
        }
        else
        {
            _orgName = null;
        }

        var addresses = await context.addresses.Include(a => a.address_typeNavigation)
            .Where(a => a.hremployeeid == HremployeeId && a.isactive).ToListAsync();
        _currentAddress = addresses.FirstOrDefault(a => a.address_typeNavigation?.code == "CUR");
        _registeredAddress = addresses.FirstOrDefault(a => a.address_typeNavigation?.code == "REG");

        var allFamily = await context.Hrd_Families.Where(f => f.HremployeeId == HremployeeId).ToListAsync();
        _family = allFamily.Where(f => !f.IsChild).ToList();
        _children = allFamily.Where(f => f.IsChild).ToList();

        _education = await context.Hrd_Educations.Where(e => e.HremployeeId == HremployeeId)
            .OrderByDescending(e => e.IsHighestDegree).ThenByDescending(e => e.FinishedDate).ToListAsync();
        _experience = await context.Hrd_Experiences.Where(e => e.HremployeeId == HremployeeId).OrderByDescending(e => e.StartDate).ToListAsync();
        _contactPersons = await context.Hrd_ContactPersons.Where(c => c.HremployeeId == HremployeeId).ToListAsync();

        _evaluations = await context.Perf_EvaluationInstances.Include(p => p.EvaluationPeriod)
            .Where(p => p.HremployeeId == HremployeeId).OrderByDescending(p => p.Id).ToListAsync();

        _positionHistory = await context.Pay_PositionSalaryHistories.Where(h => h.HremployeeId == HremployeeId)
            .OrderByDescending(h => h.ChangedDate).ToListAsync();

        // ประวัติทำงานในคณะทำงาน/คณะกรรมการ — no separate table: reuses
        // Pos_EmployeeType (HR tags the position's employee type "กรรมการ")
        // + Hrd_EmploymentHistory (formal appointment/order record). A row
        // counts as committee history when its NewPosExecTypeId points to a
        // Pos_ExecType whose EmployeeTypeId resolves to a Pos_EmployeeType
        // named "กรรมการ" — set that up via /pos/employee-types and
        // /pos/exec-types, then record the appointment at
        // /employee/{id}/employment-history like any other position change.
        var committeeTypeIds = await context.Pos_EmployeeTypes
            .Where(t => t.Name == "กรรมการ")
            .Select(t => t.Id)
            .ToListAsync();
        var committeeExecTypeIds = committeeTypeIds.Count == 0
            ? new List<long>()
            : await context.Pos_ExecTypes
                .Where(e => e.EmployeeTypeId != null && committeeTypeIds.Contains(e.EmployeeTypeId.Value))
                .Select(e => e.Id)
                .ToListAsync();
        _committeeHistory = committeeExecTypeIds.Count == 0
            ? new List<Hrd_EmploymentHistory>()
            : await context.Hrd_EmploymentHistories
                .Where(h => h.HremployeeId == HremployeeId && h.NewPosExecTypeId != null && committeeExecTypeIds.Contains(h.NewPosExecTypeId.Value))
                .OrderByDescending(h => h.EffectiveDate)
                .ToListAsync();

        // Employee-document types: legacy mas_doc_type master, rows tagged
        // group_ref = "EMPLOYEE_PROFILE_DOC" (seeded idempotently at startup
        // by Services/Hr/EmployeeDocTypeSeeder — standard types per CEO order).
        _docTypes = await context.mas_doc_types
            .Where(t => t.group_ref == EmployeeDocTypeSeeder.GroupRef && t.isActive)
            .OrderBy(t => t.orderTh).ThenBy(t => t.name)
            .ToListAsync();

        _documents = await LoadDocumentsAsync(context);

        await AuditLogger.LogAccessAsync("Hremployee", HremployeeId.ToString(), isSensitive: true, note: "personnel profile view");
    }

    // One query shape for both hosts: ESS (ReadOnlyDocuments) sees active
    // rows only; HR loads everything and the "ดูของเก่า" switch decides what
    // renders. doctypecode stays "EMPLOYEE_PROFILE_DOC" for every row (the
    // download endpoints key on it); the document TYPE rides in
    // mas_doc_type_id, the FK the legacy table already has.
    private async Task<List<doc_center>> LoadDocumentsAsync(HRMContext context)
    {
        var query = context.doc_centers.Include(d => d.mas_doc_type)
            .Where(d => d.doctypecode == "EMPLOYEE_PROFILE_DOC" && d.refid == HremployeeId);
        if (ReadOnlyDocuments)
            query = query.Where(d => d.isActive == true);
        return await query.OrderByDescending(d => d.moddate).ToListAsync();
    }

    private async Task UploadDocAsync(IBrowserFile file)
    {
        if (ReadOnlyDocuments) return; // ESS mode never renders the upload form; belt-and-braces

        if (_uploadTypeId is null)
        {
            Snackbar.Add(L.Translate("EmpDocSelectTypeFirst"), Severity.Warning);
            return;
        }

        try
        {
            const long maxSize = 10 * 1024 * 1024; // 10 MB
            await using var stream = file.OpenReadStream(maxSize);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var bytes = ms.ToArray();

            var storedFileName = $"{HremployeeId}_{Guid.NewGuid():N}_{file.Name}";
            var (relativePath, _) = await FileStorage.SaveAsync("employee-profile-docs", storedFileName, bytes);

            await using var context = await DbFactory.CreateDbContextAsync();
            // doc_center.id is a real IDENTITY column (verified via
            // sys.columns.is_identity), so plain Add is safe. Note: a new
            // upload NEVER deactivates older documents of the same type —
            // CEO explicitly wants several active at once, with a manual
            // per-row "ปลดเป็นของเก่า" toggle instead.
            context.doc_centers.Add(new doc_center
            {
                refid = HremployeeId,
                doctypecode = "EMPLOYEE_PROFILE_DOC",
                mas_doc_type_id = _uploadTypeId,
                files = file.Name,
                path = relativePath,
                remark = string.IsNullOrWhiteSpace(_uploadRemark) ? null : _uploadRemark.Trim(),
                isActive = true,
                moddate = DateTime.Now,
                modby = await CurrentActorAsync(),
            });
            await context.SaveChangesAsync();

            Snackbar.Add(string.Format(L.Translate("EmpDocUploadSuccessTemplate"), file.Name), Severity.Success);
            _uploadRemark = null;
            _documents = await LoadDocumentsAsync(context);
        }
        catch (Exception ex)
        {
            Snackbar.Add(L.Translate("EmpDocUploadFailed") + ": " + ex.Message, Severity.Error);
        }
    }

    // Manual per-row active/superseded flip — soft state change only, the
    // row and the stored file are never deleted (version history). The
    // automatic audit hook in HRMContext.Audit.cs logs the update.
    private async Task ToggleDocActiveAsync(doc_center doc)
    {
        if (ReadOnlyDocuments) return;

        await using var context = await DbFactory.CreateDbContextAsync();
        var row = await context.doc_centers.FirstOrDefaultAsync(d => d.id == doc.id);
        if (row is null) return;

        row.isActive = row.isActive != true;
        row.moddate = DateTime.Now;
        row.modby = await CurrentActorAsync();
        await context.SaveChangesAsync();

        _documents = await LoadDocumentsAsync(context);
        Snackbar.Add(L.Translate("EmpDocStatusUpdated"), Severity.Success);
    }

    private async Task<string> CurrentActorAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        return state.User.Identity?.Name ?? "unknown";
    }

    private string DocTypeLabel(mas_doc_type t)
        => L.CurrentLanguage == "en" && !string.IsNullOrWhiteSpace(t.name_en) ? t.name_en! : (t.name ?? t.code ?? "-");

    private string TenureText()
    {
        if (_emp?.WorkDate is null) return "-";
        var span = DateTime.Today - _emp.WorkDate.Value;
        var years = span.Days / 365;
        var months = (span.Days % 365) / 30;
        return $"{years} ปี {months} เดือน";
    }

    private static string SexLabel(string? sex) => sex switch
    {
        "M" => "ชาย",
        "F" => "หญิง",
        _ => sex ?? "-",
    };

    private static string AddressText(address a)
    {
        var parts = new[] { a.no, a.moo is null ? null : $"หมู่ {a.moo}", a.soi is null ? null : $"ซอย{a.soi}", a.road is null ? null : $"ถนน{a.road}", a.subdistrict, a.districtid, a.province, a.postcode };
        var text = string.Join(" ", parts.Where(p => !string.IsNullOrWhiteSpace(p)));
        return string.IsNullOrWhiteSpace(text) ? "-" : text;
    }

    private static string ChangeTypeLabel(string? changeType) => changeType switch
    {
        "P" => "เลื่อนตำแหน่ง",
        "D" => "ลดตำแหน่ง",
        "T" => "โยกย้าย",
        "S" => "ปรับเงินเดือน",
        "O" => "อื่นๆ",
        _ => changeType ?? "-",
    };
}
