@page "/force-change-password"
@using HRM.Services
@using HRM.Components.Shared
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inherits LocalizedComponentBase
@inject JsonLocalizationService L

@* The modern SysMgmt/User/PasswdAction.jsp. Reached only by
   Middleware/ForcePasswordChangeMiddleware, which pins every request from a
   user whose password must be replaced (admin reset / brand-new account /
   expired) to this page until they've done it. *@

<h3>@L.Translate("ForceChangePasswordTitle")</h3>

@* No reason = the user came here on their own (the expiry-warning banner in
   MainLayout links here before the hard gate ever fires), so there's nothing
   to explain — just show them the form. *@
@if (Reason == "expired")
{
    <div class="alert alert-warning">@L.Translate("ForceChangePasswordExpiredReason")</div>
}
else if (Reason == "forced")
{
    <div class="alert alert-info">@L.Translate("ForceChangePasswordForcedReason")</div>
}

@if (Error == "mismatch")
{
    <div class="alert alert-danger">@L.Translate("ResetPasswordMismatchError")</div>
}
else if (Error == "weak")
{
    <div class="alert alert-danger">@L.Translate("ResetPasswordWeakError")</div>
}
else if (Error == "wrongcurrent")
{
    <div class="alert alert-danger">@L.Translate("ForceChangePasswordWrongCurrentError")</div>
}
else if (Error == "same")
{
    <div class="alert alert-danger">@L.Translate("ForceChangePasswordSameError")</div>
}
else if (Error == "invalid")
{
    <div class="alert alert-danger">@L.Translate("ResetPasswordInvalidLinkError")</div>
}

@* Plain HTML form posted to a real endpoint (Endpoints/PasswordPolicyEndpoints.cs)
   rather than a Blazor event handler — the handler ends with
   RefreshSignInAsync, which has to rewrite the auth cookie on a live HTTP
   response. Same reason /login-handler works this way. *@
<form method="post" action="/force-change-password-handler">
    <div class="mb-3">
        <label>@L.Translate("CurrentPasswordLabel")</label>
        <input class="form-control" name="currentPassword" type="password" required autocomplete="current-password" />
    </div>
    <div class="mb-3">
        <label>@L.Translate("NewPasswordLabel")</label>
        <input class="form-control" name="newPassword" type="password" required autocomplete="new-password" />
    </div>
    <div class="mb-3">
        <label>@L.Translate("ConfirmNewPasswordLabel")</label>
        <input class="form-control" name="confirmPassword" type="password" required autocomplete="new-password" />
    </div>
    <button type="submit" class="btn btn-primary">@L.Translate("ForceChangePasswordSubmitButton")</button>
</form>

<p class="mt-3"><a href="/logout">@L.Translate("Logout")</a></p>

@code {
    [SupplyParameterFromQuery]
    private string? Error { get; set; }

    // Set by ForcePasswordChangeMiddleware's claim value ("forced"/"expired")
    // when it redirects here, so the page can say *why* without guessing.
    [SupplyParameterFromQuery]
    private string? Reason { get; set; }
}
