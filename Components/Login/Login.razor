    private async Task HandleLogin()
    {
        context = DbFactory.CreateDbContext();

        // 1. ดึง user ตาม loginname
        var user = await context.sc_users.FirstOrDefaultAsync(u => u.loginname == loginModel.Username);

        if (user != null && !user.isdisable && !user.iscancel && user.isActivate)
        {
            // 2. ใช้ PasswordHasher ตรวจสอบความถูกต้องของรหัสผ่าน
            var result = PasswordHasher.VerifyHashedPassword(user, user.password ?? "", loginModel.Password);

            if (result == PasswordVerificationResult.Success)
            {
                var claims = new List<Claim>
            {
                new Claim(ClaimTypes.Name, user.firstname + " " + user.lastname),
                new Claim("userid", user.userid.ToString()),
                new Claim("username", user.loginname),
                new Claim("company_id", user.company_id.ToString())
            };

                var identity = new ClaimsIdentity(claims, CookieAuthenticationDefaults.AuthenticationScheme);
                var principal = new ClaimsPrincipal(identity);

                await HttpContextAccessor.HttpContext!.SignInAsync(
                    CookieAuthenticationDefaults.AuthenticationScheme, principal);
                Logger.LogInformation("Check login for user: {Username}", loginModel.Username);
                Logger.LogInformation("Stored hash: {Hash}", user.password);
                Logger.LogInformation("Login input password: {Input}", loginModel.Password);

                Logger.LogInformation("Login success for: {Username}", user.loginname);
                Navigation.NavigateTo("/sc_users");
                return;
            }
        }

        errorMessage = "รหัสผ่านหรือชื่อผู้ใช้งานไม่ถูกต้อง หรือบัญชีถูกปิดใช้งาน";
    }


    public class LoginModel
    {
        [Required]
        public string Username { get; set; } = string.Empty;

        [Required]
        public string Password { get; set; } = string.Empty;
    }
}
