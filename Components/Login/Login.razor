@page "/login"

<h3>Login</h3>

@if (Error == "1")
{
    <div class="alert alert-danger">รหัสผ่านหรือชื่อผู้ใช้งานไม่ถูกต้อง หรือบัญชีถูกปิดใช้งาน</div>
}

@* Plain HTML form posted to /login-handler (a real endpoint, not a Blazor
   event handler) — see Program.cs for why the sign-in must happen there. *@
<form method="post" action="/login-handler">
    <input type="hidden" name="returnUrl" value="@ReturnUrl" />
    <div class="mb-3">
        <label>Username</label>
        <input class="form-control" name="username" required />
    </div>
    <div class="mb-3">
        <label>Password</label>
        <input class="form-control" name="password" type="password" required />
    </div>
    <button type="submit" class="btn btn-primary">Login</button>
</form>

@code {
    [SupplyParameterFromQuery]
    private string? Error { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }
}
