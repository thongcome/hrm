@page "/login"
@using HRM.Services
@inject JsonLocalizationService L

<h3>@L.Translate("Login")</h3>

@if (Error == "1")
{
    <div class="alert alert-danger">@L.Translate("LoginErrorMessage")</div>
}

@* Plain HTML form posted to /login-handler (a real endpoint, not a Blazor
   event handler) — see Program.cs for why the sign-in must happen there. *@
<form method="post" action="/login-handler">
    <input type="hidden" name="returnUrl" value="@ReturnUrl" />
    <div class="mb-3">
        <label>@L.Translate("Username")</label>
        <input class="form-control" name="username" required />
    </div>
    <div class="mb-3">
        <label>@L.Translate("Password")</label>
        <input class="form-control" name="password" type="password" required />
    </div>
    <button type="submit" class="btn btn-primary">@L.Translate("Login")</button>
</form>

@code {
    [SupplyParameterFromQuery]
    private string? Error { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }
}
