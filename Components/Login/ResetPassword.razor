@page "/reset-password"
@using HRM.Services
@using HRM.Components.Shared
@inherits LocalizedComponentBase
@inject JsonLocalizationService L

<h3>@L.Translate("ResetPasswordTitle")</h3>

@if (string.IsNullOrEmpty(Username) || string.IsNullOrEmpty(Token))
{
    <div class="alert alert-danger">@L.Translate("ResetPasswordMissingLinkError")</div>
    <p><a href="/forgot-password">@L.Translate("ForgotPasswordTitle")</a></p>
}
else
{
    @if (Error == "mismatch")
    {
        <div class="alert alert-danger">@L.Translate("ResetPasswordMismatchError")</div>
    }
    else if (Error == "weak")
    {
        <div class="alert alert-danger">@L.Translate("ResetPasswordWeakError")</div>
    }
    else if (Error == "invalid")
    {
        <div class="alert alert-danger">@L.Translate("ResetPasswordInvalidLinkError")</div>
        <p><a href="/forgot-password">@L.Translate("ForgotPasswordTitle")</a></p>
    }

    @* Plain HTML form posted to /reset-password-handler (a real endpoint,
       not a Blazor event handler) — see Endpoints/ForgotPasswordEndpoints.cs. *@
    <form method="post" action="/reset-password-handler">
        <input type="hidden" name="username" value="@Username" />
        <input type="hidden" name="token" value="@Token" />
        <div class="mb-3">
            <label>@L.Translate("NewPasswordLabel")</label>
            <input class="form-control" name="newPassword" type="password" required />
        </div>
        <div class="mb-3">
            <label>@L.Translate("ConfirmNewPasswordLabel")</label>
            <input class="form-control" name="confirmPassword" type="password" required />
        </div>
        <button type="submit" class="btn btn-primary">@L.Translate("ResetPasswordSubmitButton")</button>
    </form>
}

@code {
    [SupplyParameterFromQuery(Name = "u")]
    private string? Username { get; set; }

    [SupplyParameterFromQuery(Name = "t")]
    private string? Token { get; set; }

    [SupplyParameterFromQuery]
    private string? Error { get; set; }
}
