@page "/forgot-password"
@using HRM.Services
@using HRM.Components.Shared
@inherits LocalizedComponentBase
@inject JsonLocalizationService L

<h3>@L.Translate("ForgotPasswordTitle")</h3>

@if (Sent == "1")
{
    <div class="alert alert-success">@L.Translate("ForgotPasswordSentMessage")</div>
}
else
{
    <p>@L.Translate("ForgotPasswordInstructions")</p>

    @* Plain HTML form posted to /forgot-password-handler (a real endpoint,
       not a Blazor event handler) — see Endpoints/ForgotPasswordEndpoints.cs. *@
    <form method="post" action="/forgot-password-handler">
        <div class="mb-3">
            <label>@L.Translate("Username")</label>
            <input class="form-control" name="username" required />
        </div>
        <button type="submit" class="btn btn-primary">@L.Translate("ForgotPasswordSubmitButton")</button>
    </form>
}

<p class="mt-3"><a href="/login">@L.Translate("BackToLoginLink")</a></p>

@code {
    [SupplyParameterFromQuery]
    private string? Sent { get; set; }
}
