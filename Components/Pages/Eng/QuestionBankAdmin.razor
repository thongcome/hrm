@page "/eng/question-bank"
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Engagement
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@inject QuestionTemplateService QuestionService
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@attribute [Authorize(Policy = "Menu:ENG_ADMIN")]

<PageTitle>คลังคำถาม (Engagement)</PageTitle>

<MudPaper Class="pa-4 mb-4" MaxWidth="900px">
    <MudText Typo="Typo.h5">คลังคำถามสำหรับ Survey / Pulse / eNPS</MudText>
    <MudText Typo="Typo.body2" Class="mt-1">
        คำถามที่นี่เป็นแม่แบบ — ตอนสร้างแคมเปญระบบจะคัดลอกข้อความ/ประเภทมาเก็บแยกไว้ในแคมเปญ (snapshot) แก้ไขที่นี่ทีหลังจะไม่กระทบแคมเปญที่เปิดไปแล้ว
    </MudText>

    @if (string.IsNullOrEmpty(_companyId))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">บัญชีของคุณยังไม่ได้ผูกกับบริษัทใดๆ</MudAlert>
    }
    else
    {
        <MudDivider Class="my-4" />

        <MudTextField T="string" Value="_searchTerm" Label="ค้นหา (ข้อความคำถาม)" Immediate="true" DebounceInterval="300"
            ValueChanged="OnSearchChangedAsync" AdornmentIcon="@Icons.Material.Filled.Search" Adornment="Adornment.Start" Class="mb-3" />

        <MudTable Items="_templates" Dense="true" Hover="true">
            <HeaderContent>
                <MudTh>คำถาม</MudTh>
                <MudTh>ประเภท</MudTh>
                <MudTh>ตัวเลือก (สำหรับ Multiple Choice)</MudTh>
                <MudTh>สถานะ</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Text</MudTd>
                <MudTd>@QuestionTypeLabel(context.QuestionType)</MudTd>
                <MudTd>@context.Options</MudTd>
                <MudTd>@(context.IsActive ? "ใช้งาน" : "ปิดใช้งาน")</MudTd>
                <MudTd>
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => EditTemplate(context))">แก้ไข</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="@(() => ToggleActiveAsync(context))">
                        @(context.IsActive ? "ปิดใช้งาน" : "เปิดใช้งาน")
                    </MudButton>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText Typo="Typo.body2">ยังไม่มีคำถามในคลัง</MudText></NoRecordsContent>
        </MudTable>

        <MudDivider Class="my-5" />

        <MudText Typo="Typo.h6">@(_editingId is null ? "เพิ่มคำถามใหม่" : "แก้ไขคำถาม")</MudText>
        <MudGrid Class="mt-2">
            <MudItem xs="12"><MudTextField @bind-Value="_form.Text" Label="ข้อความคำถาม" Lines="2" /></MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="Eng_QuestionType" @bind-Value="_form.QuestionType" Label="ประเภทคำถาม">
                    <MudSelectItem Value="Eng_QuestionType.Rating">ให้คะแนน (1-5)</MudSelectItem>
                    <MudSelectItem Value="Eng_QuestionType.YesNo">ใช่/ไม่ใช่</MudSelectItem>
                    <MudSelectItem Value="Eng_QuestionType.Text">ข้อความอิสระ</MudSelectItem>
                    <MudSelectItem Value="Eng_QuestionType.MultipleChoice">ตัวเลือกหลายข้อ</MudSelectItem>
                </MudSelect>
            </MudItem>
            @if (_form.QuestionType == Eng_QuestionType.MultipleChoice)
            {
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_form.Options" Label="ตัวเลือก (คั่นด้วยเครื่องหมายจุลภาค)" Placeholder="เช่น เห็นด้วยมาก, เห็นด้วย, ไม่เห็นด้วย" />
                </MudItem>
            }
        </MudGrid>

        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
        }

        <MudStack Row="true" Spacing="2" Class="mt-4">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">@(_editingId is null ? "เพิ่ม" : "บันทึก")</MudButton>
            @if (_editingId is not null)
            {
                <MudButton Variant="Variant.Text" OnClick="CancelEdit">ยกเลิก</MudButton>
            }
        </MudStack>
    }
</MudPaper>

@code {
    private string? _companyId;
    private List<Eng_QuestionTemplate> _templates = new();
    private string? _searchTerm;
    private string? _error;
    private long? _editingId;
    private Eng_QuestionTemplate _form = new() { IsActive = true };

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
        if (string.IsNullOrWhiteSpace(_companyId)) return;
        await LoadAsync();
    }

    private async Task OnSearchChangedAsync(string term)
    {
        _searchTerm = term;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _templates = await QuestionService.GetAllAsync(_companyId!, _searchTerm);
    }

    private void EditTemplate(Eng_QuestionTemplate template)
    {
        _editingId = template.Id;
        _form = new Eng_QuestionTemplate
        {
            Id = template.Id,
            Text = template.Text,
            QuestionType = template.QuestionType,
            Options = template.Options,
            IsActive = template.IsActive,
        };
    }

    private void CancelEdit()
    {
        _editingId = null;
        _form = new Eng_QuestionTemplate { IsActive = true };
        _error = null;
    }

    private async Task SaveAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_form.Text))
        {
            _error = "กรุณากรอกข้อความคำถาม";
            return;
        }

        _form.CompanyId = _companyId!;
        await QuestionService.SaveAsync(_form);
        Snackbar.Add("บันทึกเรียบร้อย", Severity.Success);
        CancelEdit();
        await LoadAsync();
    }

    private async Task ToggleActiveAsync(Eng_QuestionTemplate template)
    {
        await QuestionService.ToggleActiveAsync(template.Id);
        await LoadAsync();
    }

    private static string QuestionTypeLabel(Eng_QuestionType t) => t switch
    {
        Eng_QuestionType.Rating => "ให้คะแนน (1-5)",
        Eng_QuestionType.YesNo => "ใช่/ไม่ใช่",
        Eng_QuestionType.Text => "ข้อความอิสระ",
        Eng_QuestionType.MultipleChoice => "ตัวเลือกหลายข้อ",
        _ => "-",
    };
}
