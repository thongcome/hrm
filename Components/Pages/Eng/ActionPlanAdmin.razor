@page "/eng/action-plans"
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Engagement
@using HRM.Services.Shared
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject ActionPlanService ActionPlanService
@inject ISnackbar Snackbar
@attribute [Authorize(Policy = "Menu:ENG_ADMIN")]

<PageTitle>แผนปฏิบัติการ — Employee Engagement</PageTitle>

@if (string.IsNullOrEmpty(_companyId))
{
    <MudAlert Severity="Severity.Error" Class="ma-4">บัญชีของคุณยังไม่ได้ผูกกับบริษัทใดๆ</MudAlert>
}
else
{
    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h5">แผนปฏิบัติการ (Action Plan)</MudText>
        <MudText Typo="Typo.body2" Class="mt-1 mb-3">ติดตามการดำเนินการต่อยอดหลังปิดแบบสำรวจ พร้อมรายการติดตามความคืบหน้า</MudText>

        <MudTable Items="_plans" Dense="true" Hover="true">
            <HeaderContent>
                <MudTh>ชื่อแผน</MudTh>
                <MudTh>แคมเปญที่เกี่ยวข้อง</MudTh>
                <MudTh>สถานะ</MudTh>
                <MudTh>ความคืบหน้า</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Title</MudTd>
                <MudTd>@(context.CampaignTitle ?? "-")</MudTd>
                <MudTd>
                    <MudSelect T="Eng_ActionPlanStatus" Value="context.Status" ValueChanged="@(v => UpdateStatusAsync(context.Id, v))" Dense="true">
                        @foreach (var v in Enum.GetValues<Eng_ActionPlanStatus>())
                        {
                            <MudSelectItem Value="@v">@StatusLabel(v)</MudSelectItem>
                        }
                    </MudSelect>
                </MudTd>
                <MudTd>@context.CompletedMilestones / @context.TotalMilestones</MudTd>
                <MudTd><MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => ToggleMilestonesAsync(context.Id))">@(_expandedId == context.Id ? "ซ่อน" : "จัดการรายการ")</MudButton></MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText Typo="Typo.body2">ยังไม่มีแผนปฏิบัติการ</MudText></NoRecordsContent>
        </MudTable>
    </MudPaper>

    @if (_expandedId is not null)
    {
        <MudPaper Class="pa-4 mb-4">
            <MudText Typo="Typo.h6" Class="mb-2">รายการติดตาม</MudText>
            <MudTable Items="_milestones" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh>รายการ</MudTh>
                    <MudTh>กำหนดเสร็จ</MudTh>
                    <MudTh>สถานะ</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Title</MudTd>
                    <MudTd>@(context.TargetDate?.ToString("dd/MM/yyyy") ?? "-")</MudTd>
                    <MudTd><MudChip T="string" Size="Size.Small" Color="@(context.Status == Eng_MilestoneStatus.Completed ? Color.Success : Color.Default)">@(context.Status == Eng_MilestoneStatus.Completed ? "เสร็จแล้ว" : "รอดำเนินการ")</MudChip></MudTd>
                    <MudTd>
                        @if (context.Status == Eng_MilestoneStatus.Pending)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => CompleteMilestoneAsync(context.Id))">เสร็จ</MudButton>
                        }
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText Typo="Typo.body2">ยังไม่มีรายการ</MudText></NoRecordsContent>
            </MudTable>

            <MudGrid Class="mt-2">
                <MudItem xs="12" sm="8"><MudTextField T="string" @bind-Value="_newMilestoneTitle" Label="รายการใหม่" /></MudItem>
                <MudItem xs="12" sm="4"><MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="AddMilestoneAsync" Disabled="@string.IsNullOrWhiteSpace(_newMilestoneTitle)">เพิ่ม</MudButton></MudItem>
            </MudGrid>
        </MudPaper>
    }

    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" Class="mb-2">สร้างแผนใหม่</MudText>
        <MudGrid>
            <MudItem xs="12" sm="6"><MudTextField T="string" @bind-Value="_title" Label="ชื่อแผน" /></MudItem>
            <MudItem xs="12" sm="6">
                <MudAutocomplete T="Eng_SurveyCampaign" Label="แคมเปญที่เกี่ยวข้อง (ถ้ามี)" @bind-Value="_selectedCampaign"
                    SearchFunc="SearchCampaignsAsync"
                    ToStringFunc="@(c => c == null ? null : c.Title)"
                    ResetValueOnEmptyText="true" CoerceText="true" MinCharacters="0" Clearable="true" />
            </MudItem>
            <MudItem xs="12" sm="6"><MudDatePicker Label="วันเริ่มดำเนินการ" @bind-Date="_startDate" /></MudItem>
            <MudItem xs="12" sm="6"><MudDatePicker Label="กำหนดเสร็จ" @bind-Date="_targetDate" /></MudItem>
            <MudItem xs="12"><MudTextField T="string" @bind-Value="_description" Label="รายละเอียด" Lines="4" /></MudItem>
            <MudItem xs="12"><MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="CreateAsync" Disabled="@string.IsNullOrWhiteSpace(_title)">สร้างแผน</MudButton></MudItem>
        </MudGrid>
    </MudPaper>
}

@code {
    private string? _companyId;
    private List<ActionPlanService.ActionPlanRow> _plans = new();
    private long? _expandedId;
    private List<Eng_ActionPlanMilestone> _milestones = new();
    private string? _newMilestoneTitle;

    private string? _title;
    private Eng_SurveyCampaign? _selectedCampaign;
    private DateTime? _startDate;
    private DateTime? _targetDate;
    private string? _description;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
        if (string.IsNullOrWhiteSpace(_companyId)) return;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (string.IsNullOrEmpty(_companyId)) return;
        _plans = await ActionPlanService.GetActionPlansAsync(_companyId);
    }

    private async Task<IEnumerable<Eng_SurveyCampaign>> SearchCampaignsAsync(string search, CancellationToken ct)
    {
        await using var context = await DbFactory.CreateDbContextAsync(ct);
        var query = context.Eng_SurveyCampaigns.Where(c => c.CompanyId == _companyId);
        query = EntitySearchHelper.ApplyTextSearch(query, search, nameof(Eng_SurveyCampaign.Title));
        return await query.OrderByDescending(c => c.CreatedDate).Take(20).ToListAsync(ct);
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_title) || string.IsNullOrEmpty(_companyId)) return;

        var state = await AuthProvider.GetAuthenticationStateAsync();
        var userId = long.TryParse(state.User.FindFirstValue("sc_userid"), out var uid) ? uid : 0;

        await ActionPlanService.CreateAsync(_companyId, _selectedCampaign?.Id, _title, _description, userId, null,
            _startDate is null ? null : DateOnly.FromDateTime(_startDate.Value),
            _targetDate is null ? null : DateOnly.FromDateTime(_targetDate.Value), userId);

        Snackbar.Add("สร้างแผนเรียบร้อย", Severity.Success);
        _title = null;
        _selectedCampaign = null;
        _startDate = null;
        _targetDate = null;
        _description = null;
        await LoadAsync();
    }

    private async Task UpdateStatusAsync(long id, Eng_ActionPlanStatus status)
    {
        await ActionPlanService.UpdateStatusAsync(id, status);
        await LoadAsync();
    }

    private async Task ToggleMilestonesAsync(long id)
    {
        if (_expandedId == id)
        {
            _expandedId = null;
            return;
        }
        _expandedId = id;
        _milestones = await ActionPlanService.GetMilestonesAsync(id);
    }

    private async Task AddMilestoneAsync()
    {
        if (_expandedId is null || string.IsNullOrWhiteSpace(_newMilestoneTitle)) return;
        await ActionPlanService.AddMilestoneAsync(_expandedId.Value, _newMilestoneTitle, null);
        _newMilestoneTitle = null;
        _milestones = await ActionPlanService.GetMilestonesAsync(_expandedId.Value);
        await LoadAsync();
    }

    private async Task CompleteMilestoneAsync(long milestoneId)
    {
        await ActionPlanService.CompleteMilestoneAsync(milestoneId);
        if (_expandedId is not null)
            _milestones = await ActionPlanService.GetMilestonesAsync(_expandedId.Value);
        await LoadAsync();
    }

    private static string StatusLabel(Eng_ActionPlanStatus s) => s switch
    {
        Eng_ActionPlanStatus.Planned => "วางแผน",
        Eng_ActionPlanStatus.InProgress => "กำลังดำเนินการ",
        Eng_ActionPlanStatus.Completed => "เสร็จสมบูรณ์",
        Eng_ActionPlanStatus.Cancelled => "ยกเลิก",
        _ => s.ToString(),
    };
}
