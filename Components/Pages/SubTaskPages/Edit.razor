@page "/subtasks/edit"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using HRM.Model
@inject IDbContextFactory<HRM.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>SubTask</h2>
<hr />
@if (SubTask is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="SubTask" OnValidSubmit="UpdateSubTask" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary />
                <input type="hidden" name="SubTask.SubId" value="@SubTask.SubId" />
                <div class="mb-3">
                    <label for="taskid" class="form-label">TaskId:</label>
                    <InputNumber id="taskid" @bind-Value="SubTask.TaskId" class="form-control" />
                    <ValidationMessage For="() => SubTask.TaskId" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="name" class="form-label">Name:</label>
                    <InputText id="name" @bind-Value="SubTask.Name" class="form-control" />
                    <ValidationMessage For="() => SubTask.Name" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="startdate" class="form-label">StartDate:</label>
                    <InputDate id="startdate" @bind-Value="SubTask.StartDate" class="form-control" />
                    <ValidationMessage For="() => SubTask.StartDate" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="enddate" class="form-label">EndDate:</label>
                    <InputDate id="enddate" @bind-Value="SubTask.EndDate" class="form-control" />
                    <ValidationMessage For="() => SubTask.EndDate" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="order" class="form-label">Order:</label>
                    <InputNumber id="order" @bind-Value="SubTask.Order" class="form-control" />
                    <ValidationMessage For="() => SubTask.Order" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="description" class="form-label">Description:</label>
                    <InputText id="description" @bind-Value="SubTask.Description" class="form-control" />
                    <ValidationMessage For="() => SubTask.Description" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="lessonmode" class="form-label">LessonMode:</label>
                    <InputText id="lessonmode" @bind-Value="SubTask.LessonMode" class="form-control" />
                    <ValidationMessage For="() => SubTask.LessonMode" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="lesson1" class="form-label">Lesson1:</label>
                    <InputText id="lesson1" @bind-Value="SubTask.Lesson1" class="form-control" />
                    <ValidationMessage For="() => SubTask.Lesson1" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="lesson2" class="form-label">Lesson2:</label>
                    <InputText id="lesson2" @bind-Value="SubTask.Lesson2" class="form-control" />
                    <ValidationMessage For="() => SubTask.Lesson2" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="thankfully" class="form-label">ThankFully:</label>
                    <InputText id="thankfully" @bind-Value="SubTask.ThankFully" class="form-control" />
                    <ValidationMessage For="() => SubTask.ThankFully" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="statuscode" class="form-label">StatusCode:</label>
                    <InputText id="statuscode" @bind-Value="SubTask.StatusCode" class="form-control" />
                    <ValidationMessage For="() => SubTask.StatusCode" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/subtasks">Back to List</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int SubId { get; set; }

    [SupplyParameterFromForm]
    private SubTask? SubTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        SubTask ??= await context.SubTasks.FirstOrDefaultAsync(m => m.SubId == SubId);

        if (SubTask is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateSubTask()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(SubTask!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!SubTaskExists(SubTask!.SubId))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/subtasks");
    }

    private bool SubTaskExists(int subid)
    {
        using var context = DbFactory.CreateDbContext();
        return context.SubTasks.Any(e => e.SubId == subid);
    }
}
