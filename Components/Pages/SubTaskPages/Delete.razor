@page "/subtasks/delete"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using HRM.Model
@inject IDbContextFactory<HRM.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>SubTask</h2>
    <hr />
    @if (subtask is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">TaskId</dt>
            <dd class="col-sm-10">@subtask.TaskId</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Name</dt>
            <dd class="col-sm-10">@subtask.Name</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">StartDate</dt>
            <dd class="col-sm-10">@subtask.StartDate</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">EndDate</dt>
            <dd class="col-sm-10">@subtask.EndDate</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Order</dt>
            <dd class="col-sm-10">@subtask.Order</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Description</dt>
            <dd class="col-sm-10">@subtask.Description</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">LessonMode</dt>
            <dd class="col-sm-10">@subtask.LessonMode</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Lesson1</dt>
            <dd class="col-sm-10">@subtask.Lesson1</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Lesson2</dt>
            <dd class="col-sm-10">@subtask.Lesson2</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">ThankFully</dt>
            <dd class="col-sm-10">@subtask.ThankFully</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">StatusCode</dt>
            <dd class="col-sm-10">@subtask.StatusCode</dd>
        </dl>
        <EditForm method="post" Model="subtask" OnValidSubmit="DeleteSubTask" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(subtask is null)">Delete</button> |
            <a href="/subtasks">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private SubTask? subtask;

    [SupplyParameterFromQuery]
    private int SubId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        subtask = await context.SubTasks.FirstOrDefaultAsync(m => m.SubId == SubId);

        if (subtask is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteSubTask()
    {
        using var context = DbFactory.CreateDbContext();
        context.SubTasks.Remove(subtask!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/subtasks");
    }
}
