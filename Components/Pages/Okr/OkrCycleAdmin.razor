@page "/okr/cycles"
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@attribute [Authorize(Policy = "Menu:OKR_ADMIN")]

<PageTitle>วงจร OKR (Cycle)</PageTitle>

<MudPaper Class="pa-4 mb-4" MaxWidth="900px">
    <MudText Typo="Typo.h5">วงจร OKR (Cycle)</MudText>
    <MudText Typo="Typo.body2" Class="mt-1">รอบเวลาของ OKR (มักเป็นรายไตรมาส) — แยกต่างหากจากรอบประเมินผลทางการโดยตั้งใจ</MudText>

    @if (string.IsNullOrEmpty(_companyId))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">บัญชีของคุณยังไม่ได้ผูกกับบริษัทใดๆ</MudAlert>
        return;
    }

    <MudDivider Class="my-4" />

    @if (!_showForm)
    {
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@(() => _showForm = true)">+ เพิ่มวงจรใหม่</MudButton>
    }

    @if (_showForm)
    {
        <MudText Typo="Typo.h6">@(_editingId is null ? "เพิ่มวงจรใหม่" : "แก้ไข")</MudText>
        <MudGrid Class="mt-1">
            <MudItem xs="12" sm="3"><MudTextField @bind-Value="_code" Label="รหัส" Required="true" /></MudItem>
            <MudItem xs="12" sm="5"><MudTextField @bind-Value="_name" Label="ชื่อวงจร" Required="true" /></MudItem>
            <MudItem xs="12" sm="2"><MudDatePicker @bind-Date="_startDate" Label="วันเริ่ม" /></MudItem>
            <MudItem xs="12" sm="2"><MudDatePicker @bind-Date="_endDate" Label="วันสิ้นสุด" /></MudItem>
            <MudItem xs="12" sm="4">
                <MudSwitch T="bool" @bind-Value="_isActive" Color="Color.Success" Label="ใช้งานอยู่" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSwitch T="bool" @bind-Value="_isLocked" Color="Color.Warning" Label="ล็อก (ห้ามแก้ไข/เพิ่มใหม่)" />
            </MudItem>
        </MudGrid>

        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
        }

        <MudStack Row="true" Spacing="2" Class="mt-3">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">บันทึก</MudButton>
            <MudButton Variant="Variant.Text" OnClick="CancelEdit">ยกเลิก</MudButton>
        </MudStack>
    }

    <MudDivider Class="my-5" />

    <MudTable Items="_items" Dense="true" Hover="true">
        <HeaderContent>
            <MudTh>รหัส</MudTh>
            <MudTh>ชื่อวงจร</MudTh>
            <MudTh>ช่วงวันที่</MudTh>
            <MudTh>สถานะ</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Code</MudTd>
            <MudTd>@context.Name</MudTd>
            <MudTd>@context.StartDate.ToString("dd/MM/yyyy") - @context.EndDate.ToString("dd/MM/yyyy")</MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">@(context.IsActive ? "ใช้งาน" : "ไม่ใช้งาน")</MudChip>
                @if (context.IsLocked)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ml-1">ล็อกแล้ว</MudChip>
                }
            </MudTd>
            <MudTd>
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => StartEdit(context))">แก้ไข</MudButton>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2">ยังไม่มีข้อมูล</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private string? _companyId;
    private List<Okr_Cycle> _items = new();
    private string? _error;
    private long? _editingId;
    private bool _showForm;

    private string _code = "";
    private string _name = "";
    private DateTime? _startDate = DateTime.Today;
    private DateTime? _endDate = DateTime.Today.AddMonths(3);
    private bool _isActive = true;
    private bool _isLocked;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
        if (string.IsNullOrWhiteSpace(_companyId)) return;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        _items = await context.Okr_Cycles.Where(c => c.CompanyId == _companyId)
            .OrderByDescending(c => c.StartDate).ToListAsync();
    }

    private void StartEdit(Okr_Cycle item)
    {
        _editingId = item.Id;
        _code = item.Code;
        _name = item.Name;
        _startDate = item.StartDate.ToDateTime(TimeOnly.MinValue);
        _endDate = item.EndDate.ToDateTime(TimeOnly.MinValue);
        _isActive = item.IsActive;
        _isLocked = item.IsLocked;
        _error = null;
        _showForm = true;
    }

    private void CancelEdit()
    {
        _editingId = null;
        _code = "";
        _name = "";
        _startDate = DateTime.Today;
        _endDate = DateTime.Today.AddMonths(3);
        _isActive = true;
        _isLocked = false;
        _error = null;
        _showForm = false;
    }

    private async Task SaveAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_code) || string.IsNullOrWhiteSpace(_name)) { _error = "กรุณาระบุรหัสและชื่อวงจร"; return; }
        if (_startDate is null || _endDate is null || _endDate < _startDate) { _error = "ช่วงวันที่ไม่ถูกต้อง"; return; }

        await using var context = await DbFactory.CreateDbContextAsync();

        if (_editingId is long id)
        {
            var existing = await context.Okr_Cycles.FirstOrDefaultAsync(c => c.Id == id && c.CompanyId == _companyId);
            if (existing is null) { _error = "ไม่พบข้อมูล"; return; }
            existing.Code = _code;
            existing.Name = _name;
            existing.StartDate = DateOnly.FromDateTime(_startDate.Value);
            existing.EndDate = DateOnly.FromDateTime(_endDate.Value);
            existing.IsActive = _isActive;
            existing.IsLocked = _isLocked;
        }
        else
        {
            context.Okr_Cycles.Add(new Okr_Cycle
            {
                CompanyId = _companyId!,
                Code = _code,
                Name = _name,
                StartDate = DateOnly.FromDateTime(_startDate.Value),
                EndDate = DateOnly.FromDateTime(_endDate.Value),
                IsActive = _isActive,
                IsLocked = _isLocked,
                CreatedDate = DateTime.Now,
            });
        }

        await context.SaveChangesAsync();
        Snackbar.Add("บันทึกเรียบร้อย", Severity.Success);
        CancelEdit();
        await LoadAsync();
    }
}
