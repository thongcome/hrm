@page "/succession/bench-strength"
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Succession
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@inject AuthenticationStateProvider AuthProvider
@inject SuccessionService SuccService
@inject NavigationManager Nav
@inject JsonLocalizationService L
@attribute [Authorize(Policy = "Menu:SUCC_ADMIN")]

<PageTitle>@L.Translate("BenchStrengthPageTitle")</PageTitle>

@if (string.IsNullOrEmpty(_companyId))
{
    <MudAlert Severity="Severity.Error" Class="ma-4">@L.Translate("CompanyNotLinkedShortError")</MudAlert>
}
else
{
    <MudButton Class="mb-2" Variant="Variant.Text" OnClick="@(() => Nav.NavigateTo("/succession/key-positions"))">← @L.Translate("BackToKeyPositionsButton")</MudButton>

    <MudPaper Class="pa-4 mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudText Typo="Typo.h5">@L.Translate("BenchStrengthReportHeading")</MudText>
            <MudChip T="string" Color="Color.Warning" Size="Size.Small">@L.Translate("ConfidentialDataChip")</MudChip>
        </MudStack>
        <MudText Typo="Typo.body2" Class="mt-1 mb-3">
            @L.Translate("BenchStrengthDesc")
        </MudText>

        @if (_rows.Any(r => r.IsSinglePointOfFailure))
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">
                @string.Format(L.Translate("SpofAlertTemplate"), _rows.Count(r => r.IsSinglePointOfFailure))
            </MudAlert>
        }
    </MudPaper>

    @if (_rows.Count > 0)
    {
        <MudPaper Class="pa-4 mb-4">
            <MudText Typo="Typo.h6" Class="mb-2">@L.Translate("RiskHeatmapHeading")</MudText>
            <MudGrid>
                <MudItem xs="1" Class="d-flex align-center justify-center">
                    <MudText Typo="Typo.subtitle2" Style="writing-mode: vertical-rl; transform: rotate(180deg);">@L.Translate("BusinessImpactLabel")</MudText>
                </MudItem>
                <MudItem xs="11">
                    <div style="display:grid; grid-template-columns: repeat(3, 1fr); gap: 8px;">
                        @foreach (var impactTier in new[] { 3, 2, 1 })
                        {
                            @foreach (var difficultyTier in new[] { 1, 2, 3 })
                            {
                                var cellKey = (impactTier, difficultyTier);
                                var cellRows = _heatmapCells.TryGetValue(cellKey, out var list) ? list : new();
                                var isExpanded = _expandedCell == cellKey;
                                <MudPaper Class="pa-3" Style="@GetHeatCellStyle(impactTier, difficultyTier)" Outlined="true">
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                        <MudText Typo="Typo.subtitle2">@GetHeatCellLabel(impactTier, difficultyTier)</MudText>
                                        <MudChip T="string" Size="Size.Small">@string.Format(L.Translate("PositionsCountTemplate"), cellRows.Count)</MudChip>
                                    </MudStack>
                                    @if (cellRows.Any(r => r.IsSinglePointOfFailure))
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Class="mt-1">
                                            @string.Format(L.Translate("NoSuccessorsCountTemplate"), cellRows.Count(r => r.IsSinglePointOfFailure))
                                        </MudChip>
                                    }
                                    @if (cellRows.Count > 0)
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => ToggleHeatCell(cellKey))" Class="mt-1">
                                            @(isExpanded ? L.Translate("CollapseButton") : L.Translate("ViewPositionListButton"))
                                        </MudButton>
                                    }
                                    @if (isExpanded)
                                    {
                                        @foreach (var row in cellRows)
                                        {
                                            <MudPaper Class="pa-2 mt-1" Outlined="true">
                                                <MudLink OnClick="@(() => Nav.NavigateTo($"/succession/key-positions/{row.KeyPositionId}"))">@row.PosExecTypeName</MudLink>
                                                <MudText Typo="Typo.caption">
                                                    @string.Format(L.Translate("ReadyNowOfTotalTemplate"), row.ReadyNowCount, row.TotalSuccessorCount)
                                                </MudText>
                                            </MudPaper>
                                        }
                                    }
                                </MudPaper>
                            }
                        }
                    </div>
                    <MudText Typo="Typo.caption" Class="mt-2" Align="Align.Center" Style="display:block">@L.Translate("ReplacementDifficultyLowToHighLabel")</MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>
    }

    <MudPaper Class="pa-4 mb-4">
        <MudTable Items="_rows" Dense="true" Hover="true">
            <HeaderContent>
                <MudTh>@L.Translate("ColPosition")</MudTh>
                <MudTh>@L.Translate("BusinessImpactLabel")</MudTh>
                <MudTh>@L.Translate("ReplacementDifficultyLabel")</MudTh>
                <MudTh>@L.Translate("ColReadyNow")</MudTh>
                <MudTh>@L.Translate("ColTotalSuccessors")</MudTh>
                <MudTh>@L.Translate("ColRisk")</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <MudLink OnClick="@(() => Nav.NavigateTo($"/succession/key-positions/{context.KeyPositionId}"))">@context.PosExecTypeName</MudLink>
                </MudTd>
                <MudTd>@ImpactLabel(context.BusinessImpact)</MudTd>
                <MudTd>@DifficultyLabel(context.ReplacementDifficulty)</MudTd>
                <MudTd>@context.ReadyNowCount</MudTd>
                <MudTd>@context.TotalSuccessorCount</MudTd>
                <MudTd>
                    @if (context.IsSinglePointOfFailure)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Error">@L.Translate("SinglePointOfFailureChip")</MudChip>
                    }
                    else if (context.ReadyNowCount == 0)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">@L.Translate("NoReadyNowChip")</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success">@L.Translate("NormalChip")</MudChip>
                    }
                </MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText Typo="Typo.body2">@L.Translate("NoKeyPositionsDefinedMessage")</MudText></NoRecordsContent>
        </MudTable>
    </MudPaper>
}

@code {
    private string? _companyId;
    private List<SuccessionService.BenchStrengthRow> _rows = new();
    private Dictionary<(int, int), List<SuccessionService.BenchStrengthRow>> _heatmapCells = new();
    private (int, int)? _expandedCell;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
        if (string.IsNullOrWhiteSpace(_companyId)) return;

        _rows = await SuccService.GetBenchStrengthAsync(_companyId);
        _heatmapCells = _rows
            .GroupBy(r => ((int)r.BusinessImpact, (int)r.ReplacementDifficulty))
            .ToDictionary(g => g.Key, g => g.ToList());
    }

    private void ToggleHeatCell((int, int) cellKey) => _expandedCell = _expandedCell == cellKey ? null : cellKey;

    private string ImpactLabel(BusinessImpactLevel v) => v switch
    {
        BusinessImpactLevel.Low => L.Translate("LevelLow"),
        BusinessImpactLevel.Medium => L.Translate("LevelMedium"),
        BusinessImpactLevel.High => L.Translate("LevelHigh"),
        _ => v.ToString(),
    };

    private string DifficultyLabel(ReplacementDifficultyLevel v) => v switch
    {
        ReplacementDifficultyLevel.Low => L.Translate("LevelLow"),
        ReplacementDifficultyLevel.Medium => L.Translate("LevelMedium"),
        ReplacementDifficultyLevel.High => L.Translate("LevelHigh"),
        _ => v.ToString(),
    };

    private string GetHeatCellLabel(int impactTier, int difficultyTier) => (impactTier, difficultyTier) switch
    {
        (3, 3) => L.Translate("CriticalHeatCellLabel"),
        (1, 1) => L.Translate("LowestRiskHeatCellLabel"),
        _ => string.Format(L.Translate("ImpactDifficultyCellTemplate"), ImpactLabel((BusinessImpactLevel)impactTier), DifficultyLabel((ReplacementDifficultyLevel)difficultyTier)),
    };

    private static string GetHeatCellStyle(int impactTier, int difficultyTier)
    {
        var risk = impactTier + difficultyTier; // 2..6 — both axes high = highest succession risk
        var color = risk switch
        {
            6 => "background-color:rgba(244,67,54,0.25)",   // top-right: highest impact + hardest to replace
            2 => "background-color:rgba(76,175,80,0.15)",   // bottom-left: lowest risk
            5 => "background-color:rgba(255,152,0,0.18)",
            3 => "background-color:rgba(139,195,74,0.15)",
            _ => "background-color:rgba(255,235,59,0.12)",
        };
        return $"{color}; min-height:140px";
    }
}
