@page "/succession/key-positions"
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Shared
@using HRM.Services.Succession
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject SuccessionService SuccService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject JsonLocalizationService L
@attribute [Authorize(Policy = "Menu:SUCC_ADMIN")]

<PageTitle>@L.Translate("KeyPositionPageTitle")</PageTitle>

@if (string.IsNullOrEmpty(_companyId))
{
    <MudAlert Severity="Severity.Error" Class="ma-4">@L.Translate("CompanyNotLinkedShortError")</MudAlert>
}
else
{
    <MudPaper Class="pa-4 mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudText Typo="Typo.h5">@L.Translate("KeyPositionHeading")</MudText>
            <MudChip T="string" Color="Color.Warning" Size="Size.Small">@L.Translate("ConfidentialDataChip")</MudChip>
        </MudStack>
        <MudText Typo="Typo.body2" Class="mt-1 mb-3">
            @L.Translate("KeyPositionDesc")
        </MudText>

        @if (!_showForm)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => _showForm = true)">
                @L.Translate("AddAsKeyPositionButton")
            </MudButton>
        }
        else
        {
            <MudGrid>
                <MudItem xs="12" sm="4">
                    <MudAutocomplete T="Pos_ExecType" Label="@L.Translate("JobFieldLabel")" @bind-Value="_selectedExecType"
                        SearchFunc="SearchExecTypesAsync"
                        ToStringFunc="@(t => t == null ? null : $"{t.Code} — {t.Name}")"
                        ResetValueOnEmptyText="true" CoerceText="true" MinCharacters="0" />
                </MudItem>
                <MudItem xs="6" sm="2">
                    <MudSelect T="BusinessImpactLevel" @bind-Value="_impact" Label="@L.Translate("BusinessImpactLabel")">
                        @foreach (var v in Enum.GetValues<BusinessImpactLevel>())
                        {
                            <MudSelectItem Value="@v">@ImpactLabel(v)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" sm="2">
                    <MudSelect T="ReplacementDifficultyLevel" @bind-Value="_difficulty" Label="@L.Translate("ReplacementDifficultyLabel")">
                        @foreach (var v in Enum.GetValues<ReplacementDifficultyLevel>())
                        {
                            <MudSelectItem Value="@v">@DifficultyLabel(v)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" sm="2">
                    <MudNumericField T="int?" @bind-Value="_minYearsExperience" Label="ประสบการณ์ขั้นต่ำ (ปี, ไม่บังคับ)" Min="0" />
                </MudItem>
                <MudItem xs="6" sm="2">
                    <MudTextField T="string" @bind-Value="_note" Label="@L.Translate("NoteIfAnyLabel")" />
                </MudItem>
            </MudGrid>
            <MudStack Row="true" Spacing="2" Class="mt-2">
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="AddAsync" Disabled="@(_selectedExecType is null)">
                    @L.Translate("AddAsKeyPositionButton")
                </MudButton>
                <MudButton Variant="Variant.Text" OnClick="CancelAdd">@L.Translate("CancelButton")</MudButton>
            </MudStack>
            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mt-2">@_error</MudAlert>
            }
        }
    </MudPaper>

    <MudPaper Class="pa-4 mb-4">
        <MudTable Items="_keyPositions" Dense="true" Hover="true">
            <HeaderContent>
                <MudTh>@L.Translate("ColPosition")</MudTh>
                <MudTh>@L.Translate("BusinessImpactLabel")</MudTh>
                <MudTh>@L.Translate("ReplacementDifficultyLabel")</MudTh>
                <MudTh>@L.Translate("ColNominatedSuccessors")</MudTh>
                <MudTh>@L.Translate("ColRemark")</MudTh>
                <MudTh>ประสบการณ์ขั้นต่ำ</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.PosExecTypeName</MudTd>
                <MudTd><MudChip T="string" Size="Size.Small" Color="@ImpactColor(context.BusinessImpact)">@ImpactLabel(context.BusinessImpact)</MudChip></MudTd>
                <MudTd><MudChip T="string" Size="Size.Small" Color="@DifficultyColor(context.ReplacementDifficulty)">@DifficultyLabel(context.ReplacementDifficulty)</MudChip></MudTd>
                <MudTd>
                    @if (context.SuccessorCount == 0)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Error">@L.Translate("NoSuccessorsChip")</MudChip>
                    }
                    else
                    {
                        @string.Format(L.Translate("PeopleCountTemplate"), context.SuccessorCount)
                    }
                </MudTd>
                <MudTd>@(context.Note ?? "-")</MudTd>
                <MudTd>@(context.MinYearsExperience is int min ? $"{min} ปี" : "-")</MudTd>
                <MudTd>
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => Nav.NavigateTo($"/succession/key-positions/{context.Id}"))">@L.Translate("ManageSuccessorsButton")</MudButton>
                    <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Text" OnClick="@(() => RemoveAsync(context.Id))">@L.Translate("RemoveButton")</MudButton>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText Typo="Typo.body2">@L.Translate("NoKeyPositionsYetMessage")</MudText></NoRecordsContent>
        </MudTable>
    </MudPaper>

    <MudButton Variant="Variant.Text" OnClick="@(() => Nav.NavigateTo("/succession/bench-strength"))">@L.Translate("ViewBenchStrengthReportButton")</MudButton>
}

@code {
    private string? _companyId;
    private List<SuccessionService.KeyPositionRow> _keyPositions = new();
    private bool _showForm;
    private Pos_ExecType? _selectedExecType;
    private BusinessImpactLevel _impact = BusinessImpactLevel.Medium;
    private ReplacementDifficultyLevel _difficulty = ReplacementDifficultyLevel.Medium;
    private int? _minYearsExperience;
    private string? _note;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
        if (string.IsNullOrWhiteSpace(_companyId)) return;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (string.IsNullOrEmpty(_companyId)) return;
        _keyPositions = await SuccService.GetKeyPositionsAsync(_companyId);
    }

    private async Task<IEnumerable<Pos_ExecType>> SearchExecTypesAsync(string search, CancellationToken ct)
    {
        await using var context = await DbFactory.CreateDbContextAsync(ct);
        var query = context.Pos_ExecTypes.Where(t => t.CompanyId == _companyId && t.IsActive);
        query = EntitySearchHelper.ApplyTextSearch(query, search, nameof(Pos_ExecType.Code), nameof(Pos_ExecType.Name));
        return await query.OrderBy(t => t.Name).Take(20).ToListAsync(ct);
    }

    private void CancelAdd()
    {
        _selectedExecType = null;
        _impact = BusinessImpactLevel.Medium;
        _difficulty = ReplacementDifficultyLevel.Medium;
        _minYearsExperience = null;
        _note = null;
        _error = null;
        _showForm = false;
    }

    private async Task AddAsync()
    {
        if (_selectedExecType is null || string.IsNullOrEmpty(_companyId)) return;
        _error = null;

        var state = await AuthProvider.GetAuthenticationStateAsync();
        var userId = long.TryParse(state.User.FindFirstValue("sc_userid"), out var uid) ? uid : 0;

        try
        {
            await SuccService.AddKeyPositionAsync(_companyId, _selectedExecType.Id, _impact, _difficulty, _note, userId, _minYearsExperience);
            Snackbar.Add(L.Translate("KeyPositionAddedSuccess"), Severity.Success);
            _selectedExecType = null;
            _impact = BusinessImpactLevel.Medium;
            _difficulty = ReplacementDifficultyLevel.Medium;
            _minYearsExperience = null;
            _note = null;
            _showForm = false;
            await LoadAsync();
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
    }

    private async Task RemoveAsync(long id)
    {
        await SuccService.RemoveKeyPositionAsync(id);
        Snackbar.Add(L.Translate("KeyPositionRemovedSuccess"), Severity.Success);
        await LoadAsync();
    }

    private string ImpactLabel(BusinessImpactLevel v) => v switch
    {
        BusinessImpactLevel.Low => L.Translate("LevelLow"),
        BusinessImpactLevel.Medium => L.Translate("LevelMedium"),
        BusinessImpactLevel.High => L.Translate("LevelHigh"),
        _ => v.ToString(),
    };

    private static Color ImpactColor(BusinessImpactLevel v) => v switch
    {
        BusinessImpactLevel.High => Color.Error,
        BusinessImpactLevel.Medium => Color.Warning,
        _ => Color.Default,
    };

    private string DifficultyLabel(ReplacementDifficultyLevel v) => v switch
    {
        ReplacementDifficultyLevel.Low => L.Translate("LevelLow"),
        ReplacementDifficultyLevel.Medium => L.Translate("LevelMedium"),
        ReplacementDifficultyLevel.High => L.Translate("LevelHigh"),
        _ => v.ToString(),
    };

    private static Color DifficultyColor(ReplacementDifficultyLevel v) => v switch
    {
        ReplacementDifficultyLevel.High => Color.Error,
        ReplacementDifficultyLevel.Medium => Color.Warning,
        _ => Color.Default,
    };
}
