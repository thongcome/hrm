@page "/succession/key-positions/{Id:long}"
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Idp
@using HRM.Services.Succession
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject SuccessionService SuccService
@inject IdpAssessmentService IdpService
@inject IdpPlanService IdpPlanSvc
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@attribute [Authorize(Policy = "Menu:SUCC_ADMIN")]

<PageTitle>ผู้สืบทอด — @(_posExecTypeName ?? "")</PageTitle>

@if (_notFound)
{
    <MudAlert Severity="Severity.Warning" Class="ma-4">ไม่พบตำแหน่งสำคัญนี้</MudAlert>
}
else if (_keyPosition is null)
{
    <MudText>กำลังโหลด...</MudText>
}
else
{
    <MudButton Class="mb-2" Variant="Variant.Text" OnClick="@(() => Nav.NavigateTo("/succession/key-positions"))">← กลับ</MudButton>

    <MudPaper Class="pa-4 mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudText Typo="Typo.h5">@_posExecTypeName</MudText>
            <MudChip T="string" Color="Color.Warning" Size="Size.Small">ข้อมูลเป็นความลับ</MudChip>
        </MudStack>
        <MudText Typo="Typo.body2" Class="mt-1">
            Business Impact: @ImpactLabel(_keyPosition.BusinessImpact) &nbsp;|&nbsp; Replacement Difficulty: @DifficultyLabel(_keyPosition.ReplacementDifficulty)
        </MudText>
    </MudPaper>

    @if (VisibleSuggestions.Count > 0)
    {
        <MudPaper Class="pa-4 mb-4">
            <MudText Typo="Typo.subtitle1" Class="mb-2">แนะนำจาก Talent Pool / 9-Box ศักยภาพสูง</MudText>
            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
                @foreach (var s in VisibleSuggestions)
                {
                    <MudChip T="string" Color="Color.Info" Icon="@Icons.Material.Filled.Star"
                        OnClick="@(() => SelectSuggestedAsync(s.HremployeeId))">
                        @s.EmpNo — @s.Name (@s.SourceLabel)
                    </MudChip>
                }
            </MudStack>
        </MudPaper>
    }

    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" Class="mb-2">เสนอชื่อผู้สืบทอด</MudText>
        <MudGrid>
            <MudItem xs="12" sm="4">
                <MudAutocomplete T="Hremployee" Label="ค้นหาพนักงาน" @bind-Value="_selectedEmployee"
                    SearchFunc="SearchEmployeesAsync"
                    ToStringFunc="@(e => e == null ? null : $"{e.EmpNo} — {e.EmpName} {e.EmpSurname}")"
                    ResetValueOnEmptyText="true" CoerceText="true" MinCharacters="0" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudSelect T="ReadinessLevel" @bind-Value="_readiness" Label="Readiness Level">
                    @foreach (var v in Enum.GetValues<ReadinessLevel>())
                    {
                        <MudSelectItem Value="@v">@ReadinessLabel(v)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudTextField T="string" @bind-Value="_note" Label="หมายเหตุ (ถ้ามี)" />
            </MudItem>
            <MudItem xs="12" sm="2" Class="d-flex align-center">
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="NominateAsync" Disabled="@(_selectedEmployee is null)">
                    เสนอชื่อ
                </MudButton>
            </MudItem>
        </MudGrid>
        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-2">@_error</MudAlert>
        }
    </MudPaper>

    <MudPaper Class="pa-4 mb-4">
        <MudTable Items="_nominations" Dense="true" Hover="true">
            <HeaderContent>
                <MudTh>ผู้สืบทอด</MudTh>
                <MudTh>Readiness</MudTh>
                <MudTh>เสนอชื่อเมื่อ</MudTh>
                <MudTh>หมายเหตุ</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.EmpNo — @context.Name</MudTd>
                <MudTd><MudChip T="string" Size="Size.Small" Color="@ReadinessColor(context.ReadinessLevel)">@ReadinessLabel(context.ReadinessLevel)</MudChip></MudTd>
                <MudTd>@context.NominatedDate.ToString("dd/MM/yyyy")</MudTd>
                <MudTd>@(context.Note ?? "-")</MudTd>
                <MudTd>
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => ToggleGapAsync(context))">
                        @(_gapNominationId == context.Id ? "ซ่อน Gap Analysis" : "ดู Gap Analysis")
                    </MudButton>
                    <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Text" OnClick="@(() => RemoveAsync(context.Id))">ถอดออก</MudButton>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText Typo="Typo.body2">ยังไม่มีผู้ถูกเสนอชื่อสำหรับตำแหน่งนี้</MudText></NoRecordsContent>
        </MudTable>
    </MudPaper>

    @if (_gapNominationId is not null)
    {
        <MudPaper Class="pa-4 mb-4">
            <MudText Typo="Typo.h6" Class="mb-2">Gap Analysis — เทียบกับตำแหน่งเป้าหมาย (@_posExecTypeName)</MudText>
            @if (_gapRows.Count == 0)
            {
                <MudAlert Severity="Severity.Info">ตำแหน่งนี้ยังไม่ได้กำหนดสมรรถนะที่ต้องการ (Job Profile) หรือผู้สืบทอดยังไม่ได้รับการประเมินสมรรถนะเลย</MudAlert>
            }
            else
            {
                <MudTable Items="_gapRows" Dense="true" Hover="true">
                    <HeaderContent>
                        <MudTh>สมรรถนะ</MudTh>
                        <MudTh>ระดับที่ต้องการ</MudTh>
                        <MudTh>ระดับปัจจุบัน (Effective)</MudTh>
                        <MudTh>ช่องว่าง (Gap)</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            @context.CompetencyName
                            @if (context.IsCritical)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ml-1">จำเป็น</MudChip>
                            }
                        </MudTd>
                        <MudTd>@context.RequiredLevel</MudTd>
                        <MudTd>@(context.EffectiveLevel?.ToString() ?? "ยังไม่ประเมิน")</MudTd>
                        <MudTd>
                            @if (context.Gap is int gap)
                            {
                                <MudChip T="string" Size="Size.Small" Color="@(gap > 0 ? Color.Error : Color.Success)">@gap</MudChip>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2">-</MudText>
                            }
                        </MudTd>
                        <MudTd>
                            @if (context.Gap is int g && g > 0)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => CreateIdpActionAsync(context))">
                                    สร้างแผนพัฒนา (IDP)
                                </MudButton>
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudPaper>
    }
}

@code {
    [Parameter] public long Id { get; set; }

    private bool _notFound;
    private Succ_KeyPosition? _keyPosition;
    private string? _posExecTypeName;
    private string? _companyId;
    private List<SuccessionService.NominationRow> _nominations = new();
    private Hremployee? _selectedEmployee;
    private ReadinessLevel _readiness = ReadinessLevel.DevelopmentNeeded;
    private string? _note;
    private string? _error;

    private long? _gapNominationId;
    private List<IdpAssessmentService.CompetencyGapRow> _gapRows = new();
    private List<SuccessionService.SuggestedCandidateRow> _suggestedCandidates = new();

    private List<SuccessionService.SuggestedCandidateRow> VisibleSuggestions =>
        _suggestedCandidates.Where(s => !_nominations.Any(n => n.HremployeeId == s.HremployeeId)).ToList();

    protected override async Task OnParametersSetAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");

        await using var context = await DbFactory.CreateDbContextAsync();
        _keyPosition = await context.Succ_KeyPositions.FirstOrDefaultAsync(k => k.Id == Id && k.IsActive);
        if (_keyPosition is null)
        {
            _notFound = true;
            return;
        }

        var execType = await context.Pos_ExecTypes.FirstOrDefaultAsync(t => t.Id == _keyPosition.PosExecTypeId);
        _posExecTypeName = execType?.Name ?? $"#{_keyPosition.PosExecTypeId}";

        if (!string.IsNullOrEmpty(_companyId))
            _suggestedCandidates = await SuccService.GetSuggestedCandidatesAsync(_companyId);

        await LoadNominationsAsync();
    }

    private async Task SelectSuggestedAsync(long hremployeeId)
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        _selectedEmployee = await context.Hremployee.FirstOrDefaultAsync(e => e.id == hremployeeId);
    }

    private async Task LoadNominationsAsync()
    {
        _nominations = await SuccService.GetNominationsAsync(Id);
    }

    private async Task<IEnumerable<Hremployee>> SearchEmployeesAsync(string search, CancellationToken ct)
    {
        await using var context = await DbFactory.CreateDbContextAsync(ct);
        var query = context.Hremployee.Where(e => e.companyid == _companyId && e.ResignDate == null);
        if (!string.IsNullOrWhiteSpace(search))
        {
            query = query.Where(e => e.EmpNo.Contains(search)
                || (e.EmpName != null && e.EmpName.Contains(search))
                || (e.EmpSurname != null && e.EmpSurname.Contains(search)));
        }
        return await query.OrderBy(e => e.EmpNo).Take(20).ToListAsync(ct);
    }

    private async Task NominateAsync()
    {
        if (_selectedEmployee is null) return;
        _error = null;

        var state = await AuthProvider.GetAuthenticationStateAsync();
        var userId = long.TryParse(state.User.FindFirstValue("sc_userid"), out var uid) ? uid : 0;

        try
        {
            await SuccService.NominateAsync(Id, _selectedEmployee.id, _readiness, userId, _note);
            Snackbar.Add("เสนอชื่อผู้สืบทอดเรียบร้อย", Severity.Success);
            _selectedEmployee = null;
            _readiness = ReadinessLevel.DevelopmentNeeded;
            _note = null;
            await LoadNominationsAsync();
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
    }

    private async Task RemoveAsync(long nominationId)
    {
        await SuccService.RemoveNominationAsync(nominationId);
        Snackbar.Add("ถอดออกจากรายชื่อผู้สืบทอดแล้ว", Severity.Success);
        if (_gapNominationId == nominationId)
            _gapNominationId = null;
        await LoadNominationsAsync();
    }

    private async Task ToggleGapAsync(SuccessionService.NominationRow nomination)
    {
        if (_gapNominationId == nomination.Id)
        {
            _gapNominationId = null;
            return;
        }

        _gapNominationId = nomination.Id;
        _gapRows = await IdpService.GetGapAnalysisForTargetPositionAsync(nomination.HremployeeId, _keyPosition!.PosExecTypeId);
    }

    // Closes the loop from "we found a gap" to "there's an actual development
    // plan for it" — reuses the same Idp_Plan/Idp_DevelopmentAction the IDP
    // module itself writes to (IdpPlanService), so the resulting action shows
    // up at /idp/my-plans and /idp/team exactly like one added by hand.
    private async Task CreateIdpActionAsync(IdpAssessmentService.CompetencyGapRow gapRow)
    {
        if (_gapNominationId is not long nominationId) return;
        var nomination = _nominations.FirstOrDefault(n => n.Id == nominationId);
        if (nomination is null) return;

        var state = await AuthProvider.GetAuthenticationStateAsync();
        var userId = long.TryParse(state.User.FindFirstValue("sc_userid"), out var uid) ? uid : 0;
        var year = DateTime.Now.Year;

        await using var context = await DbFactory.CreateDbContextAsync();
        var existingPlan = await context.Idp_Plans
            .Where(p => p.HremployeeId == nomination.HremployeeId && p.Year == year && p.Status != IdpPlanStatus.Rejected)
            .OrderByDescending(p => p.CreatedDate)
            .FirstOrDefaultAsync();

        long planId;
        if (existingPlan is null)
        {
            planId = await IdpPlanSvc.CreateDraftAsync(nomination.HremployeeId, year, userId);
        }
        else if (existingPlan.Status == IdpPlanStatus.Draft)
        {
            planId = existingPlan.Id;
        }
        else
        {
            Snackbar.Add($"{nomination.Name} มีแผนพัฒนาปี {year} อยู่แล้ว (สถานะ: {existingPlan.Status}) ไม่สามารถเพิ่มรายการอัตโนมัติได้ — กรุณาไปที่โมดูล IDP โดยตรง", Severity.Warning);
            return;
        }

        try
        {
            await IdpPlanSvc.AddActionAsync(planId, gapRow.CompetencyId,
                $"พัฒนา {gapRow.CompetencyName} เพื่อเตรียมความพร้อมสำหรับตำแหน่ง {_posExecTypeName}",
                $"ระบุจาก Succession Planning — ต้องการระดับ {gapRow.RequiredLevel}, ปัจจุบัน {(gapRow.EffectiveLevel?.ToString() ?? "ยังไม่ประเมิน")} (ช่องว่าง {gapRow.Gap})",
                targetDate: null, userId);
            Snackbar.Add("เพิ่มรายการเข้าแผนพัฒนา (IDP) เรียบร้อย", Severity.Success);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
    }

    private static string ImpactLabel(BusinessImpactLevel v) => v switch
    {
        BusinessImpactLevel.Low => "ต่ำ",
        BusinessImpactLevel.Medium => "ปานกลาง",
        BusinessImpactLevel.High => "สูง",
        _ => v.ToString(),
    };

    private static string DifficultyLabel(ReplacementDifficultyLevel v) => v switch
    {
        ReplacementDifficultyLevel.Low => "ต่ำ",
        ReplacementDifficultyLevel.Medium => "ปานกลาง",
        ReplacementDifficultyLevel.High => "สูง",
        _ => v.ToString(),
    };

    private static string ReadinessLabel(ReadinessLevel v) => v switch
    {
        ReadinessLevel.ReadyNow => "พร้อมทันที (Ready Now)",
        ReadinessLevel.Ready1To2Years => "พร้อมใน 1-2 ปี",
        ReadinessLevel.Ready3To5Years => "พร้อมใน 3-5 ปี",
        ReadinessLevel.DevelopmentNeeded => "ต้องพัฒนาเพิ่มเติม",
        _ => v.ToString(),
    };

    private static Color ReadinessColor(ReadinessLevel v) => v switch
    {
        ReadinessLevel.ReadyNow => Color.Success,
        ReadinessLevel.Ready1To2Years => Color.Info,
        ReadinessLevel.Ready3To5Years => Color.Warning,
        _ => Color.Default,
    };
}
