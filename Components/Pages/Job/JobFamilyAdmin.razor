@page "/job/families"
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@attribute [Authorize(Policy = "Menu:JOBCOMP_ADMIN")]

<PageTitle>สายอาชีพ (Job Family)</PageTitle>

<MudPaper Class="pa-4 mb-4" MaxWidth="900px">
    <MudText Typo="Typo.h5">สายอาชีพ (Job Family)</MudText>
    <MudText Typo="Typo.body2" Class="mt-1">กลุ่มบทบาทงานที่เกี่ยวข้องกัน เช่น "การเงิน", "วิศวกรรม" — ใช้จัดกลุ่ม Job Profile</MudText>

    @if (string.IsNullOrEmpty(_companyId))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">บัญชีของคุณยังไม่ได้ผูกกับบริษัทใดๆ</MudAlert>
        return;
    }

    <MudDivider Class="my-4" />

    <MudText Typo="Typo.h6">@(_editingId is null ? "เพิ่มสายอาชีพ" : "แก้ไข")</MudText>
    <MudGrid Class="mt-1">
        <MudItem xs="12" sm="3"><MudTextField @bind-Value="_code" Label="รหัส" /></MudItem>
        <MudItem xs="12" sm="4"><MudTextField @bind-Value="_name" Label="ชื่อสายอาชีพ (ไทย)" Required="true" /></MudItem>
        <MudItem xs="12" sm="5"><MudTextField @bind-Value="_nameEn" Label="ชื่อสายอาชีพ (อังกฤษ)" /></MudItem>
        <MudItem xs="12"><MudTextField @bind-Value="_description" Label="คำอธิบาย" Lines="2" /></MudItem>
        <MudItem xs="12" sm="4">
            <MudSwitch T="bool" @bind-Value="_isActive" Color="Color.Success" Label="ใช้งานอยู่" />
        </MudItem>
    </MudGrid>

    @if (!string.IsNullOrEmpty(_error))
    {
        <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
    }

    <MudStack Row="true" Spacing="2" Class="mt-3">
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">บันทึก</MudButton>
        @if (_editingId is not null)
        {
            <MudButton Variant="Variant.Text" OnClick="CancelEdit">ยกเลิก</MudButton>
        }
    </MudStack>

    <MudDivider Class="my-5" />

    <MudTextField T="string" Value="_searchTerm" Label="ค้นหา" Immediate="true"
        DebounceInterval="300" ValueChanged="OnSearchChanged"
        AdornmentIcon="@Icons.Material.Filled.Search" Adornment="Adornment.Start" Class="mb-3" />

    <MudTable Items="_items" Dense="true" Hover="true">
        <HeaderContent>
            <MudTh>รหัส</MudTh>
            <MudTh>ชื่อสายอาชีพ</MudTh>
            <MudTh>สถานะ</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Code</MudTd>
            <MudTd>@context.Name @(string.IsNullOrWhiteSpace(context.NameEn) ? "" : $"({context.NameEn})")</MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                    @(context.IsActive ? "ใช้งาน" : "ไม่ใช้งาน")
                </MudChip>
            </MudTd>
            <MudTd>
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => StartEdit(context))">แก้ไข</MudButton>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2">ยังไม่มีข้อมูล</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private string? _companyId;
    private List<Job_Family> _items = new();
    private string? _searchTerm;
    private string? _error;
    private long? _editingId;

    private string? _code;
    private string _name = "";
    private string? _nameEn;
    private string? _description;
    private bool _isActive = true;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
        if (string.IsNullOrWhiteSpace(_companyId)) return;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var query = context.Job_Families.Where(f => f.CompanyId == _companyId);
        query = EntitySearchHelper.ApplyTextSearch(query, _searchTerm, nameof(Job_Family.Code), nameof(Job_Family.Name), nameof(Job_Family.NameEn));
        _items = await query.OrderBy(f => f.Name).ToListAsync();
    }

    private async Task OnSearchChanged(string term)
    {
        _searchTerm = term;
        await LoadAsync();
    }

    private void StartEdit(Job_Family item)
    {
        _editingId = item.Id;
        _code = item.Code;
        _name = item.Name;
        _nameEn = item.NameEn;
        _description = item.Description;
        _isActive = item.IsActive;
        _error = null;
    }

    private void CancelEdit()
    {
        _editingId = null;
        _code = null;
        _name = "";
        _nameEn = null;
        _description = null;
        _isActive = true;
        _error = null;
    }

    private async Task SaveAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_name)) { _error = "กรุณาระบุชื่อสายอาชีพ"; return; }

        await using var context = await DbFactory.CreateDbContextAsync();

        if (_editingId is long id)
        {
            var existing = await context.Job_Families.FirstOrDefaultAsync(f => f.Id == id && f.CompanyId == _companyId);
            if (existing is null) { _error = "ไม่พบข้อมูล"; return; }
            existing.Code = _code;
            existing.Name = _name;
            existing.NameEn = _nameEn;
            existing.Description = _description;
            existing.IsActive = _isActive;
        }
        else
        {
            context.Job_Families.Add(new Job_Family
            {
                CompanyId = _companyId!,
                Code = _code,
                Name = _name,
                NameEn = _nameEn,
                Description = _description,
                IsActive = _isActive,
            });
        }

        await context.SaveChangesAsync();
        Snackbar.Add("บันทึกเรียบร้อย", Severity.Success);
        CancelEdit();
        await LoadAsync();
    }
}
