@page "/job/profiles/{PosExecTypeId:long}"
@using HRM.Models
@using HRM.Services.Job
@using HRM.Services.Security
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider
@inject ProgramRoleService ProgramRoles
@inject JsonLocalizationService L
@attribute [Authorize(Policy = "Menu:JOBCOMP_ADMIN")]

<PageTitle>Job Profile — @(_execType?.Name)</PageTitle>

@if (_execType is null)
{
    <MudAlert Severity="Severity.Warning" Class="ma-4">ไม่พบตำแหน่งนี้</MudAlert>
}
else
{
    <MudPaper Class="pa-4 mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudText Typo="Typo.h5">Job Profile — @_execType.Name</MudText>
            <MudSpacer />
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Print"
                OnClick="@(() => Nav.NavigateTo($"/job/profiles/{PosExecTypeId}/print"))">@L.Translate("JdPrintButton")</MudButton>
        </MudStack>
        <MudText Typo="Typo.body2" Class="mt-1">นิยามบทบาทของตำแหน่งนี้: สายอาชีพ/ระดับ, วัตถุประสงค์, ความรับผิดชอบหลัก และสมรรถนะที่ต้องการ</MudText>
        <MudText Typo="Typo.caption" Class="mt-1" Style="opacity:.75;">@JdVersionLine()</MudText>

        @if (!CanWrite)
        {
            @* AD.CRUDManage rule: unwritable state is announced, never silently missing buttons. *@
            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">@L.Translate("JdNoWriteAccess")</MudAlert>
        }

        <MudGrid Class="mt-3">
            <MudItem xs="12" sm="4">
                <MudSelect T="long?" @bind-Value="_jobFamilyId" Label="สายอาชีพ (Job Family)" Clearable="true" ReadOnly="@(!CanWrite)">
                    @foreach (var f in _families)
                    {
                        <MudSelectItem T="long?" Value="@((long?)f.Id)">@f.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="CareerTrack?" @bind-Value="_careerTrack" Label="สาย (Career Track)" Clearable="true" ReadOnly="@(!CanWrite)">
                    <MudSelectItem T="CareerTrack?" Value="CareerTrack.IndividualContributor">สายผู้เชี่ยวชาญ (IC)</MudSelectItem>
                    <MudSelectItem T="CareerTrack?" Value="CareerTrack.Managerial">สายบริหาร (Managerial)</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="long?" @bind-Value="_jobLevelId" Label="ระดับ (Job Level)" Clearable="true" ReadOnly="@(!CanWrite)">
                    @foreach (var l in _levels.Where(l => _careerTrack == null || l.CareerTrack == _careerTrack))
                    {
                        <MudSelectItem T="long?" Value="@((long?)l.Id)">@l.Name (@l.Code)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_purpose" Label="วัตถุประสงค์ของตำแหน่ง (Purpose)" Lines="2" ReadOnly="@(!CanWrite)" />
            </MudItem>
        </MudGrid>

        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
        }

        @if (CanWrite)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="mt-3" OnClick="SaveProfileAsync">บันทึก Job Profile</MudButton>
        }
    </MudPaper>

    @* ---------- สายบังคับบัญชา (auto-derived, read-only — never keyed in by HR) ---------- *@
    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6">@L.Translate("JdReportingSectionTitle")</MudText>
        <MudText Typo="Typo.body2" Class="mt-1">@L.Translate("JdReportingAutoNote")</MudText>
        @if (_reportingRows.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">@L.Translate("JdReportingNoSlots")</MudAlert>
        }
        else
        {
            <MudTable Items="_reportingRows" Dense="true" Hover="true" Class="mt-2">
                <HeaderContent>
                    <MudTh>@L.Translate("JdReportingOrgCol")</MudTh>
                    <MudTh>@L.Translate("JdReportsToLabel")</MudTh>
                    <MudTh>@L.Translate("JdSubordinateCountLabel")</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.OrgName @(context.IsBoss ? $"({L.Translate("JdReportingBossChip")})" : "")</MudTd>
                    <MudTd>
                        @if (context.ReportsToTitle is null && context.ReportsToName is null)
                        {
                            @L.Translate("JdReportingVacant")
                        }
                        else
                        {
                            @($"{context.ReportsToTitle ?? "-"} — {context.ReportsToName ?? L.Translate("JdReportingVacant")}")
                        }
                    </MudTd>
                    <MudTd>@(context.IsBoss ? context.SubordinateCount.ToString() : "-")</MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>

    @* ---------- หน้าที่ความรับผิดชอบ (structured duties — replaces the KeyAccountabilities blob) ---------- *@
    <MudPaper Class="pa-4 mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudText Typo="Typo.h6">@L.Translate("JdDutiesSectionTitle")</MudText>
            <MudSpacer />
            @if (CanWrite)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.AutoAwesome"
                    OnClick="SuggestCompetenciesAsync">@L.Translate("JdSuggestButton")</MudButton>
            }
        </MudStack>

        @if (ActiveDuties.Count == 0 && !string.IsNullOrWhiteSpace(_execType.KeyAccountabilities))
        {
            @* One-way legacy fallback: show the old free-text blob only while no
               structured duty rows exist yet. Once rows are saved, the blob is
               ignored (the column itself is never deleted). *@
            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">@L.Translate("JdLegacyBlobFallbackInfo")</MudAlert>
            <MudPaper Outlined="true" Class="pa-3 mt-2" Style="white-space: pre-wrap;">@_execType.KeyAccountabilities</MudPaper>
        }

        <MudTable Items="ActiveDuties" Dense="true" Hover="true" Class="mt-2">
            <HeaderContent>
                <MudTh Style="min-width:280px;">@L.Translate("JdDutyColText")</MudTh>
                <MudTh Style="width:110px;">@L.Translate("JdDutyColWeight")</MudTh>
                <MudTh Style="width:90px;">@L.Translate("JdColSort")</MudTh>
                <MudTh Style="min-width:260px;">@L.Translate("JdColCompetencyFlag")</MudTh>
                <MudTh Style="width:70px;"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <MudTextField T="string" @bind-Value="context.Text" Lines="2" ReadOnly="@(!CanWrite)" MaxLength="500" />
                    @if (_suggestions.TryGetValue(context, out var dutySugs) && context.LinkedCompetencyId is null)
                    {
                        <MudStack Row="true" Spacing="1" Class="mt-1" Wrap="Wrap.Wrap">
                            @if (dutySugs.Count == 0)
                            {
                                <MudText Typo="Typo.caption">@L.Translate("JdSuggestNone")</MudText>
                            }
                            @foreach (var s in dutySugs)
                            {
                                var sug = s;
                                <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined"
                                    OnClick="@(() => AcceptSuggestion(context, null, sug))">
                                    @string.Format(L.Translate("JdSuggestChipTemplate"), sug.DisplayName, (int)Math.Round(sug.Score * 100))
                                </MudChip>
                            }
                        </MudStack>
                    }
                </MudTd>
                <MudTd><MudNumericField T="decimal?" @bind-Value="context.WeightPercent" Min="0" Max="100" ReadOnly="@(!CanWrite)" /></MudTd>
                <MudTd><MudNumericField T="int" @bind-Value="context.SortOrder" ReadOnly="@(!CanWrite)" /></MudTd>
                <MudTd>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudCheckBox T="bool" @bind-Value="context.IncludeInCompetency" Disabled="@(!CanWrite)" Dense="true" />
                        @if (context.IncludeInCompetency)
                        {
                            <MudSelect T="long?" @bind-Value="context.LinkedCompetencyId" Label="@L.Translate("JdColLinkedCompetency")"
                                Dense="true" Clearable="true" ReadOnly="@(!CanWrite)">
                                @foreach (var c in _allCompetencies.OrderBy(c => c.Name))
                                {
                                    <MudSelectItem T="long?" Value="@((long?)c.Id)">@c.Code — @c.Name</MudSelectItem>
                                }
                            </MudSelect>
                        }
                    </MudStack>
                </MudTd>
                <MudTd>
                    @if (CanWrite)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                            OnClick="@(() => RemoveDutyAsync(context))">@L.Translate("JdRemoveRow")</MudButton>
                    }
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.body2">@L.Translate("JdNoDutyRows")</MudText>
            </NoRecordsContent>
        </MudTable>

        @if (ActiveDuties.Any(d => d.WeightPercent is not null))
        {
            var sum = ActiveDuties.Sum(d => d.WeightPercent ?? 0);
            <MudText Typo="Typo.body2" Class="mt-2" Color="@(sum == 100 ? Color.Success : Color.Warning)">
                @string.Format(L.Translate("JdWeightSumTemplate"), sum)
            </MudText>
        }

        @if (CanWrite)
        {
            <MudStack Row="true" Spacing="2" Class="mt-3">
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="AddDutyRow">@L.Translate("JdAddDutyButton")</MudButton>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveDutiesAsync">@L.Translate("JdSaveDutiesButton")</MudButton>
            </MudStack>
        }
    </MudPaper>

    @* ---------- คุณสมบัติประจำตำแหน่ง (Qualifications) ---------- *@
    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6">@L.Translate("JdQualSectionTitle")</MudText>

        <MudTable Items="ActiveQualifications" Dense="true" Hover="true" Class="mt-2">
            <HeaderContent>
                <MudTh Style="width:170px;">@L.Translate("JdQualColType")</MudTh>
                <MudTh Style="min-width:240px;">@L.Translate("JdQualColText")</MudTh>
                <MudTh Style="width:130px;">@L.Translate("JdQualColRequired")</MudTh>
                <MudTh Style="width:90px;">@L.Translate("JdColSort")</MudTh>
                <MudTh Style="min-width:260px;">@L.Translate("JdColCompetencyFlag")</MudTh>
                <MudTh Style="width:70px;"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <MudSelect T="JobQualificationType" @bind-Value="context.QualType" Dense="true" ReadOnly="@(!CanWrite)">
                        @foreach (var qt in Enum.GetValues<JobQualificationType>())
                        {
                            <MudSelectItem T="JobQualificationType" Value="qt">@QualTypeLabel(qt)</MudSelectItem>
                        }
                    </MudSelect>
                </MudTd>
                <MudTd>
                    <MudTextField T="string" @bind-Value="context.Text" ReadOnly="@(!CanWrite)" MaxLength="300" />
                    @if (_suggestions.TryGetValue(context, out var qualSugs) && context.LinkedCompetencyId is null)
                    {
                        <MudStack Row="true" Spacing="1" Class="mt-1" Wrap="Wrap.Wrap">
                            @if (qualSugs.Count == 0)
                            {
                                <MudText Typo="Typo.caption">@L.Translate("JdSuggestNone")</MudText>
                            }
                            @foreach (var s in qualSugs)
                            {
                                var sug = s;
                                <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined"
                                    OnClick="@(() => AcceptSuggestion(null, context, sug))">
                                    @string.Format(L.Translate("JdSuggestChipTemplate"), sug.DisplayName, (int)Math.Round(sug.Score * 100))
                                </MudChip>
                            }
                        </MudStack>
                    }
                </MudTd>
                <MudTd>
                    <MudSwitch T="bool" @bind-Value="context.IsRequired" Color="Color.Warning" Disabled="@(!CanWrite)"
                        Label="@(context.IsRequired ? L.Translate("JdQualRequired") : L.Translate("JdQualPreferred"))" />
                </MudTd>
                <MudTd><MudNumericField T="int" @bind-Value="context.SortOrder" ReadOnly="@(!CanWrite)" /></MudTd>
                <MudTd>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudCheckBox T="bool" @bind-Value="context.IncludeInCompetency" Disabled="@(!CanWrite)" Dense="true" />
                        @if (context.IncludeInCompetency)
                        {
                            <MudSelect T="long?" @bind-Value="context.LinkedCompetencyId" Label="@L.Translate("JdColLinkedCompetency")"
                                Dense="true" Clearable="true" ReadOnly="@(!CanWrite)">
                                @foreach (var c in _allCompetencies.OrderBy(c => c.Name))
                                {
                                    <MudSelectItem T="long?" Value="@((long?)c.Id)">@c.Code — @c.Name</MudSelectItem>
                                }
                            </MudSelect>
                        }
                    </MudStack>
                </MudTd>
                <MudTd>
                    @if (CanWrite)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                            OnClick="@(() => RemoveQualificationAsync(context))">@L.Translate("JdRemoveRow")</MudButton>
                    }
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.body2">@L.Translate("JdNoQualRows")</MudText>
            </NoRecordsContent>
        </MudTable>

        @if (CanWrite)
        {
            <MudStack Row="true" Spacing="2" Class="mt-3">
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="AddQualificationRow">@L.Translate("JdAddQualButton")</MudButton>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveQualificationsAsync">@L.Translate("JdSaveQualsButton")</MudButton>
            </MudStack>
        }
    </MudPaper>

    @* ---------- KPI ประจำตำแหน่ง (JD block B) ---------- *@
    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6">@L.Translate("JdKpiSectionTitle")</MudText>

        <MudTable Items="ActiveKpis" Dense="true" Hover="true" Class="mt-2">
            <HeaderContent>
                <MudTh Style="min-width:220px;">@L.Translate("JdKpiColName")</MudTh>
                <MudTh Style="min-width:220px;">@L.Translate("JdKpiColTarget")</MudTh>
                <MudTh Style="width:110px;">@L.Translate("JdKpiColUnit")</MudTh>
                <MudTh Style="width:130px;">@L.Translate("JdKpiColValue")</MudTh>
                <MudTh Style="width:90px;">@L.Translate("JdColSort")</MudTh>
                <MudTh Style="width:70px;"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd><MudTextField T="string" @bind-Value="context.Name" ReadOnly="@(!CanWrite)" MaxLength="300" /></MudTd>
                <MudTd><MudTextField T="string" @bind-Value="context.TargetDescription" ReadOnly="@(!CanWrite)" MaxLength="500" /></MudTd>
                <MudTd><MudTextField T="string" @bind-Value="context.Unit" ReadOnly="@(!CanWrite)" MaxLength="50" /></MudTd>
                <MudTd><MudNumericField T="decimal?" @bind-Value="context.TargetValue" ReadOnly="@(!CanWrite)" /></MudTd>
                <MudTd><MudNumericField T="int" @bind-Value="context.SortOrder" ReadOnly="@(!CanWrite)" /></MudTd>
                <MudTd>
                    @if (CanWrite)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                            OnClick="@(() => RemoveKpiAsync(context))">@L.Translate("JdRemoveRow")</MudButton>
                    }
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.body2">@L.Translate("JdNoKpiRows")</MudText>
            </NoRecordsContent>
        </MudTable>

        @if (CanWrite)
        {
            <MudStack Row="true" Spacing="2" Class="mt-3">
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="AddKpiRow">@L.Translate("JdAddKpiButton")</MudButton>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveKpisAsync">@L.Translate("JdSaveKpisButton")</MudButton>
            </MudStack>
        }
    </MudPaper>

    @* ---------- สมรรถนะที่ต้องการ (existing requirements table, kept as-is) ---------- *@
    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6">สมรรถนะที่ต้องการ (Required Competencies)</MudText>

        <MudTable Items="_requirements" Dense="true" Hover="true" Class="mt-2">
            <HeaderContent>
                <MudTh>สมรรถนะ</MudTh>
                <MudTh>ระดับที่ต้องการ</MudTh>
                <MudTh>จำเป็น</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@CompetencyName(context.CompetencyId)</MudTd>
                <MudTd>ระดับ @context.RequiredLevel — @LevelDescription(context.CompetencyId, context.RequiredLevel)</MudTd>
                <MudTd>@(context.IsCritical ? "จำเป็น (Critical)" : "ควรมี")</MudTd>
                <MudTd>
                    @if (CanDelete)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="@(() => RemoveRequirementAsync(context.Id))">ลบ</MudButton>
                    }
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.body2">ยังไม่มีสมรรถนะที่กำหนด</MudText>
            </NoRecordsContent>
        </MudTable>

        @if (CanWrite)
        {
            <MudGrid Class="mt-3">
                <MudItem xs="12" sm="5">
                    <MudAutocomplete T="Comp_Competency" Label="เลือกสมรรถนะ" @bind-Value="_selectedCompetency"
                        SearchFunc="SearchCompetenciesAsync"
                        ToStringFunc="@(c => c == null ? null : $"{c.Code} — {c.Name}")"
                        ResetValueOnEmptyText="true" CoerceText="true" MinCharacters="0" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect T="int" @bind-Value="_selectedLevel" Label="ระดับที่ต้องการ">
                        @for (var lvl = 1; lvl <= 5; lvl++)
                        {
                            var l = lvl;
                            <MudSelectItem T="int" Value="l">ระดับ @l @(_selectedCompetency is null ? "" : $"— {LevelDescription(_selectedCompetency.Id, l)}")</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="8" sm="2">
                    <MudSwitch T="bool" @bind-Value="_selectedCritical" Color="Color.Warning" Label="จำเป็น (Critical)" />
                </MudItem>
                <MudItem xs="4" sm="1">
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="AddRequirementAsync">เพิ่ม</MudButton>
                </MudItem>
            </MudGrid>
        }
    </MudPaper>

    <MudButton Variant="Variant.Text" OnClick="@(() => Nav.NavigateTo("/pos/exec-types"))">กลับไปหน้าชื่อตำแหน่ง</MudButton>
}

@code {
    [Parameter] public long PosExecTypeId { get; set; }

    // AD.CRUDManage: one program path for this route ({PosExecTypeId} segment
    // is stripped by ProgramRoleService.NormalizeRouteTemplate). All child-row
    // edits on this page (duties/qualifications/requirements) count as Edit
    // on the profile; row removals count as Delete.
    private const string ProgramPath = "/job/profiles";
    private ProgramRoleService.ProgramRights? _rights;
    private bool CanWrite => _rights?.CanEdit == true;
    private bool CanDelete => _rights?.CanDelete == true;

    private Pos_ExecType? _execType;
    private List<Job_Family> _families = new();
    private List<Job_Level> _levels = new();
    private List<Job_CompetencyRequirement> _requirements = new();
    private List<Comp_Competency> _allCompetencies = new();
    private List<Comp_ProficiencyLevel> _allLevels = new();
    private List<Job_ProfileDuty> _duties = new();
    private List<Job_ProfileQualification> _qualifications = new();
    private List<Job_ProfileKpi> _kpis = new();
    private List<JobReportingLineHelper.ReportingLineRow> _reportingRows = new();
    private string? _error;
    private string _actorName = "admin";

    private long? _jobFamilyId;
    private CareerTrack? _careerTrack;
    private long? _jobLevelId;
    private string? _purpose;

    private Comp_Competency? _selectedCompetency;
    private int _selectedLevel = 3;
    private bool _selectedCritical;

    // Suggestion chips keyed by the row object itself — stable across
    // re-renders, immune to add/remove reindexing.
    private readonly Dictionary<object, List<JdCompetencySuggestionService.Suggestion>> _suggestions = new();

    private List<Job_ProfileDuty> ActiveDuties => _duties.Where(d => d.IsActive).OrderBy(d => d.SortOrder).ToList();
    private List<Job_ProfileQualification> ActiveQualifications => _qualifications.Where(q => q.IsActive).OrderBy(q => q.SortOrder).ToList();
    private List<Job_ProfileKpi> ActiveKpis => _kpis.Where(k => k.IsActive).OrderBy(k => k.SortOrder).ToList();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _rights = await ProgramRoles.GetRightsAsync(state.User, ProgramPath);
        _actorName = state.User.Identity?.Name ?? "admin";
    }

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _suggestions.Clear();
        await using var context = await DbFactory.CreateDbContextAsync();
        _execType = await context.Pos_ExecTypes.FirstOrDefaultAsync(e => e.Id == PosExecTypeId);
        if (_execType is null) return;

        _families = await context.Job_Families.Where(f => f.CompanyId == _execType.CompanyId && f.IsActive).OrderBy(f => f.Name).ToListAsync();
        _levels = await context.Job_Levels.Where(l => l.CompanyId == _execType.CompanyId && l.IsActive).OrderBy(l => l.CareerTrack).ThenBy(l => l.LevelNumber).ToListAsync();

        _jobFamilyId = _execType.JobFamilyId;
        _careerTrack = _execType.CareerTrack;
        _jobLevelId = _execType.JobLevelId;
        _purpose = _execType.Purpose;

        _requirements = await context.Job_CompetencyRequirements.Where(r => r.PosExecTypeId == PosExecTypeId && r.IsActive).OrderBy(r => r.SortOrder).ToListAsync();
        _duties = await context.Job_ProfileDuties.Where(d => d.PosExecTypeId == PosExecTypeId && d.IsActive).OrderBy(d => d.SortOrder).ToListAsync();
        _qualifications = await context.Job_ProfileQualifications.Where(q => q.PosExecTypeId == PosExecTypeId && q.IsActive).OrderBy(q => q.SortOrder).ToListAsync();
        _kpis = await context.Job_ProfileKpis.Where(k => k.PosExecTypeId == PosExecTypeId && k.IsActive).OrderBy(k => k.SortOrder).ToListAsync();

        var categoryIds = await context.Comp_Categories.Where(c => c.CompanyId == _execType.CompanyId).Select(c => c.Id).ToListAsync();
        _allCompetencies = await context.Comp_Competencies.Where(c => categoryIds.Contains(c.CategoryId) && c.IsActive).ToListAsync();
        var competencyIds = _allCompetencies.Select(c => c.Id).ToList();
        _allLevels = await context.Comp_ProficiencyLevels.Where(l => competencyIds.Contains(l.CompetencyId)).ToListAsync();

        _reportingRows = await JobReportingLineHelper.ResolveAsync(context, PosExecTypeId);
    }

