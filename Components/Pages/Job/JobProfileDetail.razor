    private async Task AddRequirementAsync()
    {
        _error = null;
        if (!await RequireAsync(ProgramRoleService.ProgramAction.Edit)) return;
        if (_selectedCompetency is null) { _error = "กรุณาเลือกสมรรถนะ"; return; }

        await using var context = await DbFactory.CreateDbContextAsync();
        var existingForPair = await context.Job_CompetencyRequirements.FirstOrDefaultAsync(r => r.PosExecTypeId == PosExecTypeId && r.CompetencyId == _selectedCompetency.Id);
        if (existingForPair is { IsActive: true }) { _error = "สมรรถนะนี้ถูกเพิ่มไว้แล้ว"; return; }

        if (existingForPair is not null)
        {
            existingForPair.IsActive = true;
            existingForPair.RequiredLevel = _selectedLevel;
            existingForPair.IsCritical = _selectedCritical;
            existingForPair.SortOrder = _requirements.Count;
            await context.SaveChangesAsync();
            _selectedCompetency = null;
            _selectedLevel = 3;
            _selectedCritical = false;
            await LoadAsync();
            return;
        }

        context.Job_CompetencyRequirements.Add(new Job_CompetencyRequirement
        {
            PosExecTypeId = PosExecTypeId,
            CompetencyId = _selectedCompetency.Id,
            RequiredLevel = _selectedLevel,
            IsCritical = _selectedCritical,
            SortOrder = _requirements.Count,
        });
        await context.SaveChangesAsync();

        _selectedCompetency = null;
        _selectedLevel = 3;
        _selectedCritical = false;
        await LoadAsync();
    }

