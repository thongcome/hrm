    private async Task SaveDutiesAsync()
    {
        _error = null;
        if (!await RequireAsync(ProgramRoleService.ProgramAction.Edit)) return;

        var rows = ActiveDuties.Where(d => !string.IsNullOrWhiteSpace(d.Text)).ToList();
        if (rows.Count != ActiveDuties.Count)
        {
            _error = L.Translate("JdRowTextRequired");
            return;
        }

        await using var context = await DbFactory.CreateDbContextAsync();
        foreach (var row in rows)
        {
            row.Text = row.Text.Trim();
            if (row.Id == 0)
            {
                context.Job_ProfileDuties.Add(row);
            }
            else
            {
                var db = await context.Job_ProfileDuties.FirstOrDefaultAsync(d => d.Id == row.Id);
                if (db is null) continue;
                db.Text = row.Text;
                db.WeightPercent = row.WeightPercent;
                db.SortOrder = row.SortOrder;
                db.IncludeInCompetency = row.IncludeInCompetency;
                db.LinkedCompetencyId = row.LinkedCompetencyId;
            }
        }

        await UpsertLinkedRequirementsAsync(context,
            rows.Where(r => r.IncludeInCompetency && r.LinkedCompetencyId is not null).Select(r => r.LinkedCompetencyId!.Value));

        await StampJdVersionAsync(context);
        await context.SaveChangesAsync();
        Snackbar.Add(L.Translate("JdSavedMessage"), Severity.Success);
        await LoadAsync();
    }

