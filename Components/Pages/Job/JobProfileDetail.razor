    // ---------- JD versioning (lightweight — JD block B) ----------
    // Deliberately NO history table this round (CEO-approved trade-off):
    // only a running version number + last-reviewed stamp on Pos_ExecType.
    // Called once per save action that changes JD content (Purpose, duties,
    // qualifications, KPIs — including soft removals), inside the same
    // context/SaveChanges as the content change itself.
    private async Task StampJdVersionAsync(HRMContext context)
    {
        var execType = await context.Pos_ExecTypes.FirstOrDefaultAsync(e => e.Id == PosExecTypeId);
        if (execType is null) return;
        execType.JdVersion += 1;
        execType.JdReviewedDate = DateTime.Now;
        execType.JdReviewedBy = _actorName;
    }

    private string JdVersionLine()
    {
        if (_execType is null) return "";
        return _execType.JdReviewedDate is DateTime rd
            ? string.Format(L.Translate("JdVersionTemplate"), _execType.JdVersion, rd.ToString("dd/MM/yyyy HH:mm"), _execType.JdReviewedBy ?? "-")
            : string.Format(L.Translate("JdVersionOnlyTemplate"), _execType.JdVersion);
    }

    // Both layers, always (AD.CRUDManage): every write handler re-checks the
    // table right server-side — a hidden button stops nobody who replays the
    // circuit event. Returns false (with the error surfaced) when refused.
    private async Task<bool> RequireAsync(ProgramRoleService.ProgramAction action)
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        try
        {
            await ProgramRoles.RequireAsync(state.User, ProgramPath, action);
            return true;
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
            return false;
        }
    }

    private async Task SaveProfileAsync()
    {
        _error = null;
        if (!await RequireAsync(ProgramRoleService.ProgramAction.Edit)) return;

        await using var context = await DbFactory.CreateDbContextAsync();
        var existing = await context.Pos_ExecTypes.FirstOrDefaultAsync(e => e.Id == PosExecTypeId);
        if (existing is null) { _error = "ไม่พบข้อมูล"; return; }

        existing.JobFamilyId = _jobFamilyId;
        existing.CareerTrack = _careerTrack;
        existing.JobLevelId = _jobLevelId;
        var newPurpose = string.IsNullOrWhiteSpace(_purpose) ? null : _purpose;
        if (existing.Purpose != newPurpose)
        {
            // JD content changed (Purpose) — bump version + stamp reviewer.
            // Family/track/level edits alone are classification, not JD
            // content, so they don't bump.
            existing.JdVersion += 1;
            existing.JdReviewedDate = DateTime.Now;
            existing.JdReviewedBy = _actorName;
        }
        existing.Purpose = newPurpose;
        // KeyAccountabilities deliberately untouched here — the legacy blob is
        // read-only fallback display now (see the duties section), never
        // edited or deleted from this page.
        await context.SaveChangesAsync();

        Snackbar.Add("บันทึก Job Profile เรียบร้อย", Severity.Success);
        await LoadAsync();
    }

