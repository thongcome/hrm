    // CEO's competency link: a flagged+linked JD line materializes as a
    // Job_CompetencyRequirement for this position (default RequiredLevel 3 —
    // mid-scale, editable afterward in the requirements table like any other
    // row). Deliberately upsert-only: UNFLAGGING a line does NOT delete or
    // deactivate the requirement it once created, because HR may since have
    // tuned that requirement's level/criticality by hand — a JD edit must
    // never silently destroy that tuning. Removing a requirement stays an
    // explicit act in the requirements table below.
    private async Task UpsertLinkedRequirementsAsync(HRMContext context, IEnumerable<long> competencyIds)
    {
        var existingCount = await context.Job_CompetencyRequirements.CountAsync(r => r.PosExecTypeId == PosExecTypeId);
        foreach (var competencyId in competencyIds.Distinct())
        {
            var existing = await context.Job_CompetencyRequirements
                .FirstOrDefaultAsync(r => r.PosExecTypeId == PosExecTypeId && r.CompetencyId == competencyId);
            if (existing is null)
            {
                context.Job_CompetencyRequirements.Add(new Job_CompetencyRequirement
                {
                    PosExecTypeId = PosExecTypeId,
                    CompetencyId = competencyId,
                    RequiredLevel = 3,
                    IsCritical = false,
                    SortOrder = existingCount++,
                });
            }
            else if (!existing.IsActive)
            {
                // Was soft-removed earlier — flagging a JD line to it again is
                // an explicit signal to bring it back (keeping its old level).
                existing.IsActive = true;
            }
            // Active existing row: leave it exactly as HR tuned it.
        }
    }

    // ---------- ML.NET suggestions ----------

    private Task SuggestCompetenciesAsync()
    {
        _error = null;
        _suggestions.Clear();

        var catalog = _allCompetencies
            .Select(c => new JdCompetencySuggestionService.CatalogItem(
                c.Id,
                $"{c.Code} — {c.Name}",
                string.Join(" ", new[] { c.Code, c.Name, c.NameEn, c.Description }.Where(s => !string.IsNullOrWhiteSpace(s)))))
            .ToList();

        var rowByKey = new Dictionary<string, object>();
        var lines = new List<JdCompetencySuggestionService.QueryLine>();
        var i = 0;
        foreach (var d in ActiveDuties.Where(d => d.LinkedCompetencyId is null && !string.IsNullOrWhiteSpace(d.Text)))
        {
            var key = $"D{i++}";
            rowByKey[key] = d;
            lines.Add(new JdCompetencySuggestionService.QueryLine(key, d.Text));
        }
        foreach (var q in ActiveQualifications.Where(q => q.LinkedCompetencyId is null && !string.IsNullOrWhiteSpace(q.Text)))
        {
            var key = $"Q{i++}";
            rowByKey[key] = q;
            lines.Add(new JdCompetencySuggestionService.QueryLine(key, q.Text));
        }

        if (lines.Count == 0 || catalog.Count == 0)
        {
            Snackbar.Add(L.Translate("JdSuggestNothingToScan"), Severity.Info);
            return Task.CompletedTask;
        }

        // In-process, on demand — the catalog is small, fitting takes
        // milliseconds; no scheduler, no persisted model (see service comment).
        var suggestions = JdCompetencySuggestionService.Suggest(catalog, lines);
        foreach (var (key, sugs) in suggestions)
            _suggestions[rowByKey[key]] = sugs;

        return Task.CompletedTask;
    }

    private void AcceptSuggestion(Job_ProfileDuty? duty, Job_ProfileQualification? qual, JdCompetencySuggestionService.Suggestion s)
    {
        if (duty is not null)
        {
            duty.IncludeInCompetency = true;
            duty.LinkedCompetencyId = s.CompetencyId;
            _suggestions.Remove(duty);
        }
        if (qual is not null)
        {
            qual.IncludeInCompetency = true;
            qual.LinkedCompetencyId = s.CompetencyId;
            _suggestions.Remove(qual);
        }
        // Link is set in-memory only — the section's save button persists it
        // (and upserts the Job_CompetencyRequirement).
        Snackbar.Add(string.Format(L.Translate("JdSuggestAccepted"), s.DisplayName), Severity.Info);
    }

