@page "/sc_menus/delete"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using HRM.Models
@inject IDbContextFactory<HRM.Models.HRMContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>sc_menu</h2>
    <hr />
    @if (sc_menu is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">menuname</dt>
            <dd class="col-sm-10">@sc_menu.menuname</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">menulevel</dt>
            <dd class="col-sm-10">@sc_menu.menulevel</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">isfinal</dt>
            <dd class="col-sm-10">@sc_menu.isfinal</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">menuorder</dt>
            <dd class="col-sm-10">@sc_menu.menuorder</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">menucode</dt>
            <dd class="col-sm-10">@sc_menu.menucode</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">langcode</dt>
            <dd class="col-sm-10">@sc_menu.langcode</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">isshow</dt>
            <dd class="col-sm-10">@sc_menu.isshow</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">tooltip</dt>
            <dd class="col-sm-10">@sc_menu.tooltip</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">startdate</dt>
            <dd class="col-sm-10">@sc_menu.startdate</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">enddate</dt>
            <dd class="col-sm-10">@sc_menu.enddate</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">programid</dt>
            <dd class="col-sm-10">@sc_menu.programid</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">icon</dt>
            <dd class="col-sm-10">@sc_menu.icon</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">small_icon</dt>
            <dd class="col-sm-10">@sc_menu.small_icon</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">url</dt>
            <dd class="col-sm-10">@sc_menu.url</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">moddate</dt>
            <dd class="col-sm-10">@sc_menu.moddate</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">modby</dt>
            <dd class="col-sm-10">@sc_menu.modby</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">uppermenucode</dt>
            <dd class="col-sm-10">@sc_menu.uppermenucode</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">menugroupid</dt>
            <dd class="col-sm-10">@sc_menu.menugroupid</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">isactive</dt>
            <dd class="col-sm-10">@sc_menu.isactive</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">method_action</dt>
            <dd class="col-sm-10">@sc_menu.method_action</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">menuname_en</dt>
            <dd class="col-sm-10">@sc_menu.menuname_en</dd>
        </dl>
        <EditForm method="post" Model="sc_menu" OnValidSubmit="Deletesc_menu" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(sc_menu is null)">Delete</button> |
            <a href="/sc_menus">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private sc_menu? sc_menu;

    [SupplyParameterFromQuery]
    private long menuid { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        sc_menu = await context.sc_menus.FirstOrDefaultAsync(m => m.menuid == menuid);

        if (sc_menu is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task Deletesc_menu()
    {
        using var context = DbFactory.CreateDbContext();
        context.sc_menus.Remove(sc_menu!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/sc_menus");
    }
}
