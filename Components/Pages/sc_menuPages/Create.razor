@page "/sc_menus/create"
@using Microsoft.EntityFrameworkCore
@using HRM.Models
@inject IDbContextFactory<HRM.Models.HRMContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>sc_menu</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="sc_menu" OnValidSubmit="Addsc_menu" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert"/>

            <!-- 🔽 Menu Group Dropdown -->
            <div class="mb-3">
                <label for="menugroupid" class="form-label">Menu Group:</label>
                <InputSelect id="menugroupid"
                             class="form-control"
                             @bind-Value="sc_menu.menugroupid">
                    <option value="menugroup">-- เลือกกลุ่มเมนู --</option>
                    @if (Menugroup is not null)
                    {
                        @foreach (var c in Menugroup)
                        {
                            <option value="@c.menugroupid">@c.menugroupname</option>
                        }
                    }
                </InputSelect>
                <ValidationMessage For="() => sc_menu.menugroupid" class="text-danger" />
            </div>
            <!-- 🔼 Company Dropdown -->
            <div class="mb-3">
                <label for="menuname" class="form-label">menuname:</label> 
                <InputText id="menuname" @bind-Value="sc_menu.menuname" class="form-control" /> 
                <ValidationMessage For="() => sc_menu.menuname" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="menulevel" class="form-label">menulevel:</label> 
                <InputNumber id="menulevel" @bind-Value="sc_menu.menulevel" class="form-control" /> 
                <ValidationMessage For="() => sc_menu.menulevel" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="isfinal" class="form-label">isfinal:</label> 
                <InputCheckbox id="isfinal" @bind-Value="sc_menu.isfinal" class="form-check-input" /> 
                <ValidationMessage For="() => sc_menu.isfinal" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="menuorder" class="form-label">menuorder:</label> 
                <InputNumber id="menuorder" @bind-Value="sc_menu.menuorder" class="form-control" /> 
                <ValidationMessage For="() => sc_menu.menuorder" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="menucode" class="form-label">menucode:</label> 
                <InputText id="menucode" @bind-Value="sc_menu.menucode" class="form-control" /> 
                <ValidationMessage For="() => sc_menu.menucode" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="langcode" class="form-label">langcode:</label> 
                <InputText id="langcode" @bind-Value="sc_menu.langcode" class="form-control" /> 
                <ValidationMessage For="() => sc_menu.langcode" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="isshow" class="form-label">isshow:</label> 
                <InputCheckbox id="isshow" @bind-Value="sc_menu.isshow" class="form-check-input" aria-required="true"/> 
                <ValidationMessage For="() => sc_menu.isshow" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="tooltip" class="form-label">tooltip:</label> 
                <InputText id="tooltip" @bind-Value="sc_menu.tooltip" class="form-control" /> 
                <ValidationMessage For="() => sc_menu.tooltip" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="startdate" class="form-label">startdate:</label> 
                <InputDate id="startdate" @bind-Value="sc_menu.startdate" class="form-control" /> 
                <ValidationMessage For="() => sc_menu.startdate" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="enddate" class="form-label">enddate:</label> 
                <InputDate id="enddate" @bind-Value="sc_menu.enddate" class="form-control" /> 
                <ValidationMessage For="() => sc_menu.enddate" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="programid" class="form-label">programid:</label> 
                <InputNumber id="programid" @bind-Value="sc_menu.programid" class="form-control" /> 
                <ValidationMessage For="() => sc_menu.programid" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="icon" class="form-label">icon:</label> 
                <InputText id="icon" @bind-Value="sc_menu.icon" class="form-control" /> 
                <ValidationMessage For="() => sc_menu.icon" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="small_icon" class="form-label">small_icon:</label> 
                <InputText id="small_icon" @bind-Value="sc_menu.small_icon" class="form-control" /> 
                <ValidationMessage For="() => sc_menu.small_icon" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="url" class="form-label">url:</label> 
                <InputText id="url" @bind-Value="sc_menu.url" class="form-control" /> 
                <ValidationMessage For="() => sc_menu.url" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="moddate" class="form-label">moddate:</label> 
                <InputDate id="moddate" @bind-Value="sc_menu.moddate" class="form-control" /> 
                <ValidationMessage For="() => sc_menu.moddate" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="modby" class="form-label">modby:</label> 
                <InputText id="modby" @bind-Value="sc_menu.modby" class="form-control" /> 
                <ValidationMessage For="() => sc_menu.modby" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="uppermenucode" class="form-label">uppermenucode:</label> 
                <InputText id="uppermenucode" @bind-Value="sc_menu.uppermenucode" class="form-control" /> 
                <ValidationMessage For="() => sc_menu.uppermenucode" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="menugroupid" class="form-label">menugroupid:</label> 
                <InputNumber id="menugroupid" @bind-Value="sc_menu.menugroupid" class="form-control" /> 
                <ValidationMessage For="() => sc_menu.menugroupid" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="isactive" class="form-label">isactive:</label> 
                <InputCheckbox id="isactive" @bind-Value="sc_menu.isactive" class="form-check-input" aria-required="true"/> 
                <ValidationMessage For="() => sc_menu.isactive" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="method_action" class="form-label">method_action:</label> 
                <InputText id="method_action" @bind-Value="sc_menu.method_action" class="form-control" /> 
                <ValidationMessage For="() => sc_menu.method_action" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="menuname_en" class="form-label">menuname_en:</label> 
                <InputText id="menuname_en" @bind-Value="sc_menu.menuname_en" class="form-control" /> 
                <ValidationMessage For="() => sc_menu.menuname_en" class="text-danger" /> 
            </div>        
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/sc_menus">Back to List</a>
</div>

@code {
    [SupplyParameterFromForm]
    private sc_menu sc_menu { get; set; } = new();
    private List<sc_menugroup> Menugroup { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();

        Menugroup = await context.sc_menugroups.ToListAsync();
    }


    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task Addsc_menu()
    {
        try
        {
            using var context = DbFactory.CreateDbContext();
            context.sc_menus.Add(sc_menu);
            await context.SaveChangesAsync();
            NavigationManager.NavigateTo("/sc_menus");
        }
        catch (Exception ex)
        {
            System.Console.WriteLine(ex.Message);
        }
    }
}
