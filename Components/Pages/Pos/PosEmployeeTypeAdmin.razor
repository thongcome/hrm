@page "/pos/employee-types"
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@attribute [Authorize(Policy = "Menu:POS_ADMIN")]

<PageTitle>ประเภทพนักงาน</PageTitle>

<MudPaper Class="pa-4 mb-4" MaxWidth="700px">
    <MudText Typo="Typo.h5">ประเภทพนักงาน (Employee Type)</MudText>
    <MudText Typo="Typo.body2" Class="mt-1">เช่น พนักงานประจำ/พนักงานสัญญาจ้าง/พนักงานชั่วคราว/คณะกรรมการ-อนุกรรมการ</MudText>

    @if (string.IsNullOrEmpty(_companyId))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">บัญชีของคุณยังไม่ได้ผูกกับบริษัทใดๆ — ติดต่อแอดมินให้ตั้งค่า empid ก่อน</MudAlert>
        return;
    }

    <MudDivider Class="my-4" />

    <MudTextField T="string" Value="_searchTerm" Label="ค้นหา" Immediate="true"
        DebounceInterval="300" ValueChanged="OnSearchChanged"
        AdornmentIcon="@Icons.Material.Filled.Search" Adornment="Adornment.Start" Class="mb-3" />

    @if (!_showForm)
    {
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" OnClick="StartCreate" Class="mb-3">เพิ่มประเภทพนักงาน</MudButton>
    }
    else
    {
        <MudText Typo="Typo.h6">@(_editingId is null ? "เพิ่มประเภทพนักงาน" : "แก้ไข")</MudText>
        <MudGrid Class="mt-1">
            <MudItem xs="12" sm="3"><MudTextField @bind-Value="_code" Label="รหัส" Required="true" MaxLength="30"
                HelperText="ต้องตรงกับประเภทพนักงานในข้อมูลพนักงาน เช่น 01, 02" /></MudItem>
            <MudItem xs="12" sm="5"><MudTextField @bind-Value="_name" Label="ชื่อ" Required="true" /></MudItem>
            <MudItem xs="12" sm="4">
                <MudSwitch T="bool" @bind-Value="_isActive" Color="Color.Success" Label="ใช้งานอยู่" />
            </MudItem>
            <MudItem xs="12">
                <MudSwitch T="bool" @bind-Value="_isPaidByPayroll" Color="Color.Primary" Label="รับเงินเดือนผ่านระบบ" />
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    ปิด = พนักงานประเภทนี้ (เช่น กรรมการที่ไม่รับเงินเดือน) จะไม่ถูกนำเข้ารอบเงินเดือน และหน้าตรวจสอบก่อนประมวลผลจะแสดงเหตุผลให้เห็น
                </MudText>
            </MudItem>
            <MudItem xs="12"><MudTextField @bind-Value="_remark" Label="หมายเหตุ" /></MudItem>
        </MudGrid>

        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
        }

        <MudStack Row="true" Spacing="2" Class="mt-3 mb-3">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">บันทึก</MudButton>
            <MudButton Variant="Variant.Text" OnClick="CancelEdit">ยกเลิก</MudButton>
        </MudStack>
    }

    <MudDivider Class="my-5" />

    <MudTable Items="_items" Dense="true" Hover="true">
        <HeaderContent>
            <MudTh>รหัส</MudTh>
            <MudTh>ชื่อ</MudTh>
            <MudTh>หมายเหตุ</MudTh>
            <MudTh>เงินเดือน</MudTh>
            <MudTh>สถานะ</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Code</MudTd>
            <MudTd>@context.Name</MudTd>
            <MudTd>@context.Remark</MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Color="@(context.IsPaidByPayroll ? Color.Primary : Color.Default)">
                    @(context.IsPaidByPayroll ? "รับผ่านระบบ" : "ไม่รับผ่านระบบ")
                </MudChip>
            </MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                    @(context.IsActive ? "ใช้งาน" : "ไม่ใช้งาน")
                </MudChip>
            </MudTd>
            <MudTd>
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => StartEdit(context))">แก้ไข</MudButton>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2">ยังไม่มีข้อมูล</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private string? _companyId;
    private List<Pos_EmployeeType> _items = new();
    private string? _searchTerm;
    private string? _error;
    private long? _editingId;
    private bool _showForm;

    private string _name = "";
    private bool _isActive = true;
    private bool _isPaidByPayroll = true;
    private string? _code;
    private string? _remark;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
        if (string.IsNullOrWhiteSpace(_companyId)) return;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var query = context.Pos_EmployeeTypes.Where(t => t.CompanyId == _companyId);
        query = EntitySearchHelper.ApplyTextSearch(query, _searchTerm, nameof(Pos_EmployeeType.Name));
        _items = await query.OrderBy(t => t.Id).ToListAsync();
    }

    private async Task OnSearchChanged(string term)
    {
        _searchTerm = term;
        await LoadAsync();
    }

    private void StartCreate()
    {
        _editingId = null;
        _name = "";
        _code = null;
        _isActive = true;
        _isPaidByPayroll = true;
        _remark = null;
        _error = null;
        _showForm = true;
    }

    private void StartEdit(Pos_EmployeeType item)
    {
        _editingId = item.Id;
        _name = item.Name;
        _code = item.Code;
        _isActive = item.IsActive;
        _isPaidByPayroll = item.IsPaidByPayroll;
        _remark = item.Remark;
        _error = null;
        _showForm = true;
    }

    private void CancelEdit()
    {
        _editingId = null;
        _name = "";
        _isActive = true;
        _remark = null;
        _error = null;
        _showForm = false;
    }

    private async Task SaveAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_name)) { _error = "กรุณาระบุชื่อ"; return; }
        if (string.IsNullOrWhiteSpace(_code)) { _error = "กรุณาระบุรหัส"; return; }
        _code = _code.Trim();

        await using var context = await DbFactory.CreateDbContextAsync();
        var editingId = _editingId ?? 0;
        if (await context.Pos_EmployeeTypes.AnyAsync(t => t.CompanyId == _companyId && t.Code == _code && t.Id != editingId))
        { _error = $"รหัส {_code} มีอยู่แล้ว"; return; }

        if (_editingId is long id)
        {
            var existing = await context.Pos_EmployeeTypes.FirstOrDefaultAsync(t => t.Id == id && t.CompanyId == _companyId);
            if (existing is null) { _error = "ไม่พบข้อมูล"; return; }
            existing.Name = _name;
            existing.Code = _code;
            existing.IsActive = _isActive;
            existing.IsPaidByPayroll = _isPaidByPayroll;
            existing.Remark = _remark;
        }
        else
        {
            context.Pos_EmployeeTypes.Add(new Pos_EmployeeType
            {
                CompanyId = _companyId!,
                Name = _name,
                Code = _code,
                IsActive = _isActive,
                IsPaidByPayroll = _isPaidByPayroll,
                Remark = _remark,
            });
        }

        await context.SaveChangesAsync();
        Snackbar.Add("บันทึกเรียบร้อย", Severity.Success);
        CancelEdit();
        await LoadAsync();
    }
}
