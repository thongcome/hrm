@page "/pos/position-slots"
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@using HRM.Services.Pos
@using HRM.Services.Hr
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject SeparationRequestService SeparationService
@inject EmployeeSlotBackfillService SlotBackfillService
@inject GradeLadderService GradeService
@attribute [Authorize(Policy = "Menu:POS_ADMIN")]

@* Pure List page — CRUD skill rule 9 (landing state is always List/View, never
   a Create/Edit form). Create/Edit now live on their own dedicated route
   (PositionSlotEdit.razor: /pos/position-slots/new and
   /pos/position-slots/{id}/edit) and View is a new route
   (PositionSlotDetail.razor: /pos/position-slots/{id}) — this page used to
   toggle an inline edit form in place, which meant browser Back had nothing
   to land on (no URL ever changed) and clicking a row skipped straight past
   View into an editable form. *@

<PageTitle>เลขที่อัตรา</PageTitle>

<MudPaper Class="pa-4 mb-4" MaxWidth="1100px">
    <MudText Typo="Typo.h5">เลขที่อัตรา (Position Headcount Slot)</MudText>
    <MudText Typo="Typo.body2" Class="mt-1">
        อัตรากำลังแต่ละ "ที่นั่ง" — ผูกกับสังกัดและชื่อตำแหน่ง มีคนครองอยู่หรือว่างก็ได้
    </MudText>

    @if (string.IsNullOrEmpty(_companyId))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">บัญชีของคุณยังไม่ได้ผูกกับบริษัทใดๆ — ติดต่อแอดมินให้ตั้งค่า empid ก่อน</MudAlert>
        return;
    }

    <MudDivider Class="my-4" />

    <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Href="/pos/position-slots/new">เพิ่มเลขที่อัตรา</MudButton>
        <MudButton Color="Color.Secondary" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.GroupAdd"
            OnClick="BackfillFromEmployeesAsync" Disabled="_backfilling">
            @(_backfilling ? "กำลังสร้าง..." : "สร้างอัตราจากพนักงาน")
        </MudButton>
        <MudButton Color="Color.Tertiary" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Stairs"
            OnClick="BuildGradeLadderAsync" Disabled="_grading">
            @(_grading ? "กำลังกำหนด..." : "กำหนดระดับตำแหน่งจากตำแหน่ง (demo)")
        </MudButton>
    </MudStack>
    <MudText Typo="Typo.caption" Class="d-block mt-1" Style="color:var(--mud-palette-text-secondary);">
        "สร้างอัตราจากพนักงาน" = สร้าง 1 อัตราต่อพนักงานที่ยังทำงานอยู่แต่ยังไม่มีอัตรา (ดึงตำแหน่งจาก POS_CODE + ประเภทพนักงานจาก EMPTYPE_CODE) — ทำซ้ำได้ ข้ามคนที่มีอัตราแล้ว เพื่อให้ผังองค์กรแสดงคนครบ
    </MudText>

    <MudDivider Class="my-5" />

    @if (_filterOrgId is not null)
    {
        <MudAlert Severity="Severity.Info" Class="mb-3" Dense="true">
            กำลังกรองเฉพาะสังกัดที่เลือกมา — <MudLink OnClick="ClearOrgFilter" Style="cursor:pointer">ล้างตัวกรอง</MudLink>
        </MudAlert>
    }
    @if (_filterEmployeeId is not null)
    {
        <MudAlert Severity="Severity.Info" Class="mb-3" Dense="true">
            กำลังกรองเฉพาะเลขที่อัตราของพนักงานที่เลือกมา — <MudLink OnClick="ClearEmployeeFilter" Style="cursor:pointer">ล้างตัวกรอง</MudLink>
        </MudAlert>
    }

    <MudTextField T="string" Value="_searchTerm" Label="ค้นหาเลขที่อัตรา (เลขที่ / ชื่อตำแหน่ง)" Immediate="true"
        DebounceInterval="300" ValueChanged="OnSearchChanged"
        AdornmentIcon="@Icons.Material.Filled.Search" Adornment="Adornment.Start" Class="mb-3" />

    <MudTable Items="_slots" Dense="true" Hover="true" HorizontalScrollbar="true">
        <HeaderContent>
            <MudTh>เลขที่ตำแหน่ง</MudTh>
            <MudTh>ชื่อตำแหน่ง</MudTh>
            <MudTh>สังกัด</MudTh>
            <MudTh>วันที่มีผล</MudTh>
            <MudTh>ผู้ครองตำแหน่ง</MudTh>
            <MudTh>สถานะ</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.PosCode</MudTd>
            <MudTd>@context.Name</MudTd>
            <MudTd>@OrgName(context.OrganizationId)</MudTd>
            <MudTd>@(context.StartDate?.ToString("dd/MM/yyyy"))</MudTd>
            <MudTd>@(EmployeeName(context.HremployeeId) ?? "ว่าง")</MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                    @(context.IsActive ? "ใช้อยู่" : "ปิดใช้งาน")
                </MudChip>
            </MudTd>
            <MudTd>
                <MudButton Size="Size.Small" Variant="Variant.Text" Href="@($"/pos/position-slots/{context.Id}")">ดู</MudButton>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2">ยังไม่มีข้อมูล</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
</MudPaper>

@code {
    private string? _companyId;
    private List<Pos_PositionSlot> _slots = new();
    private Dictionary<long, string> _orgNames = new();
    private Dictionary<long, string> _employeeNames = new();
    private string? _searchTerm;
    private long? _filterOrgId;
    private long? _filterEmployeeId;
    private bool _backfilling;
    private bool _grading;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
        if (string.IsNullOrWhiteSpace(_companyId)) return;

        // Lazy apply-on-read (no scheduler): free any อัตรา whose occupant's
        // separation effective date has arrived, so vacancy shown here is current.
        await SeparationService.ApplyDueSeparationsAsync();

        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("orgId", out var orgIdStr) && long.TryParse(orgIdStr, out var orgId))
        {
            _filterOrgId = orgId;
        }
        if (query.TryGetValue("employeeId", out var empIdStr) && long.TryParse(empIdStr, out var empId))
        {
            _filterEmployeeId = empId;
        }

        await LoadAsync();
    }

    private void ClearOrgFilter()
    {
        _filterOrgId = null;
        _ = LoadAsync();
    }

    private void ClearEmployeeFilter()
    {
        _filterEmployeeId = null;
        _ = LoadAsync();
    }

    private string? OrgName(long? id)
    {
        if (id is null) return null;
        return _orgNames.TryGetValue(id.Value, out var name) ? name : null;
    }

    private string? EmployeeName(long? id)
    {
        if (id is null) return null;
        return _employeeNames.TryGetValue(id.Value, out var name) ? name : null;
    }

    private async Task LoadAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var query = context.Pos_PositionSlots.Where(s => s.CompanyId == _companyId);
        if (_filterOrgId is not null)
            query = query.Where(s => s.OrganizationId == _filterOrgId);
        if (_filterEmployeeId is not null)
            query = query.Where(s => s.HremployeeId == _filterEmployeeId);
        query = EntitySearchHelper.ApplyTextSearch(query, _searchTerm, nameof(Pos_PositionSlot.PosCode), nameof(Pos_PositionSlot.Name));
        _slots = await query.OrderBy(s => s.PosCode).ToListAsync();

        var orgIds = _slots.Where(s => s.OrganizationId is not null).Select(s => s.OrganizationId!.Value).Distinct().ToList();
        _orgNames = await context.com_organizations.Where(o => orgIds.Contains(o.id)).ToDictionaryAsync(o => o.id, o => $"{o.code} — {o.name}");

        var empIds = _slots.Where(s => s.HremployeeId is not null).Select(s => s.HremployeeId!.Value).Distinct().ToList();
        _employeeNames = await context.Hremployee.Where(e => empIds.Contains(e.id)).ToDictionaryAsync(e => e.id, e => $"{e.EmpName} {e.EmpSurname}");
    }

    private async Task OnSearchChanged(string term)
    {
        _searchTerm = term;
        await LoadAsync();
    }

    private async Task BuildGradeLadderAsync()
    {
        if (string.IsNullOrEmpty(_companyId)) return;
        _grading = true;
        try
        {
            var state = await AuthProvider.GetAuthenticationStateAsync();
            var userId = long.TryParse(state.User.FindFirstValue("sc_userid"), out var uid) ? uid : 0;
            var r = await GradeService.BuildAsync(_companyId, userId);
            Snackbar.Add($"เพิ่มระดับใหม่ {r.GradesSeeded} · กำหนดระดับให้พนักงาน {r.EmployeesGraded} คน (A0n → ระดับ n) — ปรับ 7.5 เองได้ที่หน้าระดับตำแหน่ง",
                Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add("กำหนดระดับไม่สำเร็จ: " + ex.Message, Severity.Error);
        }
        finally
        {
            _grading = false;
        }
    }

    private async Task BackfillFromEmployeesAsync()
    {
        if (string.IsNullOrEmpty(_companyId)) return;
        _backfilling = true;
        try
        {
            var state = await AuthProvider.GetAuthenticationStateAsync();
            var userId = long.TryParse(state.User.FindFirstValue("sc_userid"), out var uid) ? uid : 0;
            var r = await SlotBackfillService.BackfillAsync(_companyId, userId);
            Snackbar.Add($"สร้างอัตราใหม่ {r.SlotsCreated} รายการ · ข้าม (มีอัตราแล้ว) {r.Skipped} · ปรับประเภทพนักงาน {r.EmployeeTypesAligned}"
                + (r.NoPositionMatch > 0 ? $" · ไม่พบตำแหน่งตาม POS_CODE {r.NoPositionMatch} คน" : ""),
                r.SlotsCreated > 0 ? Severity.Success : Severity.Info);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add("สร้างอัตราจากพนักงานไม่สำเร็จ: " + ex.Message, Severity.Error);
        }
        finally
        {
            _backfilling = false;
        }
    }
}
