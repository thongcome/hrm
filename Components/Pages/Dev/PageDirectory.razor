@page "/dev/pages"
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@attribute [Authorize(Policy = "Menu:SYS_ADMIN")]

<PageTitle>รวมลิงก์หน้าทั้งหมด (Dev)</PageTitle>

<MudPaper Class="pa-4 mb-4">
    <MudText Typo="Typo.h5">รวมลิงก์หน้าทั้งหมดในระบบ (สำหรับ Dev อ้างอิง)</MudText>
    <MudText Typo="Typo.body2" Class="mt-1">
        หน้านี้เป็นแค่ลิสต์อ้างอิง ไม่ใช่เมนูใช้งานจริง — ไม่ได้กรองตามสิทธิ์รายบุคคล (สิทธิ์จริงยังคุมที่หน้าปลายทางแต่ละหน้าเหมือนเดิม)
    </MudText>

    @foreach (var group in _groups)
    {
        <MudText Typo="Typo.h6" Class="mt-5 mb-1">@group.Title</MudText>
        <MudSimpleTable Dense="true" Hover="true">
            <thead>
                <tr><th style="width:30%">หน้า</th><th style="width:20%">Route</th><th>ทำหน้าที่</th></tr>
            </thead>
            <tbody>
                @foreach (var item in group.Items)
                {
                    <tr>
                        <td><MudLink Href="@item.Route">@item.Name</MudLink></td>
                        <td><code>@item.Route</code></td>
                        <td>@item.Description</td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    }
</MudPaper>

@code {
    private record PageItem(string Name, string Route, string Description);
    private record PageGroup(string Title, List<PageItem> Items);

    private readonly List<PageGroup> _groups = new()
    {
        new("Payroll", new()
        {
            new("จัดการพนักงาน (Payroll)", "/pay/employees", "เพิ่ม/แก้ไขพนักงาน, ลงวันที่ลาออก, แนบเอกสาร — แก้ Hremployee แถวเดียวกับที่คำนวณจริงใช้"),
            new("จัดการงวดเงินเดือน", "/pay/admin/periods", "ตั้งค่างวด (Pay_PayrollPeriod) ใช้เป็น dropdown ในหน้าตรวจสอบรายชื่อ"),
            new("ตั้งค่าสลิปเงินเดือน", "/pay/admin/payslip-settings", "ตั้งรูปแบบรหัสผ่านสลิป PDF ต่อบริษัท"),
            new("รายการเงินได้-เงินหักเฉพาะกิจ", "/pay/adhoc", "HR ป้อนรายการพิเศษ (โบนัส/หักเฉพาะกิจ) รออนุมัติก่อนถูกดึงเข้าคำนวณ"),
            new("เงินเดือน (ใหม่)", "/pay/runs", "ประมวลผลเงินเดือนจริง — ระบบหลักที่ใช้งาน (Draft→Calculated→Approved→Posted→Paid)"),
            new("ประมวลผลเงินเดือน (เก่า)", "/payrollprocess", "wizard เก่า ยังไม่ตัดออก แก้เฉพาะ Step 1 (ตรวจสอบรายชื่อ) ไปแล้ว — ไม่ใช่ระบบหลัก"),
            new("AI ประมวลผลเงินเดือน (เก่า)", "/AIpayrollprocess", "เหมือนหน้าบน + มีการตรวจ anomaly ด้วย AI — ยังไม่ได้แก้ ไม่ใช่ระบบหลัก"),
            new("พนักงาน (payrolls, เก่า)", "/hremployees", "scaffold ดิบ 88 คอลัมน์ รกรุงรัง — ยังไม่ได้ปรับ ใช้ /pay/employees แทนสำหรับงาน Payroll"),
        }),
        new("บันทึกเวลาเข้างาน (Attendance)", new()
        {
            new("ตั้งค่าเวลาเข้างาน", "/att/settings", "สวิตช์หลักต่อบริษัท: ไม่เปิดใช้ / บันทึกเข้า-ออกอย่างเดียว / มีระบบกะ"),
            new("จัดการกะ", "/att/shifts", "ตั้งกะ + มอบหมายกะรายบุคคล/รายวัน (รองรับกะหมุนเวียน) — ใช้เมื่อเลือก \"มีระบบกะ\""),
            new("นำเข้า Log เครื่องสแกน", "/att/import", "อัปโหลด CSV จากเครื่องสแกนลายนิ้วมือ/Face Recognition + ลงทะเบียนเครื่อง"),
            new("รายงานเวลาเข้างาน", "/att/report", "คำนวณและแสดงผลสาย/ออกก่อน/WFH ต่อวัน + จุดที่ HR ป้อน WFH แทนพนักงาน"),
        }),
        new("ระบบ/แอดมิน", new()
        {
            new("Role", "/sc_roles", "จัดการ role (sc_role) — มาจาก sc_menu แบบ dynamic"),
            new("ผูกบัญชี Identity", "/admin/link-identity-account", "สร้าง/ผูกบัญชี ASP.NET Identity (AspNetUsers) เข้ากับ sc_user เดิม — มาจาก sc_menu แบบ dynamic"),
            new("User Mng", "/sc_users", "จัดการ sc_user (บัญชี login หลักของระบบ)"),
            new("Master Data", "/masterdata", "ข้อมูลหลักทั่วไปของระบบ HR เดิม"),
        }),
        new("อื่นๆ / เก่า", new()
        {
            new("Dashboard", "/hrpayrolldasboard", "แดชบอร์ดเก่า ไม่ได้ผูกกับข้อมูล Pay_*/Att_* ใหม่"),
            new("Income Mng.", "/income", "จัดการรายได้ (ระบบเดิม)"),
            new("OT", "/ot", "จัดการ OT (ระบบเดิม)"),
            new("report", "/onlinereport", "รายงานออนไลน์ (ระบบเดิม)"),
            new("hrpayrolls", "/hrpayrolls", "scaffold CRUD ของ Hrpayroll เดิม"),
        }),
        // 7 ก.ย. 2569: scaffold CRUD ดิบของ workflow engine เดิม (Index/Create/
        // Edit/Details/Delete ที่ scaffold มาตรง ๆ จากตาราง) ถูกแทนที่ด้วยหน้า
        // Wf/*Admin.razor ทั้งหมดแล้ว (ทำงานกับ id จริง มี MudBlazor form, ค้นหา,
        // ผูก AD.CRUDManage) — 4 ใน 5 หน้านี้ไม่มีลิงก์ในเมนูจริงเลย เข้าได้แค่พิมพ์
        // URL ตรง ๆ เท่านั้น เก็บไว้อ้างอิงที่นี่แทนปล่อยลอยอยู่โดยไม่มีใครรู้
        new("Workflow Engine (เก่า, scaffold ดิบ)", new()
        {
            new("wf_workflow (เก่า)", "/wfworkflows", "scaffold CRUD ของ wf_workflow — แทนที่แล้วด้วย /wf/workflows (ยังมีลิงก์ในเมนูจริง ติดป้าย \"ระบบเดิม\")"),
            new("wf_loa (เก่า)", "/wf_loas", "scaffold CRUD ของ wf_loa (ช่วงวงเงินอนุมัติ) — แทนที่แล้วด้วย /wf/loa — ไม่มีลิงก์ในเมนูจริง"),
            new("wf_loa_user (เก่า)", "/wf_loa_users", "scaffold CRUD ของ wf_loa_user (ผู้อนุมัติตามวงเงิน) — แทนที่แล้วด้วย /wf/loa-users — ไม่มีลิงก์ในเมนูจริง"),
            new("wf_sub_workflow_master (เก่า)", "/wf_sub_workflow_masters", "scaffold CRUD ของระดับการอนุมัติ — แทนที่แล้วด้วย /wf/sub-workflow-levels — ไม่มีลิงก์ในเมนูจริง"),
            new("wf_role_authority (เก่า)", "/wf_role_authorities", "scaffold CRUD ของ wf_role_authority (Role↔Position↔Org master data ใหม่ ยังไม่ผูกเข้า engine) — ยังไม่มีหน้าใหม่มาแทน — ไม่มีลิงก์ในเมนูจริง"),
        }),
    };
}
