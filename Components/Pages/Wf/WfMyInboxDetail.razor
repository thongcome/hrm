@page "/wf/my-inbox/{JobMasterId:long}"
@using HRM.Models
@using HRM.Services.Workflow
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@using HRM.Services.Pay
@inject IDbContextFactory<HRMContext> DbFactory
@inject WorkflowEngineService Engine
@inject AuthenticationStateProvider AuthProvider
@inject PrivateFileStorage FileStorage
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject JsonLocalizationService L
@attribute [Authorize]

@* ESS-personalized page (self-scoped by the logged-in user's job_user_list
   assignment) — bare [Authorize] on purpose, no Menu:XXX policy. *@

<PageTitle>@string.Format(L.Translate("WfInboxDetailPageTitle"), JobMasterId)</PageTitle>

<MudPaper Class="pa-4 mb-4">
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack"
               OnClick="@(() => Nav.NavigateTo("/wf/my-inbox"))">
        @L.Translate("WfBackToInboxButton")
    </MudButton>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Class="mt-3" />
    }
    else if (_notMine || _job is null)
    {
        <MudAlert Severity="Severity.Info" Class="mt-3">@L.Translate("WfJobNotInInboxAlert")</MudAlert>
    }
    else
    {
        <MudText Typo="Typo.h5" Class="mt-3">@string.Format(L.Translate("WfInboxDetailHeadingTemplate"), _job.jobmasterid) — @_job.subject</MudText>
        <MudText Typo="Typo.body2" Class="mt-1">@L.Translate("WfWorkflowLabel"): @_job.wname</MudText>
        <MudText Typo="Typo.body2">@L.Translate("WfRequesterLabel"): @RequesterName() @(_job.createdate is not null ? $"({_job.createdate:dd/MM/yyyy HH:mm})" : "")</MudText>
        <MudText Typo="Typo.body2">@string.Format(L.Translate("WfJobStatusLevelLine"), _job.status, _job.lastLevel, _job.maxlevel)</MudText>

        @* Reusable front-steps progress stepper (self-loads by job id). *@
        <div class="mt-3 mb-2">
            <WorkflowStepper JobMasterId="JobMasterId" />
        </div>

        @* Pluggable document slot: renders the workflow's registered document
           component, or falls back to a link to the source document. *@
        <div class="mt-2 mb-1">
            <WorkflowDocumentSlot JobMasterId="JobMasterId" />
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
        }
        @if (!string.IsNullOrEmpty(_info))
        {
            <MudAlert Severity="Severity.Success" Class="mt-3">@_info</MudAlert>
        }

        @if (_myPendingRow is not null)
        {
            @* Reusable, config-driven action panel (write-once component) —
               which buttons show comes from this level's config passed in. *@
            <WorkflowActionPanel JobApproverId="@_myPendingRow.jobapproverid" ActorUserId="@_actorUserId"
                IsTop="@_currentIsTop" BackwardLevel="@_currentBackwardLevel" ApproveLabel="@_approveLabel"
                WorkflowId="@_job.workflowid" Wlevel="@(_job.lastLevel ?? 0)" IsAndCondition="@_currentIsAndCondition"
                OnActed="OnWorkflowActed" />
        }
        else
        {
            <MudAlert Severity="Severity.Normal" Class="mt-3">@L.Translate("WfNoPendingActionNote")</MudAlert>
        }

        <MudTable Items="_job.job_user_lists" Dense="true" Class="mt-3">
            <HeaderContent>
                <MudTh>@L.Translate("WfLevelHeader")</MudTh>
                <MudTh>@L.Translate("WfApproverHeader")</MudTh>
                <MudTh>@L.Translate("WfStatusHeader")</MudTh>
                <MudTh>@L.Translate("WfApproveDateHeader")</MudTh>
                <MudTh>@L.Translate("WfCommentHeader")</MudTh>
                <MudTh>@L.Translate("WfAttachmentHeader")</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.wlevel</MudTd>
                <MudTd>@(!string.IsNullOrWhiteSpace(context.username) ? context.username : ApproverName(context.userid))</MudTd>
                <MudTd>@context.jobstatus</MudTd>
                <MudTd>@context.approvedate?.ToString("dd/MM/yyyy HH:mm")</MudTd>
                <MudTd>@context.comment</MudTd>
                <MudTd>
                    @if (_attachments.TryGetValue(context.jobapproverid, out var files) && files.Count > 0)
                    {
                        <MudStack Spacing="0">
                            @foreach (var f in files)
                            {
                                <MudLink Href="@($"/wf/files/attachment/{f.id}")" Target="_blank">@f.files</MudLink>
                            }
                        </MudStack>
                    }
                    <MudFileUpload T="IBrowserFile" FilesChanged="@(file => UploadAttachmentAsync(context.jobapproverid, file))">
                        <ActivatorContent>
                            <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.AttachFile">@L.Translate("WfAttachFileButton")</MudButton>
                        </ActivatorContent>
                    </MudFileUpload>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

@code {
    [Parameter] public long JobMasterId { get; set; }

    private job_master? _job;
    private job_user_list? _myPendingRow;
    private Dictionary<long, string> _approverNames = new();
    private bool _currentIsTop;          // current level is the terminal (istop) level -> Decline allowed
    private int? _currentBackwardLevel;  // current level has a configured backwardlevel -> Send Back allowed
    private bool _currentIsAndCondition; // current level is an AND-condition level (for wf_button selection)
    private string _approveLabel = "อนุมัติ"; // forward-button caption, configurable per level (displayName)
    private Dictionary<long, List<doc_center>> _attachments = new();
    private bool _loading = true;
    private bool _notMine;
    private string? _error;
    private string? _info;

    private long _actorUserId;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _actorUserId = long.Parse(state.User.FindFirst("sc_userid")?.Value ?? "0");

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            // Same scoping the inbox list uses: the user's pending job_user_list
            // rows via the engine's inbox query. A job is visible here only if
            // the current user has an assignment row on it (pending or already
            // acted on) — never anyone else's jobs.
            var inbox = await Engine.GetMyInboxAsync(_actorUserId);
            _myPendingRow = inbox.FirstOrDefault(r => r.jobmasterid == JobMasterId);

            var job = await Engine.GetJobDetailAsync(JobMasterId);
            if (job is null || (_myPendingRow is null && !job.job_user_lists.Any(a => a.userid == _actorUserId)))
            {
                _notMine = true;
                _job = null;
                return;
            }

            _job = job;
            await LoadApproverNamesAsync();
            await LoadStageDefsAsync();
            await LoadAttachmentsAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    // Resolve every userid on this job (approvers + requester) to a Thai
    // display name once, as a fallback for rows without a name snapshot. Order:
    // authoritative Hremployee name → sc_user firstname+lastname → loginname →
    // empno — never a raw "#id" code (the CEO's complaint) and never blank.
    private async Task LoadApproverNamesAsync()
    {
        _approverNames = new();
        if (_job is null) return;

        var userIds = _job.job_user_lists.Where(a => a.userid.HasValue).Select(a => a.userid!.Value).ToList();
        if (_job.createuserid is long ruid) userIds.Add(ruid);
        userIds = userIds.Distinct().ToList();
        if (userIds.Count == 0) return;

        await using var context = await DbFactory.CreateDbContextAsync();
        var users = await context.sc_users
            .Where(u => userIds.Contains(u.userid))
            .Select(u => new { u.userid, u.empid, u.loginname, u.firstname, u.lastname })
            .ToListAsync();

        var empIds = users.Where(u => u.empid != null).Select(u => u.empid!).Distinct().ToList();
        var emps = await context.Hremployee
            .Where(e => empIds.Contains(e.EmpNo))
            .Select(e => new { e.EmpNo, e.EmpName, e.EmpSurname })
            .ToListAsync();
        var nameByEmpNo = emps.ToDictionary(e => e.EmpNo, e => $"{e.EmpName} {e.EmpSurname}".Trim());

        foreach (var u in users)
        {
            var scName = $"{u.firstname} {u.lastname}".Trim();
            var name = u.empid != null && nameByEmpNo.TryGetValue(u.empid, out var n) && !string.IsNullOrWhiteSpace(n)
                ? n
                : !string.IsNullOrWhiteSpace(scName) ? scName
                : !string.IsNullOrWhiteSpace(u.loginname) ? u.loginname!
                : (u.empid ?? "(ไม่พบชื่อ)");
            _approverNames[u.userid] = name;
        }
    }

    private string ApproverName(long? userid)
        => userid is long id && _approverNames.TryGetValue(id, out var n) ? n : "(ไม่ระบุผู้อนุมัติ)";

    private string RequesterName()
    {
        if (_job is null) return "-";
        if (!string.IsNullOrWhiteSpace(_job.createusername)) return _job.createusername!;
        if (!string.IsNullOrWhiteSpace(_job.reqName)) return _job.reqName!;
        if (_job.createuserid is long ruid && _approverNames.TryGetValue(ruid, out var n)) return n;
        return _job.createby ?? "-";
    }

    // Load the FULL ordered stage definition for this job's workflow — every
    // level, including ones not yet reached — so the progress bar can show the
    // whole path from the start (epms's approach: drive the stepper from the
    // wf_sub_workflow_master definition + job_master.lastLevel, not from the
    // per-approver rows that only materialise as the job advances).
    // Reads the CURRENT level's config (istop / backwardlevel / displayName) from
    // wf_sub_workflow_master — this drives which action buttons appear on the
    // WorkflowActionPanel and the forward button's caption. The full-path stepper
    // now lives in the reusable <WorkflowStepper>, which loads its own stage defs.
    private async Task LoadStageDefsAsync()
    {
        _currentIsTop = false;
        _currentBackwardLevel = null;
        _currentIsAndCondition = false;
        _approveLabel = "อนุมัติ";
        if (_job is null) return;
        await using var context = await DbFactory.CreateDbContextAsync();
        var cur = await context.wf_sub_workflow_masters
            .Where(s => s.workflowid == _job.workflowid && s.wlevel == (_job.lastLevel ?? 0))
            .Select(s => new { s.istop, s.backwardlevel, s.displayName, s.isandcondition })
            .FirstOrDefaultAsync();
        if (cur is not null)
        {
            _currentIsTop = cur.istop;
            _currentBackwardLevel = cur.backwardlevel;
            _currentIsAndCondition = cur.isandcondition;
            if (!string.IsNullOrWhiteSpace(cur.displayName)) _approveLabel = cur.displayName!;
        }
    }

    // The reusable <WorkflowActionPanel> now owns the buttons, confirm-before-
    // acting step, and engine calls; this page only reacts once an action
    // succeeds — go back to the inbox (the job left this user's queue).
    private void OnWorkflowActed() => Nav.NavigateTo("/wf/my-inbox");

    // Block 8: attachments per approval level — doc_center rows keyed by
    // refid = job_user_list.jobapproverid (see WorkflowFileEndpoints.cs for
    // why that's a sufficient key without a reftable discriminator column).
    private async Task LoadAttachmentsAsync()
    {
        _attachments = new();
        if (_job is null) return;

        var approverIds = _job.job_user_lists.Select(a => a.jobapproverid).ToList();
        await using var context = await DbFactory.CreateDbContextAsync();
        var docs = await context.doc_centers
            .Where(d => d.doctypecode == "WF_ATTACHMENT" && d.refid != null && approverIds.Contains(d.refid.Value) && d.isActive != false)
            .ToListAsync();
        _attachments = docs.GroupBy(d => d.refid!.Value).ToDictionary(g => g.Key, g => g.ToList());
    }

    private async Task UploadAttachmentAsync(long jobApproverId, IBrowserFile file)
    {
        _error = null;
        _info = null;
        try
        {
            const long maxSize = 10 * 1024 * 1024; // 10 MB
            await using var stream = file.OpenReadStream(maxSize);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var bytes = ms.ToArray();

            var storedFileName = $"{jobApproverId}_{Guid.NewGuid():N}_{file.Name}";
            var (relativePath, _) = await FileStorage.SaveAsync("wf-attachments", storedFileName, bytes);

            await using var context = await DbFactory.CreateDbContextAsync();
            context.doc_centers.Add(new doc_center
            {
                refid = jobApproverId,
                doctypecode = "WF_ATTACHMENT",
                files = file.Name,
                path = relativePath,
                isActive = true,
                moddate = DateTime.Now,
            });
            await context.SaveChangesAsync();

            _info = string.Format(L.Translate("WfAttachSuccessTemplate"), file.Name);
            await LoadAttachmentsAsync();
        }
        catch (Exception ex)
        {
            _error = L.Translate("WfAttachFailedPrefix") + ex.Message;
        }
    }

}
