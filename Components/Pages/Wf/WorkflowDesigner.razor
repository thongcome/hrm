@page "/wf/design"
@page "/wf/design/{WorkflowId:long}"
@using HRM.Models
@using HRM.Services.Shared
@using HRM.Services.Workflow
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.EntityFrameworkCore.ChangeTracking
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@attribute [Authorize(Policy = "Menu:WF_WORKFLOW_ADMIN")]

@*
    ออกแบบ Workflow — Master/Detail หน้าเดียว
      ซ้าย  = รายการ workflow (master)
      ขวา   = หัวงาน + เส้นทางเดินทีละขั้น (detail)

    ทุกอย่างที่ตั้งค่าได้อยู่ในหน้าเดียว ไม่ต้องกระโดดไป 5 หน้า
    (เดิม: ขั้นตอนอยู่ /wf/sub-workflow-levels, รายชื่ออยู่ /wf/custom-users,
     role อยู่ /wf/custom-roles, วงเงินอยู่ /wf/loa)

    กฎเดิมของ HR: workflow ที่ Active แล้วห้ามแก้ทุกกรณี — หน้านี้จึงล็อกและ
    บอกให้ชัด พร้อมปุ่มปิดใช้งานเพื่อแก้ไข ไม่ใช่ปล่อยให้กดแล้วค่อย error
*@

<PageTitle>ออกแบบ Workflow</PageTitle>

<MudGrid Class="pa-2" Spacing="2">

    @* ─────────── MASTER: รายการ workflow ─────────── *@
    <MudItem xs="12" md="4">
        <MudPaper Class="pa-3" Style="position:sticky; top:8px;">
            <div class="d-flex align-center justify-space-between mb-2">
                <MudText Typo="Typo.h6">Workflow</MudText>
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="NewWorkflow">สร้างใหม่</MudButton>
            </div>

            <MudTextField T="string" Value="_search" ValueChanged="OnSearch" Immediate="true" DebounceInterval="300"
                          Placeholder="ค้นหา รหัส / ชื่องาน" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-2" Clearable="true" />

            <MudList T="long" Dense="true" Class="wf-master-list" Style="max-height:70vh; overflow:auto;">
                @foreach (var w in _list)
                {
                    <MudListItem T="long" OnClick="@(() => Select(w.workflowid))"
                                 Class="@(w.workflowid == _wf?.workflowid ? "mud-selected-item" : "")">
                        <div class="d-flex align-center justify-space-between" style="width:100%">
                            <div>
                                <MudText Typo="Typo.body2"><b>@w.workflowcode</b></MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@w.wname</MudText>
                            </div>
                            <div class="text-right">
                                <MudChip T="string" Size="Size.Small"
                                         Color="@(w.isactive == true ? Color.Success : Color.Default)">
                                    @(w.isactive == true ? "ใช้งาน" : "ปิด")
                                </MudChip>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                    @(_levelCount.GetValueOrDefault(w.workflowid)) ขั้น
                                </MudText>
                            </div>
                        </div>
                    </MudListItem>
                }
                @if (_list.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary pa-2">ไม่พบ workflow</MudText>
                }
            </MudList>
        </MudPaper>
    </MudItem>

    @* ─────────── DETAIL: หัวงาน + เส้นทางเดิน ─────────── *@
    <MudItem xs="12" md="8">
        @if (_wf is null)
        {
            <MudPaper Class="pa-6 d-flex align-center justify-center" Style="min-height:200px">
                <MudText Typo="Typo.body1" Class="mud-text-secondary">
                    เลือก workflow จากรายการทางซ้าย หรือกด "สร้างใหม่"
                </MudText>
            </MudPaper>
        }
        else
        {
            @if (_locked)
            {
                <MudAlert Severity="Severity.Warning" Class="mb-2" Dense="true">
                    <div class="d-flex align-center justify-space-between" style="width:100%">
                        <span>Workflow นี้เปิดใช้งานอยู่ — แก้ไขไม่ได้ทุกกรณี (เป็นสัญญาที่มีงานวิ่งอยู่จริง)</span>
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Warning"
                                   OnClick="DeactivateAsync">ปิดใช้งานเพื่อแก้ไข</MudButton>
                    </div>
                </MudAlert>
            }
            @if (!string.IsNullOrEmpty(_error)) { <MudAlert Severity="Severity.Error" Class="mb-2">@_error</MudAlert> }

            @* พร้อมเปิดใช้งานหรือยัง — workflow ที่ไม่มีขั้นสุดท้าย (istop) จะวิ่งไม่มีวันจบ
               ต้นฉบับ JSP กันด้วย getIsTop() ที่ยอมให้มี istop ได้ขั้นเดียวเท่านั้น *@
            @if (!_locked && _wf.workflowid != 0)
            {
                var problems = ReadinessProblems();
                @if (problems.Count > 0)
                {
                    <MudAlert Severity="Severity.Warning" Class="mb-2" Dense="true">
                        <b>ยังเปิดใช้งานไม่ได้</b>
                        <ul class="mt-1 mb-0">
                            @foreach (var p in problems) { <li>@p</li> }
                        </ul>
                    </MudAlert>
                }
                else
                {
                    <MudAlert Severity="Severity.Success" Class="mb-2" Dense="true">
                        <div class="d-flex align-center justify-space-between" style="width:100%">
                            <span>เส้นทางครบถ้วน พร้อมเปิดใช้งาน — เปิดแล้วจะแก้ไขไม่ได้อีก</span>
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                                       Disabled="_busy" OnClick="ActivateAsync">เปิดใช้งาน</MudButton>
                        </div>
                    </MudAlert>
                }
            }

            @* หัวงาน *@
            <MudPaper Class="pa-3 mb-2">
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="3">
                        <MudTextField @bind-Value="_wf.workflowcode" Label="รหัส" ReadOnly="_locked" Required="true" />
                    </MudItem>
                    <MudItem xs="12" sm="5">
                        <MudTextField @bind-Value="_wf.wname" Label="ชื่องาน" ReadOnly="_locked" Required="true" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudTextField @bind-Value="_wf.tableref" Label="ตารางเอกสารต้นทาง" ReadOnly="_locked"
                                      HelperText="เช่น Exp_ClaimHeader — งานนี้อนุมัติเอกสารจากตารางไหน" />
                    </MudItem>
                    <MudItem xs="12" sm="8">
                        <MudTextField @bind-Value="_wf.url" Label="route หน้าเอกสาร" ReadOnly="_locked"
                                      HelperText="เช่น /exp/my-claims/{refid} — ใช้เป็นลิงก์สำรองเมื่อขั้นนั้นไม่ได้ตั้ง controller" />
                    </MudItem>
                    <MudItem xs="12" sm="4" Class="d-flex align-center">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_locked || _busy"
                                   StartIcon="@Icons.Material.Filled.Save" OnClick="SaveHeaderAsync">บันทึกหัวงาน</MudButton>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            @* เส้นทางเดิน *@
            <MudPaper Class="pa-3">
                <div class="d-flex align-center justify-space-between mb-2">
                    <div>
                        <MudText Typo="Typo.h6">เส้นทางเดิน</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            ระดับ 0 ไม่ต้องสร้าง — เป็น draft ที่งานอยู่กับผู้กรอกโดยอัตโนมัติ เส้นทางเริ่มที่ระดับ 1
                        </MudText>
                    </div>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="_locked || _busy"
                               StartIcon="@Icons.Material.Filled.Add" OnClick="AddLevel">เพิ่มขั้น</MudButton>
                </div>

                @if (_levels.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">
                        ยังไม่มีขั้นตอน — กด "เพิ่มขั้น" เพื่อเริ่มสร้างเส้นทาง
                    </MudAlert>
                }

                <MudExpansionPanels MultiExpansion="false" Elevation="0">
                    @foreach (var lv in _levels)
                    {
                        <MudExpansionPanel>
                            <TitleContent>
                                <div class="d-flex align-center gap-2" style="width:100%">
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary">ขั้น @lv.wlevel</MudChip>
                                    <b>@(string.IsNullOrWhiteSpace(lv.subject) ? "(ยังไม่ตั้งชื่อขั้น)" : lv.subject)</b>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@WhoLabel(lv)</MudText>
                                    @if (lv.istop) { <MudChip T="string" Size="Size.Small" Color="Color.Success">ขั้นสุดท้าย</MudChip> }
                                    @if (lv.isPool) { <MudChip T="string" Size="Size.Small">Pool</MudChip> }
                                    @if (lv.isReturnSender) { <MudChip T="string" Size="Size.Small">ส่งกลับผู้กรอกได้</MudChip> }
                                </div>
                            </TitleContent>
                            <ChildContent>
                                @RenderLevelEditor(lv)
                            </ChildContent>
                        </MudExpansionPanel>
                    }
                </MudExpansionPanels>
            </MudPaper>
        }
    </MudItem>
</MudGrid>

@code {
    [Parameter] public long? WorkflowId { get; set; }

    private string? _search;
    private string? _error;
    private bool _busy;
    private bool _canEdit;

    private List<wf_workflow> _list = new();
    private Dictionary<long, int> _levelCount = new();
    private wf_workflow? _wf;
    private List<wf_sub_workflow_master> _levels = new();
    private bool _locked => _wf?.isactive == true;

    // ผู้อนุมัติที่เลือกไว้ของแต่ละขั้น (key = subworkflowid, 0 = ขั้นที่เพิ่งเพิ่ม)
    private readonly Dictionary<long, List<sc_user>> _pickedUsers = new();
    private readonly Dictionary<long, List<long>> _pickedRoles = new();
    private readonly Dictionary<long, List<string>> _whoPreview = new();
    private List<sc_role> _roles = new();
    private List<string> _statusCodes = new();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _canEdit = state.User.HasClaim("menu_edit", "WF_WORKFLOW_ADMIN");

        await using var db = await DbFactory.CreateDbContextAsync();
        _roles = await db.sc_roles.OrderBy(r => r.name).ToListAsync();
        _statusCodes = await db.job_statuses.OrderBy(s => s.jobstatuscode).Select(s => s.jobstatuscode).ToListAsync();

        await LoadListAsync();
        if (WorkflowId is long id) await SelectAsync(id);
    }

    private async Task LoadListAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var q = db.wf_workflows.AsQueryable();
        if (!string.IsNullOrWhiteSpace(_search))
            q = EntitySearchHelper.ApplyTextSearch(q, _search,
                nameof(wf_workflow.workflowcode), nameof(wf_workflow.wname));
        _list = await q.OrderBy(w => w.workflowcode).Take(200).ToListAsync();

        var ids = _list.Select(w => w.workflowid).ToList();
        _levelCount = await db.wf_sub_workflow_masters
            .Where(s => ids.Contains(s.workflowid))
            .GroupBy(s => s.workflowid)
            .Select(g => new { g.Key, N = g.Count() })
            .ToDictionaryAsync(x => x.Key, x => x.N);
    }

    private async Task OnSearch(string? term) { _search = term; await LoadListAsync(); }

    private void Select(long id) => _ = SelectAsync(id);

    private async Task SelectAsync(long id)
    {
        _error = null;
        await using var db = await DbFactory.CreateDbContextAsync();
        _wf = await db.wf_workflows.FirstOrDefaultAsync(w => w.workflowid == id);
        if (_wf is null) return;

        _levels = await db.wf_sub_workflow_masters
            .Where(s => s.workflowid == id).OrderBy(s => s.wlevel).ToListAsync();

        _pickedUsers.Clear(); _pickedRoles.Clear(); _whoPreview.Clear();
        foreach (var lv in _levels)
        {
            var userIds = await db.wf_custom_users
                .Where(c => c.workflowid == id && c.wlevel == lv.wlevel && c.isactive)
                .Select(c => c.userid).ToListAsync();
            _pickedUsers[lv.subworkflowid] = await db.sc_users.Where(u => userIds.Contains(u.userid)).ToListAsync();

            _pickedRoles[lv.subworkflowid] = await db.wf_custom_roles
                .Where(c => c.workflowid == id && c.wlevel == lv.wlevel && c.isactive != false)
                .Select(c => c.roleid).ToListAsync();
        }
        // ย้าย URL เฉพาะตอนที่ยังไม่ตรง — ถ้าเข้าหน้ามาพร้อม id อยู่แล้วแล้วสั่งย้ายซ้ำ
        // component จะ re-init วนไม่จบและหน้าจะว่าง
        var target = $"/wf/design/{id}";
        if (!Nav.Uri.EndsWith(target, StringComparison.OrdinalIgnoreCase))
            Nav.NavigateTo(target, replace: true);
        StateHasChanged();
    }

    private void NewWorkflow()
    {
        _error = null;
        _wf = new wf_workflow { wstatus = "DRAFT", isshow = true, isactive = false, wname = "", workflowcode = "" };
        _levels = new();
        _pickedUsers.Clear(); _pickedRoles.Clear(); _whoPreview.Clear();
    }

    private async Task SaveHeaderAsync()
    {
        if (_wf is null) return;
        _busy = true; _error = null;
        try
        {
            if (string.IsNullOrWhiteSpace(_wf.workflowcode) || string.IsNullOrWhiteSpace(_wf.wname))
                throw new InvalidOperationException("กรุณากรอกรหัสและชื่องาน");

            await using var db = await DbFactory.CreateDbContextAsync();
            if (_wf.workflowid == 0)
            {
                _wf.workflowid = await EntitySearchHelper.NextIdAsync(db.wf_workflows, w => w.workflowid);
                db.wf_workflows.Add(_wf);
            }
            else
            {
                await WorkflowLockGuard.EnsureWorkflowEditableAsync(db, _wf.workflowid);
                var existing = await db.wf_workflows.FirstAsync(w => w.workflowid == _wf.workflowid);
                existing.workflowcode = _wf.workflowcode;
                existing.wname = _wf.wname;
                existing.tableref = _wf.tableref;
                existing.url = _wf.url;
            }
            await db.SaveChangesAsync();
            Snackbar.Add("บันทึกหัวงานแล้ว", Severity.Success);
            await LoadListAsync();
            await SelectAsync(_wf.workflowid);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    // ── workflow นี้พร้อมใช้งานหรือยัง ──────────────────────────────────────
    // ข้อสำคัญที่สุด: ไม่มีขั้นที่ istop = งานวิ่งไปเรื่อย ๆ ไม่มีวันจบ
    // ต้นฉบับ JSP บังคับให้มี istop ได้ขั้นเดียว (getIsTop นับว่ามีขั้นอื่นเป็น istop แล้วหรือยัง)
    private List<string> ReadinessProblems()
    {
        var p = new List<string>();
        if (_levels.Count == 0) { p.Add("ยังไม่มีขั้นตอนเลย"); return p; }

        var saved = _levels.Where(l => l.subworkflowid != 0).ToList();
        if (saved.Count == 0) { p.Add("ยังไม่ได้บันทึกขั้นตอนสักขั้น"); return p; }

        var tops = saved.Count(l => l.istop);
        if (tops == 0) p.Add("ไม่มีขั้นสุดท้าย (istop) — งานจะวิ่งไปเรื่อย ๆ ไม่มีวันจบ ต้องติ๊ก \"ขั้นสุดท้าย\" ที่ขั้นใดขั้นหนึ่ง");
        if (tops > 1) p.Add($"มีขั้นสุดท้าย {tops} ขั้น — ต้องมีได้ขั้นเดียวเท่านั้น");

        var levels = saved.Select(l => l.wlevel).OrderBy(x => x).ToList();
        if (levels.First() != 1) p.Add($"เส้นทางต้องเริ่มที่ระดับ 1 (ตอนนี้เริ่มที่ {levels.First()}) — ระดับ 0 เป็น draft อัตโนมัติ ไม่ต้องสร้าง");
        if (levels.Distinct().Count() != levels.Count) p.Add("มีระดับซ้ำกัน");
        for (var i = 1; i < levels.Count; i++)
            if (levels[i] != levels[i - 1] + 1) { p.Add($"ระดับข้ามจาก {levels[i - 1]} ไป {levels[i]} — ต้องเรียงติดกัน"); break; }

        foreach (var l in saved)
        {
            var hasWho = l.iscustomUser || l.iscustomRole || l.isLOA || l.SupervisorLevels > 0
                      || l.isApproverSameOrg || l.isApproverSameCostCenter || l.isAdhocUser
                      || l.userid1 is not null || l.userid2 is not null || l.userid3 is not null;
            if (!hasWho) p.Add($"ขั้นที่ {l.wlevel} ยังไม่ได้กำหนดว่าใครอนุมัติ");
            else if (l.iscustomUser && (_pickedUsers.GetValueOrDefault(l.subworkflowid)?.Count ?? 0) == 0)
                p.Add($"ขั้นที่ {l.wlevel} ติ๊กระบุตัวคนไว้แต่ยังไม่ได้เลือกใคร");
            else if (l.iscustomRole && (_pickedRoles.GetValueOrDefault(l.subworkflowid)?.Count ?? 0) == 0)
                p.Add($"ขั้นที่ {l.wlevel} ติ๊กระบุบทบาทไว้แต่ยังไม่ได้เลือก role");
        }
        return p;
    }

    private async Task ActivateAsync()
    {
        if (_wf is null) return;
        _busy = true; _error = null;
        try
        {
            var problems = ReadinessProblems();
            if (problems.Count > 0) throw new InvalidOperationException(string.Join(" · ", problems));

            await using var db = await DbFactory.CreateDbContextAsync();
            var w = await db.wf_workflows.FirstAsync(x => x.workflowid == _wf.workflowid);
            w.isactive = true;
            w.isshow = true;
            await db.SaveChangesAsync();
            Snackbar.Add("เปิดใช้งานแล้ว — แก้ไขไม่ได้อีก", Severity.Success);
            await LoadListAsync();
            await SelectAsync(_wf.workflowid);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task DeactivateAsync()
    {
        if (_wf is null) return;
        _busy = true; _error = null;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var w = await db.wf_workflows.FirstAsync(x => x.workflowid == _wf.workflowid);
            w.isactive = false;
            await db.SaveChangesAsync();
            Snackbar.Add("ปิดใช้งานแล้ว — แก้ไขได้", Severity.Success);
            await LoadListAsync();
            await SelectAsync(_wf.workflowid);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private void AddLevel()
    {
        if (_wf is null) return;
        var next = _levels.Count == 0 ? 1 : _levels.Max(l => l.wlevel) + 1;
        _levels.Add(new wf_sub_workflow_master
        {
            workflowid = _wf.workflowid,
            wlevel = next,
            subject = $"ขั้นที่ {next}",
            forwardstatus = "APPROVED",
            standstatus = "PENDING",
            backwardstatus = "RETURNED",
            istop = _levels.Count == 0,
        });
    }

    // ── ตัวแก้ไขของขั้นหนึ่งขั้น ── ทุกอย่างที่ config ได้อยู่ในนี้ที่เดียว
    private RenderFragment RenderLevelEditor(wf_sub_workflow_master lv) => @<text>
        <MudGrid Spacing="2" Class="pa-1">
            <MudItem xs="12" sm="2"><MudNumericField T="int" @bind-Value="lv.wlevel" Label="ระดับ" Min="1" ReadOnly="_locked" /></MudItem>
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="lv.subject" Label="ชื่อขั้น" ReadOnly="_locked" /></MudItem>
            <MudItem xs="12" sm="4"><MudTextField @bind-Value="lv.displayName" Label="ข้อความบนปุ่ม" ReadOnly="_locked"
                                                  HelperText="เช่น อนุมัติและส่งต่อ / ตรวจสอบ / อนุมัติจ่าย" /></MudItem>

            @* ── ใครอนุมัติ: 4 คำถาม ── *@
            <MudItem xs="12"><MudDivider Class="my-1" /><MudText Typo="Typo.subtitle2">ขั้นนี้ใครอนุมัติ</MudText></MudItem>

            <MudItem xs="12" sm="3">
                <MudCheckBox T="bool" Value="lv.iscustomUser" Disabled="_locked"
                             ValueChanged="@((bool v) => lv.iscustomUser = v)" Label="ระบุตัวคน" />
            </MudItem>
            <MudItem xs="12" sm="9">
                @if (lv.iscustomUser)
                {
                    <MudAutocomplete T="sc_user" Label="เลือกคน" Value="null" Disabled="_locked"
                                     SearchFunc="SearchUsersAsync"
                                     ToStringFunc="@(u => u is null ? "" : $"{u.loginname} — {u.firstname} {u.lastname}")"
                                     ValueChanged="@(u => AddUser(lv, u))" Clearable="true" Dense="true" />
                    <div class="mt-1">
                        @foreach (var u in Users(lv))
                        {
                            <MudChip T="string" Size="Size.Small" Class="mr-1"
                                     OnClose="@(_locked ? null : () => Users(lv).Remove(u))">@u.firstname @u.lastname</MudChip>
                        }
                        @if (Users(lv).Count == 0)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Warning">ติ๊กไว้แต่ยังไม่ได้เลือกใคร — งานจะค้าง</MudText>
                        }
                    </div>
                }
            </MudItem>

            <MudItem xs="12" sm="3">
                <MudCheckBox T="bool" Value="lv.iscustomRole" Disabled="_locked"
                             ValueChanged="@((bool v) => lv.iscustomRole = v)" Label="ระบุบทบาท (role)" />
            </MudItem>
            <MudItem xs="12" sm="9">
                @if (lv.iscustomRole)
                {
                    <MudSelect T="long" Label="เลือก role" Value="0" Dense="true" Disabled="_locked"
                               ValueChanged="@(r => AddRole(lv, r))">
                        @foreach (var r in _roles) { <MudSelectItem T="long" Value="@r.roleid">@r.name</MudSelectItem> }
                    </MudSelect>
                    <div class="mt-1">
                        @foreach (var r in Roles(lv))
                        {
                            <MudChip T="string" Size="Size.Small" Class="mr-1"
                                     OnClose="@(_locked ? null : () => Roles(lv).Remove(r))">
                                @(_roles.FirstOrDefault(x => x.roleid == r)?.name ?? $"role #{r}")
                            </MudChip>
                        }
                        @if (Roles(lv).Count == 0)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Warning">ติ๊กไว้แต่ยังไม่ได้เลือก role</MudText>
                        }
                    </div>
                }
            </MudItem>

            <MudItem xs="12" sm="4">
                <MudNumericField T="int?" @bind-Value="lv.isNeedsupervisorapprove" Label="ผ่านหัวหน้าตามผังกี่ชั้น"
                                 Min="0" Max="10" ReadOnly="_locked"
                                 HelperText="0/ว่าง = ไม่ผ่าน · 1 = หัวหน้าตรง · 3 = ไล่ขึ้นสามชั้น" />
            </MudItem>
            <MudItem xs="12" sm="8" Class="d-flex align-center flex-wrap gap-3">
                <MudCheckBox T="bool" @bind-Value="lv.isLOA" Disabled="_locked" Label="ตามวงเงิน (LOA)" />
                <MudCheckBox T="bool" @bind-Value="lv.isApproverSameOrg" Disabled="_locked" Label="คนในหน่วยงานเดียวกัน" />
                <MudCheckBox T="bool" @bind-Value="lv.isApproverSameCostCenter" Disabled="_locked" Label="หัวหน้า Cost Center" />
                <MudCheckBox T="bool" @bind-Value="lv.isAdhocUser" Disabled="_locked" Label="เรียกคนเพิ่มตอนอนุมัติ" />
            </MudItem>

            @* ── ต้องอนุมัติกันกี่คน ── *@
            <MudItem xs="12"><MudDivider Class="my-1" /><MudText Typo="Typo.subtitle2">ต้องอนุมัติกันแบบไหน</MudText></MudItem>
            <MudItem xs="12" sm="4">
                <MudCheckBox T="bool" Value="lv.isorcondition" Disabled="_locked || lv.isandcondition"
                             ValueChanged="@((bool v) => { lv.isorcondition = v; if (v) { lv.isandcondition = false; lv.andpercent = null; } })"
                             Label="ใครอนุมัติคนแรกก็พอ (OR)" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudCheckBox T="bool" Value="lv.isandcondition" Disabled="_locked || lv.isorcondition"
                             ValueChanged="@((bool v) => { lv.isandcondition = v; if (v) lv.isorcondition = false; })"
                             Label="รวมน้ำหนักให้ถึงเกณฑ์ (AND %)" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudNumericField T="decimal?" @bind-Value="lv.andpercent" Label="เกณฑ์ %" Min="1" Max="100"
                                 Disabled="_locked || !lv.isandcondition" />
            </MudItem>

            @* ── การเดินและสิทธิ์ ── *@
            <MudItem xs="12"><MudDivider Class="my-1" /><MudText Typo="Typo.subtitle2">การเดินและสิทธิ์</MudText></MudItem>
            <MudItem xs="12" sm="3"><MudCheckBox T="bool" @bind-Value="lv.istop" Disabled="_locked" Label="ขั้นสุดท้าย (จบงาน)" /></MudItem>
            <MudItem xs="12" sm="3"><MudCheckBox T="bool" @bind-Value="lv.isReturnSender" Disabled="_locked" Label="ส่งกลับผู้กรอกได้เลย" /></MudItem>
            <MudItem xs="12" sm="3"><MudCheckBox T="bool" @bind-Value="lv.isAutoApproveAllow" Disabled="_locked" Label="ไม่มีคน = ข้ามขั้น" /></MudItem>
            <MudItem xs="12" sm="3"><MudCheckBox T="bool" @bind-Value="lv.isPool" Disabled="_locked" Label="งานกอง (Pool)" /></MudItem>
            <MudItem xs="12" sm="4">
                <MudNumericField T="int?" @bind-Value="lv.backwardlevel" Label="ถูกปฏิเสธแล้วถอยไปขั้นที่"
                                 Min="0" Max="@(lv.wlevel - 1)" Disabled="_locked"
                                 HelperText="ว่าง = ถอยทีละขั้น · 0 = กลับถึงผู้กรอก" />
            </MudItem>

            @* ── สถานะที่ตราลงงาน ── *@
            <MudItem xs="12"><MudDivider Class="my-1" /><MudText Typo="Typo.subtitle2">สถานะที่ตราลงงาน</MudText></MudItem>
            <MudItem xs="12" sm="3">@StatusPicker("งานมานั่งขั้นนี้", lv.sitinstatus, v => lv.sitinstatus = v)</MudItem>
            <MudItem xs="12" sm="3">@StatusPicker("อยู่กับที่", lv.standstatus, v => lv.standstatus = v!)</MudItem>
            <MudItem xs="12" sm="3">@StatusPicker("อนุมัติผ่าน/จบ", lv.forwardstatus, v => lv.forwardstatus = v!)</MudItem>
            <MudItem xs="12" sm="3">@StatusPicker("ถูกส่งกลับ", lv.backwardstatus, v => lv.backwardstatus = v!)</MudItem>

            @* ── หน้าจอเอกสาร ── *@
            <MudItem xs="12"><MudDivider Class="my-1" /><MudText Typo="Typo.subtitle2">หน้าจอเอกสาร</MudText></MudItem>
            <MudItem xs="12" sm="8">
                <MudTextField @bind-Value="lv.controller" Label="route หน้าเอกสารที่จะเสียบให้ผู้อนุมัติดู" ReadOnly="_locked"
                              HelperText="เช่น /exp/my-claims/{refid} — {refid} จะถูกแทนด้วยเลขเอกสารของงาน" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="lv.ApproveController" Label="หน้าประกอบที่ 2 (ถ้ามี)" ReadOnly="_locked"
                              HelperText="ข้อมูลประกอบให้ผู้อนุมัติดู เช่นยอดคงเหลือ" />
            </MudItem>

            @* ── ปุ่ม ── *@
            <MudItem xs="12" Class="d-flex justify-space-between align-center">
                <div>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="_locked || _busy"
                               StartIcon="@Icons.Material.Filled.Visibility" OnClick="@(() => PreviewAsync(lv))">
                        ดูว่าขั้นนี้จะได้ใครบ้าง
                    </MudButton>
                    @if (_whoPreview.TryGetValue(lv.subworkflowid, out var lines))
                    {
                        <div class="mt-1">
                            @foreach (var line in lines) { <MudText Typo="Typo.caption">@line</MudText> }
                        </div>
                    }
                </div>
                <div>
                    <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Text" Disabled="_locked || _busy"
                               OnClick="@(() => DeleteLevelAsync(lv))">ลบขั้นนี้</MudButton>
                    <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled" Disabled="_locked || _busy"
                               StartIcon="@Icons.Material.Filled.Save" OnClick="@(() => SaveLevelAsync(lv))">บันทึกขั้นนี้</MudButton>
                </div>
            </MudItem>
        </MudGrid>
    </text>;

    private RenderFragment StatusPicker(string label, string? value, Action<string?> set) => @<text>
        <MudSelect T="string" Value="@value" Label="@label" Dense="true" Clearable="true" Disabled="_locked"
                   ValueChanged="@((string v) => set(v))">
            @foreach (var s in _statusCodes) { <MudSelectItem T="string" Value="@s">@s</MudSelectItem> }
        </MudSelect>
    </text>;

    private List<sc_user> Users(wf_sub_workflow_master lv)
    {
        if (!_pickedUsers.TryGetValue(lv.subworkflowid, out var l)) { l = new(); _pickedUsers[lv.subworkflowid] = l; }
        return l;
    }

    private List<long> Roles(wf_sub_workflow_master lv)
    {
        if (!_pickedRoles.TryGetValue(lv.subworkflowid, out var l)) { l = new(); _pickedRoles[lv.subworkflowid] = l; }
        return l;
    }

    private void AddUser(wf_sub_workflow_master lv, sc_user? u)
    {
        if (u is null) return;
        var l = Users(lv);
        if (!l.Any(x => x.userid == u.userid)) l.Add(u);
    }

    private void AddRole(wf_sub_workflow_master lv, long roleid)
    {
        if (roleid == 0) return;
        var l = Roles(lv);
        if (!l.Contains(roleid)) l.Add(roleid);
    }

    private async Task<IEnumerable<sc_user>> SearchUsersAsync(string term, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(term)) return Array.Empty<sc_user>();
        await using var db = await DbFactory.CreateDbContextAsync();
        return await db.sc_users
            .Where(u => u.isdisable != true &&
                   (u.loginname.Contains(term) || u.firstname.Contains(term) || u.lastname.Contains(term)))
            .OrderBy(u => u.loginname).Take(20).ToListAsync(ct);
    }

    private async Task SaveLevelAsync(wf_sub_workflow_master lv)
    {
        if (_wf is null) return;
        _busy = true; _error = null;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            await WorkflowLockGuard.EnsureWorkflowEditableAsync(db, _wf.workflowid);

            var oldKey = lv.subworkflowid;
            if (lv.subworkflowid == 0)
            {
                lv.wfcode = _wf.workflowcode;
                db.wf_sub_workflow_masters.Add(lv);
            }
            else
            {
                db.wf_sub_workflow_masters.Attach(lv);
                db.Entry(lv).State = EntityState.Modified;
            }
            await db.SaveChangesAsync();

            // รายชื่อ/บทบาทเขียนพร้อมกัน — flag กับข้อมูลจึงตรงกันเสมอ
            var users = _pickedUsers.GetValueOrDefault(oldKey) ?? new();
            var roles = _pickedRoles.GetValueOrDefault(oldKey) ?? new();

            db.wf_custom_users.RemoveRange(await db.wf_custom_users
                .Where(c => c.workflowid == _wf.workflowid && c.wlevel == lv.wlevel).ToListAsync());
            if (lv.iscustomUser)
                db.wf_custom_users.AddRange(users.Select(u => new wf_custom_user
                {
                    subworkflowid = lv.subworkflowid, workflowid = _wf.workflowid, wlevel = lv.wlevel,
                    userid = u.userid, empid = u.empid, isactive = true, modate = DateTime.Now,
                }));

            db.wf_custom_roles.RemoveRange(await db.wf_custom_roles
                .Where(c => c.workflowid == _wf.workflowid && c.wlevel == lv.wlevel).ToListAsync());
            if (lv.iscustomRole)
                db.wf_custom_roles.AddRange(roles.Select(r => new wf_custom_role
                {
                    subworkflowid = lv.subworkflowid, workflowid = _wf.workflowid, wlevel = lv.wlevel,
                    roleid = r, isactive = true, modate = DateTime.Now,
                }));

            await db.SaveChangesAsync();
            Snackbar.Add($"บันทึกขั้นที่ {lv.wlevel} แล้ว", Severity.Success);
            await LoadListAsync();
            await SelectAsync(_wf.workflowid);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task DeleteLevelAsync(wf_sub_workflow_master lv)
    {
        if (_wf is null) return;
        _busy = true; _error = null;
        try
        {
            if (lv.subworkflowid == 0) { _levels.Remove(lv); return; }

            await using var db = await DbFactory.CreateDbContextAsync();
            await WorkflowLockGuard.EnsureWorkflowEditableAsync(db, _wf.workflowid);
            db.wf_custom_users.RemoveRange(await db.wf_custom_users
                .Where(c => c.workflowid == _wf.workflowid && c.wlevel == lv.wlevel).ToListAsync());
            db.wf_custom_roles.RemoveRange(await db.wf_custom_roles
                .Where(c => c.workflowid == _wf.workflowid && c.wlevel == lv.wlevel).ToListAsync());
            db.wf_sub_workflow_masters.Remove(
                await db.wf_sub_workflow_masters.FirstAsync(s => s.subworkflowid == lv.subworkflowid));
            await db.SaveChangesAsync();
            Snackbar.Add("ลบขั้นแล้ว", Severity.Success);
            await LoadListAsync();
            await SelectAsync(_wf.workflowid);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    // เรียกเมธอดของตัว config เอง ตัวเดียวกับที่ engine ใช้ตอนงานวิ่งจริง
    private async Task PreviewAsync(wf_sub_workflow_master lv)
    {
        _error = null;
        var lines = new List<string>();
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var state = await AuthProvider.GetAuthenticationStateAsync();
            var meId = long.Parse(state.User.FindFirst("sc_userid")?.Value ?? "0");
            var me = await db.sc_users.FirstOrDefaultAsync(u => u.userid == meId);

            var probe = new job_master
            {
                workflowid = lv.workflowid,
                createuserid = meId,
                empid = me?.empid,
                reqOrg = me?.orgcode,
            };

            foreach (var src in await lv.GetUserBySourceAsync(db, probe, CancellationToken.None))
            {
                var names = await db.sc_users.Where(u => src.UserIds.Contains(u.userid))
                    .Select(u => (u.firstname + " " + u.lastname).Trim()).ToListAsync();
                lines.Add($"{src.Field} ({src.ResolverKind}) → {(names.Count == 0 ? "— ไม่พบใคร —" : string.Join(", ", names))}"
                          + (string.IsNullOrWhiteSpace(src.Note) ? "" : $" · {src.Note}"));
            }
            if (lines.Count == 0) lines.Add("ยังไม่ได้กำหนดผู้อนุมัติของขั้นนี้");
        }
        catch (Exception ex) { lines.Add("ผิดพลาด: " + ex.Message); }
        _whoPreview[lv.subworkflowid] = lines;
    }

    // สรุปสั้น ๆ ว่าขั้นนี้ใครอนุมัติ ให้เห็นบนหัวแถบโดยไม่ต้องกางออกมา
    private string WhoLabel(wf_sub_workflow_master lv)
    {
        var parts = new List<string>();
        if (lv.iscustomUser) parts.Add($"ระบุตัวคน {_pickedUsers.GetValueOrDefault(lv.subworkflowid)?.Count ?? 0} คน");
        if (lv.iscustomRole) parts.Add($"บทบาท {_pickedRoles.GetValueOrDefault(lv.subworkflowid)?.Count ?? 0} role");
        if (lv.SupervisorLevels > 0) parts.Add($"หัวหน้า {lv.SupervisorLevels} ชั้น");
        if (lv.isLOA) parts.Add("ตามวงเงิน");
        if (lv.isApproverSameOrg) parts.Add("คนในหน่วยงานเดียวกัน");
        if (lv.isApproverSameCostCenter) parts.Add("หัวหน้า Cost Center");
        if (lv.isAdhocUser) parts.Add("เรียกคนเพิ่มตอนอนุมัติ");
        return parts.Count == 0 ? "· ยังไม่ได้กำหนดผู้อนุมัติ" : "· " + string.Join(" + ", parts);
    }
}
