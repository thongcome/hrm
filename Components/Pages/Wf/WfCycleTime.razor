@page "/wf/cycle-time"
@using HRM.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@attribute [Authorize(Policy = "Menu:WF_WORKFLOW_ADMIN")]

@*
    เวลาที่งานใช้ในแต่ละขั้น — ข้อเสนอ BA ข้อ 4 (CEO, 10 ก.ย. 2569)

    ระบบเก็บ starttime/endtime ของทุกขั้นไว้ใน job_subworkflow_master อยู่แล้ว
    ตั้งแต่แรก แต่ไม่มีหน้าไหนอ่านเลย หน้านี้เอามาตอบคำถามที่ตอบไม่ได้มาก่อน:
    ขั้นไหนกินเวลามากที่สุด — ซึ่งเป็นคอขวดจริง ไม่ใช่คอขวดที่เดาเอา

    ตั้งใจไม่ทำเป็น dashboard สวย ๆ เพราะสิ่งที่ต้องการคือตัวเลขที่เอาไปคุยกับ
    เจ้าของขั้นนั้นได้ ไม่ใช่ภาพรวมที่ดูแล้วจำไม่ได้ว่าต้องไปคุยกับใคร
*@

<PageTitle>เวลาที่ใช้ในแต่ละขั้น</PageTitle>

<MudPaper Class="pa-4 mb-4">
    <MudText Typo="Typo.h5">เวลาที่ใช้ในแต่ละขั้น</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1" Style="max-width:72ch">
        นับจากเวลาที่งานมาถึงขั้นนั้น จนถึงเวลาที่งานออกจากขั้นนั้น
        ขั้นที่ยังไม่จบจะนับเป็น “ค้างอยู่” แยกไว้ต่างหาก ไม่เอามาเฉลี่ยปนกัน
    </MudText>
    <div class="mt-3">
        <MudSelect T="int" Label="ช่วงเวลา" Value="_days" ValueChanged="OnDaysChanged" Style="max-width:220px" Dense="true">
            <MudSelectItem T="int" Value="30">30 วันล่าสุด</MudSelectItem>
            <MudSelectItem T="int" Value="90">90 วันล่าสุด</MudSelectItem>
            <MudSelectItem T="int" Value="365">1 ปีล่าสุด</MudSelectItem>
            <MudSelectItem T="int" Value="0">ทั้งหมด</MudSelectItem>
        </MudSelect>
    </div>
</MudPaper>

@if (_busy)
{
    <MudProgressLinear Indeterminate="true" Class="mb-3" />
}
else if (_rows.Count == 0)
{
    <MudAlert Severity="Severity.Info">
        ยังไม่มีข้อมูลพอจะคำนวณ — ต้องมีงานที่เดินผ่านขั้นตอนจนจบอย่างน้อยหนึ่งขั้นในช่วงที่เลือก
    </MudAlert>
}
else
{
    @if (_slowest is not null)
    {
        <MudAlert Severity="Severity.Normal" Class="mb-4">
            ขั้นที่กินเวลามากที่สุดตอนนี้คือ <b>@_slowest.WorkflowName ขั้นที่ @_slowest.Level</b>
            (@_slowest.LevelName) เฉลี่ย <b>@Fmt(_slowest.AvgHours)</b> ต่อหนึ่งงาน
            — ถ้าจะลดเวลารวมของกระบวนการ นี่คือจุดที่คุ้มที่สุดที่จะไปคุย
        </MudAlert>
    }

    <MudPaper Class="pa-4">
        <MudTable Items="_rows" Dense="true" Hover="true" GroupBy="_groupBy">
            <HeaderContent>
                <MudTh>ขั้น</MudTh><MudTh>ชื่อขั้น</MudTh>
                <MudTh Style="text-align:right">งานที่ผ่านแล้ว</MudTh>
                <MudTh Style="text-align:right">เฉลี่ย</MudTh>
                <MudTh Style="text-align:right">นานสุด</MudTh>
                <MudTh Style="text-align:right">ค้างอยู่ตอนนี้</MudTh>
            </HeaderContent>
            <GroupHeaderTemplate>
                <MudTh Class="mud-table-cell-custom-group" colspan="6">
                    <b>@context.Key</b>
                </MudTh>
            </GroupHeaderTemplate>
            <RowTemplate>
                <MudTd>@context.Level</MudTd>
                <MudTd>@context.LevelName</MudTd>
                <MudTd Style="text-align:right">@context.Finished</MudTd>
                <MudTd Style="text-align:right">
                    <span style="@(context.AvgHours >= 72 ? "font-weight:600" : "")">@Fmt(context.AvgHours)</span>
                </MudTd>
                <MudTd Style="text-align:right">@Fmt(context.MaxHours)</MudTd>
                <MudTd Style="text-align:right">
                    @if (context.Open > 0)
                    {
                        <MudChip T="string" Size="Size.Small" Color="@(context.OldestOpenHours >= 72 ? Color.Warning : Color.Default)">
                            @context.Open งาน · เก่าสุด @Fmt(context.OldestOpenHours)
                        </MudChip>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}

@code {
    private record Row(string WorkflowName, int Level, string LevelName,
        int Finished, double AvgHours, double MaxHours, int Open, double OldestOpenHours);

    private bool _busy = true;
    private int _days = 90;
    private List<Row> _rows = new();
    private Row? _slowest;

    private readonly TableGroupDefinition<Row> _groupBy = new()
    {
        Selector = r => r.WorkflowName,
        Indentation = false,
        Expandable = false,
    };

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task OnDaysChanged(int days)
    {
        _days = days;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _busy = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var since = _days > 0 ? DateTime.Now.AddDays(-_days) : DateTime.MinValue;

            // อ่านรอยเท้าของทุกขั้นที่เริ่มในช่วงที่เลือก — starttime/endtime ถูก
            // เก็บอยู่แล้วทุกครั้งที่งานเข้า/ออกขั้น ไม่ต้องเพิ่มการเก็บอะไรใหม่
            var stamps = await db.job_subworkflow_masters
                .Where(s => s.starttime != null && s.starttime >= since && s.wlevel > 0)
                .Select(s => new { s.workflowid, s.wlevel, s.subject, s.starttime, s.endtime })
                .ToListAsync();
            if (stamps.Count == 0) { _rows = new(); _slowest = null; return; }

            var wfNames = await db.wf_workflows
                .ToDictionaryAsync(w => w.workflowid, w => (w.wname ?? w.workflowcode ?? $"#{w.workflowid}")!);

            var now = DateTime.Now;
            _rows = stamps
                .GroupBy(s => new { s.workflowid, s.wlevel })
                .Select(g =>
                {
                    var done = g.Where(x => x.endtime != null)
                        .Select(x => (x.endtime!.Value - x.starttime!.Value).TotalHours)
                        .Where(h => h >= 0).ToList();
                    var open = g.Where(x => x.endtime == null).ToList();
                    return new Row(
                        wfNames.GetValueOrDefault(g.Key.workflowid, $"#{g.Key.workflowid}"),
                        g.Key.wlevel,
                        g.Select(x => x.subject).FirstOrDefault(x => !string.IsNullOrWhiteSpace(x)) ?? "",
                        done.Count,
                        done.Count > 0 ? done.Average() : 0,
                        done.Count > 0 ? done.Max() : 0,
                        open.Count,
                        open.Count > 0 ? open.Max(x => (now - x.starttime!.Value).TotalHours) : 0);
                })
                .OrderBy(r => r.WorkflowName).ThenBy(r => r.Level)
                .ToList();

            _slowest = _rows.Where(r => r.Finished > 0).OrderByDescending(r => r.AvgHours).FirstOrDefault();
        }
        finally { _busy = false; }
    }

    // ชั่วโมงล้วนอ่านยากเมื่อเกินสองสามวัน แปลงเป็นหน่วยที่คนพูดกันจริง
    private static string Fmt(double hours) => hours switch
    {
        <= 0 => "—",
        < 1 => $"{hours * 60:N0} นาที",
        < 48 => $"{hours:N1} ชม.",
        _ => $"{hours / 24:N1} วัน",
    };
}
