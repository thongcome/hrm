@page "/workflow"
@page "/workflow/detail/{Id:long}"
@page "/workflow/create/{WorkflowId:long}"
@using System.Reflection
@using HRM.Models
@using HRM.Services.Workflow
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using HRM.Services.Pay
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject WorkflowService Wf
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav
@inject WorkflowButtonService Buttons
@inject PrivateFileStorage FileStorage
@inject IDialogService Dialog
@attribute [Authorize]

@*
    หน้า workflow ตัวเดียวใช้ได้ทุก workflow — พอร์ตตรงจาก epms Views/Workflow/Detail.cshtml

    หน้านี้ไม่รู้จักโมดูลไหนเลย มันอ่านแค่ว่า "งานอยู่ขั้นไหน" แล้วทำสามอย่าง:
      1. เสียบเอกสารของโมดูลเข้ามา ตาม controller ที่ config ไว้ที่ขั้นนั้น
         (epms: @@Html.Action(sub.action, sub.controller, new { Id })
          Blazor: <DynamicComponent Type Parameters /> — ตัวเทียบกันตรง ๆ)
      2. โชว์ปุ่มตาม config: ไม่ใช่ขั้นสุดท้าย (istop=false) ไม่มีปุ่มอนุมัติ
      3. ส่งค่าไป-กลับผ่าน WorkFlowViewModel ตัวเดียว
*@

<PageTitle>งาน #@Id</PageTitle>

<MudPaper Class="pa-4 mb-4">
    @* หน้าเปล่า (ไม่ได้ส่ง id มา) = หน้าเริ่มงาน เลือก workflow แล้วงานเกิดทันที
       ที่ขั้นแรกของเส้นทาง — epms: Create(workflowid) -> RedirectToAction("Detail") *@
    @if (Id == 0 && WorkflowId is null)
    {
        <div class="d-flex align-center justify-space-between flex-wrap mb-1">
            <div>
                <MudText Typo="Typo.h5">เริ่มงานใหม่</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    เลือกประเภทงาน — งานจะถูกสร้างเป็นร่างในมือคุณก่อน แล้วค่อยกดส่งเข้าสายอนุมัติ
                </MudText>
            </div>
            <MudTextField T="string" Value="_find" ValueChanged="@(v => _find = v)" Immediate="true"
                          Placeholder="ค้นหาประเภทงาน" Adornment="Adornment.Start" Clearable="true"
                          AdornmentIcon="@Icons.Material.Filled.Search" Style="max-width:280px" />
        </div>
        @if (!string.IsNullOrEmpty(_error)) { <MudAlert Severity="Severity.Error" Class="mb-2">@_error</MudAlert> }

        @* หมวดหมู่ + ไอคอน อ่านจาก wf_workflow.wgroup / icon — เพิ่มงานใหม่แล้ว
           ใส่ wgroup ก็ขึ้นหมวดเองโดยไม่ต้องแก้หน้านี้ *@
        @foreach (var grp in Filtered().GroupBy(x => string.IsNullOrWhiteSpace(x.Group) ? "อื่น ๆ" : x.Group)
                                        .OrderBy(g => GroupOrder(g.Key)))
        {
            <MudText Typo="Typo.subtitle1" Class="mt-5 mb-2"><b>@grp.Key</b>
                <MudText Typo="Typo.caption" Class="mud-text-secondary ml-2">@grp.Count() ประเภท</MudText>
            </MudText>
            <MudGrid Spacing="2">
                @foreach (var w in grp.OrderBy(x => x.Name))
                {
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudPaper Class="pa-3 wf-card" Outlined="true" Style="height:100%">
                            <div class="d-flex align-start gap-3">
                                <MudAvatar Color="@GroupColor(grp.Key)" Variant="Variant.Filled" Size="Size.Medium">
                                    <MudIcon Icon="@IconOf(w.Icon)" />
                                </MudAvatar>
                                <div style="flex:1; min-width:0">
                                    <MudText Typo="Typo.body1" Style="font-weight:600">@w.Name</MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">@w.Code</MudText>
                                    <div class="mt-1">
                                        <MudChip T="string" Size="Size.Small" Class="mr-1">@w.Levels ขั้น</MudChip>
                                        @if (string.IsNullOrWhiteSpace(w.RefTable))
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Warning">ยังไม่ผูกเอกสาร</MudChip>
                                        }
                                    </div>
                                </div>
                            </div>
                            <MudButton FullWidth="true" Class="mt-3" Size="Size.Small"
                                       Variant="Variant.Filled" Color="@GroupColor(grp.Key)"
                                       StartIcon="@Icons.Material.Filled.PlayArrow"
                                       Href="@($"/workflow/create/{w.WorkflowId}")">เริ่มงาน</MudButton>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        }

        @if (_myOpen.Count > 0)
        {
            <MudDivider Class="my-5" />
            <MudText Typo="Typo.h6" Class="mb-2">งานของฉันที่ยังไม่ปิด</MudText>
            <MudTable Items="_myOpen" Dense="true" Hover="true">
                <HeaderContent><MudTh>งาน</MudTh><MudTh>ประเภท</MudTh><MudTh>สถานะ</MudTh><MudTh>ขั้น</MudTh><MudTh></MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd>#@context.jobmasterid</MudTd>
                    <MudTd>@context.wname</MudTd>
                    <MudTd><MudChip T="string" Size="Size.Small">@context.status</MudChip></MudTd>
                    <MudTd>@context.lastLevel</MudTd>
                    <MudTd><MudButton Size="Size.Small" Variant="Variant.Outlined"
                                      Href="@($"/workflow/detail/{context.jobmasterid}")">เปิด</MudButton></MudTd>
                </RowTemplate>
            </MudTable>
        }
    }
    else if (_m?.jobMaster is null)
    {
        <MudAlert Severity="Severity.Info">@(_m?.message.FirstOrDefault() ?? "กำลังโหลด...")</MudAlert>
    }
    else
    {
        <MudText Typo="Typo.h5">@_m.jobMaster.wname — @_m.jobMaster.subject</MudText>
        <MudText Typo="Typo.body2" Class="mt-1">
            งาน #@_m.jobMaster.jobmasterid · ผู้ขอ @_m.jobMaster.reqName
            @(_m.jobMaster.createdate is not null ? $"({_m.jobMaster.createdate:dd/MM/yyyy HH:mm})" : "")
        </MudText>
        <MudText Typo="Typo.body2">
            สถานะ <b>@_m.jobMaster.status</b> · ขั้นที่ @_m.jobMaster.lastLevel
            @(_m.subWorkflow?.subject is string s && s.Length > 0 ? $"— {s}" : "")
            · ก้าวที่ @_m.jobMaster.jobseq
            @if (_m.jobMaster.isJobClosed == true) { <MudChip T="string" Size="Size.Small" Color="Color.Default" Class="ml-2">ปิดแล้ว</MudChip> }
        </MudText>

        @* ── 1. ความคืบหน้าของงาน (epms Detail.cshtml collapse1) ───────────── *@
        <div class="mt-3 mb-2">
            <WorkflowStepper JobMasterId="@Id" />
        </div>

        @* ── เส้นทางทั้งหมด พร้อมชื่อผู้อนุมัติทุกขั้น ─────────────────────────
           ต้นฉบับทำแบบนี้ทั้งคู่ — JSP getWorkflowRount() คืนทั้งเส้นทางพร้อมชื่อ
           และ epms getPredictNextUser() ทายจาก config ผู้ยื่นจึงเห็นตั้งแต่ต้นว่า
           เรื่องจะผ่านมือใครบ้าง ไม่ใช่รู้ทีละขั้นตอนที่งานเดินไปถึง *@
        @if (_route.Count > 0)
        {
            <MudExpansionPanels Elevation="0" Class="mb-2">
                <MudExpansionPanel Text="@($"เส้นทางอนุมัติทั้งหมด {_route.Count} ขั้น — ดูว่าเรื่องจะผ่านใครบ้าง")">
                    <MudTable Items="_route" Dense="true" Hover="false" Elevation="0">
                        <HeaderContent>
                            <MudTh>ขั้น</MudTh><MudTh>ชื่อขั้น</MudTh><MudTh>ผู้อนุมัติ</MudTh><MudTh></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.Level</MudTd>
                            <MudTd>
                                @context.Name
                                @if (context.IsTop)
                                {
                                    <MudChip T="string" Size="Size.Small" Class="ml-1">ขั้นสุดท้าย</MudChip>
                                }
                            </MudTd>
                            <MudTd>
                                @if (context.Approvers.Count > 0)
                                {
                                    @string.Join(", ", context.Approvers)
                                }
                                else
                                {
                                    <span class="mud-text-secondary">@context.Source</span>
                                }
                                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">@context.Source</MudText>
                            </MudTd>
                            <MudTd>
                                @if (context.IsCurrent)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary">อยู่ที่นี่</MudChip>
                                }
                                else if (context.IsDone)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success">ผ่านแล้ว</MudChip>
                                }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        ขั้นที่ผ่านไปแล้วแสดงชื่อคนที่ทำจริง ขั้นที่ยังไม่ถึงอ่านจากการตั้งค่าของ workflow ณ ตอนนี้
                        — ถ้าผังองค์กรหรือผู้รับมอบฉันทะเปลี่ยน รายชื่อจะเปลี่ยนตาม
                    </MudText>
                </MudExpansionPanel>
            </MudExpansionPanels>
        }

        @* ── 2. เอกสาร: เสียบหน้าของโมดูลตาม config ของขั้นนี้ (collapse2) ──── *@
        <MudDivider Class="my-3" />
        <MudText Typo="Typo.subtitle2">เอกสาร</MudText>
        @if (_docType is not null)
        {
            <DynamicComponent Type="_docType" Parameters="_docParams" />
        }
        else if (_docLink is not null)
        {
            <MudButton Href="@_docLink" Target="_blank" Variant="Variant.Outlined" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.OpenInNew" Class="mt-1">
                ดูเอกสารต้นทาง (@_m.jobMaster.reftable #@_m.jobMaster.refid)
            </MudButton>
        }
        else
        {
            @* ยังไม่ได้ config หน้าโมดูล — อย่างน้อยต้องบอกให้ได้ว่ากำลังอนุมัติอะไร
               (CEO: "คุณทำ workflow แต่ไม่รู้ว่าอนุมัติอะไร ได้อย่างไร")
               job_master พกข้อมูลของคำขอมาด้วยอยู่แล้วตั้งแต่ตอนเปิดงาน
               จึงแสดงจากตรงนั้นได้เลย ไม่ต้องรู้จักโมดูลปลายทาง — ใช้ได้กับ
               ทุก workflow ที่ยังไม่มีหน้ารายละเอียดของตัวเอง *@
            <MudSimpleTable Dense="true" Hover="false" Striped="false" Class="mt-1" Style="max-width:640px">
                <tbody>
                    @foreach (var (label, value) in JobFacts())
                    {
                        <tr>
                            <td style="width:170px" class="mud-text-secondary">@label</td>
                            <td>@value</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
            <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">
                ขั้นนี้ยังไม่ได้ตั้งค่าว่าให้เสียบหน้ารายละเอียดของโมดูลไหน —
                ตั้งได้ที่ช่อง "หน้ารายละเอียด (controller)" ในหน้าออกแบบ workflow
            </MudText>
        }

        @* ── เอกสารแนบ ──
           doc_center เป็นที่เก็บไฟล์แนบกลางของทั้งระบบ workflow จึงดึงมาแสดงเอง
           ไม่ต้องรอให้หน้าโมดูลมีปุ่มแนบของตัวเอง (CEO, 10 ก.ย. 2569)
             แถวบน = ไฟล์ของเอกสารต้นทาง คีย์ด้วย (wf_workflow.doctypecode, job.refid)
             แถวล่าง = ไฟล์ที่ผู้อนุมัติแนบระหว่างอนุมัติ คีย์ด้วย jobapproverid *@
        <MudDivider Class="my-3" />
        <div class="d-flex align-center gap-2">
            <MudText Typo="Typo.subtitle2">เอกสารแนบ</MudText>
            <MudChip T="string" Size="Size.Small">@(_docFiles.Count + _myFiles.Count) ไฟล์</MudChip>
        </div>

        @if (_docFiles.Count > 0)
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary">แนบมากับคำขอ</MudText>
            <MudStack Spacing="0" Class="mb-2">
                @foreach (var f in _docFiles)
                {
                    <MudLink Href="@($"/wf/files/job/{Id}/{f.id}")" Target="_blank">
                        <MudIcon Icon="@Icons.Material.Filled.AttachFile" Size="Size.Small" /> @f.files
                    </MudLink>
                }
            </MudStack>
        }

        @if (_myFiles.Count > 0)
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary">แนบโดยผู้อนุมัติ</MudText>
            <MudStack Spacing="0" Class="mb-2">
                @foreach (var f in _myFiles)
                {
                    <MudLink Href="@($"/wf/files/job/{Id}/{f.id}")" Target="_blank">
                        <MudIcon Icon="@Icons.Material.Filled.AttachFile" Size="Size.Small" /> @f.files
                    </MudLink>
                }
            </MudStack>
        }

        @if (_m.isCurrentUser && _m.jobUserListSession is not null)
        {
            <MudFileUpload T="IBrowserFile" FilesChanged="UploadAsync">
                <ActivatorContent>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.AttachFile">แนบไฟล์</MudButton>
                </ActivatorContent>
            </MudFileUpload>
        }
        else if (_docFiles.Count == 0 && _myFiles.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">ไม่มีเอกสารแนบ</MudText>
        }

        @* ── 2. ปุ่ม: ขึ้นตาม config ของขั้นที่งานอยู่ ────────────────────────── *@
        <MudDivider Class="my-3" />
        @if (!string.IsNullOrEmpty(_error)) { <MudAlert Severity="Severity.Error" Class="mb-2">@_error</MudAlert> }

        @* ขั้นแบบงานกอง (isPool) — ป้ายบอกให้ชัด + ดูได้ว่ามีใครอยู่ในกองบ้าง *@
        @if (_m.isPoolLevel)
        {
            <MudAlert Severity="@(_m.poolClaimedByMe ? Severity.Success : _m.poolClaimedByName is not null ? Severity.Warning : Severity.Info)"
                      Class="mb-2" Dense="true">
                <div class="d-flex align-center flex-wrap gap-2">
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Icon="@Icons.Material.Filled.Groups">
                        งานกอง (Pool)
                    </MudChip>

                    @if (_m.poolClaimedByMe)
                    {
                        <span>คุณรับงานนี้ไว้แล้ว</span>
                        <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="_busy"
                                   OnClick="ReleaseAsync">คืนงานเข้ากอง</MudButton>
                    }
                    else if (_m.poolClaimedByName is not null)
                    {
                        <span>ถูกรับไปแล้วโดย <b>@_m.poolClaimedByName</b></span>
                    }
                    else
                    {
                        <span>ยังไม่มีใครรับ — กดรับงานก่อนจึงจะดำเนินการได้</span>
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                   Disabled="_busy" OnClick="ClaimAsync">รับงาน</MudButton>
                    }

                    <MudButton Size="Size.Small" Variant="Variant.Text"
                               EndIcon="@(_showPool ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                               OnClick="@(() => _showPool = !_showPool)">
                        อยู่ในกอง @_m.poolMembers.Count คน
                    </MudButton>
                </div>

                <MudCollapse Expanded="_showPool">
                    <MudTable Items="_m.poolMembers" Dense="true" Class="mt-2">
                        <HeaderContent><MudTh>ผู้อยู่ในกอง</MudTh><MudTh>หน่วยงาน</MudTh><MudTh>สถานะ</MudTh><MudTh>ดำเนินการเมื่อ</MudTh></HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                @context.username
                                @if (context.userid == _m.jobMaster!.PoolClaimedByUserId)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Class="ml-2">รับงานแล้ว</MudChip>
                                }
                            </MudTd>
                            <MudTd>@context.orgcode</MudTd>
                            <MudTd>@context.jobstatus</MudTd>
                            <MudTd>@context.approvedate?.ToString("dd/MM/yyyy HH:mm")</MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudCollapse>
            </MudAlert>
        }

        @* ── 3. งานที่ต้องทำ: เหตุผล + หมายเหตุ + ปุ่ม (collapse3) ───────────── *@
        @if (_m.isCurrentUser)
        {
            @* dropdown เหตุผล อ่านจาก mas_reason ที่ผูกกับ workflow+level นี้
               (epms: ViewBag.mas_reason_id = SelectList(db.mas_reason.Where(workflowid, wlevel))) *@
            @if (_reasons.Count > 0)
            {
                <MudSelect T="long?" @bind-Value="_reasonId" Label="เหตุผล" Clearable="true" Class="mb-2">
                    @foreach (var r in _reasons)
                    {
                        <MudSelectItem T="long?" Value="@((long?)r.id)">@r.name</MudSelectItem>
                    }
                </MudSelect>
            }
            <MudTextField @bind-Value="_reason" Label="หมายเหตุ" Lines="2" Class="mb-2" />

            @* ── ปุ่ม ──
               ขั้นที่ติ๊ก isManualButton = ไม่ใช้ปุ่มมาตรฐาน ให้ wf_button เป็นคนบอก
               ว่ามีปุ่มอะไรบ้าง ชื่ออะไร สีอะไร ทำอะไร (epms GetButtonList)
               ถ้าไม่ได้ติ๊ก หรือ config ไม่มีปุ่มเลย ก็ใช้ปุ่มมาตรฐานตาม istop เหมือนเดิม *@
            @if (_configButtons.Count > 0)
            {
                <MudStack Row="true" Spacing="2">
                    @foreach (var b in _configButtons)
                    {
                        <MudButton Variant="Variant.Filled" Color="@ButtonColor(b.ColorOrClass)" Disabled="_busy"
                                   OnClick="@(() => ActByKind(b.ActionKind))">
                            @b.Label
                            @* ปุ่มส่งกลับบอกชื่อปลายทางด้วย ผู้อนุมัติจะได้รู้ก่อนกดว่าเรื่องจะไปถึงใคร *@
                            @if (b.ActionKind == WorkflowButtonService.ActionSendBack && _m.sendBackToName is not null)
                            {
                                <span>&nbsp;(@_m.sendBackToName)</span>
                            }
                        </MudButton>
                    }
                </MudStack>
            }
            else
            {
            <MudStack Row="true" Spacing="2">
                @* ขั้นสุดท้าย = ไม่มีที่ให้ไปต่อ -> ยืนอยู่กับที่แล้วงานจบ *@
                @if (_m.subWorkflow?.istop == true)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Success" Disabled="_busy"
                               OnClick="@(() => Act(Wf.ApproveAsync))">
                        @(_m.subWorkflow?.displayName ?? "อนุมัติ")
                    </MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy"
                               OnClick="@(() => Act(Wf.SubmitAsync))">
                        @(_m.subWorkflow?.displayName ?? "ส่งต่อ")
                    </MudButton>
                }

                @* ปุ่มส่งกลับ ขึ้นตาม isReturnSender ของขั้นที่ยืนอยู่ และแสดงชื่อ
                   คนที่จะส่งกลับไปหา เพื่อให้ผู้อนุมัติรู้ก่อนกดว่างานจะไปถึงใคร *@
                @if (_m.canReturnToSender)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Warning" Disabled="_busy"
                               StartIcon="@Icons.Material.Filled.Undo"
                               OnClick="@(() => Act(Wf.ReturnToSenderAsync))">
                        ส่งกลับหาผู้กรอกแบบฟอร์ม (@_m.sendBackToName)
                    </MudButton>
                }
                else if (_m.sendBackToName is not null)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Warning" Disabled="_busy"
                               StartIcon="@Icons.Material.Filled.ArrowBack"
                               OnClick="@(() => Act(Wf.RejectOneStepAsync))">
                        ส่งกลับ (@_m.sendBackToName)
                    </MudButton>
                }

                @* "ไม่อนุมัติ" คนละเรื่องกับ "ส่งกลับ" และผู้ใช้สับสนกันบ่อย
                   จึงขึ้นเฉพาะขั้นสุดท้าย และมีคำอธิบายกำกับใต้ปุ่มเสมอ *@
                @if (_m.canDecline)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="_busy"
                               StartIcon="@Icons.Material.Filled.Block"
                               OnClick="@(() => Act(Wf.DeclineAsync))">
                        ไม่อนุมัติ
                    </MudButton>
                }
            </MudStack>

            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">
                @if (_m.canDecline)
                {
                    <span><b>ส่งกลับ</b> = ให้กลับไปแก้แล้วส่งมาใหม่ เรื่องยังเดินต่อได้ ·
                          <b>ไม่อนุมัติ</b> = ปฏิเสธและปิดเรื่อง ไม่ต้องส่งมาอีก</span>
                }
                else if (_m.subWorkflow?.istop == true)
                {
                    <span>กดอนุมัติแล้วงานนี้จะจบทันที เพราะเป็นขั้นสุดท้าย</span>
                }
                else
                {
                    <span>กดแล้วเรื่องจะเดินไปขั้นถัดไป — ถ้าไม่เห็นด้วยให้ใช้ “ส่งกลับ”
                          การปฏิเสธถาวรทำได้เฉพาะผู้อนุมัติขั้นสุดท้าย</span>
                }
            </MudText>
            }
        }
        else if (_m.jobMaster.isJobClosed != true)
        {
            <MudAlert Severity="Severity.Normal">
                งานนี้ไม่ได้อยู่ที่คุณ — ตอนนี้รออยู่ที่ขั้นที่ @_m.jobMaster.lastLevel
                คุณดูความคืบหน้าได้ แต่ยังกดดำเนินการแทนไม่ได้
            </MudAlert>
        }

        @* ── สิ่งที่ "ผู้ยื่นคำขอ" ทำได้ — แยกจากสิ่งที่ผู้อนุมัติทำ ───────────── *@
        @if (_m.isDraftHolder || _m.canCancel)
        {
            <MudDivider Class="my-3" />
            <MudText Typo="Typo.subtitle2">คำขอของคุณ</MudText>

            @if (_m.isDraftHolder)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
                    เรื่องนี้อยู่ในมือคุณ ยังไม่ได้เข้าสายอนุมัติ
                    @if (!string.IsNullOrEmpty(_m.jobMaster.remark))
                    {
                        <span>— เหตุผลที่ถูกส่งกลับ: <b>@_m.jobMaster.remark</b></span>
                    }
                    <br />แก้เอกสารให้เรียบร้อยก่อน แล้วจึงกด “ส่งต่อ” เพื่อส่งเข้าสายอนุมัติอีกครั้ง
                </MudText>
                @if (_m.editUrl is not null)
                {
                    <MudButton Href="@_m.editUrl" Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Edit" Class="mr-2">แก้ไขเอกสาร</MudButton>
                }
            }

            @if (_m.canCancel)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" Disabled="_busy"
                           StartIcon="@Icons.Material.Filled.DoNotDisturbOn"
                           OnClick="CancelRequestAsync">ยกเลิกคำขอนี้</MudButton>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1">
                    ยกเลิกแล้วเรื่องจะปิดทันทีและหายจากกล่องงานของผู้อนุมัติ
                    ข้อมูลและประวัติยังเก็บไว้ครบ ไม่ได้ถูกลบ — แต่เปิดใหม่ไม่ได้ ต้องยื่นเรื่องใหม่
                </MudText>
            }
        }

        @* ── 3. ผู้อนุมัติขั้นถัดไป (ทายไว้ล่วงหน้า) ──────────────────────────── *@
        @if (_m.jobUserListPredict.Count > 0)
        {
            @* บอกก่อนกดว่าเรื่องจะไปถึงใคร — ลดการส่งผิดทาง และทำให้ผู้อนุมัติ
               ตัดสินใจได้เร็วขึ้นเพราะเห็นว่าใครจะรับช่วงต่อ (ข้อเสนอ BA ข้อ 5) *@
            <MudDivider Class="my-3" />
            <MudText Typo="Typo.subtitle2">กดแล้วเรื่องจะไปที่ใคร</MudText>
            <MudText Typo="Typo.body2">
                ขั้นที่ @_m.jobUserListPredict[0].wlevel —
                <b>@string.Join(", ", _m.jobUserListPredict.Select(p => p.username))</b>
                @if (_m.jobUserListPredict.Count > 1)
                {
                    <span class="mud-text-secondary"> (@_m.jobUserListPredict.Count คน)</span>
                }
            </MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                คำนวณจากการตั้งค่าของขั้นถัดไป ณ ตอนนี้ — ถ้าผังองค์กรหรือผู้รับมอบฉันทะเปลี่ยนก่อนคุณกด รายชื่ออาจเปลี่ยนตาม
            </MudText>
        }

        @* ── 4. ประวัติการเดิน ──────────────────────────────────────────────── *@
        <MudText Typo="Typo.subtitle2" Class="mt-4">ประวัติการเดินของงาน</MudText>
        <MudTable Items="_m.jobUserList" Dense="true" Class="mt-1">
            <HeaderContent>
                <MudTh>ก้าว</MudTh><MudTh>ขั้น</MudTh><MudTh>ผู้รับ</MudTh>
                <MudTh>สถานะ</MudTh><MudTh>เมื่อ</MudTh><MudTh>เหตุผล</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.jobseq</MudTd>
                <MudTd>@context.wlevel</MudTd>
                <MudTd>@context.username</MudTd>
                <MudTd>@context.jobstatus</MudTd>
                <MudTd>@context.approvedate?.ToString("dd/MM/yyyy HH:mm")</MudTd>
                <MudTd>@context.comment</MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

@code {
    [Parameter] public long Id { get; set; }

    // epms: WorkflowController.Create(workflowid) -> RedirectToAction("Detail")
    // เลือก workflow แล้วงานเกิดทันที เด้งเข้าหน้าเดียวกันนี้ที่ขั้นแรกของเส้นทาง
    [Parameter] public long? WorkflowId { get; set; }

    // งานต้องผูกกับเอกสารเสมอ ไม่งั้นผู้อนุมัติไม่มีอะไรให้ดู
    // (CEO, 10 ก.ย. 2569: "คุณทำ workflow แต่ไม่รู้ว่าอนุมัติอะไร")
    // โมดูลเรียกมาแบบ /workflow/create/{wfid}?reftable=Exp_ClaimHeader&refid=12
    [SupplyParameterFromQuery(Name = "reftable")] public string? RefTable { get; set; }
    [SupplyParameterFromQuery(Name = "refid")] public string? RefIdParam { get; set; }
    [SupplyParameterFromQuery(Name = "subject")] public string? SubjectParam { get; set; }
    [SupplyParameterFromQuery(Name = "amount")] public decimal? AmountParam { get; set; }

    private WorkFlowViewModel? _m;
    private long _actorUserId;
    private string? _reason;
    private string? _error;
    private bool _busy;
    private bool _showPool;

    private Type? _docType;
    private Dictionary<string, object> _docParams = new();
    private string? _docLink;

    // OnParametersSetAsync ไม่ใช่ OnInitializedAsync — Create แล้ว redirect ไป
    // route detail เป็น component ตัวเดิม Blazor จึงไม่เรียก OnInitialized ซ้ำ
    protected override async Task OnParametersSetAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _actorUserId = long.Parse(state.User.FindFirst("sc_userid")?.Value ?? "0");
        var empno = state.User.FindFirst("empno")?.Value;

        if (WorkflowId is long wfid)
        {
            try
            {
                var created = await Wf.CreateAsync(wfid, _actorUserId, empno,
                    subject: SubjectParam, reftable: RefTable, refid: RefIdParam, amount: AmountParam);
                Nav.NavigateTo($"/workflow/detail/{created.jobmasterid}", replace: true);
                return;
            }
            catch (Exception ex)
            {
                _error = ex.Message;
                _m = new WorkFlowViewModel { message = { ex.Message } };
                return;
            }
        }

        if (Id == 0)
        {
            await LoadStartPageAsync();
            return;
        }

        await LoadAsync();
    }

    // หน้าเริ่มงาน: workflow ที่เปิดใช้และมีเส้นทางตั้งไว้แล้ว + งานของฉันที่ยังไม่ปิด
    private record Startable(long WorkflowId, string? Code, string? Name, int Levels, string? RefTable,
                             string? Group, string? Icon);
    private string? _find;

    private IEnumerable<Startable> Filtered() =>
        string.IsNullOrWhiteSpace(_find)
            ? _startable
            : _startable.Where(x =>
                (x.Name ?? "").Contains(_find, StringComparison.OrdinalIgnoreCase) ||
                (x.Code ?? "").Contains(_find, StringComparison.OrdinalIgnoreCase) ||
                (x.Group ?? "").Contains(_find, StringComparison.OrdinalIgnoreCase));

    // เรียงหมวดให้ของที่ใช้บ่อยอยู่บน ของทดสอบอยู่ล่างสุด
    private static int GroupOrder(string g) => g switch
    {
        "งานบุคคล" => 1,
        "การเงิน" => 2,
        "สรรหา" => 3,
        "พัฒนาบุคลากร" => 4,
        "วินัยและรางวัล" => 5,
        "โครงสร้างองค์กร" => 6,
        "ทดสอบระบบ" => 98,
        _ => 50,
    };

    private static Color GroupColor(string g) => g switch
    {
        "งานบุคคล" => Color.Primary,
        "การเงิน" => Color.Success,
        "สรรหา" => Color.Info,
        "พัฒนาบุคลากร" => Color.Secondary,
        "วินัยและรางวัล" => Color.Warning,
        "โครงสร้างองค์กร" => Color.Tertiary,
        _ => Color.Default,
    };

    // ไอคอนเก็บเป็นชื่อใน wf_workflow.icon — แปลงเป็นไอคอนจริงตอนแสดง
    // ชื่อที่ไม่รู้จักหรือยังไม่ได้ตั้ง ใช้ไอคอนกลาง ไม่พังหน้า
    private static readonly Dictionary<string, string> _iconCache = new();
    private static string IconOf(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return Icons.Material.Filled.Assignment;
        if (_iconCache.TryGetValue(name, out var cached)) return cached;
        var f = typeof(Icons.Material.Filled).GetField(name,
            System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Static);
        var icon = f?.GetValue(null) as string ?? Icons.Material.Filled.Assignment;
        _iconCache[name] = icon;
        return icon;
    }
    private List<Startable> _startable = new();
    private List<job_master> _myOpen = new();

    private async Task LoadStartPageAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        // กรอง "ต้องมีขั้นตอนแล้ว" ในหน่วยความจำ — EF แปลงเงื่อนไขบน record
        // ที่ Select ออกมาแล้วไม่ได้ (ต้องเป็น Where บนคอลัมน์จริงเท่านั้น)
        var rows = await db.wf_workflows
            .Where(w => w.isactive == true)
            .Select(w => new Startable(w.workflowid, w.workflowcode, w.wname,
                db.wf_sub_workflow_masters.Count(s => s.workflowid == w.workflowid),
                w.tableref, w.wgroup, w.icon))
            .ToListAsync();
        _startable = rows.Where(x => x.Levels > 0).OrderBy(x => x.Code).ToList();

        _myOpen = await db.job_masters
            .Where(j => j.createuserid == _actorUserId && j.isJobClosed != true)
            .OrderByDescending(j => j.jobmasterid).Take(20).ToListAsync();
    }

    private List<mas_reason> _reasons = new();
    private long? _reasonId;

    // ปุ่มจาก config (wf_button) — ว่างเมื่อขั้นนี้ไม่ได้ตั้ง isManualButton
    // หรือตั้งแล้วแต่ยังไม่มีปุ่มใน wf_button ก็จะกลับไปใช้ปุ่มมาตรฐาน
    private List<WorkflowButtonService.WorkflowButtonDescriptor> _configButtons = new();
    private List<WorkflowService.RouteStep> _route = new();

    private static Color ButtonColor(string c) => c?.ToLowerInvariant() switch
    {
        "success" => Color.Success,
        "warning" => Color.Warning,
        "error" or "danger" => Color.Error,
        "info" => Color.Info,
        "secondary" => Color.Secondary,
        _ => Color.Primary,
    };

    // ปุ่มจาก config บอกแค่ "ทำอะไร" — แปลงเป็นการขยับของ engine
    private Task ActByKind(string kind) => kind switch
    {
        "sendback" when _m?.canReturnToSender == true => Act(Wf.ReturnToSenderAsync),
        "sendback" => Act(Wf.RejectOneStepAsync),
        // ปุ่มที่ config บอกว่าเป็น decline ต้องปฏิเสธจริง ไม่ใช่ส่งกลับ
        "decline" when _m?.canDecline == true => Act(Wf.DeclineAsync),
        "decline"  => Act(Wf.RejectOneStepAsync),
        _          => _m?.subWorkflow?.istop == true ? Act(Wf.ApproveAsync) : Act(Wf.SubmitAsync),
    };

    // ยกเลิกคำขอ — ต้องยืนยันก่อน เพราะปิดแล้วเปิดใหม่ไม่ได้
    private async Task CancelRequestAsync()
    {
        var ok = await Dialog.ShowMessageBox("ยกเลิกคำขอนี้",
            "เรื่องจะปิดทันทีและหายจากกล่องงานของผู้อนุมัติ ประวัติยังเก็บไว้ แต่เปิดใหม่ไม่ได้ ต้องยื่นเรื่องใหม่",
            yesText: "ยกเลิกคำขอ", cancelText: "ไม่ใช่ตอนนี้");
        if (ok != true) return;

        _busy = true; _error = null;
        try
        {
            await Wf.CancelAsync(new WorkFlowViewModel
            {
                jobmasterid = Id, actorUserId = _actorUserId,
                reason = string.IsNullOrWhiteSpace(_reason) ? "ผู้ยื่นยกเลิกคำขอเอง" : _reason,
            });
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task ClaimAsync()
    {
        _busy = true; _error = null;
        try { await Wf.ClaimPoolAsync(Id, _actorUserId); await LoadAsync(); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task ReleaseAsync()
    {
        _busy = true; _error = null;
        try { await Wf.ReleasePoolAsync(Id, _actorUserId); await LoadAsync(); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task LoadAsync()
    {
        _m = await Wf.DetailAsync(Id, _actorUserId);
        ResolveDocument();
        await LoadReasonsAsync();
        await LoadButtonsAsync();
        _route = _m?.jobMaster is null ? new() : await Wf.GetRouteAsync(Id);
        await LoadAttachmentsAsync();
    }

    // ── doc_center เข้ามาเป็นส่วนหนึ่งของ workflow ────────────────────────
    private List<doc_center> _docFiles = new();   // ไฟล์ของเอกสารต้นทาง
    private List<doc_center> _myFiles = new();    // ไฟล์ที่ผู้อนุมัติแนบ

    private async Task LoadAttachmentsAsync()
    {
        _docFiles = new(); _myFiles = new();
        if (_m?.jobMaster is null) return;

        await using var db = await DbFactory.CreateDbContextAsync();

        // เอกสารต้นทาง — คีย์ (doctypecode ของ workflow, refid ของงาน)
        var dt = _m.wfWorkflow?.doctypecode;
        if (!string.IsNullOrWhiteSpace(dt) && long.TryParse(_m.jobMaster.refid, out var refid))
            _docFiles = await db.doc_centers
                .Where(d => d.doctypecode == dt && d.refid == refid && d.isActive != false)
                .OrderBy(d => d.id).ToListAsync();

        // ไฟล์ที่ผู้อนุมัติแนบ — คีย์ jobapproverid ของงานนี้
        var approverIds = _m.jobUserList.Select(a => a.jobapproverid).ToList();
        if (approverIds.Count > 0)
            _myFiles = await db.doc_centers
                .Where(d => d.doctypecode == "WF_ATTACHMENT" && d.refid != null
                         && approverIds.Contains(d.refid.Value) && d.isActive != false)
                .OrderBy(d => d.id).ToListAsync();
    }

    private async Task UploadAsync(IBrowserFile? file)
    {
        if (file is null || _m?.jobUserListSession is null) return;
        _busy = true; _error = null;
        try
        {
            const long maxSize = 10 * 1024 * 1024;   // 10 MB
            await using var stream = file.OpenReadStream(maxSize);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);

            var approverId = _m.jobUserListSession.jobapproverid;
            var stored = $"{approverId}_{Guid.NewGuid():N}_{file.Name}";
            var (relativePath, _) = await FileStorage.SaveAsync("wf-attachments", stored, ms.ToArray());

            await using var db = await DbFactory.CreateDbContextAsync();
            db.doc_centers.Add(new doc_center
            {
                refid = approverId,
                doctypecode = "WF_ATTACHMENT",
                files = file.Name,
                path = relativePath,
                isActive = true,
                moddate = DateTime.Now,
            });
            await db.SaveChangesAsync();
            await LoadAttachmentsAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    // isManualButton — ขั้นนี้ไม่ใช้ปุ่มมาตรฐาน ให้ wf_button เป็นคนบอกว่ามีปุ่มอะไร
    // (epms GetButtonList เลือกจาก isStart / istop / isAndCondition)
    private async Task LoadButtonsAsync()
    {
        // CEO, 10 ก.ย. 2569: "ปุ่มไม่อนุมัติ -> config ใน table ได้เลย ดูจาก epms"
        // epms อ่าน wf_button เสมอ (GetButtonList(isStart, istop, isAndCondition))
        // ไม่มีเงื่อนไขว่าต้องติ๊กอะไรก่อน — เดิมเรากั้นด้วย isManualButton ทำให้
        // ตารางปุ่มไม่เคยถูกใช้เลย ตอนนี้อ่านทุกครั้ง ถ้าไม่มีแถวที่ตรงก็ตกไปใช้
        // ปุ่มมาตรฐานเหมือนเดิม (service คืนลิสต์ว่างเมื่อยังไม่ได้ config)
        _configButtons = new();
        var lv = _m?.subWorkflow;
        if (lv is null || _m?.isCurrentUser != true) return;

        _configButtons = await Buttons.GetButtonsForLevelAsync(
            lv.workflowid, lv.wlevel, lv.istop, lv.isandcondition);
    }

    // เหตุผลที่เลือกได้ของขั้นนี้ — แถวที่ผูกกับ workflow+level นี้โดยเฉพาะ
    // ถ้าไม่มีก็ใช้แถวกลางที่ไม่ได้ผูกกับ workflow ไหน (เหมือน epms ที่ fallback
    // ไป db.mas_reason ทั้งตารางเมื่อหาแบบเจาะจงไม่เจอ)
    private async Task LoadReasonsAsync()
    {
        _reasons = new();
        _reasonId = null;
        if (_m?.jobMaster is null) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        var level = _m.jobMaster.lastLevel ?? 0;
        _reasons = await db.mas_reasons
            .Where(r => r.isActive != false && r.workflowid == _m.jobMaster.workflowid && r.wlevel == level)
            .OrderBy(r => r.name).ToListAsync();

        if (_reasons.Count == 0)
            _reasons = await db.mas_reasons
                .Where(r => r.isActive != false && r.workflowid == null)
                .OrderBy(r => r.name).ToListAsync();
    }

    // ปุ่มทุกปุ่มเรียกทางนี้ทางเดียว — ต่างกันแค่ method ที่ส่งเข้ามา
    private async Task Act(Func<WorkFlowViewModel, CancellationToken, Task<WorkFlowViewModel>> move)
    {
        _busy = true;
        _error = null;
        try
        {
            await move(new WorkFlowViewModel
            {
                jobmasterid = Id,
                actorUserId = _actorUserId,
                reason = _reason,
                mas_reason_id = _reasonId,
            }, CancellationToken.None);
            _reason = null;
            _reasonId = null;
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    // ข้อเท็จจริงของคำขอที่ job_master พกมาเอง ใช้ตอนขั้นนั้นยังไม่ได้ config
    // หน้ารายละเอียดของโมดูล — ผู้อนุมัติต้องเห็นอย่างน้อยว่ากำลังอนุมัติอะไร
    // ให้ใครและจำนวนเท่าไหร่ ข้ามช่องที่ว่าง จะได้ไม่มีแถวเปล่าให้รก
    private IEnumerable<(string Label, string Value)> JobFacts()
    {
        var j = _m?.jobMaster;
        if (j is null) yield break;

        (string, string)[] all =
        {
            ("เรื่อง",              j.subject ?? ""),
            ("ผู้ยื่นคำขอ",          j.reqName ?? j.createby ?? ""),
            ("หน่วยงาน",            j.reqdept ?? ""),
            ("วันที่ขอ",            j.reqdate?.ToString("d MMM yyyy") ?? j.createdate?.ToString("d MMM yyyy") ?? ""),
            ("จำนวนเงิน",           j.reqamont is decimal a && a != 0 ? $"{a:N2} บาท" : ""),
            ("รายละเอียด",          j.description ?? ""),
            ("เหตุผลล่าสุด",         j.remark ?? ""),
            ("เอกสารต้นทาง",        string.IsNullOrWhiteSpace(j.reftable) ? "" : $"{j.reftable} #{j.refid}"),
        };
        foreach (var row in all)
            if (!string.IsNullOrWhiteSpace(row.Item2)) yield return row;
    }

    // ── include หน้าเอกสาร ────────────────────────────────────────────────
    // wf_sub_workflow_master.controller เก็บ route ของหน้าโมดูล เช่น
    // "/leave-requests/detail/{refid}" -> แทนค่า refid แล้วเทียบกับ route table
    // จริงของแอป ได้ Type แล้วเสียบด้วย <DynamicComponent> พร้อมส่ง id เข้าไป
    private void ResolveDocument()
    {
        _docType = null; _docParams = new(); _docLink = null;
        var route = _m?.subWorkflow?.controller;
        var refid = _m?.jobMaster?.refid ?? "";
        if (string.IsNullOrWhiteSpace(route)) return;

        var url = route.Replace("{refid}", refid, StringComparison.OrdinalIgnoreCase);
        var (type, prms) = MatchRoute(url);
        if (type is null) { _docLink = url; return; }

        AddIfDeclared(type, prms, "RefId", refid);
        AddIfDeclared(type, prms, "JobMasterId", Id);
        _docType = type;
        _docParams = prms;
    }

    // route table ของแอปเอง สร้างครั้งเดียว — ทำให้ config ใส่ route ธรรมดาได้
    // โดยไม่ต้องลงทะเบียน component ทีละตัวในโค้ด
    private static readonly Lazy<List<(string[] Segments, Type Type)>> _routes = new(() =>
        typeof(WorkflowService).Assembly.GetTypes()
            .Where(t => typeof(IComponent).IsAssignableFrom(t) && !t.IsAbstract)
            .SelectMany(t => t.GetCustomAttributes<RouteAttribute>().Select(a => (a.Template, Type: t)))
            .Select(x => (Segments: x.Template.Trim('/').Split('/'), x.Type))
            .ToList());

    private static (Type? Type, Dictionary<string, object> Parameters) MatchRoute(string url)
    {
        var parts = url.Split('?')[0].Trim('/').Split('/');
        foreach (var (segments, type) in _routes.Value)
        {
            if (segments.Length != parts.Length) continue;
            var prms = new Dictionary<string, object>();
            var ok = true;
            for (var i = 0; i < segments.Length; i++)
            {
                var seg = segments[i];
                if (seg.StartsWith('{') && seg.EndsWith('}'))
                {
                    var name = seg.Trim('{', '}');
                    var constraint = "";
                    var colon = name.IndexOf(':');
                    if (colon >= 0) { constraint = name[(colon + 1)..]; name = name[..colon]; }
                    object? val = constraint switch
                    {
                        "long" => long.TryParse(parts[i], out var l) ? l : null,
                        "int" => int.TryParse(parts[i], out var n) ? n : null,
                        "guid" => Guid.TryParse(parts[i], out var g) ? g : null,
                        _ => parts[i],
                    };
                    if (val is null) { ok = false; break; }
                    prms[name] = val;
                }
                else if (!string.Equals(seg, parts[i], StringComparison.OrdinalIgnoreCase)) { ok = false; break; }
            }
            if (ok) return (type, prms);
        }
        return (null, new());
    }

    // DynamicComponent จะพังถ้าส่งพารามิเตอร์ที่หน้านั้นไม่ได้ประกาศไว้
    private static void AddIfDeclared(Type type, Dictionary<string, object> prms, string name, object value)
    {
        if (prms.ContainsKey(name)) return;
        var p = type.GetProperty(name);
        if (p?.GetCustomAttribute<ParameterAttribute>() is not null) prms[name] = value;
    }
}
