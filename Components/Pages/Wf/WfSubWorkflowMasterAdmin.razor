@page "/wf/sub-workflow-levels"
@using HRM.Models
@using HRM.Services.Shared
@using HRM.Services.Workflow
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@attribute [Authorize(Policy = "Menu:WF_WORKFLOW_ADMIN")]

<PageTitle>จัดการระดับการอนุมัติ</PageTitle>

<CrudScaffold TEntity="wf_sub_workflow_master"
    Title="จัดการระดับการอนุมัติของ Workflow (wf_sub_workflow_master)"
    IsPdpaSensitive="false"
    CanEdit="_canEdit"
    LoadListAsync="LoadListAsync"
    GetId="e => e.subworkflowid.ToString()"
    SaveAsync="SaveAsync"
    CreateNew="CreateNewLevel"
    RowColumns="RenderRowColumns"
    ViewFields="RenderViewFields"
    EditFields="RenderEditFields">
    <HeaderColumns>
        <MudTh>Workflow</MudTh>
        <MudTh>ระดับ</MudTh>
        <MudTh>หัวข้อ</MudTh>
        <MudTh>ประเภทผู้อนุมัติ</MudTh>
    </HeaderColumns>
</CrudScaffold>

@code {
    private bool _canEdit;
    private List<wf_workflow> _workflows = new();
    private List<string> _statusCodes = new();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _canEdit = state.User.HasClaim("menu_edit", "WF_WORKFLOW_ADMIN");

        await using var context = await DbFactory.CreateDbContextAsync();
        _workflows = await context.wf_workflows.OrderBy(w => w.workflowcode).ToListAsync();
        // Block 9 (Moving Status): forward/stand/backward status are now
        // pick-lists sourced from job_status instead of free text, so admins
        // can't typo a status code the engine will never match against
        // anything meaningful downstream.
        _statusCodes = await context.job_statuses.OrderBy(s => s.jobstatuscode).Select(s => s.jobstatuscode).ToListAsync();
    }

    private string WorkflowName(long workflowId) => _workflows.FirstOrDefault(w => w.workflowid == workflowId)?.wname ?? $"#{workflowId}";

    private bool IsParentWorkflowActive(long workflowId) => _workflows.FirstOrDefault(w => w.workflowid == workflowId)?.isactive == true;

    // forwardstatus/standstatus/backwardstatus are NOT NULL in the DB — see
    // Gotcha #4 in the plan file. approver-type booleans already default to
    // false via the model's own property initializers, so only the three
    // status strings need explicit defaults here.
    private wf_sub_workflow_master CreateNewLevel() => new wf_sub_workflow_master
    {
        wlevel = 1,
        forwardstatus = "PENDING",
        standstatus = "PENDING",
        backwardstatus = "RETURNED",
    };

    private RenderFragment RenderRowColumns(wf_sub_workflow_master row) => @<text>
        <MudTd>@WorkflowName(row.workflowid)</MudTd>
        <MudTd>@row.wlevel</MudTd>
        <MudTd>@row.subject</MudTd>
        <MudTd>@ActiveStrategyLabels(row)</MudTd>
    </text>;

    // Lists every resolver-related flag that's turned on for this level.
    // Multiple can genuinely be true at once as of Phase 2 Block 3/4 —
    // ResolveCandidatesAsync unions the pool from every strategy ticked here
    // (isLOA stays exclusive, per the explicit financial-control decision).
    private static string ActiveStrategyLabels(wf_sub_workflow_master e)
    {
        var active = new List<string>();
        if (e.iscustomUser) active.Add("Custom User");
        if (e.iscustomRole) active.Add("Custom Role");
        if (e.isupperrole || e.isupperuser) active.Add("Vertical");
        if (e.isLOA) active.Add("LOA (วงเงิน)");
        if (e.isReturnSender) active.Add("Return to Sender");
        if (e.isApproverSameCostCenter) active.Add("Same Cost Center");
        if (e.isAdhocUser) active.Add("Adhoc User");
        return active.Count == 0 ? "ยังไม่กำหนด" : string.Join(", ", active);
    }

    private RenderFragment RenderViewFields(wf_sub_workflow_master e) => @<text>
        @if (IsParentWorkflowActive(e.workflowid))
        {
            <MudAlert Severity="Severity.Warning" Class="mb-3">
                Workflow นี้เปิดใช้งานอยู่ — ระดับการอนุมัตินี้ห้ามแก้ไข/เพิ่ม/ลบทุกกรณี
                ถ้าต้องการเปลี่ยนแปลง ให้ไปยกเลิกการใช้งาน workflow นี้ก่อน แล้วสร้าง workflow ใหม่แทน
            </MudAlert>
        }
        <MudGrid Class="mt-1">
            <MudItem xs="12" sm="6"><MudTextField Value="@WorkflowName(e.workflowid)" Label="Workflow" ReadOnly="true" /></MudItem>
            <MudItem xs="12" sm="2"><MudTextField Value="@e.wlevel.ToString()" Label="ระดับ" ReadOnly="true" /></MudItem>
            <MudItem xs="12" sm="4"><MudTextField Value="@e.subject" Label="หัวข้อ" ReadOnly="true" /></MudItem>
            <MudItem xs="12" sm="4"><MudCheckBox Value="e.iscustomUser" ReadOnly="true" Label="Custom User" /></MudItem>
            <MudItem xs="12" sm="4"><MudCheckBox Value="e.iscustomRole" ReadOnly="true" Label="Custom Role" /></MudItem>
            <MudItem xs="12" sm="4"><MudCheckBox Value="e.istop" ReadOnly="true" Label="ระดับสุดท้าย (istop)" /></MudItem>
            <MudItem xs="12" sm="4"><MudTextField Value="@e.forwardstatus" Label="สถานะเมื่ออนุมัติผ่าน" ReadOnly="true" /></MudItem>
            <MudItem xs="12" sm="4"><MudTextField Value="@e.standstatus" Label="สถานะระหว่างรออนุมัติ" ReadOnly="true" /></MudItem>
            <MudItem xs="12" sm="4"><MudTextField Value="@e.backwardstatus" Label="สถานะเมื่อตีกลับ/ปฏิเสธ" ReadOnly="true" /></MudItem>
            <MudItem xs="12" sm="4"><MudCheckBox Value="e.isandcondition" ReadOnly="true" Label="AND-condition (อนุมัติแบบ %)" /></MudItem>
            <MudItem xs="12" sm="4"><MudTextField Value="@(e.andpercent?.ToString("0.##") ?? "-")" Label="เกณฑ์ % ที่ต้องอนุมัติผ่าน" ReadOnly="true" /></MudItem>
            <MudItem xs="12" sm="4"><MudCheckBox Value="e.isorcondition" ReadOnly="true" Label="OR-condition (คนแรกที่อนุมัติพอ)" /></MudItem>
            <MudItem xs="12" sm="4"><MudTextField Value="@(e.isNeedsupervisorapprove?.ToString() ?? "0")" Label="จำนวนชั้นสายบังคับบัญชาที่ต้องอนุมัติก่อน (Mix Approval)" ReadOnly="true" /></MudItem>
            <MudItem xs="12" sm="4"><MudTextField Value="@(e.backwardlevel?.ToString() ?? "-")" Label="ตีกลับไประดับ (เมื่อถูกปฏิเสธ)" ReadOnly="true" /></MudItem>
            <MudItem xs="12" sm="4"><MudCheckBox Value="e.isupperrole" ReadOnly="true" Label="Vertical: Upper Role" /></MudItem>
            <MudItem xs="12" sm="4"><MudCheckBox Value="e.isupperuser" ReadOnly="true" Label="Vertical: Upper User" /></MudItem>
            <MudItem xs="12" sm="4"><MudCheckBox Value="e.isAutoApproveAllow" ReadOnly="true" Label="ข้ามอัตโนมัติถ้าไม่มีผู้อนุมัติ (isAutoApproveAllow)" /></MudItem>
            <MudItem xs="12" sm="4"><MudCheckBox Value="e.isLOA" ReadOnly="true" Label="LOA (ผู้อนุมัติตามวงเงิน)" /></MudItem>
            <MudItem xs="12" sm="4"><MudCheckBox Value="e.isReturnSender" ReadOnly="true" Label="Return to Sender (ส่งกลับไปหาผู้ขอ)" /></MudItem>
            <MudItem xs="12" sm="4"><MudCheckBox Value="e.isApproverSameCostCenter" ReadOnly="true" Label="ผู้อนุมัติที่ Cost Center เดียวกับผู้ขอ" /></MudItem>
            <MudItem xs="12" sm="4"><MudCheckBox Value="e.isApproverSameOrg" ReadOnly="true" Label="ผู้อนุมัติที่หน่วยงาน (Org) เดียวกับผู้ขอ" /></MudItem>
            <MudItem xs="12" sm="4"><MudCheckBox Value="e.isAdhocUser" ReadOnly="true" Label="ผู้อนุมัติเฉพาะกิจต่อ Job (wf_adhoc_user)" /></MudItem>
            <MudItem xs="12" sm="4"><MudTextField Value="@(e.empLevel?.ToString() ?? "-")" Label="ระดับพนักงานผู้อนุมัติ (empLevel)" ReadOnly="true" /></MudItem>
            <MudItem xs="12"><MudText Typo="Typo.subtitle2" Class="mt-2">การเสียบ Component + ปุ่ม (epms)</MudText></MudItem>
            <MudItem xs="12" sm="6"><MudTextField Value="@e.controller" Label="Controller (component เอกสาร)" ReadOnly="true" /></MudItem>
            <MudItem xs="12" sm="6"><MudTextField Value="@e.action" Label="Action / View (component เอกสาร)" ReadOnly="true" /></MudItem>
            <MudItem xs="12" sm="6"><MudTextField Value="@e.displayName" Label="ข้อความบนปุ่มอนุมัติ (displayName)" ReadOnly="true" /></MudItem>
            <MudItem xs="12" sm="6"><MudCheckBox Value="e.isManualButton" ReadOnly="true" Label="ปุ่มกำหนดเอง (isManualButton)" /></MudItem>
            <MudItem xs="12"><MudTextField Value="@e.remark" Label="หมายเหตุ" ReadOnly="true" Lines="2" /></MudItem>
        </MudGrid>
    </text>;

    private RenderFragment RenderEditFields(wf_sub_workflow_master e) => @<text>
        <MudGrid Class="mt-1">
            <MudItem xs="12" sm="6">
                <MudSelect T="long" Value="e.workflowid" ValueChanged="v => e.workflowid = v" Label="Workflow" Required="true">
                    @foreach (var wf in _workflows)
                    {
                        <MudSelectItem T="long" Value="@wf.workflowid">@wf.workflowcode - @wf.wname</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="2"><MudNumericField T="int" @bind-Value="e.wlevel" Label="ระดับ" Required="true" Min="1" /></MudItem>
            <MudItem xs="12" sm="4"><MudTextField @bind-Value="e.subject" Label="หัวข้อ" /></MudItem>
            <MudItem xs="12" sm="4"><MudCheckBox @bind-Value="e.iscustomUser" Label="Custom User (ระบุผู้อนุมัติเจาะจง)" /></MudItem>
            <MudItem xs="12" sm="4"><MudCheckBox @bind-Value="e.iscustomRole" Label="Custom Role (ระบุ Role ผู้อนุมัติ)" /></MudItem>
            <MudItem xs="12" sm="4"><MudCheckBox @bind-Value="e.istop" Label="ระดับสุดท้าย (istop)" /></MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="string" Value="e.forwardstatus" ValueChanged="v => e.forwardstatus = v" Label="สถานะเมื่ออนุมัติผ่าน" Required="true">
                    @foreach (var statusCode in _statusCodes)
                    {
                        <MudSelectItem T="string" Value="@statusCode">@statusCode</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="string" Value="e.standstatus" ValueChanged="v => e.standstatus = v" Label="สถานะระหว่างรออนุมัติ" Required="true">
                    @foreach (var statusCode in _statusCodes)
                    {
                        <MudSelectItem T="string" Value="@statusCode">@statusCode</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="string" Value="e.backwardstatus" ValueChanged="v => e.backwardstatus = v" Label="สถานะเมื่อตีกลับ/ปฏิเสธ" Required="true">
                    @foreach (var statusCode in _statusCodes)
                    {
                        <MudSelectItem T="string" Value="@statusCode">@statusCode</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudCheckBox T="bool" Value="e.isandcondition" ValueChanged="@((bool v) => { e.isandcondition = v; if (v) e.isorcondition = false; })" Label="AND-condition (อนุมัติแบบ % แทนต้องครบทุกคน)" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudNumericField T="decimal?" @bind-Value="e.andpercent" Label="เกณฑ์ % ที่ต้องอนุมัติผ่าน (ค่าเริ่มต้น 100)" Min="1" Max="100" Disabled="!e.isandcondition" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudCheckBox T="bool" Value="e.isorcondition" ValueChanged="@((bool v) => { e.isorcondition = v; if (v) e.isandcondition = false; })" Label="OR-condition (คนแรกที่อนุมัติพอ ไม่ต้องรอทุกคน)" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudNumericField T="int?" @bind-Value="e.isNeedsupervisorapprove" Label="จำนวนชั้นสายบังคับบัญชาที่ต้องอนุมัติก่อน (Mix Approval, 0 = ไม่ใช้)" Min="0" Max="10" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudNumericField T="int?" @bind-Value="e.backwardlevel" Label="ตีกลับไประดับ (ต้องน้อยกว่าระดับตัวเอง, เว้นว่าง = ปฏิเสธจบทันทีเหมือนเดิม)" Min="1" Max="@(e.wlevel - 1)" />
            </MudItem>
            <MudItem xs="12">
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                    ติ๊กได้พร้อมกันหลายอัน — engine จะรวมผู้อนุมัติจากทุก strategy ที่เปิดไว้เข้าด้วยกัน (union) ยกเว้น "LOA" ที่ยังคงทำงานแบบแยกเดี่ยวเสมอเพื่อความปลอดภัยด้านการควบคุมทางการเงิน (ถ้าติ๊ก LOA ไว้ด้วย strategy อื่นด้านล่างจะถูกข้ามทั้งหมด)
                </MudAlert>
            </MudItem>
            <MudItem xs="12" sm="4"><MudCheckBox @bind-Value="e.isupperrole" Label="Vertical: Upper Role" /></MudItem>
            <MudItem xs="12" sm="4"><MudCheckBox @bind-Value="e.isupperuser" Label="Vertical: Upper User" /></MudItem>
            <MudItem xs="12" sm="4"><MudCheckBox @bind-Value="e.isAutoApproveAllow" Label="ข้ามอัตโนมัติถ้าไม่มีผู้อนุมัติ (isAutoApproveAllow)" /></MudItem>
            <MudItem xs="12" sm="4"><MudCheckBox @bind-Value="e.isLOA" Label="LOA (ผู้อนุมัติตามวงเงิน — ตั้งค่าช่วงที่ /wf/loa)" /></MudItem>
            <MudItem xs="12" sm="4"><MudCheckBox @bind-Value="e.isReturnSender" Label="Return to Sender (ส่งกลับไปหาผู้ขอ)" /></MudItem>
            <MudItem xs="12" sm="4"><MudCheckBox @bind-Value="e.isApproverSameCostCenter" Label="ผู้อนุมัติที่ Cost Center เดียวกับผู้ขอ" /></MudItem>
            <MudItem xs="12" sm="4"><MudCheckBox @bind-Value="e.isApproverSameOrg" Label="ผู้อนุมัติที่หน่วยงาน (Org) เดียวกับผู้ขอ" /></MudItem>
            <MudItem xs="12" sm="4"><MudCheckBox @bind-Value="e.isAdhocUser" Label="ผู้อนุมัติเฉพาะกิจต่อ Job (ตั้งค่าที่ /wf/adhoc-users)" /></MudItem>
            <MudItem xs="12" sm="4"><MudNumericField T="int?" @bind-Value="e.empLevel" Label="ระดับพนักงานผู้อนุมัติ (empLevel, เว้นว่าง = ไม่กำหนด)" Min="0" /></MudItem>

            <MudItem xs="12">
                <MudText Typo="Typo.subtitle2" Class="mt-2">การเสียบ Component + ปุ่ม (epms)</MudText>
            </MudItem>
            <MudItem xs="12">
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                    ค่าเหล่านี้ทำให้ runtime แสดงผลแบบ generic ได้: ระบุ component เอกสารที่จะเสียบในหน้า workflow และข้อความบนปุ่มอนุมัติของระดับนี้ เว้นว่างทั้งหมดถ้าใช้ลิงก์เอกสารปกติ + ชุดปุ่มมาตรฐาน
                </MudAlert>
            </MudItem>
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="e.controller" Label="Controller (component เอกสาร)" HelperText="Controller ของ component เอกสารที่จะเสียบในหน้า workflow (epms) — เว้นว่างถ้าใช้ลิงก์เอกสารปกติ" /></MudItem>
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="e.action" Label="Action / View (component เอกสาร)" HelperText="Action/View ของ component เอกสาร" /></MudItem>
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="e.displayName" Label="ข้อความบนปุ่มอนุมัติ (displayName)" HelperText="ข้อความบนปุ่มอนุมัติของระดับนี้ (เว้นว่าง = 'อนุมัติ')" /></MudItem>
            <MudItem xs="12" sm="6"><MudCheckBox @bind-Value="e.isManualButton" Label="ปุ่มกำหนดเอง(ไม่ใช้ชุดปุ่มมาตรฐาน)" /></MudItem>

            <MudItem xs="12"><MudTextField @bind-Value="e.remark" Label="หมายเหตุ" Lines="2" /></MudItem>
        </MudGrid>
    </text>;

    private async Task<List<wf_sub_workflow_master>> LoadListAsync(string term)
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var query = EntitySearchHelper.ApplyTextSearch(context.wf_sub_workflow_masters.AsQueryable(), term,
            nameof(wf_sub_workflow_master.subject), nameof(wf_sub_workflow_master.remark));
        return await query.OrderBy(e => e.workflowid).ThenBy(e => e.wlevel).ToListAsync();
    }

    private async Task<wf_sub_workflow_master> SaveAsync(wf_sub_workflow_master entity)
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        await WorkflowLockGuard.EnsureWorkflowEditableAsync(context, entity.workflowid);
        if (entity.subworkflowid == 0)
        {
            context.wf_sub_workflow_masters.Add(entity);
        }
        else
        {
            var existing = await context.wf_sub_workflow_masters.FirstOrDefaultAsync(e => e.subworkflowid == entity.subworkflowid)
                ?? throw new InvalidOperationException("ไม่พบรายการนี้ในระบบแล้ว");
            existing.workflowid = entity.workflowid;
            existing.wlevel = entity.wlevel;
            existing.subject = entity.subject;
            existing.iscustomUser = entity.iscustomUser;
            existing.iscustomRole = entity.iscustomRole;
            existing.istop = entity.istop;
            existing.forwardstatus = entity.forwardstatus;
            existing.standstatus = entity.standstatus;
            existing.backwardstatus = entity.backwardstatus;
            existing.isandcondition = entity.isandcondition;
            existing.andpercent = entity.andpercent;
            existing.isorcondition = entity.isorcondition;
            existing.isNeedsupervisorapprove = entity.isNeedsupervisorapprove;
            existing.backwardlevel = entity.backwardlevel;
            existing.isupperrole = entity.isupperrole;
            existing.isupperuser = entity.isupperuser;
            existing.isAutoApproveAllow = entity.isAutoApproveAllow;
            existing.isLOA = entity.isLOA;
            existing.isReturnSender = entity.isReturnSender;
            existing.isApproverSameCostCenter = entity.isApproverSameCostCenter;
            existing.isApproverSameOrg = entity.isApproverSameOrg;
            existing.isAdhocUser = entity.isAdhocUser;
            existing.empLevel = entity.empLevel;
            existing.controller = entity.controller;
            existing.action = entity.action;
            existing.displayName = entity.displayName;
            existing.isManualButton = entity.isManualButton;
            existing.remark = entity.remark;
            entity = existing;
        }
        await context.SaveChangesAsync();
        return entity;
    }
}
