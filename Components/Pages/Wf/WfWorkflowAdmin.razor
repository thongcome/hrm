@page "/wf/workflows"
@using HRM.Models
@using HRM.Services.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@inject HRM.Services.Workflow.WorkflowStateChangeService StateChangeService
@inject NavigationManager Nav
@attribute [Authorize(Policy = "Menu:WF_WORKFLOW_ADMIN")]

<PageTitle>จัดการ Workflow</PageTitle>

<CrudScaffold TEntity="wf_workflow"
    Title="จัดการ Workflow (wf_workflow)"
    IsPdpaSensitive="false"
    CanEdit="_canEdit"
    LoadListAsync="LoadListAsync"
    GetId="e => e.workflowid.ToString()"
    SaveAsync="SaveAsync"
    CreateNew="CreateNewWorkflow"
    RowColumns="RenderRowColumns"
    ViewFields="RenderViewFields"
    EditFields="RenderEditFields">
    <HeaderColumns>
        <MudTh>รหัส Workflow</MudTh>
        <MudTh>ชื่อ</MudTh>
        <MudTh>สถานะ</MudTh>
        <MudTh>เปิดใช้งาน</MudTh>
    </HeaderColumns>
</CrudScaffold>

@* Deactivating a workflow is destructive at company scale — a single stray click
   used to disable it and break every new request for that flow. This dialog makes
   it deliberate: the admin must type the exact workflow code before the confirm
   button unlocks (the "type the repo name to delete" pattern). *@
<MudDialog @bind-Visible="_showDeactivateConfirm" Options="_deactivateDialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6" Color="Color.Warning">
            <MudIcon Icon="@Icons.Material.Filled.Gavel" Class="mr-2" Style="vertical-align:middle;" />
            ขอปิดใช้งาน Workflow — ต้องผ่านการอนุมัติ
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (_deactivateTarget is not null)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-3">
                การปิด <b>@_deactivateTarget.workflowcode</b> (@_deactivateTarget.wname) จะทำให้
                <b>ทุกคำขอใหม่ที่ใช้ workflow นี้ทั้งบริษัทส่งไม่ได้</b> จึงไม่สามารถกดปิดได้ทันที —
                ระบบจะส่ง <b>คำขอเปลี่ยนสถานะเข้าสายอนุมัติ (WF_STATE_CHANGE)</b> และจะปิดจริงก็ต่อเมื่อผู้มีสิทธิ์อนุมัติแล้วเท่านั้น
            </MudAlert>
            <MudTextField @bind-Value="_deactivateReason" Label="เหตุผลของการขอปิด (จำเป็น)" Lines="2"
                Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
            <MudText Typo="Typo.body2" Class="mb-2">
                ยืนยันการส่งคำขอ ให้พิมพ์รหัส <b>@_deactivateTarget.workflowcode</b> ลงในช่องด้านล่าง:
            </MudText>
            <MudTextField @bind-Value="_deactivateTyped" Immediate="true"
                Placeholder="@_deactivateTarget.workflowcode" Variant="Variant.Outlined" Margin="Margin.Dense" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CancelDeactivate">ยกเลิก</MudButton>
        <MudButton Color="Color.Warning" Variant="Variant.Filled"
            Disabled="@(_deactivateTarget is null || _deactivateTyped != _deactivateTarget.workflowcode || string.IsNullOrWhiteSpace(_deactivateReason))"
            OnClick="ConfirmDeactivateAsync">ส่งคำขออนุมัติปิดใช้งาน</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private bool _canEdit;

    private bool _showDeactivateConfirm;
    private wf_workflow? _deactivateTarget;
    private string _deactivateTyped = "";
    private string _deactivateReason = "";
    private static readonly DialogOptions _deactivateDialogOptions =
        new() { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _canEdit = state.User.HasClaim("menu_edit", "WF_WORKFLOW_ADMIN");
    }

    // wf_workflow.wstatus/isshow/isactive are NOT NULL in the DB — default
    // them here so Create doesn't hit the same NOT NULL trap documented as
    // Gotcha #4 in the plan file.
    private wf_workflow CreateNewWorkflow() => new wf_workflow { wstatus = "ACTIVE", isshow = true, isactive = true };

    private RenderFragment RenderRowColumns(wf_workflow row) => @<text>
        <MudTd>@row.workflowcode</MudTd>
        <MudTd>@row.wname</MudTd>
        <MudTd>@row.wstatus</MudTd>
        <MudTd>@(row.isactive == true ? "ใช้งาน" : "ปิด")</MudTd>
    </text>;

    private RenderFragment RenderViewFields(wf_workflow e) => @<text>
        @if (e.isactive == true)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-3">
                Workflow นี้เปิดใช้งานอยู่ — ห้ามแก้ไขทุกกรณี (ระดับการอนุมัติ/ผู้อนุมัติทุกตารางที่ผูกกับ workflow นี้ก็ล็อกด้วยเช่นกัน)
                ถ้าต้องการเปลี่ยนแปลง ให้กด "ยกเลิกการใช้งาน" ด้านล่างก่อน แล้วสร้าง workflow ใหม่แทน
            </MudAlert>
            @if (_canEdit)
            {
                <MudButton Color="Color.Error" Variant="Variant.Outlined" Class="mb-3" OnClick="@(() => DeactivateAsync(e))">ยกเลิกการใช้งาน (Deactivate)</MudButton>
            }
        }
        <MudGrid Class="mt-1">
            <MudItem xs="12" sm="4"><MudTextField Value="@e.workflowcode" Label="รหัส Workflow" ReadOnly="true" /></MudItem>
            <MudItem xs="12" sm="8"><MudTextField Value="@e.wname" Label="ชื่อ" ReadOnly="true" /></MudItem>
            <MudItem xs="12" sm="4"><MudTextField Value="@e.wstatus" Label="สถานะ" ReadOnly="true" /></MudItem>
            <MudItem xs="12" sm="4"><MudTextField Value="@e.abbname" Label="ชื่อย่อ" ReadOnly="true" /></MudItem>
            <MudItem xs="12" sm="4"><MudTextField Value="@e.wgroup" Label="กลุ่ม" ReadOnly="true" /></MudItem>
            <MudItem xs="12" sm="6"><MudTextField Value="@e.url" Label="URL ปลายทาง (สำหรับ generic routing)" ReadOnly="true" /></MudItem>
            <MudItem xs="12" sm="3"><MudTextField Value="@(e.isactive == true ? "ใช้งาน" : "ปิด")" Label="เปิดใช้งาน" ReadOnly="true" /></MudItem>
            <MudItem xs="12" sm="3"><MudTextField Value="@(e.isshow == true ? "แสดง" : "ซ่อน")" Label="แสดงในเมนู" ReadOnly="true" /></MudItem>
            <MudItem xs="12"><MudTextField Value="@e.description" Label="คำอธิบาย" ReadOnly="true" Lines="2" /></MudItem>
        </MudGrid>
    </text>;

    private RenderFragment RenderEditFields(wf_workflow e) => @<text>
        <MudGrid Class="mt-1">
            <MudItem xs="12" sm="4"><MudTextField @bind-Value="e.workflowcode" Label="รหัส Workflow" Required="true" /></MudItem>
            <MudItem xs="12" sm="8"><MudTextField @bind-Value="e.wname" Label="ชื่อ" Required="true" /></MudItem>
            <MudItem xs="12" sm="4"><MudTextField @bind-Value="e.wstatus" Label="สถานะ" Required="true" /></MudItem>
            <MudItem xs="12" sm="4"><MudTextField @bind-Value="e.abbname" Label="ชื่อย่อ" /></MudItem>
            <MudItem xs="12" sm="4"><MudTextField @bind-Value="e.wgroup" Label="กลุ่ม" /></MudItem>
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="e.url" Label="URL ปลายทาง (สำหรับ generic routing)" /></MudItem>
            <MudItem xs="12" sm="3">
                <MudCheckBox T="bool?" Value="e.isactive" ValueChanged="v => e.isactive = v ?? false" Label="เปิดใช้งาน" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudCheckBox T="bool?" Value="e.isshow" ValueChanged="v => e.isshow = v ?? false" Label="แสดงในเมนู" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudCheckBox T="bool?" Value="e.isautoapprove" ValueChanged="v => e.isautoapprove = v ?? false" Label="อนุมัติอัตโนมัติ (auto-approve)" />
            </MudItem>
            <MudItem xs="12"><MudTextField @bind-Value="e.description" Label="คำอธิบาย" Lines="2" /></MudItem>
        </MudGrid>
    </text>;

    private async Task<List<wf_workflow>> LoadListAsync(string term)
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var query = EntitySearchHelper.ApplyTextSearch(context.wf_workflows.AsQueryable(), term,
            nameof(wf_workflow.workflowcode), nameof(wf_workflow.wname), nameof(wf_workflow.description));
        return await query.OrderBy(e => e.workflowcode).ToListAsync();
    }

    // Opens the type-to-confirm dialog instead of deactivating on the spot —
    // the actual write happens in ConfirmDeactivateAsync only after the admin
    // has typed the exact workflow code.
    private void DeactivateAsync(wf_workflow e)
    {
        _deactivateTarget = e;
        _deactivateTyped = "";
        _showDeactivateConfirm = true;
    }

    private void CancelDeactivate()
    {
        _showDeactivateConfirm = false;
        _deactivateReason = "";
        _deactivateTarget = null;
        _deactivateTyped = "";
    }

    // Deactivating a workflow is no longer a direct write — it files a
    // state-change request that routes through the WF_STATE_CHANGE approval
    // workflow. The target's isactive flips only after that approval completes
    // (WorkflowStateChangeService.ApplyApprovedAsync), so a mis-click can't
    // take a company-wide workflow offline.
    private async Task ConfirmDeactivateAsync()
    {
        var e = _deactivateTarget;
        if (e is null || _deactivateTyped != e.workflowcode || string.IsNullOrWhiteSpace(_deactivateReason))
            return;

        var state = await AuthProvider.GetAuthenticationStateAsync();
        long.TryParse(state.User.FindFirst("sc_userid")?.Value, out var userId);
        var empId = state.User.FindFirst("empno")?.Value;

        try
        {
            await StateChangeService.RequestStateChangeAsync(e.workflowid, setActive: false, _deactivateReason, userId, empId);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return;
        }

        Snackbar.Add($"ส่งคำขอปิดใช้งาน '{e.workflowcode}' เข้าสายอนุมัติแล้ว — จะปิดจริงเมื่อผู้อนุมัติเห็นชอบ", Severity.Success);
        CancelDeactivate();
        Nav.NavigateTo("/wf/state-change-requests");
    }

    private async Task<wf_workflow> SaveAsync(wf_workflow entity)
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        if (entity.workflowid == 0)
        {
            context.wf_workflows.Add(entity);
        }
        else
        {
            var existing = await context.wf_workflows.FirstOrDefaultAsync(e => e.workflowid == entity.workflowid)
                ?? throw new InvalidOperationException("ไม่พบรายการนี้ในระบบแล้ว");
            if (existing.isactive == true)
                throw new InvalidOperationException(HRM.Services.Workflow.WorkflowLockGuard.LockedMessage);
            existing.workflowcode = entity.workflowcode;
            existing.wname = entity.wname;
            existing.wstatus = entity.wstatus;
            existing.abbname = entity.abbname;
            existing.wgroup = entity.wgroup;
            existing.url = entity.url;
            existing.isactive = entity.isactive;
            existing.isshow = entity.isshow;
            existing.isautoapprove = entity.isautoapprove;
            existing.description = entity.description;
            entity = existing;
        }
        await context.SaveChangesAsync();
        return entity;
    }
}
