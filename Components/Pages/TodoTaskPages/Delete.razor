@page "/todotasks/delete"

@using Microsoft.EntityFrameworkCore
@using LeaderDevelop.Model
@inject IDbContextFactory<LeaderDevelop.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager


<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>TodoTask</h4>
    <hr />
    @if (todotask is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Name</dt>
            <dd class="col-sm-10">@todotask.Name</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Startdate</dt>
            <dd class="col-sm-10">@todotask.Startdate</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">EndDate</dt>
            <dd class="col-sm-10">@todotask.EndDate</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">StatusCode</dt>
            <dd class="col-sm-10">@todotask.StatusCode</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Description</dt>
            <dd class="col-sm-10">@todotask.Description</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">LessonMode</dt>
            <dd class="col-sm-10">@todotask.LessonMode</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Lesson1</dt>
            <dd class="col-sm-10">@todotask.Lesson1</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Lesson2</dt>
            <dd class="col-sm-10">@todotask.Lesson2</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">UserId</dt>
            <dd class="col-sm-10">@todotask.UserId</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Email</dt>
            <dd class="col-sm-10">@todotask.Email</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">IsActive</dt>
            <dd class="col-sm-10">@todotask.IsActive</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">ThankFully</dt>
            <dd class="col-sm-10">@todotask.ThankFully</dd>
        </dl>
        <EditForm method="post" Model="todotask" OnValidSubmit="DeleteTodoTask" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(todotask is null)">Delete</button> |
            <a href="/todotasks">Back to List</a>
        </EditForm>
    }
</div>

@code {
    TodoTask? todotask;

    [SupplyParameterFromQuery]
    public int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        todotask = await context.TodoTasks.FirstOrDefaultAsync(m => m.Id == Id);

        if (todotask is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    public async Task DeleteTodoTask()
    {
        using var context = DbFactory.CreateDbContext();
        context.TodoTasks.Remove(todotask!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/todotasks");
    }
}
