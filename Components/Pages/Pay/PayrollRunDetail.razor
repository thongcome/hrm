@page "/pay/runs/{RunId:long}"
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Pay
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject PayrollWorkflowService WorkflowService
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject PayslipGenerationService PayslipGenerationService
@inject BankFileExportService BankFileExportService
@inject GLExportService GLExportService
@inject JsonLocalizationService L
@attribute [Authorize(Policy = "Menu:PAY_RUNS")]

<PageTitle>@string.Format(L.Translate("RunDetailPageTitle"), RunId)</PageTitle>

@if (_forbidden)
{
    <MudAlert Severity="Severity.Error">@L.Translate("RunDetailForbidden")</MudAlert>
}
else if (_run is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudPaper Class="pa-4 mb-4">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <div>
                <MudText Typo="Typo.h5">@L.Translate("RunDetailHeadingPrefix") @_run.CompanyId — @_run.PayrollPeriod (@_run.RunType)</MudText>
                <MudText Typo="Typo.body2" Class="mt-1">
                    @string.Format(L.Translate("RunDetailPeriodLine"), _run.PeriodStart.ToString("dd/MM/yyyy"), _run.PeriodEnd.ToString("dd/MM/yyyy"), _run.PayDate.ToString("dd/MM/yyyy"))
                </MudText>
            </div>
            <MudChip T="string" Color="StatusColor(_run.Status)" Size="Size.Medium">@_run.Status</MudChip>
        </MudStack>

        <MudDivider Class="my-3" />

        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
            @if (_allowed.Contains(PayrollAction.Calculate))
            {
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="CalculateAsync" Disabled="_busy">
                    @(_employees.Count == 0 ? L.Translate("CalculateButton") : L.Translate("RecalculateButton"))
                </MudButton>
            }
            @if (_allowed.Contains(PayrollAction.SubmitForReview))
            {
                <MudButton Color="Color.Info" Variant="Variant.Filled" OnClick="SubmitForReviewAsync" Disabled="_busy">@L.Translate("SubmitForReviewButton")</MudButton>
            }
            @if (_allowed.Contains(PayrollAction.Approve))
            {
                <MudButton Color="Color.Tertiary" Variant="Variant.Filled" OnClick="ApproveAsync" Disabled="_busy">@L.Translate("ApproveButton")</MudButton>
            }
            @if (_allowed.Contains(PayrollAction.Post))
            {
                <MudButton Color="Color.Secondary" Variant="Variant.Filled" OnClick="PostAsync" Disabled="_busy">@L.Translate("PostButton")</MudButton>
            }
            @if (_allowed.Contains(PayrollAction.MarkPaid))
            {
                <MudButton Color="Color.Success" Variant="Variant.Filled" OnClick="MarkPaidAsync" Disabled="_busy">@L.Translate("MarkPaidButton")</MudButton>
            }
            @if (_allowed.Contains(PayrollAction.Cancel))
            {
                <MudButton Color="Color.Error" Variant="Variant.Outlined" OnClick="CancelAsync" Disabled="_busy">@L.Translate("CancelRunButton")</MudButton>
            }
            @if (_allowed.Contains(PayrollAction.CreateAdjustment))
            {
                <MudButton Color="Color.Warning" Variant="Variant.Outlined" OnClick="CreateAdjustmentAsync" Disabled="_busy">@L.Translate("CreateAdjustmentButton")</MudButton>
            }
            @if (_canGenerateDocuments)
            {
                <MudButton Color="Color.Primary" Variant="Variant.Outlined" OnClick="GeneratePayslipsAsync" Disabled="_busy">@L.Translate("GeneratePayslipsButton")</MudButton>
                <MudButton Color="Color.Primary" Variant="Variant.Outlined" OnClick="GenerateBankFileAsync" Disabled="_busy">@L.Translate("GenerateBankFileButton")</MudButton>
            }
            @if (_canGenerateGL)
            {
                <MudButton Color="Color.Primary" Variant="Variant.Outlined" OnClick="GenerateGLExportAsync" Disabled="_busy">@L.Translate("GenerateGLButton")</MudButton>
            }
        </MudStack>

        @if (_payslipSummary is not null)
        {
            <MudAlert Severity="@(_payslipSummary.SkippedReasons.Count > 0 ? Severity.Warning : Severity.Success)" Class="mt-3">
                @string.Format(L.Translate("PayslipGenerateSuccessTemplate"), _payslipSummary.Generated)
                @if (_payslipSummary.SkippedReasons.Count > 0)
                {
                    <div>@string.Format(L.Translate("PayslipSkippedTemplate"), _payslipSummary.SkippedReasons.Count)
                        <ul class="mb-0">
                            @foreach (var reason in _payslipSummary.SkippedReasons)
                            {
                                <li>@reason</li>
                            }
                        </ul>
                    </div>
                }
            </MudAlert>
        }

        @if (_negativeCount > 0)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-3">
                @string.Format(L.Translate("NegativeNetPayWarning"), _negativeCount)
            </MudAlert>
        }

        @if (_pendingAdhocCount > 0 || _unconsumedApprovedAdhocCount > 0)
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
                    <span>
                        @if (_pendingAdhocCount > 0)
                        {
                            <text>@((MarkupString)string.Format(L.Translate("PendingAdhocWarningPart"), BoldItemCount(_pendingAdhocCount)))</text>
                        }
                        @if (_unconsumedApprovedAdhocCount > 0)
                        {
                            <text>@((MarkupString)string.Format(L.Translate("UnconsumedApprovedAdhocWarningPart"), BoldItemCount(_unconsumedApprovedAdhocCount)))</text>
                        }
                        @L.Translate("AdhocWarningSuffix")
                    </span>
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error"
                        OnClick="@(() => Navigation.NavigateTo($"/pay/adhoc/{_run!.PayrollPeriod}"))">
                        @L.Translate("GoToListButton")
                    </MudButton>
                </MudStack>
            </MudAlert>
        }

        @{ var pendingAnomalies = _anomalies.Where(a => !a.IsAcknowledged).ToList(); }
        @if (pendingAnomalies.Count > 0)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-3">
                <MudText Typo="Typo.subtitle2" Class="mb-2">@string.Format(L.Translate("AnomalyDetectedTemplate"), pendingAnomalies.Count)</MudText>
                @foreach (var anomaly in pendingAnomalies)
                {
                    var empNo = anomaly.PayrollEmployeeId is long peid
                        ? _employees.FirstOrDefault(e => e.Employee.Id == peid)?.Employee.EmpNo
                        : null;
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2" Class="mb-1">
                        <span>
                            <MudChip T="string" Size="Size.Small" Color="@AnomalySeverityColor(anomaly.Severity)" Class="mr-1">@anomaly.Severity</MudChip>
                            @if (!string.IsNullOrEmpty(empNo))
                            {
                                <b>@empNo</b>
                                @: —
                            }
                            @anomaly.Description
                        </span>
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => AcknowledgeAnomalyAsync(anomaly.Id))">@L.Translate("AcknowledgeButton")</MudButton>
                    </MudStack>
                }
            </MudAlert>
        }
    </MudPaper>

    <MudPaper Class="pa-4">
        <MudText Typo="Typo.h6" Class="mb-2">@string.Format(L.Translate("EmployeeListHeadingTemplate"), _employees.Count, _employees.Sum(e => e.Employee.NetPay).ToString("N2"))</MudText>
        <MudTable Items="_employees" Hover="true" Dense="true">
            <HeaderContent>
                <MudTh>@L.Translate("EmpNoLabel")</MudTh>
                <MudTh>@L.Translate("ColName")</MudTh>
                <MudTh>@L.Translate("ColWorkDaysRatio")</MudTh>
                <MudTh>@L.Translate("ColGrossEarnings")</MudTh>
                <MudTh>@L.Translate("ColTotalDeductions")</MudTh>
                <MudTh>@L.Translate("ColNetPay")</MudTh>
                <MudTh>@L.Translate("ColPayslip")</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Employee.EmpNo</MudTd>
                <MudTd>@context.Employee.Hremployee?.EmpName @context.Employee.Hremployee?.EmpSurname</MudTd>
                <MudTd>
                    @context.Employee.ActualWorkingDays/@context.Employee.WorkingDaysInPeriod
                    @if (context.Employee.ProrationFactor < 1m)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Class="ml-1">prorated</MudChip>
                    }
                </MudTd>
                <MudTd>@context.Employee.GrossEarnings.ToString("N2")</MudTd>
                <MudTd>@context.Employee.TotalDeductions.ToString("N2")</MudTd>
                <MudTd>
                    @context.Employee.NetPay.ToString("N2")
                    @if (context.Employee.IsNegativeNetPayFlag)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Class="ml-1">@L.Translate("NegativeChip")</MudChip>
                    }
                    @{ var empAnomalyCount = _anomalies.Count(a => a.PayrollEmployeeId == context.Employee.Id && !a.IsAcknowledged); }
                    @if (empAnomalyCount > 0)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ml-1">AI: @empAnomalyCount</MudChip>
                    }
                </MudTd>
                <MudTd>
                    @if (_payslipIdByEmployeeId.TryGetValue(context.Employee.Id, out var payslipId))
                    {
                        <MudLink Href="@($"/pay/files/payslip/{payslipId}")" Target="_blank">@L.Translate("DownloadButton")</MudLink>
                    }
                </MudTd>
                <MudTd>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => Navigation.NavigateTo($"/pay/runs/{RunId}/employee/{context.Employee.Id}"))">
                        @L.Translate("DescriptionLabel")
                    </MudButton>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText>@L.Translate("NotCalculatedYetMessage")</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>

    @if (_bankFileBatches.Count > 0)
    {
        <MudPaper Class="pa-4 mt-4">
            <MudText Typo="Typo.h6" Class="mb-2">@L.Translate("BankFilesGeneratedHeading")</MudText>
            <MudTable Items="_bankFileBatches" Hover="true" Dense="true">
                <HeaderContent>
                    <MudTh>@L.Translate("ColGeneratedDate")</MudTh>
                    <MudTh>@L.Translate("ColRecordCount")</MudTh>
                    <MudTh>@L.Translate("ColTotalAmount")</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.GeneratedDate.ToString("dd/MM/yyyy HH:mm")</MudTd>
                    <MudTd>@context.TotalRecordCount</MudTd>
                    <MudTd>@context.TotalAmount.ToString("N2")</MudTd>
                    <MudTd><MudLink Href="@($"/pay/files/bank-export/{context.Id}")" Target="_blank">@L.Translate("DownloadButton")</MudLink></MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    }

    @if (_glExportBatches.Count > 0)
    {
        <MudPaper Class="pa-4 mt-4">
            <MudText Typo="Typo.h6" Class="mb-2">@L.Translate("GLFilesGeneratedHeading")</MudText>
            <MudTable Items="_glExportBatches" Hover="true" Dense="true">
                <HeaderContent>
                    <MudTh>@L.Translate("ColGeneratedDate")</MudTh>
                    <MudTh>@L.Translate("ColTotalDebit")</MudTh>
                    <MudTh>@L.Translate("ColTotalCredit")</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.GeneratedDate.ToString("dd/MM/yyyy HH:mm")</MudTd>
                    <MudTd>@context.TotalDebit.ToString("N2")</MudTd>
                    <MudTd>@context.TotalCredit.ToString("N2")</MudTd>
                    <MudTd><MudLink Href="@($"/pay/files/gl-export/{context.Id}")" Target="_blank">@L.Translate("DownloadButton")</MudLink></MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    }
}

@code {
    [Parameter] public long RunId { get; set; }

    private Pay_PayrollRun? _run;
    private bool _forbidden;
    private IReadOnlySet<PayrollAction> _allowed = new HashSet<PayrollAction>();
    private bool _busy;
    private int _negativeCount;
    private int _pendingAdhocCount;
    private int _unconsumedApprovedAdhocCount;
    private bool _canGenerateDocuments;
    private bool _canGenerateGL;
    private PayslipGenerationResult? _payslipSummary;
    private List<Pay_PayrollAnomaly> _anomalies = new();
    private Dictionary<long, long> _payslipIdByEmployeeId = new();
    private List<Pay_BankFileExportBatch> _bankFileBatches = new();
    private List<Pay_GLExportBatch> _glExportBatches = new();

    private record EmployeeRow(Pay_PayrollEmployee Employee);
    private List<EmployeeRow> _employees = new();

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();

        _run = await context.Pay_PayrollRuns.FirstOrDefaultAsync(r => r.Id == RunId);
        if (_run is null) return;

        // One sc_user resolves to exactly one company via empid ->
        // Hremployee.EmpNo — see PayrollCompanyResolver. A run for any
        // other company is treated as inaccessible, not just hidden from
        // lists (defends direct-URL access, not just navigation).
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var companyId = authState.User.FindFirstValue("payroll_company");
        if (_run.CompanyId != companyId)
        {
            _forbidden = true;
            _run = null;
            return;
        }

        var employees = await context.Pay_PayrollEmployees
            .Include(e => e.Hremployee)
            .Where(e => e.PayrollRunId == RunId)
            .OrderBy(e => e.EmpNo)
            .ToListAsync();

        _employees = employees.Select(e => new EmployeeRow(e)).ToList();
        _negativeCount = employees.Count(e => e.IsNegativeNetPayFlag && !e.IsExcluded);
        _allowed = PayrollWorkflowService.GetAllowedActions(_run.Status);

        _pendingAdhocCount = await context.Pay_AdhocPayItems
            .CountAsync(a => a.TargetPeriod == _run.PayrollPeriod
                && a.Hremployee.companyid == _run.CompanyId
                && a.Status == PayAdhocItemStatus.Pending);
        _unconsumedApprovedAdhocCount = await context.Pay_AdhocPayItems
            .CountAsync(a => a.TargetPeriod == _run.PayrollPeriod
                && a.Hremployee.companyid == _run.CompanyId
                && a.Status == PayAdhocItemStatus.Approved);

        _canGenerateDocuments = _run.Status >= PayrollRunStatus.Approved && _run.Status != PayrollRunStatus.Cancelled;
        _canGenerateGL = _run.Status >= PayrollRunStatus.Posted && _run.Status != PayrollRunStatus.Cancelled;

        _payslipIdByEmployeeId = await context.Pay_Payslips
            .Where(p => employees.Select(e => e.Id).Contains(p.PayrollEmployeeId))
            .ToDictionaryAsync(p => p.PayrollEmployeeId, p => p.Id);

        _bankFileBatches = await context.Pay_BankFileExportBatches
            .Where(b => b.PayrollRunId == RunId)
            .OrderByDescending(b => b.GeneratedDate)
            .ToListAsync();
        _glExportBatches = await context.Pay_GLExportBatches
            .Where(b => b.PayrollRunId == RunId)
            .OrderByDescending(b => b.GeneratedDate)
            .ToListAsync();

        _anomalies = await context.Pay_PayrollAnomalies
            .Where(a => a.PayrollRunId == RunId)
            .OrderByDescending(a => a.Severity)
            .ToListAsync();
    }

    private async Task AcknowledgeAnomalyAsync(long anomalyId)
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var anomaly = await context.Pay_PayrollAnomalies.FirstOrDefaultAsync(a => a.Id == anomalyId);
        if (anomaly is null) return;

        anomaly.IsAcknowledged = true;
        anomaly.AcknowledgedByUserId = await GetCurrentUserIdAsync();
        anomaly.AcknowledgedDate = DateTime.Now;
        await context.SaveChangesAsync();

        await LoadAsync();
        Snackbar.Add(L.Translate("AcknowledgedSuccess"), Severity.Success);
    }

    private string BoldItemCount(int count) => $"<b>{string.Format(L.Translate("AdhocItemCountUnit"), count)}</b>";

    private async Task<long> GetCurrentUserIdAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        var idClaim = state.User.FindFirstValue("sc_userid");
        return long.TryParse(idClaim, out var id) ? id : 0;
    }

    private async Task RunActionAsync(Func<long, Task> action, string successMessage)
    {
        _busy = true;
        try
        {
            var actorUserId = await GetCurrentUserIdAsync();
            await action(actorUserId);
            await LoadAsync();
            Snackbar.Add(successMessage, Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private Task CalculateAsync() => RunActionAsync(
        async uid => await WorkflowService.CalculateAsync(RunId, uid),
        L.Translate("CalculatedSuccess"));

    private Task SubmitForReviewAsync() => RunActionAsync(
        async uid => await WorkflowService.SubmitForReviewAsync(RunId, uid),
        L.Translate("SubmittedForReviewSuccess"));

    private async Task ApproveAsync()
    {
        var confirmed = await DialogService.ShowMessageBox(
            L.Translate("ConfirmApproveTitle"), L.Translate("ConfirmApproveMessage"),
            yesText: L.Translate("ApproveButton"), cancelText: L.Translate("CancelButton"));
        if (confirmed != true) return;

        await RunActionAsync(async uid => await WorkflowService.ApproveAsync(RunId, uid, null), L.Translate("ApprovedSuccess"));
    }

    private Task PostAsync() => RunActionAsync(
        async uid => await WorkflowService.PostAsync(RunId, uid),
        L.Translate("PostedSuccess"));

    private Task MarkPaidAsync() => RunActionAsync(
        async uid => await WorkflowService.MarkPaidAsync(RunId, uid),
        L.Translate("MarkedPaidSuccess"));

    private async Task CancelAsync()
    {
        var confirmed = await DialogService.ShowMessageBox(
            L.Translate("ConfirmCancelRunTitle"), L.Translate("ConfirmCancelRunMessage"), yesText: L.Translate("CancelRunButton"), cancelText: L.Translate("BackButton"));
        if (confirmed != true) return;

        await RunActionAsync(async uid => await WorkflowService.CancelAsync(RunId, uid, "Cancelled by user"), L.Translate("RunCancelledSuccess"));
    }

    private async Task CreateAdjustmentAsync()
    {
        _busy = true;
        try
        {
            var actorUserId = await GetCurrentUserIdAsync();
            var newRunId = await WorkflowService.CreateAdjustmentRunAsync(RunId, actorUserId);
            Navigation.NavigateTo($"/pay/runs/{newRunId}");
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task GeneratePayslipsAsync()
    {
        _busy = true;
        try
        {
            _payslipSummary = await PayslipGenerationService.GenerateAsync(RunId);
            await LoadAsync();
            Snackbar.Add(string.Format(L.Translate("PayslipGenerateSuccessTemplate"), _payslipSummary.Generated), Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private Task GenerateBankFileAsync() => RunActionAsync(
        async uid => await BankFileExportService.ExportAsync(RunId, uid),
        L.Translate("BankFileGeneratedSuccess"));

    private Task GenerateGLExportAsync() => RunActionAsync(
        async uid => await GLExportService.ExportAsync(RunId, uid),
        L.Translate("GLGeneratedSuccess"));

    private static Color StatusColor(PayrollRunStatus status) => status switch
    {
        PayrollRunStatus.Draft => Color.Default,
        PayrollRunStatus.Calculated => Color.Info,
        PayrollRunStatus.Reviewed => Color.Warning,
        PayrollRunStatus.Approved => Color.Tertiary,
        PayrollRunStatus.Posted => Color.Secondary,
        PayrollRunStatus.Paid => Color.Success,
        PayrollRunStatus.Cancelled => Color.Error,
        _ => Color.Default,
    };

    private static Color AnomalySeverityColor(PayrollAnomalySeverity severity) => severity switch
    {
        PayrollAnomalySeverity.Info => Color.Info,
        PayrollAnomalySeverity.Warning => Color.Warning,
        PayrollAnomalySeverity.Critical => Color.Error,
        _ => Color.Default,
    };
}
