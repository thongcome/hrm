@page "/pay/runs/{RunId:long}"
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Pay
@using HRM.Services.Security
@using HRM.Services.Audit
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject PayrollWorkflowService WorkflowService
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject PayslipGenerationService PayslipGenerationService
@inject PayslipEmailService PayslipEmailService
@inject BankFileExportService BankFileExportService
@inject GLExportService GLExportService
@inject PayrollAnomalyDetectionService AnomalyDetectionService
@inject JsonLocalizationService L
@inject PayrollCalcJobRegistry CalcJobs
@inject PayrollCalcJobService CalcJobService
@inject PayrollPreflightService Preflight
@inject ProgramRoleService ProgramRoles
@inject IAuditLogger AuditLogger
@implements IDisposable
@attribute [Authorize(Policy = "Menu:PAY_RUNS")]

<PageTitle>@string.Format(L.Translate("RunDetailPageTitle"), RunId)</PageTitle>

@if (_forbidden)
{
    <MudAlert Severity="Severity.Error">@L.Translate("RunDetailForbidden")</MudAlert>
}
else if (_run is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudPaper Class="pa-4 mb-4">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <div>
                <MudText Typo="Typo.h5">@L.Translate("RunDetailHeadingPrefix") @_run.CompanyId — @_run.PayrollPeriod@(_run.TermNo > 1 || _run.PeriodEnd.Day < 28 ? $" งวด {_run.TermNo}" : "") (@RunTypeLabel(_run.RunType))</MudText>
                <MudText Typo="Typo.body2" Class="mt-1">
                    @string.Format(L.Translate("RunDetailPeriodLine"), _run.PeriodStart.ToString("dd/MM/yyyy"), _run.PeriodEnd.ToString("dd/MM/yyyy"), _run.PayDate.ToString("dd/MM/yyyy"))
                </MudText>
            </div>
            <MudChip T="string" Color="StatusColor(_run.Status)" Size="Size.Medium">@StatusLabel(_run.Status)</MudChip>
        </MudStack>

        @if (_run.Status == PayrollRunStatus.Cancelled)
        {
            <MudAlert Severity="Severity.Error" Class="mt-3" Dense="true">@L.Translate("RunCancelledNotice")</MudAlert>
        }
        else
        {
            <MudStack Row="true" Spacing="0" AlignItems="AlignItems.Start" Class="mt-4 mb-1" Style="overflow-x:auto;">
                @for (var i = 0; i < _stepTrack.Length; i++)
                {
                    var step = _stepTrack[i];
                    <MudStack AlignItems="AlignItems.Center" Spacing="0" Style="min-width:88px;">
                        <MudAvatar Color="StepColor(step)" Size="Size.Small">
                            @if ((int)step < (int)_run.Status)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                            }
                            else
                            {
                                @((i + 1).ToString())
                            }
                        </MudAvatar>
                        <MudText Typo="Typo.caption" Align="Align.Center" Class="mt-1">@StatusLabel(step)</MudText>
                    </MudStack>
                    @if (i < _stepTrack.Length - 1)
                    {
                        <MudDivider Style="@($"flex:1;min-width:24px;margin-top:16px;border-color:{(((int)_stepTrack[i + 1] <= (int)_run.Status) ? "var(--mud-palette-success)" : "var(--mud-palette-lines-default)")};")" />
                    }
                }
            </MudStack>
        }

        <MudDivider Class="my-3" />

        @if (_rights is not null && !_rights.CanEdit)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">หน้านี้ยังไม่ได้เปิดสิทธิ์แก้ไขให้บทบาทของคุณ — ดูได้อย่างเดียว ปุ่มดำเนินการจะถูกปฏิเสธ</MudAlert>
        }

        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
            @if (_allowed.Contains(PayrollAction.Calculate))
            {
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="CalculateAsync" Disabled="@(_busy || _calcRunning)">
                    @(_employees.Count == 0 ? L.Translate("CalculateButton") : L.Translate("RecalculateButton"))
                </MudButton>
            }
            @if (_calcRunning)
            {
                @* Background job progress (Phase A). The job runs server-side
                   independent of this page — closing the tab does not stop it; the
                   bar here is just polling PayrollCalcJobRegistry. *@
                <MudPaper Class="pa-3 mt-3" Outlined="true" Style="width:100%;">
                    <div class="d-flex align-center" style="gap:12px;">
                        <MudProgressCircular Indeterminate="@(_calcTotal == 0)" Value="@_calcPercent" Size="Size.Small" Color="Color.Primary" />
                        <div style="flex:1 1 auto;">
                            <MudText Typo="Typo.subtitle2">
                                กำลังคำนวณเงินเดือน… @(_calcTotal > 0 ? $"{_calcDone:#,0} / {_calcTotal:#,0} คน ({_calcPercent:0.#}%)" : "กำลังเตรียมข้อมูล")
                            </MudText>
                            <MudProgressLinear Color="Color.Primary" Indeterminate="@(_calcTotal == 0)" Value="@_calcPercent" Rounded="true" Size="Size.Large" Class="mt-1" />
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                งานนี้รันอยู่ที่เซิร์ฟเวอร์ — ปิดหน้านี้ได้ ระบบจะคำนวณต่อจนเสร็จ กลับมาดูความคืบหน้าได้ทุกเมื่อ
                            </MudText>
                        </div>
                    </div>
                </MudPaper>
            }
            else if (!string.IsNullOrEmpty(_run.CalcError))
            {
                <MudAlert Severity="Severity.Error" Class="mt-3">การคำนวณครั้งก่อนล้มเหลว: @_run.CalcError — กด "คำนวณ" เพื่อลองใหม่</MudAlert>
            }
            else if (_run.IsCalculating)
            {
                <MudAlert Severity="Severity.Warning" Class="mt-3">
                    พบว่าการคำนวณครั้งก่อนถูกขัดจังหวะ (เช่น เซิร์ฟเวอร์รีสตาร์ต) ตั้งแต่ @_run.CalcStartedAt?.ToString("dd/MM/yyyy HH:mm") — กด "คำนวณ" ใหม่ได้ ระบบจะล้างผลเก่าแล้วคำนวณซ้ำให้
                </MudAlert>
            }
            @* Phase B: pre-flight check — config errors, per-employee data issues,
               the approval checklist (pending adhoc/OT that would be silently
               excluded), and per-run employee holds with a reason. *@
            <MudPaper Class="pa-3 mt-3" Outlined="true" Style="width:100%;">
                <div class="d-flex align-center flex-wrap" style="gap:8px;">
                    <MudIcon Icon="@Icons.Material.Filled.FactCheck" Color="Color.Primary" />
                    <MudText Typo="Typo.subtitle1"><b>ตรวจสอบก่อนประมวลผล (Pre-flight)</b></MudText>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="RunPreflightAsync" Disabled="@(_preflightBusy || _calcRunning)">
                        @(_preflight is null ? "ตรวจสอบข้อมูล" : "ตรวจสอบอีกครั้ง")
                    </MudButton>
                    @if (_preflight is not null)
                    {
                        <MudChip T="string" Size="Size.Small" Color="@(_preflight.ErrorCount > 0 ? Color.Error : Color.Success)">ผิดพลาด @_preflight.ErrorCount</MudChip>
                        <MudChip T="string" Size="Size.Small" Color="@(_preflight.WarningCount > 0 ? Color.Warning : Color.Default)">เตือน @_preflight.WarningCount</MudChip>
                        <MudChip T="string" Size="Size.Small" Color="@(_preflight.PendingApprovals.Count > 0 ? Color.Warning : Color.Default)">รออนุมัติ @_preflight.PendingApprovals.Count</MudChip>
                        <MudChip T="string" Size="Size.Small" Color="Color.Info">hold @_preflight.HeldCount</MudChip>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">จะคำนวณ @_preflight.EligibleCount.ToString("#,0") คน</MudText>
                    }
                </div>
                @if (_preflightBusy) { <MudProgressLinear Indeterminate="true" Class="mt-2" /> }
                @if (_preflight is not null)
                {
                    @if (_preflight.ReadyToCalculate)
                    {
                        <MudAlert Severity="Severity.Success" Dense="true" Class="mt-2">ข้อมูลพร้อม ไม่พบข้อผิดพลาดและไม่มีรายการรออนุมัติ — คำนวณได้</MudAlert>
                    }
                    @foreach (var ce in _preflight.ConfigErrors)
                    {
                        <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@ce</MudAlert>
                    }
                    @if (_preflight.PendingApprovals.Count > 0)
                    {
                        <MudText Typo="Typo.subtitle2" Class="mt-3">✅ Checklist: ต้องอนุมัติก่อนประมวลผล (@_preflight.PendingApprovals.Count รายการ) — ถ้าไม่อนุมัติ รายการเหล่านี้จะไม่ถูกนำมาคำนวณ</MudText>
                        <MudTable Items="_preflight.PendingApprovals" Dense="true" Hover="true" Elevation="0">
                            <HeaderContent><MudTh>ประเภท</MudTh><MudTh>รหัส</MudTh><MudTh>พนักงาน</MudTh><MudTh>รายละเอียด</MudTh></HeaderContent>
                            <RowTemplate>
                                <MudTd><MudChip T="string" Size="Size.Small" Color="Color.Warning">@context.Kind</MudChip></MudTd>
                                <MudTd>@context.EmpNo</MudTd><MudTd>@context.Name</MudTd><MudTd>@context.Detail</MudTd>
                            </RowTemplate>
                            <PagerContent><MudTablePager PageSizeOptions="new[] { 20, 50, 100 }" /></PagerContent>
                        </MudTable>
                    }
                    @if (_preflight.Issues.Count > 0)
                    {
                        <MudText Typo="Typo.subtitle2" Class="mt-3">ข้อมูลพนักงานที่ต้องตรวจ (@_preflight.Issues.Count)</MudText>
                        <div class="d-flex align-center flex-wrap mb-1" style="gap:8px;">
                            <MudTextField T="string" @bind-Value="_holdReason" Label="เหตุผลการ hold (ใช้กับปุ่ม hold ด้านล่าง)" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:320px;" />
                        </div>
                        <MudTable Items="_preflight.Issues" Dense="true" Hover="true" Elevation="0">
                            <HeaderContent><MudTh>ระดับ</MudTh><MudTh>รหัส</MudTh><MudTh>พนักงาน</MudTh><MudTh>ปัญหา</MudTh><MudTh></MudTh></HeaderContent>
                            <RowTemplate>
                                <MudTd><MudChip T="string" Size="Size.Small" Color="@(context.Severity == PayrollPreflightService.Severity.Error ? Color.Error : Color.Warning)">@(context.Severity == PayrollPreflightService.Severity.Error ? "ผิดพลาด" : "เตือน")</MudChip></MudTd>
                                <MudTd>@context.EmpNo</MudTd><MudTd>@context.Name</MudTd><MudTd>@context.Message</MudTd>
                                <MudTd><MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Info" OnClick="@(() => HoldEmployeeAsync(context.HremployeeId))" Disabled="_calcRunning">hold คนนี้</MudButton></MudTd>
                            </RowTemplate>
                            <PagerContent><MudTablePager PageSizeOptions="new[] { 20, 50, 100 }" /></PagerContent>
                        </MudTable>
                    }
                    <MudText Typo="Typo.subtitle2" Class="mt-3">พนักงานที่ hold ไว้ (@_preflight.Holds.Count) — ถูกข้ามในรอบนี้ นำไปคำนวณรอบถัดไป</MudText>
                    <div class="d-flex align-center flex-wrap mb-1" style="gap:8px;">
                        <MudTextField T="string" @bind-Value="_holdEmpNo" Label="รหัสพนักงานที่จะ hold" Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:200px;" />
                        <MudTextField T="string" @bind-Value="_holdReason" Label="เหตุผล" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:280px;" />
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Info" OnClick="HoldByEmpNoAsync" Disabled="_calcRunning">hold</MudButton>
                    </div>
                    @if (_preflight.Holds.Count > 0)
                    {
                        <MudTable Items="_preflight.Holds" Dense="true" Hover="true" Elevation="0">
                            <HeaderContent><MudTh>รหัส</MudTh><MudTh>พนักงาน</MudTh><MudTh>เหตุผล</MudTh><MudTh>เมื่อ</MudTh><MudTh></MudTh></HeaderContent>
                            <RowTemplate>
                                <MudTd>@context.EmpNo</MudTd><MudTd>@context.Name</MudTd><MudTd>@context.Reason</MudTd>
                                <MudTd>@context.HeldDate.ToString("dd/MM/yyyy HH:mm")</MudTd>
                                <MudTd><MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Success" OnClick="@(() => ReleaseHoldAsync(context.Id))" Disabled="_calcRunning">ปล่อย</MudButton></MudTd>
                            </RowTemplate>
                            <PagerContent><MudTablePager PageSizeOptions="new[] { 20, 50, 100 }" /></PagerContent>
                        </MudTable>
                    }
                }
            </MudPaper>
            @if (_allowed.Contains(PayrollAction.SubmitForReview))
            {
                <MudButton Color="Color.Info" Variant="Variant.Filled" OnClick="SubmitForReviewAsync" Disabled="@(_busy || _calcRunning)">@L.Translate("SubmitForReviewButton")</MudButton>
            }
            @if (_allowed.Contains(PayrollAction.Approve))
            {
                <MudButton Color="Color.Tertiary" Variant="Variant.Filled" OnClick="ApproveAsync" Disabled="_busy">@L.Translate("ApproveButton")</MudButton>
            }
            @if (_allowed.Contains(PayrollAction.Post))
            {
                <MudButton Color="Color.Secondary" Variant="Variant.Filled" OnClick="PostAsync" Disabled="_busy">@L.Translate("PostButton")</MudButton>
            }
            @if (_allowed.Contains(PayrollAction.MarkPaid))
            {
                <MudButton Color="Color.Success" Variant="Variant.Filled" OnClick="MarkPaidAsync" Disabled="_busy">@L.Translate("MarkPaidButton")</MudButton>
            }
            @if (_allowed.Contains(PayrollAction.Cancel))
            {
                <MudButton Color="Color.Error" Variant="Variant.Outlined" OnClick="CancelAsync" Disabled="_busy">@L.Translate("CancelRunButton")</MudButton>
            }
            @if (_allowed.Contains(PayrollAction.CreateAdjustment))
            {
                <MudButton Color="Color.Warning" Variant="Variant.Outlined" OnClick="CreateAdjustmentAsync" Disabled="_busy">@L.Translate("CreateAdjustmentButton")</MudButton>
            }
            @if (_allowed.Contains(PayrollAction.Reverse))
            {
                <MudButton Color="Color.Error" Variant="Variant.Outlined" OnClick="@(() => _showReverse = !_showReverse)" Disabled="_busy">@L.Translate("ReverseRunButton")</MudButton>
            }
            @if (_showReverse && _allowed.Contains(PayrollAction.Reverse))
            {
                @* BA item #2: a Posted/Paid run is immutable (DB triggers refuse edits to its
                   rows). The only correction path is a reversal run that negates every line. *@
                <MudPaper Class="pa-3 mt-2" Outlined="true" Style="width:100%;">
                    <MudText Typo="Typo.body2" Class="mb-2">@L.Translate("ReverseRunReasonPrompt")</MudText>
                    <div class="d-flex align-center flex-wrap" style="gap:8px;">
                        <MudTextField T="string" @bind-Value="_reverseReason" Label="เหตุผล" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:360px;" />
                        <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="ReverseRunAsync" Disabled="@(_busy || string.IsNullOrWhiteSpace(_reverseReason))">ยืนยันกลับรายการ</MudButton>
                    </div>
                </MudPaper>
            }
            @if (_canGenerateDocuments)
            {
                <MudButton Color="Color.Primary" Variant="Variant.Outlined" OnClick="GeneratePayslipsAsync" Disabled="_busy">@L.Translate("GeneratePayslipsButton")</MudButton>
                <MudButton Color="Color.Primary" Variant="Variant.Outlined" OnClick="GenerateBankFileAsync" Disabled="_busy">@L.Translate("GenerateBankFileButton")</MudButton>
            }
            @if (_canGenerateGL)
            {
                <MudButton Color="Color.Primary" Variant="Variant.Outlined" OnClick="GenerateGLExportAsync" Disabled="_busy">@L.Translate("GenerateGLButton")</MudButton>
            }
        </MudStack>

        @if (_payslipSummary is not null)
        {
            <MudAlert Severity="@(_payslipSummary.SkippedReasons.Count > 0 ? Severity.Warning : Severity.Success)" Class="mt-3">
                @string.Format(L.Translate("PayslipGenerateSuccessTemplate"), _payslipSummary.Generated)
                @if (_payslipSummary.SkippedReasons.Count > 0)
                {
                    <div>@string.Format(L.Translate("PayslipSkippedTemplate"), _payslipSummary.SkippedReasons.Count)
                        <ul class="mb-0">
                            @foreach (var reason in _payslipSummary.SkippedReasons)
                            {
                                <li>@reason</li>
                            }
                        </ul>
                    </div>
                }
            </MudAlert>
        }

        @if (_negativeCount > 0)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-3">
                @string.Format(L.Translate("NegativeNetPayWarning"), _negativeCount)
            </MudAlert>
        }

        @if ((_pendingAdhocCount > 0 || _unconsumedApprovedAdhocCount > 0) && _run.Status < PayrollRunStatus.Posted)
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
                    <span>
                        @if (_pendingAdhocCount > 0)
                        {
                            <text>@((MarkupString)string.Format(L.Translate("PendingAdhocWarningPart"), BoldItemCount(_pendingAdhocCount)))</text>
                        }
                        @if (_unconsumedApprovedAdhocCount > 0)
                        {
                            <text>@((MarkupString)string.Format(L.Translate("UnconsumedApprovedAdhocWarningPart"), BoldItemCount(_unconsumedApprovedAdhocCount)))</text>
                        }
                        @L.Translate("AdhocWarningSuffix")
                    </span>
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error"
                        OnClick="@(() => Navigation.NavigateTo($"/pay/adhoc/{_run!.PayrollPeriod}"))">
                        @L.Translate("GoToListButton")
                    </MudButton>
                </MudStack>
            </MudAlert>
        }

        @if (_employees.Count > 0)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-3" Wrap="Wrap.Wrap">
                <MudText Typo="Typo.body2">@L.Translate("AnomalyBaselineLabel")</MudText>
                <MudSelect T="long?" @bind-Value="_selectedBaselineRunId" Dense="true" Style="min-width: 260px;">
                    <MudSelectItem T="long?" Value="null">@L.Translate("AnomalyBaselineAuto")</MudSelectItem>
                    @foreach (var r in _pastRuns)
                    {
                        <MudSelectItem T="long?" Value="r.Id">@r.PayrollPeriod (@L.Translate("PayrollRunType_" + r.RunType))</MudSelectItem>
                    }
                </MudSelect>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="RerunAnomalyDetectionAsync" Disabled="@(_busy || _anomalyPending)">
                    @L.Translate("AnomalyRerunButton")
                </MudButton>
                @if (_anomalyPending)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Icon="@Icons.Material.Filled.HourglassTop">กำลังตรวจหาความผิดปกติ (AI) ในพื้นหลัง — ตัวเลขเงินเดือนด้านบนสมบูรณ์แล้ว</MudChip>
                }
            </MudStack>
        }

        @{ var pendingAnomalies = _anomalies.Where(a => !a.IsAcknowledged).ToList(); }
        @if (pendingAnomalies.Count > 0)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-3">
                <MudText Typo="Typo.subtitle2" Class="mb-2">@string.Format(L.Translate("AnomalyDetectedTemplate"), pendingAnomalies.Count)</MudText>
                @if (pendingAnomalies.Count > AnomalyDisplayCap) { <MudText Typo="Typo.caption" Class="mb-2 d-block">แสดง @AnomalyDisplayCap รายการแรก (เรียงตามความรุนแรง) จากทั้งหมด @pendingAnomalies.Count.ToString("#,0") — กด "รับทราบ" หรือดูรายพนักงานเพื่อไล่ที่เหลือ</MudText> }
                @foreach (var anomaly in pendingAnomalies.OrderByDescending(a => (int)a.Severity).Take(AnomalyDisplayCap))
                {
                    var empNo = anomaly.PayrollEmployeeId is long peid
                        ? _employees.FirstOrDefault(e => e.Employee.Id == peid)?.Employee.EmpNo
                        : null;
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2" Class="mb-1">
                        <span>
                            <MudChip T="string" Size="Size.Small" Color="@AnomalySeverityColor(anomaly.Severity)" Class="mr-1">@anomaly.Severity</MudChip>
                            @if (!string.IsNullOrEmpty(empNo))
                            {
                                <b>@empNo</b>
                                @: —
                            }
                            @anomaly.Description
                        </span>
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => AcknowledgeAnomalyAsync(anomaly.Id))">@L.Translate("AcknowledgeButton")</MudButton>
                    </MudStack>
                }
            </MudAlert>
        }
    </MudPaper>

    <MudPaper Class="pa-4">
        <MudText Typo="Typo.h6" Class="mb-2">@string.Format(L.Translate("EmployeeListHeadingTemplate"), _employees.Count, _employees.Sum(e => e.Employee.NetPay).ToString("N2"))</MudText>
        <MudTable Items="_employees" Hover="true" Dense="true">
            <HeaderContent>
                <MudTh>@L.Translate("EmpNoLabel")</MudTh>
                <MudTh>@L.Translate("ColName")</MudTh>
                <MudTh>@L.Translate("ColWorkDaysRatio")</MudTh>
                <MudTh>@L.Translate("ColGrossEarnings")</MudTh>
                <MudTh>@L.Translate("ColTotalDeductions")</MudTh>
                <MudTh>@L.Translate("ColNetPay")</MudTh>
                <MudTh>@L.Translate("ColPayslip")</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Employee.EmpNo</MudTd>
                <MudTd>@context.Employee.Hremployee?.EmpName @context.Employee.Hremployee?.EmpSurname</MudTd>
                <MudTd>
                    @context.Employee.ActualWorkingDays/@context.Employee.WorkingDaysInPeriod
                    @if (context.Employee.ProrationFactor < 1m)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Class="ml-1">prorated</MudChip>
                    }
                </MudTd>
                <MudTd>@context.Employee.GrossEarnings.ToString("N2")</MudTd>
                <MudTd>@context.Employee.TotalDeductions.ToString("N2")</MudTd>
                <MudTd>
                    @context.Employee.NetPay.ToString("N2")
                    @if (context.Employee.IsNegativeNetPayFlag)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Class="ml-1">@L.Translate("NegativeChip")</MudChip>
                    }
                    @{ var empAnomalyCount = _anomalies.Count(a => a.PayrollEmployeeId == context.Employee.Id && !a.IsAcknowledged); }
                    @if (empAnomalyCount > 0)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ml-1">AI: @empAnomalyCount</MudChip>
                    }
                </MudTd>
                <MudTd>
                    @if (_payslipIdByEmployeeId.TryGetValue(context.Employee.Id, out var payslipId))
                    {
                        <MudLink Href="@($"/pay/files/payslip/{payslipId}")" Target="_blank">@L.Translate("DownloadButton")</MudLink>
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" Class="ml-1"
                                   Disabled="@_sendingPayslipIds.Contains(payslipId)"
                                   OnClick="@(() => SendPayslipToEmployeeAsync(payslipId))">
                            <MudIcon Icon="@Icons.Material.Filled.Send" Size="Size.Small" /> ส่งอีเมล
                        </MudButton>
                    }
                </MudTd>
                <MudTd>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => Navigation.NavigateTo($"/pay/runs/{RunId}/employee/{context.Employee.Id}"))">
                        @L.Translate("DescriptionLabel")
                    </MudButton>
                    @* กันออก/เอากลับ — ก่อนอนุมัติเท่านั้น (audit M11: เดิม IsExcluded ไม่มีปุ่มเขียนเลย) *@
                    @if (_run is not null && _run.Status < PayrollRunStatus.Approved && _rights?.CanEdit == true)
                    {
                        @if (context.Employee.IsExcluded)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Class="ml-1">กันออก: @context.Employee.ExcludeReason</MudChip>
                            <MudButton Size="Size.Small" Variant="Variant.Text" Class="ml-1" Disabled="_busy"
                                       OnClick="@(() => SetExclusionAsync(context.Employee.Id, false, null))">เอากลับเข้ารอบ</MudButton>
                        }
                        else if (_excludeTargetId == context.Employee.Id)
                        {
                            <MudTextField T="string" @bind-Value="_excludeReason" Placeholder="เหตุผลที่กันออก" Immediate="true"
                                          Margin="Margin.Dense" Variant="Variant.Outlined" Class="ml-1" Style="max-width:220px;display:inline-flex" />
                            <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Filled" Class="ml-1" Disabled="_busy"
                                       OnClick="@(() => SetExclusionAsync(context.Employee.Id, true, _excludeReason))">ยืนยันกันออก</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => _excludeTargetId = null)">ยกเลิก</MudButton>
                        }
                        else
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" Class="ml-1" Disabled="_busy"
                                       OnClick="@(() => { _excludeTargetId = context.Employee.Id; _excludeReason = null; })">กันออก</MudButton>
                        }
                    }
                </MudTd>
            </RowTemplate>
            <PagerContent><MudTablePager PageSizeOptions="new[] { 25, 50, 100, 200 }" /></PagerContent>
            <NoRecordsContent>
                <MudText>@L.Translate("NotCalculatedYetMessage")</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>

    @if (_bankFileBatches.Count > 0)
    {
        <MudPaper Class="pa-4 mt-4">
            <MudText Typo="Typo.h6" Class="mb-2">@L.Translate("BankFilesGeneratedHeading")</MudText>
            <MudTable Items="_bankFileBatches" Hover="true" Dense="true">
                <HeaderContent>
                    <MudTh>@L.Translate("ColGeneratedDate")</MudTh>
                    <MudTh>@L.Translate("ColRecordCount")</MudTh>
                    <MudTh>@L.Translate("ColTotalAmount")</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.GeneratedDate.ToString("dd/MM/yyyy HH:mm")</MudTd>
                    <MudTd>@context.TotalRecordCount</MudTd>
                    <MudTd>@context.TotalAmount.ToString("N2")</MudTd>
                    <MudTd><MudLink Href="@($"/pay/files/bank-export/{context.Id}")" Target="_blank">@L.Translate("DownloadButton")</MudLink></MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    }

    @if (_glExportBatches.Count > 0)
    {
        <MudPaper Class="pa-4 mt-4">
            <MudText Typo="Typo.h6" Class="mb-2">@L.Translate("GLFilesGeneratedHeading")</MudText>
            <MudTable Items="_glExportBatches" Hover="true" Dense="true">
                <HeaderContent>
                    <MudTh>@L.Translate("ColGeneratedDate")</MudTh>
                    <MudTh>@L.Translate("ColTotalDebit")</MudTh>
                    <MudTh>@L.Translate("ColTotalCredit")</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.GeneratedDate.ToString("dd/MM/yyyy HH:mm")</MudTd>
                    <MudTd>@context.TotalDebit.ToString("N2")</MudTd>
                    <MudTd>@context.TotalCredit.ToString("N2")</MudTd>
                    <MudTd><MudLink Href="@($"/pay/files/gl-export/{context.Id}")" Target="_blank">@L.Translate("DownloadButton")</MudLink></MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    }
}

@code {
    [Parameter] public long RunId { get; set; }

    private Pay_PayrollRun? _run;
    private bool _forbidden;
    private IReadOnlySet<PayrollAction> _allowed = new HashSet<PayrollAction>();
    private bool _busy;

    // Background-calc observer state (Phase A). Polled from the singleton
    // registry so it survives this page being closed and reopened.
    private bool _calcRunning;
    private int _calcDone;
    private int _calcTotal;
    private double _calcPercent;
    private System.Threading.Timer? _calcPoll;

    // Anomaly (ML) analysis runs as a second phase after the calculation is Done.
    private bool _anomalyPending;
    // A first-ever run with no baseline can flag 10k+ anomalies; rendering them all
    // freezes the browser. Show the worst N, the count tells HR the true size.
    private const int AnomalyDisplayCap = 50;

    // #2 reversal of a Posted/Paid run
    private bool _showReverse;
    private string _reverseReason = "";

    // Phase B pre-flight / holds
    private PayrollPreflightService.Report? _preflight;
    private bool _preflightBusy;
    private string _holdReason = "";
    private string _holdEmpNo = "";

    private int _negativeCount;
    private int _pendingAdhocCount;
    private int _unconsumedApprovedAdhocCount;
    private bool _canGenerateDocuments;
    private bool _canGenerateGL;
    private PayslipGenerationResult? _payslipSummary;
    private List<Pay_PayrollAnomaly> _anomalies = new();
    private List<Pay_PayrollRun> _pastRuns = new();
    private long? _selectedBaselineRunId;
    private Dictionary<long, long> _payslipIdByEmployeeId = new();
    private readonly HashSet<long> _sendingPayslipIds = new();

    // HR-initiated payslip email — an employee asks for their slip, HR sends
    // it to the email on file. Shares PayslipEmailService with the ESS
    // self-send so both stay identical (file name, audit, email resolution).
    private async Task SendPayslipToEmployeeAsync(long payslipId)
    {
        _sendingPayslipIds.Add(payslipId);
        try
        {
            var result = await PayslipEmailService.SendToEmployeeAsync(payslipId, "HR ส่งจากหน้ารอบเงินเดือน");
            if (result.Success)
                Snackbar.Add($"ส่งสลิปไปที่ {result.Email} แล้ว", Severity.Success);
            else
                Snackbar.Add(result.ErrorReason ?? "ส่งอีเมลไม่สำเร็จ", Severity.Error);
        }
        finally
        {
            _sendingPayslipIds.Remove(payslipId);
        }
    }
    private List<Pay_BankFileExportBatch> _bankFileBatches = new();
    private List<Pay_GLExportBatch> _glExportBatches = new();

    private record EmployeeRow(Pay_PayrollEmployee Employee);
    private List<EmployeeRow> _employees = new();

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
        // Resume observing a calculation that is already in flight for this run
        // (started from this page earlier, another tab, or another user).
        if (CalcJobs.IsRunning(RunId)) StartCalcPolling();
    }

    private async Task LoadAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();

        _run = await context.Pay_PayrollRuns.FirstOrDefaultAsync(r => r.Id == RunId);
        if (_run is null) return;

        // One sc_user resolves to exactly one company via empid ->
        // Hremployee.EmpNo — see PayrollCompanyResolver. A run for any
        // other company is treated as inaccessible, not just hidden from
        // lists (defends direct-URL access, not just navigation).
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var companyId = authState.User.FindFirstValue("payroll_company");
        if (_run.CompanyId != companyId)
        {
            _forbidden = true;
            _run = null;
            return;
        }
        // AD.CRUDManage: สิทธิ์ต่อบทบาทของหน้านี้ (ปุ่มดำเนินการ = Edit, ยกเลิกรอบ = Delete)
        _rights = await ProgramRoles.GetRightsAsync(authState.User, ProgramPath);
        // PDPA: หน้านี้แสดงเงินเดือนสุทธิของทั้งบริษัท — บันทึกการเปิดดูทุกครั้ง (audit M15)
        await AuditLogger.LogAccessAsync("Pay_PayrollRun", RunId.ToString(), isSensitive: true, note: "view run detail");

        var employees = await context.Pay_PayrollEmployees
            .Include(e => e.Hremployee)
            .Where(e => e.PayrollRunId == RunId)
            .OrderBy(e => e.EmpNo)
            .ToListAsync();

        _employees = employees.Select(e => new EmployeeRow(e)).ToList();
        _negativeCount = employees.Count(e => e.IsNegativeNetPayFlag && !e.IsExcluded);
        _allowed = PayrollWorkflowService.GetAllowedActions(_run);

        _pendingAdhocCount = await context.Pay_AdhocPayItems
            .CountAsync(a => a.TargetPeriod == _run.PayrollPeriod
                && a.Hremployee.companyid == _run.CompanyId
                && a.Status == PayAdhocItemStatus.Pending);
        _unconsumedApprovedAdhocCount = await context.Pay_AdhocPayItems
            .CountAsync(a => a.TargetPeriod == _run.PayrollPeriod
                && a.Hremployee.companyid == _run.CompanyId
                && a.Status == PayAdhocItemStatus.Approved);

        _canGenerateDocuments = _run.Status >= PayrollRunStatus.Approved && _run.Status != PayrollRunStatus.Cancelled;
        _canGenerateGL = _run.Status >= PayrollRunStatus.Posted && _run.Status != PayrollRunStatus.Cancelled;

        _payslipIdByEmployeeId = await context.Pay_Payslips
            .Where(p => employees.Select(e => e.Id).Contains(p.PayrollEmployeeId))
            .ToDictionaryAsync(p => p.PayrollEmployeeId, p => p.Id);

        _bankFileBatches = await context.Pay_BankFileExportBatches
            .Where(b => b.PayrollRunId == RunId)
            .OrderByDescending(b => b.GeneratedDate)
            .ToListAsync();
        _glExportBatches = await context.Pay_GLExportBatches
            .Where(b => b.PayrollRunId == RunId)
            .OrderByDescending(b => b.GeneratedDate)
            .ToListAsync();

        _anomalies = await context.Pay_PayrollAnomalies
            .Where(a => a.PayrollRunId == RunId)
            .OrderByDescending(a => a.Severity)
            .ToListAsync();

        // For the "compare against this period instead" dropdown — any other
        // non-cancelled run for this company, regardless of RunType, newest
        // first. Excludes the current run itself.
        _pastRuns = await context.Pay_PayrollRuns
            .Where(r => r.CompanyId == _run.CompanyId && r.Id != RunId && r.Status != PayrollRunStatus.Cancelled)
            .OrderByDescending(r => r.PeriodStart)
            .ToListAsync();
    }

    private async Task RerunAnomalyDetectionAsync()
    {
        _busy = true;
        try
        {
            DateOnly? compareAsOf = _selectedBaselineRunId is long baselineId
                ? _pastRuns.FirstOrDefault(r => r.Id == baselineId)?.PeriodStart
                : null;

            await AnomalyDetectionService.DetectAnomaliesAsync(RunId, compareAsOf);
            await LoadAsync();
            Snackbar.Add(L.Translate("AnomalyRerunSuccess"), Severity.Success);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task AcknowledgeAnomalyAsync(long anomalyId)
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var anomaly = await context.Pay_PayrollAnomalies.FirstOrDefaultAsync(a => a.Id == anomalyId);
        if (anomaly is null) return;

        anomaly.IsAcknowledged = true;
        anomaly.AcknowledgedByUserId = await GetCurrentUserIdAsync();
        anomaly.AcknowledgedDate = DateTime.Now;
        await context.SaveChangesAsync();

        await LoadAsync();
        Snackbar.Add(L.Translate("AcknowledgedSuccess"), Severity.Success);
    }

    private string BoldItemCount(int count) => $"<b>{string.Format(L.Translate("AdhocItemCountUnit"), count)}</b>";

    private async Task<long> GetCurrentUserIdAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        var idClaim = state.User.FindFirstValue("sc_userid");
        return long.TryParse(idClaim, out var id) ? id : 0;
    }

    // AD.CRUDManage: ทุกปุ่มที่เปลี่ยนสถานะรอบต้องมีสิทธิ์ Edit ของ /pay/runs (ยกเลิก = Delete)
    // ตรวจฝั่งเซิร์ฟเวอร์ทุกครั้ง ไม่ใช่แค่ซ่อนปุ่ม (audit H6)
    private const string ProgramPath = "/pay/runs";
    private ProgramRoleService.ProgramRights? _rights;

    private async Task<bool> RequireRightAsync(ProgramRoleService.ProgramAction action)
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        try { await ProgramRoles.RequireAsync(state.User, ProgramPath, action); return true; }
        catch (InvalidOperationException ex) { Snackbar.Add(ex.Message, Severity.Warning); return false; }
    }

    private async Task RunActionAsync(Func<long, Task> action, string successMessage,
        ProgramRoleService.ProgramAction right = ProgramRoleService.ProgramAction.Edit)
    {
        if (!await RequireRightAsync(right)) return;
        _busy = true;
        try
        {
            var actorUserId = await GetCurrentUserIdAsync();
            await action(actorUserId);
            await LoadAsync();
            Snackbar.Add(successMessage, Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    // Phase A: start the calculation as a detached SERVER job and just observe
    // it. Closing this page no longer cancels a half-finished run — the job
    // has its own DI scope + DbContext and is driven by CancellationToken.None.
    private async Task CalculateAsync()
    {
        if (!await RequireRightAsync(ProgramRoleService.ProgramAction.Edit)) return;
        try
        {
            // Phase B: if the last pre-flight found blocking errors or unapproved
            // period items, make HR confirm — those items will be excluded/wrong.
            if (_preflight is not null && !_preflight.ReadyToCalculate)
            {
                var msg = $"Pre-flight พบ: ผิดพลาด {_preflight.ErrorCount} รายการ, รออนุมัติ {_preflight.PendingApprovals.Count} รายการ (จะไม่ถูกนำมาคำนวณ) — ต้องการคำนวณต่อเลยหรือไม่?";
                var go = await DialogService.ShowMessageBox("ข้อมูลยังไม่พร้อมทั้งหมด", msg, yesText: "คำนวณต่อ", cancelText: "กลับไปแก้ก่อน");
                if (go != true) return;
            }
            var uid = await GetCurrentUserIdAsync();
            var started = await CalcJobService.StartAsync(RunId, uid);
            if (!started)
                Snackbar.Add("กำลังคำนวณรอบนี้อยู่แล้ว — แสดงความคืบหน้าให้", Severity.Info);
            StartCalcPolling();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task RunPreflightAsync()
    {
        _preflightBusy = true;
        try { _preflight = await Preflight.CheckAsync(RunId); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _preflightBusy = false; }
    }

    private async Task HoldEmployeeAsync(long hremployeeId)
    {
        if (string.IsNullOrWhiteSpace(_holdReason)) { Snackbar.Add("กรุณาใส่เหตุผลการ hold ก่อน", Severity.Warning); return; }
        try
        {
            await Preflight.HoldAsync(RunId, hremployeeId, _holdReason, await GetCurrentUserIdAsync());
            Snackbar.Add("hold พนักงานแล้ว — จะถูกข้ามในรอบนี้", Severity.Success);
            await RunPreflightAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task HoldByEmpNoAsync()
    {
        if (_run is null) return;
        if (string.IsNullOrWhiteSpace(_holdEmpNo) || string.IsNullOrWhiteSpace(_holdReason)) { Snackbar.Add("ใส่รหัสพนักงานและเหตุผล", Severity.Warning); return; }
        try
        {
            var ok = await Preflight.HoldByEmpNoAsync(RunId, _run.CompanyId, _holdEmpNo, _holdReason, await GetCurrentUserIdAsync());
            Snackbar.Add(ok ? $"hold {_holdEmpNo} แล้ว" : $"ไม่พบพนักงาน {_holdEmpNo} ในบริษัทนี้", ok ? Severity.Success : Severity.Error);
            if (ok) { _holdEmpNo = ""; await RunPreflightAsync(); }
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task ReleaseHoldAsync(long holdId)
    {
        try { await Preflight.ReleaseAsync(holdId, await GetCurrentUserIdAsync()); Snackbar.Add("ปล่อย hold แล้ว", Severity.Success); await RunPreflightAsync(); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private void StartCalcPolling()
    {
        _calcRunning = true;
        _calcDone = 0; _calcTotal = 0; _calcPercent = 0;
        _calcPoll?.Dispose();
        // Timer fires on a thread-pool thread — every UI touch must go through
        // InvokeAsync so Blazor re-renders on its own dispatcher.
        _calcPoll = new System.Threading.Timer(_ => _ = InvokeAsync(PollCalcAsync), null, 0, 1000);
    }

    private async Task PollCalcAsync()
    {
        var state = CalcJobs.Get(RunId);
        if (state is null || state.Status == PayrollCalcJobRegistry.JobStatus.Running)
        {
            if (state is not null) { _calcDone = state.Done; _calcTotal = state.Total; _calcPercent = state.Percent; }
            StateHasChanged();
            return;
        }

        // Calculation finished (Done or Failed). Show the numbers right away;
        // the ML anomaly pass may still be running as a second phase — keep a
        // light poll going until it ends, then refresh the anomaly list.
        if (_calcRunning)
        {
            _calcRunning = false;
            if (state.Status == PayrollCalcJobRegistry.JobStatus.Done)
                Snackbar.Add(L.Translate("CalculatedSuccess"), Severity.Success);
            else
                Snackbar.Add($"คำนวณไม่สำเร็จ: {state.Error}", Severity.Error);
            await SafeReloadAsync();
        }

        if (state.AnomalyRunning)
        {
            _anomalyPending = true;
            StateHasChanged();
            return;
        }

        _calcPoll?.Dispose(); _calcPoll = null;
        CalcJobs.Clear(RunId);
        if (_anomalyPending)
        {
            _anomalyPending = false;
            Snackbar.Add("ตรวจหาความผิดปกติ (AI) เสร็จแล้ว", Severity.Info);
            await SafeReloadAsync();
        }
        StateHasChanged();
    }

    // The poll runs inside a timer callback: an exception there (typically a
    // 30 s SQL timeout while another 7,000-employee run is calculating on the
    // same server) would otherwise escape unobserved and leave the page frozen
    // in its last state. Report it and let the user refresh instead.
    private async Task SafeReloadAsync()
    {
        try { await LoadAsync(); }
        catch (Exception ex)
        {
            Snackbar.Add($"โหลดข้อมูลรอบไม่สำเร็จ (เซิร์ฟเวอร์กำลังทำงานหนัก): {ex.GetBaseException().Message} — กด Refresh หน้าอีกครั้ง", Severity.Warning);
        }
        StateHasChanged();
    }

    public void Dispose()
    {
        // Only the OBSERVER stops here — the background job itself keeps running.
        _calcPoll?.Dispose();
        _calcPoll = null;
    }

    private long? _excludeTargetId;
    private string? _excludeReason;

    private Task SetExclusionAsync(long payrollEmployeeId, bool excluded, string? reason) => RunActionAsync(
        async uid =>
        {
            await WorkflowService.SetEmployeeExclusionAsync(RunId, payrollEmployeeId, excluded, reason, uid);
            _excludeTargetId = null;
        },
        excluded ? "กันพนักงานออกจากรอบแล้ว — ยอดสุทธิของรอบไม่รวมคนนี้" : "เอาพนักงานกลับเข้ารอบแล้ว");

    private Task SubmitForReviewAsync() => RunActionAsync(
        async uid => await WorkflowService.SubmitForReviewAsync(RunId, uid),
        L.Translate("SubmittedForReviewSuccess"));

    private async Task ApproveAsync()
    {
        var confirmed = await DialogService.ShowMessageBox(
            L.Translate("ConfirmApproveTitle"), L.Translate("ConfirmApproveMessage"),
            yesText: L.Translate("ApproveButton"), cancelText: L.Translate("CancelButton"));
        if (confirmed != true) return;

        await RunActionAsync(async uid => await WorkflowService.ApproveAsync(RunId, uid, null), L.Translate("ApprovedSuccess"));
    }

    private Task PostAsync() => RunActionAsync(
        async uid => await WorkflowService.PostAsync(RunId, uid),
        L.Translate("PostedSuccess"));

    private Task MarkPaidAsync() => RunActionAsync(
        async uid => await WorkflowService.MarkPaidAsync(RunId, uid),
        L.Translate("MarkedPaidSuccess"));

    private async Task CancelAsync()
    {
        var confirmed = await DialogService.ShowMessageBox(
            L.Translate("ConfirmCancelRunTitle"), L.Translate("ConfirmCancelRunMessage"), yesText: L.Translate("CancelRunButton"), cancelText: L.Translate("BackButton"));
        if (confirmed != true) return;

        await RunActionAsync(async uid => await WorkflowService.CancelAsync(RunId, uid, "Cancelled by user"), L.Translate("RunCancelledSuccess"),
            ProgramRoleService.ProgramAction.Delete);
    }

    private async Task ReverseRunAsync()
    {
        if (!await RequireRightAsync(ProgramRoleService.ProgramAction.Edit)) return;
        _busy = true;
        try
        {
            var actorUserId = await GetCurrentUserIdAsync();
            var newRunId = await WorkflowService.CreateReversalRunAsync(RunId, actorUserId, _reverseReason);
            Snackbar.Add($"สร้างรอบกลับรายการ #{newRunId} แล้ว — รอบเดิม #{RunId} ไม่ถูกแก้", Severity.Success);
            Navigation.NavigateTo($"/pay/runs/{newRunId}");
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CreateAdjustmentAsync()
    {
        if (!await RequireRightAsync(ProgramRoleService.ProgramAction.Edit)) return;
        _busy = true;
        try
        {
            var actorUserId = await GetCurrentUserIdAsync();
            var newRunId = await WorkflowService.CreateAdjustmentRunAsync(RunId, actorUserId);
            Navigation.NavigateTo($"/pay/runs/{newRunId}");
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task GeneratePayslipsAsync()
    {
        _busy = true;
        try
        {
            _payslipSummary = await PayslipGenerationService.GenerateAsync(RunId);
            await LoadAsync();
            Snackbar.Add(string.Format(L.Translate("PayslipGenerateSuccessTemplate"), _payslipSummary.Generated), Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private Task GenerateBankFileAsync() => RunActionAsync(
        async uid => await BankFileExportService.ExportAsync(RunId, uid),
        L.Translate("BankFileGeneratedSuccess"));

    private Task GenerateGLExportAsync() => RunActionAsync(
        async uid => await GLExportService.ExportAsync(RunId, uid),
        L.Translate("GLGeneratedSuccess"));

    private static Color StatusColor(PayrollRunStatus status) => status switch
    {
        PayrollRunStatus.Draft => Color.Default,
        PayrollRunStatus.Calculated => Color.Info,
        PayrollRunStatus.Reviewed => Color.Warning,
        PayrollRunStatus.Approved => Color.Tertiary,
        PayrollRunStatus.Posted => Color.Secondary,
        PayrollRunStatus.Paid => Color.Success,
        PayrollRunStatus.Cancelled => Color.Error,
        _ => Color.Default,
    };

    private string StatusLabel(PayrollRunStatus status) => L.Translate("PayrollStatus_" + status);
    private string RunTypeLabel(PayrollRunType type) => L.Translate("PayrollRunType_" + type);

    // The 6-step happy-path progression (Cancelled is a terminal exit, not a
    // step on this track — shown as its own alert instead, see markup).
    private static readonly PayrollRunStatus[] _stepTrack =
    {
        PayrollRunStatus.Draft, PayrollRunStatus.Calculated, PayrollRunStatus.Reviewed,
        PayrollRunStatus.Approved, PayrollRunStatus.Posted, PayrollRunStatus.Paid,
    };

    private Color StepColor(PayrollRunStatus step)
    {
        if (_run is null) return Color.Default;
        if (_run.Status == PayrollRunStatus.Cancelled) return Color.Default;
        if ((int)step < (int)_run.Status) return Color.Success;   // already passed
        if (step == _run.Status) return StatusColor(step);         // current
        return Color.Default;                                       // not reached yet
    }

    private static Color AnomalySeverityColor(PayrollAnomalySeverity severity) => severity switch
    {
        PayrollAnomalySeverity.Info => Color.Info,
        PayrollAnomalySeverity.Warning => Color.Warning,
        PayrollAnomalySeverity.Critical => Color.Error,
        _ => Color.Default,
    };
}
