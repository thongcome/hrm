    private static Color StatusColor(PayrollRunStatus status) => status switch
    {
        PayrollRunStatus.Draft => Color.Default,
        PayrollRunStatus.Calculated => Color.Info,
        PayrollRunStatus.Reviewed => Color.Warning,
        PayrollRunStatus.Approved => Color.Tertiary,
        PayrollRunStatus.Posted => Color.Secondary,
        PayrollRunStatus.Paid => Color.Success,
        PayrollRunStatus.Cancelled => Color.Error,
        _ => Color.Default,
    };

    private string StatusLabel(PayrollRunStatus status) => L.Translate("PayrollStatus_" + status);
    private string RunTypeLabel(PayrollRunType type) => L.Translate("PayrollRunType_" + type);

    // The 6-step happy-path progression (Cancelled is a terminal exit, not a
    // step on this track — shown as its own alert instead, see markup).
    private static readonly PayrollRunStatus[] _stepTrack =
    {
        PayrollRunStatus.Draft, PayrollRunStatus.Calculated, PayrollRunStatus.Reviewed,
        PayrollRunStatus.Approved, PayrollRunStatus.Posted, PayrollRunStatus.Paid,
    };

    private Color StepColor(PayrollRunStatus step)
    {
        if (_run is null) return Color.Default;
        if (_run.Status == PayrollRunStatus.Cancelled) return Color.Default;
        if ((int)step < (int)_run.Status) return Color.Success;   // already passed
        if (step == _run.Status) return StatusColor(step);         // current
        return Color.Default;                                       // not reached yet
    }

    private static Color AnomalySeverityColor(PayrollAnomalySeverity severity) => severity switch
    {
        PayrollAnomalySeverity.Info => Color.Info,
        PayrollAnomalySeverity.Warning => Color.Warning,
        PayrollAnomalySeverity.Critical => Color.Error,
        _ => Color.Default,
    };
}
