@page "/pay/employees/{HremployeeId:long}/lifecycle"
@layout PayrollEmployeeHubLayout
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Audit
@using HRM.Services.Hrd
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@inject LifecycleTaskService LifecycleService
@inject IAuditLogger AuditLogger
@inject JsonLocalizationService L
@attribute [Authorize(Policy = "Menu:PAY_ADMIN")]

<PageTitle>@L.Translate("OnboardingOffboardingNavLabel")</PageTitle>

@if (_notFound)
{
    <MudAlert Severity="Severity.Warning">@L.Translate("EmployeeDataNotFoundOrOutsideCompanyError")</MudAlert>
}
else if (_employee is null)
{
    <MudText>@L.Translate("LoadingText")</MudText>
}
else
{
    <MudPaper Class="pa-4 mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudText Typo="Typo.h6">@L.Translate("ProbationOnboardOffboardHeading")</MudText>
            <MudChip T="string" Color="Color.Warning" Size="Size.Small">PDPA</MudChip>
        </MudStack>

        <MudDivider Class="my-3" />

        <MudText Typo="Typo.subtitle1">@L.Translate("ProbationSubheading")</MudText>
        @if (_employee.WorkDate is null)
        {
            <MudAlert Severity="Severity.Info" Class="mt-2">@L.Translate("NoWorkDateInfo")</MudAlert>
        }
        else if (_employee.ProbationConfirmedDate is not null)
        {
            <MudChip T="string" Color="Color.Success" Size="Size.Small" Class="mt-2">
                @string.Format(L.Translate("ProbationPassedChipTemplate"), _employee.ProbationConfirmedDate.Value.ToString("dd/MM/yyyy"))
            </MudChip>
        }
        else
        {
            <MudGrid Class="mt-1">
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.body2">@string.Format(L.Translate("WorkDateColonTemplate"), _employee.WorkDate.Value.ToString("dd/MM/yyyy"))</MudText>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudDatePicker Date="_probationEndDate" DateChanged="@(d => _probationEndDate = d)"
                        Label="@L.Translate("ProbationEndDateLabel")" Editable="true" DateFormat="dd/MM/yyyy" />
                </MudItem>
                <MudItem xs="12" sm="4" Class="d-flex align-center">
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ConfirmProbationAsync">@L.Translate("ConfirmProbationButton")</MudButton>
                </MudItem>
            </MudGrid>
        }
    </MudPaper>

    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.subtitle1">@L.Translate("OnboardingChecklistHeading")</MudText>
        @RenderChecklist(_onboardingTasks, LifecycleTaskDirection.Onboarding)
    </MudPaper>

    @if (_employee.ResignDate is not null)
    {
        <MudPaper Class="pa-4 mb-4">
            <MudText Typo="Typo.subtitle1">@L.Translate("OffboardingChecklistHeading")</MudText>
            <MudText Typo="Typo.body2" Class="mb-2">@string.Format(L.Translate("ResignDateColonTemplate"), _employee.ResignDate.Value.ToString("dd/MM/yyyy"))</MudText>
            @RenderChecklist(_offboardingTasks, LifecycleTaskDirection.Offboarding)
        </MudPaper>

        <MudPaper Class="pa-4 mb-4">
            <MudText Typo="Typo.subtitle1">@L.Translate("ExitInterviewHeading")</MudText>

            @if (_latestExitInterview is not null)
            {
                <MudAlert Severity="Severity.Info" Class="mt-2">
                    @string.Format(L.Translate("LatestExitInterviewTemplate"), _latestExitInterview.InterviewDate.ToString("dd/MM/yyyy"), ReasonLabel(_latestExitInterview.ReasonCode))
                </MudAlert>
            }

            <MudGrid Class="mt-2">
                <MudItem xs="12" sm="4">
                    <MudDatePicker Date="_interviewDate" DateChanged="@(d => _interviewDate = d)" Label="@L.Translate("InterviewDateLabel")" Editable="true" DateFormat="dd/MM/yyyy" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect T="ExitReasonCode" @bind-Value="_reasonCode" Label="@L.Translate("MainReasonLabel")">
                        @foreach (ExitReasonCode reason in Enum.GetValues<ExitReasonCode>())
                        {
                            <MudSelectItem Value="reason">@ReasonLabel(reason)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSwitch T="bool?" Value="_wouldRecommend" ValueChanged="@(v => _wouldRecommend = v)" Label="@L.Translate("WouldRecommendCompanyLabel")" Color="Color.Primary" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_reasonNote" Label="@L.Translate("ReasonDetailOptionalLabel")" Lines="2" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_feedback" Label="@L.Translate("FeedbackSuggestionsLabel")" Lines="2" />
                </MudItem>
            </MudGrid>

            <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="mt-3" OnClick="SaveExitInterviewAsync">@L.Translate("SaveInterviewResultButton")</MudButton>
        </MudPaper>
    }
}

@code {
    [Parameter] public long HremployeeId { get; set; }

    private Hremployee? _employee;
    private bool _notFound;
    private string? _companyId;
    private int _defaultProbationDays = 119;

    private DateTime? _probationEndDate;

    private List<Hrd_LifecycleTaskInstance> _onboardingTasks = new();
    private List<Hrd_LifecycleTaskInstance> _offboardingTasks = new();

    private Hrd_ExitInterview? _latestExitInterview;
    private DateTime? _interviewDate = DateTime.Today;
    private ExitReasonCode _reasonCode = ExitReasonCode.Other;
    private string? _reasonNote;
    private bool? _wouldRecommend;
    private string? _feedback;

    private readonly Dictionary<long, string> _newAdHocTitle = new();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");

        await using var context = await DbFactory.CreateDbContextAsync();

        _employee = await context.Hremployee.FirstOrDefaultAsync(e => e.id == HremployeeId && e.companyid == _companyId);
        if (_employee is null)
        {
            _notFound = true;
            return;
        }

        var settings = await context.Pay_PayslipSettings.FirstOrDefaultAsync(s => s.CompanyId == _companyId);
        if (settings is not null) _defaultProbationDays = settings.DefaultProbationDays;

        _probationEndDate = _employee.ProbationEndDate
            ?? (_employee.WorkDate is DateTime workDate ? LifecycleTaskService.ResolveSuggestedProbationEndDate(workDate, _defaultProbationDays) : null);

        await LoadTasksAsync();
        await LoadExitInterviewAsync();

        await AuditLogger.LogAccessAsync("Hremployee", HremployeeId.ToString(), isSensitive: true, note: "lifecycle tab view");
    }

    private async Task LoadTasksAsync()
    {
        _onboardingTasks = await LifecycleService.GetTasksAsync(HremployeeId, LifecycleTaskDirection.Onboarding);
        _offboardingTasks = await LifecycleService.GetTasksAsync(HremployeeId, LifecycleTaskDirection.Offboarding);
    }

    private async Task LoadExitInterviewAsync()
    {
        _latestExitInterview = await LifecycleService.GetLatestExitInterviewAsync(HremployeeId);
    }

    private async Task<long> GetActorUserIdAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        var claim = state.User.FindFirstValue("sc_userid");
        return long.TryParse(claim, out var uid) ? uid : 0;
    }

    private async Task ConfirmProbationAsync()
    {
        if (_probationEndDate is null)
        {
            Snackbar.Add(L.Translate("SpecifyProbationEndDateError"), Severity.Warning);
            return;
        }
        var actorUserId = await GetActorUserIdAsync();
        await LifecycleService.ConfirmProbationAsync(HremployeeId, actorUserId, _probationEndDate.Value);
        Snackbar.Add(L.Translate("ProbationConfirmedSuccess"), Severity.Success);

        await using var context = await DbFactory.CreateDbContextAsync();
        _employee = await context.Hremployee.FirstOrDefaultAsync(e => e.id == HremployeeId);
    }

    private async Task StartAsync(LifecycleTaskDirection direction)
    {
        var actorUserId = await GetActorUserIdAsync();
        if (direction == LifecycleTaskDirection.Onboarding)
            await LifecycleService.StartOnboardingAsync(HremployeeId, actorUserId);
        else
            await LifecycleService.StartOffboardingAsync(HremployeeId, actorUserId);

        await LoadTasksAsync();
        Snackbar.Add(L.Translate("StartChecklistSuccess"), Severity.Success);
    }

    private async Task CompleteAsync(long taskId)
    {
        var actorUserId = await GetActorUserIdAsync();
        await LifecycleService.CompleteTaskAsync(taskId, actorUserId, null);
        await LoadTasksAsync();
    }

    private async Task SkipAsync(long taskId)
    {
        var actorUserId = await GetActorUserIdAsync();
        await LifecycleService.SkipTaskAsync(taskId, actorUserId, null);
        await LoadTasksAsync();
    }

    private async Task ReopenAsync(long taskId)
    {
        await LifecycleService.ReopenTaskAsync(taskId);
        await LoadTasksAsync();
    }

    private async Task AddAdHocAsync(LifecycleTaskDirection direction)
    {
        var key = (long)direction;
        if (!_newAdHocTitle.TryGetValue(key, out var title) || string.IsNullOrWhiteSpace(title))
        {
            Snackbar.Add(L.Translate("SpecifyTaskTitleError"), Severity.Warning);
            return;
        }

        var actorUserId = await GetActorUserIdAsync();
        await LifecycleService.AddAdHocTaskAsync(HremployeeId, direction, title, null, actorUserId);
        _newAdHocTitle[key] = "";
        await LoadTasksAsync();
    }

    private async Task SaveExitInterviewAsync()
    {
        if (_interviewDate is null)
        {
            Snackbar.Add(L.Translate("SpecifyInterviewDateError"), Severity.Warning);
            return;
        }

        var actorUserId = await GetActorUserIdAsync();
        await LifecycleService.RecordExitInterviewAsync(HremployeeId, actorUserId, _interviewDate.Value,
            _reasonCode, _reasonNote, _wouldRecommend, _feedback);
        Snackbar.Add(L.Translate("ExitInterviewSavedSuccess"), Severity.Success);

        _reasonNote = null;
        _feedback = null;
        _wouldRecommend = null;
        await LoadExitInterviewAsync();
    }

    private string ReasonLabel(ExitReasonCode code) => code switch
    {
        ExitReasonCode.BetterOpportunity => L.Translate("ExitReasonBetterOpportunity"),
        ExitReasonCode.Compensation => L.Translate("ExitReasonCompensation"),
        ExitReasonCode.Relocation => L.Translate("ExitReasonRelocation"),
        ExitReasonCode.PersonalHealth => L.Translate("ExitReasonPersonalHealth"),
        ExitReasonCode.FamilyReason => L.Translate("ExitReasonFamilyReason"),
        ExitReasonCode.Retirement => L.Translate("ExitReasonRetirement"),
        ExitReasonCode.Termination => L.Translate("ExitReasonTermination"),
        _ => L.Translate("DocTypeOther"),
    };

    private RenderFragment RenderChecklist(List<Hrd_LifecycleTaskInstance> tasks, LifecycleTaskDirection direction) => @<text>
        @if (tasks.Count == 0)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="mt-2"
                OnClick="@(() => StartAsync(direction))">
                @(direction == LifecycleTaskDirection.Onboarding ? L.Translate("StartOnboardingButton") : L.Translate("StartOffboardingButton"))
            </MudButton>
        }
        else
        {
            var doneCount = tasks.Count(t => t.Status != LifecycleTaskStatus.Pending);
            var percent = tasks.Count == 0 ? 0 : (double)doneCount / tasks.Count * 100;

            <MudText Typo="Typo.body2" Class="mt-1">@string.Format(L.Translate("ProgressColonTemplate"), doneCount, tasks.Count)</MudText>
            <MudProgressLinear Color="Color.Success" Value="percent" Class="my-2" />

            <MudSimpleTable Dense="true">
                <thead>
                    <tr><th>@L.Translate("ColTask")</th><th>@L.Translate("ColStatus")</th><th>@L.Translate("ColCompletedByDate")</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var task in tasks)
                    {
                        <tr>
                            <td>@task.Title</td>
                            <td>@StatusLabel(task.Status)</td>
                            <td>@(task.CompletedDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                            <td>
                                @if (task.Status == LifecycleTaskStatus.Pending)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Success" OnClick="@(() => CompleteAsync(task.Id))">@L.Translate("CompleteButton")</MudButton>
                                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => SkipAsync(task.Id))">@L.Translate("SkipButton")</MudButton>
                                }
                                else
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => ReopenAsync(task.Id))">@L.Translate("ReopenButton")</MudButton>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>

            <MudStack Row="true" Spacing="2" Class="mt-3" AlignItems="AlignItems.Center">
                <MudTextField T="string" Value="@GetAdHocTitle(direction)" ValueChanged="@(v => _newAdHocTitle[(long)direction] = v)" Label="@L.Translate("AddOwnTaskLabel")" Class="flex-grow-1" />
                <MudButton Variant="Variant.Outlined" OnClick="@(() => AddAdHocAsync(direction))">@L.Translate("AddButtonPlain")</MudButton>
            </MudStack>
        }
    </text>;

    private string GetAdHocTitle(LifecycleTaskDirection direction)
        => _newAdHocTitle.TryGetValue((long)direction, out var v) ? v : "";

    private string StatusLabel(LifecycleTaskStatus status) => status switch
    {
        LifecycleTaskStatus.Completed => L.Translate("TaskStatusCompleted"),
        LifecycleTaskStatus.Skipped => L.Translate("SkipButton"),
        _ => L.Translate("TaskStatusPending"),
    };
}
