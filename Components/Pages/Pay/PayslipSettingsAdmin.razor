@page "/pay/admin/payslip-settings"
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Pay
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@attribute [Authorize(Policy = "Menu:PAY_ADMIN")]

<PageTitle>ตั้งค่ารหัสผ่านสลิปเงินเดือน</PageTitle>

<MudPaper Class="pa-4 mb-4" MaxWidth="700px">
    <MudText Typo="Typo.h5">ตั้งค่ารหัสผ่านสลิปเงินเดือน (PDF)</MudText>
    <MudText Typo="Typo.body2" Class="mt-1">
        รหัสผ่านจะถูกคำนวณจากข้อมูลพนักงานตามรูปแบบนี้ทุกครั้งที่สร้าง/เปิดสลิป — ระบบไม่เก็บรหัสผ่านไว้ที่ไหนเลย
        รูปแบบเดียวกันนี้ยังใช้เป็น<b>รหัสผ่านเริ่มต้นตอนสร้างบัญชีผู้ใช้พนักงาน</b> (หน้า "จัดการพนักงาน" ปุ่ม "สร้างบัญชีผู้ใช้") ด้วย
        เพื่อให้ทั้งสองที่ใช้สูตรเดียวกัน จำง่าย ไม่ต้องจำรหัสแยกกันสองชุด
    </MudText>

    @if (_settings is null)
    {
        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-4">@_error</MudAlert>
        }
        else
        {
            <MudProgressCircular Indeterminate="true" Class="mt-4" />
        }
    }
    else
    {
        <MudDivider Class="my-4" />

        <MudSelect T="string" Value="_selectedPreset" ValueChanged="OnPresetChanged" Label="รูปแบบสำเร็จรูป">
            <MudSelectItem Value="@("{BirthDateDDMMYYYY}")">วันเกิด แบบ วว/ดด/ปปปป (ค.ศ.) เช่น 15031990</MudSelectItem>
            <MudSelectItem Value="@("{BirthDateDDMMYY}")">วันเกิด แบบ วว/ดด/ปป เช่น 150390</MudSelectItem>
            <MudSelectItem Value="@("{IdCardLast4}")">เลขบัตรประชาชน 4 ตัวท้าย</MudSelectItem>
            <MudSelectItem Value="@("{IdCardLast4}{EmpNo}")">เลขบัตรประชาชน 4 ตัวท้าย + รหัสพนักงาน</MudSelectItem>
            <MudSelectItem Value="@("{EmpNo}{BirthDateDDMMYY}")">กำหนดเอง (แก้ไขด้านล่าง)</MudSelectItem>
        </MudSelect>

        <MudTextField @bind-Value="_settings.PasswordTemplate" Label="รูปแบบรหัสผ่าน (template)" Class="mt-4"
            HelperText="โทเค็นที่ใช้ได้: {BirthDateDDMMYYYY} {BirthDateDDMMYY} {IdCardLast4} {EmpNo} — ผสมกันได้ เช่น {EmpNo}{BirthDateDDMMYY}" />
        <MudText Typo="Typo.caption" Class="mt-1" Style="opacity:.75;">
            หมายเหตุ: รูปแบบนี้ใช้เฉพาะรหัสผ่านสลิป PDF เท่านั้น — รหัสผ่านเข้าสู่ระบบครั้งแรกของพนักงานตั้งแยกไว้ด้านล่าง (ไม่ขึ้นกับข้อมูลพนักงาน)
        </MudText>

        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
        }

        <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="mt-4" OnClick="SaveAsync">บันทึก</MudButton>

        <MudDivider Class="my-5" />

        <MudText Typo="Typo.h6" Class="mb-2">ข้อมูลบริษัท (สำหรับหนังสือรับรองหักภาษี ณ ที่จ่าย)</MudText>
        <MudText Typo="Typo.body2" Class="mb-2">
            ใช้พิมพ์บนหัวหนังสือรับรองหักภาษี 50 ทวิ — เลขผู้เสียภาษี/ที่อยู่เป็นข้อมูลทางกฎหมายจริง กรุณากรอกให้ถูกต้อง
        </MudText>
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_settings.CompanyName" Label="ชื่อบริษัท (ไทย)" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_settings.CompanyNameEn" Label="ชื่อบริษัท (อังกฤษ)" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_settings.CompanyTaxId" Label="เลขประจำตัวผู้เสียภาษี (13 หลัก)" MaxLength="13" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_settings.CompanyAddress" Label="ที่อยู่บริษัท" Lines="2" />
            </MudItem>
        </MudGrid>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="mt-3" OnClick="SaveCompanyInfoAsync">บันทึกข้อมูลบริษัท</MudButton>

        <MudDivider Class="my-5" />

        <MudText Typo="Typo.h6" Class="mb-2">ปีบัญชี (Fiscal Year)</MudText>
        <MudText Typo="Typo.body2" Class="mb-2">
            กำหนดเดือนเริ่มต้นปีบัญชี ใช้คำนวณช่วง YTD ในแดชบอร์ดเงินเดือน (ค่าเริ่มต้น: มกราคม = ปีปฏิทินปกติ)
        </MudText>
        <MudSelect T="int" @bind-Value="_settings.FiscalYearStartMonth" Label="เดือนเริ่มต้นปีบัญชี" Class="mud-width-full" Style="max-width: 300px;">
            @for (var m = 1; m <= 12; m++)
            {
                var month = m;
                <MudSelectItem T="int" Value="@month">@ThaiMonthName(month)</MudSelectItem>
            }
        </MudSelect>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="mt-3" OnClick="SaveFiscalYearAsync">บันทึกปีบัญชี</MudButton>

        <MudDivider Class="my-5" />

        <MudText Typo="Typo.h6" Class="mb-2">รหัสผ่านเริ่มต้นสำหรับสร้าง/รีเซ็ตบัญชีผู้ใช้พนักงาน</MudText>
        <MudText Typo="Typo.body2" Class="mb-2">
            ใช้ตอนกด "สร้างบัญชีผู้ใช้" หรือ "รีเซ็ตรหัสผ่าน" ในหน้าจัดการพนักงาน — รหัสผ่านจริงคือค่าทั้งสองช่องต่อกันตรงๆ
            (ไม่ขึ้นกับข้อมูลพนักงาน จึงใช้ได้แม้พนักงานยังไม่มีวันเกิด/เลขบัตรในระบบ)
        </MudText>
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_settings.DefaultPasswordPart1" Label="ส่วนที่ 1" Placeholder="เช่น Abcd" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_settings.DefaultPasswordPart2" Label="ส่วนที่ 2" Placeholder="เช่น 2025" />
            </MudItem>
        </MudGrid>
        @if (!string.IsNullOrEmpty(CombinedDefaultPassword))
        {
            @if (DefaultPasswordPolicyError is null)
            {
                <MudAlert Severity="Severity.Success" Class="mt-3">รหัสผ่านที่ได้: <b class="mono">@CombinedDefaultPassword</b></MudAlert>
            }
            else
            {
                <MudAlert Severity="Severity.Error" Class="mt-3">รหัสผ่านที่ได้ "@CombinedDefaultPassword" @DefaultPasswordPolicyError</MudAlert>
            }
        }
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="mt-3" OnClick="SaveDefaultPasswordAsync">บันทึกรหัสผ่านเริ่มต้น</MudButton>

        <MudDivider Class="my-5" />

        <MudText Typo="Typo.h6" Class="mb-2">ทดสอบดูตัวอย่าง</MudText>
        <MudAutocomplete T="Hremployee" Label="เลือกพนักงานเพื่อดูตัวอย่างรหัสผ่าน" @bind-Value="_previewEmployee"
            SearchFunc="SearchEmployeesAsync"
            ToStringFunc="@(e => e == null ? null : $"{e.EmpNo} — {e.EmpName} {e.EmpSurname}")"
            ResetValueOnEmptyText="true" CoerceText="true" MinCharacters="0" />

        @if (_previewEmployee is not null)
        {
            var result = PayslipPasswordService.Resolve(_previewEmployee, _settings.PasswordTemplate);
            @if (result.Success)
            {
                <MudAlert Severity="Severity.Success" Class="mt-3">
                    รหัสผ่านสำหรับ @_previewEmployee.EmpNo — @_previewEmployee.EmpName: <b class="mono">@result.Password</b>
                </MudAlert>
            }
            else
            {
                <MudAlert Severity="Severity.Warning" Class="mt-3">@result.ErrorReason</MudAlert>
            }
        }
    }
</MudPaper>

<style>
    .mono { font-family: ui-monospace, Consolas, monospace; }
</style>

@code {
    private Pay_PayslipSettings? _settings;
    private Hremployee? _previewEmployee;
    private string _selectedPreset = "{BirthDateDDMMYYYY}";
    private string? _error;
    private string? _companyId;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
        if (string.IsNullOrWhiteSpace(_companyId))
        {
            _error = "บัญชีของคุณยังไม่ได้ผูกกับบริษัทใดๆ — ติดต่อแอดมินให้ตั้งค่า empid ก่อน";
            return;
        }

        await using var context = await DbFactory.CreateDbContextAsync();
        _settings = await context.Pay_PayslipSettings.FirstOrDefaultAsync(s => s.CompanyId == _companyId);
        if (_settings is null)
        {
            _settings = new Pay_PayslipSettings { CompanyId = _companyId, PasswordTemplate = "{BirthDateDDMMYYYY}" };
            context.Pay_PayslipSettings.Add(_settings);
            await context.SaveChangesAsync();
        }
        _selectedPreset = PayslipPasswordService.SupportedTokens.Contains(_settings.PasswordTemplate)
            ? _settings.PasswordTemplate
            : "{EmpNo}{BirthDateDDMMYY}";
    }

    private string CombinedDefaultPassword => (_settings?.DefaultPasswordPart1 ?? "") + (_settings?.DefaultPasswordPart2 ?? "");
    private string? DefaultPasswordPolicyError => ValidatePasswordPolicy(CombinedDefaultPassword);

    private void OnPresetChanged(string value)
    {
        _selectedPreset = value;
        if (_settings is not null && value != "{EmpNo}{BirthDateDDMMYY}")
            _settings.PasswordTemplate = value;
    }

    private async Task<IEnumerable<Hremployee>> SearchEmployeesAsync(string search, CancellationToken ct)
    {
        await using var context = await DbFactory.CreateDbContextAsync(ct);
        var query = context.Hremployee.Where(e => e.companyid == _companyId);
        if (!string.IsNullOrWhiteSpace(search))
        {
            query = query.Where(e => e.EmpNo.Contains(search)
                || (e.EmpName != null && e.EmpName.Contains(search))
                || (e.EmpSurname != null && e.EmpSurname.Contains(search)));
        }
        return await query.OrderBy(e => e.EmpNo).Take(20).ToListAsync(ct);
    }

    private async Task SaveAsync()
    {
        _error = null;
        if (_settings is null || string.IsNullOrWhiteSpace(_settings.PasswordTemplate))
        {
            _error = "กรุณากำหนดรูปแบบรหัสผ่าน";
            return;
        }

        await using var context = await DbFactory.CreateDbContextAsync();
        var existing = await context.Pay_PayslipSettings.FirstOrDefaultAsync(s => s.CompanyId == _companyId);
        if (existing is null)
        {
            _error = "ไม่พบการตั้งค่า กรุณาโหลดหน้าใหม่";
            return;
        }

        existing.PasswordTemplate = _settings.PasswordTemplate;
        existing.ModifiedDate = DateTime.Now;
        existing.ModifiedByUserId = await GetCurrentUserIdAsync();
        await context.SaveChangesAsync();

        Snackbar.Add("บันทึกการตั้งค่าเรียบร้อย", Severity.Success);
    }

    // Mirrors ASP.NET Core Identity's default PasswordOptions (never
    // explicitly configured in Program.cs, so the framework default applies:
    // digit + lowercase + uppercase + non-alphanumeric + length >= 6).
    // Checked client-side here so a bad combination is caught when the admin
    // saves it, not the next time HR tries to create an account.
    private static string? ValidatePasswordPolicy(string value)
    {
        if (value.Length < 6) return "— ต้องมีความยาวรวมอย่างน้อย 6 ตัวอักษร";
        if (!value.Any(char.IsDigit)) return "— ต้องมีตัวเลขอย่างน้อย 1 ตัว";
        if (!value.Any(char.IsLower)) return "— ต้องมีอักษรพิมพ์เล็กอย่างน้อย 1 ตัว";
        if (!value.Any(char.IsUpper)) return "— ต้องมีอักษรพิมพ์ใหญ่อย่างน้อย 1 ตัว";
        if (value.All(char.IsLetterOrDigit)) return "— ต้องมีสัญลักษณ์ (เช่น @ ! #) อย่างน้อย 1 ตัว";
        return null;
    }

    private async Task SaveDefaultPasswordAsync()
    {
        _error = null;
        if (_settings is null) return;

        if (string.IsNullOrEmpty(CombinedDefaultPassword))
        {
            _error = "กรุณากรอกรหัสผ่านเริ่มต้นทั้งสองช่อง";
            return;
        }
        if (DefaultPasswordPolicyError is not null)
        {
            _error = $"รหัสผ่าน \"{CombinedDefaultPassword}\" ไม่ผ่านเงื่อนไข {DefaultPasswordPolicyError}";
            return;
        }

        await using var context = await DbFactory.CreateDbContextAsync();
        var existing = await context.Pay_PayslipSettings.FirstOrDefaultAsync(s => s.CompanyId == _companyId);
        if (existing is null)
        {
            _error = "ไม่พบการตั้งค่า กรุณาโหลดหน้าใหม่";
            return;
        }

        existing.DefaultPasswordPart1 = _settings.DefaultPasswordPart1;
        existing.DefaultPasswordPart2 = _settings.DefaultPasswordPart2;
        existing.ModifiedDate = DateTime.Now;
        existing.ModifiedByUserId = await GetCurrentUserIdAsync();
        await context.SaveChangesAsync();

        Snackbar.Add("บันทึกรหัสผ่านเริ่มต้นเรียบร้อย", Severity.Success);
    }

    private async Task SaveCompanyInfoAsync()
    {
        _error = null;
        if (_settings is null) return;

        await using var context = await DbFactory.CreateDbContextAsync();
        var existing = await context.Pay_PayslipSettings.FirstOrDefaultAsync(s => s.CompanyId == _companyId);
        if (existing is null)
        {
            _error = "ไม่พบการตั้งค่า กรุณาโหลดหน้าใหม่";
            return;
        }

        existing.CompanyName = _settings.CompanyName;
        existing.CompanyNameEn = _settings.CompanyNameEn;
        existing.CompanyTaxId = _settings.CompanyTaxId;
        existing.CompanyAddress = _settings.CompanyAddress;
        existing.ModifiedDate = DateTime.Now;
        existing.ModifiedByUserId = await GetCurrentUserIdAsync();
        await context.SaveChangesAsync();

        Snackbar.Add("บันทึกข้อมูลบริษัทเรียบร้อย", Severity.Success);
    }

    private async Task SaveFiscalYearAsync()
    {
        _error = null;
        if (_settings is null) return;

        await using var context = await DbFactory.CreateDbContextAsync();
        var existing = await context.Pay_PayslipSettings.FirstOrDefaultAsync(s => s.CompanyId == _companyId);
        if (existing is null)
        {
            _error = "ไม่พบการตั้งค่า กรุณาโหลดหน้าใหม่";
            return;
        }

        existing.FiscalYearStartMonth = _settings.FiscalYearStartMonth;
        existing.ModifiedDate = DateTime.Now;
        existing.ModifiedByUserId = await GetCurrentUserIdAsync();
        await context.SaveChangesAsync();

        Snackbar.Add("บันทึกปีบัญชีเรียบร้อย", Severity.Success);
    }

    private async Task<long> GetCurrentUserIdAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        var idClaim = state.User.FindFirstValue("sc_userid");
        return long.TryParse(idClaim, out var id) ? id : 0;
    }

    private static string ThaiMonthName(int month) => month switch
    {
        1 => "มกราคม",
        2 => "กุมภาพันธ์",
        3 => "มีนาคม",
        4 => "เมษายน",
        5 => "พฤษภาคม",
        6 => "มิถุนายน",
        7 => "กรกฎาคม",
        8 => "สิงหาคม",
        9 => "กันยายน",
        10 => "ตุลาคม",
        11 => "พฤศจิกายน",
        12 => "ธันวาคม",
        _ => month.ToString(System.Globalization.CultureInfo.InvariantCulture),
    };
}
