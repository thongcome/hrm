@page "/pay/admin/payslip-settings"
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Pay
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@inject JsonLocalizationService L
@attribute [Authorize(Policy = "Menu:PAY_ADMIN")]

<PageTitle>@L.Translate("PayslipSettingsPageTitle")</PageTitle>

<MudPaper Class="pa-4 mb-4" MaxWidth="700px">
    <MudText Typo="Typo.h5">@L.Translate("PayslipSettingsHeading")</MudText>
    <MudText Typo="Typo.body2" Class="mt-1">
        @((MarkupString)L.Translate("PayslipSettingsDesc"))
    </MudText>

    @if (_settings is null)
    {
        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-4">@_error</MudAlert>
        }
        else
        {
            <MudProgressCircular Indeterminate="true" Class="mt-4" />
        }
    }
    else
    {
        <MudDivider Class="my-4" />

        <MudSelect T="string" Value="_selectedPreset" ValueChanged="OnPresetChanged" Label="@L.Translate("PasswordPresetLabel")">
            <MudSelectItem Value="@("{BirthDateDDMMYYYY}")">@L.Translate("PresetBirthDateLong")</MudSelectItem>
            <MudSelectItem Value="@("{BirthDateDDMMYY}")">@L.Translate("PresetBirthDateShort")</MudSelectItem>
            <MudSelectItem Value="@("{IdCardLast4}")">@L.Translate("PresetIdCardLast4")</MudSelectItem>
            <MudSelectItem Value="@("{IdCardLast4}{EmpNo}")">@L.Translate("PresetIdCardLast4EmpNo")</MudSelectItem>
            <MudSelectItem Value="@("{EmpNo}{BirthDateDDMMYY}")">@L.Translate("PresetCustom")</MudSelectItem>
        </MudSelect>

        <MudTextField @bind-Value="_settings.PasswordTemplate" Label="@L.Translate("PasswordTemplateLabel")" Class="mt-4"
            HelperText="@L.Translate("PasswordTemplateHelperText")" />
        <MudText Typo="Typo.caption" Class="mt-1" Style="opacity:.75;">
            @L.Translate("PasswordTemplateCaption")
        </MudText>

        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
        }

        <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="mt-4" OnClick="SaveAsync">@L.Translate("Save")</MudButton>

        <MudDivider Class="my-5" />

        <MudText Typo="Typo.h6" Class="mb-2">@L.Translate("CompanyInfoForCertHeading")</MudText>
        <MudText Typo="Typo.body2" Class="mb-2">
            @L.Translate("CompanyInfoForCertDesc")
        </MudText>
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_settings.CompanyName" Label="@L.Translate("CompanyNameThLabel")" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_settings.CompanyNameEn" Label="@L.Translate("CompanyNameEnLabel")" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_settings.CompanyTaxId" Label="@L.Translate("CompanyTaxIdLabel")" MaxLength="13" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_settings.CompanyAddress" Label="@L.Translate("CompanyAddressLabel")" Lines="2" />
            </MudItem>
        </MudGrid>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="mt-3" OnClick="SaveCompanyInfoAsync">@L.Translate("SaveCompanyInfoButton")</MudButton>

        <MudDivider Class="my-5" />

        <MudText Typo="Typo.h6" Class="mb-2">@L.Translate("FiscalYearSectionHeading")</MudText>
        <MudText Typo="Typo.body2" Class="mb-2">
            @L.Translate("FiscalYearSectionDesc")
        </MudText>
        <MudSelect T="int" @bind-Value="_settings.FiscalYearStartMonth" Label="@L.Translate("FiscalYearStartMonthLabel")" Class="mud-width-full" Style="max-width: 300px;">
            @for (var m = 1; m <= 12; m++)
            {
                var month = m;
                <MudSelectItem T="int" Value="@month">@ThaiMonthName(month)</MudSelectItem>
            }
        </MudSelect>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="mt-3" OnClick="SaveFiscalYearAsync">@L.Translate("SaveFiscalYearButton")</MudButton>

        <MudDivider Class="my-5" />

        <MudText Typo="Typo.h6" Class="mb-2">@L.Translate("ProbationSectionHeading")</MudText>
        <MudText Typo="Typo.body2" Class="mb-2">
            @L.Translate("ProbationSectionDesc")
        </MudText>
        <MudNumericField @bind-Value="_settings.DefaultProbationDays" Label="@L.Translate("DefaultProbationDaysLabel")" Min="0" Style="max-width: 300px;" />
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="mt-3" OnClick="SaveProbationSettingsAsync">@L.Translate("SaveProbationButton")</MudButton>

        <MudDivider Class="my-5" />

        <MudText Typo="Typo.h6" Class="mb-2">@L.Translate("HeadcountBudgetSectionHeading")</MudText>
        <MudText Typo="Typo.body2" Class="mb-2">
            @L.Translate("HeadcountBudgetSectionDesc")
        </MudText>
        <MudSwitch T="bool" @bind-Value="_settings.BlockOverBudgetCreation" Color="Color.Warning" Label="@L.Translate("BlockOverBudgetLabel")" />
        <br />
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="mt-3" OnClick="SaveHeadcountBudgetSettingsAsync">@L.Translate("SaveHeadcountBudgetButton")</MudButton>

        <MudDivider Class="my-5" />

        <MudText Typo="Typo.h6" Class="mb-2">@L.Translate("DefaultPasswordSectionHeading")</MudText>
        <MudText Typo="Typo.body2" Class="mb-2">
            @L.Translate("DefaultPasswordSectionDesc")
        </MudText>
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_settings.DefaultPasswordPart1" Label="@L.Translate("PasswordPart1Label")" Placeholder="@L.Translate("PasswordPart1Placeholder")" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_settings.DefaultPasswordPart2" Label="@L.Translate("PasswordPart2Label")" Placeholder="@L.Translate("PasswordPart2Placeholder")" />
            </MudItem>
        </MudGrid>
        @if (!string.IsNullOrEmpty(CombinedDefaultPassword))
        {
            @if (DefaultPasswordPolicyError is null)
            {
                <MudAlert Severity="Severity.Success" Class="mt-3">@L.Translate("ResultingPasswordLabel") <b class="mono">@CombinedDefaultPassword</b></MudAlert>
            }
            else
            {
                <MudAlert Severity="Severity.Error" Class="mt-3">@string.Format(L.Translate("ResultingPasswordErrorTemplate"), CombinedDefaultPassword, DefaultPasswordPolicyError)</MudAlert>
            }
        }
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="mt-3" OnClick="SaveDefaultPasswordAsync">@L.Translate("SaveDefaultPasswordButton")</MudButton>

        <MudDivider Class="my-5" />

        <MudText Typo="Typo.h6" Class="mb-2">@L.Translate("TestPreviewSectionHeading")</MudText>
        <MudAutocomplete T="Hremployee" Label="@L.Translate("SelectEmployeeForPasswordPreviewLabel")" @bind-Value="_previewEmployee"
            SearchFunc="SearchEmployeesAsync"
            ToStringFunc="@(e => e == null ? null : $"{e.EmpNo} — {e.EmpName} {e.EmpSurname}")"
            ResetValueOnEmptyText="true" CoerceText="true" MinCharacters="0" />

        @if (_previewEmployee is not null)
        {
            var result = PayslipPasswordService.Resolve(_previewEmployee, _settings.PasswordTemplate);
            @if (result.Success)
            {
                <MudAlert Severity="Severity.Success" Class="mt-3">
                    @string.Format(L.Translate("PasswordPreviewResultTemplate"), _previewEmployee.EmpNo, _previewEmployee.EmpName) <b class="mono">@result.Password</b>
                </MudAlert>
            }
            else
            {
                <MudAlert Severity="Severity.Warning" Class="mt-3">@result.ErrorReason</MudAlert>
            }
        }
    }
</MudPaper>

<style>
    .mono { font-family: ui-monospace, Consolas, monospace; }
</style>

@code {
    private Pay_PayslipSettings? _settings;
    private Hremployee? _previewEmployee;
    private string _selectedPreset = "{BirthDateDDMMYYYY}";
    private string? _error;
    private string? _companyId;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
        if (string.IsNullOrWhiteSpace(_companyId))
        {
            _error = L.Translate("CompanyNotLinkedError");
            return;
        }

        await using var context = await DbFactory.CreateDbContextAsync();
        _settings = await context.Pay_PayslipSettings.FirstOrDefaultAsync(s => s.CompanyId == _companyId);
        if (_settings is null)
        {
            _settings = new Pay_PayslipSettings { CompanyId = _companyId, PasswordTemplate = "{BirthDateDDMMYYYY}" };
            context.Pay_PayslipSettings.Add(_settings);
            await context.SaveChangesAsync();
        }
        _selectedPreset = PayslipPasswordService.SupportedTokens.Contains(_settings.PasswordTemplate)
            ? _settings.PasswordTemplate
            : "{EmpNo}{BirthDateDDMMYY}";
    }

    private string CombinedDefaultPassword => (_settings?.DefaultPasswordPart1 ?? "") + (_settings?.DefaultPasswordPart2 ?? "");
    private string? DefaultPasswordPolicyError => ValidatePasswordPolicy(CombinedDefaultPassword);

    private void OnPresetChanged(string value)
    {
        _selectedPreset = value;
        if (_settings is not null && value != "{EmpNo}{BirthDateDDMMYY}")
            _settings.PasswordTemplate = value;
    }

    private async Task<IEnumerable<Hremployee>> SearchEmployeesAsync(string search, CancellationToken ct)
    {
        await using var context = await DbFactory.CreateDbContextAsync(ct);
        var query = context.Hremployee.Where(e => e.companyid == _companyId);
        if (!string.IsNullOrWhiteSpace(search))
        {
            query = query.Where(e => e.EmpNo.Contains(search)
                || (e.EmpName != null && e.EmpName.Contains(search))
                || (e.EmpSurname != null && e.EmpSurname.Contains(search)));
        }
        return await query.OrderBy(e => e.EmpNo).Take(20).ToListAsync(ct);
    }

    private async Task SaveAsync()
    {
        _error = null;
        if (_settings is null || string.IsNullOrWhiteSpace(_settings.PasswordTemplate))
        {
            _error = L.Translate("PasswordTemplateRequiredError");
            return;
        }

        await using var context = await DbFactory.CreateDbContextAsync();
        var existing = await context.Pay_PayslipSettings.FirstOrDefaultAsync(s => s.CompanyId == _companyId);
        if (existing is null)
        {
            _error = L.Translate("SettingsNotFoundError");
            return;
        }

        existing.PasswordTemplate = _settings.PasswordTemplate;
        existing.ModifiedDate = DateTime.Now;
        existing.ModifiedByUserId = await GetCurrentUserIdAsync();
        await context.SaveChangesAsync();

        Snackbar.Add(L.Translate("SettingsSavedSuccess"), Severity.Success);
    }

    // Mirrors ASP.NET Core Identity's default PasswordOptions (never
    // explicitly configured in Program.cs, so the framework default applies:
    // digit + lowercase + uppercase + non-alphanumeric + length >= 6).
    // Checked client-side here so a bad combination is caught when the admin
    // saves it, not the next time HR tries to create an account.
    private string? ValidatePasswordPolicy(string value)
    {
        if (value.Length < 6) return L.Translate("PasswordPolicyMinLength");
        if (!value.Any(char.IsDigit)) return L.Translate("PasswordPolicyDigit");
        if (!value.Any(char.IsLower)) return L.Translate("PasswordPolicyLower");
        if (!value.Any(char.IsUpper)) return L.Translate("PasswordPolicyUpper");
        if (value.All(char.IsLetterOrDigit)) return L.Translate("PasswordPolicySymbol");
        return null;
    }

    private async Task SaveDefaultPasswordAsync()
    {
        _error = null;
        if (_settings is null) return;

        if (string.IsNullOrEmpty(CombinedDefaultPassword))
        {
            _error = L.Translate("BothPasswordPartsRequiredError");
            return;
        }
        if (DefaultPasswordPolicyError is not null)
        {
            _error = string.Format(L.Translate("PasswordDoesNotMeetPolicyTemplate"), CombinedDefaultPassword, DefaultPasswordPolicyError);
            return;
        }

        await using var context = await DbFactory.CreateDbContextAsync();
        var existing = await context.Pay_PayslipSettings.FirstOrDefaultAsync(s => s.CompanyId == _companyId);
        if (existing is null)
        {
            _error = L.Translate("SettingsNotFoundError");
            return;
        }

        existing.DefaultPasswordPart1 = _settings.DefaultPasswordPart1;
        existing.DefaultPasswordPart2 = _settings.DefaultPasswordPart2;
        existing.ModifiedDate = DateTime.Now;
        existing.ModifiedByUserId = await GetCurrentUserIdAsync();
        await context.SaveChangesAsync();

        Snackbar.Add(L.Translate("DefaultPasswordSavedSuccess"), Severity.Success);
    }

    private async Task SaveCompanyInfoAsync()
    {
        _error = null;
        if (_settings is null) return;

        await using var context = await DbFactory.CreateDbContextAsync();
        var existing = await context.Pay_PayslipSettings.FirstOrDefaultAsync(s => s.CompanyId == _companyId);
        if (existing is null)
        {
            _error = L.Translate("SettingsNotFoundError");
            return;
        }

        existing.CompanyName = _settings.CompanyName;
        existing.CompanyNameEn = _settings.CompanyNameEn;
        existing.CompanyTaxId = _settings.CompanyTaxId;
        existing.CompanyAddress = _settings.CompanyAddress;
        existing.ModifiedDate = DateTime.Now;
        existing.ModifiedByUserId = await GetCurrentUserIdAsync();
        await context.SaveChangesAsync();

        Snackbar.Add(L.Translate("CompanyInfoSavedSuccess"), Severity.Success);
    }

    private async Task SaveFiscalYearAsync()
    {
        _error = null;
        if (_settings is null) return;

        await using var context = await DbFactory.CreateDbContextAsync();
        var existing = await context.Pay_PayslipSettings.FirstOrDefaultAsync(s => s.CompanyId == _companyId);
        if (existing is null)
        {
            _error = L.Translate("SettingsNotFoundError");
            return;
        }

        existing.FiscalYearStartMonth = _settings.FiscalYearStartMonth;
        existing.ModifiedDate = DateTime.Now;
        existing.ModifiedByUserId = await GetCurrentUserIdAsync();
        await context.SaveChangesAsync();

        Snackbar.Add(L.Translate("FiscalYearSavedSuccess"), Severity.Success);
    }

    private async Task SaveProbationSettingsAsync()
    {
        _error = null;
        if (_settings is null) return;

        await using var context = await DbFactory.CreateDbContextAsync();
        var existing = await context.Pay_PayslipSettings.FirstOrDefaultAsync(s => s.CompanyId == _companyId);
        if (existing is null)
        {
            _error = L.Translate("SettingsNotFoundError");
            return;
        }

        existing.DefaultProbationDays = _settings.DefaultProbationDays;
        existing.ModifiedDate = DateTime.Now;
        existing.ModifiedByUserId = await GetCurrentUserIdAsync();
        await context.SaveChangesAsync();

        Snackbar.Add(L.Translate("ProbationSavedSuccess"), Severity.Success);
    }

    private async Task SaveHeadcountBudgetSettingsAsync()
    {
        _error = null;
        if (_settings is null) return;

        await using var context = await DbFactory.CreateDbContextAsync();
        var existing = await context.Pay_PayslipSettings.FirstOrDefaultAsync(s => s.CompanyId == _companyId);
        if (existing is null)
        {
            _error = L.Translate("SettingsNotFoundError");
            return;
        }

        existing.BlockOverBudgetCreation = _settings.BlockOverBudgetCreation;
        existing.ModifiedDate = DateTime.Now;
        existing.ModifiedByUserId = await GetCurrentUserIdAsync();
        await context.SaveChangesAsync();

        Snackbar.Add(L.Translate("HeadcountBudgetSavedSuccess"), Severity.Success);
    }

    private async Task<long> GetCurrentUserIdAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        var idClaim = state.User.FindFirstValue("sc_userid");
        return long.TryParse(idClaim, out var id) ? id : 0;
    }

    private string ThaiMonthName(int month) => month switch
    {
        1 => L.Translate("MonthJanuary"),
        2 => L.Translate("MonthFebruary"),
        3 => L.Translate("MonthMarch"),
        4 => L.Translate("MonthApril"),
        5 => L.Translate("MonthMay"),
        6 => L.Translate("MonthJune"),
        7 => L.Translate("MonthJuly"),
        8 => L.Translate("MonthAugust"),
        9 => L.Translate("MonthSeptember"),
        10 => L.Translate("MonthOctober"),
        11 => L.Translate("MonthNovember"),
        12 => L.Translate("MonthDecember"),
        _ => month.ToString(System.Globalization.CultureInfo.InvariantCulture),
    };
}
