@page "/pay/recurring-items"
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Pay
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject JsonLocalizationService L
@attribute [Authorize(Policy = "Menu:PAY_ADMIN")]

<PageTitle>@L.Translate("RecurringItemsPageTitle")</PageTitle>

<MudPaper Class="pa-4 mb-4">
    <MudText Typo="Typo.h5">@L.Translate("RecurringItemsPageTitle")</MudText>
    <MudText Typo="Typo.body2" Class="mt-1">@L.Translate("RecurringItemsDesc")</MudText>
</MudPaper>

<MudPaper Class="pa-4">
    <MudTabs Elevation="0" Rounded="true">
        <MudTabPanel Text="@L.Translate("RecurringItemsByEmployeeTab")">
            <MudStack Class="mt-3 mb-3" Style="max-width: 500px;">
                <MudAutocomplete T="Hremployee" Label="@L.Translate("EmployeeSearchLabel")" Value="_selectedEmployee"
                    SearchFunc="SearchEmployeesAsync" ValueChanged="OnEmployeeSelectedAsync"
                    ToStringFunc="@(e => e == null ? null : $"{e.EmpNo} — {e.EmpName} {e.EmpSurname}")"
                    ResetValueOnEmptyText="true" CoerceText="true" MinCharacters="0" />
            </MudStack>

            @if (_selectedEmployee is not null)
            {
                <MudTable Items="_employeeRows" Hover="true" Dense="true" Loading="_loadingEmployee">
                    <HeaderContent>
                        <MudTh>@L.Translate("ColItemName")</MudTh>
                        <MudTh>@L.Translate("RecurringItemsColDetail")</MudTh>
                        <MudTh>@L.Translate("RecurringItemsColEffective")</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.TypeName</MudTd>
                        <MudTd>@context.Detail</MudTd>
                        <MudTd>
                            @if (context.EffectiveFrom is not null)
                            {
                                @($"{context.EffectiveFrom:dd/MM/yyyy} — {(context.EffectiveTo is not null ? context.EffectiveTo.Value.ToString("dd/MM/yyyy") : L.Translate("RecurringItemsOngoing"))}")
                            }
                            else
                            {
                                <text>-</text>
                            }
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText>@L.Translate("RecurringItemsNoneForEmployee")</MudText>
                    </NoRecordsContent>
                </MudTable>
            }
        </MudTabPanel>

        <MudTabPanel Text="@L.Translate("RecurringItemsByTypeTab")">
            <MudStack Class="mt-3 mb-3" Style="max-width: 400px;">
                <MudSelect T="string" Value="_selectedTypeCode" Label="@L.Translate("ColType")" ValueChanged="OnTypeSelectedAsync">
                    @foreach (var t in RecurringPayItemService.ItemTypes)
                    {
                        <MudSelectItem T="string" Value="t.Code">@t.NameTh</MudSelectItem>
                    }
                </MudSelect>
            </MudStack>

            @if (!string.IsNullOrEmpty(_selectedTypeCode))
            {
                <MudTable Items="_typeParticipants" Hover="true" Dense="true" Loading="_loadingType">
                    <HeaderContent>
                        <MudTh>@L.Translate("EmployeeLabel")</MudTh>
                        <MudTh>@L.Translate("RecurringItemsColDetail")</MudTh>
                        <MudTh>@L.Translate("RecurringItemsColEffective")</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.EmpNo — @context.EmpName</MudTd>
                        <MudTd>@context.Detail</MudTd>
                        <MudTd>@(context.EffectiveFrom is not null ? context.EffectiveFrom.Value.ToString("dd/MM/yyyy") : "-")</MudTd>
                    </RowTemplate>
                    <FooterContent>
                        <MudTd colspan="3"><b>@string.Format(L.Translate("RecurringItemsTotalParticipantsTemplate"), _typeParticipants.Count)</b></MudTd>
                    </FooterContent>
                    <NoRecordsContent>
                        <MudText>@L.Translate("NoItemsYet")</MudText>
                    </NoRecordsContent>
                </MudTable>
            }
        </MudTabPanel>
    </MudTabs>
</MudPaper>

@code {
    private Hremployee? _selectedEmployee;
    private List<RecurringItemRow> _employeeRows = new();
    private bool _loadingEmployee;

    private string? _selectedTypeCode;
    private List<RecurringItemParticipant> _typeParticipants = new();
    private bool _loadingType;

    private async Task<string?> GetCurrentCompanyIdAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        return state.User.FindFirstValue("payroll_company");
    }

    private async Task<IEnumerable<Hremployee>> SearchEmployeesAsync(string search, CancellationToken ct)
    {
        var companyId = await GetCurrentCompanyIdAsync();
        await using var context = await DbFactory.CreateDbContextAsync(ct);
        var query = context.Hremployee.Where(e => e.companyid == companyId);
        if (!string.IsNullOrWhiteSpace(search))
        {
            query = query.Where(e => e.EmpNo.Contains(search)
                || (e.EmpName != null && e.EmpName.Contains(search))
                || (e.EmpSurname != null && e.EmpSurname.Contains(search)));
        }
        return await query.OrderBy(e => e.EmpNo).Take(20).ToListAsync(ct);
    }

    private async Task OnEmployeeSelectedAsync(Hremployee? employee)
    {
        _selectedEmployee = employee;
        _employeeRows = new();
        if (employee is null) return;

        _loadingEmployee = true;
        await using var context = await DbFactory.CreateDbContextAsync();
        _employeeRows = await RecurringPayItemService.GetForEmployeeAsync(context, employee.id);
        _loadingEmployee = false;
    }

    private async Task OnTypeSelectedAsync(string? typeCode)
    {
        _selectedTypeCode = typeCode;
        _typeParticipants = new();
        if (string.IsNullOrEmpty(typeCode)) return;

        var companyId = await GetCurrentCompanyIdAsync();
        if (companyId is null) return;

        _loadingType = true;
        await using var context = await DbFactory.CreateDbContextAsync();
        _typeParticipants = await RecurringPayItemService.GetParticipantsByTypeAsync(context, companyId, typeCode);
        _loadingType = false;
    }
}
