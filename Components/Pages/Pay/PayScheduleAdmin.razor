@page "/pay/admin/pay-schedules"
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Security
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject ProgramRoleService ProgramRoles
@inject ISnackbar Snackbar
@attribute [Authorize(Policy = "Menu:PAY_ADMIN")]

<PageTitle>รอบจ่ายเงินเดือน</PageTitle>

<MudPaper Class="pa-4 mb-4" MaxWidth="1100px">
    <MudText Typo="Typo.h5">รอบจ่ายเงินเดือน (Pay Schedule)</MudText>
    <MudText Typo="Typo.body2" Class="mt-1">
        กำหนดว่าจ่ายกี่งวดต่อเดือน ใช้กับพนักงานกลุ่มไหน และมีผลตั้งแต่-ถึงวันที่ — ตัวคำนวณภาษีหัก ณ ที่จ่ายอ่านปฏิทินจากตรงนี้
        (ไม่ใช่สูตรตายตัวเดือนละงวด) เปลี่ยนความถี่กลางปีได้โดยเพิ่มแถวใหม่พร้อมวันที่มีผล และใส่วันสิ้นสุดให้แถวเดิม
        ค่าเริ่มต้นเมื่อไม่มีแถวใด = เดือนละ 1 งวด · ทับเฉพาะรายคนได้ด้านล่าง
    </MudText>

    @if (_rights is { CanEdit: false, CanCreate: false })
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">หน้านี้ยังไม่ได้เปิดสิทธิ์แก้ไขให้บทบาทของคุณ</MudAlert>
    }

    <MudDivider Class="my-4" />
    <MudText Typo="Typo.h6" Class="mb-2">รอบจ่ายของบริษัท @_companyId</MudText>
    <MudTable Items="_schedules" Dense="true" Hover="true">
        <HeaderContent>
            <MudTh>รหัส</MudTh>
            <MudTh>ชื่อ</MudTh>
            <MudTh>งวด/เดือน</MudTh>
            <MudTh>งวดที่ 2 เริ่มวันที่</MudTh>
            <MudTh>ใช้กับ</MudTh>
            <MudTh>มีผลตั้งแต่</MudTh>
            <MudTh>ถึง</MudTh>
            <MudTh>สถานะ</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            @if (_editing is not null && _editing.Id == context.Id)
            {
                <MudTd>@context.Code</MudTd>
                <MudTd><MudTextField T="string" @bind-Value="_editing.Name" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudTd>
                <MudTd>
                    <MudSelect T="int" @bind-Value="_editing.PeriodsPerMonth" Margin="Margin.Dense" Variant="Variant.Outlined">
                        <MudSelectItem T="int" Value="1">1 งวด</MudSelectItem>
                        <MudSelectItem T="int" Value="2">2 งวด</MudSelectItem>
                    </MudSelect>
                </MudTd>
                <MudTd><MudNumericField T="int" @bind-Value="_editing.SecondTermStartDay" Min="2" Max="28" Margin="Margin.Dense" Variant="Variant.Outlined" Style="width:90px;" /></MudTd>
                <MudTd>
                    <MudSelect T="PayScheduleGroup" @bind-Value="_editing.AppliesTo" Margin="Margin.Dense" Variant="Variant.Outlined">
                        <MudSelectItem T="PayScheduleGroup" Value="PayScheduleGroup.MonthlySalaried">พนักงานรายเดือน</MudSelectItem>
                        <MudSelectItem T="PayScheduleGroup" Value="PayScheduleGroup.DailyWage">พนักงานรายวัน</MudSelectItem>
                        <MudSelectItem T="PayScheduleGroup" Value="PayScheduleGroup.All">ทุกคน</MudSelectItem>
                    </MudSelect>
                </MudTd>
                <MudTd><MudDatePicker Date="_editFrom" DateChanged="d => _editFrom = d" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudTd>
                <MudTd><MudDatePicker Date="_editTo" DateChanged="d => _editTo = d" Clearable="true" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudTd>
                <MudTd><MudCheckBox T="bool" @bind-Value="_editing.IsActive" Dense="true" /></MudTd>
                <MudTd style="white-space:nowrap;">
                    <MudIconButton Icon="@Icons.Material.Filled.Save" Color="Color.Primary" Size="Size.Small" OnClick="SaveEditAsync" />
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => _editing = null)" />
                </MudTd>
            }
            else
            {
                <MudTd><b>@context.Code</b></MudTd>
                <MudTd>@context.Name</MudTd>
                <MudTd>@context.PeriodsPerMonth งวด</MudTd>
                <MudTd>@(context.PeriodsPerMonth == 2 ? context.SecondTermStartDay.ToString() : "-")</MudTd>
                <MudTd>@GroupLabel(context.AppliesTo)</MudTd>
                <MudTd>@context.EffectiveFrom.ToString("dd/MM/yyyy")</MudTd>
                <MudTd>@(context.EffectiveTo?.ToString("dd/MM/yyyy") ?? "ไม่กำหนด")</MudTd>
                <MudTd><MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">@(context.IsActive ? "ใช้งาน" : "ปิด")</MudChip></MudTd>
                <MudTd>
                    @if (_rights?.CanEdit == true)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => BeginEdit(context))" />
                    }
                </MudTd>
            }
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2">ยังไม่มีรอบจ่าย — ระบบใช้ค่าเริ่มต้นเดือนละ 1 งวดกับพนักงานทุกคน</MudText>
        </NoRecordsContent>
    </MudTable>

    @if (_rights?.CanCreate == true)
    {
        <MudDivider Class="my-4" />
        <MudText Typo="Typo.subtitle1" Class="mb-2">เพิ่มรอบจ่าย</MudText>
        <MudGrid>
            <MudItem xs="12" sm="2"><MudTextField T="string" @bind-Value="_new.Code" Label="รหัส" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="12" sm="3"><MudTextField T="string" @bind-Value="_new.Name" Label="ชื่อ" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="12" sm="2">
                <MudSelect T="int" @bind-Value="_new.PeriodsPerMonth" Label="งวด/เดือน" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem T="int" Value="1">1 งวด</MudSelectItem>
                    <MudSelectItem T="int" Value="2">2 งวด</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="2"><MudNumericField T="int" @bind-Value="_new.SecondTermStartDay" Label="งวดที่ 2 เริ่มวันที่" Min="2" Max="28" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="12" sm="3">
                <MudSelect T="PayScheduleGroup" @bind-Value="_new.AppliesTo" Label="ใช้กับ" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem T="PayScheduleGroup" Value="PayScheduleGroup.MonthlySalaried">พนักงานรายเดือน</MudSelectItem>
                    <MudSelectItem T="PayScheduleGroup" Value="PayScheduleGroup.DailyWage">พนักงานรายวัน</MudSelectItem>
                    <MudSelectItem T="PayScheduleGroup" Value="PayScheduleGroup.All">ทุกคน</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="3"><MudDatePicker Label="มีผลตั้งแต่" Date="_newFrom" DateChanged="d => _newFrom = d" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="12" sm="3"><MudDatePicker Label="ถึง (เว้นว่าง = ไม่กำหนด)" Date="_newTo" DateChanged="d => _newTo = d" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="12" sm="4"><MudTextField T="string" @bind-Value="_new.Note" Label="หมายเหตุ" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="12" sm="2"><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddAsync">เพิ่ม</MudButton></MudItem>
        </MudGrid>
    }
</MudPaper>

<MudPaper Class="pa-4 mb-4" MaxWidth="1100px">
    <MudText Typo="Typo.h6">ทับรายคน</MudText>
    <MudText Typo="Typo.body2" Class="mt-1 mb-3">พนักงานที่ต้องใช้รอบจ่ายต่างจากค่าเริ่มต้นของกลุ่ม — มีผลตั้งแต่-ถึงวันที่ หมดช่วงแล้วกลับไปใช้ค่าเริ่มต้นเอง</MudText>

    <MudAutocomplete T="Hremployee" Label="พนักงาน" Value="_selectedEmployee" ValueChanged="OnEmployeeChangedAsync" SearchFunc="SearchEmployeesAsync"
                     ToStringFunc="@(e => e is null ? "" : $"{e.EmpNo} {e.EmpName} {e.EmpSurname}")" MinCharacters="0" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" />

    @if (_selectedEmployee is not null)
    {
        <MudText Typo="Typo.body2" Class="mt-2">
            ค่าเริ่มต้นของคนนี้: <b>@GroupLabel(HRM.Services.Pay.PayScheduleResolver.GroupOf(_selectedEmployee))</b>
        </MudText>
        <MudTable Items="_overrides" Dense="true" Hover="true" Class="mt-2">
            <HeaderContent>
                <MudTh>รอบจ่าย</MudTh>
                <MudTh>มีผลตั้งแต่</MudTh>
                <MudTh>ถึง</MudTh>
                <MudTh>หมายเหตุ</MudTh>
                <MudTh>สถานะ</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@(_schedules.FirstOrDefault(s => s.Id == context.PayScheduleId)?.Name ?? $"#{context.PayScheduleId}")</MudTd>
                <MudTd>@context.EffectiveFrom.ToString("dd/MM/yyyy")</MudTd>
                <MudTd>@(context.EffectiveTo?.ToString("dd/MM/yyyy") ?? "ไม่กำหนด")</MudTd>
                <MudTd>@context.Note</MudTd>
                <MudTd>@(context.IsActive ? "ใช้งาน" : "ปิด")</MudTd>
                <MudTd>
                    @if (_rights?.CanEdit == true && context.IsActive)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Warning" OnClick="@(() => DeactivateOverrideAsync(context))">ปิดใช้</MudButton>
                    }
                </MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText Typo="Typo.body2">ไม่มีการทับรายคน — ใช้ค่าเริ่มต้นของกลุ่ม</MudText></NoRecordsContent>
        </MudTable>

        @if (_rights?.CanCreate == true)
        {
            <MudGrid Class="mt-3">
                <MudItem xs="12" sm="4">
                    <MudSelect T="long?" @bind-Value="_ovScheduleId" Label="รอบจ่าย" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var s in _schedules.Where(s => s.IsActive))
                        {
                            <MudSelectItem T="long?" Value="@((long?)s.Id)">@s.Name (@s.PeriodsPerMonth งวด/เดือน)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="3"><MudDatePicker Label="มีผลตั้งแต่" Date="_ovFrom" DateChanged="d => _ovFrom = d" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="12" sm="3"><MudDatePicker Label="ถึง" Date="_ovTo" DateChanged="d => _ovTo = d" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="12" sm="4"><MudTextField T="string" @bind-Value="_ovNote" Label="หมายเหตุ" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="12" sm="2"><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddOverrideAsync">เพิ่ม</MudButton></MudItem>
            </MudGrid>
        }
    }
</MudPaper>

@code {
    private const string ProgramPath = "/pay/admin/pay-schedules";

    private string? _companyId;
    private long _actorUserId;
    private ProgramRoleService.ProgramRights? _rights;

    private List<Pay_PaySchedule> _schedules = new();
    private Pay_PaySchedule? _editing;
    private DateTime? _editFrom;
    private DateTime? _editTo;

    private Pay_PaySchedule _new = new() { PeriodsPerMonth = 1, SecondTermStartDay = 16, AppliesTo = PayScheduleGroup.All };
    private DateTime? _newFrom = new DateTime(DateTime.Today.Year, 1, 1);
    private DateTime? _newTo;

    private Hremployee? _selectedEmployee;
    private List<Pay_EmployeePayScheduleOverride> _overrides = new();
    private long? _ovScheduleId;
    private DateTime? _ovFrom = DateTime.Today;
    private DateTime? _ovTo;
    private string? _ovNote;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _actorUserId = long.TryParse(state.User.FindFirst("sc_userid")?.Value, out var uid) ? uid : 0;
        _companyId = state.User.FindFirst("payroll_company")?.Value;
        _rights = await ProgramRoles.GetRightsAsync(state.User, ProgramPath);
        await LoadAsync();
    }

    private async Task<string?> RequireRightAsync(ProgramRoleService.ProgramAction action)
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        try { await ProgramRoles.RequireAsync(state.User, ProgramPath, action); return null; }
        catch (InvalidOperationException ex) { return ex.Message; }
    }

    private static string GroupLabel(PayScheduleGroup g) => g switch
    {
        PayScheduleGroup.MonthlySalaried => "พนักงานรายเดือน",
        PayScheduleGroup.DailyWage => "พนักงานรายวัน",
        _ => "ทุกคน",
    };

    private async Task LoadAsync()
    {
        await using var ctx = await DbFactory.CreateDbContextAsync();
        _schedules = await ctx.Pay_PaySchedules
            .Where(s => _companyId == null || s.CompanyId == _companyId)
            .OrderBy(s => s.AppliesTo).ThenBy(s => s.EffectiveFrom).ToListAsync();
        if (_selectedEmployee is not null)
            _overrides = await ctx.Pay_EmployeePayScheduleOverrides
                .Where(o => o.HremployeeId == _selectedEmployee.id)
                .OrderByDescending(o => o.EffectiveFrom).ToListAsync();
    }

    private void BeginEdit(Pay_PaySchedule s)
    {
        _editing = new Pay_PaySchedule
        {
            Id = s.Id, CompanyId = s.CompanyId, Code = s.Code, Name = s.Name, PeriodsPerMonth = s.PeriodsPerMonth,
            SecondTermStartDay = s.SecondTermStartDay, AppliesTo = s.AppliesTo, EffectiveFrom = s.EffectiveFrom,
            EffectiveTo = s.EffectiveTo, IsActive = s.IsActive, Note = s.Note,
        };
        _editFrom = s.EffectiveFrom.ToDateTime(TimeOnly.MinValue);
        _editTo = s.EffectiveTo?.ToDateTime(TimeOnly.MinValue);
    }

    private async Task SaveEditAsync()
    {
        if (_editing is null) return;
        if (await RequireRightAsync(ProgramRoleService.ProgramAction.Edit) is string denied) { Snackbar.Add(denied, Severity.Error); return; }
        if (_editFrom is null) { Snackbar.Add("ต้องระบุวันที่มีผล", Severity.Warning); return; }
        await using var ctx = await DbFactory.CreateDbContextAsync();
        var row = await ctx.Pay_PaySchedules.FirstOrDefaultAsync(s => s.Id == _editing.Id);
        if (row is null) { Snackbar.Add("ไม่พบรอบจ่าย", Severity.Error); return; }
        row.Name = _editing.Name.Trim();
        row.PeriodsPerMonth = _editing.PeriodsPerMonth;
        row.SecondTermStartDay = _editing.SecondTermStartDay;
        row.AppliesTo = _editing.AppliesTo;
        row.EffectiveFrom = DateOnly.FromDateTime(_editFrom.Value);
        row.EffectiveTo = _editTo is null ? null : DateOnly.FromDateTime(_editTo.Value);
        row.IsActive = _editing.IsActive;
        await ctx.SaveChangesAsync();
        _editing = null;
        Snackbar.Add("บันทึกแล้ว — มีผลกับรอบที่คำนวณหลังจากนี้", Severity.Success);
        await LoadAsync();
    }

    private async Task AddAsync()
    {
        if (await RequireRightAsync(ProgramRoleService.ProgramAction.Create) is string denied) { Snackbar.Add(denied, Severity.Error); return; }
        if (string.IsNullOrWhiteSpace(_companyId)) { Snackbar.Add("บัญชีของคุณไม่ได้ผูกกับบริษัทเงินเดือน", Severity.Error); return; }
        if (string.IsNullOrWhiteSpace(_new.Code) || string.IsNullOrWhiteSpace(_new.Name)) { Snackbar.Add("ต้องระบุรหัสและชื่อ", Severity.Warning); return; }
        if (_newFrom is null) { Snackbar.Add("ต้องระบุวันที่มีผล", Severity.Warning); return; }
        await using var ctx = await DbFactory.CreateDbContextAsync();
        var code = _new.Code.Trim().ToUpperInvariant();
        if (await ctx.Pay_PaySchedules.AnyAsync(s => s.CompanyId == _companyId && s.Code == code)) { Snackbar.Add($"รหัส {code} มีอยู่แล้ว", Severity.Warning); return; }
        ctx.Pay_PaySchedules.Add(new Pay_PaySchedule
        {
            CompanyId = _companyId, Code = code, Name = _new.Name.Trim(), PeriodsPerMonth = _new.PeriodsPerMonth,
            SecondTermStartDay = _new.SecondTermStartDay, AppliesTo = _new.AppliesTo,
            EffectiveFrom = DateOnly.FromDateTime(_newFrom.Value), EffectiveTo = _newTo is null ? null : DateOnly.FromDateTime(_newTo.Value),
            IsActive = true, Note = string.IsNullOrWhiteSpace(_new.Note) ? null : _new.Note.Trim(),
        });
        await ctx.SaveChangesAsync();
        Snackbar.Add($"เพิ่มรอบจ่าย {code} แล้ว", Severity.Success);
        _new = new() { PeriodsPerMonth = 1, SecondTermStartDay = 16, AppliesTo = PayScheduleGroup.All };
        await LoadAsync();
    }

    private async Task<IEnumerable<Hremployee>> SearchEmployeesAsync(string term, CancellationToken ct)
    {
        await using var ctx = await DbFactory.CreateDbContextAsync(ct);
        var query = ctx.Hremployee.Where(e => _companyId == null || e.companyid == _companyId);
        if (!string.IsNullOrWhiteSpace(term))
            query = query.Where(e => e.EmpNo.Contains(term) || (e.EmpName != null && e.EmpName.Contains(term)) || (e.EmpSurname != null && e.EmpSurname.Contains(term)));
        return await query.OrderBy(e => e.EmpNo).Take(20).ToListAsync(ct);
    }

    private async Task OnEmployeeChangedAsync(Hremployee? emp)
    {
        _selectedEmployee = emp;
        _overrides = new();
        await LoadAsync();
    }

    private async Task AddOverrideAsync()
    {
        if (_selectedEmployee is null) return;
        if (await RequireRightAsync(ProgramRoleService.ProgramAction.Create) is string denied) { Snackbar.Add(denied, Severity.Error); return; }
        if (_ovScheduleId is null || _ovFrom is null) { Snackbar.Add("เลือกรอบจ่ายและวันที่มีผล", Severity.Warning); return; }
        await using var ctx = await DbFactory.CreateDbContextAsync();
        ctx.Pay_EmployeePayScheduleOverrides.Add(new Pay_EmployeePayScheduleOverride
        {
            HremployeeId = _selectedEmployee.id, PayScheduleId = _ovScheduleId.Value,
            EffectiveFrom = DateOnly.FromDateTime(_ovFrom.Value), EffectiveTo = _ovTo is null ? null : DateOnly.FromDateTime(_ovTo.Value),
            Note = string.IsNullOrWhiteSpace(_ovNote) ? null : _ovNote.Trim(), IsActive = true,
            EnteredByUserId = _actorUserId, EnteredDate = DateTime.Now,
        });
        await ctx.SaveChangesAsync();
        Snackbar.Add("บันทึกการทับรายคนแล้ว", Severity.Success);
        _ovNote = null;
        await LoadAsync();
    }

    private async Task DeactivateOverrideAsync(Pay_EmployeePayScheduleOverride o)
    {
        if (await RequireRightAsync(ProgramRoleService.ProgramAction.Edit) is string denied) { Snackbar.Add(denied, Severity.Error); return; }
        await using var ctx = await DbFactory.CreateDbContextAsync();
        var row = await ctx.Pay_EmployeePayScheduleOverrides.FirstOrDefaultAsync(x => x.Id == o.Id);
        if (row is null) return;
        row.IsActive = false;
        await ctx.SaveChangesAsync();
        await LoadAsync();
    }
}
