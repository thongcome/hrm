@page "/pay/admin/welfare-fund-policy"
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Pay.Calculators
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@inject JsonLocalizationService L
@attribute [Authorize(Policy = "Menu:PAY_ADMIN")]

<PageTitle>@L.Translate("WelfareFundPageTitle")</PageTitle>

<MudPaper Class="pa-4 mb-4" MaxWidth="900px">
    <MudText Typo="Typo.h5">@L.Translate("WelfareFundHeading")</MudText>
    <MudAlert Severity="Severity.Warning" Class="mt-2">
        @((MarkupString)L.Translate("WelfareFundLegalAlert"))
    </MudAlert>

    @if (string.IsNullOrEmpty(_companyId))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">@L.Translate("CompanyNotLinkedError")</MudAlert>
        return;
    }

    <MudDivider Class="my-4" />

    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.h6">@(_editingId is null ? L.Translate("AddNewRateRangeHeading") : L.Translate("EditRateRangeHeading"))</MudText>
        @if (!_showForm)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="OpenCreate">+ @L.Translate("AddRateRangeButton")</MudButton>
        }
    </MudStack>

    @if (_showForm)
    {
        <MudGrid Class="mt-1">
            <MudItem xs="12" sm="6"><MudDatePicker Label="@L.Translate("EffectiveFromLabel")" @bind-Date="_effectiveFrom" Editable="true" DateFormat="dd/MM/yyyy" /></MudItem>
            <MudItem xs="12" sm="6"><MudDatePicker Label="@L.Translate("EffectiveToLabel")" @bind-Date="_effectiveTo" Editable="true" DateFormat="dd/MM/yyyy" /></MudItem>
            <MudItem xs="12" sm="4"><MudNumericField T="decimal" @bind-Value="_employeeRate" Label="@L.Translate("EmployeeRatePercentLabel")" Format="0.00" Min="0" Max="100" /></MudItem>
            <MudItem xs="12" sm="4"><MudNumericField T="decimal" @bind-Value="_companyRate" Label="@L.Translate("CompanyRatePercentLabel")" Format="0.00" Min="0" Max="100" /></MudItem>
            <MudItem xs="12" sm="4"><MudNumericField T="decimal?" @bind-Value="_wageCap" Label="@L.Translate("WageCapLabel")" Format="N2" Min="0" /></MudItem>
            <MudItem xs="12">
                <MudSwitch T="bool" @bind-Value="_isEnabled" Color="Color.Warning" Label="@L.Translate("EnableSwitchLabel")" />
            </MudItem>
            <MudItem xs="12"><MudTextField @bind-Value="_note" Label="@L.Translate("NoteSourceLabel")" Lines="2" /></MudItem>
        </MudGrid>

        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
        }

        <MudStack Row="true" Spacing="2" Class="mt-3">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">
                @(_editingId is null ? L.Translate("AddRateRangeButton") : L.Translate("SaveEditButton"))
            </MudButton>
            <MudButton Variant="Variant.Text" OnClick="CancelEdit">@L.Translate("CancelButton")</MudButton>
        </MudStack>
    }

    <MudDivider Class="my-5" />

    <MudTable Items="_policies" Dense="true" Hover="true">
        <HeaderContent>
            <MudTh>@L.Translate("DateRangeLabel")</MudTh>
            <MudTh>@L.Translate("ColRateEmpCompany")</MudTh>
            <MudTh>@L.Translate("ColWageCap")</MudTh>
            <MudTh>@L.Translate("ColStatus")</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.EffectiveFrom.ToString("dd/MM/yyyy") - @(context.EffectiveTo?.ToString("dd/MM/yyyy") ?? L.Translate("NoDeadlineText"))</MudTd>
            <MudTd>@context.EmployeeContributionRate.ToString("0.00")% / @context.CompanyContributionRate.ToString("0.00")%</MudTd>
            <MudTd>@(context.WageCapPerMonth?.ToString("N2") ?? L.Translate("NoCapText"))</MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Color="@(context.IsEnabled ? Color.Warning : Color.Default)">
                    @(context.IsEnabled ? L.Translate("EnabledChip") : L.Translate("DisabledChip"))
                </MudChip>
            </MudTd>
            <MudTd>
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => StartEdit(context))">@L.Translate("EditButton")</MudButton>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2">@L.Translate("NoRatesConfiguredMessage")</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

<MudPaper Class="pa-4 mb-4" MaxWidth="900px">
    <MudText Typo="Typo.h6">@L.Translate("TestCalculationHeading")</MudText>
    <MudText Typo="Typo.body2" Class="mt-1">
        @L.Translate("TestCalculationDesc")
    </MudText>
    <MudGrid Class="mt-2">
        <MudItem xs="12" sm="6"><MudNumericField T="decimal" @bind-Value="_testWage" Label="@L.Translate("MonthlyWageLabel")" Format="N2" Min="0" /></MudItem>
        <MudItem xs="12" sm="6"><MudDatePicker Label="@L.Translate("TestDateLabel")" @bind-Date="_testDate" Editable="true" DateFormat="dd/MM/yyyy" /></MudItem>
    </MudGrid>
    <MudButton Color="Color.Secondary" Variant="Variant.Text" Class="mt-3" OnClick="RunPreview">@L.Translate("CalculateButton")</MudButton>

    @if (_previewResult is not null)
    {
        <MudAlert Severity="Severity.Info" Class="mt-3">
            @if (_previewResult.Value.Matched is null)
            {
                <text>@L.Translate("NoMatchingRateMessage")</text>
            }
            else
            {
                @((MarkupString)string.Format(L.Translate("PreviewMatchedTemplate"),
                    _previewResult.Value.Matched.EffectiveFrom.ToString("dd/MM/yyyy"),
                    _previewResult.Value.Matched.EffectiveTo?.ToString("dd/MM/yyyy") ?? L.Translate("NoDeadlineText"),
                    _previewResult.Value.Matched.EmployeeContributionRate.ToString("0.00"),
                    _previewResult.Value.Matched.CompanyContributionRate.ToString("0.00"),
                    _previewResult.Value.Result.EmployeeAmount.ToString("N2"),
                    _previewResult.Value.Result.CompanyAmount.ToString("N2")))
                @if (!_previewResult.Value.Matched.IsEnabled)
                {
                    <br />
                    <text><i>@L.Translate("StillDisabledNote")</i></text>
                }
            }
        </MudAlert>
    }
</MudPaper>

@code {
    private string? _companyId;
    private List<Pay_WelfareFundPolicy> _policies = new();
    private string? _error;
    private long? _editingId;
    private bool _showForm;

    private DateTime? _effectiveFrom = DateTime.Today;
    private DateTime? _effectiveTo;
    private decimal _employeeRate;
    private decimal _companyRate;
    private decimal? _wageCap;
    private bool _isEnabled;
    private string? _note;

    private decimal _testWage = 20000m;
    private DateTime? _testDate = new DateTime(2026, 10, 1);
    private (Pay_WelfareFundPolicy? Matched, WelfareFundCalculator.Result Result)? _previewResult;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
        if (string.IsNullOrWhiteSpace(_companyId)) return;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        _policies = await context.Pay_WelfareFundPolicies
            .Where(p => p.CompanyId == _companyId)
            .OrderBy(p => p.EffectiveFrom)
            .ToListAsync();
    }

    private void OpenCreate()
    {
        CancelEdit();
        _showForm = true;
    }

    private void StartEdit(Pay_WelfareFundPolicy policy)
    {
        _editingId = policy.Id;
        _effectiveFrom = policy.EffectiveFrom.ToDateTime(TimeOnly.MinValue);
        _effectiveTo = policy.EffectiveTo?.ToDateTime(TimeOnly.MinValue);
        _employeeRate = policy.EmployeeContributionRate;
        _companyRate = policy.CompanyContributionRate;
        _wageCap = policy.WageCapPerMonth;
        _isEnabled = policy.IsEnabled;
        _note = policy.Note;
        _error = null;
        _showForm = true;
    }

    private void CancelEdit()
    {
        _editingId = null;
        _effectiveFrom = DateTime.Today;
        _effectiveTo = null;
        _employeeRate = 0;
        _companyRate = 0;
        _wageCap = null;
        _isEnabled = false;
        _note = null;
        _error = null;
        _showForm = false;
    }

    private async Task SaveAsync()
    {
        _error = null;

        if (_effectiveFrom is null)
        {
            _error = L.Translate("InvalidEffectiveDateError");
            return;
        }
        if (_effectiveTo is not null && _effectiveTo < _effectiveFrom)
        {
            _error = L.Translate("EndDateBeforeStartError");
            return;
        }

        await using var context = await DbFactory.CreateDbContextAsync();

        var effectiveFrom = DateOnly.FromDateTime(_effectiveFrom.Value);
        var effectiveTo = _effectiveTo is not null ? DateOnly.FromDateTime(_effectiveTo.Value) : (DateOnly?)null;

        if (_editingId is long id)
        {
            var existing = await context.Pay_WelfareFundPolicies.FirstOrDefaultAsync(p => p.Id == id && p.CompanyId == _companyId);
            if (existing is null)
            {
                _error = L.Translate("RateRangeNotFoundError");
                return;
            }
            existing.EffectiveFrom = effectiveFrom;
            existing.EffectiveTo = effectiveTo;
            existing.EmployeeContributionRate = _employeeRate;
            existing.CompanyContributionRate = _companyRate;
            existing.WageCapPerMonth = _wageCap;
            existing.IsEnabled = _isEnabled;
            existing.Note = _note;
        }
        else
        {
            context.Pay_WelfareFundPolicies.Add(new Pay_WelfareFundPolicy
            {
                CompanyId = _companyId!,
                EffectiveFrom = effectiveFrom,
                EffectiveTo = effectiveTo,
                EmployeeContributionRate = _employeeRate,
                CompanyContributionRate = _companyRate,
                WageCapPerMonth = _wageCap,
                IsEnabled = _isEnabled,
                Note = _note,
            });
        }

        await context.SaveChangesAsync();
        Snackbar.Add(_editingId is null ? L.Translate("RateRangeAddedSuccess") : L.Translate("GradeEditSavedSuccess"), Severity.Success);
        CancelEdit();
        await LoadAsync();
    }

    private void RunPreview()
    {
        if (_testDate is null) return;

        var testDate = DateOnly.FromDateTime(_testDate.Value);
        var matched = _policies.FirstOrDefault(p =>
            p.EffectiveFrom <= testDate && (p.EffectiveTo == null || p.EffectiveTo >= testDate));

        if (matched is null)
        {
            _previewResult = (null, new WelfareFundCalculator.Result(0, 0));
            return;
        }

        var result = WelfareFundCalculator.Calculate(_testWage, matched.EmployeeContributionRate, matched.CompanyContributionRate, matched.WageCapPerMonth);
        _previewResult = (matched, result);
    }
}
