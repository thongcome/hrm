@page "/pay/admin/salary-grades"
@using System.Security.Claims
@using HRM.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@inject JsonLocalizationService L
@attribute [Authorize(Policy = "Menu:PAY_ADMIN")]

<PageTitle>@L.Translate("SalaryGradePageTitle")</PageTitle>

<MudPaper Class="pa-4 mb-4" MaxWidth="900px">
    <MudText Typo="Typo.h5">@L.Translate("SalaryGradeHeading")</MudText>
    <MudText Typo="Typo.body2" Class="mt-1">
        @L.Translate("SalaryGradeDesc")
    </MudText>

    @if (string.IsNullOrEmpty(_companyId))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">@L.Translate("CompanyNotLinkedError")</MudAlert>
        return;
    }

    <MudDivider Class="my-4" />

    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.h6">@(_editingId is null ? L.Translate("AddNewGradeHeading") : string.Format(L.Translate("EditGradeHeadingTemplate"), _form.GradeCode))</MudText>
        @if (!_showForm)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="OpenCreate">+ @L.Translate("AddGradeButton")</MudButton>
        }
    </MudStack>

    @if (_showForm)
    {
        <MudGrid Class="mt-1">
            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="_form.GradeCode" Label="@L.Translate("GradeCodeLabel")" Required="true" />
            </MudItem>
            <MudItem xs="12" sm="8">
                <MudTextField @bind-Value="_form.GradeName" Label="@L.Translate("GradeNameLabel")" Required="true" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudNumericField @bind-Value="_form.MinSalary" Label="@L.Translate("MinSalaryLabel")" Format="N2" Min="0" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudNumericField @bind-Value="_form.MidSalary" Label="@L.Translate("MidSalaryLabel")" Format="N2" Min="0" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudNumericField @bind-Value="_form.MaxSalary" Label="@L.Translate("MaxSalaryLabel")" Format="N2" Min="0" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudNumericField @bind-Value="_form.SortOrder" Label="@L.Translate("SortOrderLabel")" Min="0" />
            </MudItem>
        </MudGrid>

        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
        }

        <MudStack Row="true" Spacing="2" Class="mt-3">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">
                @(_editingId is null ? L.Translate("AddGradeButton") : L.Translate("SaveEditButton"))
            </MudButton>
            <MudButton Variant="Variant.Text" OnClick="CancelEdit">@L.Translate("CancelButton")</MudButton>
        </MudStack>
    }

    <MudDivider Class="my-5" />

    <MudTable Items="_grades" Dense="true" Hover="true">
        <HeaderContent>
            <MudTh>@L.Translate("ColCode")</MudTh>
            <MudTh>@L.Translate("GradeNameLabel")</MudTh>
            <MudTh>@L.Translate("SalaryRangeColHeader")</MudTh>
            <MudTh>@L.Translate("ColStatus")</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.GradeCode</MudTd>
            <MudTd>@context.GradeName</MudTd>
            <MudTd>@context.MinSalary.ToString("N2") - @context.MidSalary.ToString("N2") - @context.MaxSalary.ToString("N2")</MudTd>
            <MudTd>@(context.IsActive ? L.Translate("PeriodActiveStatus") : L.Translate("PeriodInactiveStatus"))</MudTd>
            <MudTd>
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => StartEdit(context))">@L.Translate("EditButton")</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => ToggleActiveAsync(context))">
                    @(context.IsActive ? L.Translate("DeactivateButton") : L.Translate("ActivateButton"))
                </MudButton>
            </MudTd>
        </RowTemplate>
    </MudTable>
</MudPaper>

@code {
    private string? _companyId;
    private List<Pay_SalaryGrade> _grades = new();
    private string? _error;
    private long? _editingId;
    private bool _showForm;

    private class GradeForm
    {
        public string GradeCode { get; set; } = "";
        public string GradeName { get; set; } = "";
        public decimal MinSalary { get; set; }
        public decimal MidSalary { get; set; }
        public decimal MaxSalary { get; set; }
        public int SortOrder { get; set; }
    }

    private GradeForm _form = new();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
        if (string.IsNullOrWhiteSpace(_companyId)) return;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        _grades = await context.Pay_SalaryGrades
            .Where(g => g.CompanyId == _companyId)
            .OrderBy(g => g.SortOrder).ThenBy(g => g.GradeCode)
            .ToListAsync();
    }

    private void OpenCreate()
    {
        _editingId = null;
        _form = new GradeForm();
        _error = null;
        _showForm = true;
    }

    private void StartEdit(Pay_SalaryGrade grade)
    {
        _editingId = grade.Id;
        _form = new GradeForm
        {
            GradeCode = grade.GradeCode,
            GradeName = grade.GradeName,
            MinSalary = grade.MinSalary,
            MidSalary = grade.MidSalary,
            MaxSalary = grade.MaxSalary,
            SortOrder = grade.SortOrder,
        };
        _error = null;
        _showForm = true;
    }

    private void CancelEdit()
    {
        _editingId = null;
        _form = new GradeForm();
        _error = null;
        _showForm = false;
    }

    private async Task SaveAsync()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_form.GradeCode) || string.IsNullOrWhiteSpace(_form.GradeName))
        {
            _error = L.Translate("FillGradeCodeNameError");
            return;
        }

        if (_form.MinSalary > _form.MidSalary || _form.MidSalary > _form.MaxSalary)
        {
            _error = L.Translate("SalaryRangeOrderError");
            return;
        }

        await using var context = await DbFactory.CreateDbContextAsync();

        var duplicate = await context.Pay_SalaryGrades.AnyAsync(g =>
            g.CompanyId == _companyId && g.GradeCode == _form.GradeCode && g.Id != (_editingId ?? 0));
        if (duplicate)
        {
            _error = string.Format(L.Translate("GradeCodeDuplicateErrorTemplate"), _form.GradeCode);
            return;
        }

        if (_editingId is long id)
        {
            var existing = await context.Pay_SalaryGrades.FirstOrDefaultAsync(g => g.Id == id && g.CompanyId == _companyId);
            if (existing is null)
            {
                _error = L.Translate("GradeNotFoundError");
                return;
            }
            existing.GradeCode = _form.GradeCode;
            existing.GradeName = _form.GradeName;
            existing.MinSalary = _form.MinSalary;
            existing.MidSalary = _form.MidSalary;
            existing.MaxSalary = _form.MaxSalary;
            existing.SortOrder = _form.SortOrder;
        }
        else
        {
            context.Pay_SalaryGrades.Add(new Pay_SalaryGrade
            {
                CompanyId = _companyId!,
                GradeCode = _form.GradeCode,
                GradeName = _form.GradeName,
                MinSalary = _form.MinSalary,
                MidSalary = _form.MidSalary,
                MaxSalary = _form.MaxSalary,
                SortOrder = _form.SortOrder,
                IsActive = true,
            });
        }

        await context.SaveChangesAsync();
        Snackbar.Add(_editingId is null ? L.Translate("GradeAddedSuccess") : L.Translate("GradeEditSavedSuccess"), Severity.Success);
        CancelEdit();
        await LoadAsync();
    }

    private async Task ToggleActiveAsync(Pay_SalaryGrade grade)
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var existing = await context.Pay_SalaryGrades.FirstOrDefaultAsync(g => g.Id == grade.Id && g.CompanyId == _companyId);
        if (existing is null) return;

        existing.IsActive = !existing.IsActive;
        await context.SaveChangesAsync();
        await LoadAsync();
    }
}
