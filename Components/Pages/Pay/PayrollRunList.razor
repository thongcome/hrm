@page "/pay/runs"
@using System.Security.Claims
@using HRM.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider
@attribute [Authorize(Policy = "Menu:PAY_RUNS")]

<PageTitle>รอบเงินเดือน (ใหม่)</PageTitle>

<MudPaper Class="pa-4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
        <MudText Typo="Typo.h5">รอบเงินเดือน</MudText>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" OnClick="GoToCreate">
            สร้างรอบใหม่
        </MudButton>
    </MudStack>

    <MudTable Items="_runs" Hover="true" Dense="true" Loading="_loading">
        <HeaderContent>
            <MudTh>บริษัท</MudTh>
            <MudTh>งวด</MudTh>
            <MudTh>ประเภท</MudTh>
            <MudTh>สถานะ</MudTh>
            <MudTh>วันที่จ่าย</MudTh>
            <MudTh>จำนวนพนักงาน</MudTh>
            <MudTh>ยอดสุทธิรวม</MudTh>
            <MudTh>รายการเฉพาะกิจ</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.CompanyId</MudTd>
            <MudTd>@context.PayrollPeriod</MudTd>
            <MudTd>@context.RunType</MudTd>
            <MudTd><MudChip T="string" Color="@StatusColor(context.Status)" Size="Size.Small">@context.Status</MudChip></MudTd>
            <MudTd>@context.PayDate.ToString("yyyy-MM-dd")</MudTd>
            <MudTd>@_employeeCounts.GetValueOrDefault(context.Id, 0)</MudTd>
            <MudTd>@_netTotals.GetValueOrDefault(context.Id, 0m).ToString("N2")</MudTd>
            <MudTd>
                @{
                    var pendingCount = _pendingAdhocCounts.GetValueOrDefault((context.CompanyId, context.PayrollPeriod), 0);
                }
                @if (pendingCount > 0)
                {
                    <MudChip T="string" Color="Color.Error" Size="Size.Small" Icon="@Icons.Material.Filled.Warning">
                        @pendingCount รายการยังไม่พร้อม
                    </MudChip>
                }
            </MudTd>
            <MudTd>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => GoToDetail(context.Id))">เปิด</MudButton>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>ยังไม่มีรอบเงินเดือน</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private List<Pay_PayrollRun> _runs = new();
    private Dictionary<long, int> _employeeCounts = new();
    private Dictionary<long, decimal> _netTotals = new();
    private Dictionary<(string CompanyId, string Period), int> _pendingAdhocCounts = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();

        // One sc_user resolves to exactly one company via empid ->
        // Hremployee.EmpNo (see PayrollCompanyResolver) — someone needing
        // more than one company gets a separate account per company. No
        // claim means no company link is set up yet, so they see nothing
        // rather than every company's payroll.
        var state = await AuthProvider.GetAuthenticationStateAsync();
        var companyId = state.User.FindFirstValue("payroll_company");

        _runs = await context.Pay_PayrollRuns
            .Where(r => r.CompanyId == companyId)
            .OrderByDescending(r => r.PayrollPeriod)
            .ThenByDescending(r => r.Id)
            .ToListAsync();

        var runIds = _runs.Select(r => r.Id).ToList();
        var grouped = await context.Pay_PayrollEmployees
            .Where(e => runIds.Contains(e.PayrollRunId))
            .GroupBy(e => e.PayrollRunId)
            .Select(g => new { RunId = g.Key, Count = g.Count(), Total = g.Sum(e => e.NetPay) })
            .ToListAsync();

        _employeeCounts = grouped.ToDictionary(g => g.RunId, g => g.Count);
        _netTotals = grouped.ToDictionary(g => g.RunId, g => g.Total);

        // pending/unapproved (or approved-but-not-yet-included) ad-hoc items,
        // grouped by company+period so every run row sharing that period
        // (including adjustment runs) shows the same warning
        var adhocGrouped = await context.Pay_AdhocPayItems
            .Where(a => a.Status == PayAdhocItemStatus.Pending || a.Status == PayAdhocItemStatus.Approved)
            .GroupBy(a => new { a.Hremployee.companyid, a.TargetPeriod })
            .Select(g => new { g.Key.companyid, g.Key.TargetPeriod, Count = g.Count() })
            .ToListAsync();
        _pendingAdhocCounts = adhocGrouped.ToDictionary(g => (g.companyid, g.TargetPeriod), g => g.Count);

        _loading = false;
    }

    private static Color StatusColor(PayrollRunStatus status) => status switch
    {
        PayrollRunStatus.Draft => Color.Default,
        PayrollRunStatus.Calculated => Color.Info,
        PayrollRunStatus.Reviewed => Color.Warning,
        PayrollRunStatus.Approved => Color.Tertiary,
        PayrollRunStatus.Posted => Color.Secondary,
        PayrollRunStatus.Paid => Color.Success,
        PayrollRunStatus.Cancelled => Color.Error,
        _ => Color.Default,
    };

    private void GoToCreate() => Navigation.NavigateTo("/pay/runs/create");
    private void GoToDetail(long id) => Navigation.NavigateTo($"/pay/runs/{id}");
}
