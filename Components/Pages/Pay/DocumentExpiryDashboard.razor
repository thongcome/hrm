@page "/pay/admin/document-expiry"
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Pay
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@inject DocumentExpiryService ExpiryService
@inject AuthenticationStateProvider AuthProvider
@inject JsonLocalizationService L
@attribute [Authorize(Policy = "Menu:PAY_ADMIN")]

<PageTitle>@L.Translate("NavPayDocExpiry")</PageTitle>

<MudPaper Class="pa-4 mb-4">
    <MudText Typo="Typo.h5">@L.Translate("NavPayDocExpiry")</MudText>

    @if (string.IsNullOrEmpty(_companyId))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">@L.Translate("CompanyNotLinkedError")</MudAlert>
        return;
    }

    <MudGrid Class="mt-3">
        <MudItem xs="12" sm="4">
            <MudNumericField @bind-Value="_daysAhead" Label="@L.Translate("DaysAheadLabel")" Min="1" Max="365" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="LoadAsync" Class="mt-2">@L.Translate("LoadDataButton")</MudButton>
        </MudItem>
    </MudGrid>

    @if (_loaded)
    {
        <MudGrid Class="mt-4">
            <MudItem xs="12" sm="4">
                <MudPaper Class="pa-3" Outlined="true">
                    <MudText Typo="Typo.h4" Color="Color.Error">@_rows.Count(r => r.Status == DocumentExpiryService.ExpiryStatus.Expired)</MudText>
                    <MudText Typo="Typo.caption">@L.Translate("ExpiryStatusExpired")</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudPaper Class="pa-3" Outlined="true">
                    <MudText Typo="Typo.h4" Color="Color.Warning">@_rows.Count(r => r.Status == DocumentExpiryService.ExpiryStatus.ExpiringSoon)</MudText>
                    <MudText Typo="Typo.caption">@L.Translate("ExpiringSoonWithin30Days")</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudPaper Class="pa-3" Outlined="true">
                    <MudText Typo="Typo.h4">@_rows.Count</MudText>
                    <MudText Typo="Typo.caption">@L.Translate("TotalInSelectedRange")</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        @if (_rows.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mt-4" Style="opacity:.7;">@L.Translate("NoExpiringDocumentsMessage")</MudText>
        }
        else
        {
            <MudSimpleTable Dense="true" Class="mt-4">
                <thead>
                    <tr><th>@L.Translate("EmpNoLabel")</th><th>@L.Translate("ColName")</th><th>@L.Translate("DocumentTypeLabel")</th><th>@L.Translate("ExpiryDateLabel")</th><th>@L.Translate("DaysRemainingLabel")</th><th>@L.Translate("ColStatus")</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var row in _rows)
                    {
                        <tr>
                            <td>@row.EmpNo</td>
                            <td>@row.EmpName</td>
                            <td>@DocTypeLabel(row.DocumentType)</td>
                            <td>@row.ExpiryDate.ToString("dd/MM/yyyy")</td>
                            <td>@row.DaysRemaining</td>
                            <td><MudChip T="string" Size="Size.Small" Color="@StatusColor(row.Status)">@StatusLabel(row.Status)</MudChip></td>
                            <td><MudLink Href="@($"/pay/employees/{row.HremployeeId}")">@L.Translate("GoToEmployeeDataLink")</MudLink></td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    }
</MudPaper>

@code {
    private string? _companyId;
    private int _daysAhead = 30;
    private bool _loaded;
    private List<DocumentExpiryService.ExpiryRow> _rows = new();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
        if (string.IsNullOrWhiteSpace(_companyId)) return;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (string.IsNullOrWhiteSpace(_companyId)) return;

        _rows = await ExpiryService.GetExpiringDocumentsAsync(_companyId, _daysAhead);
        _loaded = true;
    }

    private string DocTypeLabel(Pay_EmployeeDocumentType type) => type switch
    {
        Pay_EmployeeDocumentType.IdCard => L.Translate("DocTypeIdCard"),
        Pay_EmployeeDocumentType.Contract => L.Translate("DocTypeContract"),
        Pay_EmployeeDocumentType.EducationCertificate => L.Translate("DocTypeEducationCertificate"),
        Pay_EmployeeDocumentType.ResignationLetter => L.Translate("DocTypeResignationLetter"),
        Pay_EmployeeDocumentType.BankBook => L.Translate("DocTypeBankBook"),
        Pay_EmployeeDocumentType.WorkPermit => L.Translate("DocTypeWorkPermit"),
        Pay_EmployeeDocumentType.Visa => L.Translate("DocTypeVisa"),
        Pay_EmployeeDocumentType.DrivingLicense => L.Translate("DocTypeDrivingLicense"),
        Pay_EmployeeDocumentType.ProfessionalLicense => L.Translate("DocTypeProfessionalLicense"),
        _ => L.Translate("DocTypeOther"),
    };

    private string StatusLabel(DocumentExpiryService.ExpiryStatus status) => status switch
    {
        DocumentExpiryService.ExpiryStatus.Expired => L.Translate("ExpiryStatusExpired"),
        DocumentExpiryService.ExpiryStatus.ExpiringSoon => L.Translate("ExpiryStatusExpiringSoon"),
        _ => L.Translate("ExpiryStatusNormal"),
    };

    private static Color StatusColor(DocumentExpiryService.ExpiryStatus status) => status switch
    {
        DocumentExpiryService.ExpiryStatus.Expired => Color.Error,
        DocumentExpiryService.ExpiryStatus.ExpiringSoon => Color.Warning,
        _ => Color.Default,
    };
}
