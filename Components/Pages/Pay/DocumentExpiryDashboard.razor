@page "/pay/admin/document-expiry"
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Pay
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@inject DocumentExpiryService ExpiryService
@inject AuthenticationStateProvider AuthProvider
@attribute [Authorize(Policy = "Menu:PAY_ADMIN")]

<PageTitle>เอกสารใกล้หมดอายุ</PageTitle>

<MudPaper Class="pa-4 mb-4">
    <MudText Typo="Typo.h5">เอกสารใกล้หมดอายุ</MudText>

    @if (string.IsNullOrEmpty(_companyId))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">บัญชีของคุณยังไม่ได้ผูกกับบริษัทใดๆ — ติดต่อแอดมินให้ตั้งค่า empid ก่อน</MudAlert>
        return;
    }

    <MudGrid Class="mt-3">
        <MudItem xs="12" sm="4">
            <MudNumericField @bind-Value="_daysAhead" Label="แสดงล่วงหน้ากี่วัน" Min="1" Max="365" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="LoadAsync" Class="mt-2">โหลดข้อมูล</MudButton>
        </MudItem>
    </MudGrid>

    @if (_loaded)
    {
        <MudGrid Class="mt-4">
            <MudItem xs="12" sm="4">
                <MudPaper Class="pa-3" Outlined="true">
                    <MudText Typo="Typo.h4" Color="Color.Error">@_rows.Count(r => r.Status == DocumentExpiryService.ExpiryStatus.Expired)</MudText>
                    <MudText Typo="Typo.caption">หมดอายุแล้ว</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudPaper Class="pa-3" Outlined="true">
                    <MudText Typo="Typo.h4" Color="Color.Warning">@_rows.Count(r => r.Status == DocumentExpiryService.ExpiryStatus.ExpiringSoon)</MudText>
                    <MudText Typo="Typo.caption">ใกล้หมดอายุ (ภายใน 30 วัน)</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudPaper Class="pa-3" Outlined="true">
                    <MudText Typo="Typo.h4">@_rows.Count</MudText>
                    <MudText Typo="Typo.caption">รวมทั้งหมดในช่วงที่เลือก</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        @if (_rows.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mt-4" Style="opacity:.7;">ไม่พบเอกสารที่หมดอายุหรือใกล้หมดอายุในช่วงที่เลือก</MudText>
        }
        else
        {
            <MudSimpleTable Dense="true" Class="mt-4">
                <thead>
                    <tr><th>รหัสพนักงาน</th><th>ชื่อ</th><th>ประเภทเอกสาร</th><th>วันหมดอายุ</th><th>เหลือกี่วัน</th><th>สถานะ</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var row in _rows)
                    {
                        <tr>
                            <td>@row.EmpNo</td>
                            <td>@row.EmpName</td>
                            <td>@DocTypeLabel(row.DocumentType)</td>
                            <td>@row.ExpiryDate.ToString("dd/MM/yyyy")</td>
                            <td>@row.DaysRemaining</td>
                            <td><MudChip T="string" Size="Size.Small" Color="@StatusColor(row.Status)">@StatusLabel(row.Status)</MudChip></td>
                            <td><MudLink Href="@($"/pay/employees/{row.HremployeeId}")">ไปที่ข้อมูลพนักงาน</MudLink></td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    }
</MudPaper>

@code {
    private string? _companyId;
    private int _daysAhead = 30;
    private bool _loaded;
    private List<DocumentExpiryService.ExpiryRow> _rows = new();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
        if (string.IsNullOrWhiteSpace(_companyId)) return;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (string.IsNullOrWhiteSpace(_companyId)) return;

        _rows = await ExpiryService.GetExpiringDocumentsAsync(_companyId, _daysAhead);
        _loaded = true;
    }

    private static string DocTypeLabel(Pay_EmployeeDocumentType type) => type switch
    {
        Pay_EmployeeDocumentType.IdCard => "บัตรประชาชน",
        Pay_EmployeeDocumentType.Contract => "สัญญาจ้าง",
        Pay_EmployeeDocumentType.EducationCertificate => "วุฒิการศึกษา",
        Pay_EmployeeDocumentType.ResignationLetter => "ใบลาออก",
        Pay_EmployeeDocumentType.BankBook => "สมุดบัญชีธนาคาร",
        Pay_EmployeeDocumentType.WorkPermit => "ใบอนุญาตทำงาน",
        Pay_EmployeeDocumentType.Visa => "วีซ่า",
        Pay_EmployeeDocumentType.DrivingLicense => "ใบขับขี่",
        Pay_EmployeeDocumentType.ProfessionalLicense => "ใบประกอบวิชาชีพ",
        _ => "อื่นๆ",
    };

    private static string StatusLabel(DocumentExpiryService.ExpiryStatus status) => status switch
    {
        DocumentExpiryService.ExpiryStatus.Expired => "หมดอายุแล้ว",
        DocumentExpiryService.ExpiryStatus.ExpiringSoon => "ใกล้หมดอายุ",
        _ => "ปกติ",
    };

    private static Color StatusColor(DocumentExpiryService.ExpiryStatus status) => status switch
    {
        DocumentExpiryService.ExpiryStatus.Expired => Color.Error,
        DocumentExpiryService.ExpiryStatus.ExpiringSoon => Color.Warning,
        _ => Color.Default,
    };
}
