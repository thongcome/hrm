@page "/pay/admin/tax-deduction-config"
@using HRM.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject ISnackbar Snackbar
@attribute [Authorize(Policy = "Menu:PAY_ADMIN")]
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthProvider
@inject HRM.Services.Security.ProgramRoleService ProgramRoles

<PageTitle>ตั้งค่าค่าลดหย่อนภาษี</PageTitle>
@if (_rights is not null && !_rights.CanEdit)
{
    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">หน้านี้ยังไม่ได้เปิดสิทธิ์แก้ไขให้บทบาทของคุณ — ดูได้อย่างเดียว</MudAlert>
}

<MudPaper Class="pa-4 mb-4" MaxWidth="900px">
    <MudText Typo="Typo.h5">ตั้งค่าค่าลดหย่อนภาษี (Tax Deduction Config)</MudText>
    <MudText Typo="Typo.body2" Class="mt-1">
        ตั้งค่าต่อปีภาษี — ค่าลดหย่อนมาตรฐาน (บังคับใช้กับพนักงานทุกคนอัตโนมัติ) และประเภทลดหย่อนพิเศษที่ HR เพิ่มเองได้ (พนักงานเลือกใช้สิทธิที่หน้า "ค่าลดหย่อนภาษีพนักงาน")
    </MudText>

    <MudGrid Class="mt-3">
        <MudItem xs="12" sm="4">
            <MudNumericField T="int" @bind-Value="_selectedYear" @bind-Value:after="LoadAsync" Label="ปีภาษี (ค.ศ.)" Min="2020" Max="2100" />
        </MudItem>
    </MudGrid>

    <MudDivider Class="my-4" />

    <MudText Typo="Typo.h6" Class="mb-2">ค่าลดหย่อนมาตรฐาน (บังคับ ใช้กับทุกคนอัตโนมัติ)</MudText>
    <MudGrid Class="mt-1">
        <MudItem xs="12" sm="4">
            <MudNumericField T="decimal" @bind-Value="_personalAllowance" Label="ค่าลดหย่อนส่วนตัว (บาท/ปี)" Format="N2" Min="0" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudNumericField T="decimal" @bind-Value="_expenseRatePercent" Label="อัตราค่าใช้จ่าย (%)" Format="0.##" Min="0" Max="100" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudNumericField T="decimal" @bind-Value="_expenseCap" Label="เพดานค่าใช้จ่าย (บาท/ปี)" Format="N2" Min="0" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudNumericField T="decimal" @bind-Value="_pfCap" Label="เพดานลดหย่อนเงินสะสมกองทุนสำรองเลี้ยงชีพ (บาท/ปี)" Format="N2" Min="0" />
        </MudItem>
        <MudItem xs="12">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveSettingAsync" Disabled="@(_rights?.CanEdit != true)">บันทึกค่าลดหย่อนมาตรฐานปี @_selectedYear</MudButton>
        </MudItem>
    </MudGrid>

    @if (!string.IsNullOrEmpty(_settingInfo))
    {
        <MudAlert Severity="Severity.Success" Class="mt-3" Dense="true">@_settingInfo</MudAlert>
    }

    <MudDivider Class="my-5" />

    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
        <MudText Typo="Typo.h6">ประเภทลดหย่อนที่พนักงานแจ้งได้ ปี @_selectedYear (แบบ ล.ย.01)</MudText>
        @if (_rights?.CanCreate == true)
        {
            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="CopyFromPreviousYearAsync">คัดลอกจากปี @(_selectedYear - 1)</MudButton>
        }
    </MudStack>
    <MudText Typo="Typo.caption" Class="mb-2">ค่าเริ่มต้นตามประมวลรัษฎากร ม.47 — ตรวจตัวเลขกับประกาศกรมสรรพากรของปีนั้นก่อนใช้จริง แก้ได้ทุกช่อง</MudText>
    <MudTable Items="_types" Dense="true" Hover="true">
        <HeaderContent>
            <MudTh>รหัส</MudTh>
            <MudTh>ชื่อ</MudTh>
            <MudTh>วิธีคิด</MudTh>
            <MudTh>เพดานกลุ่ม</MudTh>
            <MudTh>สถานะ</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Code</MudTd>
            <MudTd>@context.NameTh</MudTd>
            <MudTd>@RuleText(context)</MudTd>
            <MudTd>@(string.IsNullOrWhiteSpace(context.CapGroup) ? "-" : $"{context.CapGroup} {context.GroupCapPerYear:N0}")</MudTd>
            <MudTd>@(context.IsActive ? "ใช้งาน" : "ปิดใช้งาน")</MudTd>
            <MudTd>
                @if (_rights?.CanEdit == true)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => StartEditType(context))">แก้ไข</MudButton>
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2">ยังไม่มีประเภทลดหย่อนสำหรับปีนี้ — กด "คัดลอกจากปี @(_selectedYear - 1)" หรือเพิ่มใหม่ด้านล่าง</MudText>
        </NoRecordsContent>
    </MudTable>

    <MudDivider Class="my-4" />
    <MudText Typo="Typo.subtitle1" Class="mb-2">@(_editingTypeId is null ? "เพิ่มประเภทลดหย่อนใหม่" : $"แก้ไข {_form.Code}")</MudText>
    <MudGrid>
        <MudItem xs="12" sm="3"><MudTextField T="string" @bind-Value="_form.Code" Label="รหัส (Code)" Disabled="@(_editingTypeId is not null)" /></MudItem>
        <MudItem xs="12" sm="5"><MudTextField T="string" @bind-Value="_form.NameTh" Label="ชื่อ (ไทย)" /></MudItem>
        <MudItem xs="12" sm="4"><MudTextField T="string" @bind-Value="_form.NameEn" Label="Name (English)" /></MudItem>
        <MudItem xs="12" sm="4">
            <MudSelect T="TaxDeductionCalcMethod" @bind-Value="_form.CalcMethod" Label="วิธีคิด">
                <MudSelectItem T="TaxDeductionCalcMethod" Value="TaxDeductionCalcMethod.FixedCap">จำนวนที่จ่ายจริง ไม่เกินเพดาน</MudSelectItem>
                <MudSelectItem T="TaxDeductionCalcMethod" Value="TaxDeductionCalcMethod.PerPerson">ต่อคน × จำนวนคน</MudSelectItem>
                <MudSelectItem T="TaxDeductionCalcMethod" Value="TaxDeductionCalcMethod.PercentOfIncome">% ของเงินได้</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="4"><MudNumericField T="decimal" @bind-Value="_form.MaxAmountPerYear" Label="เพดาน/ปี (บาท, 0 = ไม่จำกัด)" Format="N2" Min="0" /></MudItem>
        <MudItem xs="12" sm="4"><MudNumericField T="int" @bind-Value="_form.SortOrder" Label="ลำดับ" /></MudItem>
        @if (_form.CalcMethod == TaxDeductionCalcMethod.PerPerson)
        {
            <MudItem xs="12" sm="4"><MudNumericField T="decimal?" @bind-Value="_form.AmountPerPerson" Label="บาทต่อคน" Format="N2" Min="0" /></MudItem>
            <MudItem xs="12" sm="4"><MudNumericField T="int?" @bind-Value="_form.MaxPersons" Label="นับได้ไม่เกิน (คน, ว่าง = ไม่จำกัด)" Min="1" /></MudItem>
        }
        @if (_form.CalcMethod == TaxDeductionCalcMethod.PercentOfIncome)
        {
            <MudItem xs="12" sm="4"><MudNumericField T="decimal?" @bind-Value="_form.PercentCap" Label="ไม่เกิน % ของฐาน" Format="0.##" Min="0" Max="100" /></MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="TaxDeductionPercentBase?" @bind-Value="_form.PercentBase" Label="ฐาน %">
                    <MudSelectItem T="TaxDeductionPercentBase?" Value="TaxDeductionPercentBase.AssessableIncome">เงินได้พึงประเมินทั้งปี</MudSelectItem>
                    <MudSelectItem T="TaxDeductionPercentBase?" Value="TaxDeductionPercentBase.NetIncomeAfterDeductions">เงินได้หลังหักค่าใช้จ่ายและลดหย่อน (บริจาค)</MudSelectItem>
                </MudSelect>
            </MudItem>
        }
        <MudItem xs="12" sm="4"><MudTextField T="string" @bind-Value="_form.CapGroup" Label="กลุ่มเพดานร่วม (เช่น RETIREMENT, LIFE_HEALTH)" /></MudItem>
        <MudItem xs="12" sm="4"><MudNumericField T="decimal?" @bind-Value="_form.GroupCapPerYear" Label="เพดานรวมของกลุ่ม (บาท/ปี)" Format="N2" Min="0" /></MudItem>
        <MudItem xs="12" sm="4"><MudCheckBox T="bool" @bind-Value="_form.IsActive" Label="ใช้งาน" /></MudItem>
        <MudItem xs="12">
            @if (_editingTypeId is null)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="AddTypeAsync" Disabled="@(_rights?.CanCreate != true)">+ เพิ่มประเภทลดหย่อน</MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveTypeAsync">บันทึก</MudButton>
                <MudButton Variant="Variant.Text" OnClick="CancelEditType">ยกเลิก</MudButton>
            }
        </MudItem>
    </MudGrid>

    @if (!string.IsNullOrEmpty(_error))
    {
        <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
    }
</MudPaper>

@code {
    private int _selectedYear = DateTime.Today.Year;

    private decimal _personalAllowance = 60000m;
    private decimal _expenseRatePercent = 50m;
    private decimal _expenseCap = 100000m;
    private decimal _pfCap = 500000m;
    private string? _settingInfo;

    private List<Pay_TaxDeductionType> _types = new();
    private long? _editingTypeId;
    private Pay_TaxDeductionType _form = NewForm();

    private static Pay_TaxDeductionType NewForm() => new() { Code = "", NameTh = "", NameEn = "", IsActive = true };

    private static string RuleText(Pay_TaxDeductionType t) => t.CalcMethod switch
    {
        TaxDeductionCalcMethod.PerPerson => $"คนละ {t.AmountPerPerson:N0}{(t.MaxPersons is int m ? $" ไม่เกิน {m} คน" : "")}",
        TaxDeductionCalcMethod.PercentOfIncome => $"ไม่เกิน {t.PercentCap:0.##}% ของ{(t.PercentBase == TaxDeductionPercentBase.NetIncomeAfterDeductions ? "เงินได้สุทธิ" : "เงินได้")}{(t.MaxAmountPerYear > 0 ? $" และ {t.MaxAmountPerYear:N0}" : "")}",
        _ => t.MaxAmountPerYear > 0 ? $"ตามจ่าย ไม่เกิน {t.MaxAmountPerYear:N0}" : "ตามจ่าย",
    };

    private string? _error;

    private const string ProgramPath = "/pay/admin/tax-deduction-config";
    private HRM.Services.Security.ProgramRoleService.ProgramRights? _rights;

    private async Task<bool> RequireRightAsync(HRM.Services.Security.ProgramRoleService.ProgramAction action)
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        try { await ProgramRoles.RequireAsync(state.User, ProgramPath, action); return true; }
        catch (InvalidOperationException ex) { Snackbar.Add(ex.Message, Severity.Warning); return false; }
    }

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _rights = await ProgramRoles.GetRightsAsync(state.User, ProgramPath);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _settingInfo = null;
        _error = null;
        await using var context = await DbFactory.CreateDbContextAsync();

        var setting = await context.Pay_TaxDeductionSettings.FirstOrDefaultAsync(s => s.EffectiveYear == _selectedYear);
        if (setting is not null)
        {
            _personalAllowance = setting.PersonalAllowancePerYear;
            _expenseRatePercent = setting.ExpenseDeductionRate * 100m;
            _expenseCap = setting.ExpenseDeductionCap;
            _pfCap = setting.ProvidentFundDeductionCapPerYear;
        }
        else
        {
            // No row for this year yet — show the current legal defaults as a
            // starting point (matches PayrollCalculationService.cs's own
            // fallback so what HR sees here is what would actually apply).
            _personalAllowance = 60000m;
            _expenseRatePercent = 50m;
            _expenseCap = 100000m;
            _pfCap = 500000m;
        }

        _types = await context.Pay_TaxDeductionTypes
            .Where(t => t.EffectiveYear == _selectedYear)
            .OrderBy(t => t.SortOrder).ThenBy(t => t.Code)
            .ToListAsync();
    }

    private async Task SaveSettingAsync()
    {
        if (!await RequireRightAsync(HRM.Services.Security.ProgramRoleService.ProgramAction.Edit)) return;
        _error = null;
        await using var context = await DbFactory.CreateDbContextAsync();
        var existing = await context.Pay_TaxDeductionSettings.FirstOrDefaultAsync(s => s.EffectiveYear == _selectedYear);
        if (existing is null)
        {
            context.Pay_TaxDeductionSettings.Add(new Pay_TaxDeductionSetting
            {
                EffectiveYear = _selectedYear,
                PersonalAllowancePerYear = _personalAllowance,
                ExpenseDeductionRate = _expenseRatePercent / 100m,
                ExpenseDeductionCap = _expenseCap,
                ProvidentFundDeductionCapPerYear = _pfCap,
                IsActive = true,
            });
        }
        else
        {
            existing.PersonalAllowancePerYear = _personalAllowance;
            existing.ExpenseDeductionRate = _expenseRatePercent / 100m;
            existing.ExpenseDeductionCap = _expenseCap;
            existing.ProvidentFundDeductionCapPerYear = _pfCap;
        }
        await context.SaveChangesAsync();

        _settingInfo = $"บันทึกค่าลดหย่อนมาตรฐานปี {_selectedYear} เรียบร้อย";
        Snackbar.Add(_settingInfo, Severity.Success);
    }

    private void StartEditType(Pay_TaxDeductionType type)
    {
        _editingTypeId = type.Id;
        _form = new Pay_TaxDeductionType
        {
            Code = type.Code, NameTh = type.NameTh, NameEn = type.NameEn, MaxAmountPerYear = type.MaxAmountPerYear,
            CalcMethod = type.CalcMethod, AmountPerPerson = type.AmountPerPerson, MaxPersons = type.MaxPersons,
            PercentCap = type.PercentCap, PercentBase = type.PercentBase, CapGroup = type.CapGroup,
            GroupCapPerYear = type.GroupCapPerYear, IsActive = type.IsActive, SortOrder = type.SortOrder,
        };
        _error = null;
    }

    private void CancelEditType()
    {
        _editingTypeId = null;
        _form = NewForm();
        _error = null;
    }

    private string? ValidateForm()
    {
        if (string.IsNullOrWhiteSpace(_form.Code) || string.IsNullOrWhiteSpace(_form.NameTh) || string.IsNullOrWhiteSpace(_form.NameEn))
            return "กรุณากรอกรหัสและชื่อให้ครบ";
        if (_form.CalcMethod == TaxDeductionCalcMethod.PerPerson && (_form.AmountPerPerson ?? 0m) <= 0m)
            return "วิธีต่อคนต้องระบุบาทต่อคน";
        if (_form.CalcMethod == TaxDeductionCalcMethod.PercentOfIncome && ((_form.PercentCap ?? 0m) <= 0m || _form.PercentBase is null))
            return "วิธี % ต้องระบุเปอร์เซ็นต์และฐาน";
        if (!string.IsNullOrWhiteSpace(_form.CapGroup) && (_form.GroupCapPerYear ?? 0m) <= 0m)
            return "ระบุกลุ่มเพดานร่วมแล้วต้องระบุเพดานรวมของกลุ่มด้วย";
        return null;
    }

    private static void CopyRule(Pay_TaxDeductionType from, Pay_TaxDeductionType to)
    {
        to.NameTh = from.NameTh.Trim();
        to.NameEn = from.NameEn.Trim();
        to.MaxAmountPerYear = from.MaxAmountPerYear;
        to.CalcMethod = from.CalcMethod;
        to.AmountPerPerson = from.CalcMethod == TaxDeductionCalcMethod.PerPerson ? from.AmountPerPerson : null;
        to.MaxPersons = from.CalcMethod == TaxDeductionCalcMethod.PerPerson ? from.MaxPersons : null;
        to.PercentCap = from.CalcMethod == TaxDeductionCalcMethod.PercentOfIncome ? from.PercentCap : null;
        to.PercentBase = from.CalcMethod == TaxDeductionCalcMethod.PercentOfIncome ? from.PercentBase : null;
        to.CapGroup = string.IsNullOrWhiteSpace(from.CapGroup) ? null : from.CapGroup.Trim().ToUpperInvariant();
        to.GroupCapPerYear = to.CapGroup is null ? null : from.GroupCapPerYear;
        to.IsActive = from.IsActive;
        to.SortOrder = from.SortOrder;
    }

    private async Task SaveTypeAsync()
    {
        if (!await RequireRightAsync(HRM.Services.Security.ProgramRoleService.ProgramAction.Edit)) return;
        if (_editingTypeId is not long id) return;
        if (ValidateForm() is string problem) { _error = problem; return; }

        await using var context = await DbFactory.CreateDbContextAsync();
        var existing = await context.Pay_TaxDeductionTypes.FirstOrDefaultAsync(t => t.Id == id);
        if (existing is null)
        {
            _error = "ไม่พบประเภทลดหย่อนที่ต้องการแก้ไข";
            return;
        }
        CopyRule(_form, existing);
        await context.SaveChangesAsync();

        Snackbar.Add("บันทึกประเภทลดหย่อนเรียบร้อย", Severity.Success);
        CancelEditType();
        await LoadAsync();
    }

    private async Task AddTypeAsync()
    {
        if (!await RequireRightAsync(HRM.Services.Security.ProgramRoleService.ProgramAction.Create)) return;
        _error = null;
        if (ValidateForm() is string problem) { _error = problem; return; }

        var code = _form.Code.Trim().ToUpperInvariant();
        await using var context = await DbFactory.CreateDbContextAsync();
        if (await context.Pay_TaxDeductionTypes.AnyAsync(t => t.Code == code && t.EffectiveYear == _selectedYear))
        {
            _error = $"มีรหัส '{code}' สำหรับปี {_selectedYear} อยู่แล้ว";
            return;
        }
        var row = new Pay_TaxDeductionType { Code = code, EffectiveYear = _selectedYear, NameTh = "", NameEn = "" };
        CopyRule(_form, row);
        context.Pay_TaxDeductionTypes.Add(row);
        await context.SaveChangesAsync();

        Snackbar.Add("เพิ่มประเภทลดหย่อนใหม่เรียบร้อย", Severity.Success);
        CancelEditType();
        await LoadAsync();
    }

    // ตั้งค่าปีใหม่: คัดลอกค่าลดหย่อนมาตรฐานและทุกประเภทของปีก่อนที่ปีนี้ยังไม่มี (ไม่ทับรายการที่ตั้งไว้แล้ว) แล้วค่อยแก้ตัวเลขที่เปลี่ยน
    private async Task CopyFromPreviousYearAsync()
    {
        if (!await RequireRightAsync(HRM.Services.Security.ProgramRoleService.ProgramAction.Create)) return;
        var fromYear = _selectedYear - 1;
        await using var context = await DbFactory.CreateDbContextAsync();
        var source = await context.Pay_TaxDeductionTypes.AsNoTracking().Where(t => t.EffectiveYear == fromYear).ToListAsync();
        var have = (await context.Pay_TaxDeductionTypes.Where(t => t.EffectiveYear == _selectedYear).Select(t => t.Code).ToListAsync())
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        var added = 0;
        foreach (var t in source.Where(t => !have.Contains(t.Code)))
        {
            var row = new Pay_TaxDeductionType { Code = t.Code, EffectiveYear = _selectedYear, NameTh = "", NameEn = "" };
            CopyRule(t, row);
            context.Pay_TaxDeductionTypes.Add(row);
            added++;
        }
        if (!await context.Pay_TaxDeductionSettings.AnyAsync(x => x.EffectiveYear == _selectedYear)
            && await context.Pay_TaxDeductionSettings.AsNoTracking().FirstOrDefaultAsync(x => x.EffectiveYear == fromYear) is { } prev)
        {
            context.Pay_TaxDeductionSettings.Add(new Pay_TaxDeductionSetting
            {
                EffectiveYear = _selectedYear,
                PersonalAllowancePerYear = prev.PersonalAllowancePerYear,
                ExpenseDeductionRate = prev.ExpenseDeductionRate,
                ExpenseDeductionCap = prev.ExpenseDeductionCap,
                ProvidentFundDeductionCapPerYear = prev.ProvidentFundDeductionCapPerYear,
                IsActive = true,
            });
        }
        await context.SaveChangesAsync();
        Snackbar.Add(source.Count == 0 ? $"ปี {fromYear} ยังไม่มีประเภทลดหย่อน" : $"คัดลอก {added} รายการจากปี {fromYear} — ตรวจตัวเลขของปี {_selectedYear} อีกครั้ง",
            source.Count == 0 ? Severity.Warning : Severity.Success);
        await LoadAsync();
    }
}
