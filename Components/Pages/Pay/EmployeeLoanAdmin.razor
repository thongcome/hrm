@page "/pay/employees/{HremployeeId:long}/loans"
@layout PayrollEmployeeHubLayout
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Pay
@using HRM.Services.Pay.Calculators
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject EmployeeLoanService LoanService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject JsonLocalizationService L
@attribute [Authorize(Policy = "Menu:PAY_ADMIN")]

<PageTitle>@L.Translate("EmployeeLoansPageTitle")</PageTitle>

@if (_notFound)
{
    <MudAlert Severity="Severity.Warning">@L.Translate("EmployeeDataNotFoundOrOutsideCompanyError")</MudAlert>
}
else if (_employee is null)
{
    <MudText>@L.Translate("LoadingText")</MudText>
}
else
{
    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.body2">@string.Format(L.Translate("BaseSalaryColonTemplate"), _employee.SalaryAmt?.ToString("N2") ?? "-")</MudText>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" MaxWidth="900px">
        <MudText Typo="Typo.h6">@L.Translate("SubmitNewLoanHeading")</MudText>
        <MudText Typo="Typo.body2" Class="mt-1">
            @L.Translate("SubmitNewLoanDesc")
        </MudText>

        @if (_hasActiveLoan)
        {
            <MudAlert Severity="Severity.Info" Class="mt-3">@L.Translate("HasActiveLoanInfo")</MudAlert>
        }
        else
        {
            <MudGrid Class="mt-2">
                <MudItem xs="12" sm="4">
                    <MudNumericField @bind-Value="_principal" Label="@L.Translate("LoanPrincipalLabel")" Format="N2" Min="0" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField @bind-Value="_totalInstallments" Label="@L.Translate("TotalInstallmentsLabel")" Min="1" Max="60" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudDatePicker Date="_startMonth" DateChanged="OnStartMonthChanged" Label="@L.Translate("FirstDeductionMonthLabel")"
                        Editable="true" DateFormat="MM/yyyy" PickerVariant="PickerVariant.Dialog" OpenTo="OpenTo.Month" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_reason" Label="@L.Translate("ReasonNoteLabel")" />
                </MudItem>
            </MudGrid>

            <MudButton Color="Color.Secondary" Variant="Variant.Text" Class="mt-3" OnClick="PreviewSchedule">@L.Translate("ViewScheduleButton")</MudButton>

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
            }

            @if (_previewSchedule is not null)
            {
                <MudSimpleTable Dense="true" Class="mt-3">
                    <thead>
                        <tr><th>@L.Translate("ColInstallmentNo")</th><th>@L.Translate("ColMonth")</th><th>@L.Translate("ColAmount")</th><th>@L.Translate("ColBalanceAfter")</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var line in _previewSchedule)
                        {
                            <tr>
                                <td>@line.InstallmentNo</td>
                                <td>@FormatPeriod(line.Period)</td>
                                <td>@line.Amount.ToString("N2")</td>
                                <td>@line.BalanceAfter.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>

                <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="mt-3" OnClick="SubmitLoanAsync">@L.Translate("ConfirmSubmitLoanButton")</MudButton>
            }
        }
    </MudPaper>

    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6">@L.Translate("LoanHistoryHeading")</MudText>

        @if (_loans.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Class="mt-3">@L.Translate("NoLoanHistoryMessage")</MudAlert>
        }
        else
        {
            @foreach (var loan in _loans)
            {
                <MudPaper Class="pa-3 mt-3" Outlined="true">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <div>
                            <MudText Typo="Typo.subtitle1">
                                @string.Format(L.Translate("LoanSummaryTemplate"), loan.PrincipalAmount.ToString("N2"), loan.TotalInstallments, FormatStatus(loan.Status))
                            </MudText>
                            <MudText Typo="Typo.body2">
                                @string.Format(L.Translate("LoanDetailTemplate"), FormatPeriod(loan.StartPeriod), loan.RemainingBalance.ToString("N2"))
                                @if (!string.IsNullOrWhiteSpace(loan.Reason)) { <text> · @loan.Reason</text> }
                            </MudText>
                        </div>
                        <MudStack Row="true" Spacing="1">
                            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => ToggleExpand(loan.Id))">
                                @(_expandedLoanId == loan.Id ? L.Translate("HideScheduleButton") : L.Translate("ViewScheduleShortButton"))
                            </MudButton>
                            @if (loan.Status == Pay_EmployeeLoanStatus.Active && loan.Pay_EmployeeLoanInstallments.All(i => i.Status != Pay_LoanInstallmentStatus.Consumed))
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Warning" OnClick="@(() => CancelLoanAsync(loan.Id))">@L.Translate("CancelButton")</MudButton>
                            }
                        </MudStack>
                    </MudStack>

                    @if (_expandedLoanId == loan.Id)
                    {
                        <MudSimpleTable Dense="true" Class="mt-2">
                            <thead>
                                <tr><th>@L.Translate("ColInstallmentNo")</th><th>@L.Translate("ColMonth")</th><th>@L.Translate("ColAmount")</th><th>@L.Translate("ColBalance")</th><th>@L.Translate("ColStatus")</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var inst in loan.Pay_EmployeeLoanInstallments.OrderBy(i => i.InstallmentNo))
                                {
                                    <tr>
                                        <td>@inst.InstallmentNo</td>
                                        <td>@FormatPeriod(inst.Period)</td>
                                        <td>@inst.Amount.ToString("N2")</td>
                                        <td>@inst.BalanceAfter.ToString("N2")</td>
                                        <td>@FormatInstallmentStatus(inst.Status)</td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }
                </MudPaper>
            }
        }
    </MudPaper>
}

@code {
    [Parameter] public long HremployeeId { get; set; }

    private Hremployee? _employee;
    private bool _notFound;
    private List<Pay_EmployeeLoan> _loans = new();
    private bool _hasActiveLoan;
    private long? _expandedLoanId;

    private decimal _principal;
    private int _totalInstallments = 6;
    private DateTime? _startMonth = DateTime.Today;
    private string? _reason;
    private List<EmployeeLoanScheduleCalculator.InstallmentLine>? _previewSchedule;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var companyId = await GetCurrentCompanyIdAsync();
        await using var context = await DbFactory.CreateDbContextAsync();

        _employee = await context.Hremployee.FirstOrDefaultAsync(e => e.id == HremployeeId && e.companyid == companyId);
        if (_employee is null)
        {
            _notFound = true;
            return;
        }

        await LoadLoansAsync();
    }

    private async Task LoadLoansAsync()
    {
        _loans = await LoanService.GetLoansForEmployeeAsync(HremployeeId);
        _hasActiveLoan = _loans.Any(l => l.Status == Pay_EmployeeLoanStatus.Active);
    }

    private async Task<string?> GetCurrentCompanyIdAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        return state.User.FindFirstValue("payroll_company");
    }

    private void OnStartMonthChanged(DateTime? date)
    {
        _startMonth = date;
        _previewSchedule = null;
    }

    private void PreviewSchedule()
    {
        _error = null;
        _previewSchedule = null;

        if (_startMonth is null)
        {
            _error = L.Translate("SelectFirstDeductionMonthError");
            return;
        }

        try
        {
            var startPeriod = $"{_startMonth.Value.Year:D4}{_startMonth.Value.Month:D2}";
            _previewSchedule = EmployeeLoanScheduleCalculator.Calculate(_principal, _totalInstallments, startPeriod);
        }
        catch (ArgumentException ex)
        {
            _error = ex.Message;
        }
    }

    private async Task SubmitLoanAsync()
    {
        _error = null;

        if (_previewSchedule is null || _startMonth is null) return;

        var state = await AuthProvider.GetAuthenticationStateAsync();
        var userIdClaim = state.User.FindFirstValue("sc_userid");
        var userId = long.TryParse(userIdClaim, out var uid) ? uid : 0;

        try
        {
            var startPeriod = $"{_startMonth.Value.Year:D4}{_startMonth.Value.Month:D2}";
            await LoanService.SubmitAsync(HremployeeId, _principal, _totalInstallments, startPeriod, _reason, userId);
            Snackbar.Add(L.Translate("LoanSubmittedSuccess"), Severity.Success);

            _principal = 0;
            _totalInstallments = 6;
            _reason = null;
            _previewSchedule = null;
            await LoadLoansAsync();
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
    }

    private async Task CancelLoanAsync(long loanId)
    {
        try
        {
            await LoanService.CancelAsync(loanId);
            Snackbar.Add(L.Translate("LoanCancelledSuccess"), Severity.Success);
            await LoadLoansAsync();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void ToggleExpand(long loanId) => _expandedLoanId = _expandedLoanId == loanId ? null : loanId;

    private static string FormatPeriod(string yyyymm)
    {
        if (yyyymm.Length != 6 || !int.TryParse(yyyymm.AsSpan(0, 4), out var y) || !int.TryParse(yyyymm.AsSpan(4, 2), out var m))
            return yyyymm;
        return $"{m:00}/{y}";
    }

    private string FormatStatus(Pay_EmployeeLoanStatus status) => status switch
    {
        Pay_EmployeeLoanStatus.Active => L.Translate("LoanStatusActive"),
        Pay_EmployeeLoanStatus.PaidOff => L.Translate("LoanStatusPaidOff"),
        Pay_EmployeeLoanStatus.Cancelled => L.Translate("LoanStatusCancelled"),
        _ => status.ToString(),
    };

    private string FormatInstallmentStatus(Pay_LoanInstallmentStatus status) => status switch
    {
        Pay_LoanInstallmentStatus.Pending => L.Translate("InstallmentStatusPending"),
        Pay_LoanInstallmentStatus.Consumed => L.Translate("InstallmentStatusConsumed"),
        Pay_LoanInstallmentStatus.Cancelled => L.Translate("CancelButton"),
        _ => status.ToString(),
    };
}
