@page "/pay/salary-cert"
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Pay
@using HRM.Services.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject HRM.Services.EmailSender EmailSender
@inject HRM.Services.Audit.IAuditLogger AuditLogger
@inject ISnackbar Snackbar
@attribute [Authorize(Policy = "Menu:PAY_ADMIN")]

<PageTitle>หนังสือรับรองเงินเดือน</PageTitle>

<MudPaper Class="pa-4 mb-4" MaxWidth="700px">
    <MudText Typo="Typo.h5">ออกหนังสือรับรองเงินเดือน</MudText>
    <MudText Typo="Typo.body2" Class="mt-1">
        เอกสารรับรองการทำงานและเงินเดือนของพนักงาน 1 คน สำหรับใช้ยื่นธนาคาร/สถานทูต/หน่วยงานอื่นๆ
    </MudText>

    @if (string.IsNullOrEmpty(_companyId))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">บัญชีของคุณยังไม่ได้ผูกกับบริษัทใดๆ — ติดต่อแอดมินให้ตั้งค่า empid ก่อน</MudAlert>
        return;
    }

    <MudGrid Class="mt-3">
        <MudItem xs="12" sm="8">
            <MudAutocomplete T="Hremployee" Label="พนักงาน (ค้นหาด้วยรหัสหรือชื่อ)" @bind-Value="_selectedEmployee"
                SearchFunc="SearchEmployeesAsync"
                ToStringFunc="@(e => e == null ? null : $"{e.EmpNo} — {e.EmpName} {e.EmpSurname}")"
                ResetValueOnEmptyText="true" CoerceText="true" MinCharacters="0" />
        </MudItem>
        <MudItem xs="12" sm="4" Class="d-flex align-center">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="LoadEmployeeAsync" Disabled="@(_selectedEmployee is null)">
                โหลดข้อมูล
            </MudButton>
        </MudItem>
    </MudGrid>

    @if (!string.IsNullOrEmpty(_error))
    {
        <MudAlert Severity="Severity.Warning" Class="mt-3">@_error</MudAlert>
    }

    @if (_data is not null)
    {
        <MudSimpleTable Dense="true" Class="mt-3">
            <tbody>
                <tr><td>พนักงาน</td><td>@_data.EmployeeName</td></tr>
                <tr><td>เลขบัตรประชาชน</td><td>@(_data.IdCard ?? "-")</td></tr>
                <tr><td>วันที่เริ่มงาน</td><td>@(_data.WorkDate?.ToString("dd/MM/yyyy") ?? "-")</td></tr>
                <tr><td>สถานะ</td><td>@(_data.ResignDate is null ? "ทำงานอยู่ปัจจุบัน" : $"ลาออกแล้ว ({_data.ResignDate:dd/MM/yyyy})")</td></tr>
                <tr><td>อัตราเงินเดือน</td><td>@(_data.SalaryAmt?.ToString("N2") ?? "ไม่มีข้อมูล")</td></tr>
            </tbody>
        </MudSimpleTable>

        <MudAlert Severity="Severity.Info" Class="mt-3" Dense="true">
            ตำแหน่ง/สังกัดในระบบมักไม่ครบถ้วน กรุณาตรวจสอบและแก้ไขให้ถูกต้องก่อนออกเอกสาร
        </MudAlert>

        <MudGrid Class="mt-2">
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_position" Label="ตำแหน่ง" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_department" Label="สังกัด/แผนก" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_addressee" Label='เรียน (ถ้าไม่ระบุจะใช้ "ผู้ที่เกี่ยวข้อง")' Placeholder="เช่น ผู้จัดการธนาคาร ก..." />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_purpose" Label='วัตถุประสงค์ (ต่อจากคำว่า "เพื่อใช้")' Placeholder="เช่น ประกอบการขอสินเชื่อ" />
            </MudItem>
        </MudGrid>

        <MudButton Color="Color.Secondary" Variant="Variant.Filled" Class="mt-3"
            Href="@BuildDownloadUrl()" Target="_blank">
            ดาวน์โหลด PDF
        </MudButton>

        @if (string.IsNullOrWhiteSpace(_selectedEmployeeEmail))
        {
            <MudAlert Severity="Severity.Warning" Class="mt-3" Dense="true">
                พนักงานคนนี้ยังไม่มีอีเมลในระบบ — ไม่สามารถส่งอีเมลได้ กรุณาเพิ่มอีเมลที่หน้า <MudLink Href="/pay/employees">จัดการพนักงาน</MudLink> ก่อน
            </MudAlert>
        }
        <MudButton Color="Color.Tertiary" Variant="Variant.Filled" Class="mt-3 ml-2"
            OnClick="SendEmailAsync" Disabled="@(string.IsNullOrWhiteSpace(_selectedEmployeeEmail) || _sending)">
            ส่งอีเมลให้พนักงาน
        </MudButton>

        @if (_sendHistory.Count > 0)
        {
            <MudText Typo="Typo.subtitle2" Class="mt-4">ประวัติการส่ง</MudText>
            <MudSimpleTable Dense="true" Class="mt-1">
                <thead><tr><th>วันที่-เวลา</th><th>ผู้ส่ง</th><th>หมายเหตุ</th></tr></thead>
                <tbody>
                    @foreach (var log in _sendHistory)
                    {
                        <tr>
                            <td>@log.EventDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@(log.ActorName ?? "-")</td>
                            <td>@(log.Note ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    }
</MudPaper>

@code {
    private string? _companyId;
    private Hremployee? _selectedEmployee;
    private SalaryCertificateData? _data;
    private string? _error;
    private string? _selectedEmployeeEmail;
    private bool _sending;
    private List<AuditLog> _sendHistory = new();

    private string _position = "";
    private string _department = "";
    private string _addressee = "";
    private string _purpose = "";

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
    }

    private async Task<IEnumerable<Hremployee>> SearchEmployeesAsync(string search, CancellationToken ct)
    {
        await using var context = await DbFactory.CreateDbContextAsync(ct);
        var query = context.Hremployee.Where(e => e.companyid == _companyId);
        if (!string.IsNullOrWhiteSpace(search))
        {
            query = query.Where(e => e.EmpNo.Contains(search)
                || (e.EmpName != null && e.EmpName.Contains(search))
                || (e.EmpSurname != null && e.EmpSurname.Contains(search)));
        }
        return await query.OrderBy(e => e.EmpNo).Take(20).ToListAsync(ct);
    }

    private async Task LoadEmployeeAsync()
    {
        _error = null;
        _data = null;

        if (_selectedEmployee is null)
        {
            _error = "กรุณาเลือกพนักงาน";
            return;
        }

        await using var context = await DbFactory.CreateDbContextAsync();
        _data = await SalaryCertificateDataService.BuildAsync(context, _selectedEmployee.id, _companyId!);
        if (_data is null)
        {
            _error = "ไม่พบข้อมูลพนักงานคนนี้";
            return;
        }

        _position = _data.PositionDefault ?? "";
        _department = _data.DepartmentDefault ?? "";
        _addressee = "";
        _purpose = "";

        _selectedEmployeeEmail = await EmployeeEmailResolver.ResolveAsync(context, _selectedEmployee.id);
        await LoadSendHistoryAsync(context, _selectedEmployee.id.ToString());
    }

    private string BuildDownloadUrl()
    {
        if (_selectedEmployee is null) return "#";
        var qs = $"position={Uri.EscapeDataString(_position)}&department={Uri.EscapeDataString(_department)}"
            + $"&purpose={Uri.EscapeDataString(_purpose)}&addressee={Uri.EscapeDataString(_addressee)}";
        return $"/pay/files/salary-cert/{_selectedEmployee.id}?{qs}";
    }

    private async Task LoadSendHistoryAsync(HRMContext context, string recordId)
    {
        _sendHistory = await context.AuditLogs
            .Where(a => a.EntityType == "SalaryCertificateEmail" && a.RecordId == recordId)
            .OrderByDescending(a => a.EventDate)
            .Take(5)
            .ToListAsync();
    }

    private async Task SendEmailAsync()
    {
        if (_data is null || _selectedEmployee is null || string.IsNullOrWhiteSpace(_selectedEmployeeEmail)) return;

        _sending = true;
        try
        {
            var bytes = SalaryCertificatePdfService.Generate(_data, _position, _department, _purpose, _addressee, DateTime.Now);
            var fileName = $"salary_cert_{_selectedEmployee.EmpNo}.pdf";
            var subject = "หนังสือรับรองเงินเดือน";
            var body = $"<p>เรียนคุณ {_data.EmployeeName}</p><p>แนบหนังสือรับรองเงินเดือนมาพร้อมนี้</p>";

            await EmailSender.SendEmailWithAttachmentAsync(_selectedEmployeeEmail!, subject, body, fileName, bytes);

            var recordId = _selectedEmployee.id.ToString();
            await AuditLogger.LogAccessAsync("SalaryCertificateEmail", recordId, isSensitive: true,
                note: $"ส่งอีเมลไปที่ {_selectedEmployeeEmail}");

            await using var context = await DbFactory.CreateDbContextAsync();
            await LoadSendHistoryAsync(context, recordId);

            Snackbar.Add($"ส่งหนังสือรับรองไปที่ {_selectedEmployeeEmail} เรียบร้อย", Severity.Success);
        }
        catch (Exception ex)
        {
            Serilog.Log.Error(ex, "Salary cert email send failed for employee {Id}", _selectedEmployee.id);
            Snackbar.Add("ส่งอีเมลไม่สำเร็จ กรุณาลองใหม่อีกครั้ง", Severity.Error);
        }
        finally
        {
            _sending = false;
        }
    }
}
