@page "/pay/admin/lifecycle-task-templates"
@using System.Security.Claims
@using HRM.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@inject JsonLocalizationService L
@attribute [Authorize(Policy = "Menu:PAY_ADMIN")]

<PageTitle>@L.Translate("LifecycleChecklistPageTitle")</PageTitle>

<MudPaper Class="pa-4 mb-4" MaxWidth="900px">
    <MudText Typo="Typo.h5">@L.Translate("LifecycleChecklistHeading")</MudText>
    <MudText Typo="Typo.body2" Class="mt-1">
        @L.Translate("LifecycleChecklistDesc")
    </MudText>

    @if (string.IsNullOrEmpty(_companyId))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">@L.Translate("CompanyNotLinkedError")</MudAlert>
        return;
    }

    <MudDivider Class="my-4" />

    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.h6">@(_editingId is null ? L.Translate("AddNewTaskHeading") : string.Format(L.Translate("EditTaskHeadingTemplate"), _form.Title))</MudText>
        @if (!_showForm)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="OpenCreate">+ @L.Translate("AddTaskButton")</MudButton>
        }
    </MudStack>

    @if (_showForm)
    {
        <MudGrid Class="mt-1">
            <MudItem xs="12" sm="4">
                <MudSelect T="LifecycleTaskDirection" @bind-Value="_form.Direction" Label="@L.Translate("DirectionLabel")">
                    <MudSelectItem Value="LifecycleTaskDirection.Onboarding">@L.Translate("OnboardingOptionLabel")</MudSelectItem>
                    <MudSelectItem Value="LifecycleTaskDirection.Offboarding">@L.Translate("OffboardingOptionLabel")</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="_form.Code" Label="@L.Translate("TaskCodeLabel")" Required="true" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudNumericField @bind-Value="_form.SortOrder" Label="@L.Translate("SortOrderLabel")" Min="0" />
            </MudItem>
            <MudItem xs="12" sm="12">
                <MudTextField @bind-Value="_form.Title" Label="@L.Translate("TaskTitleLabel")" Required="true" />
            </MudItem>
            <MudItem xs="12" sm="8">
                <MudTextField @bind-Value="_form.Description" Label="@L.Translate("TaskDescriptionLabel")" Lines="2" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="_form.DefaultAssigneeRole" Label="@L.Translate("DefaultAssigneeRoleLabel")" />
            </MudItem>
        </MudGrid>

        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
        }

        <MudStack Row="true" Spacing="2" Class="mt-3">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">
                @(_editingId is null ? L.Translate("AddTaskButton") : L.Translate("SaveEditButton"))
            </MudButton>
            <MudButton Variant="Variant.Text" OnClick="CancelEdit">@L.Translate("CancelButton")</MudButton>
        </MudStack>
    }

    <MudDivider Class="my-5" />

    <MudTabs>
        <MudTabPanel Text="Onboarding">
            @RenderTemplateTable(_templates.Where(t => t.Direction == LifecycleTaskDirection.Onboarding))
        </MudTabPanel>
        <MudTabPanel Text="Offboarding">
            @RenderTemplateTable(_templates.Where(t => t.Direction == LifecycleTaskDirection.Offboarding))
        </MudTabPanel>
    </MudTabs>
</MudPaper>

@code {
    private string? _companyId;
    private List<Hrd_LifecycleTaskTemplate> _templates = new();
    private string? _error;
    private long? _editingId;
    private bool _showForm;

    private class TemplateForm
    {
        public LifecycleTaskDirection Direction { get; set; } = LifecycleTaskDirection.Onboarding;
        public string Code { get; set; } = "";
        public string Title { get; set; } = "";
        public string? Description { get; set; }
        public int SortOrder { get; set; }
        public string? DefaultAssigneeRole { get; set; }
    }

    private TemplateForm _form = new();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
        if (string.IsNullOrWhiteSpace(_companyId)) return;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        _templates = await context.Hrd_LifecycleTaskTemplates
            .Where(t => t.CompanyId == _companyId)
            .OrderBy(t => t.Direction).ThenBy(t => t.SortOrder).ThenBy(t => t.Code)
            .ToListAsync();
    }

    private void OpenCreate()
    {
        _editingId = null;
        _form = new TemplateForm();
        _error = null;
        _showForm = true;
    }

    private void StartEdit(Hrd_LifecycleTaskTemplate template)
    {
        _editingId = template.Id;
        _form = new TemplateForm
        {
            Direction = template.Direction,
            Code = template.Code,
            Title = template.Title,
            Description = template.Description,
            SortOrder = template.SortOrder,
            DefaultAssigneeRole = template.DefaultAssigneeRole,
        };
        _error = null;
        _showForm = true;
    }

    private void CancelEdit()
    {
        _editingId = null;
        _form = new TemplateForm();
        _error = null;
        _showForm = false;
    }

    private async Task SaveAsync()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_form.Code) || string.IsNullOrWhiteSpace(_form.Title))
        {
            _error = L.Translate("FillTaskCodeTitleError");
            return;
        }

        await using var context = await DbFactory.CreateDbContextAsync();

        var duplicate = await context.Hrd_LifecycleTaskTemplates.AnyAsync(t =>
            t.CompanyId == _companyId && t.Direction == _form.Direction && t.Code == _form.Code && t.Id != (_editingId ?? 0));
        if (duplicate)
        {
            _error = string.Format(L.Translate("TaskCodeDuplicateErrorTemplate"), _form.Code);
            return;
        }

        if (_editingId is long id)
        {
            var existing = await context.Hrd_LifecycleTaskTemplates.FirstOrDefaultAsync(t => t.Id == id && t.CompanyId == _companyId);
            if (existing is null)
            {
                _error = L.Translate("TaskNotFoundError");
                return;
            }
            existing.Direction = _form.Direction;
            existing.Code = _form.Code;
            existing.Title = _form.Title;
            existing.Description = _form.Description;
            existing.SortOrder = _form.SortOrder;
            existing.DefaultAssigneeRole = _form.DefaultAssigneeRole;
        }
        else
        {
            context.Hrd_LifecycleTaskTemplates.Add(new Hrd_LifecycleTaskTemplate
            {
                CompanyId = _companyId!,
                Direction = _form.Direction,
                Code = _form.Code,
                Title = _form.Title,
                Description = _form.Description,
                SortOrder = _form.SortOrder,
                DefaultAssigneeRole = _form.DefaultAssigneeRole,
                IsActive = true,
            });
        }

        await context.SaveChangesAsync();
        Snackbar.Add(_editingId is null ? L.Translate("TaskAddedSuccess") : L.Translate("GradeEditSavedSuccess"), Severity.Success);
        CancelEdit();
        await LoadAsync();
    }

    private async Task ToggleActiveAsync(Hrd_LifecycleTaskTemplate template)
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var existing = await context.Hrd_LifecycleTaskTemplates.FirstOrDefaultAsync(t => t.Id == template.Id && t.CompanyId == _companyId);
        if (existing is null) return;

        existing.IsActive = !existing.IsActive;
        await context.SaveChangesAsync();
        await LoadAsync();
    }

    private RenderFragment RenderTemplateTable(IEnumerable<Hrd_LifecycleTaskTemplate> items) => @<text>
        <MudTable Items="items" Dense="true" Hover="true">
            <HeaderContent>
                <MudTh>@L.Translate("ColSortOrder")</MudTh>
                <MudTh>@L.Translate("ColCode")</MudTh>
                <MudTh>@L.Translate("TaskTitleLabel")</MudTh>
                <MudTh>@L.Translate("ColAssignee")</MudTh>
                <MudTh>@L.Translate("ColStatus")</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate Context="row">
                <MudTd>@row.SortOrder</MudTd>
                <MudTd>@row.Code</MudTd>
                <MudTd>@row.Title</MudTd>
                <MudTd>@row.DefaultAssigneeRole</MudTd>
                <MudTd>@(row.IsActive ? L.Translate("PeriodActiveStatus") : L.Translate("PeriodInactiveStatus"))</MudTd>
                <MudTd>
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => StartEdit(row))">@L.Translate("EditButton")</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => ToggleActiveAsync(row))">
                        @(row.IsActive ? L.Translate("DeactivateButton") : L.Translate("ActivateButton"))
                    </MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </text>;
}
