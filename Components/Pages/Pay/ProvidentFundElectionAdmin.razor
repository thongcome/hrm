@page "/pay/employees/{HremployeeId:long}/provident-fund"
@layout PayrollEmployeeHubLayout
@using System.Security.Claims
@using HRM.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject JsonLocalizationService L
@attribute [Authorize(Policy = "Menu:PAY_ADMIN")]

<PageTitle>@L.Translate("ProvidentFundNavLabel")</PageTitle>

@if (_notFound)
{
    <MudAlert Severity="Severity.Warning">@L.Translate("EmployeeDataNotFoundOrOutsideCompanyError")</MudAlert>
}
else if (_employee is null)
{
    <MudText>@L.Translate("LoadingText")</MudText>
}
else
{
    <MudPaper Class="pa-4 mb-4" MaxWidth="900px">
        <MudText Typo="Typo.h6">@L.Translate("ProvidentFundElectionSetupHeading")</MudText>
        <MudText Typo="Typo.body2" Class="mt-1">
            @L.Translate("ProvidentFundElectionDesc")
        </MudText>

        @if (_activePolicy is null)
        {
            <MudAlert Severity="Severity.Info" Class="mt-3">
                @L.Translate("NoPfPolicyEnabledPrefix") <MudLink Href="/pay/admin/provident-fund-policy">@L.Translate("NoPfPolicyEnabledLinkText")</MudLink> @L.Translate("NoPlansAvailableSuffix")
            </MudAlert>
        }
        else
        {
            <MudGrid Class="mt-2">
                <MudItem xs="12" sm="6">
                    <MudDatePicker Date="_effectiveFrom" DateChanged="@(d => _effectiveFrom = d)" Label="@L.Translate("EffectiveFromLabel")"
                        Editable="true" DateFormat="dd/MM/yyyy" PickerVariant="PickerVariant.Dialog" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="long?" @bind-Value="_investmentPolicyId" Label="@L.Translate("InvestmentPolicyOptionalLabel")" Clearable="true">
                        @foreach (var inv in _investmentPolicies)
                        {
                            <MudSelectItem T="long?" Value="@((long?)inv.Id)">@inv.Code — @inv.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="_employeeRate" Label="@string.Format(L.Translate("EmployeeRateWithRangeTemplate"), _activePolicy.MinEmployeeRate.ToString("0.0"), _activePolicy.MaxEmployeeRate.ToString("0.0"))" Format="0.00" Min="0" Max="100" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="_companyRate" Label="@string.Format(L.Translate("CompanyRateWithRangeTemplate"), _activePolicy.MinCompanyRate.ToString("0.0"), _activePolicy.MaxCompanyRate.ToString("0.0"))" Format="0.00" Min="0" Max="100" />
                </MudItem>
            </MudGrid>

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
            }

            <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="mt-3" OnClick="ElectAsync">@L.Translate("SaveElectionButton")</MudButton>
        }
    </MudPaper>

    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6">@L.Translate("ElectionHistoryHeading")</MudText>

        @if (_elections.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Class="mt-3">@L.Translate("NoElectionsMessage")</MudAlert>
        }
        else
        {
            <MudSimpleTable Dense="true" Class="mt-2">
                <thead>
                    <tr><th>@L.Translate("ColRateContribution")</th><th>@L.Translate("ColInvestmentPolicy")</th><th>@L.Translate("EffectiveFromLabel")</th><th>@L.Translate("ColEnds")</th><th>@L.Translate("ColStatus")</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var election in _elections)
                    {
                        <tr>
                            <td>@election.EmployeeContributionRate.ToString("0.00")% / @election.CompanyContributionRate.ToString("0.00")%</td>
                            <td>@(election.InvestmentPolicy is not null ? $"{election.InvestmentPolicy.Code} — {election.InvestmentPolicy.Name}" : "-")</td>
                            <td>@election.EffectiveFrom.ToString("dd/MM/yyyy")</td>
                            <td>@(election.EffectiveTo?.ToString("dd/MM/yyyy") ?? "-")</td>
                            <td>@(election.IsActive ? L.Translate("PeriodActiveStatus") : L.Translate("EndedStatus"))</td>
                            <td>
                                @if (election.IsActive)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Warning" OnClick="@(() => EndElectionAsync(election.Id))">@L.Translate("EndButton")</MudButton>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    </MudPaper>
}

@code {
    [Parameter] public long HremployeeId { get; set; }

    private Hremployee? _employee;
    private bool _notFound;
    private Pay_ProvidentFundPolicy? _activePolicy;
    private List<Pay_ProvidentFundInvestmentPolicy> _investmentPolicies = new();
    private List<Pay_ProvidentFundElection> _elections = new();
    private string? _companyId;

    private DateTime? _effectiveFrom = DateTime.Today;
    private long? _investmentPolicyId;
    private decimal _employeeRate = 3m;
    private decimal _companyRate = 3m;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");

        await using var context = await DbFactory.CreateDbContextAsync();

        _employee = await context.Hremployee.FirstOrDefaultAsync(e => e.id == HremployeeId && e.companyid == _companyId);
        if (_employee is null)
        {
            _notFound = true;
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();

        var today = DateOnly.FromDateTime(DateTime.Today);
        _activePolicy = await context.Pay_ProvidentFundPolicies
            .Where(p => p.CompanyId == _companyId && p.IsEnabled
                        && p.EffectiveFrom <= today && (p.EffectiveTo == null || p.EffectiveTo >= today))
            .FirstOrDefaultAsync();

        _investmentPolicies = await context.Pay_ProvidentFundInvestmentPolicies
            .Where(p => p.CompanyId == _companyId && p.IsActive)
            .OrderBy(p => p.SortOrder)
            .ToListAsync();

        _elections = await context.Pay_ProvidentFundElections
            .Include(e => e.InvestmentPolicy)
            .Where(e => e.HremployeeId == HremployeeId)
            .OrderByDescending(e => e.EffectiveFrom)
            .ToListAsync();
    }

    private async Task ElectAsync()
    {
        _error = null;

        if (_activePolicy is null)
        {
            _error = L.Translate("NoPfPolicyEnabledShortError");
            return;
        }
        if (_effectiveFrom is null)
        {
            _error = L.Translate("InvalidEffectiveDateError");
            return;
        }
        if (_employeeRate < _activePolicy.MinEmployeeRate || _employeeRate > _activePolicy.MaxEmployeeRate)
        {
            _error = string.Format(L.Translate("EmployeeRateRangeErrorTemplate"), _activePolicy.MinEmployeeRate.ToString("0.0"), _activePolicy.MaxEmployeeRate.ToString("0.0"));
            return;
        }
        if (_companyRate < _activePolicy.MinCompanyRate || _companyRate > _activePolicy.MaxCompanyRate)
        {
            _error = string.Format(L.Translate("CompanyRateRangeErrorTemplate"), _activePolicy.MinCompanyRate.ToString("0.0"), _activePolicy.MaxCompanyRate.ToString("0.0"));
            return;
        }
        if (_companyRate < _employeeRate)
        {
            _error = L.Translate("CompanyRateBelowEmployeeError");
            return;
        }

        var state = await AuthProvider.GetAuthenticationStateAsync();
        var userIdClaim = state.User.FindFirstValue("sc_userid");
        var userId = long.TryParse(userIdClaim, out var uid) ? uid : 0;

        await using var context = await DbFactory.CreateDbContextAsync();

        var existingActive = await context.Pay_ProvidentFundElections
            .Where(e => e.HremployeeId == HremployeeId && e.IsActive)
            .ToListAsync();
        foreach (var old in existingActive)
        {
            old.IsActive = false;
            old.EffectiveTo = DateOnly.FromDateTime(_effectiveFrom.Value).AddDays(-1);
        }

        context.Pay_ProvidentFundElections.Add(new Pay_ProvidentFundElection
        {
            HremployeeId = HremployeeId,
            EmployeeContributionRate = _employeeRate,
            CompanyContributionRate = _companyRate,
            InvestmentPolicyId = _investmentPolicyId,
            EffectiveFrom = DateOnly.FromDateTime(_effectiveFrom.Value),
            IsActive = true,
            ElectedByUserId = userId,
            ElectedDate = DateTime.Now,
        });

        await context.SaveChangesAsync();
        Snackbar.Add(L.Translate("ElectionSavedSuccess"), Severity.Success);

        await LoadAsync();
    }

    private async Task EndElectionAsync(long electionId)
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var existing = await context.Pay_ProvidentFundElections
            .FirstOrDefaultAsync(e => e.Id == electionId && e.HremployeeId == HremployeeId);
        if (existing is null) return;

        existing.IsActive = false;
        existing.EffectiveTo = DateOnly.FromDateTime(DateTime.Today);
        await context.SaveChangesAsync();
        Snackbar.Add(L.Translate("ElectionEndedSuccess"), Severity.Success);
        await LoadAsync();
    }
}
