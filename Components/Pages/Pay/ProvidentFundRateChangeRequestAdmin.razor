@page "/pay/admin/provident-fund-rate-requests"
@using System.Security.Claims
@using HRM.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@inject HRM.Services.Pay.ProvidentFundRateChangeRequestService RequestService
@attribute [Authorize(Policy = "Menu:PAY_ADMIN")]

<PageTitle>คำขอเปลี่ยนอัตรากองทุนสำรองเลี้ยงชีพ</PageTitle>

<MudPaper Class="pa-4 mb-4" MaxWidth="1100px">
    <MudText Typo="Typo.h5">คำขอเปลี่ยนอัตรากองทุนสำรองเลี้ยงชีพ</MudText>
    <MudText Typo="Typo.body2" Class="mt-1" Style="opacity:.75;">
        ยื่นคำขอแทนพนักงาน หรือดูคำขอที่พนักงานยื่นเองผ่าน ESS — ทุกคำขอต้องผ่านการอนุมัติที่ <MudLink Href="/wf/my-inbox">งานรออนุมัติของฉัน</MudLink> ก่อนถึงจะมีผลจริง
    </MudText>

    @if (string.IsNullOrEmpty(_companyId))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">บัญชีของคุณยังไม่ได้ผูกกับบริษัทใดๆ — ติดต่อแอดมินให้ตั้งค่า empid ก่อน</MudAlert>
        return;
    }

    <MudDivider Class="my-4" />

    <MudText Typo="Typo.h6">ยื่นคำขอใหม่</MudText>
    <MudGrid Class="mt-1">
        <MudItem xs="12" sm="6">
            <MudAutocomplete T="Hremployee" Label="พนักงาน" @bind-Value="_selectedEmployee"
                SearchFunc="SearchEmployeesAsync"
                ToStringFunc="@(e => e == null ? null : $"{e.EmpNo} — {e.EmpName} {e.EmpSurname}")"
                ResetValueOnEmptyText="true" CoerceText="true" MinCharacters="0" />
        </MudItem>
        <MudItem xs="12" sm="6"><MudNumericField T="decimal" @bind-Value="_requestedEmployeeRate" Label="อัตราเงินสะสมที่ขอ (%)" Format="0.00" Min="0" Max="100" /></MudItem>
    </MudGrid>

    @if (!string.IsNullOrEmpty(_error))
    {
        <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
    }

    <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="mt-3" OnClick="SubmitAsync" Disabled="_saving">ยื่นคำขอ</MudButton>

    <MudDivider Class="my-5" />

    <MudText Typo="Typo.h6">ประวัติคำขอทั้งหมด</MudText>
    <MudTable Items="_requests" Dense="true" Hover="true" Class="mt-2">
        <HeaderContent>
            <MudTh>วันที่ยื่น</MudTh>
            <MudTh>พนักงาน</MudTh>
            <MudTh>ขอสะสม</MudTh>
            <MudTh>สมทบที่เสนอ</MudTh>
            <MudTh>ที่มา</MudTh>
            <MudTh>มีผล</MudTh>
            <MudTh>สถานะ</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.RequestedDate.ToString("dd/MM/yyyy")</MudTd>
            <MudTd>@EmployeeName(context.HremployeeId)</MudTd>
            <MudTd>@context.RequestedEmployeeRate.ToString("0.00")%</MudTd>
            <MudTd>@context.RequestedCompanyRate.ToString("0.00")% @(context.SuggestedCompanyRate is not null ? "(จากตาราง)" : "")</MudTd>
            <MudTd>@(context.IsEmployeeInitiated ? "พนักงานยื่นเอง" : "HR ยื่นแทน")</MudTd>
            <MudTd>@context.RequestedEffectiveFrom.ToString("dd/MM/yyyy")</MudTd>
            <MudTd><MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Status)">@StatusLabel(context.Status)</MudChip></MudTd>
            <MudTd><MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => ShowCalcDetailAsync(context.Id))">รายละเอียดคำนวณ</MudButton></MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText Typo="Typo.body2">ยังไม่มีคำขอ</MudText></NoRecordsContent>
    </MudTable>

    @if (_calcDetails.Count > 0)
    {
        <MudDivider Class="my-4" />
        <MudText Typo="Typo.subtitle1">รายละเอียดการคำนวณ (คำขอ #@_calcDetailRequestId)</MudText>
        @foreach (var d in _calcDetails)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                @d.InputsSummary — @d.MatchedRuleDescription — ผลลัพธ์: @d.ResultValue.ToString("0.00")%
                <MudText Typo="Typo.caption" Class="d-block">คำนวณเมื่อ @d.CalculatedDate.ToString("dd/MM/yyyy HH:mm")</MudText>
            </MudAlert>
        }
    }
</MudPaper>

@code {
    private string? _companyId;
    private Hremployee? _selectedEmployee;
    private decimal _requestedEmployeeRate = 3m;
    private string? _error;
    private bool _saving;
    private List<Pay_ProvidentFundRateChangeRequest> _requests = new();
    private Dictionary<long, string> _employeeNames = new();
    private long? _calcDetailRequestId;
    private List<Pay_ProvidentFundCalculationDetail> _calcDetails = new();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
        if (string.IsNullOrWhiteSpace(_companyId)) return;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var empIds = await context.Hremployee.Where(e => e.companyid == _companyId).Select(e => e.id).ToListAsync();

        var pendingIds = await context.Pay_ProvidentFundRateChangeRequests
            .Where(r => empIds.Contains(r.HremployeeId) && r.Status == ProvidentFundRequestStatus.PendingApproval)
            .Select(r => r.Id).ToListAsync();
        foreach (var id in pendingIds) await RequestService.SyncStatusFromJobAsync(id);

        _requests = await context.Pay_ProvidentFundRateChangeRequests
            .Where(r => empIds.Contains(r.HremployeeId))
            .OrderByDescending(r => r.RequestedDate)
            .ToListAsync();

        _employeeNames = await context.Hremployee
            .Where(e => empIds.Contains(e.id))
            .ToDictionaryAsync(e => e.id, e => $"{e.EmpNo} — {e.EmpName} {e.EmpSurname}".Trim());
    }

    private string EmployeeName(long id) => _employeeNames.GetValueOrDefault(id, id.ToString());

    private static string StatusLabel(ProvidentFundRequestStatus s) => s switch
    {
        ProvidentFundRequestStatus.PendingApproval => "รออนุมัติ",
        ProvidentFundRequestStatus.Approved => "อนุมัติแล้ว",
        ProvidentFundRequestStatus.Rejected => "ไม่อนุมัติ",
        _ => s.ToString(),
    };

    private static Color StatusColor(ProvidentFundRequestStatus s) => s switch
    {
        ProvidentFundRequestStatus.Approved => Color.Success,
        ProvidentFundRequestStatus.Rejected => Color.Error,
        _ => Color.Warning,
    };

    private async Task<IEnumerable<Hremployee>> SearchEmployeesAsync(string search, CancellationToken ct)
    {
        await using var context = await DbFactory.CreateDbContextAsync(ct);
        var query = context.Hremployee.Where(e => e.companyid == _companyId);
        if (!string.IsNullOrWhiteSpace(search))
        {
            query = query.Where(e => e.EmpNo.Contains(search)
                || (e.EmpName != null && e.EmpName.Contains(search))
                || (e.EmpSurname != null && e.EmpSurname.Contains(search)));
        }
        return await query.OrderBy(e => e.EmpNo).Take(20).ToListAsync(ct);
    }

    private async Task SubmitAsync()
    {
        _error = null;
        if (_selectedEmployee is null)
        {
            _error = "กรุณาเลือกพนักงาน";
            return;
        }

        _saving = true;
        try
        {
            var state = await AuthProvider.GetAuthenticationStateAsync();
            var userId = long.TryParse(state.User.FindFirst("sc_userid")?.Value, out var uid) ? uid : 0;

            await RequestService.SubmitAsync(_selectedEmployee.id, _requestedEmployeeRate, userId, _selectedEmployee.EmpNo, isEmployeeInitiated: false);
            Snackbar.Add("ยื่นคำขอเรียบร้อยแล้ว", Severity.Success);
            _selectedEmployee = null;
            await LoadAsync();
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ShowCalcDetailAsync(long requestId)
    {
        _calcDetailRequestId = requestId;
        _calcDetails = await RequestService.GetCalculationDetailsAsync(requestId);
    }
}
