@page "/pay/dashboard"
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Pay
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav
@inject JsonLocalizationService L
@attribute [Authorize(Policy = "Menu:PAY_REPORTS")]

<PageTitle>@L.Translate("NavPayDashboard")</PageTitle>

<MudPaper Class="pa-4 mb-4">
    <MudText Typo="Typo.h5">@L.Translate("PayDashboardHeading")</MudText>

    @if (string.IsNullOrEmpty(_companyId))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">@L.Translate("CompanyNotLinkedError")</MudAlert>
        return;
    }

    @if (!_loaded)
    {
        <MudProgressCircular Indeterminate="true" Class="mt-4" />
    }
    else
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-3" Spacing="2">
            <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" OnClick="@(() => GoToFiscalYear(_fiscalYear - 1))" title="@L.Translate("PreviousFiscalYearTitle")" />
            <MudText Typo="Typo.h6">@L.Translate("FiscalYearLabel") @FiscalYearLabel()</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" OnClick="@(() => GoToFiscalYear(_fiscalYear + 1))" title="@L.Translate("NextFiscalYearTitle")" />
            @if (_fiscalYear != _currentFiscalYear)
            {
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => GoToFiscalYear(_currentFiscalYear))">@L.Translate("BackToCurrentYearButton")</MudButton>
            }
            <MudText Typo="Typo.caption" Class="ml-2">(@_fyStart.ToString("dd/MM/yyyy") - @_fyEnd.ToString("dd/MM/yyyy"))</MudText>
        </MudStack>

        <MudText Typo="Typo.subtitle1" Class="mt-4 mb-2">@L.Translate("YtdOverviewHeading")</MudText>
        <MudGrid>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-3" Elevation="2">
                    <MudText Typo="Typo.caption">@L.Translate("ColGrossTotal")</MudText>
                    <MudText Typo="Typo.h5">@_ytd.TotalGross.ToString("N2")</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-3" Elevation="2">
                    <MudText Typo="Typo.caption">@L.Translate("TotalDeductionsLabel")</MudText>
                    <MudText Typo="Typo.h5">@_ytd.TotalDeductions.ToString("N2")</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-3" Elevation="2">
                    <MudText Typo="Typo.caption">@L.Translate("TotalNetPayLabel")</MudText>
                    <MudText Typo="Typo.h5">@_ytd.TotalNetPay.ToString("N2")</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-3" Elevation="2">
                    <MudText Typo="Typo.caption">@L.Translate("TotalTaxWithheldLabel")</MudText>
                    <MudText Typo="Typo.h5">@_ytd.TotalTax.ToString("N2")</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>
        <MudText Typo="Typo.caption" Class="mt-1">@string.Format(L.Translate("EmployeesPaidInFiscalYearTemplate"), _ytd.EmployeeCount)</MudText>

        <MudText Typo="Typo.subtitle1" Class="mt-5 mb-2">@L.Translate("CostCenterSummaryHeading")</MudText>
        @if (_costCenters.Count == 0)
        {
            <MudAlert Severity="Severity.Info">@L.Translate("NoDataInFiscalYearMessage")</MudAlert>
        }
        else
        {
            <MudSimpleTable Dense="true">
                <thead><tr><th>@L.Translate("CostCenterLabel")</th><th>@L.Translate("ColGrossTotal")</th><th>@L.Translate("PayRunColEmployeeCount")</th></tr></thead>
                <tbody>
                    @foreach (var cc in _costCenters)
                    {
                        <tr>
                            <td>@cc.CostCenterCode</td>
                            <td>@cc.TotalGross.ToString("N2")</td>
                            <td>@cc.EmployeeCount</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }

        <MudText Typo="Typo.subtitle1" Class="mt-5 mb-2">@L.Translate("PeriodsInFiscalYearHeading")</MudText>
        @if (_periods.Count == 0)
        {
            <MudAlert Severity="Severity.Info">@L.Translate("NoPayrollPeriodsInFiscalYearMessage")</MudAlert>
        }
        else
        {
            <MudSimpleTable Dense="true" Hover="true">
                <thead><tr><th>@L.Translate("Period")</th><th>@L.Translate("DateRangeLabel")</th><th>@L.Translate("ColStatus")</th><th>@L.Translate("PayRunColEmployeeCount")</th><th>@L.Translate("TotalNetPayLabel")</th><th></th></tr></thead>
                <tbody>
                    @foreach (var p in _periods)
                    {
                        <tr style="cursor:pointer" @onclick="@(() => Nav.NavigateTo($"/pay/dashboard/period/{p.RunId}"))">
                            <td>@p.PayrollPeriod</td>
                            <td>@p.PeriodStart.ToString("dd/MM/yyyy") - @p.PeriodEnd.ToString("dd/MM/yyyy")</td>
                            <td>@p.Status</td>
                            <td>@p.EmployeeCount</td>
                            <td>@p.TotalNetPay.ToString("N2")</td>
                            <td><MudLink Href="@($"/pay/dashboard/period/{p.RunId}")">@L.Translate("ViewDetailsLink")</MudLink></td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }

        @if (_negativeNetPay.Count > 0)
        {
            <MudAlert Severity="Severity.Error" Class="mt-5">
                @string.Format(L.Translate("NegativeNetPayInLatestPeriodTemplate"), string.Join(", ", _negativeNetPay.Select(e => $"{e.EmpNo} ({e.Hremployee.EmpName})")))
            </MudAlert>
        }
        @if (_excluded.Count > 0)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-2">
                @string.Format(L.Translate("ExcludedEmployeesInLatestPeriodTemplate"), string.Join(", ", _excluded.Select(e => $"{e.EmpNo} ({e.ExcludeReason})")))
            </MudAlert>
        }

        <MudGrid Class="mt-3">
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Class="pa-3" Elevation="2">
                    <MudText Typo="Typo.caption">@L.Translate("ActiveResignedEmployeesLabel")</MudText>
                    <MudText Typo="Typo.h5">@_activeCount / @_resignedCount</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Class="pa-3" Elevation="2" Style="@(_pendingApprovalCount > 0 ? "border-left:4px solid var(--mud-palette-warning)" : "")">
                    <MudText Typo="Typo.caption">@L.Translate("RunsPendingApprovalLabel")</MudText>
                    <MudText Typo="Typo.h5">@_pendingApprovalCount</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Class="pa-3" Elevation="2" Style="@(_pendingAdhocCount > 0 ? "border-left:4px solid var(--mud-palette-warning)" : "")">
                    <MudText Typo="Typo.caption">@L.Translate("AdhocPendingApprovalLabel")</MudText>
                    <MudText Typo="Typo.h5">@_pendingAdhocCount</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudText Typo="Typo.h6" Class="mt-5 mb-2">@L.Translate("RunStatusBoardHeading")</MudText>
        <MudSimpleTable Dense="true">
            <thead><tr><th>@L.Translate("ColStatus")</th><th>@L.Translate("RunCountLabel")</th></tr></thead>
            <tbody>
                @foreach (var kv in _runStatusBoard.OrderBy(k => k.Key))
                {
                    <tr><td>@kv.Key</td><td>@kv.Value</td></tr>
                }
            </tbody>
        </MudSimpleTable>

        <MudText Typo="Typo.h6" Class="mt-5 mb-2">@L.Translate("RecentActivityHeading")</MudText>
        <MudSimpleTable Dense="true">
            <thead><tr><th>@L.Translate("TimeLabel")</th><th>@L.Translate("EventLabel")</th><th>@L.Translate("Period")</th><th>@L.Translate("NoteLabel")</th></tr></thead>
            <tbody>
                @foreach (var log in _recentActivity)
                {
                    <tr>
                        <td>@log.EventDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@log.EventType</td>
                        <td>@log.Pay_PayrollRun.PayrollPeriod</td>
                        <td>@log.Comment</td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    }
</MudPaper>

@code {
    [SupplyParameterFromQuery(Name = "fy")]
    public int? FyQuery { get; set; }

    private string? _companyId;
    private bool _loaded;
    private int _fiscalYearStartMonth = 1;
    private int _currentFiscalYear;
    private int _fiscalYear;
    private DateOnly _fyStart;
    private DateOnly _fyEnd;

    private YtdSummary _ytd = new(0, 0, 0, 0, 0);
    private List<CostCenterRow> _costCenters = new();
    private List<FiscalPeriodRow> _periods = new();

    private Dictionary<PayrollRunStatus, int> _runStatusBoard = new();
    private int _pendingApprovalCount;
    private List<Pay_PayrollEmployee> _negativeNetPay = new();
    private List<Pay_PayrollEmployee> _excluded = new();
    private int _activeCount;
    private int _resignedCount;
    private int _pendingAdhocCount;
    private List<Pay_PayrollAuditLog> _recentActivity = new();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
        if (string.IsNullOrWhiteSpace(_companyId)) return;

        await using var context = await DbFactory.CreateDbContextAsync();

        var settings = await context.Pay_PayslipSettings.FirstOrDefaultAsync(s => s.CompanyId == _companyId);
        _fiscalYearStartMonth = settings?.FiscalYearStartMonth is int m and >= 1 and <= 12 ? m : 1;

        _currentFiscalYear = PayrollDashboardService.GetCurrentFiscalYear(_fiscalYearStartMonth, DateOnly.FromDateTime(DateTime.Today));
        _fiscalYear = FyQuery ?? _currentFiscalYear;
        (_fyStart, _fyEnd) = PayrollDashboardService.GetFiscalYearBounds(_fiscalYearStartMonth, _fiscalYear);

        _ytd = await PayrollDashboardService.GetYtdSummaryAsync(context, _companyId, _fyStart, _fyEnd);
        _costCenters = await PayrollDashboardService.GetCostCenterBreakdownAsync(context, _companyId, _fyStart, _fyEnd);
        _periods = await PayrollDashboardService.GetPeriodsInFiscalYearAsync(context, _companyId, _fyStart, _fyEnd);

        _runStatusBoard = await PayrollDashboardService.GetRunStatusBoardAsync(context, _companyId, 10);
        _pendingApprovalCount = await PayrollDashboardService.GetPendingApprovalCountAsync(context, _companyId);
        _negativeNetPay = await PayrollDashboardService.GetNegativeNetPayAlertsAsync(context, _companyId);
        _excluded = await PayrollDashboardService.GetExcludedEmployeesAsync(context, _companyId);
        (_activeCount, _resignedCount) = await PayrollDashboardService.GetHeadcountAsync(context, _companyId);
        _pendingAdhocCount = await PayrollDashboardService.GetPendingAdhocCountAsync(context, _companyId);
        _recentActivity = await PayrollDashboardService.GetRecentActivityAsync(context, _companyId, 20);

        _loaded = true;
    }

    private void GoToFiscalYear(int fy)
    {
        Nav.NavigateTo($"/pay/dashboard?fy={fy}");
    }

    private string FiscalYearLabel()
    {
        return _fiscalYearStartMonth == 1
            ? _fiscalYear.ToString(System.Globalization.CultureInfo.InvariantCulture)
            : $"{_fiscalYear}/{_fiscalYear + 1}";
    }
}
