@page "/pay/admin/provident-fund-policy"
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Pay.Calculators
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@inject JsonLocalizationService L
@attribute [Authorize(Policy = "Menu:PAY_ADMIN")]

<PageTitle>@L.Translate("ProvidentFundSettingsPageTitle")</PageTitle>

<MudPaper Class="pa-4 mb-4" MaxWidth="900px">
    <MudText Typo="Typo.h5">@L.Translate("ProvidentFundHeading")</MudText>
    <MudAlert Severity="Severity.Info" Class="mt-2">
        @((MarkupString)L.Translate("ProvidentFundInfoAlert"))
    </MudAlert>

    @if (string.IsNullOrEmpty(_companyId))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">@L.Translate("CompanyNotLinkedError")</MudAlert>
        return;
    }

    <MudDivider Class="my-4" />

    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.h6">@(_editingId is null ? L.Translate("AddNewPolicyRangeHeading") : L.Translate("EditPolicyRangeHeading"))</MudText>
        @if (!_showForm)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="OpenCreate">+ @L.Translate("AddPolicyRangeButton")</MudButton>
        }
    </MudStack>

    @if (_showForm)
    {
        <MudGrid Class="mt-1">
            <MudItem xs="12" sm="6"><MudDatePicker Label="@L.Translate("EffectiveFromLabel")" @bind-Date="_effectiveFrom" Editable="true" DateFormat="dd/MM/yyyy" /></MudItem>
            <MudItem xs="12" sm="6"><MudDatePicker Label="@L.Translate("EffectiveToLabel")" @bind-Date="_effectiveTo" Editable="true" DateFormat="dd/MM/yyyy" /></MudItem>
            <MudItem xs="12" sm="3"><MudNumericField T="decimal" @bind-Value="_minEmployeeRate" Label="@L.Translate("MinEmployeeRateLabel")" Format="0.00" Min="0" Max="100" /></MudItem>
            <MudItem xs="12" sm="3"><MudNumericField T="decimal" @bind-Value="_maxEmployeeRate" Label="@L.Translate("MaxEmployeeRateLabel")" Format="0.00" Min="0" Max="100" /></MudItem>
            <MudItem xs="12" sm="3"><MudNumericField T="decimal" @bind-Value="_minCompanyRate" Label="@L.Translate("MinCompanyRateLabel")" Format="0.00" Min="0" Max="100" /></MudItem>
            <MudItem xs="12" sm="3"><MudNumericField T="decimal" @bind-Value="_maxCompanyRate" Label="@L.Translate("MaxCompanyRateLabel")" Format="0.00" Min="0" Max="100" /></MudItem>
            <MudItem xs="12" sm="6"><MudNumericField T="int?" @bind-Value="_rateChangeLimitPerYear" Label="@L.Translate("RateChangeLimitLabel")" Min="1" /></MudItem>
            <MudItem xs="12" sm="6">
                <MudSwitch T="bool" @bind-Value="_isEnabled" Color="Color.Success" Label="@L.Translate("PfEnableSwitchLabel")" />
            </MudItem>
            @if (_isEnabled)
            {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Warning" Dense="true">
                        @L.Translate("PfEnabledWarningAlert")
                    </MudAlert>
                </MudItem>
            }
            <MudItem xs="12">
                <MudSwitch T="bool" @bind-Value="_useFundMembershipYears" Color="Color.Info" Label="ใช้อายุสมาชิกกองทุน (แยกจากอายุงาน) ในการคำนวณ vesting/สิ้นสุดสมาชิกภาพ" />
                <MudText Typo="Typo.caption" Class="ml-1" Style="opacity:.7;">ถ้าไม่เปิด จะใช้อายุงานปกติเหมือนเดิม — เปิดเมื่อบริษัทนับอายุสมาชิกกองทุนใหม่ทุกครั้งที่ลาออกจากกองทุนแล้วสมัครกลับเข้าใหม่</MudText>
            </MudItem>
            <MudItem xs="12"><MudTextField @bind-Value="_note" Label="@L.Translate("NoteLabel")" Lines="2" /></MudItem>
        </MudGrid>

        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
        }

        <MudStack Row="true" Spacing="2" Class="mt-3">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">
                @(_editingId is null ? L.Translate("AddPolicyRangeButton") : L.Translate("SaveEditButton"))
            </MudButton>
            <MudButton Variant="Variant.Text" OnClick="CancelEdit">@L.Translate("CancelButton")</MudButton>
        </MudStack>
    }

    <MudDivider Class="my-5" />

    <MudTable Items="_policies" Dense="true" Hover="true">
        <HeaderContent>
            <MudTh>@L.Translate("DateRangeLabel")</MudTh>
            <MudTh>@L.Translate("ColRateRangeEmpCompany")</MudTh>
            <MudTh>@L.Translate("ColRateChangesPerYear")</MudTh>
            <MudTh>@L.Translate("ColStatus")</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.EffectiveFrom.ToString("dd/MM/yyyy") - @(context.EffectiveTo?.ToString("dd/MM/yyyy") ?? L.Translate("NoDeadlineText"))</MudTd>
            <MudTd>@context.MinEmployeeRate.ToString("0.0")-@context.MaxEmployeeRate.ToString("0.0")% / @context.MinCompanyRate.ToString("0.0")-@context.MaxCompanyRate.ToString("0.0")%</MudTd>
            <MudTd>@(context.RateChangeLimitPerYear?.ToString() ?? L.Translate("UnlimitedText"))</MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Color="@(context.IsEnabled ? Color.Success : Color.Default)">
                    @(context.IsEnabled ? L.Translate("EnabledChip") : L.Translate("DisabledChip"))
                </MudChip>
            </MudTd>
            <MudTd>
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => StartEdit(context))">@L.Translate("EditButton")</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary" OnClick="@(() => SelectPolicyForTiersAsync(context))">@L.Translate("VestingTierButton")</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Tertiary" OnClick="@(() => SelectPolicyForWindowsAsync(context))">ช่วงเปลี่ยนอัตรา</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Tertiary" OnClick="@(() => SelectPolicyForMatrixAsync(context))">ตารางอัตราสมทบ</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Tertiary" OnClick="@(() => SelectPolicyForExitReasonsAsync(context))">เหตุผลสิ้นสุดสมาชิกภาพ</MudButton>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2">@L.Translate("NoPoliciesConfiguredMessage")</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@if (_tierPolicyId is not null)
{
    <MudPaper Class="pa-4 mb-4" MaxWidth="900px">
        <MudText Typo="Typo.h6">@L.Translate("VestingTierHeading")</MudText>
        <MudText Typo="Typo.body2" Class="mt-1">
            @L.Translate("VestingTierDesc")
        </MudText>

        @if (!_showTierForm)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Text" Class="mt-2" OnClick="@(() => _showTierForm = true)">+ @L.Translate("AddTierButton")</MudButton>
        }
        else
        {
            <MudGrid Class="mt-3">
                <MudItem xs="12" sm="3"><MudNumericField T="int" @bind-Value="_tierMinYears" Label="@L.Translate("TierMinYearsLabel")" Min="0" /></MudItem>
                <MudItem xs="12" sm="3"><MudNumericField T="int?" @bind-Value="_tierMaxYears" Label="@L.Translate("TierMaxYearsLabel")" Min="0" /></MudItem>
                <MudItem xs="12" sm="3"><MudNumericField T="decimal" @bind-Value="_tierVestingPercent" Label="@L.Translate("TierVestingPercentLabel")" Format="0.00" Min="0" Max="100" /></MudItem>
                <MudItem xs="12" sm="3"><MudNumericField T="int" @bind-Value="_tierSortOrder" Label="@L.Translate("ColSortOrder")" Min="0" /></MudItem>
            </MudGrid>
            <MudStack Row="true" Spacing="2" Class="mt-2">
                <MudButton Color="Color.Primary" Variant="Variant.Text" OnClick="AddTierAsync">@L.Translate("AddTierButton")</MudButton>
                <MudButton Variant="Variant.Text" OnClick="@(() => _showTierForm = false)">@L.Translate("CancelButton")</MudButton>
            </MudStack>
        }

        <MudTable Items="_vestingTiers" Dense="true" Hover="true" Class="mt-3">
            <HeaderContent>
                <MudTh>@L.Translate("ColYearsOfService")</MudTh>
                <MudTh>@L.Translate("TierVestingPercentLabel")</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.MinYearsOfService - @(context.MaxYearsOfService?.ToString() ?? L.Translate("NoCapText"))</MudTd>
                <MudTd>@context.VestingPercent.ToString("0.00")%</MudTd>
                <MudTd>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="@(() => RemoveTierAsync(context.Id))">@L.Translate("DeleteButton")</MudButton>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.body2">@L.Translate("NoTiersMessage")</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
}

@if (_windowPolicyId is not null)
{
    <MudPaper Class="pa-4 mb-4" MaxWidth="900px">
        <MudText Typo="Typo.h6">ช่วงเวลาเปิดรับคำขอเปลี่ยนอัตรา</MudText>
        <MudText Typo="Typo.body2" Class="mt-1">ตั้งได้หลายช่วงต่อปี (วน ทุกปี) — นอกช่วงที่กำหนด ปุ่มขอเปลี่ยนอัตราจะหายไปทั้งฝั่งพนักงานและ HR</MudText>

        @if (!_showWindowForm)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Text" Class="mt-2" OnClick="@(() => _showWindowForm = true)">+ เพิ่มช่วงเวลา</MudButton>
        }
        else
        {
            <MudGrid Class="mt-3">
                <MudItem xs="12" sm="4"><MudTextField @bind-Value="_winName" Label="ชื่อรอบ" /></MudItem>
                <MudItem xs="12" sm="4">
                    <MudGrid>
                        <MudItem xs="6"><MudNumericField T="int" @bind-Value="_winOpenFromMonth" Label="เปิดรับ เดือน" Min="1" Max="12" /></MudItem>
                        <MudItem xs="6"><MudNumericField T="int" @bind-Value="_winOpenFromDay" Label="วัน" Min="1" Max="31" /></MudItem>
                    </MudGrid>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudGrid>
                        <MudItem xs="6"><MudNumericField T="int" @bind-Value="_winOpenToMonth" Label="ถึง เดือน" Min="1" Max="12" /></MudItem>
                        <MudItem xs="6"><MudNumericField T="int" @bind-Value="_winOpenToDay" Label="วัน" Min="1" Max="31" /></MudItem>
                    </MudGrid>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudGrid>
                        <MudItem xs="6"><MudNumericField T="int" @bind-Value="_winEffectiveMonth" Label="มีผลวันที่ เดือน" Min="1" Max="12" /></MudItem>
                        <MudItem xs="6"><MudNumericField T="int" @bind-Value="_winEffectiveDay" Label="วัน" Min="1" Max="31" /></MudItem>
                    </MudGrid>
                </MudItem>
            </MudGrid>
            <MudStack Row="true" Spacing="2" Class="mt-2">
                <MudButton Color="Color.Primary" Variant="Variant.Text" OnClick="AddWindowAsync">เพิ่มช่วงเวลา</MudButton>
                <MudButton Variant="Variant.Text" OnClick="@(() => _showWindowForm = false)">@L.Translate("CancelButton")</MudButton>
            </MudStack>
        }

        <MudTable Items="_windows" Dense="true" Hover="true" Class="mt-3">
            <HeaderContent>
                <MudTh>ชื่อรอบ</MudTh><MudTh>เปิดรับ</MudTh><MudTh>มีผล</MudTh><MudTh>สถานะ</MudTh><MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Name</MudTd>
                <MudTd>@context.OpenFromDay.ToString("00")/@context.OpenFromMonth.ToString("00") - @context.OpenToDay.ToString("00")/@context.OpenToMonth.ToString("00")</MudTd>
                <MudTd>@context.EffectiveDay.ToString("00")/@context.EffectiveMonth.ToString("00")</MudTd>
                <MudTd><MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">@(context.IsActive ? "เปิดใช้งาน" : "ปิดใช้งาน")</MudChip></MudTd>
                <MudTd><MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => ToggleWindowActiveAsync(context))">@(context.IsActive ? "ปิด" : "เปิด")</MudButton></MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText Typo="Typo.body2">ยังไม่มีช่วงเวลาที่ตั้งค่า</MudText></NoRecordsContent>
        </MudTable>
    </MudPaper>
}

@if (_matrixPolicyId is not null)
{
    <MudPaper Class="pa-4 mb-4" MaxWidth="900px">
        <MudText Typo="Typo.h6">ตารางคำนวณอัตราเงินสมทบ (แนะนำอัตโนมัติ)</MudText>
        <MudText Typo="Typo.body2" Class="mt-1">ตามอายุงาน × อัตราเงินสะสมที่พนักงานเลือก — ใช้เป็นค่าที่เสนอในคำขอเปลี่ยนอัตราเท่านั้น HR ยังแก้ไขได้ก่อนอนุมัติ</MudText>

        @if (!_showMatrixForm)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Text" Class="mt-2" OnClick="@(() => _showMatrixForm = true)">+ เพิ่มแถว</MudButton>
        }
        else
        {
            <MudGrid Class="mt-3">
                <MudItem xs="6" sm="3"><MudNumericField T="int" @bind-Value="_mxMinYears" Label="อายุงานตั้งแต่ (ปี)" Min="0" /></MudItem>
                <MudItem xs="6" sm="3"><MudNumericField T="int?" @bind-Value="_mxMaxYears" Label="ถึงก่อน (ปี, เว้นว่าง=ไม่จำกัด)" Min="0" /></MudItem>
                <MudItem xs="6" sm="3"><MudNumericField T="decimal" @bind-Value="_mxEmpRateMin" Label="เงินสะสม %ตั้งแต่" Format="0.00" Min="0" Max="100" /></MudItem>
                <MudItem xs="6" sm="3"><MudNumericField T="decimal" @bind-Value="_mxEmpRateMax" Label="เงินสะสม %ถึง" Format="0.00" Min="0" Max="100" /></MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="ProvidentFundMatrixResultType" @bind-Value="_mxResultType" Label="ผลลัพธ์">
                        <MudSelectItem Value="ProvidentFundMatrixResultType.Fixed">อัตราคงที่</MudSelectItem>
                        <MudSelectItem Value="ProvidentFundMatrixResultType.MatchEmployeeRate">เท่ากับอัตราเงินสะสม</MudSelectItem>
                    </MudSelect>
                </MudItem>
                @if (_mxResultType == ProvidentFundMatrixResultType.Fixed)
                {
                    <MudItem xs="12" sm="6"><MudNumericField T="decimal" @bind-Value="_mxFixedRate" Label="อัตราคงที่ %" Format="0.00" Min="0" Max="100" /></MudItem>
                }
            </MudGrid>
            <MudStack Row="true" Spacing="2" Class="mt-2">
                <MudButton Color="Color.Primary" Variant="Variant.Text" OnClick="AddMatrixRuleAsync">เพิ่มแถว</MudButton>
                <MudButton Variant="Variant.Text" OnClick="@(() => _showMatrixForm = false)">@L.Translate("CancelButton")</MudButton>
            </MudStack>
        }

        <MudTable Items="_matrixRules" Dense="true" Hover="true" Class="mt-3">
            <HeaderContent>
                <MudTh>อายุงาน</MudTh><MudTh>เงินสะสม</MudTh><MudTh>ผลลัพธ์</MudTh><MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.MinYearsOfService - @(context.MaxYearsOfService?.ToString() ?? "ไม่จำกัด") ปี</MudTd>
                <MudTd>@context.EmployeeRateMin.ToString("0.0")-@context.EmployeeRateMax.ToString("0.0")%</MudTd>
                <MudTd>@(context.ResultType == ProvidentFundMatrixResultType.MatchEmployeeRate ? "เท่ากับเงินสะสม" : $"{context.FixedCompanyRate:0.00}%")</MudTd>
                <MudTd><MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="@(() => RemoveMatrixRuleAsync(context.Id))">@L.Translate("DeleteButton")</MudButton></MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText Typo="Typo.body2">ยังไม่มีตารางที่ตั้งค่า — ระบบจะไม่แนะนำอัตราให้ ต้องกรอกเอง</MudText></NoRecordsContent>
        </MudTable>
    </MudPaper>
}

@if (_exitReasonPolicyId is not null)
{
    <MudPaper Class="pa-4 mb-4" MaxWidth="900px">
        <MudText Typo="Typo.h6">เหตุผลการสิ้นสุดสมาชิกภาพ</MudText>
        <MudText Typo="Typo.body2" Class="mt-1">แต่ละเหตุผลกำหนดผลต่อเงินสมทบนายจ้าง — ใช้เมื่อ HR เปิดเคสปิดสมาชิกภาพ</MudText>

        @if (!_showExitReasonForm)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Text" Class="mt-2" OnClick="@(() => _showExitReasonForm = true)">+ เพิ่มเหตุผล</MudButton>
        }
        else
        {
            <MudGrid Class="mt-3">
                <MudItem xs="12" sm="3"><MudTextField @bind-Value="_erCode" Label="รหัส" /></MudItem>
                <MudItem xs="12" sm="4"><MudTextField @bind-Value="_erName" Label="ชื่อเหตุผล" /></MudItem>
                <MudItem xs="12" sm="5">
                    <MudSelect T="ProvidentFundExitVestingOverride" @bind-Value="_erOverrideType" Label="ผลต่อเงินสมทบ">
                        <MudSelectItem Value="ProvidentFundExitVestingOverride.UseNormalTier">ใช้ตาราง vesting ปกติ</MudSelectItem>
                        <MudSelectItem Value="ProvidentFundExitVestingOverride.ForceZero">ริบทั้งหมด (0%)</MudSelectItem>
                        <MudSelectItem Value="ProvidentFundExitVestingOverride.ForceFull">จ่ายเต็มจำนวน (100%)</MudSelectItem>
                    </MudSelect>
                </MudItem>
                @if (_erOverrideType == ProvidentFundExitVestingOverride.ForceZero)
                {
                    <MudItem xs="12">
                        <MudSwitch T="bool" @bind-Value="_erRequiresException" Color="Color.Info" Label="มีข้อยกเว้น (อายุ + อายุสมาชิกกองทุนขั้นต่ำ) ให้จ่ายเต็มจำนวนแทน" />
                    </MudItem>
                    @if (_erRequiresException)
                    {
                        <MudItem xs="6" sm="3"><MudNumericField T="int?" @bind-Value="_erMinAge" Label="อายุขั้นต่ำ (ปี)" Min="0" /></MudItem>
                        <MudItem xs="6" sm="3"><MudNumericField T="int?" @bind-Value="_erMinMembershipYears" Label="อายุสมาชิกขั้นต่ำ (ปี)" Min="0" /></MudItem>
                    }
                }
            </MudGrid>
            <MudStack Row="true" Spacing="2" Class="mt-2">
                <MudButton Color="Color.Primary" Variant="Variant.Text" OnClick="AddExitReasonAsync">เพิ่มเหตุผล</MudButton>
                <MudButton Variant="Variant.Text" OnClick="@(() => _showExitReasonForm = false)">@L.Translate("CancelButton")</MudButton>
            </MudStack>
        }

        <MudTable Items="_exitReasons" Dense="true" Hover="true" Class="mt-3">
            <HeaderContent>
                <MudTh>รหัส</MudTh><MudTh>ชื่อ</MudTh><MudTh>ผล</MudTh><MudTh>สถานะ</MudTh><MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Code</MudTd>
                <MudTd>@context.Name</MudTd>
                <MudTd>
                    @(context.OverrideType switch
                    {
                        ProvidentFundExitVestingOverride.ForceZero => context.RequiresAgeAndMembershipCheck ? $"ริบทั้งหมด (ยกเว้นอายุ≥{context.MinAgeForException}+สมาชิก≥{context.MinMembershipYearsForException}ปี)" : "ริบทั้งหมด",
                        ProvidentFundExitVestingOverride.ForceFull => "จ่ายเต็มจำนวน",
                        _ => "ใช้ตาราง vesting ปกติ",
                    })
                </MudTd>
                <MudTd><MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">@(context.IsActive ? "เปิดใช้งาน" : "ปิดใช้งาน")</MudChip></MudTd>
                <MudTd><MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => ToggleExitReasonActiveAsync(context))">@(context.IsActive ? "ปิด" : "เปิด")</MudButton></MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText Typo="Typo.body2">ยังไม่มีเหตุผลที่ตั้งค่า</MudText></NoRecordsContent>
        </MudTable>
    </MudPaper>
}

<MudPaper Class="pa-4 mb-4" MaxWidth="900px">
    <MudText Typo="Typo.h6">@L.Translate("InvestmentPolicyHeading")</MudText>
    <MudText Typo="Typo.body2" Class="mt-1">
        @L.Translate("InvestmentPolicyDesc")
    </MudText>

    @if (!_showInvestmentForm)
    {
        <MudButton Color="Color.Primary" Variant="Variant.Text" Class="mt-2" OnClick="@(() => _showInvestmentForm = true)">+ @L.Translate("AddInvestmentPolicyButton")</MudButton>
    }
    else
    {
        <MudGrid Class="mt-2">
            <MudItem xs="12" sm="3"><MudTextField @bind-Value="_invCode" Label="@L.Translate("ColCode")" /></MudItem>
            <MudItem xs="12" sm="4"><MudTextField @bind-Value="_invName" Label="@L.Translate("InvNameLabel")" /></MudItem>
            <MudItem xs="12" sm="5"><MudTextField @bind-Value="_invRiskDescription" Label="@L.Translate("InvRiskDescriptionLabel")" /></MudItem>
        </MudGrid>
        <MudStack Row="true" Spacing="2" Class="mt-2">
            <MudButton Color="Color.Primary" Variant="Variant.Text" OnClick="AddInvestmentPolicyAsync">@L.Translate("AddInvestmentPolicyButton")</MudButton>
            <MudButton Variant="Variant.Text" OnClick="@(() => _showInvestmentForm = false)">@L.Translate("CancelButton")</MudButton>
        </MudStack>
    }

    <MudTable Items="_investmentPolicies" Dense="true" Hover="true" Class="mt-3">
        <HeaderContent>
            <MudTh>@L.Translate("ColCode")</MudTh>
            <MudTh>@L.Translate("ColName")</MudTh>
            <MudTh>@L.Translate("ColRisk")</MudTh>
            <MudTh>@L.Translate("ColStatus")</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Code</MudTd>
            <MudTd>@context.Name</MudTd>
            <MudTd>@context.RiskDescription</MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                    @(context.IsActive ? L.Translate("PeriodActiveStatus") : L.Translate("PeriodInactiveStatus"))
                </MudChip>
            </MudTd>
            <MudTd>
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => ToggleInvestmentPolicyActiveAsync(context))">
                    @(context.IsActive ? L.Translate("DeactivateButton") : L.Translate("ActivateButton"))
                </MudButton>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2">@L.Translate("NoInvestmentPoliciesMessage")</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

<MudPaper Class="pa-4 mb-4" MaxWidth="900px">
    <MudText Typo="Typo.h6">@L.Translate("TestCalculationHeading")</MudText>
    <MudText Typo="Typo.body2" Class="mt-1">
        @L.Translate("PfTestCalcDesc")
    </MudText>
    <MudGrid Class="mt-2">
        <MudItem xs="12" sm="4"><MudDatePicker Label="@L.Translate("HireDateLabel")" @bind-Date="_testHireDate" Editable="true" DateFormat="dd/MM/yyyy" /></MudItem>
        <MudItem xs="12" sm="4"><MudDatePicker Label="@L.Translate("AsOfDateLabel")" @bind-Date="_testAsOfDate" Editable="true" DateFormat="dd/MM/yyyy" /></MudItem>
        <MudItem xs="12" sm="4"><MudNumericField T="decimal" @bind-Value="_testWage" Label="@L.Translate("SalaryBahtLabel")" Format="N2" Min="0" /></MudItem>
        <MudItem xs="12" sm="6"><MudNumericField T="decimal" @bind-Value="_testEmployeeRate" Label="@L.Translate("TestEmployeeRateLabel")" Format="0.00" Min="0" Max="100" /></MudItem>
        <MudItem xs="12" sm="6"><MudNumericField T="decimal" @bind-Value="_testCompanyRate" Label="@L.Translate("TestCompanyRateLabel")" Format="0.00" Min="0" Max="100" /></MudItem>
    </MudGrid>
    <MudButton Color="Color.Secondary" Variant="Variant.Text" Class="mt-3" OnClick="RunPreviewAsync">@L.Translate("CalculatePreviewButton")</MudButton>

    @if (_previewResult is not null)
    {
        <MudAlert Severity="Severity.Info" Class="mt-3">
            @((MarkupString)string.Format(L.Translate("PfPreviewResultTemplate"),
                _previewResult.Value.Pf.EmployeeAmount.ToString("N2"),
                _previewResult.Value.Pf.CompanyAmount.ToString("N2"),
                _previewResult.Value.Vesting.YearsOfService.ToString("0.00"),
                _previewResult.Value.Vesting.ServiceDays,
                _previewResult.Value.Vesting.VestingPercent.ToString("0.00")))
            @if (_previewResult.Value.Vesting.MatchedTierNote is not null)
            {
                <text> @string.Format(L.Translate("TierNoteTemplate"), _previewResult.Value.Vesting.MatchedTierNote)</text>
            }
            @if (!string.IsNullOrEmpty(_previewPolicyNote))
            {
                <br />
                <MudText Typo="Typo.caption">@_previewPolicyNote</MudText>
            }
        </MudAlert>
    }
</MudPaper>

@code {
    private string? _companyId;
    private List<Pay_ProvidentFundPolicy> _policies = new();
    private string? _error;
    private long? _editingId;
    private bool _showForm;

    private DateTime? _effectiveFrom = DateTime.Today;
    private DateTime? _effectiveTo;
    private decimal _minEmployeeRate = 2m;
    private decimal _maxEmployeeRate = 15m;
    private decimal _minCompanyRate = 2m;
    private decimal _maxCompanyRate = 15m;
    private int? _rateChangeLimitPerYear;
    private bool _isEnabled;
    private bool _useFundMembershipYears;
    private string? _note;

    private long? _tierPolicyId;
    private bool _showTierForm;
    private List<Pay_ProvidentFundVestingTier> _vestingTiers = new();
    private int _tierMinYears;
    private int? _tierMaxYears;
    private decimal _tierVestingPercent = 100m;
    private int _tierSortOrder;

    private long? _windowPolicyId;
    private bool _showWindowForm;
    private List<Pay_ProvidentFundRateChangeWindow> _windows = new();
    private string? _winName;
    private int _winOpenFromMonth = 1;
    private int _winOpenFromDay = 1;
    private int _winOpenToMonth = 1;
    private int _winOpenToDay = 31;
    private int _winEffectiveMonth = 1;
    private int _winEffectiveDay = 1;

    private long? _matrixPolicyId;
    private bool _showMatrixForm;
    private List<Pay_ProvidentFundRateMatrixRule> _matrixRules = new();
    private int _mxMinYears;
    private int? _mxMaxYears;
    private decimal _mxEmpRateMin = 2m;
    private decimal _mxEmpRateMax = 15m;
    private ProvidentFundMatrixResultType _mxResultType = ProvidentFundMatrixResultType.Fixed;
    private decimal _mxFixedRate = 3m;

    private long? _exitReasonPolicyId;
    private bool _showExitReasonForm;
    private List<Pay_ProvidentFundExitReasonRule> _exitReasons = new();
    private string? _erCode;
    private string? _erName;
    private ProvidentFundExitVestingOverride _erOverrideType = ProvidentFundExitVestingOverride.UseNormalTier;
    private bool _erRequiresException;
    private int? _erMinAge;
    private int? _erMinMembershipYears;

    private bool _showInvestmentForm;
    private List<Pay_ProvidentFundInvestmentPolicy> _investmentPolicies = new();
    private string? _invCode;
    private string? _invName;
    private string? _invRiskDescription;

    private DateTime? _testHireDate = DateTime.Today.AddYears(-2);
    private DateTime? _testAsOfDate = DateTime.Today;
    private decimal _testWage = 20000m;
    private decimal _testEmployeeRate = 3m;
    private decimal _testCompanyRate = 3m;
    private (ProvidentFundCalculator.ProvidentFundResult Pf, ProvidentFundVestingCalculator.VestingResult Vesting)? _previewResult;
    private string? _previewPolicyNote;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
        if (string.IsNullOrWhiteSpace(_companyId)) return;

        await LoadAsync();
        await LoadInvestmentPoliciesAsync();
    }

    private async Task LoadAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        _policies = await context.Pay_ProvidentFundPolicies
            .Where(p => p.CompanyId == _companyId)
            .OrderBy(p => p.EffectiveFrom)
            .ToListAsync();
    }

    private async Task LoadInvestmentPoliciesAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        _investmentPolicies = await context.Pay_ProvidentFundInvestmentPolicies
            .Where(p => p.CompanyId == _companyId)
            .OrderBy(p => p.SortOrder)
            .ToListAsync();
    }

    private void OpenCreate()
    {
        CancelEdit();
        _showForm = true;
    }

    private void StartEdit(Pay_ProvidentFundPolicy policy)
    {
        _editingId = policy.Id;
        _effectiveFrom = policy.EffectiveFrom.ToDateTime(TimeOnly.MinValue);
        _effectiveTo = policy.EffectiveTo?.ToDateTime(TimeOnly.MinValue);
        _minEmployeeRate = policy.MinEmployeeRate;
        _maxEmployeeRate = policy.MaxEmployeeRate;
        _minCompanyRate = policy.MinCompanyRate;
        _maxCompanyRate = policy.MaxCompanyRate;
        _rateChangeLimitPerYear = policy.RateChangeLimitPerYear;
        _isEnabled = policy.IsEnabled;
        _useFundMembershipYears = policy.UseFundMembershipYearsForVesting;
        _note = policy.Note;
        _error = null;
        _showForm = true;
    }

    private void CancelEdit()
    {
        _editingId = null;
        _effectiveFrom = DateTime.Today;
        _effectiveTo = null;
        _minEmployeeRate = 2m;
        _maxEmployeeRate = 15m;
        _minCompanyRate = 2m;
        _maxCompanyRate = 15m;
        _rateChangeLimitPerYear = null;
        _isEnabled = false;
        _useFundMembershipYears = false;
        _note = null;
        _error = null;
        _showForm = false;
    }

    private async Task SaveAsync()
    {
        _error = null;

        if (_effectiveFrom is null)
        {
            _error = L.Translate("InvalidEffectiveDateError");
            return;
        }
        if (_effectiveTo is not null && _effectiveTo < _effectiveFrom)
        {
            _error = L.Translate("EndDateBeforeStartError");
            return;
        }
        if (_minEmployeeRate < 2m || _maxEmployeeRate > 15m || _minCompanyRate < 2m || _maxCompanyRate > 15m)
        {
            _error = L.Translate("PfRateOutOfRangeError");
            return;
        }
        if (_minEmployeeRate > _maxEmployeeRate || _minCompanyRate > _maxCompanyRate)
        {
            _error = L.Translate("MinNotGreaterThanMaxError");
            return;
        }

        await using var context = await DbFactory.CreateDbContextAsync();

        var effectiveFrom = DateOnly.FromDateTime(_effectiveFrom.Value);
        var effectiveTo = _effectiveTo is not null ? DateOnly.FromDateTime(_effectiveTo.Value) : (DateOnly?)null;

        if (_editingId is long id)
        {
            var existing = await context.Pay_ProvidentFundPolicies.FirstOrDefaultAsync(p => p.Id == id && p.CompanyId == _companyId);
            if (existing is null)
            {
                _error = L.Translate("PolicyNotFoundError");
                return;
            }
            existing.EffectiveFrom = effectiveFrom;
            existing.EffectiveTo = effectiveTo;
            existing.MinEmployeeRate = _minEmployeeRate;
            existing.MaxEmployeeRate = _maxEmployeeRate;
            existing.MinCompanyRate = _minCompanyRate;
            existing.MaxCompanyRate = _maxCompanyRate;
            existing.RateChangeLimitPerYear = _rateChangeLimitPerYear;
            existing.IsEnabled = _isEnabled;
            existing.UseFundMembershipYearsForVesting = _useFundMembershipYears;
            existing.Note = _note;
        }
        else
        {
            context.Pay_ProvidentFundPolicies.Add(new Pay_ProvidentFundPolicy
            {
                CompanyId = _companyId!,
                EffectiveFrom = effectiveFrom,
                EffectiveTo = effectiveTo,
                MinEmployeeRate = _minEmployeeRate,
                MaxEmployeeRate = _maxEmployeeRate,
                MinCompanyRate = _minCompanyRate,
                MaxCompanyRate = _maxCompanyRate,
                RateChangeLimitPerYear = _rateChangeLimitPerYear,
                IsEnabled = _isEnabled,
                UseFundMembershipYearsForVesting = _useFundMembershipYears,
                Note = _note,
            });
        }

        await context.SaveChangesAsync();
        Snackbar.Add(_editingId is null ? L.Translate("PolicyAddedSuccess") : L.Translate("GradeEditSavedSuccess"), Severity.Success);
        CancelEdit();
        await LoadAsync();
    }

    private async Task SelectPolicyForTiersAsync(Pay_ProvidentFundPolicy policy)
    {
        _tierPolicyId = policy.Id;
        _showTierForm = false;
        await LoadTiersAsync();
    }

    private async Task LoadTiersAsync()
    {
        if (_tierPolicyId is null) return;
        await using var context = await DbFactory.CreateDbContextAsync();
        _vestingTiers = await context.Pay_ProvidentFundVestingTiers
            .Where(t => t.PolicyId == _tierPolicyId && t.IsActive)
            .OrderBy(t => t.SortOrder)
            .ToListAsync();
    }

    private async Task AddTierAsync()
    {
        if (_tierPolicyId is null) return;
        await using var context = await DbFactory.CreateDbContextAsync();
        context.Pay_ProvidentFundVestingTiers.Add(new Pay_ProvidentFundVestingTier
        {
            PolicyId = _tierPolicyId.Value,
            MinYearsOfService = _tierMinYears,
            MaxYearsOfService = _tierMaxYears,
            VestingPercent = _tierVestingPercent,
            SortOrder = _tierSortOrder,
        });
        await context.SaveChangesAsync();
        Snackbar.Add(L.Translate("TierAddedSuccess"), Severity.Success);
        _showTierForm = false;
        await LoadTiersAsync();
    }

    private async Task RemoveTierAsync(long tierId)
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var tier = await context.Pay_ProvidentFundVestingTiers.FirstOrDefaultAsync(t => t.Id == tierId);
        if (tier is null) return;
        tier.IsActive = false;
        await context.SaveChangesAsync();
        await LoadTiersAsync();
    }

    private async Task SelectPolicyForWindowsAsync(Pay_ProvidentFundPolicy policy)
    {
        _windowPolicyId = policy.Id;
        _showWindowForm = false;
        await LoadWindowsAsync();
    }

    private async Task LoadWindowsAsync()
    {
        if (_windowPolicyId is null) return;
        await using var context = await DbFactory.CreateDbContextAsync();
        _windows = await context.Pay_ProvidentFundRateChangeWindows.Where(w => w.PolicyId == _windowPolicyId).ToListAsync();
    }

    private async Task AddWindowAsync()
    {
        if (_windowPolicyId is null || string.IsNullOrWhiteSpace(_winName)) return;
        await using var context = await DbFactory.CreateDbContextAsync();
        context.Pay_ProvidentFundRateChangeWindows.Add(new Pay_ProvidentFundRateChangeWindow
        {
            PolicyId = _windowPolicyId.Value,
            Name = _winName,
            OpenFromMonth = _winOpenFromMonth,
            OpenFromDay = _winOpenFromDay,
            OpenToMonth = _winOpenToMonth,
            OpenToDay = _winOpenToDay,
            EffectiveMonth = _winEffectiveMonth,
            EffectiveDay = _winEffectiveDay,
            IsActive = true,
        });
        await context.SaveChangesAsync();
        Snackbar.Add("เพิ่มช่วงเวลาแล้ว", Severity.Success);
        _winName = null;
        _showWindowForm = false;
        await LoadWindowsAsync();
    }

    private async Task ToggleWindowActiveAsync(Pay_ProvidentFundRateChangeWindow window)
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var existing = await context.Pay_ProvidentFundRateChangeWindows.FirstOrDefaultAsync(w => w.Id == window.Id);
        if (existing is null) return;
        existing.IsActive = !existing.IsActive;
        await context.SaveChangesAsync();
        await LoadWindowsAsync();
    }

    private async Task SelectPolicyForMatrixAsync(Pay_ProvidentFundPolicy policy)
    {
        _matrixPolicyId = policy.Id;
        _showMatrixForm = false;
        await LoadMatrixRulesAsync();
    }

    private async Task LoadMatrixRulesAsync()
    {
        if (_matrixPolicyId is null) return;
        await using var context = await DbFactory.CreateDbContextAsync();
        _matrixRules = await context.Pay_ProvidentFundRateMatrixRules.Where(r => r.PolicyId == _matrixPolicyId && r.IsActive).OrderBy(r => r.SortOrder).ToListAsync();
    }

    private async Task AddMatrixRuleAsync()
    {
        if (_matrixPolicyId is null) return;
        await using var context = await DbFactory.CreateDbContextAsync();
        context.Pay_ProvidentFundRateMatrixRules.Add(new Pay_ProvidentFundRateMatrixRule
        {
            PolicyId = _matrixPolicyId.Value,
            MinYearsOfService = _mxMinYears,
            MaxYearsOfService = _mxMaxYears,
            EmployeeRateMin = _mxEmpRateMin,
            EmployeeRateMax = _mxEmpRateMax,
            ResultType = _mxResultType,
            FixedCompanyRate = _mxResultType == ProvidentFundMatrixResultType.Fixed ? _mxFixedRate : null,
            SortOrder = _matrixRules.Count,
        });
        await context.SaveChangesAsync();
        Snackbar.Add("เพิ่มแถวแล้ว", Severity.Success);
        _showMatrixForm = false;
        await LoadMatrixRulesAsync();
    }

    private async Task RemoveMatrixRuleAsync(long ruleId)
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var rule = await context.Pay_ProvidentFundRateMatrixRules.FirstOrDefaultAsync(r => r.Id == ruleId);
        if (rule is null) return;
        rule.IsActive = false;
        await context.SaveChangesAsync();
        await LoadMatrixRulesAsync();
    }

    private async Task SelectPolicyForExitReasonsAsync(Pay_ProvidentFundPolicy policy)
    {
        _exitReasonPolicyId = policy.Id;
        _showExitReasonForm = false;
        await LoadExitReasonsAsync();
    }

    private async Task LoadExitReasonsAsync()
    {
        if (_exitReasonPolicyId is null) return;
        await using var context = await DbFactory.CreateDbContextAsync();
        _exitReasons = await context.Pay_ProvidentFundExitReasonRules.Where(r => r.PolicyId == _exitReasonPolicyId).OrderBy(r => r.SortOrder).ToListAsync();
    }

    private async Task AddExitReasonAsync()
    {
        if (_exitReasonPolicyId is null || string.IsNullOrWhiteSpace(_erCode) || string.IsNullOrWhiteSpace(_erName)) return;
        await using var context = await DbFactory.CreateDbContextAsync();
        context.Pay_ProvidentFundExitReasonRules.Add(new Pay_ProvidentFundExitReasonRule
        {
            PolicyId = _exitReasonPolicyId.Value,
            Code = _erCode,
            Name = _erName,
            OverrideType = _erOverrideType,
            RequiresAgeAndMembershipCheck = _erOverrideType == ProvidentFundExitVestingOverride.ForceZero && _erRequiresException,
            MinAgeForException = _erRequiresException ? _erMinAge : null,
            MinMembershipYearsForException = _erRequiresException ? _erMinMembershipYears : null,
            IsActive = true,
            SortOrder = _exitReasons.Count,
        });
        await context.SaveChangesAsync();
        Snackbar.Add("เพิ่มเหตุผลแล้ว", Severity.Success);
        _erCode = null; _erName = null; _erRequiresException = false; _erMinAge = null; _erMinMembershipYears = null;
        _showExitReasonForm = false;
        await LoadExitReasonsAsync();
    }

    private async Task ToggleExitReasonActiveAsync(Pay_ProvidentFundExitReasonRule reason)
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var existing = await context.Pay_ProvidentFundExitReasonRules.FirstOrDefaultAsync(r => r.Id == reason.Id);
        if (existing is null) return;
        existing.IsActive = !existing.IsActive;
        await context.SaveChangesAsync();
        await LoadExitReasonsAsync();
    }

    private async Task AddInvestmentPolicyAsync()
    {
        if (string.IsNullOrWhiteSpace(_invCode) || string.IsNullOrWhiteSpace(_invName))
        {
            Snackbar.Add(L.Translate("FillInvCodeNameError"), Severity.Warning);
            return;
        }

        await using var context = await DbFactory.CreateDbContextAsync();
        context.Pay_ProvidentFundInvestmentPolicies.Add(new Pay_ProvidentFundInvestmentPolicy
        {
            CompanyId = _companyId!,
            Code = _invCode,
            Name = _invName,
            RiskDescription = _invRiskDescription,
            SortOrder = _investmentPolicies.Count,
            IsActive = true,
        });
        await context.SaveChangesAsync();
        Snackbar.Add(L.Translate("InvestmentPolicyAddedSuccess"), Severity.Success);
        _invCode = null; _invName = null; _invRiskDescription = null;
        _showInvestmentForm = false;
        await LoadInvestmentPoliciesAsync();
    }

    private async Task ToggleInvestmentPolicyActiveAsync(Pay_ProvidentFundInvestmentPolicy policy)
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var existing = await context.Pay_ProvidentFundInvestmentPolicies.FirstOrDefaultAsync(p => p.Id == policy.Id);
        if (existing is null) return;
        existing.IsActive = !existing.IsActive;
        await context.SaveChangesAsync();
        await LoadInvestmentPoliciesAsync();
    }

    private async Task RunPreviewAsync()
    {
        if (_testHireDate is null || _testAsOfDate is null) return;

        var hireDate = DateOnly.FromDateTime(_testHireDate.Value);
        var asOfDate = DateOnly.FromDateTime(_testAsOfDate.Value);
        if (asOfDate < hireDate) return;

        // Resolve tiers fresh from whichever policy actually applies as of the
        // reference date, instead of reusing _vestingTiers — that field is only
        // populated when HR clicks "Vesting Tier" on a specific policy row, so
        // running this preview without doing that first used to silently treat
        // real, already-configured tiers as absent (misreporting 100% vesting).
        await using var context = await DbFactory.CreateDbContextAsync();
        var applicablePolicy = await context.Pay_ProvidentFundPolicies
            .Where(p => p.CompanyId == _companyId && p.IsEnabled
                        && p.EffectiveFrom <= asOfDate && (p.EffectiveTo == null || p.EffectiveTo >= asOfDate))
            .FirstOrDefaultAsync();

        var tiers = applicablePolicy is null
            ? new List<Pay_ProvidentFundVestingTier>()
            : await context.Pay_ProvidentFundVestingTiers
                .Where(t => t.PolicyId == applicablePolicy.Id && t.IsActive)
                .OrderBy(t => t.SortOrder)
                .ToListAsync();

        _previewPolicyNote = applicablePolicy is null
            ? L.Translate("NoApplicablePolicyNote")
            : string.Format(L.Translate("UsingTierFromPolicyTemplate"), applicablePolicy.EffectiveFrom.ToString("dd/MM/yyyy"), applicablePolicy.EffectiveTo?.ToString("dd/MM/yyyy") ?? L.Translate("NoDeadlineText"));

        var pf = ProvidentFundCalculator.Calculate(_testWage, _testEmployeeRate, _testCompanyRate);
        var vesting = ProvidentFundVestingCalculator.ResolveVesting(hireDate, asOfDate, tiers);
        _previewResult = (pf, vesting);
    }
}
