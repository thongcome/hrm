@page "/pay/admin/provident-fund-policy"
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Pay.Calculators
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@attribute [Authorize(Policy = "Menu:PAY_ADMIN")]

<PageTitle>ตั้งค่ากองทุนสำรองเลี้ยงชีพ</PageTitle>

<MudPaper Class="pa-4 mb-4" MaxWidth="900px">
    <MudText Typo="Typo.h5">กองทุนสำรองเลี้ยงชีพ (Provident Fund)</MudText>
    <MudAlert Severity="Severity.Info" Class="mt-2">
        กองทุนสมัครใจของนายจ้าง ตาม พ.ร.บ.กองทุนสำรองเลี้ยงชีพ พ.ศ. 2530 — อัตราเงินสะสม/เงินสมทบตามกฎหมายอยู่ในช่วง <b>2-15%</b>
        และ<b>เงินสมทบนายจ้างต้องไม่ต่ำกว่าเงินสะสมพนักงาน</b> ส่วน vesting/ความถี่การเปลี่ยนอัตราไม่มีมาตรฐานตายตัวตามกฎหมาย — ขึ้นกับข้อบังคับกองทุนแต่ละแห่ง จึงต้องตั้งค่าเอง
    </MudAlert>

    @if (string.IsNullOrEmpty(_companyId))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">บัญชีของคุณยังไม่ได้ผูกกับบริษัทใดๆ — ติดต่อแอดมินให้ตั้งค่า empid ก่อน</MudAlert>
        return;
    }

    <MudDivider Class="my-4" />

    <MudText Typo="Typo.h6">@(_editingId is null ? "เพิ่มช่วงนโยบายใหม่" : "แก้ไขช่วงนโยบาย")</MudText>
    <MudGrid Class="mt-1">
        <MudItem xs="12" sm="6"><MudDatePicker Label="มีผลตั้งแต่" @bind-Date="_effectiveFrom" Editable="true" DateFormat="dd/MM/yyyy" /></MudItem>
        <MudItem xs="12" sm="6"><MudDatePicker Label="ถึงวันที่ (เว้นว่าง = ไม่มีกำหนด)" @bind-Date="_effectiveTo" Editable="true" DateFormat="dd/MM/yyyy" /></MudItem>
        <MudItem xs="12" sm="3"><MudNumericField T="decimal" @bind-Value="_minEmployeeRate" Label="อัตราสะสมขั้นต่ำ (%)" Format="0.00" Min="0" Max="100" /></MudItem>
        <MudItem xs="12" sm="3"><MudNumericField T="decimal" @bind-Value="_maxEmployeeRate" Label="อัตราสะสมสูงสุด (%)" Format="0.00" Min="0" Max="100" /></MudItem>
        <MudItem xs="12" sm="3"><MudNumericField T="decimal" @bind-Value="_minCompanyRate" Label="อัตราสมทบขั้นต่ำ (%)" Format="0.00" Min="0" Max="100" /></MudItem>
        <MudItem xs="12" sm="3"><MudNumericField T="decimal" @bind-Value="_maxCompanyRate" Label="อัตราสมทบสูงสุด (%)" Format="0.00" Min="0" Max="100" /></MudItem>
        <MudItem xs="12" sm="6"><MudNumericField T="int?" @bind-Value="_rateChangeLimitPerYear" Label="จำนวนครั้งที่เปลี่ยนอัตราได้ต่อปี (เว้นว่าง = ไม่จำกัด)" Min="1" /></MudItem>
        <MudItem xs="12" sm="6">
            <MudSwitch T="bool" @bind-Value="_isEnabled" Color="Color.Success" Label="เปิดใช้งาน" />
        </MudItem>
        @if (_isEnabled)
        {
            <MudItem xs="12">
                <MudAlert Severity="Severity.Warning" Dense="true">
                    การเปิดใช้งานนี้จะทำให้บริษัทได้รับยกเว้นไม่ต้องนำส่งกองทุนสงเคราะห์ลูกจ้างอัตโนมัติ ตามมาตรา 130 พ.ร.บ.คุ้มครองแรงงาน
                    (ระบบจะข้ามการหักกองทุนสงเคราะห์ลูกจ้างให้เองตอนรันเงินเดือน ถ้าช่วงนโยบายนี้ทับซ้อนกับงวดนั้น)
                </MudAlert>
            </MudItem>
        }
        <MudItem xs="12"><MudTextField @bind-Value="_note" Label="หมายเหตุ" Lines="2" /></MudItem>
    </MudGrid>

    @if (!string.IsNullOrEmpty(_error))
    {
        <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
    }

    <MudStack Row="true" Spacing="2" Class="mt-3">
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">
            @(_editingId is null ? "เพิ่มช่วงนโยบาย" : "บันทึกการแก้ไข")
        </MudButton>
        @if (_editingId is not null)
        {
            <MudButton Variant="Variant.Text" OnClick="CancelEdit">ยกเลิก</MudButton>
        }
    </MudStack>

    <MudDivider Class="my-5" />

    <MudTable Items="_policies" Dense="true" Hover="true">
        <HeaderContent>
            <MudTh>ช่วงวันที่</MudTh>
            <MudTh>ช่วงอัตราสะสม/สมทบ</MudTh>
            <MudTh>เปลี่ยนอัตราได้/ปี</MudTh>
            <MudTh>สถานะ</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.EffectiveFrom.ToString("dd/MM/yyyy") - @(context.EffectiveTo?.ToString("dd/MM/yyyy") ?? "ไม่มีกำหนด")</MudTd>
            <MudTd>@context.MinEmployeeRate.ToString("0.0")-@context.MaxEmployeeRate.ToString("0.0")% / @context.MinCompanyRate.ToString("0.0")-@context.MaxCompanyRate.ToString("0.0")%</MudTd>
            <MudTd>@(context.RateChangeLimitPerYear?.ToString() ?? "ไม่จำกัด")</MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Color="@(context.IsEnabled ? Color.Success : Color.Default)">
                    @(context.IsEnabled ? "เปิดใช้งาน" : "ปิดอยู่")
                </MudChip>
            </MudTd>
            <MudTd>
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => StartEdit(context))">แก้ไข</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary" OnClick="@(() => SelectPolicyForTiersAsync(context))">Vesting Tier</MudButton>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2">ยังไม่มีการตั้งค่านโยบายสำหรับบริษัทนี้</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@if (_tierPolicyId is not null)
{
    <MudPaper Class="pa-4 mb-4" MaxWidth="900px">
        <MudText Typo="Typo.h6">Vesting Tier — สิทธิ์รับเงินสมทบนายจ้างตามอายุงาน</MudText>
        <MudText Typo="Typo.body2" Class="mt-1">
            เงินสะสม (ฝั่งพนักงาน) คืนเต็ม 100% เสมอ — ตารางนี้กำหนดเฉพาะ % ที่จะได้รับจากเงินสมทบฝั่งนายจ้างตามอายุงาน
            ถ้าไม่ตั้งค่าไว้เลย ระบบจะถือว่า vest เต็ม 100% เสมอ (ไม่ทำให้พนักงานเสียสิทธิ์โดยไม่ตั้งใจ)
        </MudText>

        <MudGrid Class="mt-3">
            <MudItem xs="12" sm="3"><MudNumericField T="int" @bind-Value="_tierMinYears" Label="อายุงานตั้งแต่ (ปี)" Min="0" /></MudItem>
            <MudItem xs="12" sm="3"><MudNumericField T="int?" @bind-Value="_tierMaxYears" Label="ถึงก่อน (ปี, เว้นว่าง=ไม่มีเพดาน)" Min="0" /></MudItem>
            <MudItem xs="12" sm="3"><MudNumericField T="decimal" @bind-Value="_tierVestingPercent" Label="% ที่ได้รับ" Format="0.00" Min="0" Max="100" /></MudItem>
            <MudItem xs="12" sm="3"><MudNumericField T="int" @bind-Value="_tierSortOrder" Label="ลำดับ" Min="0" /></MudItem>
        </MudGrid>
        <MudButton Color="Color.Primary" Variant="Variant.Text" Class="mt-2" OnClick="AddTierAsync">เพิ่ม Tier</MudButton>

        <MudTable Items="_vestingTiers" Dense="true" Hover="true" Class="mt-3">
            <HeaderContent>
                <MudTh>อายุงาน (ปี)</MudTh>
                <MudTh>% ที่ได้รับ</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.MinYearsOfService - @(context.MaxYearsOfService?.ToString() ?? "ไม่มีเพดาน")</MudTd>
                <MudTd>@context.VestingPercent.ToString("0.00")%</MudTd>
                <MudTd>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="@(() => RemoveTierAsync(context.Id))">ลบ</MudButton>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.body2">ยังไม่มี tier — ปัจจุบันถือว่า vest เต็ม 100% เสมอ</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
}

<MudPaper Class="pa-4 mb-4" MaxWidth="900px">
    <MudText Typo="Typo.h6">นโยบายการลงทุน (Employee's Choice)</MudText>
    <MudText Typo="Typo.body2" Class="mt-1">
        ตัวเลือกนโยบายการลงทุนให้พนักงานเลือกภายในกองทุนเดียวของบริษัท — เก็บไว้อ้างอิงเท่านั้น ไม่กระทบยอดเงินที่หัก
    </MudText>
    <MudGrid Class="mt-2">
        <MudItem xs="12" sm="3"><MudTextField @bind-Value="_invCode" Label="รหัส" /></MudItem>
        <MudItem xs="12" sm="4"><MudTextField @bind-Value="_invName" Label="ชื่อนโยบาย" /></MudItem>
        <MudItem xs="12" sm="5"><MudTextField @bind-Value="_invRiskDescription" Label="คำอธิบายความเสี่ยง เช่น ตราสารหนี้ 100%" /></MudItem>
    </MudGrid>
    <MudButton Color="Color.Primary" Variant="Variant.Text" Class="mt-2" OnClick="AddInvestmentPolicyAsync">เพิ่มนโยบายการลงทุน</MudButton>

    <MudTable Items="_investmentPolicies" Dense="true" Hover="true" Class="mt-3">
        <HeaderContent>
            <MudTh>รหัส</MudTh>
            <MudTh>ชื่อ</MudTh>
            <MudTh>ความเสี่ยง</MudTh>
            <MudTh>สถานะ</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Code</MudTd>
            <MudTd>@context.Name</MudTd>
            <MudTd>@context.RiskDescription</MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                    @(context.IsActive ? "ใช้งาน" : "ปิดใช้งาน")
                </MudChip>
            </MudTd>
            <MudTd>
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => ToggleInvestmentPolicyActiveAsync(context))">
                    @(context.IsActive ? "ปิดใช้งาน" : "เปิดใช้งาน")
                </MudButton>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2">ยังไม่มีนโยบายการลงทุน</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

<MudPaper Class="pa-4 mb-4" MaxWidth="900px">
    <MudText Typo="Typo.h6">ทดสอบคำนวณ</MudText>
    <MudText Typo="Typo.body2" Class="mt-1">
        ป้อนวันเริ่มงาน วันที่อ้างอิง เงินเดือน และอัตรา — ไม่บันทึกข้อมูลใดๆ ใช้สำหรับตรวจสอบ config เท่านั้น
    </MudText>
    <MudGrid Class="mt-2">
        <MudItem xs="12" sm="4"><MudDatePicker Label="วันเริ่มงาน" @bind-Date="_testHireDate" Editable="true" DateFormat="dd/MM/yyyy" /></MudItem>
        <MudItem xs="12" sm="4"><MudDatePicker Label="วันที่อ้างอิง" @bind-Date="_testAsOfDate" Editable="true" DateFormat="dd/MM/yyyy" /></MudItem>
        <MudItem xs="12" sm="4"><MudNumericField T="decimal" @bind-Value="_testWage" Label="เงินเดือน (บาท)" Format="N2" Min="0" /></MudItem>
        <MudItem xs="12" sm="6"><MudNumericField T="decimal" @bind-Value="_testEmployeeRate" Label="อัตราสะสมพนักงาน (%)" Format="0.00" Min="0" Max="100" /></MudItem>
        <MudItem xs="12" sm="6"><MudNumericField T="decimal" @bind-Value="_testCompanyRate" Label="อัตราสมทบบริษัท (%)" Format="0.00" Min="0" Max="100" /></MudItem>
    </MudGrid>
    <MudButton Color="Color.Secondary" Variant="Variant.Text" Class="mt-3" OnClick="RunPreview">คำนวณตัวอย่าง</MudButton>

    @if (_previewResult is not null)
    {
        <MudAlert Severity="Severity.Info" Class="mt-3">
            หักจากพนักงาน: <b>@_previewResult.Value.Pf.EmployeeAmount.ToString("N2")</b> บาท/เดือน ·
            บริษัทสมทบ: <b>@_previewResult.Value.Pf.CompanyAmount.ToString("N2")</b> บาท/เดือน
            <br />
            อายุงานถึงวันที่อ้างอิง: @_previewResult.Value.Vesting.YearsOfService.ToString("0.00") ปี (@_previewResult.Value.Vesting.ServiceDays วัน) —
            สิทธิ์รับเงินสมทบนายจ้างถ้าออกวันนี้: <b>@_previewResult.Value.Vesting.VestingPercent.ToString("0.00")%</b>
            @if (_previewResult.Value.Vesting.MatchedTierNote is not null)
            {
                <text> (tier @_previewResult.Value.Vesting.MatchedTierNote)</text>
            }
        </MudAlert>
    }
</MudPaper>

@code {
    private string? _companyId;
    private List<Pay_ProvidentFundPolicy> _policies = new();
    private string? _error;
    private long? _editingId;

    private DateTime? _effectiveFrom = DateTime.Today;
    private DateTime? _effectiveTo;
    private decimal _minEmployeeRate = 2m;
    private decimal _maxEmployeeRate = 15m;
    private decimal _minCompanyRate = 2m;
    private decimal _maxCompanyRate = 15m;
    private int? _rateChangeLimitPerYear;
    private bool _isEnabled;
    private string? _note;

    private long? _tierPolicyId;
    private List<Pay_ProvidentFundVestingTier> _vestingTiers = new();
    private int _tierMinYears;
    private int? _tierMaxYears;
    private decimal _tierVestingPercent = 100m;
    private int _tierSortOrder;

    private List<Pay_ProvidentFundInvestmentPolicy> _investmentPolicies = new();
    private string? _invCode;
    private string? _invName;
    private string? _invRiskDescription;

    private DateTime? _testHireDate = DateTime.Today.AddYears(-2);
    private DateTime? _testAsOfDate = DateTime.Today;
    private decimal _testWage = 20000m;
    private decimal _testEmployeeRate = 3m;
    private decimal _testCompanyRate = 3m;
    private (ProvidentFundCalculator.ProvidentFundResult Pf, ProvidentFundVestingCalculator.VestingResult Vesting)? _previewResult;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
        if (string.IsNullOrWhiteSpace(_companyId)) return;

        await LoadAsync();
        await LoadInvestmentPoliciesAsync();
    }

    private async Task LoadAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        _policies = await context.Pay_ProvidentFundPolicies
            .Where(p => p.CompanyId == _companyId)
            .OrderBy(p => p.EffectiveFrom)
            .ToListAsync();
    }

    private async Task LoadInvestmentPoliciesAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        _investmentPolicies = await context.Pay_ProvidentFundInvestmentPolicies
            .Where(p => p.CompanyId == _companyId)
            .OrderBy(p => p.SortOrder)
            .ToListAsync();
    }

    private void StartEdit(Pay_ProvidentFundPolicy policy)
    {
        _editingId = policy.Id;
        _effectiveFrom = policy.EffectiveFrom.ToDateTime(TimeOnly.MinValue);
        _effectiveTo = policy.EffectiveTo?.ToDateTime(TimeOnly.MinValue);
        _minEmployeeRate = policy.MinEmployeeRate;
        _maxEmployeeRate = policy.MaxEmployeeRate;
        _minCompanyRate = policy.MinCompanyRate;
        _maxCompanyRate = policy.MaxCompanyRate;
        _rateChangeLimitPerYear = policy.RateChangeLimitPerYear;
        _isEnabled = policy.IsEnabled;
        _note = policy.Note;
        _error = null;
    }

    private void CancelEdit()
    {
        _editingId = null;
        _effectiveFrom = DateTime.Today;
        _effectiveTo = null;
        _minEmployeeRate = 2m;
        _maxEmployeeRate = 15m;
        _minCompanyRate = 2m;
        _maxCompanyRate = 15m;
        _rateChangeLimitPerYear = null;
        _isEnabled = false;
        _note = null;
        _error = null;
    }

    private async Task SaveAsync()
    {
        _error = null;

        if (_effectiveFrom is null)
        {
            _error = "กรุณาระบุวันที่มีผล";
            return;
        }
        if (_effectiveTo is not null && _effectiveTo < _effectiveFrom)
        {
            _error = "วันสิ้นสุดต้องไม่ก่อนวันที่มีผล";
            return;
        }
        if (_minEmployeeRate < 2m || _maxEmployeeRate > 15m || _minCompanyRate < 2m || _maxCompanyRate > 15m)
        {
            _error = "อัตราตามกฎหมายต้องอยู่ในช่วง 2-15%";
            return;
        }
        if (_minEmployeeRate > _maxEmployeeRate || _minCompanyRate > _maxCompanyRate)
        {
            _error = "ค่าต่ำสุดต้องไม่มากกว่าค่าสูงสุด";
            return;
        }

        await using var context = await DbFactory.CreateDbContextAsync();

        var effectiveFrom = DateOnly.FromDateTime(_effectiveFrom.Value);
        var effectiveTo = _effectiveTo is not null ? DateOnly.FromDateTime(_effectiveTo.Value) : (DateOnly?)null;

        if (_editingId is long id)
        {
            var existing = await context.Pay_ProvidentFundPolicies.FirstOrDefaultAsync(p => p.Id == id && p.CompanyId == _companyId);
            if (existing is null)
            {
                _error = "ไม่พบนโยบายที่ต้องการแก้ไข";
                return;
            }
            existing.EffectiveFrom = effectiveFrom;
            existing.EffectiveTo = effectiveTo;
            existing.MinEmployeeRate = _minEmployeeRate;
            existing.MaxEmployeeRate = _maxEmployeeRate;
            existing.MinCompanyRate = _minCompanyRate;
            existing.MaxCompanyRate = _maxCompanyRate;
            existing.RateChangeLimitPerYear = _rateChangeLimitPerYear;
            existing.IsEnabled = _isEnabled;
            existing.Note = _note;
        }
        else
        {
            context.Pay_ProvidentFundPolicies.Add(new Pay_ProvidentFundPolicy
            {
                CompanyId = _companyId!,
                EffectiveFrom = effectiveFrom,
                EffectiveTo = effectiveTo,
                MinEmployeeRate = _minEmployeeRate,
                MaxEmployeeRate = _maxEmployeeRate,
                MinCompanyRate = _minCompanyRate,
                MaxCompanyRate = _maxCompanyRate,
                RateChangeLimitPerYear = _rateChangeLimitPerYear,
                IsEnabled = _isEnabled,
                Note = _note,
            });
        }

        await context.SaveChangesAsync();
        Snackbar.Add(_editingId is null ? "เพิ่มนโยบายเรียบร้อย" : "บันทึกการแก้ไขเรียบร้อย", Severity.Success);
        CancelEdit();
        await LoadAsync();
    }

    private async Task SelectPolicyForTiersAsync(Pay_ProvidentFundPolicy policy)
    {
        _tierPolicyId = policy.Id;
        await LoadTiersAsync();
    }

    private async Task LoadTiersAsync()
    {
        if (_tierPolicyId is null) return;
        await using var context = await DbFactory.CreateDbContextAsync();
        _vestingTiers = await context.Pay_ProvidentFundVestingTiers
            .Where(t => t.PolicyId == _tierPolicyId)
            .OrderBy(t => t.SortOrder)
            .ToListAsync();
    }

    private async Task AddTierAsync()
    {
        if (_tierPolicyId is null) return;
        await using var context = await DbFactory.CreateDbContextAsync();
        context.Pay_ProvidentFundVestingTiers.Add(new Pay_ProvidentFundVestingTier
        {
            PolicyId = _tierPolicyId.Value,
            MinYearsOfService = _tierMinYears,
            MaxYearsOfService = _tierMaxYears,
            VestingPercent = _tierVestingPercent,
            SortOrder = _tierSortOrder,
        });
        await context.SaveChangesAsync();
        Snackbar.Add("เพิ่ม tier เรียบร้อย", Severity.Success);
        await LoadTiersAsync();
    }

    private async Task RemoveTierAsync(long tierId)
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var tier = await context.Pay_ProvidentFundVestingTiers.FirstOrDefaultAsync(t => t.Id == tierId);
        if (tier is null) return;
        context.Pay_ProvidentFundVestingTiers.Remove(tier);
        await context.SaveChangesAsync();
        await LoadTiersAsync();
    }

    private async Task AddInvestmentPolicyAsync()
    {
        if (string.IsNullOrWhiteSpace(_invCode) || string.IsNullOrWhiteSpace(_invName))
        {
            Snackbar.Add("กรุณาระบุรหัสและชื่อนโยบาย", Severity.Warning);
            return;
        }

        await using var context = await DbFactory.CreateDbContextAsync();
        context.Pay_ProvidentFundInvestmentPolicies.Add(new Pay_ProvidentFundInvestmentPolicy
        {
            CompanyId = _companyId!,
            Code = _invCode,
            Name = _invName,
            RiskDescription = _invRiskDescription,
            SortOrder = _investmentPolicies.Count,
            IsActive = true,
        });
        await context.SaveChangesAsync();
        Snackbar.Add("เพิ่มนโยบายการลงทุนเรียบร้อย", Severity.Success);
        _invCode = null; _invName = null; _invRiskDescription = null;
        await LoadInvestmentPoliciesAsync();
    }

    private async Task ToggleInvestmentPolicyActiveAsync(Pay_ProvidentFundInvestmentPolicy policy)
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var existing = await context.Pay_ProvidentFundInvestmentPolicies.FirstOrDefaultAsync(p => p.Id == policy.Id);
        if (existing is null) return;
        existing.IsActive = !existing.IsActive;
        await context.SaveChangesAsync();
        await LoadInvestmentPoliciesAsync();
    }

    private void RunPreview()
    {
        if (_testHireDate is null || _testAsOfDate is null) return;

        var hireDate = DateOnly.FromDateTime(_testHireDate.Value);
        var asOfDate = DateOnly.FromDateTime(_testAsOfDate.Value);
        if (asOfDate < hireDate) return;

        var pf = ProvidentFundCalculator.Calculate(_testWage, _testEmployeeRate, _testCompanyRate);
        var vesting = ProvidentFundVestingCalculator.ResolveVesting(hireDate, asOfDate, _vestingTiers);
        _previewResult = (pf, vesting);
    }
}
