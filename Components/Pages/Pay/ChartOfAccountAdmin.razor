@page "/pay/admin/chart-of-accounts"
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@inject JsonLocalizationService L
@attribute [Authorize(Policy = "Menu:PAY_ADMIN")]

<PageTitle>@L.Translate("ChartOfAccountsPageTitle")</PageTitle>

<MudPaper Class="pa-4 mb-4" MaxWidth="900px">
    <MudText Typo="Typo.h5">@L.Translate("ChartOfAccountsHeading")</MudText>
    <MudText Typo="Typo.body2" Class="mt-1">
        @L.Translate("ChartOfAccountsDesc")
    </MudText>

    @if (string.IsNullOrEmpty(_companyId))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">@L.Translate("CompanyNotLinkedError")</MudAlert>
        return;
    }

    <MudDivider Class="my-4" />

    <MudText Typo="Typo.h6">@(_editingId is null ? L.Translate("AddNewAccountHeading") : L.Translate("EditAccountHeading"))</MudText>
    <MudGrid Class="mt-1">
        <MudItem xs="12" sm="4"><MudTextField @bind-Value="_code" Label="@L.Translate("AccountCodeLabel")" Required="true" /></MudItem>
        <MudItem xs="12" sm="4"><MudTextField @bind-Value="_nameTh" Label="@L.Translate("AccountNameThLabel")" Required="true" /></MudItem>
        <MudItem xs="12" sm="4"><MudTextField @bind-Value="_nameEn" Label="@L.Translate("AccountNameEnLabel")" /></MudItem>
        <MudItem xs="12" sm="6">
            <MudSelect T="AccountType" @bind-Value="_accountType" Label="@L.Translate("AccountTypeFieldLabel")">
                <MudSelectItem T="AccountType" Value="AccountType.Asset">@L.Translate("AccountTypeAssetFull")</MudSelectItem>
                <MudSelectItem T="AccountType" Value="AccountType.Liability">@L.Translate("AccountTypeLiabilityFull")</MudSelectItem>
                <MudSelectItem T="AccountType" Value="AccountType.Equity">@L.Translate("AccountTypeEquityFull")</MudSelectItem>
                <MudSelectItem T="AccountType" Value="AccountType.Revenue">@L.Translate("AccountTypeRevenueFull")</MudSelectItem>
                <MudSelectItem T="AccountType" Value="AccountType.Expense">@L.Translate("AccountTypeExpenseFull")</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudSwitch T="bool" @bind-Value="_isCostCenter" Color="Color.Primary" Label="@L.Translate("IsCostCenterSwitchLabel")" />
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudSwitch T="bool" @bind-Value="_isActive" Color="Color.Success" Label="@L.Translate("IsActiveSwitchLabel")" />
        </MudItem>
    </MudGrid>

    @if (!string.IsNullOrEmpty(_error))
    {
        <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
    }

    <MudStack Row="true" Spacing="2" Class="mt-3">
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">
            @(_editingId is null ? L.Translate("AddAccountButton") : L.Translate("SaveEditButton"))
        </MudButton>
        @if (_editingId is not null)
        {
            <MudButton Variant="Variant.Text" OnClick="CancelEdit">@L.Translate("CancelButton")</MudButton>
        }
    </MudStack>

    <MudDivider Class="my-5" />

    <MudTextField T="string" Value="_searchTerm" Label="@L.Translate("SearchAccountPlaceholder")" Immediate="true"
        DebounceInterval="300" ValueChanged="OnSearchChanged"
        AdornmentIcon="@Icons.Material.Filled.Search" Adornment="Adornment.Start" Class="mb-3" />

    <MudTable Items="_accounts" Dense="true" Hover="true">
        <HeaderContent>
            <MudTh>@L.Translate("ColCode")</MudTh>
            <MudTh>@L.Translate("ColAccountName")</MudTh>
            <MudTh>@L.Translate("ColAccountType")</MudTh>
            <MudTh>Cost Center</MudTh>
            <MudTh>@L.Translate("ColStatus")</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Code</MudTd>
            <MudTd>@context.NameTh @(string.IsNullOrWhiteSpace(context.NameEn) ? "" : $"({context.NameEn})")</MudTd>
            <MudTd>@AccountTypeLabel(context.AccountType)</MudTd>
            <MudTd>
                @if (context.IsCostCenter)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary">Cost Center</MudChip>
                }
            </MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                    @(context.IsActive ? L.Translate("PeriodActiveStatus") : L.Translate("PeriodInactiveStatus"))
                </MudChip>
            </MudTd>
            <MudTd>
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => StartEdit(context))">@L.Translate("EditButton")</MudButton>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2">@L.Translate("NoAccountsMessage")</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private string? _companyId;
    private List<Com_ChartOfAccount> _accounts = new();
    private string? _searchTerm;
    private string? _error;
    private long? _editingId;

    private string _code = "";
    private string _nameTh = "";
    private string? _nameEn;
    private AccountType _accountType = AccountType.Expense;
    private bool _isCostCenter;
    private bool _isActive = true;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
        if (string.IsNullOrWhiteSpace(_companyId)) return;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var query = context.Com_ChartOfAccounts.Where(a => a.CompanyId == _companyId);
        query = EntitySearchHelper.ApplyTextSearch(query, _searchTerm, nameof(Com_ChartOfAccount.Code), nameof(Com_ChartOfAccount.NameTh), nameof(Com_ChartOfAccount.NameEn));
        _accounts = await query.OrderBy(a => a.Code).ToListAsync();
    }

    private async Task OnSearchChanged(string term)
    {
        _searchTerm = term;
        await LoadAsync();
    }

    private string AccountTypeLabel(AccountType type) => type switch
    {
        AccountType.Asset => L.Translate("AccountTypeAssetShort"),
        AccountType.Liability => L.Translate("AccountTypeLiabilityShort"),
        AccountType.Equity => L.Translate("AccountTypeEquityShort"),
        AccountType.Revenue => L.Translate("AccountTypeRevenueShort"),
        AccountType.Expense => L.Translate("AccountTypeExpenseShort"),
        _ => type.ToString(),
    };

    private void StartEdit(Com_ChartOfAccount account)
    {
        _editingId = account.Id;
        _code = account.Code;
        _nameTh = account.NameTh;
        _nameEn = account.NameEn;
        _accountType = account.AccountType;
        _isCostCenter = account.IsCostCenter;
        _isActive = account.IsActive;
        _error = null;
    }

    private void CancelEdit()
    {
        _editingId = null;
        _code = "";
        _nameTh = "";
        _nameEn = null;
        _accountType = AccountType.Expense;
        _isCostCenter = false;
        _isActive = true;
        _error = null;
    }

    private async Task SaveAsync()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_code) || string.IsNullOrWhiteSpace(_nameTh))
        {
            _error = L.Translate("FillAccountCodeNameError");
            return;
        }

        await using var context = await DbFactory.CreateDbContextAsync();

        var duplicate = await context.Com_ChartOfAccounts
            .AnyAsync(a => a.CompanyId == _companyId && a.Code == _code && a.Id != (_editingId ?? 0));
        if (duplicate)
        {
            _error = L.Translate("AccountCodeDuplicateError");
            return;
        }

        if (_editingId is long id)
        {
            var existing = await context.Com_ChartOfAccounts.FirstOrDefaultAsync(a => a.Id == id && a.CompanyId == _companyId);
            if (existing is null)
            {
                _error = L.Translate("AccountNotFoundError");
                return;
            }
            existing.Code = _code;
            existing.NameTh = _nameTh;
            existing.NameEn = _nameEn;
            existing.AccountType = _accountType;
            existing.IsCostCenter = _isCostCenter;
            existing.IsActive = _isActive;
        }
        else
        {
            context.Com_ChartOfAccounts.Add(new Com_ChartOfAccount
            {
                CompanyId = _companyId!,
                Code = _code,
                NameTh = _nameTh,
                NameEn = _nameEn,
                AccountType = _accountType,
                IsCostCenter = _isCostCenter,
                IsActive = _isActive,
            });
        }

        await context.SaveChangesAsync();
        Snackbar.Add(_editingId is null ? L.Translate("AccountAddedSuccess") : L.Translate("GradeEditSavedSuccess"), Severity.Success);
        CancelEdit();
        await LoadAsync();
    }
}
