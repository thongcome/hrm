@page "/pay/employees/{HremployeeId:long}/pay-items"
@layout PayrollEmployeeHubLayout
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Pay
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject JsonLocalizationService L
@attribute [Authorize(Policy = "Menu:PAY_ADMIN")]

<PageTitle>@L.Translate("AdhocPayItemsPageTitle")</PageTitle>

@if (_notFound)
{
    <MudAlert Severity="Severity.Warning">@L.Translate("EmployeeDataNotFoundOrOutsideCompanyError")</MudAlert>
}
else if (_employee is null)
{
    <MudText>@L.Translate("LoadingText")</MudText>
}
else
{
    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.body2">@((MarkupString)string.Format(L.Translate("DeptPosSalaryTemplate"), _employee.DeptgrpCode, _employee.PosCode, _employee.SalaryAmt?.ToString("N2") ?? "-"))</MudText>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudText Typo="Typo.subtitle1">@L.Translate("PeriodColonLabel")</MudText>
            <MudDatePicker Date="_periodMonth" DateChanged="OnPeriodMonthChangedAsync" Editable="true"
                DateFormat="MM/yyyy" PickerVariant="PickerVariant.Dialog" OpenTo="OpenTo.Month" Class="mud-width-200" />
        </MudStack>
        <MudText Typo="Typo.body2" Class="mt-1">
            @L.Translate("AdhocPayItemsDesc")
        </MudText>
    </MudPaper>

    @if (_payrollEmployee is not null)
    {
        <MudPaper Class="pa-4 mb-4">
            <MudText Typo="Typo.h6">@L.Translate("CalculatedPayrollResultHeading")</MudText>
            <MudText Typo="Typo.body2" Class="mt-1">
                @string.Format(L.Translate("WorkDaysProportionTemplate"), _payrollEmployee.ActualWorkingDays, _payrollEmployee.WorkingDaysInPeriod, _payrollEmployee.ProrationFactor.ToString("P2"))
            </MudText>

            <MudSimpleTable Class="mt-3" Dense="true">
                <tbody>
                    <tr><td>@L.Translate("GrossEarningsRowLabel")</td><td class="text-right">@_payrollEmployee.GrossEarnings.ToString("N2")</td></tr>
                    <tr><td>@L.Translate("ColTotalDeductions")</td><td class="text-right">@_payrollEmployee.TotalDeductions.ToString("N2")</td></tr>
                    <tr><td><b>@L.Translate("NetPayBoldLabel")</b></td><td class="text-right"><b>@_payrollEmployee.NetPay.ToString("N2")</b></td></tr>
                </tbody>
            </MudSimpleTable>

            <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">@L.Translate("LineItemsHeading")</MudText>
            <MudTable Items="_displayRows" Dense="true">
                <HeaderContent>
                    <MudTh>@L.Translate("ColItemName")</MudTh>
                    <MudTh>@L.Translate("ColItemType")</MudTh>
                    <MudTh>@L.Translate("ColAmount")</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        @context.LineItem.Pay_PayItemType.NameTh (@context.LineItem.Pay_PayItemType.NameEn)
                        @if (!context.IsCalculated)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Class="ml-2">@L.Translate("NoItemThisPeriodChip")</MudChip>
                        }
                    </MudTd>
                    <MudTd>@(context.LineItem.SignFlag > 0 ? L.Translate("EarningChip") : L.Translate("DeductionChip"))</MudTd>
                    <MudTd>@((context.LineItem.SignFlag * context.LineItem.Amount).ToString("N2"))</MudTd>
                    <MudTd>
                        <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Info" OnClick="@(() => ShowCalculationDetailAsync(context))">
                            @L.Translate("ViewCalculationLink")
                        </MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    }
    else
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">
            @L.Translate("NoCalculationYetInfo")
        </MudAlert>
    }

    <MudGrid>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                    <MudText Typo="Typo.h6" Color="Color.Success">@L.Translate("EarningsPanelHeading")</MudText>
                    <MudButton Size="Size.Small" Color="Color.Success" Variant="Variant.Filled"
                        OnClick="@(() => OpenCreate(PayItemCategory.Earning))">@L.Translate("AddButtonShort")</MudButton>
                </MudStack>
                <MudTable Items="_earningItems" Dense="true" Hover="true">
                    <HeaderContent>
                        <MudTh>@L.Translate("ColItemType")</MudTh>
                        <MudTh>@L.Translate("ColAmount")</MudTh>
                        <MudTh>@L.Translate("ReasonLabel")</MudTh>
                        <MudTh>@L.Translate("ColStatus")</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Pay_PayItemType.NameTh</MudTd>
                        <MudTd>@context.Amount.ToString("N2")</MudTd>
                        <MudTd>@context.Reason</MudTd>
                        <MudTd><MudChip T="string" Size="Size.Small" Color="StatusColor(context.Status)">@context.Status</MudChip></MudTd>
                        <MudTd>
                            @if (context.Status == PayAdhocItemStatus.Pending)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Success" Title="@L.Translate("ApproveButton")" OnClick="@(() => ApproveAsync(context.Id))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error" Title="@L.Translate("RejectButton")" OnClick="@(() => RejectAsync(context.Id))" />
                            }
                            @if (context.Status is PayAdhocItemStatus.Pending or PayAdhocItemStatus.Approved)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Title="@L.Translate("DeleteItemTitle")" OnClick="@(() => CancelItemAsync(context.Id))" />
                            }
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent><MudText>@L.Translate("NoItemsYet")</MudText></NoRecordsContent>
                    <FooterContent>
                        <MudTd colspan="2"><b>@string.Format(L.Translate("TotalColonTemplate"), _earningItems.Where(i => i.Status != PayAdhocItemStatus.Rejected && i.Status != PayAdhocItemStatus.Cancelled).Sum(i => i.Amount).ToString("N2"))</b></MudTd>
                        <MudTd colspan="3"></MudTd>
                    </FooterContent>
                </MudTable>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                    <MudText Typo="Typo.h6" Color="Color.Error">@L.Translate("DeductionsPanelHeading")</MudText>
                    <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Filled"
                        OnClick="@(() => OpenCreate(PayItemCategory.Deduction))">@L.Translate("AddButtonShort")</MudButton>
                </MudStack>
                <MudTable Items="_deductionItems" Dense="true" Hover="true">
                    <HeaderContent>
                        <MudTh>@L.Translate("ColItemType")</MudTh>
                        <MudTh>@L.Translate("ColAmount")</MudTh>
                        <MudTh>@L.Translate("ReasonLabel")</MudTh>
                        <MudTh>@L.Translate("ColStatus")</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Pay_PayItemType.NameTh</MudTd>
                        <MudTd>@context.Amount.ToString("N2")</MudTd>
                        <MudTd>@context.Reason</MudTd>
                        <MudTd><MudChip T="string" Size="Size.Small" Color="StatusColor(context.Status)">@context.Status</MudChip></MudTd>
                        <MudTd>
                            @if (context.Status == PayAdhocItemStatus.Pending)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Success" Title="@L.Translate("ApproveButton")" OnClick="@(() => ApproveAsync(context.Id))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error" Title="@L.Translate("RejectButton")" OnClick="@(() => RejectAsync(context.Id))" />
                            }
                            @if (context.Status is PayAdhocItemStatus.Pending or PayAdhocItemStatus.Approved)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Title="@L.Translate("DeleteItemTitle")" OnClick="@(() => CancelItemAsync(context.Id))" />
                            }
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent><MudText>@L.Translate("NoItemsYet")</MudText></NoRecordsContent>
                    <FooterContent>
                        <MudTd colspan="2"><b>@string.Format(L.Translate("TotalColonTemplate"), _deductionItems.Where(i => i.Status != PayAdhocItemStatus.Rejected && i.Status != PayAdhocItemStatus.Cancelled).Sum(i => i.Amount).ToString("N2"))</b></MudTd>
                        <MudTd colspan="3"></MudTd>
                    </FooterContent>
                </MudTable>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @if (_showCreate)
    {
        <MudPaper Class="pa-4 mt-4">
            <MudText Typo="Typo.h6">@string.Format(L.Translate("AddAdhocItemHeadingTemplate"), _createCategory == PayItemCategory.Earning ? L.Translate("EarningsPanelHeading") : L.Translate("DeductionsPanelHeading"))</MudText>
            <MudGrid Class="mt-2">
                <MudItem xs="12" sm="6">
                    <MudSelect T="int" @bind-Value="_form.PayItemTypeId" Label="@L.Translate("AdhocPayItemTypeLabel")">
                        @foreach (var t in _payItemTypes.Where(t => t.Category == _createCategory))
                        {
                            <MudSelectItem T="int" Value="t.Id">@t.NameTh (@t.NameEn)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="_form.Amount" Label="@L.Translate("AmountLabel")" Required="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudCheckBox @bind-Value="_form.IsTaxable" Label="@L.Translate("AdhocIsTaxableLabel")" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_form.Reason" Label="@L.Translate("ReasonLabel")" Required="true" Lines="2" />
                </MudItem>
            </MudGrid>
            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mt-2">@_error</MudAlert>
            }
            <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="mt-3" OnClick="SubmitAsync">@L.Translate("SaveButton")</MudButton>
            <MudButton Variant="Variant.Text" Class="mt-3" OnClick="@(() => _showCreate = false)">@L.Translate("CancelButton")</MudButton>
        </MudPaper>
    }
}

@code {
    [Parameter] public long HremployeeId { get; set; }

    private Hremployee? _employee;
    private bool _notFound;
    private List<Pay_PayItemType> _payItemTypes = new();
    private List<Pay_AdhocPayItem> _earningItems = new();
    private List<Pay_AdhocPayItem> _deductionItems = new();
    private Pay_PayrollEmployee? _payrollEmployee;
    private List<Pay_PayrollLineItem> _calculatedLineItems = new();
    private List<PayrollLineItemDisplayHelper.DisplayRow> _displayRows = new();
    private DateTime? _periodMonth = DateTime.Today;
    private bool _showCreate;
    private PayItemCategory _createCategory;
    private string? _error;
    private CreateForm _form = new();

    private class CreateForm
    {
        public int PayItemTypeId { get; set; }
        public decimal Amount { get; set; }
        public bool IsTaxable { get; set; } = true;
        public string Reason { get; set; } = "";
    }

    // InvariantCulture: the server's ambient culture is Thai, whose default
    // calendar formats "yyyy" as the Buddhist year — TargetPeriod must stay
    // Gregorian to match Pay_PayrollRun.PayrollPeriod (see AdhocPayItemList.razor).
    private string TargetPeriod =>
        (_periodMonth ?? DateTime.Today).ToString("yyyyMM", System.Globalization.CultureInfo.InvariantCulture);

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task OnPeriodMonthChangedAsync(DateTime? date)
    {
        _periodMonth = date;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var companyId = await GetCurrentCompanyIdAsync();
        await using var context = await DbFactory.CreateDbContextAsync();

        _employee = await context.Hremployee.FirstOrDefaultAsync(e => e.id == HremployeeId && e.companyid == companyId);
        if (_employee is null)
        {
            _notFound = true;
            return;
        }

        _payItemTypes = await context.Pay_PayItemTypes.Where(t => t.IsActive).OrderBy(t => t.SortOrder).ToListAsync();

        var items = await context.Pay_AdhocPayItems
            .Include(a => a.Pay_PayItemType)
            .Where(a => a.HremployeeId == HremployeeId && a.TargetPeriod == TargetPeriod)
            .OrderByDescending(a => a.RequestedDate)
            .ToListAsync();

        _earningItems = items.Where(a => a.Pay_PayItemType.Category == PayItemCategory.Earning).ToList();
        _deductionItems = items.Where(a => a.Pay_PayItemType.Category == PayItemCategory.Deduction).ToList();

        // If this employee's period has already gone through an actual
        // payroll calculation (see PayrollEmployeeDetail.razor, same shape
        // of summary/line-item display), show that alongside the ad-hoc
        // items so this page gives the full picture, not just the pending
        // ad-hoc requests. Cancelled runs are skipped; if a period somehow
        // has more than one non-cancelled run (e.g. a superseding
        // Adjustment run), the most recently created one wins.
        var run = await context.Pay_PayrollRuns
            .Where(r => r.CompanyId == companyId && r.PayrollPeriod == TargetPeriod && r.Status != PayrollRunStatus.Cancelled)
            .OrderByDescending(r => r.CreatedDate)
            .FirstOrDefaultAsync();

        _payrollEmployee = run is null
            ? null
            : await context.Pay_PayrollEmployees.FirstOrDefaultAsync(e => e.PayrollRunId == run.Id && e.HremployeeId == HremployeeId);

        _calculatedLineItems = _payrollEmployee is null
            ? new()
            : await context.Pay_PayrollLineItems
                .Include(li => li.Pay_PayItemType)
                .Where(li => li.PayrollEmployeeId == _payrollEmployee.Id)
                .OrderBy(li => li.SeqNo)
                .ToListAsync();

        _displayRows = _payrollEmployee is null
            ? new()
            : PayrollLineItemDisplayHelper.BuildDisplayRows(_calculatedLineItems, _payItemTypes);
    }

    private Task ShowCalculationDetailAsync(PayrollLineItemDisplayHelper.DisplayRow row)
    {
        var typeName = $"{row.LineItem.Pay_PayItemType.NameTh} ({row.LineItem.Pay_PayItemType.NameEn})";
        var message = row.IsCalculated
            ? (string.IsNullOrWhiteSpace(row.LineItem.Description)
                ? string.Format(L.Translate("CalculationDetailAmountOnlyTemplate"), (row.LineItem.SignFlag * row.LineItem.Amount).ToString("N2"))
                : row.LineItem.Description!)
            : L.Translate("CalculationDetailNotCalculatedNote");

        return DialogService.ShowMessageBox(typeName, message, yesText: L.Translate("CloseButton"));
    }

    private void OpenCreate(PayItemCategory category)
    {
        _createCategory = category;
        _form = new CreateForm();
        _error = null;
        _showCreate = true;
    }

    private async Task<long> GetCurrentUserIdAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        var idClaim = state.User.FindFirstValue("sc_userid");
        return long.TryParse(idClaim, out var id) ? id : 0;
    }

    // One sc_user resolves to exactly one company via empid -> Hremployee.EmpNo
    // (see PayrollCompanyResolver) — mirrors AdhocPayItemList.razor.
    private async Task<string?> GetCurrentCompanyIdAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        return state.User.FindFirstValue("payroll_company");
    }

    private async Task SubmitAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_form.Reason) || _form.Amount <= 0 || _form.PayItemTypeId == 0)
        {
            _error = L.Translate("FillAllFieldsError");
            return;
        }

        await using var context = await DbFactory.CreateDbContextAsync();
        var actorUserId = await GetCurrentUserIdAsync();
        context.Pay_AdhocPayItems.Add(new Pay_AdhocPayItem
        {
            HremployeeId = HremployeeId,
            PayItemTypeId = _form.PayItemTypeId,
            TargetPeriod = TargetPeriod,
            Amount = _form.Amount,
            IsTaxable = _form.IsTaxable,
            Reason = _form.Reason,
            Status = PayAdhocItemStatus.Pending,
            RequestedByUserId = actorUserId,
        });
        await context.SaveChangesAsync();

        _showCreate = false;
        Snackbar.Add(L.Translate("ItemSavedSuccess"), Severity.Success);
        await LoadAsync();
    }

    private async Task<Pay_AdhocPayItem?> LoadOwnCompanyItemAsync(HRMContext context, long id)
    {
        var companyId = await GetCurrentCompanyIdAsync();
        return await context.Pay_AdhocPayItems
            .Include(a => a.Hremployee)
            .FirstOrDefaultAsync(a => a.Id == id && a.Hremployee.companyid == companyId);
    }

    private async Task ApproveAsync(long id)
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var item = await LoadOwnCompanyItemAsync(context, id);
        if (item is null || item.Status != PayAdhocItemStatus.Pending) return;
        item.Status = PayAdhocItemStatus.Approved;
        item.ApprovedByUserId = await GetCurrentUserIdAsync();
        item.ApprovedDate = DateTime.Now;
        await context.SaveChangesAsync();
        Snackbar.Add(L.Translate("ApprovedSuccess"), Severity.Success);
        await LoadAsync();
    }

    private async Task RejectAsync(long id)
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var item = await LoadOwnCompanyItemAsync(context, id);
        if (item is null || item.Status != PayAdhocItemStatus.Pending) return;
        item.Status = PayAdhocItemStatus.Rejected;
        item.ApprovedByUserId = await GetCurrentUserIdAsync();
        item.ApprovedDate = DateTime.Now;
        await context.SaveChangesAsync();
        Snackbar.Add(L.Translate("RejectedSuccess"), Severity.Warning);
        await LoadAsync();
    }

    private async Task CancelItemAsync(long id)
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var item = await LoadOwnCompanyItemAsync(context, id);
        if (item is null) return;
        item.Status = PayAdhocItemStatus.Cancelled;
        await context.SaveChangesAsync();
        Snackbar.Add(L.Translate("CancelledSuccess"), Severity.Info);
        await LoadAsync();
    }

    private static Color StatusColor(PayAdhocItemStatus status) => status switch
    {
        PayAdhocItemStatus.Pending => Color.Warning,
        PayAdhocItemStatus.Approved => Color.Info,
        PayAdhocItemStatus.Rejected => Color.Error,
        PayAdhocItemStatus.Cancelled => Color.Default,
        PayAdhocItemStatus.Consumed => Color.Success,
        _ => Color.Default,
    };
}
