@page "/pay/employees/{HremployeeId:long}/position-salary-history"
@layout PayrollEmployeeHubLayout
@using System.Security.Claims
@using HRM.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav
@inject JsonLocalizationService L
@attribute [Authorize(Policy = "Menu:PAY_ADMIN")]

<PageTitle>@L.Translate("PositionSalaryHistoryNavLabel")</PageTitle>

@if (_notFound)
{
    <MudAlert Severity="Severity.Warning">@L.Translate("EmployeeDataNotFoundOrOutsideCompanyError")</MudAlert>
}
else if (_employee is null)
{
    <MudText>@L.Translate("LoadingText")</MudText>
}
else
{
    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.body2">@string.Format(L.Translate("CurrentPositionSalaryTemplate"), _employee.PosCode ?? "-", _employee.SalaryAmt?.ToString("N2") ?? "-")</MudText>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6">@L.Translate("PositionSalaryHistoryNavLabel")</MudText>
        <MudText Typo="Typo.body2" Class="mt-1">
            @L.Translate("PositionSalaryHistoryDesc")
        </MudText>

        @if (_history.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Class="mt-3">@L.Translate("NoPositionSalaryHistoryMessage")</MudAlert>
        }
        else
        {
            <MudTable Items="_history" Dense="true" Hover="true" Elevation="0" Class="mt-3">
                <HeaderContent>
                    <MudTh>@L.Translate("ColDate")</MudTh>
                    <MudTh>@L.Translate("ColItemType")</MudTh>
                    <MudTh>@L.Translate("ColPositionOldNew")</MudTh>
                    <MudTh>@L.Translate("ColSalaryOldNew")</MudTh>
                    <MudTh>@L.Translate("ColOrderNo")</MudTh>
                    <MudTh>@L.Translate("ColRemark")</MudTh>
                    <MudTh>@L.Translate("ColRecordedBy")</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.ChangedDate.ToString("dd/MM/yyyy HH:mm")</MudTd>
                    <MudTd>@FormatChangeType(context.ChangeType)</MudTd>
                    <MudTd>@(context.OldPositionCode ?? "-") → @(context.NewPositionCode ?? "-")</MudTd>
                    <MudTd>
                        @(context.OldSalary?.ToString("N2") ?? "-") → @(context.NewSalary?.ToString("N2") ?? "-")
                        @if (context.OldSalary is not null && context.NewSalary is not null && context.NewSalary != context.OldSalary)
                        {
                            var diff = context.NewSalary.Value - context.OldSalary.Value;
                            <MudText Typo="Typo.caption" Color="@(diff > 0 ? Color.Success : Color.Error)">
                                (@(diff > 0 ? "+" : "")@diff.ToString("N2"))
                            </MudText>
                        }
                    </MudTd>
                    <MudTd>@(context.OrderNo ?? "-")</MudTd>
                    <MudTd>@(context.Reason ?? "-")</MudTd>
                    <MudTd>@(_userNames.TryGetValue(context.ChangedByUserId ?? 0, out var name) ? name : "-")</MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>
}

@code {
    [Parameter] public long HremployeeId { get; set; }

    private Hremployee? _employee;
    private bool _notFound;
    private List<Pay_PositionSalaryHistory> _history = new();
    private Dictionary<long, string> _userNames = new();

    protected override async Task OnInitializedAsync()
    {
        var companyId = await GetCurrentCompanyIdAsync();
        await using var context = await DbFactory.CreateDbContextAsync();

        _employee = await context.Hremployee.FirstOrDefaultAsync(e => e.id == HremployeeId && e.companyid == companyId);
        if (_employee is null)
        {
            _notFound = true;
            return;
        }

        _history = await context.Pay_PositionSalaryHistories
            .Where(h => h.HremployeeId == HremployeeId)
            .OrderByDescending(h => h.ChangedDate)
            .ToListAsync();

        var userIds = _history.Where(h => h.ChangedByUserId is not null).Select(h => h.ChangedByUserId!.Value).Distinct().ToList();
        if (userIds.Count > 0)
        {
            _userNames = await context.sc_users
                .Where(u => userIds.Contains(u.userid))
                .ToDictionaryAsync(u => u.userid, u => $"{u.firstname} {u.lastname}".Trim());
        }
    }

    private async Task<string?> GetCurrentCompanyIdAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        return state.User.FindFirstValue("payroll_company");
    }

    private string FormatChangeType(string? code) => code switch
    {
        "P" => L.Translate("ChangeTypePromotion"),
        "D" => L.Translate("ChangeTypeDemotion"),
        "T" => L.Translate("ChangeTypeTransfer"),
        "S" => L.Translate("ChangeTypeSalaryOnly"),
        "O" => L.Translate("ChangeTypeOther"),
        _ => "-",
    };
}
