@using HRM.Models
@using HRM.Services.Shared
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject NavigationManager Nav
@inject JsonLocalizationService L

@* Shared core-fields form for an Hremployee, reused by both the create panel
   (PayrollEmployeeAdmin.razor) and the edit tab (PayrollEmployeeDetail.razor)
   — same entity, same fields, only IsCreating changes what's editable/shown. *@

<MudGrid>
    <MudItem xs="12" sm="4">
        <MudTextField @bind-Value="Employee.EmpNo" Label="@L.Translate("EmpNoLabel")" Required="true"
            ReadOnly="@(!IsCreating || !EmpNoUnlocked)"
            Adornment="@(IsCreating && !EmpNoUnlocked ? Adornment.End : Adornment.None)"
            AdornmentIcon="@Icons.Material.Filled.Edit" AdornmentColor="Color.Default"
            OnAdornmentClick="@(() => EmpNoUnlockedChanged.InvokeAsync(true))"
            HelperText="@(IsCreating && !EmpNoUnlocked ? L.Translate("AutoGeneratedEmpNoHelperText") : null)" />
    </MudItem>
    <MudItem xs="12" sm="2">
        <MudTextField @bind-Value="Employee.PrenameCode" Label="@L.Translate("PrenameLabel")" />
    </MudItem>
    <MudItem xs="12" sm="3">
        <MudTextField @bind-Value="Employee.EmpName" Label="@L.Translate("FirstNameLabel")" Required="true" />
    </MudItem>
    <MudItem xs="12" sm="3">
        <MudTextField @bind-Value="Employee.EmpSurname" Label="@L.Translate("LastNameLabel")" Required="true" />
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudTextField Value="Email" ValueChanged="@((string v) => EmailChanged.InvokeAsync(v))" Label="@L.Translate("EmailFieldLabel")" Required="true" InputType="InputType.Email"
            HelperText="@L.Translate("EmailForDocsHelperText")" />
    </MudItem>

    <MudItem xs="12" sm="4">
        <MudSelect T="string" @bind-Value="Employee.EmptypeCode" Label="@L.Translate("EmployeeTypeFieldLabel")">
            <MudSelectItem T="string" Value="@("01")">@L.Translate("RegularEmployeeCheckbox")</MudSelectItem>
            <MudSelectItem T="string" Value="@("02")">@L.Translate("TemporaryEmployeeCheckbox")</MudSelectItem>
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudTextField @bind-Value="Employee.DeptgrpCode" Label="@L.Translate("DepartmentLabel")" />
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudTextField @bind-Value="Employee.PosCode" Label="@L.Translate("PositionLabel")" />
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudAutocomplete T="Com_ChartOfAccount" Label="@L.Translate("CostCenterFieldLabel")" Value="SelectedCostCenter" ValueChanged="OnCostCenterSelected"
            SearchFunc="SearchCostCentersAsync"
            ToStringFunc="@(a => a == null ? null : $"{a.Code} — {a.NameTh}{(string.IsNullOrWhiteSpace(a.NameEn) ? "" : $" ({a.NameEn})")}")"
            HelperText="@L.Translate("CostCenterHelperText")"
            ResetValueOnEmptyText="true" CoerceText="true" MinCharacters="0" Clearable="true" />
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudText Typo="Typo.caption" Class="mud-text-secondary">@L.Translate("OrganizationOrgChartLabel")</MudText>
        <MudText Typo="Typo.body1">@(CurrentOrgLabel ?? L.Translate("NotLinkedToPositionSlotText"))</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">@string.Format(L.Translate("PositionInlineTemplate"), CurrentSlot?.Name ?? "—")</MudText>
        @if (!IsCreating)
        {
            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" Class="mt-1"
                OnClick="@(() => Nav.NavigateTo($"/pos/position-slots?employeeId={Employee.id}"))">
                @L.Translate("ManagePositionAffiliationLink")
            </MudButton>
        }
        else
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1">
                @L.Translate("SetOrgAfterSaveNote")
            </MudText>
        }
    </MudItem>

    <MudItem xs="12" sm="4">
        <MudDatePicker Date="WorkDate" DateChanged="@((DateTime? v) => WorkDateChanged.InvokeAsync(v))" Label="@L.Translate("WorkDateLabel")" />
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudDatePicker Date="BirthDate" DateChanged="@((DateTime? v) => BirthDateChanged.InvokeAsync(v))" Label="@L.Translate("BirthDateFieldLabel")" />
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudTextField @bind-Value="Employee.IdCard" Label="@L.Translate("IdCardLabel")" />
    </MudItem>

    <MudItem xs="12" sm="4">
        <MudNumericField @bind-Value="Employee.SalaryAmt" Label="@L.Translate("SalaryLabel")" Format="N2" />
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudSelect T="long?" @bind-Value="Employee.SalaryGradeId" Label="@L.Translate("SalaryGradeFieldLabel")" Clearable="true">
            @foreach (var grade in SalaryGrades)
            {
                <MudSelectItem T="long?" Value="@((long?)grade.Id)">@grade.GradeCode — @grade.GradeName</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudTextField @bind-Value="Employee.SalexpBank" Label="@L.Translate("BankCodeLabel")" />
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudTextField @bind-Value="Employee.SalexpBranch" Label="@L.Translate("BranchCodeLabel")" />
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudTextField @bind-Value="Employee.SalexpAccid" Label="@L.Translate("AccountNoLabel")" />
    </MudItem>
    @{ var compaStatus = GetCompaRatioStatus(); }
    @if (compaStatus is not null)
    {
        <MudItem xs="12">
            <MudAlert Severity="compaStatus.Value.Severity" Dense="true">@compaStatus.Value.Text</MudAlert>
        </MudItem>
    }
</MudGrid>

@code {
    [Parameter, EditorRequired] public Hremployee Employee { get; set; } = null!;
    [Parameter] public bool IsCreating { get; set; }
    [Parameter] public bool EmpNoUnlocked { get; set; }
    [Parameter] public EventCallback<bool> EmpNoUnlockedChanged { get; set; }
    [Parameter] public string? Email { get; set; }
    [Parameter] public EventCallback<string?> EmailChanged { get; set; }
    [Parameter] public DateTime? WorkDate { get; set; }
    [Parameter] public EventCallback<DateTime?> WorkDateChanged { get; set; }
    [Parameter] public DateTime? BirthDate { get; set; }
    [Parameter] public EventCallback<DateTime?> BirthDateChanged { get; set; }
    [Parameter] public List<Pay_SalaryGrade> SalaryGrades { get; set; } = new();
    [Parameter] public Com_ChartOfAccount? SelectedCostCenter { get; set; }
    [Parameter] public EventCallback<Com_ChartOfAccount?> SelectedCostCenterChanged { get; set; }
    [Parameter, EditorRequired] public string CompanyId { get; set; } = null!;
    [Parameter] public Pos_PositionSlot? CurrentSlot { get; set; }
    [Parameter] public string? CurrentOrgLabel { get; set; }

    private async Task OnCostCenterSelected(Com_ChartOfAccount? account)
    {
        Employee.CostCenterCode = account?.Code;
        await SelectedCostCenterChanged.InvokeAsync(account);
    }

    private async Task<IEnumerable<Com_ChartOfAccount>> SearchCostCentersAsync(string search, CancellationToken ct)
    {
        await using var context = await DbFactory.CreateDbContextAsync(ct);
        var query = context.Com_ChartOfAccounts.Where(a => a.CompanyId == CompanyId && a.IsCostCenter && a.IsActive);
        query = EntitySearchHelper.ApplyTextSearch(query, search, nameof(Com_ChartOfAccount.Code), nameof(Com_ChartOfAccount.NameTh), nameof(Com_ChartOfAccount.NameEn));
        return await query.OrderBy(a => a.Code).Take(20).ToListAsync(ct);
    }

    // null = ไม่ได้กำหนดเกรด; otherwise compares SalaryAmt against the
    // selected grade's band and returns a short Thai label + severity.
    private (string Text, Severity Severity)? GetCompaRatioStatus()
    {
        if (Employee.SalaryGradeId is not long gradeId || Employee.SalaryAmt is not decimal salary)
            return null;

        var grade = SalaryGrades.FirstOrDefault(g => g.Id == gradeId);
        if (grade is null) return null;

        var compaRatio = grade.MidSalary == 0 ? 0 : salary / grade.MidSalary * 100;

        if (salary < grade.MinSalary)
            return (string.Format(L.Translate("CompaRatioBelowTemplate"), compaRatio.ToString("N0")), Severity.Warning);
        if (salary > grade.MaxSalary)
            return (string.Format(L.Translate("CompaRatioAboveTemplate"), compaRatio.ToString("N0")), Severity.Warning);
        return (string.Format(L.Translate("CompaRatioWithinTemplate"), compaRatio.ToString("N0")), Severity.Success);
    }
}
