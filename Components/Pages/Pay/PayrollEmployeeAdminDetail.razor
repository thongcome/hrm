    private async Task SubmitSeveranceAsync()
    {
        _severanceError = null;

        if (_employee is null || _severanceTargetMonth is null || _severanceAmount <= 0 || string.IsNullOrWhiteSpace(_severanceReason))
        {
            _severanceError = L.Translate("FillAllFieldsError");
            return;
        }

        var state = await AuthProvider.GetAuthenticationStateAsync();
        var userIdClaim = state.User.FindFirstValue("sc_userid");
        var userId = long.TryParse(userIdClaim, out var uid) ? uid : 0;

        // InvariantCulture: ambient Thai culture formats "yyyy" as Buddhist
        // year — TargetPeriod must stay Gregorian to match Pay_PayrollRun.
        var targetPeriod = _severanceTargetMonth.Value.ToString("yyyyMM", System.Globalization.CultureInfo.InvariantCulture);

        try
        {
            await SeveranceService.SubmitAsync(_employee.id, targetPeriod, _severanceAmount, _severanceReason, userId);
        }
        catch (InvalidOperationException ex)
        {
            _severanceError = ex.Message;
            return;
        }

        Snackbar.Add(L.Translate("SeveranceSubmittedSuccess"), Severity.Success);
        Nav.NavigateTo($"/pay/adhoc/{targetPeriod}");
    }

    private void OnFileSelected(IBrowserFile file)
    {
        _uploadFile = file;
    }

    private string? _photoError;

    private static string InitialsFor(Hremployee emp) =>
        !string.IsNullOrEmpty(emp.EmpName) ? emp.EmpName.Substring(0, 1).ToUpperInvariant() : "?";

    private async Task OnPhotoSelected(IBrowserFile file)
    {
        _photoError = null;
        if (_employee is null) return;

        const long maxSize = 5 * 1024 * 1024; // 5 MB
        if (file.Size > maxSize)
        {
            _photoError = L.Translate("FileTooLargePhotoError");
            return;
        }
        var ext = Path.GetExtension(file.Name).ToLowerInvariant();
        if (ext != ".jpg" && ext != ".jpeg" && ext != ".png")
        {
            _photoError = L.Translate("UnsupportedImageFormatError");
            return;
        }

        await using var stream = file.OpenReadStream(maxSize);
        using var buffer = new MemoryStream();
        await stream.CopyToAsync(buffer);
        var bytes = buffer.ToArray();

        var storedFileName = $"{_employee.id}_{Guid.NewGuid():N}{ext}";
        var (relativePath, _) = await FileStorage.SaveAsync("employee-photos", storedFileName, bytes);

        await using var context = await DbFactory.CreateDbContextAsync();
        var existing = await context.Hremployee.FirstAsync(e => e.id == _employee.id);
        existing.PhotoStoragePath = relativePath;
        await context.SaveChangesAsync();

        _employee.PhotoStoragePath = relativePath;
        Snackbar.Add(L.Translate("PhotoUploadedSuccess"), Severity.Success);
    }

    private async Task UploadDocAsync()
    {
        _docError = null;
        if (_employee is null || _uploadFile is null) return;

        const long maxSize = 10 * 1024 * 1024; // 10 MB
        if (_uploadFile.Size > maxSize)
        {
            _docError = L.Translate("FileTooLargeDocError");
            return;
        }

        await using var stream = _uploadFile.OpenReadStream(maxSize);
        using var buffer = new MemoryStream();
        await stream.CopyToAsync(buffer);
        var bytes = buffer.ToArray();

        var storedFileName = $"{_employee.EmpNo}_{DateTime.Now:yyyyMMddHHmmss}_{_uploadFile.Name}";
        var (relativePath, sha256) = await FileStorage.SaveAsync("employee-docs", storedFileName, bytes);

        var state = await AuthProvider.GetAuthenticationStateAsync();
        var userIdClaim = state.User.FindFirstValue("sc_userid");
        var userId = long.TryParse(userIdClaim, out var uid) ? uid : 0;

        await using var context = await DbFactory.CreateDbContextAsync();
        context.Pay_EmployeeDocuments.Add(new Pay_EmployeeDocument
        {
            HremployeeId = _employee.id,
            DocumentType = _uploadDocType,
            FileName = _uploadFile.Name,
            StoragePath = relativePath,
            Sha256 = sha256,
            UploadedByUserId = userId,
            UploadedDate = DateTime.Now,
            ExpiryDate = _uploadExpiryDate.HasValue ? DateOnly.FromDateTime(_uploadExpiryDate.Value) : null,
        });
        await context.SaveChangesAsync();

        Snackbar.Add(L.Translate("DocUploadedSuccess"), Severity.Success);
        _uploadFile = null;
        _uploadExpiryDate = null;
        await LoadDocsAsync(context);
    }

