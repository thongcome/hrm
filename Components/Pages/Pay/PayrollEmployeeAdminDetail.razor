@page "/pay/employees/{Id:long}"
@layout PayrollEmployeeHubLayout
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Pay
@using HRM.Services.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@inject PrivateFileStorage FileStorage
@inject SeveranceService SeveranceService
@inject NavigationManager Nav
@inject HRM.Services.Audit.IAuditLogger AuditLogger
@attribute [Authorize(Policy = "Menu:PAY_ADMIN")]

<PageTitle>รายละเอียดพนักงาน (Payroll)</PageTitle>

@if (_notFound)
{
    <MudAlert Severity="Severity.Warning" Class="ma-4">ไม่พบข้อมูลพนักงาน หรือพนักงานไม่ได้อยู่ในบริษัทของคุณ</MudAlert>
}
else if (_employee is null)
{
    <MudProgressCircular Indeterminate="true" Class="ma-4" />
}
else
{
    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" Class="mb-2">ข้อมูลทั่วไป</MudText>
                <EmployeeCoreFieldsForm Employee="_employee" IsCreating="false" CompanyId="@(_companyId!)"
                    Email="@_formEmployeeEmail" EmailChanged="@(v => _formEmployeeEmail = v)"
                    WorkDate="_workDate" WorkDateChanged="@(v => _workDate = v)"
                    BirthDate="_birthDate" BirthDateChanged="@(v => _birthDate = v)"
                    SalaryGrades="_salaryGrades"
                    SelectedCostCenter="_selectedCostCenter" SelectedCostCenterChanged="@(v => _selectedCostCenter = v)"
                    CurrentSlot="_currentSlot" CurrentOrgLabel="@_currentOrgLabel" />

                <MudAlert Severity="Severity.Info" Class="mt-3" Dense="true">
                    ถ้าเปลี่ยนตำแหน่งหรือเงินเดือนในฟอร์มด้านบน ระบบจะบันทึกลง "ประวัติปรับตำแหน่ง/เงินเดือน" ให้อัตโนมัติ — ช่องด้านล่างนี้ไม่บังคับ ใช้เผื่ออยากระบุรายละเอียดเพิ่ม
                </MudAlert>
                <MudGrid Class="mt-1">
                    <MudItem xs="12" sm="4">
                        <MudSelect T="string" @bind-Value="_positionSalaryChangeType" Label="ประเภทการเปลี่ยนแปลง" Clearable="true">
                            <MudSelectItem T="string" Value="@("P")">เลื่อนตำแหน่ง</MudSelectItem>
                            <MudSelectItem T="string" Value="@("D")">ลดตำแหน่ง</MudSelectItem>
                            <MudSelectItem T="string" Value="@("T")">โยกย้าย</MudSelectItem>
                            <MudSelectItem T="string" Value="@("S")">ปรับเงินเดือนอย่างเดียว</MudSelectItem>
                            <MudSelectItem T="string" Value="@("O")">อื่นๆ</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudTextField @bind-Value="_positionSalaryOrderNo" Label="เลขที่คำสั่ง" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudTextField @bind-Value="_positionSalaryReason" Label="หมายเหตุ/เหตุผล" />
                    </MudItem>
                </MudGrid>

                @if (!string.IsNullOrEmpty(_formError))
                {
                    <MudAlert Severity="Severity.Error" Class="mt-3">@_formError</MudAlert>
                }
                <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="mt-4" OnClick="SaveEmployeeAsync">บันทึก</MudButton>
            </MudPaper>

            <MudPaper Class="pa-4 mb-4">
                <MudText Typo="Typo.h6" Class="mb-2">ลาออก / ค่าชดเชย</MudText>
                @if (_employee.ResignDate is null)
                {
                    <MudDatePicker @bind-Date="_resignDate" Label="วันที่ลาออก" Class="mt-1" />
                    @if (!string.IsNullOrEmpty(_resignError))
                    {
                        <MudAlert Severity="Severity.Error" Class="mt-2">@_resignError</MudAlert>
                    }
                    <MudButton Color="Color.Warning" Variant="Variant.Filled" Class="mt-3" OnClick="ConfirmResignAsync">ยืนยันลงวันที่ลาออก</MudButton>
                }
                else
                {
                    @if (!string.IsNullOrEmpty(_severanceError))
                    {
                        <MudAlert Severity="Severity.Error" Class="mt-2">@_severanceError</MudAlert>
                    }
                    @if (_severancePreview is not null)
                    {
                        <MudAlert Severity="Severity.Warning" Class="mt-2">
                            ตรวจสอบก่อนว่าการเลิกจ้างเข้าข่ายข้อยกเว้นตามมาตรา 119 หรือไม่ (เช่น ทุจริต ฝ่าฝืนระเบียบร้ายแรง) หากเข้าข่ายข้อยกเว้น ไม่ต้องยื่นรายการนี้
                        </MudAlert>
                        <MudSimpleTable Dense="true" Class="mt-3">
                            <tbody>
                                <tr><td>อายุงาน</td><td>@_severancePreview.ContinuousServiceDays วัน</td></tr>
                                <tr><td>เกณฑ์ที่เข้าเงื่อนไข</td><td>@_severancePreview.TierDescription</td></tr>
                                <tr><td>จำนวนวันที่ได้รับ</td><td>@_severancePreview.EntitledDays วัน</td></tr>
                                <tr><td>ค่าจ้างต่อวัน</td><td>@_severancePreview.DailyWage.ToString("N2")</td></tr>
                                <tr><td>ยอดค่าชดเชยตามกฎหมาย (ขั้นต่ำ)</td><td>@_severancePreview.Amount.ToString("N2")</td></tr>
                            </tbody>
                        </MudSimpleTable>

                        <MudGrid Class="mt-3">
                            <MudItem xs="12" sm="4">
                                <MudDatePicker @bind-Date="_severanceTargetMonth" Label="งวดที่จะจ่าย" Editable="true" />
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudNumericField @bind-Value="_severanceAmount" Label="จำนวนเงินที่จะยื่น" Format="N2" />
                            </MudItem>
                        </MudGrid>
                        <MudTextField @bind-Value="_severanceReason" Label="เหตุผล" Lines="2" Class="mt-2" />

                        <MudButton Color="Color.Secondary" Variant="Variant.Filled" Class="mt-3" OnClick="SubmitSeveranceAsync">ยื่นค่าชดเชย</MudButton>
                    }
                }
            </MudPaper>

            <MudPaper Class="pa-4 mb-4">
                <MudText Typo="Typo.h6" Class="mb-2">เอกสาร</MudText>
                <MudSimpleTable Dense="true" Class="mt-2">
                    <thead>
                        <tr><th>ประเภท</th><th>ชื่อไฟล์</th><th>วันที่อัปโหลด</th><th></th></tr>
                    </thead>
                    <tbody>
                        @if (_docs.Count == 0)
                        {
                            <tr><td colspan="4"><MudText Typo="Typo.caption">ยังไม่มีเอกสารแนบ</MudText></td></tr>
                        }
                        @foreach (var doc in _docs)
                        {
                            <tr>
                                <td>@DocTypeLabel(doc.DocumentType)</td>
                                <td>@doc.FileName</td>
                                <td>@doc.UploadedDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td><MudLink Href="@($"/pay/files/employee-doc/{doc.Id}")" Target="_blank">ดาวน์โหลด</MudLink></td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>

                <MudGrid Class="mt-3">
                    <MudItem xs="12" sm="4">
                        <MudSelect T="Pay_EmployeeDocumentType" @bind-Value="_uploadDocType" Label="ประเภทเอกสาร">
                            <MudSelectItem T="Pay_EmployeeDocumentType" Value="Pay_EmployeeDocumentType.IdCard">บัตรประชาชน</MudSelectItem>
                            <MudSelectItem T="Pay_EmployeeDocumentType" Value="Pay_EmployeeDocumentType.Contract">สัญญาจ้าง</MudSelectItem>
                            <MudSelectItem T="Pay_EmployeeDocumentType" Value="Pay_EmployeeDocumentType.EducationCertificate">วุฒิการศึกษา</MudSelectItem>
                            <MudSelectItem T="Pay_EmployeeDocumentType" Value="Pay_EmployeeDocumentType.ResignationLetter">ใบลาออก</MudSelectItem>
                            <MudSelectItem T="Pay_EmployeeDocumentType" Value="Pay_EmployeeDocumentType.BankBook">สมุดบัญชีธนาคาร</MudSelectItem>
                            <MudSelectItem T="Pay_EmployeeDocumentType" Value="Pay_EmployeeDocumentType.Other">อื่นๆ</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudFileUpload T="IBrowserFile" FilesChanged="OnFileSelected">
                            <ActivatorContent>
                                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AttachFile">
                                    @(_uploadFile?.Name ?? "เลือกไฟล์")
                                </MudButton>
                            </ActivatorContent>
                        </MudFileUpload>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="UploadDocAsync" Disabled="_uploadFile is null">อัปโหลด</MudButton>
                    </MudItem>
                </MudGrid>

                @if (!string.IsNullOrEmpty(_docError))
                {
                    <MudAlert Severity="Severity.Error" Class="mt-2">@_docError</MudAlert>
                }
            </MudPaper>
}

@code {
    [Parameter] public long Id { get; set; }

    private string? _companyId;
    private Hremployee? _employee;
    private bool _notFound;

    private string? _formEmployeeEmail;
    private DateTime? _workDate;
    private DateTime? _birthDate;
    private string? _formError;
    private string? _positionSalaryReason;
    private string? _positionSalaryOrderNo;
    private string? _positionSalaryChangeType;
    private Com_ChartOfAccount? _selectedCostCenter;
    private List<Pay_SalaryGrade> _salaryGrades = new();
    private Pos_PositionSlot? _currentSlot;
    private string? _currentOrgLabel;

    private DateTime? _resignDate = DateTime.Today;
    private string? _resignError;

    private HRM.Services.Pay.Calculators.SeveranceCalculator.SeveranceResult? _severancePreview;
    private DateTime? _severanceTargetMonth = DateTime.Today;
    private decimal _severanceAmount;
    private string _severanceReason = string.Empty;
    private string? _severanceError;

    private List<Pay_EmployeeDocument> _docs = new();
    private Pay_EmployeeDocumentType _uploadDocType = Pay_EmployeeDocumentType.Other;
    private IBrowserFile? _uploadFile;
    private string? _docError;

    protected override async Task OnParametersSetAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
        if (string.IsNullOrWhiteSpace(_companyId)) { _notFound = true; return; }

        await using var context = await DbFactory.CreateDbContextAsync();

        _employee = await context.Hremployee.FirstOrDefaultAsync(e => e.id == Id && e.companyid == _companyId);
        if (_employee is null) { _notFound = true; return; }

        await AuditLogger.LogAccessAsync("Hremployee", _employee.id.ToString(), isSensitive: true, note: "employee admin record opened");

        _workDate = _employee.WorkDate;
        _birthDate = _employee.BirthDate;
        _formEmployeeEmail = await EmployeeEmailResolver.ResolveAsync(context, _employee.id);

        _salaryGrades = await context.Pay_SalaryGrades
            .Where(g => g.CompanyId == _companyId && g.IsActive)
            .OrderBy(g => g.SortOrder).ThenBy(g => g.GradeCode)
            .ToListAsync();

        _selectedCostCenter = null;
        if (!string.IsNullOrWhiteSpace(_employee.CostCenterCode))
        {
            _selectedCostCenter = await context.Com_ChartOfAccounts
                .FirstOrDefaultAsync(a => a.CompanyId == _companyId && a.Code == _employee.CostCenterCode);
        }

        // Read-only org/position display — sourced live from the active
        // slot (same query EmployeeDetail.razor uses), not from
        // Hremployee's own snapshot fields, so it self-heals even if the
        // snapshot were ever momentarily stale.
        _currentSlot = await context.Pos_PositionSlots.FirstOrDefaultAsync(s => s.HremployeeId == _employee.id && s.IsActive);
        if (_currentSlot?.OrganizationId is long orgId)
        {
            var org = await context.com_organizations.FirstOrDefaultAsync(o => o.id == orgId);
            _currentOrgLabel = org is null ? null : $"{org.code} — {org.name}";
        }
        else
        {
            _currentOrgLabel = null;
        }

        _resignDate = DateTime.Today;
        _resignError = null;

        _severanceError = null;
        _severancePreview = null;
        if (_employee.ResignDate is not null)
        {
            try
            {
                _severancePreview = await SeveranceService.PreviewAsync(_employee.id);
                _severanceAmount = _severancePreview.Amount;
                _severanceReason = $"ค่าชดเชยตามกฎหมาย มาตรา 118 ({_severancePreview.TierDescription})";
                _severanceTargetMonth = DateTime.Today;
            }
            catch (InvalidOperationException ex)
            {
                _severanceError = ex.Message;
            }
        }

        await LoadDocsAsync(context);
    }

    private async Task LoadDocsAsync(HRMContext context)
    {
        _docs = await context.Pay_EmployeeDocuments
            .Where(d => d.HremployeeId == Id)
            .OrderByDescending(d => d.UploadedDate)
            .ToListAsync();
    }

    private async Task SaveEmployeeAsync()
    {
        _formError = null;

        if (_employee is null || string.IsNullOrWhiteSpace(_employee.EmpName) || string.IsNullOrWhiteSpace(_employee.EmpSurname)
            || string.IsNullOrWhiteSpace(_formEmployeeEmail))
        {
            _formError = "กรุณากรอกชื่อ นามสกุล และอีเมล";
            return;
        }

        if (!EmployeeEmailResolver.IsValidFormat(_formEmployeeEmail))
        {
            _formError = "รูปแบบอีเมลไม่ถูกต้อง";
            return;
        }

        try
        {
            await using var context = await DbFactory.CreateDbContextAsync();
            var existing = await context.Hremployee.FirstOrDefaultAsync(e => e.id == Id && e.companyid == _companyId);
            if (existing is null)
            {
                _formError = "ไม่พบข้อมูลพนักงาน";
                return;
            }

            existing.PrenameCode = _employee.PrenameCode;
            existing.EmpName = _employee.EmpName;
            existing.EmpSurname = _employee.EmpSurname;
            var oldPosCode = existing.PosCode;
            var oldSalary = existing.SalaryAmt;

            existing.EmptypeCode = _employee.EmptypeCode;
            existing.DeptgrpCode = _employee.DeptgrpCode;
            existing.PosCode = _employee.PosCode;
            existing.CostCenterCode = _employee.CostCenterCode;
            existing.IdCard = _employee.IdCard;
            existing.SalaryAmt = _employee.SalaryAmt;
            existing.SalaryGradeId = _employee.SalaryGradeId;
            existing.SalexpBank = _employee.SalexpBank;
            existing.SalexpBranch = _employee.SalexpBranch;
            existing.SalexpAccid = _employee.SalexpAccid;
            existing.WorkDate = _workDate;
            existing.BirthDate = _birthDate;
            await context.SaveChangesAsync();
            await EmployeeEmailResolver.SetAsync(context, existing.id, _formEmployeeEmail!);

            // Auto-capture into ประวัติปรับตำแหน่ง/เงินเดือน — only when
            // position or salary actually changed, so a save that touches
            // unrelated fields doesn't create a spurious history row.
            if (oldPosCode != existing.PosCode || oldSalary != existing.SalaryAmt)
            {
                var state = await AuthProvider.GetAuthenticationStateAsync();
                var userIdClaim = state.User.FindFirstValue("sc_userid");
                var userId = long.TryParse(userIdClaim, out var uid) ? uid : (long?)null;

                context.Pay_PositionSalaryHistories.Add(new Pay_PositionSalaryHistory
                {
                    HremployeeId = existing.id,
                    EmpNo = existing.EmpNo,
                    CompanyId = existing.companyid,
                    OldPositionCode = oldPosCode,
                    NewPositionCode = existing.PosCode,
                    OldSalary = oldSalary,
                    NewSalary = existing.SalaryAmt,
                    ChangeType = string.IsNullOrWhiteSpace(_positionSalaryChangeType) ? null : _positionSalaryChangeType,
                    OrderNo = string.IsNullOrWhiteSpace(_positionSalaryOrderNo) ? null : _positionSalaryOrderNo,
                    OrderDate = DateTime.Today,
                    Reason = string.IsNullOrWhiteSpace(_positionSalaryReason) ? null : _positionSalaryReason,
                    ChangedByUserId = userId,
                });
                await context.SaveChangesAsync();
            }

            _employee = existing;
        }
        catch (DbUpdateException)
        {
            // Never let a DB-level failure bubble up as an unhandled
            // exception — that crashes the whole Blazor circuit.
            _formError = "บันทึกไม่สำเร็จ — ข้อมูลอาจไม่ถูกต้องตามรูปแบบที่ระบบกำหนด กรุณาตรวจสอบแล้วลองใหม่";
            return;
        }

        Snackbar.Add("บันทึกข้อมูลเรียบร้อย", Severity.Success);
    }

    private async Task ConfirmResignAsync()
    {
        _resignError = null;

        if (_resignDate is null)
        {
            _resignError = "กรุณาระบุวันที่ลาออก";
            return;
        }

        await using var context = await DbFactory.CreateDbContextAsync();
        var existing = await context.Hremployee.FirstOrDefaultAsync(e => e.id == Id && e.companyid == _companyId);
        if (existing is null)
        {
            _resignError = "ไม่พบข้อมูลพนักงาน";
            return;
        }

        existing.ResignDate = _resignDate;
        await context.SaveChangesAsync();

        Snackbar.Add("บันทึกวันที่ลาออกเรียบร้อย", Severity.Success);
        await OnParametersSetAsync();
    }

    private async Task SubmitSeveranceAsync()
    {
        _severanceError = null;

        if (_employee is null || _severanceTargetMonth is null || _severanceAmount <= 0 || string.IsNullOrWhiteSpace(_severanceReason))
        {
            _severanceError = "กรุณากรอกข้อมูลให้ครบถ้วน";
            return;
        }

        var state = await AuthProvider.GetAuthenticationStateAsync();
        var userIdClaim = state.User.FindFirstValue("sc_userid");
        var userId = long.TryParse(userIdClaim, out var uid) ? uid : 0;

        // InvariantCulture: ambient Thai culture formats "yyyy" as Buddhist
        // year — TargetPeriod must stay Gregorian to match Pay_PayrollRun.
        var targetPeriod = _severanceTargetMonth.Value.ToString("yyyyMM", System.Globalization.CultureInfo.InvariantCulture);

        try
        {
            await SeveranceService.SubmitAsync(_employee.id, targetPeriod, _severanceAmount, _severanceReason, userId);
        }
        catch (InvalidOperationException ex)
        {
            _severanceError = ex.Message;
            return;
        }

        Snackbar.Add("ยื่นค่าชดเชยเรียบร้อย รออนุมัติที่หน้ารายการเฉพาะกิจ", Severity.Success);
        Nav.NavigateTo($"/pay/adhoc/{targetPeriod}");
    }

    private void OnFileSelected(IBrowserFile file)
    {
        _uploadFile = file;
    }

    private async Task UploadDocAsync()
    {
        _docError = null;
        if (_employee is null || _uploadFile is null) return;

        const long maxSize = 10 * 1024 * 1024; // 10 MB
        if (_uploadFile.Size > maxSize)
        {
            _docError = "ไฟล์ใหญ่เกินไป (จำกัด 10 MB)";
            return;
        }

        await using var stream = _uploadFile.OpenReadStream(maxSize);
        using var buffer = new MemoryStream();
        await stream.CopyToAsync(buffer);
        var bytes = buffer.ToArray();

        var storedFileName = $"{_employee.EmpNo}_{DateTime.Now:yyyyMMddHHmmss}_{_uploadFile.Name}";
        var (relativePath, sha256) = await FileStorage.SaveAsync("employee-docs", storedFileName, bytes);

        var state = await AuthProvider.GetAuthenticationStateAsync();
        var userIdClaim = state.User.FindFirstValue("sc_userid");
        var userId = long.TryParse(userIdClaim, out var uid) ? uid : 0;

        await using var context = await DbFactory.CreateDbContextAsync();
        context.Pay_EmployeeDocuments.Add(new Pay_EmployeeDocument
        {
            HremployeeId = _employee.id,
            DocumentType = _uploadDocType,
            FileName = _uploadFile.Name,
            StoragePath = relativePath,
            Sha256 = sha256,
            UploadedByUserId = userId,
            UploadedDate = DateTime.Now,
        });
        await context.SaveChangesAsync();

        Snackbar.Add("อัปโหลดเอกสารเรียบร้อย", Severity.Success);
        _uploadFile = null;
        await LoadDocsAsync(context);
    }

    private static string DocTypeLabel(Pay_EmployeeDocumentType type) => type switch
    {
        Pay_EmployeeDocumentType.IdCard => "บัตรประชาชน",
        Pay_EmployeeDocumentType.Contract => "สัญญาจ้าง",
        Pay_EmployeeDocumentType.EducationCertificate => "วุฒิการศึกษา",
        Pay_EmployeeDocumentType.ResignationLetter => "ใบลาออก",
        Pay_EmployeeDocumentType.BankBook => "สมุดบัญชีธนาคาร",
        _ => "อื่นๆ",
    };
}
