    private string SalaryGradeLabel()
    {
        if (_employee?.SalaryGradeId is not long gradeId) return "—";
        var grade = _salaryGrades.FirstOrDefault(g => g.Id == gradeId);
        return grade is null ? "—" : $"{grade.GradeCode} — {grade.GradeName}";
    }

    private async Task SubmitSeparationAsync()
    {
        _separationError = null;

        if (_employee is null || _separationEffectiveDate is null)
        {
            _separationError = L.Translate("PleaseSpecifyResignDateError");
            return;
        }

        var state = await AuthProvider.GetAuthenticationStateAsync();
        var userIdClaim = state.User.FindFirstValue("sc_userid");
        var userId = long.TryParse(userIdClaim, out var uid) ? uid : 0;
        var requesterEmpId = state.User.FindFirst("empno")?.Value;

        try
        {
            await SeparationRequestService.SubmitAsync(_employee.id, _separationType, _separationEffectiveDate.Value,
                _separationReason, userId, requesterEmpId);
        }
        catch (InvalidOperationException ex)
        {
            _separationError = ex.Message;
            return;
        }

        Snackbar.Add("ส่งคำขอสิ้นสุดการจ้างงานเรียบร้อย รออนุมัติ", Severity.Success);
        await OnParametersSetAsync();
    }

    private async Task SubmitRescheduleAsync()
    {
        _rescheduleError = null;

        if (_employee is null || _rescheduleNewDate is null)
        {
            _rescheduleError = "กรุณาระบุวันที่มีผลใหม่";
            return;
        }

        var state = await AuthProvider.GetAuthenticationStateAsync();
        var userId = long.TryParse(state.User.FindFirstValue("sc_userid"), out var uid) ? uid : 0;
        var requesterEmpId = state.User.FindFirst("empno")?.Value;

        try
        {
            await SeparationRequestService.RescheduleAsync(_employee.id, _rescheduleNewDate.Value,
                _rescheduleReason, userId, requesterEmpId);
        }
        catch (InvalidOperationException ex)
        {
            _rescheduleError = ex.Message;
            return;
        }

        _rescheduleNewDate = null;
        _rescheduleReason = null;
        Snackbar.Add("ส่งคำขอเลื่อนวันสิ้นสุดการจ้างงานเรียบร้อย รออนุมัติ", Severity.Success);
        await OnParametersSetAsync();
    }

