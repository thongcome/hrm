@page "/pay/employees/{Id:long}"
@layout PayrollEmployeeHubLayout
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Pay
@using HRM.Services.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@inject PrivateFileStorage FileStorage
@inject SeveranceService SeveranceService
@inject HRM.Services.Hr.SeparationRequestService SeparationRequestService
@inject NavigationManager Nav
@inject HRM.Services.Audit.IAuditLogger AuditLogger
@inject JsonLocalizationService L
@attribute [Authorize(Policy = "Menu:PAY_ADMIN")]

<PageTitle>@L.Translate("PayrollEmployeeDetailPageTitle")</PageTitle>

@if (_notFound)
{
    <MudAlert Severity="Severity.Warning" Class="ma-4">@L.Translate("EmployeeDataNotFoundOrOutsideCompanyError")</MudAlert>
}
else if (_employee is null)
{
    <MudProgressCircular Indeterminate="true" Class="ma-4" />
}
else
{
    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" Class="mb-2">@L.Translate("GeneralInfoHeading")</MudText>

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-4">
            @if (!string.IsNullOrEmpty(_employee.PhotoStoragePath))
            {
                <MudAvatar Size="Size.Large" Style="width:80px;height:80px;">
                    <MudImage Src="@($"/org/files/employee-photo/{_employee.id}")" ObjectFit="ObjectFit.Cover" />
                </MudAvatar>
            }
            else
            {
                <MudAvatar Size="Size.Large" Style="width:80px;height:80px;" Color="Color.Primary">
                    @InitialsFor(_employee)
                </MudAvatar>
            }
            <MudStack Spacing="1">
                <MudFileUpload T="IBrowserFile" FilesChanged="OnPhotoSelected" Accept=".jpg,.jpeg,.png">
                    <ActivatorContent>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.PhotoCamera">
                            @(string.IsNullOrEmpty(_employee.PhotoStoragePath) ? L.Translate("UploadEmployeePhotoButton") : L.Translate("ChangeEmployeePhotoButton"))
                        </MudButton>
                    </ActivatorContent>
                </MudFileUpload>
                @if (_photoError is not null)
                {
                    <MudText Typo="Typo.caption" Color="Color.Error">@_photoError</MudText>
                }
            </MudStack>
        </MudStack>

                @if (_editingCore)
                {
                    <EmployeeCoreFieldsForm Employee="_employee" IsCreating="false" CompanyId="@(_companyId!)"
                        Email="@_formEmployeeEmail" EmailChanged="@(v => _formEmployeeEmail = v)"
                        WorkDate="_workDate" WorkDateChanged="@(v => _workDate = v)"
                        BirthDate="_birthDate" BirthDateChanged="@(v => _birthDate = v)"
                        SalaryGrades="_salaryGrades"
                        SelectedCostCenter="_selectedCostCenter" SelectedCostCenterChanged="@(v => _selectedCostCenter = v)"
                        CurrentSlot="_currentSlot" CurrentOrgLabel="@_currentOrgLabel" />

                    <MudAlert Severity="Severity.Info" Class="mt-3" Dense="true">
                        @L.Translate("PositionSalaryAutoTrackNote")
                    </MudAlert>
                    <MudGrid Class="mt-1">
                        <MudItem xs="12" sm="4">
                            <MudSelect T="string" @bind-Value="_positionSalaryChangeType" Label="@L.Translate("ChangeTypeLabel")" Clearable="true">
                                <MudSelectItem T="string" Value="@("P")">@L.Translate("ChangeTypePromotion")</MudSelectItem>
                                <MudSelectItem T="string" Value="@("D")">@L.Translate("ChangeTypeDemotion")</MudSelectItem>
                                <MudSelectItem T="string" Value="@("T")">@L.Translate("ChangeTypeTransfer")</MudSelectItem>
                                <MudSelectItem T="string" Value="@("S")">@L.Translate("ChangeTypeSalaryOnly")</MudSelectItem>
                                <MudSelectItem T="string" Value="@("O")">@L.Translate("ChangeTypeOther")</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudTextField @bind-Value="_positionSalaryOrderNo" Label="@L.Translate("OrderNoLabel")" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudTextField @bind-Value="_positionSalaryReason" Label="@L.Translate("ReasonNoteLabel")" />
                        </MudItem>
                    </MudGrid>

                    @if (!string.IsNullOrEmpty(_formError))
                    {
                        <MudAlert Severity="Severity.Error" Class="mt-3">@_formError</MudAlert>
                    }
                    <MudStack Row="true" Spacing="2" Class="mt-4">
                        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveEmployeeAsync">@L.Translate("SaveButton")</MudButton>
                        <MudButton Variant="Variant.Text" OnClick="CancelEditCoreAsync">@L.Translate("CancelButton")</MudButton>
                    </MudStack>
                }
                else
                {
                    <MudGrid>
                        <MudItem xs="12" sm="4"><MudText Typo="Typo.caption" Class="mud-text-secondary">@L.Translate("EmpNoLabel")</MudText><MudText Typo="Typo.body1">@_employee.EmpNo</MudText></MudItem>
                        <MudItem xs="12" sm="4"><MudText Typo="Typo.caption" Class="mud-text-secondary">@L.Translate("FirstNameLabel")</MudText><MudText Typo="Typo.body1">@_employee.PrenameCode @_employee.EmpName @_employee.EmpSurname</MudText></MudItem>
                        <MudItem xs="12" sm="4"><MudText Typo="Typo.caption" Class="mud-text-secondary">@L.Translate("EmailFieldLabel")</MudText><MudText Typo="Typo.body1">@(_formEmployeeEmail ?? "—")</MudText></MudItem>
                        <MudItem xs="12" sm="4"><MudText Typo="Typo.caption" Class="mud-text-secondary">@L.Translate("EmployeeTypeFieldLabel")</MudText><MudText Typo="Typo.body1">@EmpTypeLabel()</MudText></MudItem>
                        <MudItem xs="12" sm="4"><MudText Typo="Typo.caption" Class="mud-text-secondary">@L.Translate("DepartmentLabel")</MudText><MudText Typo="Typo.body1">@(_employee.DeptgrpCode ?? "—")</MudText></MudItem>
                        <MudItem xs="12" sm="4"><MudText Typo="Typo.caption" Class="mud-text-secondary">@L.Translate("PositionLabel")</MudText><MudText Typo="Typo.body1">@(_employee.PosCode ?? "—")</MudText></MudItem>
                        <MudItem xs="12" sm="4"><MudText Typo="Typo.caption" Class="mud-text-secondary">@L.Translate("CostCenterFieldLabel")</MudText><MudText Typo="Typo.body1">@(_selectedCostCenter is null ? "—" : $"{_selectedCostCenter.Code} — {_selectedCostCenter.NameTh}")</MudText></MudItem>
                        <MudItem xs="12" sm="4">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@L.Translate("OrganizationOrgChartLabel")</MudText>
                            <MudText Typo="Typo.body1">@(_currentOrgLabel ?? L.Translate("NotLinkedToPositionSlotText"))</MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">@string.Format(L.Translate("PositionInlineTemplate"), _currentSlot?.Name ?? "—")</MudText>
                        </MudItem>
                        <MudItem xs="12" sm="4"><MudText Typo="Typo.caption" Class="mud-text-secondary">@L.Translate("WorkDateLabel")</MudText><MudText Typo="Typo.body1">@(_workDate?.ToString("dd/MM/yyyy") ?? "—")</MudText></MudItem>
                        <MudItem xs="12" sm="4"><MudText Typo="Typo.caption" Class="mud-text-secondary">@L.Translate("BirthDateFieldLabel")</MudText><MudText Typo="Typo.body1">@(_birthDate?.ToString("dd/MM/yyyy") ?? "—")</MudText></MudItem>
                        <MudItem xs="12" sm="4"><MudText Typo="Typo.caption" Class="mud-text-secondary">@L.Translate("IdCardLabel")</MudText><MudText Typo="Typo.body1">@(_employee.IdCard ?? "—")</MudText></MudItem>
                        <MudItem xs="12" sm="4"><MudText Typo="Typo.caption" Class="mud-text-secondary">@L.Translate("SalaryLabel")</MudText><MudText Typo="Typo.body1">@(_employee.SalaryAmt?.ToString("N2") ?? "—")</MudText></MudItem>
                        <MudItem xs="12" sm="4"><MudText Typo="Typo.caption" Class="mud-text-secondary">@L.Translate("SalaryGradeFieldLabel")</MudText><MudText Typo="Typo.body1">@SalaryGradeLabel()</MudText></MudItem>
                        <MudItem xs="12" sm="4"><MudText Typo="Typo.caption" Class="mud-text-secondary">@L.Translate("BankCodeLabel")</MudText><MudText Typo="Typo.body1">@(_employee.SalexpBank ?? "—")</MudText></MudItem>
                        <MudItem xs="12" sm="4"><MudText Typo="Typo.caption" Class="mud-text-secondary">@L.Translate("BranchCodeLabel")</MudText><MudText Typo="Typo.body1">@(_employee.SalexpBranch ?? "—")</MudText></MudItem>
                        <MudItem xs="12" sm="4"><MudText Typo="Typo.caption" Class="mud-text-secondary">@L.Translate("AccountNoLabel")</MudText><MudText Typo="Typo.body1">@(_employee.SalexpAccid ?? "—")</MudText></MudItem>
                    </MudGrid>
                    <MudButton Color="Color.Primary" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Edit" Class="mt-4" OnClick="@(() => _editingCore = true)">@L.Translate("EditButton")</MudButton>
                }
            </MudPaper>

            <MudPaper Class="pa-4 mb-4">
                <MudText Typo="Typo.h6" Class="mb-2">@L.Translate("ResignSeveranceHeading")</MudText>
                @if (_employee.ResignDate is null)
                {
                    @if (_latestSeparationRequest is { Status: SeparationRequestStatus.PendingApproval })
                    {
                        <MudAlert Severity="Severity.Info" Class="mt-1">
                            มีคำขอสิ้นสุดการจ้างงานรออนุมัติอยู่ — @HRM.Services.Hr.SeparationRequestService.SeparationTypeLabel(_latestSeparationRequest.SeparationType),
                            มีผลวันที่ @_latestSeparationRequest.EffectiveDate.ToString("dd/MM/yyyy") —
                            ดูสถานะได้ที่ <MudLink Href="/wf/my-inbox">กล่องอนุมัติ (My Inbox)</MudLink>
                        </MudAlert>
                    }
                    else
                    {
                        @if (_latestSeparationRequest is { Status: SeparationRequestStatus.Rejected })
                        {
                            <MudAlert Severity="Severity.Warning" Class="mt-1 mb-3">คำขอสิ้นสุดการจ้างงานก่อนหน้าถูกปฏิเสธ — ส่งคำขอใหม่ได้ด้านล่าง</MudAlert>
                        }
                        <MudAlert Severity="Severity.Info" Class="mb-3" Dense="true">
                            การสิ้นสุดการจ้างงานทุกกรณี (รวมลาออกเอง) ต้องผ่านการอนุมัติก่อนจึงจะบันทึกวันที่สิ้นสุดจริง
                        </MudAlert>
                        <MudSelect T="SeparationType" @bind-Value="_separationType" Label="ประเภทการสิ้นสุดการจ้างงาน" Class="mt-1">
                            <MudSelectItem T="SeparationType" Value="SeparationType.VoluntaryResignation">ลาออกเอง (ไม่มีค่าชดเชย)</MudSelectItem>
                            <MudSelectItem T="SeparationType" Value="SeparationType.TerminationOrdinary">เลิกจ้าง — ไม่เข้าข่ายมาตรา 119 (มีค่าชดเชยตามอายุงาน)</MudSelectItem>
                            <MudSelectItem T="SeparationType" Value="SeparationType.TerminationSection119">เลิกจ้าง — เข้าข่ายมาตรา 119 (ไม่มีค่าชดเชย)</MudSelectItem>
                        </MudSelect>
                        <MudDatePicker @bind-Date="_separationEffectiveDate" Label="วันที่มีผล (วันสุดท้ายของการจ้างงาน)" Class="mt-2" Culture="@System.Globalization.CultureInfo.InvariantCulture" />
                        <MudTextField @bind-Value="_separationReason" Label="เหตุผล / หมายเหตุ" Lines="2" Class="mt-2" />
                        @if (!string.IsNullOrEmpty(_separationError))
                        {
                            <MudAlert Severity="Severity.Error" Class="mt-2">@_separationError</MudAlert>
                        }
                        <MudButton Color="Color.Warning" Variant="Variant.Filled" Class="mt-3" OnClick="SubmitSeparationAsync">ส่งคำขอสิ้นสุดการจ้างงาน</MudButton>
                    }
                }
                else
                {
                    <MudAlert Severity="@(_employee.ResignDate > DateTime.Today ? Severity.Info : Severity.Normal)" Class="mt-1 mb-2" Dense="true">
                        วันสิ้นสุดการจ้างงาน: <b>@_employee.ResignDate?.ToString("dd/MM/yyyy")</b>
                        @if (_employee.ResignDate > DateTime.Today)
                        {
                            <text> — ยังไม่ถึงวันมีผล พนักงานยังครองอัตราอยู่ (อัตราจะถูกปล่อยเป็นว่างอัตโนมัติเมื่อถึงวันนี้)</text>
                        }
                        else
                        {
                            <text> — พ้นสภาพแล้ว อัตราถูกปล่อยเป็นว่างเรียบร้อย</text>
                        }
                    </MudAlert>

                    @if (_employee.ResignDate > DateTime.Today)
                    {
                        @if (_pendingDateChange is not null)
                        {
                            <MudAlert Severity="Severity.Info" Class="mb-2" Dense="true">
                                มีคำขอ<b>เลื่อนวันสิ้นสุดการจ้างงาน</b>รออนุมัติ — จาก @_pendingDateChange.OldEffectiveDate.ToString("dd/MM/yyyy") → @_pendingDateChange.NewEffectiveDate.ToString("dd/MM/yyyy")
                                (ดูสถานะที่ <MudLink Href="/wf/my-inbox">กล่องอนุมัติ</MudLink>)
                            </MudAlert>
                        }
                        else
                        {
                            <MudExpansionPanels Class="mb-2">
                                <MudExpansionPanel Text="เลื่อนวันสิ้นสุดการจ้างงาน (ต้องผ่านการอนุมัติ)">
                                    <MudDatePicker @bind-Date="_rescheduleNewDate" Label="วันที่มีผลใหม่" Culture="@System.Globalization.CultureInfo.InvariantCulture" />
                                    <MudTextField @bind-Value="_rescheduleReason" Label="เหตุผลการเลื่อน" Lines="2" Class="mt-2" />
                                    @if (!string.IsNullOrEmpty(_rescheduleError))
                                    {
                                        <MudAlert Severity="Severity.Error" Class="mt-2">@_rescheduleError</MudAlert>
                                    }
                                    <MudButton Color="Color.Warning" Variant="Variant.Filled" Class="mt-2" OnClick="SubmitRescheduleAsync">ส่งคำขอเลื่อนวัน</MudButton>
                                </MudExpansionPanel>
                            </MudExpansionPanels>
                        }
                    }

                    @if (_dateChangeHistory.Count > 0)
                    {
                        <MudText Typo="Typo.subtitle2" Class="mt-2 mb-1">ประวัติการเลื่อนวันสิ้นสุดการจ้างงาน</MudText>
                        <MudSimpleTable Dense="true" Bordered="true" Class="mb-3">
                            <thead>
                                <tr><th>วันเดิม</th><th>วันใหม่</th><th>เหตุผล</th><th>สถานะ</th><th>ยื่นเมื่อ</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var h in _dateChangeHistory)
                                {
                                    <tr>
                                        <td>@h.OldEffectiveDate.ToString("dd/MM/yyyy")</td>
                                        <td>@h.NewEffectiveDate.ToString("dd/MM/yyyy")</td>
                                        <td>@h.Reason</td>
                                        <td>
                                            <MudChip T="string" Size="Size.Small"
                                                Color="@(h.Status == SeparationRequestStatus.Approved ? Color.Success : h.Status == SeparationRequestStatus.Rejected ? Color.Error : Color.Warning)">
                                                @DateChangeStatusLabel(h.Status)
                                            </MudChip>
                                        </td>
                                        <td>@h.RequestedDate.ToString("dd/MM/yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }

                    @if (!string.IsNullOrEmpty(_severanceError))
                    {
                        <MudAlert Severity="Severity.Error" Class="mt-2">@_severanceError</MudAlert>
                    }
                    @if (_severancePreview is not null)
                    {
                        <MudAlert Severity="Severity.Warning" Class="mt-2">
                            @L.Translate("Section119WarningNote")
                        </MudAlert>
                        <MudSimpleTable Dense="true" Class="mt-3">
                            <tbody>
                                <tr><td>@L.Translate("TenureLabel")</td><td>@_severancePreview.ContinuousServiceDays @L.Translate("DaysUnit")</td></tr>
                                <tr><td>@L.Translate("MatchedTierLabel")</td><td>@_severancePreview.TierDescription</td></tr>
                                <tr><td>@L.Translate("EntitledDaysLabel")</td><td>@_severancePreview.EntitledDays @L.Translate("DaysUnit")</td></tr>
                                <tr><td>@L.Translate("DailyWageLabel")</td><td>@_severancePreview.DailyWage.ToString("N2")</td></tr>
                                <tr><td>@L.Translate("StatutoryMinSeveranceLabel")</td><td>@_severancePreview.Amount.ToString("N2")</td></tr>
                            </tbody>
                        </MudSimpleTable>

                        <MudGrid Class="mt-3">
                            <MudItem xs="12" sm="4">
                                <MudDatePicker @bind-Date="_severanceTargetMonth" Label="@L.Translate("SeverancePayPeriodLabel")" Culture="@System.Globalization.CultureInfo.InvariantCulture" />
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudNumericField @bind-Value="_severanceAmount" Label="@L.Translate("SeveranceAmountLabel")" Format="N2" />
                            </MudItem>
                        </MudGrid>
                        <MudTextField @bind-Value="_severanceReason" Label="@L.Translate("ReasonLabel")" Lines="2" Class="mt-2" />

                        <MudButton Color="Color.Secondary" Variant="Variant.Filled" Class="mt-3" OnClick="SubmitSeveranceAsync">@L.Translate("SubmitSeveranceButton")</MudButton>
                    }
                }
            </MudPaper>

            <MudPaper Class="pa-4 mb-4">
                <MudText Typo="Typo.h6" Class="mb-2">@L.Translate("DocumentsHeading")</MudText>
                <MudSimpleTable Dense="true" Class="mt-2">
                    <thead>
                        <tr><th>@L.Translate("ColDocType")</th><th>@L.Translate("ColFileName")</th><th>@L.Translate("ColUploadDate")</th><th>@L.Translate("ColExpiryDate")</th><th></th></tr>
                    </thead>
                    <tbody>
                        @if (_docs.Count == 0)
                        {
                            <tr><td colspan="5"><MudText Typo="Typo.caption">@L.Translate("NoAttachmentsMessage")</MudText></td></tr>
                        }
                        @foreach (var doc in _docs)
                        {
                            <tr>
                                <td>@DocTypeLabel(doc.DocumentType)</td>
                                <td>@doc.FileName</td>
                                <td>@doc.UploadedDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @if (doc.ExpiryDate is { } exp)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="@ExpiryChipColor(exp)">@exp.ToString("dd/MM/yyyy")</MudChip>
                                    }
                                </td>
                                <td><MudLink Href="@($"/pay/files/employee-doc/{doc.Id}")" Target="_blank">@L.Translate("DownloadButton")</MudLink></td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>

                <MudGrid Class="mt-3">
                    <MudItem xs="12" sm="3">
                        <MudSelect T="Pay_EmployeeDocumentType" @bind-Value="_uploadDocType" Label="@L.Translate("DocumentTypeLabel")">
                            <MudSelectItem T="Pay_EmployeeDocumentType" Value="Pay_EmployeeDocumentType.IdCard">@L.Translate("DocTypeIdCard")</MudSelectItem>
                            <MudSelectItem T="Pay_EmployeeDocumentType" Value="Pay_EmployeeDocumentType.Contract">@L.Translate("DocTypeContract")</MudSelectItem>
                            <MudSelectItem T="Pay_EmployeeDocumentType" Value="Pay_EmployeeDocumentType.EducationCertificate">@L.Translate("DocTypeEducationCertificate")</MudSelectItem>
                            <MudSelectItem T="Pay_EmployeeDocumentType" Value="Pay_EmployeeDocumentType.ResignationLetter">@L.Translate("DocTypeResignationLetter")</MudSelectItem>
                            <MudSelectItem T="Pay_EmployeeDocumentType" Value="Pay_EmployeeDocumentType.BankBook">@L.Translate("DocTypeBankBook")</MudSelectItem>
                            <MudSelectItem T="Pay_EmployeeDocumentType" Value="Pay_EmployeeDocumentType.WorkPermit">@L.Translate("DocTypeWorkPermit")</MudSelectItem>
                            <MudSelectItem T="Pay_EmployeeDocumentType" Value="Pay_EmployeeDocumentType.Visa">@L.Translate("DocTypeVisa")</MudSelectItem>
                            <MudSelectItem T="Pay_EmployeeDocumentType" Value="Pay_EmployeeDocumentType.DrivingLicense">@L.Translate("DocTypeDrivingLicense")</MudSelectItem>
                            <MudSelectItem T="Pay_EmployeeDocumentType" Value="Pay_EmployeeDocumentType.ProfessionalLicense">@L.Translate("DocTypeProfessionalLicense")</MudSelectItem>
                            <MudSelectItem T="Pay_EmployeeDocumentType" Value="Pay_EmployeeDocumentType.Other">@L.Translate("DocTypeOther")</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudDatePicker @bind-Date="_uploadExpiryDate" Label="@L.Translate("ExpiryDateOptionalLabel")" Culture="@System.Globalization.CultureInfo.InvariantCulture" />
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudFileUpload T="IBrowserFile" FilesChanged="OnFileSelected">
                            <ActivatorContent>
                                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AttachFile">
                                    @(_uploadFile?.Name ?? L.Translate("SelectFileButton"))
                                </MudButton>
                            </ActivatorContent>
                        </MudFileUpload>
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="UploadDocAsync" Disabled="_uploadFile is null">@L.Translate("UploadButton")</MudButton>
                    </MudItem>
                </MudGrid>

                @if (!string.IsNullOrEmpty(_docError))
                {
                    <MudAlert Severity="Severity.Error" Class="mt-2">@_docError</MudAlert>
                }
            </MudPaper>
}

@code {
    [Parameter] public long Id { get; set; }

    private string? _companyId;
    private Hremployee? _employee;
    private bool _notFound;

    private bool _editingCore;
    private string? _formEmployeeEmail;
    private DateTime? _workDate;
    private DateTime? _birthDate;
    private string? _formError;
    private string? _positionSalaryReason;
    private string? _positionSalaryOrderNo;
    private string? _positionSalaryChangeType;
    private Com_ChartOfAccount? _selectedCostCenter;
    private List<Pay_SalaryGrade> _salaryGrades = new();
    private Pos_PositionSlot? _currentSlot;
    private string? _currentOrgLabel;

    private Hr_SeparationRequest? _latestSeparationRequest;
    private SeparationType _separationType = SeparationType.VoluntaryResignation;
    private DateTime? _separationEffectiveDate = DateTime.Today;
    private string? _separationReason;
    private string? _separationError;
    private List<Hr_SeparationDateChange> _dateChangeHistory = new();
    private Hr_SeparationDateChange? _pendingDateChange;
    private DateTime? _rescheduleNewDate;
    private string? _rescheduleReason;
    private string? _rescheduleError;

    private HRM.Services.Pay.Calculators.SeveranceCalculator.SeveranceResult? _severancePreview;
    private DateTime? _severanceTargetMonth = DateTime.Today;
    private decimal _severanceAmount;
    private string _severanceReason = string.Empty;
    private string? _severanceError;

    private List<Pay_EmployeeDocument> _docs = new();
    private Pay_EmployeeDocumentType _uploadDocType = Pay_EmployeeDocumentType.Other;
    private DateTime? _uploadExpiryDate;
    private IBrowserFile? _uploadFile;
    private string? _docError;

    protected override async Task OnParametersSetAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
        if (string.IsNullOrWhiteSpace(_companyId)) { _notFound = true; return; }

        await using var context = await DbFactory.CreateDbContextAsync();

        _employee = await context.Hremployee.FirstOrDefaultAsync(e => e.id == Id && e.companyid == _companyId);
        if (_employee is null) { _notFound = true; return; }

        await AuditLogger.LogAccessAsync("Hremployee", _employee.id.ToString(), isSensitive: true, note: "employee admin record opened");

        // Lazy apply-on-read: pick up a separation request whose workflow
        // job has since closed (approved/rejected) before rendering the
        // resignation panel below — no scheduler exists anywhere in this
        // app, so this is the only place ResignDate/SeparationType get
        // applied. Reload (not a second FirstOrDefaultAsync on the same
        // context) because SyncStatusFromJobAsync writes through its own
        // DbContext — the identity map would otherwise hand back the
        // already-tracked, now-stale _employee instance.
        await SeparationRequestService.SyncStatusFromJobAsync(_employee.id);
        await context.Entry(_employee).ReloadAsync();
        _latestSeparationRequest = await SeparationRequestService.GetLatestAsync(_employee.id);

        // Same lazy apply-on-read for a reschedule (เลื่อนวันลาออก) whose job has
        // closed — it may have moved ResignDate, so reload again before the panel
        // renders — then load the change history + any still-pending change.
        await SeparationRequestService.SyncDateChangeStatusFromJobAsync(_employee.id);
        await context.Entry(_employee).ReloadAsync();
        _dateChangeHistory = await SeparationRequestService.GetDateChangeHistoryAsync(_employee.id);
        _pendingDateChange = _dateChangeHistory.FirstOrDefault(c => c.Status == SeparationRequestStatus.PendingApproval);

        _workDate = _employee.WorkDate;
        _birthDate = _employee.BirthDate;
        _formEmployeeEmail = await EmployeeEmailResolver.ResolveAsync(context, _employee.id);

        _salaryGrades = await context.Pay_SalaryGrades
            .Where(g => g.CompanyId == _companyId && g.IsActive)
            .OrderBy(g => g.SortOrder).ThenBy(g => g.GradeCode)
            .ToListAsync();

        _selectedCostCenter = null;
        if (!string.IsNullOrWhiteSpace(_employee.CostCenterCode))
        {
            _selectedCostCenter = await context.Com_ChartOfAccounts
                .FirstOrDefaultAsync(a => a.CompanyId == _companyId && a.Code == _employee.CostCenterCode);
        }

        // Read-only org/position display — sourced live from the active
        // slot (same query EmployeeDetail.razor uses), not from
        // Hremployee's own snapshot fields, so it self-heals even if the
        // snapshot were ever momentarily stale.
        _currentSlot = await context.Pos_PositionSlots.FirstOrDefaultAsync(s => s.HremployeeId == _employee.id && s.IsActive);
        if (_currentSlot?.OrganizationId is long orgId)
        {
            var org = await context.com_organizations.FirstOrDefaultAsync(o => o.id == orgId);
            _currentOrgLabel = org is null ? null : $"{org.code} — {org.name}";
        }
        else
        {
            _currentOrgLabel = null;
        }

        _separationType = SeparationType.VoluntaryResignation;
        _separationEffectiveDate = DateTime.Today;
        _separationReason = null;
        _separationError = null;

        _severanceError = null;
        _severancePreview = null;
        if (_employee.ResignDate is not null)
        {
            try
            {
                _severancePreview = await SeveranceService.PreviewAsync(_employee.id);
                _severanceAmount = _severancePreview.Amount;
                _severanceReason = string.Format(L.Translate("SeveranceReasonTemplate"), _severancePreview.TierDescription);
                _severanceTargetMonth = DateTime.Today;
            }
            catch (InvalidOperationException ex)
            {
                _severanceError = ex.Message;
            }
        }

        await LoadDocsAsync(context);
    }

    private async Task LoadDocsAsync(HRMContext context)
    {
        _docs = await context.Pay_EmployeeDocuments
            .Where(d => d.HremployeeId == Id)
            .OrderByDescending(d => d.UploadedDate)
            .ToListAsync();
    }

    private async Task SaveEmployeeAsync()
    {
        _formError = null;

        if (_employee is null || string.IsNullOrWhiteSpace(_employee.EmpName) || string.IsNullOrWhiteSpace(_employee.EmpSurname)
            || string.IsNullOrWhiteSpace(_formEmployeeEmail))
        {
            _formError = L.Translate("FillNameEmailError");
            return;
        }

        if (!EmployeeEmailResolver.IsValidFormat(_formEmployeeEmail))
        {
            _formError = L.Translate("InvalidEmailFormatError");
            return;
        }

        try
        {
            await using var context = await DbFactory.CreateDbContextAsync();
            var existing = await context.Hremployee.FirstOrDefaultAsync(e => e.id == Id && e.companyid == _companyId);
            if (existing is null)
            {
                _formError = L.Translate("EmployeeDataNotFoundError");
                return;
            }

            existing.PrenameCode = _employee.PrenameCode;
            existing.EmpName = _employee.EmpName;
            existing.EmpSurname = _employee.EmpSurname;
            var oldPosCode = existing.PosCode;
            var oldSalary = existing.SalaryAmt;

            existing.EmptypeCode = _employee.EmptypeCode;
            existing.DeptgrpCode = _employee.DeptgrpCode;
            existing.PosCode = _employee.PosCode;
            existing.CostCenterCode = _employee.CostCenterCode;
            existing.IdCard = _employee.IdCard;
            existing.SalaryAmt = _employee.SalaryAmt;
            existing.SalaryGradeId = _employee.SalaryGradeId;
            existing.SalexpBank = _employee.SalexpBank;
            existing.SalexpBranch = _employee.SalexpBranch;
            existing.SalexpAccid = _employee.SalexpAccid;
            existing.WorkDate = _workDate;
            existing.BirthDate = _birthDate;
            await context.SaveChangesAsync();
            await EmployeeEmailResolver.SetAsync(context, existing.id, _formEmployeeEmail!);

            // Auto-capture into ประวัติปรับตำแหน่ง/เงินเดือน — only when
            // position or salary actually changed, so a save that touches
            // unrelated fields doesn't create a spurious history row.
            if (oldPosCode != existing.PosCode || oldSalary != existing.SalaryAmt)
            {
                var state = await AuthProvider.GetAuthenticationStateAsync();
                var userIdClaim = state.User.FindFirstValue("sc_userid");
                var userId = long.TryParse(userIdClaim, out var uid) ? uid : (long?)null;

                context.Pay_PositionSalaryHistories.Add(new Pay_PositionSalaryHistory
                {
                    HremployeeId = existing.id,
                    EmpNo = existing.EmpNo,
                    CompanyId = existing.companyid,
                    OldPositionCode = oldPosCode,
                    NewPositionCode = existing.PosCode,
                    OldSalary = oldSalary,
                    NewSalary = existing.SalaryAmt,
                    ChangeType = string.IsNullOrWhiteSpace(_positionSalaryChangeType) ? null : _positionSalaryChangeType,
                    OrderNo = string.IsNullOrWhiteSpace(_positionSalaryOrderNo) ? null : _positionSalaryOrderNo,
                    OrderDate = DateTime.Today,
                    Reason = string.IsNullOrWhiteSpace(_positionSalaryReason) ? null : _positionSalaryReason,
                    ChangedByUserId = userId,
                });
                await context.SaveChangesAsync();
            }

            _employee = existing;
        }
        catch (DbUpdateException)
        {
            // Never let a DB-level failure bubble up as an unhandled
            // exception — that crashes the whole Blazor circuit.
            _formError = L.Translate("SaveFailedGenericError");
            return;
        }

        _editingCore = false;
        Snackbar.Add(L.Translate("DataSavedSuccessGeneric"), Severity.Success);
    }

    private async Task CancelEditCoreAsync()
    {
        // Discard any unsaved edits by simply reloading everything from the
        // DB — cheap and safe since OnParametersSetAsync is idempotent (same
        // pattern ConfirmResignAsync already relies on below).
        _formError = null;
        await OnParametersSetAsync();
        _editingCore = false;
    }

