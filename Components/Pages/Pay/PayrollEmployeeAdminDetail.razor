    private static Color ExpiryChipColor(DateOnly expiryDate)
    {
        var daysLeft = expiryDate.DayNumber - DateOnly.FromDateTime(DateTime.Today).DayNumber;
        if (daysLeft < 0) return Color.Error;
        if (daysLeft <= 30) return Color.Warning;
        return Color.Default;
    }
