@page "/pay/runs/{RunId:long}/employee/{EmployeeId:long}"
@using System.Security.Claims
@using HRM.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@attribute [Authorize(Policy = "Menu:PAY_RUNS")]

<PageTitle>รายละเอียดเงินเดือนพนักงาน</PageTitle>

@if (_forbidden)
{
    <MudAlert Severity="Severity.Error">รอบเงินเดือนนี้เป็นของบริษัทอื่น ไม่สามารถเข้าถึงได้</MudAlert>
}
else if (_employee is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => Navigation.NavigateTo($"/pay/runs/{RunId}"))" Class="mb-2">
        กลับไปหน้ารอบเงินเดือน
    </MudButton>

    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h5">@_employee.Hremployee?.EmpName @_employee.Hremployee?.EmpSurname (@_employee.EmpNo)</MudText>
        <MudText Typo="Typo.body2" Class="mt-1">
            สัดส่วนวันทำงาน @_employee.ActualWorkingDays/@_employee.WorkingDaysInPeriod (@(_employee.ProrationFactor.ToString("P2")))
        </MudText>

        <MudSimpleTable Class="mt-3" Dense="true">
            <tbody>
                <tr><td>รายรับรวม (Gross)</td><td class="text-right">@_employee.GrossEarnings.ToString("N2")</td></tr>
                <tr><td>รายหักรวม</td><td class="text-right">@_employee.TotalDeductions.ToString("N2")</td></tr>
                <tr><td><b>สุทธิ (Net Pay)</b></td><td class="text-right"><b>@_employee.NetPay.ToString("N2")</b></td></tr>
            </tbody>
        </MudSimpleTable>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" Class="mb-2">รายการย่อย</MudText>
        <MudTable Items="_lineItems" Dense="true">
            <HeaderContent>
                <MudTh>รายการ</MudTh>
                <MudTh>ประเภท</MudTh>
                <MudTh>จำนวนเงิน</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Pay_PayItemType.NameTh (@context.Pay_PayItemType.NameEn)</MudTd>
                <MudTd>@(context.SignFlag > 0 ? "รายรับ" : "รายหัก")</MudTd>
                <MudTd>@((context.SignFlag * context.Amount).ToString("N2"))</MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>

    @if (_anomalies.Count > 0)
    {
        <MudPaper Class="pa-4 mb-4">
            <MudText Typo="Typo.h6" Class="mb-2">ความผิดปกติที่ตรวจพบ (AI)</MudText>
            @foreach (var anomaly in _anomalies)
            {
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap" Spacing="2" Class="mb-2">
                    <div>
                        <MudChip T="string" Size="Size.Small" Color="@AnomalySeverityColor(anomaly.Severity)" Class="mr-1">@anomaly.Severity</MudChip>
                        @anomaly.Description
                        @if (anomaly.DetectedValue is not null)
                        {
                            <MudText Typo="Typo.caption" Class="d-block">
                                ค่าที่ตรวจพบ: @anomaly.DetectedValue.Value.ToString("N2")
                                @if (anomaly.ReferenceValue is not null)
                                {
                                    <text> · ค่าอ้างอิง: @anomaly.ReferenceValue.Value.ToString("N2")</text>
                                }
                            </MudText>
                        }
                        @if (anomaly.IsAcknowledged)
                        {
                            <MudText Typo="Typo.caption" Class="d-block">รับทราบแล้วเมื่อ @anomaly.AcknowledgedDate?.ToString("dd/MM/yyyy HH:mm")</MudText>
                        }
                    </div>
                    @if (!anomaly.IsAcknowledged)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => AcknowledgeAnomalyAsync(anomaly.Id))">รับทราบ</MudButton>
                    }
                </MudStack>
            }
        </MudPaper>
    }

    @if (_taxDetailJson is not null)
    {
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-2">รายละเอียดการคำนวณภาษี (Audit Trail)</MudText>
            <MudTextField Value="@_taxDetailJson" T="string" Lines="12" ReadOnly="true" Variant="Variant.Outlined" />
        </MudPaper>
    }
}

@code {
    [Parameter] public long RunId { get; set; }
    [Parameter] public long EmployeeId { get; set; }

    private Pay_PayrollEmployee? _employee;
    private bool _forbidden;
    private List<Pay_PayrollLineItem> _lineItems = new();
    private List<Pay_PayrollAnomaly> _anomalies = new();
    private string? _taxDetailJson;

    protected override async Task OnParametersSetAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();

        _employee = await context.Pay_PayrollEmployees
            .Include(e => e.Hremployee)
            .FirstOrDefaultAsync(e => e.Id == EmployeeId && e.PayrollRunId == RunId);
        if (_employee is null) return;

        var state = await AuthProvider.GetAuthenticationStateAsync();
        var companyId = state.User.FindFirstValue("payroll_company");
        if (_employee.CompanyId != companyId)
        {
            _forbidden = true;
            _employee = null;
            return;
        }

        _lineItems = await context.Pay_PayrollLineItems
            .Include(li => li.Pay_PayItemType)
            .Where(li => li.PayrollEmployeeId == EmployeeId)
            .OrderBy(li => li.SeqNo)
            .ToListAsync();

        _taxDetailJson = await context.Pay_PayrollAuditLogs
            .Where(a => a.PayrollRunId == RunId && a.PayrollEmployeeId == EmployeeId && a.EventType == PayAuditEventType.TaxCalculationDetail)
            .OrderByDescending(a => a.EventDate)
            .Select(a => a.DetailJson)
            .FirstOrDefaultAsync();

        _anomalies = await context.Pay_PayrollAnomalies
            .Where(a => a.PayrollEmployeeId == EmployeeId)
            .OrderByDescending(a => a.Severity)
            .ToListAsync();
    }

    private async Task AcknowledgeAnomalyAsync(long anomalyId)
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var anomaly = await context.Pay_PayrollAnomalies.FirstOrDefaultAsync(a => a.Id == anomalyId);
        if (anomaly is null) return;

        var state = await AuthProvider.GetAuthenticationStateAsync();
        var idClaim = state.User.FindFirstValue("sc_userid");

        anomaly.IsAcknowledged = true;
        anomaly.AcknowledgedByUserId = long.TryParse(idClaim, out var uid) ? uid : 0;
        anomaly.AcknowledgedDate = DateTime.Now;
        await context.SaveChangesAsync();

        await OnParametersSetAsync();
        Snackbar.Add("รับทราบแล้ว", Severity.Success);
    }

    private static Color AnomalySeverityColor(PayrollAnomalySeverity severity) => severity switch
    {
        PayrollAnomalySeverity.Info => Color.Info,
        PayrollAnomalySeverity.Warning => Color.Warning,
        PayrollAnomalySeverity.Critical => Color.Error,
        _ => Color.Default,
    };
}
