@page "/pay/runs/{RunId:long}/employee/{EmployeeId:long}"
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Pay
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject JsonLocalizationService L
@inject HRM.Services.Audit.IAuditLogger AuditLogger
@attribute [Authorize(Policy = "Menu:PAY_RUNS")]
@inject HRM.Services.Security.ProgramRoleService ProgramRoles

<PageTitle>@L.Translate("PayrollEmployeeDetailHeaderPageTitle")</PageTitle>
@if (_rights is not null && !_rights.CanEdit)
{
    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">หน้านี้ยังไม่ได้เปิดสิทธิ์แก้ไขให้บทบาทของคุณ — ดูได้อย่างเดียว</MudAlert>
}

@if (_forbidden)
{
    <MudAlert Severity="Severity.Error">@L.Translate("OtherCompanyForbiddenError")</MudAlert>
}
else if (_employee is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => Navigation.NavigateTo($"/pay/runs/{RunId}"))" Class="mb-2">
        @L.Translate("BackToPayrollRunButton")
    </MudButton>

    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h5">@_employee.Hremployee?.EmpName @_employee.Hremployee?.EmpSurname (@_employee.EmpNo)</MudText>
        <MudText Typo="Typo.body2" Class="mt-1">
            @string.Format(L.Translate("WorkDaysProportionTemplate"), _employee.ActualWorkingDays, _employee.WorkingDaysInPeriod, _employee.ProrationFactor.ToString("P2"))
        </MudText>

        <MudSimpleTable Class="mt-3" Dense="true">
            <tbody>
                <tr><td>@L.Translate("GrossEarningsRowLabel")</td><td class="text-right">@_employee.GrossEarnings.ToString("N2")</td></tr>
                <tr><td>@L.Translate("ColTotalDeductions")</td><td class="text-right">@_employee.TotalDeductions.ToString("N2")</td></tr>
                <tr><td><b>@L.Translate("NetPayBoldLabel")</b></td><td class="text-right"><b>@_employee.NetPay.ToString("N2")</b></td></tr>
            </tbody>
        </MudSimpleTable>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" Class="mb-2">@L.Translate("LineItemsHeading")</MudText>
        <MudTable Items="_displayRows" Dense="true">
            <HeaderContent>
                <MudTh>@L.Translate("ColItemName")</MudTh>
                <MudTh>@L.Translate("ColItemType")</MudTh>
                <MudTh>@L.Translate("ColAmount")</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    @context.LineItem.Pay_PayItemType.NameTh (@context.LineItem.Pay_PayItemType.NameEn)
                    @if (!context.IsCalculated)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Class="ml-2">@L.Translate("NoItemThisPeriodChip")</MudChip>
                    }
                </MudTd>
                <MudTd>@(context.LineItem.SignFlag > 0 ? L.Translate("EarningChip") : L.Translate("DeductionChip"))</MudTd>
                <MudTd>@((context.LineItem.SignFlag * context.LineItem.Amount).ToString("N2"))</MudTd>
                <MudTd>
                    <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Info" OnClick="@(() => ShowCalculationDetailAsync(context))">
                        @L.Translate("ViewCalculationLink")
                    </MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>

    @if (_anomalies.Count > 0)
    {
        <MudPaper Class="pa-4 mb-4">
            <MudText Typo="Typo.h6" Class="mb-2">@L.Translate("AnomaliesDetectedHeading")</MudText>
            @foreach (var anomaly in _anomalies)
            {
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap" Spacing="2" Class="mb-2">
                    <div>
                        <MudChip T="string" Size="Size.Small" Color="@AnomalySeverityColor(anomaly.Severity)" Class="mr-1">@anomaly.Severity</MudChip>
                        @anomaly.Description
                        @if (anomaly.DetectedValue is not null)
                        {
                            <MudText Typo="Typo.caption" Class="d-block">
                                @string.Format(L.Translate("DetectedValueTemplate"), anomaly.DetectedValue.Value.ToString("N2"))
                                @if (anomaly.ReferenceValue is not null)
                                {
                                    <text>@string.Format(L.Translate("ReferenceValueInlineTemplate"), anomaly.ReferenceValue.Value.ToString("N2"))</text>
                                }
                            </MudText>
                        }
                        @if (anomaly.IsAcknowledged)
                        {
                            <MudText Typo="Typo.caption" Class="d-block">@string.Format(L.Translate("AcknowledgedAtTemplate"), anomaly.AcknowledgedDate?.ToString("dd/MM/yyyy HH:mm"))</MudText>
                        }
                    </div>
                    @if (!anomaly.IsAcknowledged && _rights?.CanEdit == true)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => AcknowledgeAnomalyAsync(anomaly.Id))">@L.Translate("AcknowledgeButton")</MudButton>
                    }
                </MudStack>
            }
        </MudPaper>
    }

    <MudPaper Class="pa-4">
        <MudText Typo="Typo.h6" Class="mb-2">@L.Translate("TaxAuditTrailHeading")</MudText>
        @if (_taxDetailJson is not null)
        {
            @* อ่านได้ก่อน (ตัวเลขจริงของงวดนี้) — JSON ดิบพับไว้สำหรับผู้ตรวจ แสดงภาษาไทยเป็นตัวอักษร ไม่ใช่รหัส escape *@
            @if (_taxNarrativeHtml is not null)
            {
                <div class="mb-3">@((MarkupString)_taxNarrativeHtml)</div>
            }
            <details>
                <summary>@L.Translate("TaxAuditTrailRawJson")</summary>
                <MudTextField Value="@_taxDetailPretty" T="string" Lines="12" ReadOnly="true" Variant="Variant.Outlined" Class="mt-2" />
            </details>
        }
        else
        {
            <MudAlert Severity="Severity.Info">@L.Translate("TaxAuditTrailEmptyMessage")</MudAlert>
        }
    </MudPaper>
}

@code {
    [Parameter] public long RunId { get; set; }
    [Parameter] public long EmployeeId { get; set; }

    private Pay_PayrollEmployee? _employee;
    private bool _forbidden;
    private List<Pay_PayrollLineItem> _lineItems = new();
    private List<PayrollLineItemDisplayHelper.DisplayRow> _displayRows = new();
    private List<Pay_PayrollAnomaly> _anomalies = new();
    private string? _taxDetailJson;
    private string? _taxDetailPretty;
    private string? _taxNarrativeHtml;

    // Route has a parameter, so its sc_program_role row is keyed by the prefix before it.
    private const string ProgramPath = "/pay/runs";
    private HRM.Services.Security.ProgramRoleService.ProgramRights? _rights;

    private async Task<bool> RequireRightAsync(HRM.Services.Security.ProgramRoleService.ProgramAction action)
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        try { await ProgramRoles.RequireAsync(state.User, ProgramPath, action); return true; }
        catch (InvalidOperationException ex) { Snackbar.Add(ex.Message, Severity.Warning); return false; }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_rights is null)
        {
            var rightsState = await AuthProvider.GetAuthenticationStateAsync();
            _rights = await ProgramRoles.GetRightsAsync(rightsState.User, ProgramPath);
        }

        await using var context = await DbFactory.CreateDbContextAsync();

        _employee = await context.Pay_PayrollEmployees
            .Include(e => e.Hremployee)
            .FirstOrDefaultAsync(e => e.Id == EmployeeId && e.PayrollRunId == RunId);
        if (_employee is null) return;

        var state = await AuthProvider.GetAuthenticationStateAsync();
        var companyId = state.User.FindFirstValue("payroll_company");
        if (_employee.CompanyId != companyId)
        {
            _forbidden = true;
            _employee = null;
            return;
        }
        // PDPA: รายละเอียดเงินเดือนรายบุคคล — บันทึกการเปิดดู (audit M15)
        await AuditLogger.LogAccessAsync("Pay_PayrollEmployee", EmployeeId.ToString(), isSensitive: true, note: "view employee pay detail");

        _lineItems = await context.Pay_PayrollLineItems
            .Include(li => li.Pay_PayItemType)
            .Where(li => li.PayrollEmployeeId == EmployeeId)
            .OrderBy(li => li.SeqNo)
            .ToListAsync();

        var payItemTypes = await context.Pay_PayItemTypes.Where(t => t.IsActive).ToListAsync();
        _displayRows = PayrollLineItemDisplayHelper.BuildDisplayRows(_lineItems, payItemTypes);

        _taxDetailJson = await context.Pay_PayrollAuditLogs
            .Where(a => a.PayrollRunId == RunId && a.PayrollEmployeeId == EmployeeId && a.EventType == PayAuditEventType.TaxCalculationDetail)
            .OrderByDescending(a => a.EventDate)
            .Select(a => a.DetailJson)
            .FirstOrDefaultAsync();
        _taxDetailPretty = _taxDetailJson is null ? null : PrettyJson(_taxDetailJson);
        _taxNarrativeHtml = TaxCalculationNarrative.TryBuild(_taxDetailJson, out var narrative) ? narrative : null;

        _anomalies = await context.Pay_PayrollAnomalies
            .Where(a => a.PayrollEmployeeId == EmployeeId)
            .OrderByDescending(a => a.Severity)
            .ToListAsync();
    }

    private async Task AcknowledgeAnomalyAsync(long anomalyId)
    {
        if (!await RequireRightAsync(HRM.Services.Security.ProgramRoleService.ProgramAction.Edit)) return;
        await using var context = await DbFactory.CreateDbContextAsync();
        var anomaly = await context.Pay_PayrollAnomalies.FirstOrDefaultAsync(a => a.Id == anomalyId && a.PayrollRunId == RunId);
        if (anomaly is null) return;

        var state = await AuthProvider.GetAuthenticationStateAsync();
        var idClaim = state.User.FindFirstValue("sc_userid");

        anomaly.IsAcknowledged = true;
        anomaly.AcknowledgedByUserId = long.TryParse(idClaim, out var uid) ? uid : 0;
        anomaly.AcknowledgedDate = DateTime.Now;
        await context.SaveChangesAsync();

        await OnParametersSetAsync();
        Snackbar.Add(L.Translate("AcknowledgedSuccess"), Severity.Success);
    }

    private Task ShowCalculationDetailAsync(PayrollLineItemDisplayHelper.DisplayRow row)
    {
        var typeName = $"{row.LineItem.Pay_PayItemType.NameTh} ({row.LineItem.Pay_PayItemType.NameEn})";

        // ภาษีหัก ณ ที่จ่าย: กางตัวเลขจริงในกล่อง (เงินได้ทั้งปี → หัก → ฐานภาษี → ขั้นบันได → เฉลี่ยงวด)
        // แทนการชี้ไป JSON ดิบด้านล่าง ซึ่งคนทำเงินเดือนอ่านไม่ออก
        // ภาษีที่ได้ 0 ไม่มีบรรทัดภาษี แต่คำนวณแล้ว — แสดงเหตุผลว่าทำไมได้ 0 ไม่ใช่ "ยังไม่ได้คำนวณ" (ทดสอบหน้าจอ 26 ก.ย. 2569)
        if (row.LineItem.Pay_PayItemType.Code == "TAX" && _taxNarrativeHtml is not null)
            return DialogService.ShowMessageBox(typeName, (MarkupString)_taxNarrativeHtml, yesText: L.Translate("CloseButton"));

        var message = row.IsCalculated
            ? (string.IsNullOrWhiteSpace(row.LineItem.Description)
                ? string.Format(L.Translate("CalculationDetailAmountOnlyTemplate"), (row.LineItem.SignFlag * row.LineItem.Amount).ToString("N2"))
                : row.LineItem.Description!)
            : L.Translate("CalculationDetailNotCalculatedNote");

        return DialogService.ShowMessageBox(typeName, message, yesText: L.Translate("CloseButton"));
    }

    private static string PrettyJson(string json)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            return System.Text.Json.JsonSerializer.Serialize(doc.RootElement, new System.Text.Json.JsonSerializerOptions
            {
                WriteIndented = true,
                Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping,
            });
        }
        catch (System.Text.Json.JsonException)
        {
            return json;
        }
    }

    private static Color AnomalySeverityColor(PayrollAnomalySeverity severity) => severity switch
    {
        PayrollAnomalySeverity.Info => Color.Info,
        PayrollAnomalySeverity.Warning => Color.Warning,
        PayrollAnomalySeverity.Critical => Color.Error,
        _ => Color.Default,
    };
}
