@page "/pay/withholding-cert"
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Pay
@using HRM.Services.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject HRM.Services.EmailSender EmailSender
@inject HRM.Services.Audit.IAuditLogger AuditLogger
@inject ISnackbar Snackbar
@inject JsonLocalizationService L
@attribute [Authorize(Policy = "Menu:PAY_ADMIN")]

<PageTitle>@L.Translate("NavPayWithholdingCert")</PageTitle>

<MudPaper Class="pa-4 mb-4" MaxWidth="700px">
    <MudText Typo="Typo.h5">@L.Translate("WithholdingCertHeading")</MudText>
    <MudText Typo="Typo.body2" Class="mt-1">
        @L.Translate("WithholdingCertDesc")
    </MudText>

    @if (string.IsNullOrEmpty(_companyId))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">@L.Translate("CompanyNotLinkedError")</MudAlert>
        return;
    }

    <MudGrid Class="mt-3">
        <MudItem xs="12" sm="8">
            <MudAutocomplete T="Hremployee" Label="@L.Translate("EmployeeSearchLabel")" @bind-Value="_selectedEmployee"
                SearchFunc="SearchEmployeesAsync"
                ToStringFunc="@(e => e == null ? null : $"{e.EmpNo} — {e.EmpName} {e.EmpSurname}")"
                ResetValueOnEmptyText="true" CoerceText="true" MinCharacters="0" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudNumericField @bind-Value="_taxYear" Label="@L.Translate("TaxYearLabel")" Min="2000" Max="2100" />
        </MudItem>
    </MudGrid>

    <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="mt-3" OnClick="PreviewAsync">@L.Translate("PreviewTotalsButton")</MudButton>

    @if (!string.IsNullOrEmpty(_error))
    {
        <MudAlert Severity="Severity.Warning" Class="mt-3">@_error</MudAlert>
    }

    @if (_preview is not null)
    {
        <MudSimpleTable Dense="true" Class="mt-3">
            <tbody>
                <tr><td>@L.Translate("EmployeeLabel")</td><td>@_preview.EmployeeName</td></tr>
                <tr><td>@L.Translate("IdCardLabel")</td><td>@(_preview.IdCard ?? "-")</td></tr>
                <tr><td>@L.Translate("RegisteredAddressLabel")</td><td>@(_preview.RegisteredAddressBlock ?? "-")</td></tr>
                <tr><td>@L.Translate("TotalAnnualIncomeLabel")</td><td>@_preview.TotalTaxableIncome.ToString("N2")</td></tr>
                <tr><td>@L.Translate("TotalWithholdingTaxLabel")</td><td>@_preview.TotalTaxWithheld.ToString("N2")</td></tr>
                <tr><td>@L.Translate("TotalSocialSecurityLabel")</td><td>@_preview.TotalSocialSecurity.ToString("N2")</td></tr>
                <tr><td>@L.Translate("TotalProvidentFundLabel")</td><td>@_preview.TotalProvidentFund.ToString("N2")</td></tr>
            </tbody>
        </MudSimpleTable>

        <MudButton Color="Color.Secondary" Variant="Variant.Filled" Class="mt-3"
            Href="@($"/pay/files/withholding-cert/{_selectedEmployee!.id}/{_taxYear}")" Target="_blank">
            @L.Translate("DownloadPdfButton")
        </MudButton>

        @if (string.IsNullOrWhiteSpace(_selectedEmployeeEmail))
        {
            <MudAlert Severity="Severity.Warning" Class="mt-3" Dense="true">
                @L.Translate("NoEmployeeEmailWarningPrefix") <MudLink Href="/pay/employees">@L.Translate("EmpAdminHeading")</MudLink> @L.Translate("NoEmployeeEmailWarningSuffix")
            </MudAlert>
        }
        <MudButton Color="Color.Tertiary" Variant="Variant.Filled" Class="mt-3 ml-2"
            OnClick="SendEmailAsync" Disabled="@(string.IsNullOrWhiteSpace(_selectedEmployeeEmail) || _sending)">
            @L.Translate("SendEmailToEmployeeButton")
        </MudButton>

        @if (_sendHistory.Count > 0)
        {
            <MudText Typo="Typo.subtitle2" Class="mt-4">@L.Translate("SendHistoryHeading")</MudText>
            <MudSimpleTable Dense="true" Class="mt-1">
                <thead><tr><th>@L.Translate("DateTimeLabel")</th><th>@L.Translate("SentByLabel")</th><th>@L.Translate("NoteLabel")</th></tr></thead>
                <tbody>
                    @foreach (var log in _sendHistory)
                    {
                        <tr>
                            <td>@log.EventDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@(log.ActorName ?? "-")</td>
                            <td>@(log.Note ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    }
</MudPaper>

@code {
    private string? _companyId;
    private Hremployee? _selectedEmployee;
    private int _taxYear = DateTime.Today.Year;
    private WithholdingCertificateData? _preview;
    private string? _error;
    private string? _selectedEmployeeEmail;
    private bool _sending;
    private List<AuditLog> _sendHistory = new();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
    }

    private async Task<IEnumerable<Hremployee>> SearchEmployeesAsync(string search, CancellationToken ct)
    {
        await using var context = await DbFactory.CreateDbContextAsync(ct);
        var query = context.Hremployee.Where(e => e.companyid == _companyId);
        if (!string.IsNullOrWhiteSpace(search))
        {
            query = query.Where(e => e.EmpNo.Contains(search)
                || (e.EmpName != null && e.EmpName.Contains(search))
                || (e.EmpSurname != null && e.EmpSurname.Contains(search)));
        }
        return await query.OrderBy(e => e.EmpNo).Take(20).ToListAsync(ct);
    }

    private async Task PreviewAsync()
    {
        _error = null;
        _preview = null;

        if (_selectedEmployee is null)
        {
            _error = L.Translate("SelectEmployeeError");
            return;
        }

        await using var context = await DbFactory.CreateDbContextAsync();
        _preview = await WithholdingCertificateDataService.BuildAsync(context, _selectedEmployee.id, _taxYear);
        if (_preview is null)
        {
            _error = string.Format(L.Translate("NoApprovedPayrollForYearError"), _taxYear);
            return;
        }

        _selectedEmployeeEmail = await EmployeeEmailResolver.ResolveAsync(context, _selectedEmployee.id);
        await LoadSendHistoryAsync(context, $"{_selectedEmployee.id}:{_taxYear}");
    }

    private async Task LoadSendHistoryAsync(HRMContext context, string recordId)
    {
        _sendHistory = await context.AuditLogs
            .Where(a => a.EntityType == "WithholdingCertificateEmail" && a.RecordId == recordId)
            .OrderByDescending(a => a.EventDate)
            .Take(5)
            .ToListAsync();
    }

    private async Task SendEmailAsync()
    {
        if (_preview is null || _selectedEmployee is null || string.IsNullOrWhiteSpace(_selectedEmployeeEmail)) return;

        _sending = true;
        try
        {
            var bytes = WithholdingCertificatePdfService.Generate(_preview);
            var fileName = $"withholding_cert_{_selectedEmployee.EmpNo}_{_taxYear}.pdf";
            var subject = $"หนังสือรับรองหักภาษี ณ ที่จ่าย ปีภาษี {_taxYear}";
            var body = $"<p>เรียนคุณ {_preview.EmployeeName}</p><p>แนบหนังสือรับรองหักภาษี ณ ที่จ่าย (50 ทวิ) ปีภาษี {_taxYear} มาพร้อมนี้</p>";

            await EmailSender.SendEmailWithAttachmentAsync(_selectedEmployeeEmail!, subject, body, fileName, bytes);

            var recordId = $"{_selectedEmployee.id}:{_taxYear}";
            await AuditLogger.LogAccessAsync("WithholdingCertificateEmail", recordId, isSensitive: true,
                note: $"ส่งอีเมลไปที่ {_selectedEmployeeEmail}");

            await using var context = await DbFactory.CreateDbContextAsync();
            await LoadSendHistoryAsync(context, recordId);

            Snackbar.Add(string.Format(L.Translate("CertificateSentSuccessTemplate"), _selectedEmployeeEmail), Severity.Success);
        }
        catch (Exception ex)
        {
            Serilog.Log.Error(ex, "Withholding cert email send failed for employee {Id}, year {Year}", _selectedEmployee.id, _taxYear);
            Snackbar.Add(L.Translate("EmailSendFailed"), Severity.Error);
        }
        finally
        {
            _sending = false;
        }
    }
}
