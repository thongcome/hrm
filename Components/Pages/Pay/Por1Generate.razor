@page "/pay/por1"
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Pay
@using HRM.Services.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject HRM.Services.EmailSender EmailSender
@inject HRM.Services.Audit.IAuditLogger AuditLogger
@inject ISnackbar Snackbar
@attribute [Authorize(Policy = "Menu:PAY_ADMIN")]

<PageTitle>ภ.ง.ด.1 / ภ.ง.ด.1ก</PageTitle>

<MudPaper Class="pa-4 mb-4" MaxWidth="900px">
    <MudText Typo="Typo.h5">แบบยื่นภาษีเงินได้หัก ณ ที่จ่าย (ภ.ง.ด.1 / ภ.ง.ด.1ก)</MudText>
    <MudText Typo="Typo.body2" Class="mt-1">
        สรุปเงินได้และภาษีหัก ณ ที่จ่ายของพนักงานทั้งบริษัท — ภ.ง.ด.1 รายเดือน (ใช้นำส่งกรมสรรพากรทุกเดือน)
        และ ภ.ง.ด.1ก สรุปประจำปี (ใช้กระทบยอดปลายปี) นับเฉพาะงวดที่อนุมัติแล้วขึ้นไป
    </MudText>

    @if (string.IsNullOrEmpty(_companyId))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">บัญชีของคุณยังไม่ได้ผูกกับบริษัทใดๆ — ติดต่อแอดมินให้ตั้งค่า empid ก่อน</MudAlert>
        return;
    }

    <MudAlert Severity="Severity.Info" Class="mt-3" Icon="@Icons.Material.Filled.Info">
        เอกสารนี้เป็นเอกสารสรุปสำหรับใช้งานภายใน/ประกอบการยื่นแบบเท่านั้น
        การยื่นแบบจริงต่อกรมสรรพากร (รวมถึงไฟล์อิเล็กทรอนิกส์สำหรับ e-Filing) ต้องตรวจสอบรูปแบบและช่องทางล่าสุดจากกรมสรรพากรก่อนใช้งานจริงเสมอ
    </MudAlert>

    <MudGrid Class="mt-3">
        <MudItem xs="12" sm="8">
            <MudAutocomplete T="Hremployee" Label="พนักงานผู้รับเอกสาร (สำหรับส่งอีเมล)" Value="_selectedEmployee" ValueChanged="OnEmployeeSelected"
                SearchFunc="SearchEmployeesAsync"
                ToStringFunc="@(e => e == null ? null : $"{e.EmpNo} — {e.EmpName} {e.EmpSurname}")"
                ResetValueOnEmptyText="true" CoerceText="true" MinCharacters="0" Clearable="true"
                HelperText="เลือกพนักงานที่จะส่งเอกสารนี้ให้ทางอีเมล — ระบบจะส่งไปยังอีเมลตามข้อมูลพนักงานในระบบเท่านั้น" />
        </MudItem>
    </MudGrid>

    @if (_selectedEmployee is not null && string.IsNullOrWhiteSpace(_selectedEmployeeEmail))
    {
        <MudAlert Severity="Severity.Warning" Class="mt-2" Dense="true">
            พนักงานคนนี้ยังไม่มีอีเมลในระบบ — ไม่สามารถส่งอีเมลได้ กรุณาเพิ่มอีเมลที่หน้า <MudLink Href="/pay/employees">จัดการพนักงาน</MudLink> ก่อน
        </MudAlert>
    }

    <MudTabs Class="mt-4" Elevation="0" Rounded="true">
        <MudTabPanel Text="ภ.ง.ด.1 (รายเดือน)">
            <MudGrid Class="mt-2">
                <MudItem xs="12" sm="8">
                    <MudSelect T="string" Label="งวดเดือนภาษี" @bind-Value="_selectedPeriod">
                        @foreach (var p in _availablePeriods)
                        {
                            <MudSelectItem Value="@p">@FormatPeriod(p)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4" Class="d-flex align-center">
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="PreviewMonthlyAsync" Disabled="@(_selectedPeriod is null)">
                        ดูตัวอย่างยอดรวม
                    </MudButton>
                </MudItem>
            </MudGrid>

            @if (!string.IsNullOrEmpty(_monthlyError))
            {
                <MudAlert Severity="Severity.Warning" Class="mt-3">@_monthlyError</MudAlert>
            }

            @if (_monthlyPreview is not null)
            {
                <MudSimpleTable Dense="true" Class="mt-3">
                    <tbody>
                        <tr><td>งวดเดือนภาษี</td><td>@_monthlyPreview.PeriodStart.ToString("MM/yyyy")</td></tr>
                        <tr><td>จำนวนผู้มีเงินได้</td><td>@_monthlyPreview.Lines.Count คน</td></tr>
                        <tr><td>รวมเงินได้ (บาท)</td><td>@_monthlyPreview.TotalTaxableIncome.ToString("N2")</td></tr>
                        <tr><td>รวมภาษีหัก ณ ที่จ่าย (บาท)</td><td>@_monthlyPreview.TotalTaxWithheld.ToString("N2")</td></tr>
                    </tbody>
                </MudSimpleTable>

                <MudButton Color="Color.Secondary" Variant="Variant.Filled" Class="mt-3"
                    Href="@($"/pay/files/por1/monthly/{_companyId}/{_selectedPeriod}")" Target="_blank">
                    ดาวน์โหลด PDF (ภ.ง.ด.1)
                </MudButton>
                <MudButton Color="Color.Tertiary" Variant="Variant.Filled" Class="mt-3 ml-2"
                    OnClick="SendMonthlyEmailAsync" Disabled="@(_selectedEmployee is null || string.IsNullOrWhiteSpace(_selectedEmployeeEmail) || _sendingMonthly)">
                    ส่งอีเมลให้พนักงานที่เลือก
                </MudButton>

                @if (_monthlySendHistory.Count > 0)
                {
                    <MudText Typo="Typo.subtitle2" Class="mt-4">ประวัติการส่ง</MudText>
                    <MudSimpleTable Dense="true" Class="mt-1">
                        <thead><tr><th>วันที่-เวลา</th><th>ผู้ส่ง</th><th>หมายเหตุ</th></tr></thead>
                        <tbody>
                            @foreach (var log in _monthlySendHistory)
                            {
                                <tr>
                                    <td>@log.EventDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@(log.ActorName ?? "-")</td>
                                    <td>@(log.Note ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
            }
        </MudTabPanel>

        <MudTabPanel Text="ภ.ง.ด.1ก (สรุปประจำปี)">
            <MudGrid Class="mt-2">
                <MudItem xs="12" sm="8">
                    <MudSelect T="int" Label="ปีภาษี" @bind-Value="_selectedYear">
                        @foreach (var y in _availableYears)
                        {
                            <MudSelectItem Value="@y">@y</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4" Class="d-flex align-center">
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="PreviewAnnualAsync" Disabled="@(_selectedYear == 0)">
                        ดูตัวอย่างยอดรวม
                    </MudButton>
                </MudItem>
            </MudGrid>

            @if (!string.IsNullOrEmpty(_annualError))
            {
                <MudAlert Severity="Severity.Warning" Class="mt-3">@_annualError</MudAlert>
            }

            @if (_annualPreview is not null)
            {
                <MudSimpleTable Dense="true" Class="mt-3">
                    <tbody>
                        <tr><td>ปีภาษี</td><td>@_annualPreview.TaxYear</td></tr>
                        <tr><td>จำนวนผู้มีเงินได้ทั้งปี</td><td>@_annualPreview.Lines.Count คน</td></tr>
                        <tr><td>รวมเงินได้ทั้งปี (บาท)</td><td>@_annualPreview.TotalTaxableIncome.ToString("N2")</td></tr>
                        <tr><td>รวมภาษีหักทั้งปี (บาท)</td><td>@_annualPreview.TotalTaxWithheld.ToString("N2")</td></tr>
                    </tbody>
                </MudSimpleTable>

                <MudButton Color="Color.Secondary" Variant="Variant.Filled" Class="mt-3"
                    Href="@($"/pay/files/por1/annual/{_companyId}/{_selectedYear}")" Target="_blank">
                    ดาวน์โหลด PDF (ภ.ง.ด.1ก)
                </MudButton>
                <MudButton Color="Color.Tertiary" Variant="Variant.Filled" Class="mt-3 ml-2"
                    OnClick="SendAnnualEmailAsync" Disabled="@(_selectedEmployee is null || string.IsNullOrWhiteSpace(_selectedEmployeeEmail) || _sendingAnnual)">
                    ส่งอีเมลให้พนักงานที่เลือก
                </MudButton>

                @if (_annualSendHistory.Count > 0)
                {
                    <MudText Typo="Typo.subtitle2" Class="mt-4">ประวัติการส่ง</MudText>
                    <MudSimpleTable Dense="true" Class="mt-1">
                        <thead><tr><th>วันที่-เวลา</th><th>ผู้ส่ง</th><th>หมายเหตุ</th></tr></thead>
                        <tbody>
                            @foreach (var log in _annualSendHistory)
                            {
                                <tr>
                                    <td>@log.EventDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@(log.ActorName ?? "-")</td>
                                    <td>@(log.Note ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
            }
        </MudTabPanel>
    </MudTabs>
</MudPaper>

@code {
    private string? _companyId;
    private List<string> _availablePeriods = new();
    private List<int> _availableYears = new();

    private string? _selectedPeriod;
    private Por1MonthlyData? _monthlyPreview;
    private string? _monthlyError;

    private int _selectedYear;
    private Por1KorAnnualData? _annualPreview;
    private string? _annualError;

    private Hremployee? _selectedEmployee;
    private string? _selectedEmployeeEmail;
    private bool _sendingMonthly;
    private bool _sendingAnnual;
    private List<AuditLog> _monthlySendHistory = new();
    private List<AuditLog> _annualSendHistory = new();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
        if (string.IsNullOrEmpty(_companyId)) return;

        await using var context = await DbFactory.CreateDbContextAsync();
        var runs = await context.Pay_PayrollRuns
            .Where(r => r.CompanyId == _companyId && r.Status >= PayrollRunStatus.Approved)
            .Select(r => new { r.PayrollPeriod, Year = r.PeriodStart.Year })
            .ToListAsync();

        _availablePeriods = runs.Select(r => r.PayrollPeriod).Distinct().OrderByDescending(p => p).ToList();
        _availableYears = runs.Select(r => r.Year).Distinct().OrderByDescending(y => y).ToList();

        _selectedPeriod = _availablePeriods.FirstOrDefault();
        _selectedYear = _availableYears.FirstOrDefault();
    }

    private static string FormatPeriod(string yyyymm)
    {
        if (yyyymm.Length != 6 || !int.TryParse(yyyymm.AsSpan(0, 4), out var y) || !int.TryParse(yyyymm.AsSpan(4, 2), out var m))
            return yyyymm;
        return $"{m:00}/{y}";
    }

    private async Task PreviewMonthlyAsync()
    {
        _monthlyError = null;
        _monthlyPreview = null;
        if (_selectedPeriod is null) return;

        await using var context = await DbFactory.CreateDbContextAsync();
        _monthlyPreview = await Por1DataService.BuildMonthlyAsync(context, _companyId!, _selectedPeriod);
        if (_monthlyPreview is null)
            _monthlyError = "ไม่พบข้อมูลเงินเดือนที่มีภาษีหัก ณ ที่จ่ายในงวดนี้";
    }

    private async Task PreviewAnnualAsync()
    {
        _annualError = null;
        _annualPreview = null;
        if (_selectedYear == 0) return;

        await using var context = await DbFactory.CreateDbContextAsync();
        _annualPreview = await Por1DataService.BuildAnnualAsync(context, _companyId!, _selectedYear);
        if (_annualPreview is null)
            _annualError = $"ไม่พบข้อมูลเงินเดือนที่อนุมัติแล้วของบริษัทนี้ในปี {_selectedYear}";
    }

    private async Task<IEnumerable<Hremployee>> SearchEmployeesAsync(string search, CancellationToken ct)
    {
        await using var context = await DbFactory.CreateDbContextAsync(ct);
        var query = context.Hremployee.Where(e => e.companyid == _companyId);
        if (!string.IsNullOrWhiteSpace(search))
        {
            query = query.Where(e => e.EmpNo.Contains(search)
                || (e.EmpName != null && e.EmpName.Contains(search))
                || (e.EmpSurname != null && e.EmpSurname.Contains(search)));
        }
        return await query.OrderBy(e => e.EmpNo).Take(20).ToListAsync(ct);
    }

    private async Task OnEmployeeSelected(Hremployee? emp)
    {
        _selectedEmployee = emp;
        _selectedEmployeeEmail = null;
        _monthlySendHistory = new();
        _annualSendHistory = new();
        if (emp is null) return;

        await using var context = await DbFactory.CreateDbContextAsync();
        _selectedEmployeeEmail = await EmployeeEmailResolver.ResolveAsync(context, emp.id);
    }

    private async Task SendMonthlyEmailAsync()
    {
        if (_monthlyPreview is null || _selectedEmployee is null || string.IsNullOrWhiteSpace(_selectedEmployeeEmail) || _selectedPeriod is null) return;

        _sendingMonthly = true;
        try
        {
            var bytes = Por1PdfService.GenerateMonthly(_monthlyPreview);
            var fileName = $"por1_{_companyId}_{_selectedPeriod}.pdf";
            var subject = $"แบบภ.ง.ด.1 งวด {FormatPeriod(_selectedPeriod)}";
            var body = $"<p>แนบแบบภ.ง.ด.1 (รายเดือน) งวด {FormatPeriod(_selectedPeriod)} มาพร้อมนี้</p>";

            await EmailSender.SendEmailWithAttachmentAsync(_selectedEmployeeEmail!, subject, body, fileName, bytes);

            var recordId = $"{_companyId}:{_selectedPeriod}:{_selectedEmployee.id}";
            await AuditLogger.LogAccessAsync("Por1MonthlyEmail", recordId, isSensitive: true,
                note: $"ส่งอีเมลไปที่ {_selectedEmployeeEmail}");

            await using var context = await DbFactory.CreateDbContextAsync();
            _monthlySendHistory = await context.AuditLogs
                .Where(a => a.EntityType == "Por1MonthlyEmail" && a.RecordId == recordId)
                .OrderByDescending(a => a.EventDate).Take(5).ToListAsync();

            Snackbar.Add($"ส่งแบบภ.ง.ด.1 ไปที่ {_selectedEmployeeEmail} เรียบร้อย", Severity.Success);
        }
        catch (Exception ex)
        {
            Serilog.Log.Error(ex, "POR.1 monthly email send failed for company {CompanyId}, period {Period}", _companyId, _selectedPeriod);
            Snackbar.Add("ส่งอีเมลไม่สำเร็จ กรุณาลองใหม่อีกครั้ง", Severity.Error);
        }
        finally
        {
            _sendingMonthly = false;
        }
    }

    private async Task SendAnnualEmailAsync()
    {
        if (_annualPreview is null || _selectedEmployee is null || string.IsNullOrWhiteSpace(_selectedEmployeeEmail) || _selectedYear == 0) return;

        _sendingAnnual = true;
        try
        {
            var bytes = Por1PdfService.GenerateAnnual(_annualPreview);
            var fileName = $"por1kor_{_companyId}_{_selectedYear}.pdf";
            var subject = $"แบบภ.ง.ด.1ก ปีภาษี {_selectedYear}";
            var body = $"<p>แนบแบบภ.ง.ด.1ก (สรุปประจำปี) ปีภาษี {_selectedYear} มาพร้อมนี้</p>";

            await EmailSender.SendEmailWithAttachmentAsync(_selectedEmployeeEmail!, subject, body, fileName, bytes);

            var recordId = $"{_companyId}:{_selectedYear}:{_selectedEmployee.id}";
            await AuditLogger.LogAccessAsync("Por1AnnualEmail", recordId, isSensitive: true,
                note: $"ส่งอีเมลไปที่ {_selectedEmployeeEmail}");

            await using var context = await DbFactory.CreateDbContextAsync();
            _annualSendHistory = await context.AuditLogs
                .Where(a => a.EntityType == "Por1AnnualEmail" && a.RecordId == recordId)
                .OrderByDescending(a => a.EventDate).Take(5).ToListAsync();

            Snackbar.Add($"ส่งแบบภ.ง.ด.1ก ไปที่ {_selectedEmployeeEmail} เรียบร้อย", Severity.Success);
        }
        catch (Exception ex)
        {
            Serilog.Log.Error(ex, "POR.1 annual email send failed for company {CompanyId}, year {Year}", _companyId, _selectedYear);
            Snackbar.Add("ส่งอีเมลไม่สำเร็จ กรุณาลองใหม่อีกครั้ง", Severity.Error);
        }
        finally
        {
            _sendingAnnual = false;
        }
    }
}
