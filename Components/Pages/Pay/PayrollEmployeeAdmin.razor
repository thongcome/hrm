@page "/pay/employees"
@using System.Security.Claims
@using HRM.Data
@using HRM.Models
@using HRM.Services.Pay
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@using System.Text.RegularExpressions
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@inject PrivateFileStorage FileStorage
@inject HRM.Services.Pay.SeveranceService SeveranceService
@inject NavigationManager Nav
@inject HRM.Services.Audit.IAuditLogger AuditLogger
@inject IPasswordHasher<sc_user> PasswordHasher
@inject UserManager<ApplicationUser> UserManager
@inject Microsoft.AspNetCore.Identity.UI.Services.IEmailSender EmailSender
@attribute [Authorize(Policy = "Menu:PAY_ADMIN")]

<PageTitle>จัดการพนักงาน (Payroll)</PageTitle>

<MudPaper Class="pa-4 mb-4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.h5">จัดการพนักงาน (สำหรับงาน Payroll)</MudText>
        @if (!string.IsNullOrEmpty(_companyId))
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenCreate">+ เพิ่มพนักงาน</MudButton>
        }
    </MudStack>
    <MudText Typo="Typo.body2" Class="mt-1">
        หน้านี้จัดการเฉพาะข้อมูลพื้นฐานที่ใช้จริงในงาน Payroll (ไม่ใช่ระบบบุคคลากรเต็มรูปแบบ) — ข้อมูลอื่นๆ เช่นที่อยู่/ผู้ติดต่อฉุกเฉิน แก้ไขผ่านหน้า Employee เดิม
    </MudText>

    @if (string.IsNullOrEmpty(_companyId))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">บัญชีของคุณยังไม่ได้ผูกกับบริษัทใดๆ — ติดต่อแอดมินให้ตั้งค่า empid ก่อน</MudAlert>
        return;
    }

    <MudTextField @bind-Value="_searchTerm" Placeholder="ค้นหา รหัสหรือชื่อ" Adornment="Adornment.Start"
        AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Class="mt-4 mud-width-full" />

    <MudTable Items="@_employees" Dense="true" Hover="true" Elevation="0" Filter="EmpFilter" Class="mt-3">
        <HeaderContent>
            <MudTh>รหัสพนักงาน</MudTh>
            <MudTh>ชื่อ-นามสกุล</MudTh>
            <MudTh>แผนก/ตำแหน่ง</MudTh>
            <MudTh>เงินเดือน</MudTh>
            <MudTh>สถานะ</MudTh>
            <MudTh>บัญชีผู้ใช้ระบบ</MudTh>
            <MudTh>การดำเนินการ</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.EmpNo</MudTd>
            <MudTd>@context.EmpName @context.EmpSurname</MudTd>
            <MudTd>@context.DeptgrpCode / @context.PosCode</MudTd>
            <MudTd>@context.SalaryAmt?.ToString("N2")</MudTd>
            <MudTd>
                @if (context.ResignDate is not null)
                {
                    <MudChip T="string" Color="Color.Default" Size="Size.Small">ลาออกแล้ว (@context.ResignDate.Value.ToString("dd/MM/yyyy"))</MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Small">ทำงานอยู่</MudChip>
                }
            </MudTd>
            <MudTd>
                @if (_linkedUsers.TryGetValue(context.EmpNo, out var linkedUser))
                {
                    <MudChip T="string" Color="@(linkedUser.isdisable ? Color.Default : Color.Success)" Size="Size.Small">@linkedUser.loginname</MudChip>
                    <MudIconButton Icon="@Icons.Material.Filled.Key" Size="Size.Small" Title="รีเซ็ตรหัสผ่าน" OnClick="@(() => OpenResetPasswordAsync(context))" />
                }
                else
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => OpenUserAccount(context))">สร้างบัญชีผู้ใช้</MudButton>
                }
            </MudTd>
            <MudTd>
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => OpenEditAsync(context))">แก้ไข</MudButton>
                @if (context.ResignDate is null)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Warning" OnClick="@(() => OpenResign(context))">ลงวันที่ลาออก</MudButton>
                }
                else
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary" OnClick="@(() => OpenSeveranceAsync(context))">คำนวณค่าชดเชย</MudButton>
                }
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => OpenDocsAsync(context))">เอกสาร</MudButton>
            </MudTd>
        </RowTemplate>
    </MudTable>

    @if (_formEmployee is not null)
    {
        <MudPaper Class="pa-4 mt-4" Outlined="true">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h6">@(_isCreating ? "เพิ่มพนักงานใหม่" : $"แก้ไขพนักงาน — {_formEmployee.EmpNo}")</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => _formEmployee = null)" />
            </MudStack>

            <MudGrid Class="mt-2">
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="_formEmployee.EmpNo" Label="รหัสพนักงาน" Required="true"
                        ReadOnly="@(!_isCreating || !_empNoUnlocked)"
                        Adornment="@(_isCreating && !_empNoUnlocked ? Adornment.End : Adornment.None)"
                        AdornmentIcon="@Icons.Material.Filled.Edit" AdornmentColor="Color.Default"
                        OnAdornmentClick="@(() => _empNoUnlocked = true)"
                        HelperText="@(_isCreating && !_empNoUnlocked ? "สร้างอัตโนมัติ — กดไอคอนเพื่อแก้ไขเอง" : null)" />
                </MudItem>
                <MudItem xs="12" sm="2">
                    <MudTextField @bind-Value="_formEmployee.PrenameCode" Label="คำนำหน้า" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudTextField @bind-Value="_formEmployee.EmpName" Label="ชื่อ" Required="true" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudTextField @bind-Value="_formEmployee.EmpSurname" Label="นามสกุล" Required="true" />
                </MudItem>

                <MudItem xs="12" sm="4">
                    <MudSelect T="string" @bind-Value="_formEmployee.EmptypeCode" Label="ประเภทพนักงาน">
                        <MudSelectItem T="string" Value="@("01")">พนักงานประจำ</MudSelectItem>
                        <MudSelectItem T="string" Value="@("02")">พนักงานชั่วคราว</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="_formEmployee.DeptgrpCode" Label="แผนก" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="_formEmployee.PosCode" Label="ตำแหน่ง" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="_formEmployee.CostCenterCode" Label="รหัสศูนย์ต้นทุน (Cost Center)"
                        HelperText="ใช้แยกค่าใช้จ่ายเงินเดือนตามหน่วยงานในแดชบอร์ด" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect T="long?" Value="_formEmployee.OrganizationId" ValueChanged="OnOrganizationSelected"
                        Label="หน่วยงาน (ผังองค์กร)" Clearable="true"
                        HelperText="@(string.IsNullOrEmpty(_formEmployee.orgcodefull) ? null : $"รหัสเต็ม: {_formEmployee.orgcodefull}")">
                        @foreach (var org in _organizations)
                        {
                            <MudSelectItem T="long?" Value="@((long?)org.id)">@org.code — @org.name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="4">
                    <MudDatePicker @bind-Date="_workDate" Label="วันเริ่มงาน" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudDatePicker @bind-Date="_birthDate" Label="วันเกิด" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="_formEmployee.IdCard" Label="เลขบัตรประชาชน" />
                </MudItem>

                <MudItem xs="12" sm="4">
                    <MudNumericField @bind-Value="_formEmployee.SalaryAmt" Label="เงินเดือน" Format="N2" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="_formEmployee.SalexpBank" Label="รหัสธนาคาร" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="_formEmployee.SalexpBranch" Label="รหัสสาขา" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="_formEmployee.SalexpAccid" Label="เลขบัญชี" />
                </MudItem>
            </MudGrid>

            @if (!string.IsNullOrEmpty(_formError))
            {
                <MudAlert Severity="Severity.Error" Class="mt-3">@_formError</MudAlert>
            }

            <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="mt-4" OnClick="SaveEmployeeAsync">บันทึก</MudButton>
        </MudPaper>
    }

    @if (_resignEmployee is not null)
    {
        <MudPaper Class="pa-4 mt-4" Outlined="true">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h6">ลงวันที่ลาออก — @_resignEmployee.EmpNo @_resignEmployee.EmpName @_resignEmployee.EmpSurname</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => _resignEmployee = null)" />
            </MudStack>
            <MudDatePicker @bind-Date="_resignDate" Label="วันที่ลาออก" Class="mt-2" />
            @if (!string.IsNullOrEmpty(_resignError))
            {
                <MudAlert Severity="Severity.Error" Class="mt-2">@_resignError</MudAlert>
            }
            <MudButton Color="Color.Warning" Variant="Variant.Filled" Class="mt-3" OnClick="ConfirmResignAsync">ยืนยันลงวันที่ลาออก</MudButton>
        </MudPaper>
    }

    @if (_severanceEmployee is not null)
    {
        <MudPaper Class="pa-4 mt-4" Outlined="true">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h6">คำนวณค่าชดเชย — @_severanceEmployee.EmpNo @_severanceEmployee.EmpName @_severanceEmployee.EmpSurname</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => _severanceEmployee = null)" />
            </MudStack>

            @if (!string.IsNullOrEmpty(_severanceError))
            {
                <MudAlert Severity="Severity.Error" Class="mt-3">@_severanceError</MudAlert>
            }

            @if (_severancePreview is not null)
            {
                <MudAlert Severity="Severity.Warning" Class="mt-3">
                    ตรวจสอบก่อนว่าการเลิกจ้างเข้าข่ายข้อยกเว้นตามมาตรา 119 หรือไม่ (เช่น ทุจริต ฝ่าฝืนระเบียบร้ายแรง) หากเข้าข่ายข้อยกเว้น ไม่ต้องยื่นรายการนี้
                </MudAlert>

                <MudSimpleTable Dense="true" Class="mt-3">
                    <tbody>
                        <tr><td>อายุงาน</td><td>@_severancePreview.ContinuousServiceDays วัน</td></tr>
                        <tr><td>เกณฑ์ที่เข้าเงื่อนไข</td><td>@_severancePreview.TierDescription</td></tr>
                        <tr><td>จำนวนวันที่ได้รับ</td><td>@_severancePreview.EntitledDays วัน</td></tr>
                        <tr><td>ค่าจ้างต่อวัน</td><td>@_severancePreview.DailyWage.ToString("N2")</td></tr>
                        <tr><td>ยอดค่าชดเชยตามกฎหมาย (ขั้นต่ำ)</td><td>@_severancePreview.Amount.ToString("N2")</td></tr>
                    </tbody>
                </MudSimpleTable>

                <MudGrid Class="mt-3">
                    <MudItem xs="12" sm="4">
                        <MudDatePicker @bind-Date="_severanceTargetMonth" Label="งวดที่จะจ่าย" Editable="true" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudNumericField @bind-Value="_severanceAmount" Label="จำนวนเงินที่จะยื่น" Format="N2" />
                    </MudItem>
                </MudGrid>
                <MudTextField @bind-Value="_severanceReason" Label="เหตุผล" Lines="2" Class="mt-2" />

                <MudButton Color="Color.Secondary" Variant="Variant.Filled" Class="mt-3" OnClick="SubmitSeveranceAsync">ยื่นค่าชดเชย</MudButton>
            }
        </MudPaper>
    }

    @if (_docsEmployee is not null)
    {
        <MudPaper Class="pa-4 mt-4" Outlined="true">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h6">เอกสาร — @_docsEmployee.EmpNo @_docsEmployee.EmpName @_docsEmployee.EmpSurname</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => _docsEmployee = null)" />
            </MudStack>

            <MudSimpleTable Dense="true" Class="mt-2">
                <thead>
                    <tr><th>ประเภท</th><th>ชื่อไฟล์</th><th>วันที่อัปโหลด</th><th></th></tr>
                </thead>
                <tbody>
                    @if (_docs.Count == 0)
                    {
                        <tr><td colspan="4"><MudText Typo="Typo.caption">ยังไม่มีเอกสารแนบ</MudText></td></tr>
                    }
                    @foreach (var doc in _docs)
                    {
                        <tr>
                            <td>@DocTypeLabel(doc.DocumentType)</td>
                            <td>@doc.FileName</td>
                            <td>@doc.UploadedDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td><MudLink Href="@($"/pay/files/employee-doc/{doc.Id}")" Target="_blank">ดาวน์โหลด</MudLink></td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>

            <MudGrid Class="mt-3">
                <MudItem xs="12" sm="4">
                    <MudSelect T="Pay_EmployeeDocumentType" @bind-Value="_uploadDocType" Label="ประเภทเอกสาร">
                        <MudSelectItem T="Pay_EmployeeDocumentType" Value="Pay_EmployeeDocumentType.IdCard">บัตรประชาชน</MudSelectItem>
                        <MudSelectItem T="Pay_EmployeeDocumentType" Value="Pay_EmployeeDocumentType.Contract">สัญญาจ้าง</MudSelectItem>
                        <MudSelectItem T="Pay_EmployeeDocumentType" Value="Pay_EmployeeDocumentType.EducationCertificate">วุฒิการศึกษา</MudSelectItem>
                        <MudSelectItem T="Pay_EmployeeDocumentType" Value="Pay_EmployeeDocumentType.ResignationLetter">ใบลาออก</MudSelectItem>
                        <MudSelectItem T="Pay_EmployeeDocumentType" Value="Pay_EmployeeDocumentType.BankBook">สมุดบัญชีธนาคาร</MudSelectItem>
                        <MudSelectItem T="Pay_EmployeeDocumentType" Value="Pay_EmployeeDocumentType.Other">อื่นๆ</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudFileUpload T="IBrowserFile" FilesChanged="OnFileSelected">
                        <ActivatorContent>
                            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AttachFile">
                                @(_uploadFile?.Name ?? "เลือกไฟล์")
                            </MudButton>
                        </ActivatorContent>
                    </MudFileUpload>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="UploadDocAsync" Disabled="_uploadFile is null">อัปโหลด</MudButton>
                </MudItem>
            </MudGrid>

            @if (!string.IsNullOrEmpty(_docError))
            {
                <MudAlert Severity="Severity.Error" Class="mt-2">@_docError</MudAlert>
            }
        </MudPaper>
    }

    @if (_userAccountEmployee is not null)
    {
        <MudPaper Class="pa-4 mt-4" Outlined="true">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h6">สร้างบัญชีผู้ใช้ระบบ — @_userAccountEmployee.EmpNo @_userAccountEmployee.EmpName @_userAccountEmployee.EmpSurname</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => _userAccountEmployee = null)" />
            </MudStack>
            <MudText Typo="Typo.body2" Class="mt-1">
                ใช้รหัสพนักงาน (@_userAccountEmployee.EmpNo) เป็นทั้งตัวผูกกับพนักงานคนนี้และเป็นชื่อเข้าสู่ระบบ (login)
            </MudText>

            <MudGrid Class="mt-2">
                <MudItem xs="12" sm="4">
                    <MudTextField Value="@_userAccountEmployee.EmpNo" Label="ชื่อเข้าสู่ระบบ (login)" ReadOnly="true" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField Value="@_userAccountEmployee.EmpName" Label="ชื่อ" ReadOnly="true" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField Value="@_userAccountEmployee.EmpSurname" Label="นามสกุล" ReadOnly="true" />
                </MudItem>
                <MudItem xs="12" sm="8">
                    <MudTextField @bind-Value="_userAccountEmail" Label="อีเมล (สำหรับส่งรหัสผ่านเริ่มต้น — เว้นว่างได้)" />
                </MudItem>
            </MudGrid>

            <MudText Typo="Typo.subtitle1" Class="mt-4 mb-1">กรุณาเลือกกลุ่มผู้ใช้ (Role)</MudText>
            <MudGrid>
                @foreach (var role in _userAccountRoles)
                {
                    <MudItem xs="12" sm="4">
                        <MudCheckBox T="bool" Value="@_selectedUserAccountRoleIds.Contains(role.roleid)"
                            ValueChanged="@((bool v) => ToggleUserAccountRole(role.roleid, v))"
                            Label="@($"{role.abbr} - {role.name}")" />
                    </MudItem>
                }
            </MudGrid>

            @if (!string.IsNullOrEmpty(_userAccountError))
            {
                <MudAlert Severity="Severity.Error" Class="mt-3">@_userAccountError</MudAlert>
            }
            @if (!string.IsNullOrEmpty(_userAccountInfo))
            {
                <MudAlert Severity="Severity.Success" Class="mt-3">@_userAccountInfo</MudAlert>
            }

            @if (string.IsNullOrEmpty(_userAccountInfo))
            {
                <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="mt-4" OnClick="CreateUserAccountAsync">สร้างบัญชีผู้ใช้</MudButton>
            }
        </MudPaper>
    }

    @if (_resetPasswordEmployee is not null)
    {
        <MudPaper Class="pa-4 mt-4" Outlined="true">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h6">รีเซ็ตรหัสผ่าน — @_resetPasswordEmployee.EmpNo @_resetPasswordEmployee.EmpName @_resetPasswordEmployee.EmpSurname</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => _resetPasswordEmployee = null)" />
            </MudStack>
            <MudText Typo="Typo.body2" Class="mt-1">
                จะตั้งรหัสผ่านกลับไปเป็นรหัสผ่านเริ่มต้นของบริษัท (ตั้งค่าได้ที่ /pay/admin/payslip-settings)
            </MudText>

            <MudTextField @bind-Value="_resetPasswordEmail" Label="อีเมล (สำหรับส่งรหัสผ่านใหม่ — เว้นว่างได้)" Class="mt-2" />

            @if (!string.IsNullOrEmpty(_resetPasswordError))
            {
                <MudAlert Severity="Severity.Error" Class="mt-3">@_resetPasswordError</MudAlert>
            }
            @if (!string.IsNullOrEmpty(_resetPasswordInfo))
            {
                <MudAlert Severity="Severity.Success" Class="mt-3">@_resetPasswordInfo</MudAlert>
            }

            @if (string.IsNullOrEmpty(_resetPasswordInfo))
            {
                <MudButton Color="Color.Warning" Variant="Variant.Filled" Class="mt-4" OnClick="ConfirmResetPasswordAsync">ยืนยันรีเซ็ตรหัสผ่าน</MudButton>
            }
        </MudPaper>
    }
</MudPaper>

@code {
    private string? _companyId;
    private List<Hremployee> _employees = new();
    private string _searchTerm = string.Empty;

    private Hremployee? _formEmployee;
    private bool _isCreating;
    private bool _empNoUnlocked;
    private string? _formError;
    private DateTime? _workDate;
    private DateTime? _birthDate;

    private Hremployee? _resignEmployee;
    private DateTime? _resignDate = DateTime.Today;
    private string? _resignError;

    private Hremployee? _severanceEmployee;
    private HRM.Services.Pay.Calculators.SeveranceCalculator.SeveranceResult? _severancePreview;
    private DateTime? _severanceTargetMonth = DateTime.Today;
    private decimal _severanceAmount;
    private string _severanceReason = string.Empty;
    private string? _severanceError;

    private Hremployee? _docsEmployee;
    private List<Pay_EmployeeDocument> _docs = new();
    private Pay_EmployeeDocumentType _uploadDocType = Pay_EmployeeDocumentType.Other;
    private IBrowserFile? _uploadFile;
    private string? _docError;

    private Dictionary<string, sc_user> _linkedUsers = new();
    private Hremployee? _userAccountEmployee;
    private List<sc_role> _userAccountRoles = new();
    private HashSet<long> _selectedUserAccountRoleIds = new();
    private string? _userAccountEmail;
    private string? _userAccountError;
    private string? _userAccountInfo;

    private Hremployee? _resetPasswordEmployee;
    private string? _resetPasswordEmail;
    private string? _resetPasswordError;
    private string? _resetPasswordInfo;

    private List<com_organization> _organizations = new();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
        if (string.IsNullOrWhiteSpace(_companyId)) return;

        await using (var context = await DbFactory.CreateDbContextAsync())
        {
