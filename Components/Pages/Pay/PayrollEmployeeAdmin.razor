@page "/pay/employees"
@using System.Security.Claims
@using HRM.Data
@using HRM.Models
@using HRM.Services.Pay
@using HRM.Services.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@using System.Text.RegularExpressions
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IPasswordHasher<sc_user> PasswordHasher
@inject UserManager<ApplicationUser> UserManager
@inject Microsoft.AspNetCore.Identity.UI.Services.IEmailSender EmailSender
@inject JsonLocalizationService L
@attribute [Authorize(Policy = "Menu:PAY_ADMIN")]

<PageTitle>@L.Translate("EmpAdminPageTitle")</PageTitle>

<MudPaper Class="pa-4 mb-4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.h5">@L.Translate("EmpAdminHeading")</MudText>
        @if (!string.IsNullOrEmpty(_companyId))
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenCreate">+ @L.Translate("EmpAdminAddButton")</MudButton>
        }
    </MudStack>
    <MudText Typo="Typo.body2" Class="mt-1">
        @L.Translate("EmpAdminDesc")
    </MudText>

    @if (string.IsNullOrEmpty(_companyId))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">@L.Translate("CompanyNotLinkedError")</MudAlert>
        return;
    }

    <MudTextField @bind-Value="_searchTerm" Placeholder="@L.Translate("SearchByCodeOrNamePlaceholder")" Adornment="Adornment.Start"
        AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Class="mt-4 mud-width-full" />

    <MudTable Items="@_employees" Dense="true" Hover="true" Elevation="0" Filter="EmpFilter" Class="mt-3">
        <HeaderContent>
            <MudTh>@L.Translate("EmpNoLabel")</MudTh>
            <MudTh>@L.Translate("FieldFullName")</MudTh>
            <MudTh>@L.Translate("ColDeptPosition")</MudTh>
            <MudTh>@L.Translate("SalaryLabel")</MudTh>
            <MudTh>@L.Translate("ColStatus")</MudTh>
            <MudTh>@L.Translate("ColUserAccount")</MudTh>
            <MudTh>@L.Translate("ColActions")</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.EmpNo</MudTd>
            <MudTd>@context.EmpName @context.EmpSurname</MudTd>
            <MudTd>@context.DeptgrpCode / @context.PosCode</MudTd>
            <MudTd>@context.SalaryAmt?.ToString("N2")</MudTd>
            <MudTd>
                @if (context.ResignDate is not null)
                {
                    <MudChip T="string" Color="Color.Default" Size="Size.Small">@string.Format(L.Translate("ResignedChipTemplate"), context.ResignDate.Value.ToString("dd/MM/yyyy"))</MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Small">@L.Translate("ActiveChip")</MudChip>
                }
            </MudTd>
            <MudTd>
                @if (_linkedUsers.TryGetValue(context.EmpNo, out var linkedUser))
                {
                    <MudChip T="string" Color="@(linkedUser.isdisable ? Color.Default : Color.Success)" Size="Size.Small">@linkedUser.loginname</MudChip>
                    <MudIconButton Icon="@Icons.Material.Filled.Key" Size="Size.Small" Title="@L.Translate("ResetPasswordLabel")" OnClick="@(() => OpenResetPasswordAsync(context))" />
                }
                else
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => OpenUserAccount(context))">@L.Translate("CreateUserAccountButton")</MudButton>
                }
            </MudTd>
            <MudTd>
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                    EndIcon="@Icons.Material.Filled.ChevronRight"
                    OnClick="@(() => Nav.NavigateTo($"/pay/employees/{context.id}"))">@L.Translate("DescriptionLabel")</MudButton>
            </MudTd>
        </RowTemplate>
    </MudTable>

    @if (_formEmployee is not null)
    {
        <MudPaper Class="pa-4 mt-4" Outlined="true">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h6">@L.Translate("AddNewEmployeeHeading")</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => _formEmployee = null)" />
            </MudStack>

            <EmployeeCoreFieldsForm Employee="_formEmployee" IsCreating="true" EmpNoUnlocked="_empNoUnlocked" EmpNoUnlockedChanged="@(v => _empNoUnlocked = v)"
                CompanyId="@(_companyId!)"
                Email="@_formEmployeeEmail" EmailChanged="@(v => _formEmployeeEmail = v)"
                WorkDate="_workDate" WorkDateChanged="@(v => _workDate = v)"
                BirthDate="_birthDate" BirthDateChanged="@(v => _birthDate = v)"
                SalaryGrades="_salaryGrades"
                SelectedCostCenter="_selectedCostCenter" SelectedCostCenterChanged="@(v => _selectedCostCenter = v)"
                CurrentSlot="_currentSlot" CurrentOrgLabel="@_currentOrgLabel" />

            @if (!string.IsNullOrEmpty(_formError))
            {
                <MudAlert Severity="Severity.Error" Class="mt-3">@_formError</MudAlert>
            }

            <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="mt-4" OnClick="SaveEmployeeAsync">@L.Translate("Save")</MudButton>
        </MudPaper>
    }

    @if (_userAccountEmployee is not null)
    {
        <MudPaper Class="pa-4 mt-4" Outlined="true">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h6">@string.Format(L.Translate("CreateUserAccountHeadingTemplate"), _userAccountEmployee.EmpNo, _userAccountEmployee.EmpName, _userAccountEmployee.EmpSurname)</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => _userAccountEmployee = null)" />
            </MudStack>
            <MudText Typo="Typo.body2" Class="mt-1">
                @string.Format(L.Translate("CreateUserAccountDesc"), _userAccountEmployee.EmpNo)
            </MudText>

            <MudGrid Class="mt-2">
                <MudItem xs="12" sm="4">
                    <MudTextField Value="@_userAccountEmployee.EmpNo" Label="@L.Translate("LoginNameLabel")" ReadOnly="true" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField Value="@_userAccountEmployee.EmpName" Label="@L.Translate("FirstNameLabel")" ReadOnly="true" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField Value="@_userAccountEmployee.EmpSurname" Label="@L.Translate("LastNameLabel")" ReadOnly="true" />
                </MudItem>
                <MudItem xs="12" sm="8">
                    <MudTextField @bind-Value="_userAccountEmail" Label="@L.Translate("EmailForInitialPasswordLabel")" />
                </MudItem>
            </MudGrid>

            <MudText Typo="Typo.subtitle1" Class="mt-4 mb-1">@L.Translate("SelectRoleHeading")</MudText>
            <MudGrid>
                @foreach (var role in _userAccountRoles)
                {
                    <MudItem xs="12" sm="4">
                        <MudCheckBox T="bool" Value="@_selectedUserAccountRoleIds.Contains(role.roleid)"
                            ValueChanged="@((bool v) => ToggleUserAccountRole(role.roleid, v))"
                            Label="@($"{role.abbr} - {role.name}")" />
                    </MudItem>
                }
            </MudGrid>

            @if (!string.IsNullOrEmpty(_userAccountError))
            {
                <MudAlert Severity="Severity.Error" Class="mt-3">@_userAccountError</MudAlert>
            }
            @if (!string.IsNullOrEmpty(_userAccountInfo))
            {
                <MudAlert Severity="Severity.Success" Class="mt-3">@_userAccountInfo</MudAlert>
            }

            @if (string.IsNullOrEmpty(_userAccountInfo))
            {
                <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="mt-4" OnClick="CreateUserAccountAsync">@L.Translate("CreateUserAccountButton")</MudButton>
            }
        </MudPaper>
    }

    @if (_resetPasswordEmployee is not null)
    {
        <MudPaper Class="pa-4 mt-4" Outlined="true">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h6">@string.Format(L.Translate("ResetPasswordHeadingTemplate"), _resetPasswordEmployee.EmpNo, _resetPasswordEmployee.EmpName, _resetPasswordEmployee.EmpSurname)</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => _resetPasswordEmployee = null)" />
            </MudStack>
            <MudText Typo="Typo.body2" Class="mt-1">
                @L.Translate("ResetPasswordDesc")
            </MudText>

            <MudTextField @bind-Value="_resetPasswordEmail" Label="@L.Translate("EmailForNewPasswordLabel")" Class="mt-2" />

            @if (!string.IsNullOrEmpty(_resetPasswordError))
            {
                <MudAlert Severity="Severity.Error" Class="mt-3">@_resetPasswordError</MudAlert>
            }
            @if (!string.IsNullOrEmpty(_resetPasswordInfo))
            {
                <MudAlert Severity="Severity.Success" Class="mt-3">@_resetPasswordInfo</MudAlert>
            }

            @if (string.IsNullOrEmpty(_resetPasswordInfo))
            {
                <MudButton Color="Color.Warning" Variant="Variant.Filled" Class="mt-4" OnClick="ConfirmResetPasswordAsync">@L.Translate("ConfirmResetPasswordButton")</MudButton>
            }
        </MudPaper>
    }
</MudPaper>

@code {
    private string? _companyId;
    private List<Hremployee> _employees = new();
    private string _searchTerm = string.Empty;

    private Hremployee? _formEmployee;
    private bool _empNoUnlocked;
    private string? _formError;
    private DateTime? _workDate;
    private DateTime? _birthDate;
    private string? _formEmployeeEmail;

    private Dictionary<string, sc_user> _linkedUsers = new();
    private Hremployee? _userAccountEmployee;
    private List<sc_role> _userAccountRoles = new();
    private HashSet<long> _selectedUserAccountRoleIds = new();
    private string? _userAccountEmail;
    private string? _userAccountError;
    private string? _userAccountInfo;

    private Hremployee? _resetPasswordEmployee;
    private string? _resetPasswordEmail;
    private string? _resetPasswordError;
    private string? _resetPasswordInfo;

    private Com_ChartOfAccount? _selectedCostCenter;
    private List<Pay_SalaryGrade> _salaryGrades = new();
    private Pos_PositionSlot? _currentSlot;
    private string? _currentOrgLabel;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
        if (string.IsNullOrWhiteSpace(_companyId)) return;

        await using (var context = await DbFactory.CreateDbContextAsync())
        {
            _salaryGrades = await context.Pay_SalaryGrades
                .Where(g => g.CompanyId == _companyId && g.IsActive)
                .OrderBy(g => g.SortOrder).ThenBy(g => g.GradeCode)
                .ToListAsync();
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        _employees = await context.Hremployee
            .Where(e => e.companyid == _companyId)
            .OrderBy(e => e.EmpNo)
            .ToListAsync();

        var empNos = _employees.Select(e => e.EmpNo).ToList();
        _linkedUsers = await context.sc_users
            .Where(u => u.empid != null && empNos.Contains(u.empid))
            .ToDictionaryAsync(u => u.empid!, u => u);
    }

    private bool EmpFilter(Hremployee emp)
    {
        if (string.IsNullOrWhiteSpace(_searchTerm)) return true;
        var q = _searchTerm.Trim().ToLowerInvariant();
        return (!string.IsNullOrWhiteSpace(emp.EmpNo) && emp.EmpNo.ToLowerInvariant().Contains(q))
            || (!string.IsNullOrWhiteSpace(emp.EmpName) && emp.EmpName.ToLowerInvariant().Contains(q))
            || (!string.IsNullOrWhiteSpace(emp.EmpSurname) && emp.EmpSurname.ToLowerInvariant().Contains(q));
    }

    private async Task OpenCreate()
    {
        _userAccountEmployee = null;
        _resetPasswordEmployee = null;
        _empNoUnlocked = false;
        _formError = null;
        _workDate = DateTime.Today;
        _birthDate = null;
        _formEmployeeEmail = null;
        _formEmployee = new Hremployee { companyid = _companyId!, EmptypeCode = "01" };
        _formEmployee.EmpNo = await GenerateNextEmpNoAsync();
        _selectedCostCenter = null;
        _currentSlot = null;
        _currentOrgLabel = null;
    }

    private async Task<string> GenerateNextEmpNoAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var settings = await context.Pay_PayslipSettings.FirstOrDefaultAsync(s => s.CompanyId == _companyId);
        var prefix = settings?.EmpCodePrefix ?? string.Empty;
        var digits = settings is null || settings.EmpCodeDigits < 1 ? 3 : settings.EmpCodeDigits;

        int next;
        if (settings?.EmpCodeNextNumber is int statefulNext)
        {
            // Admin explicitly set a starting number via the format settings
            // page (Master Data > รูปแบบรหัสพนักงาน) — use it directly instead
            // of re-deriving from existing data.
            next = statefulNext;
        }
        else
        {
            // EmpNo also doubles as sc_user.loginname now, so the running
            // number is tracked globally, not just within this company.
            var existingNumbers = await context.Hremployee
                .Where(e => e.EmpNo.StartsWith(prefix))
                .Select(e => e.EmpNo)
                .ToListAsync();

            var pattern = $"^{Regex.Escape(prefix)}(\\d+)$";
            next = existingNumbers
                .Select(no => Regex.Match(no, pattern))
                .Where(m => m.Success)
                .Select(m => int.Parse(m.Groups[1].Value))
                .DefaultIfEmpty(0)
                .Max() + 1;
        }

        return prefix + next.ToString(new string('0', digits));
    }

    private const int MaxEmpNoLength = 6; // Hremployee.EmpNo StringLength(6)

    private async Task SaveEmployeeAsync()
    {
        _formError = null;

        if (_formEmployee is null || string.IsNullOrWhiteSpace(_formEmployee.EmpNo)
            || string.IsNullOrWhiteSpace(_formEmployee.EmpName) || string.IsNullOrWhiteSpace(_formEmployee.EmpSurname)
            || string.IsNullOrWhiteSpace(_formEmployeeEmail))
        {
            _formError = L.Translate("FillEmpBasicFieldsError");
            return;
        }

        if (!EmployeeEmailResolver.IsValidFormat(_formEmployeeEmail))
        {
            _formError = L.Translate("InvalidEmailFormatError");
            return;
        }

        if (_formEmployee.EmpNo.Length > MaxEmpNoLength)
        {
            _formError = string.Format(L.Translate("EmpNoTooLongError"), MaxEmpNoLength);
            return;
        }

        try
        {
            await using var context = await DbFactory.CreateDbContextAsync();

            // Global, not company-scoped: EmpNo doubles as sc_user.loginname
            // (see PayrollEmployeeAdmin's "สร้างบัญชีผู้ใช้" flow), which must
            // be unique across the whole system regardless of company.
            var duplicate = await context.Hremployee.AnyAsync(e => e.EmpNo == _formEmployee.EmpNo);
            if (duplicate)
            {
                _formError = string.Format(L.Translate("EmpNoDuplicateError"), _formEmployee.EmpNo);
                return;
            }

            _formEmployee.WorkDate = _workDate;
            _formEmployee.BirthDate = _birthDate;
            context.Hremployee.Add(_formEmployee);
            await context.SaveChangesAsync();
            await EmployeeEmailResolver.SetAsync(context, _formEmployee.id, _formEmployeeEmail!);

            // Only auto-advance the stateful counter when the suggested code
            // was used as-is — a manually typed code (unlocked) shouldn't
            // silently move the counter based on a guess at its intent.
            if (!_empNoUnlocked)
            {
                var settings = await context.Pay_PayslipSettings.FirstOrDefaultAsync(s => s.CompanyId == _companyId);
                if (settings?.EmpCodeNextNumber is not null)
                {
                    settings.EmpCodeNextNumber++;
                    await context.SaveChangesAsync();
                }
            }
        }
        catch (DbUpdateException)
        {
            // Never let a DB-level failure (truncation, constraint, etc.) bubble
            // up as an unhandled exception — that crashes the whole Blazor
            // circuit and makes every button on the page silently stop working.
            _formError = L.Translate("SaveFailedGenericError");
            return;
        }

        Snackbar.Add(L.Translate("EmpAddedSuccess"), Severity.Success);
        _formEmployee = null;
        await LoadAsync();
    }

    private async Task OpenUserAccount(Hremployee emp)
    {
        _formEmployee = null;
        _resetPasswordEmployee = null;
        _userAccountError = null;
        _userAccountInfo = null;
        _userAccountEmployee = emp;

        await using var context = await DbFactory.CreateDbContextAsync();
        _userAccountRoles = await context.sc_roles.Where(r => r.isactive).OrderBy(r => r.roleid).ToListAsync();
        var employeeRole = _userAccountRoles.FirstOrDefault(r => r.rolecode == "emp");
        _selectedUserAccountRoleIds = employeeRole is not null ? new HashSet<long> { employeeRole.roleid } : new HashSet<long>();
        _userAccountEmail = await EmployeeEmailResolver.ResolveAsync(context, emp.id);
    }

    private void ToggleUserAccountRole(long roleId, bool selected)
    {
        if (selected) _selectedUserAccountRoleIds.Add(roleId);
        else _selectedUserAccountRoleIds.Remove(roleId);
    }

    private async Task OpenResetPasswordAsync(Hremployee emp)
    {
        _formEmployee = null;
        _userAccountEmployee = null;
        _resetPasswordError = null;
        _resetPasswordInfo = null;
        _resetPasswordEmployee = emp;

        await using var context = await DbFactory.CreateDbContextAsync();
        _resetPasswordEmail = await EmployeeEmailResolver.ResolveAsync(context, emp.id);
    }

    private async Task ConfirmResetPasswordAsync()
    {
        _resetPasswordError = null;
        if (_resetPasswordEmployee is null) return;

        await using var context = await DbFactory.CreateDbContextAsync();

        var newPassword = await GetDefaultPasswordAsync(context);
        if (newPassword is null)
        {
            _resetPasswordError = L.Translate("DefaultPasswordNotSetError");
            return;
        }

        var scUser = await context.sc_users.FirstOrDefaultAsync(u => u.empid == _resetPasswordEmployee.EmpNo);
        if (scUser is null)
        {
            _resetPasswordError = L.Translate("UserAccountNotFoundError");
            return;
        }

        var state = await AuthProvider.GetAuthenticationStateAsync();
        scUser.password = PasswordHasher.HashPassword(scUser, newPassword);
        scUser.isforcechanged = true;
        scUser.moddate = DateTime.Now;
        scUser.modby = state.User.Identity?.Name ?? "admin";
        await context.SaveChangesAsync();

        // sc_user.password above is legacy/reference only (same note as
        // UserAdmin.razor's ResetPasswordAsync) — the credential that
        // actually matters for sign-in is ApplicationUser.PasswordHash.
        var appUser = await UserManager.Users.FirstOrDefaultAsync(u => u.userid == scUser.userid);
        if (appUser is null)
        {
            _resetPasswordError = L.Translate("IdentityNotLinkedError");
            return;
        }
        await UserManager.RemovePasswordAsync(appUser);
        await UserManager.AddPasswordAsync(appUser, newPassword);

        var emailNote = await TrySendCredentialEmailAsync(_resetPasswordEmail, scUser.loginname, newPassword, isReset: true);
        _resetPasswordInfo = string.Format(L.Translate("ResetPasswordSuccessTemplate"), newPassword, emailNote);
        Snackbar.Add(L.Translate("ResetPasswordSuccessSnackbar"), Severity.Success);
    }

    private async Task CreateUserAccountAsync()
    {
        _userAccountError = null;
        if (_userAccountEmployee is null) return;

        if (_selectedUserAccountRoleIds.Count == 0)
        {
            _userAccountError = L.Translate("SelectAtLeastOneRoleError");
            return;
        }

        await using var context = await DbFactory.CreateDbContextAsync();

        var duplicate = await context.sc_users.AnyAsync(u => u.loginname == _userAccountEmployee.EmpNo);
        if (duplicate)
        {
            _userAccountError = string.Format(L.Translate("LoginNameDuplicateError"), _userAccountEmployee.EmpNo);
            return;
        }

        var accountPassword = await GetDefaultPasswordAsync(context);
        if (accountPassword is null)
        {
            _userAccountError = L.Translate("DefaultPasswordNotSetError");
            return;
        }

        var state = await AuthProvider.GetAuthenticationStateAsync();
        var actor = state.User.Identity?.Name ?? "admin";

        var newUser = new sc_user
        {
            loginname = _userAccountEmployee.EmpNo,
            empid = _userAccountEmployee.EmpNo,
            firstname = _userAccountEmployee.EmpName ?? _userAccountEmployee.EmpNo,
            lastname = _userAccountEmployee.EmpSurname ?? string.Empty,
            company_id = 1,
            isforcechanged = true,
            isActivate = true,
            isdisable = false,
            iscancel = false,
            moddate = DateTime.Now,
            modby = actor,
        };
        newUser.password = PasswordHasher.HashPassword(newUser, accountPassword);

        try
        {
            context.sc_users.Add(newUser);
            await context.SaveChangesAsync();

            foreach (var roleId in _selectedUserAccountRoleIds)
            {
                context.sc_user_roles.Add(new sc_user_role
                {
                    userid = newUser.userid,
                    roleid = roleId,
                    isactive = true,
                    modate = DateTime.Now,
                    modby = actor,
                });
            }
            await context.SaveChangesAsync();
        }
        catch (DbUpdateException)
        {
            // Same defense as SaveEmployeeAsync — never let a DB-level failure
            // crash the whole Blazor circuit.
            _userAccountError = L.Translate("CreateUserAccountFailedError");
            return;
        }

        // Also create the linked Identity account right here (previously a
        // separate manual step via /admin/link-identity-account) — the
        // real login flow (Endpoints/LoginEndpoints.cs) authenticates
        // against ApplicationUser.PasswordHash, not sc_user.password above,
        // so without this the account couldn't actually log in yet despite
        // the message telling HR a password.
        var appUser = new ApplicationUser
        {
            // UserName stays synthetic/unique-by-loginname regardless of
            // whether a real email is on file — sign-in matches by loginname
            // (LoginEndpoints.cs), not by this value, and using the real
            // email here would risk a collision if it's ever reused.
            UserName = $"{newUser.loginname}@local.humanok",
            Email = string.IsNullOrWhiteSpace(_userAccountEmail) ? $"{newUser.loginname}@local.humanok" : _userAccountEmail,
            EmailConfirmed = true,
            FirstName = newUser.firstname,
            LastName = newUser.lastname,
            userid = newUser.userid,
        };
        var identityResult = await UserManager.CreateAsync(appUser, accountPassword);
        if (!identityResult.Succeeded)
        {
            // sc_user row already exists at this point — surface the error
            // but don't roll back; HR can still finish the link manually via
            // /admin/link-identity-account (e.g. if the derived password
            // somehow still fails a policy check we didn't anticipate).
            _userAccountError = string.Format(L.Translate("IdentityLinkFailedError"),
                string.Join(", ", identityResult.Errors.Select(e => e.Description)));
            await LoadAsync();
            return;
        }

        var emailNote = await TrySendCredentialEmailAsync(_userAccountEmail, newUser.loginname, accountPassword, isReset: false);

        _userAccountInfo = string.Format(L.Translate("CreateUserAccountSuccessTemplate"), newUser.loginname, accountPassword, emailNote);
        Snackbar.Add(L.Translate("CreateUserAccountSuccessSnackbar"), Severity.Success);
        await LoadAsync();
    }

    // Company-wide static password (Pay_PayslipSettings.DefaultPasswordPart1
    // + Part2, concatenated verbatim) — deliberately NOT derived from
    // employee data like the payslip PDF password (PasswordTemplate) is, so
    // creating/resetting an account never blocks on missing birthdate/ID
    // card the way the old formula-based attempt did (see the "010 ไม่มี
    // ข้อมูล วันเกิด" report that prompted this change).
    private async Task<string?> GetDefaultPasswordAsync(HRMContext context)
    {
        var settings = await context.Pay_PayslipSettings.FirstOrDefaultAsync(s => s.CompanyId == _companyId);
        if (settings is null) return null;
        var combined = (settings.DefaultPasswordPart1 ?? "") + (settings.DefaultPasswordPart2 ?? "");
        return string.IsNullOrEmpty(combined) ? null : combined;
    }

    // Sends the plaintext credential by email per the user's explicit
    // request (rather than the token-based /Account/ForgotPassword +
    // /Account/ResetPassword flow already built into this app via Identity's
    // scaffolded pages, which is the more conventional pattern but not what
    // was asked for here). Never blocks account creation/reset on failure —
    // SMTP is external and its failure shouldn't strand HR without the
    // password that's already shown on screen.
    private async Task<string> TrySendCredentialEmailAsync(string? email, string loginname, string password, bool isReset)
    {
        if (string.IsNullOrWhiteSpace(email)) return L.Translate("NoEmailProvidedNote");

        var subject = isReset ? "รีเซ็ตรหัสผ่านเข้าระบบ HumanOk" : "บัญชีผู้ใช้ระบบ HumanOk ของคุณ";
        var body = $"<p>ชื่อเข้าสู่ระบบ: <b>{loginname}</b></p><p>รหัสผ่าน{(isReset ? "ใหม่" : "เริ่มต้น")}: <b>{password}</b></p>" +
            "<p>กรุณาเข้าสู่ระบบที่หน้า /login</p>";
        try
        {
            await EmailSender.SendEmailAsync(email, subject, body);
            return string.Format(L.Translate("EmailSentNote"), email);
        }
        catch (Exception ex)
        {
            Serilog.Log.Error(ex, "Failed to send credential email to {Email}", email);
            return string.Format(L.Translate("EmailSendFailedNote"), email);
        }
    }

}
