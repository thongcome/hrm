    private async Task OpenUserAccount(Hremployee emp)
    {
        _formEmployee = null;
        _resignEmployee = null;
        _severanceEmployee = null;
        _docsEmployee = null;
        _userAccountError = null;
        _userAccountInfo = null;
        _userAccountEmployee = emp;

        await using var context = await DbFactory.CreateDbContextAsync();
        _userAccountRoles = await context.sc_roles.Where(r => r.isactive).OrderBy(r => r.roleid).ToListAsync();
        var employeeRole = _userAccountRoles.FirstOrDefault(r => r.rolecode == "emp");
        _selectedUserAccountRoleIds = employeeRole is not null ? new HashSet<long> { employeeRole.roleid } : new HashSet<long>();
    }

    private void ToggleUserAccountRole(long roleId, bool selected)
    {
        if (selected) _selectedUserAccountRoleIds.Add(roleId);
        else _selectedUserAccountRoleIds.Remove(roleId);
    }

    private async Task CreateUserAccountAsync()
    {
        _userAccountError = null;
        if (_userAccountEmployee is null) return;

        if (_selectedUserAccountRoleIds.Count == 0)
        {
            _userAccountError = "กรุณาเลือกอย่างน้อย 1 กลุ่มผู้ใช้";
            return;
        }

        await using var context = await DbFactory.CreateDbContextAsync();

        var duplicate = await context.sc_users.AnyAsync(u => u.loginname == _userAccountEmployee.EmpNo);
        if (duplicate)
        {
            _userAccountError = $"มีชื่อเข้าสู่ระบบ '{_userAccountEmployee.EmpNo}' อยู่แล้วในระบบ";
            return;
        }

        var state = await AuthProvider.GetAuthenticationStateAsync();
        var actor = state.User.Identity?.Name ?? "admin";

        var newUser = new sc_user
        {
            loginname = _userAccountEmployee.EmpNo,
            empid = _userAccountEmployee.EmpNo,
            firstname = _userAccountEmployee.EmpName ?? _userAccountEmployee.EmpNo,
            lastname = _userAccountEmployee.EmpSurname ?? string.Empty,
            company_id = 1,
            isforcechanged = true,
            isActivate = true,
            isdisable = false,
            iscancel = false,
            moddate = DateTime.Now,
            modby = actor,
        };
        newUser.password = PasswordHasher.HashPassword(newUser, DefaultAccountPassword);

        try
        {
            context.sc_users.Add(newUser);
            await context.SaveChangesAsync();

            foreach (var roleId in _selectedUserAccountRoleIds)
            {
                context.sc_user_roles.Add(new sc_user_role
                {
                    userid = newUser.userid,
                    roleid = roleId,
                    isactive = true,
                    modate = DateTime.Now,
                    modby = actor,
                });
            }
            await context.SaveChangesAsync();
        }
        catch (DbUpdateException)
        {
            // Same defense as SaveEmployeeAsync — never let a DB-level failure
            // crash the whole Blazor circuit.
            _userAccountError = "สร้างบัญชีผู้ใช้ไม่สำเร็จ — กรุณาลองใหม่ หรือตรวจสอบว่ารหัสพนักงานถูกต้อง";
            return;
        }

        _userAccountInfo = $"สร้างบัญชีผู้ใช้เรียบร้อย ชื่อเข้าสู่ระบบ {newUser.loginname} รหัสผ่านเริ่มต้นคือ {DefaultAccountPassword} " +
            "(บังคับเปลี่ยนรหัสผ่านครั้งแรกที่ login) — ต้องผูกบัญชี Identity ผ่านหน้า \"ผูกบัญชี Identity\" ก่อนถึงจะ login เข้าระบบได้จริง";
        Snackbar.Add("สร้างบัญชีผู้ใช้เรียบร้อย", Severity.Success);
        await LoadAsync();
    }

    private async Task UploadDocAsync()
    {
        _docError = null;

        if (_docsEmployee is null || _uploadFile is null) return;

        const long maxSize = 10 * 1024 * 1024; // 10 MB
        if (_uploadFile.Size > maxSize)
        {
            _docError = "ไฟล์ใหญ่เกินไป (จำกัด 10 MB)";
            return;
        }

        await using var stream = _uploadFile.OpenReadStream(maxSize);
        using var buffer = new MemoryStream();
        await stream.CopyToAsync(buffer);
        var bytes = buffer.ToArray();

        var storedFileName = $"{_docsEmployee.EmpNo}_{DateTime.Now:yyyyMMddHHmmss}_{_uploadFile.Name}";
        var (relativePath, sha256) = await FileStorage.SaveAsync("employee-docs", storedFileName, bytes);

        var state = await AuthProvider.GetAuthenticationStateAsync();
        var userIdClaim = state.User.FindFirstValue("sc_userid");
        var userId = long.TryParse(userIdClaim, out var uid) ? uid : 0;

        await using var context = await DbFactory.CreateDbContextAsync();
        context.Pay_EmployeeDocuments.Add(new Pay_EmployeeDocument
        {
            HremployeeId = _docsEmployee.id,
            DocumentType = _uploadDocType,
            FileName = _uploadFile.Name,
            StoragePath = relativePath,
            Sha256 = sha256,
            UploadedByUserId = userId,
            UploadedDate = DateTime.Now,
        });
        await context.SaveChangesAsync();

        Snackbar.Add("อัปโหลดเอกสารเรียบร้อย", Severity.Success);
        _uploadFile = null;
        await OpenDocsAsync(_docsEmployee);
    }

