    private async Task OpenSeveranceAsync(Hremployee emp)
    {
        _formEmployee = null;
        _resignEmployee = null;
        _docsEmployee = null;
        _userAccountEmployee = null;
        _severanceError = null;
        _severancePreview = null;
        _severanceEmployee = emp;

        try
        {
            _severancePreview = await SeveranceService.PreviewAsync(emp.id);
            _severanceAmount = _severancePreview.Amount;
            _severanceReason = $"ค่าชดเชยตามกฎหมาย มาตรา 118 ({_severancePreview.TierDescription})";
            _severanceTargetMonth = DateTime.Today;
        }
        catch (InvalidOperationException ex)
        {
            _severanceError = ex.Message;
        }
    }

    private async Task SubmitSeveranceAsync()
    {
        _severanceError = null;

        if (_severanceEmployee is null || _severanceTargetMonth is null || _severanceAmount <= 0 || string.IsNullOrWhiteSpace(_severanceReason))
        {
            _severanceError = "กรุณากรอกข้อมูลให้ครบถ้วน";
            return;
        }

        var state = await AuthProvider.GetAuthenticationStateAsync();
        var userIdClaim = state.User.FindFirstValue("sc_userid");
        var userId = long.TryParse(userIdClaim, out var uid) ? uid : 0;

        // InvariantCulture: ambient Thai culture formats "yyyy" as Buddhist
        // year — TargetPeriod must stay Gregorian to match Pay_PayrollRun.
        var targetPeriod = _severanceTargetMonth.Value.ToString("yyyyMM", System.Globalization.CultureInfo.InvariantCulture);

        try
        {
            await SeveranceService.SubmitAsync(_severanceEmployee.id, targetPeriod, _severanceAmount, _severanceReason, userId);
        }
        catch (InvalidOperationException ex)
        {
            _severanceError = ex.Message;
            return;
        }

        Snackbar.Add("ยื่นค่าชดเชยเรียบร้อย รออนุมัติที่หน้ารายการเฉพาะกิจ", Severity.Success);
        _severanceEmployee = null;
        Nav.NavigateTo($"/pay/adhoc/{targetPeriod}");
    }

