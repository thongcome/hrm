@page "/pay/runs/create"
@using System.Security.Claims
@using HRM.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation
@inject JsonLocalizationService L
@inject HRM.Services.Pay.PayDateService PayDates
@attribute [Authorize(Policy = "Menu:PAY_RUNS")]

<PageTitle>@L.Translate("PayRunCreatePageTitle")</PageTitle>

<MudPaper Class="pa-4" MaxWidth="600px">
    <MudText Typo="Typo.h5" Class="mb-4">@L.Translate("PayRunCreateHeading")</MudText>

    <MudForm @ref="_form" Model="_model">
        <MudTextField Value="_model.CompanyId" Label="@L.Translate("PayRunFieldCompanyId")" ReadOnly="true"
            HelperText="@L.Translate("PayRunCompanyIdHelper")" />
        <MudSelect @bind-Value="_model.RunType" Label="@L.Translate("ColType")" Class="mt-3">
            <MudSelectItem Value="PayrollRunType.Regular">@L.Translate("PayRunTypeRegular")</MudSelectItem>
            <MudSelectItem Value="PayrollRunType.Bonus">@L.Translate("PayRunTypeBonus")</MudSelectItem>
        </MudSelect>
        @* Date/DateChanged (not @bind-Date) so picking a month can recompute
           the default pay date from company config — mixing @bind-Date with an
           explicit handler is the RZ10010 compile error. *@
        <MudDatePicker Date="_periodMonth" DateChanged="OnPeriodMonthChangedAsync" Label="@L.Translate("PayRunFieldPeriodMonth")" Class="mt-3" />
        @if (_periodsPerMonth == 2 && _model.RunType == PayrollRunType.Regular)
        {
            @* ปฏิทินจ่ายของบริษัทเป็น 2 งวด/เดือน (Pay_PaySchedule) — เลือกครึ่งเดือน; งวด YYYYMM เดียวกันทั้งสองรอบ *@
            <MudSelect T="int" @bind-Value="_termNo" Label="งวดที่ของเดือน" Class="mt-3"
                HelperText="@($"บริษัทตั้งปฏิทินจ่าย 2 งวด/เดือน — งวดที่ 1 = วันที่ 1–{_secondTermStartDay - 1}, งวดที่ 2 = วันที่ {_secondTermStartDay}–สิ้นเดือน")">
                <MudSelectItem T="int" Value="1">งวดที่ 1 (วันที่ 1–@(_secondTermStartDay - 1))</MudSelectItem>
                <MudSelectItem T="int" Value="2">งวดที่ 2 (วันที่ @_secondTermStartDay–สิ้นเดือน)</MudSelectItem>
            </MudSelect>
        }
        <MudDatePicker @bind-Date="_payDate" Label="@L.Translate("PayRunFieldPayDate")" Class="mt-3"
            HelperText="ค่าเริ่มต้นจาก config (วันจ่ายประจำเดือน เลื่อนเข้าถ้าตรงวันหยุด) — แก้ทับได้" />

        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
        }

        <MudStack Row="true" Class="mt-4" Justify="Justify.FlexEnd">
            <MudButton Variant="Variant.Text" OnClick="@(() => Navigation.NavigateTo("/pay/runs"))">@L.Translate("CancelButton")</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">@L.Translate("PayRunCreateSubmitButton")</MudButton>
        </MudStack>
    </MudForm>
</MudPaper>

@code {
    private MudForm _form = null!;
    private readonly CreateModel _model = new();
    private DateTime? _periodMonth = DateTime.Today;
    private DateTime? _payDate = DateTime.Today;
    private string? _error;
    private int _periodsPerMonth = 1;
    private int _secondTermStartDay = 16;
    private int _termNo = 1;

    private class CreateModel
    {
        public string CompanyId { get; set; } = "";
        public PayrollRunType RunType { get; set; } = PayrollRunType.Regular;
    }

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _model.CompanyId = state.User.FindFirstValue("payroll_company") ?? "";
        // Pay date used to default to "today", which is meaningless for the
        // period being created (and produced dates like 30/09 for a January
        // run). Default it from company config for the selected month instead.
        await RecomputeDefaultPayDateAsync();
    }

    private async Task OnPeriodMonthChangedAsync(DateTime? value)
    {
        _periodMonth = value;
        await RecomputeDefaultPayDateAsync();
    }

    private async Task RecomputeDefaultPayDateAsync()
    {
        if (string.IsNullOrWhiteSpace(_model.CompanyId) || _periodMonth is null) return;
        var d = await PayDates.ComputeDefaultPayDateAsync(_model.CompanyId, _periodMonth.Value.Year, _periodMonth.Value.Month);
        _payDate = d.ToDateTime(TimeOnly.MinValue);
        await LoadPayScheduleAsync();
    }

    // ปฏิทินจ่ายที่มีผลกับเดือนที่เลือก (แถว "ทุกคน" หรือกลุ่มใดกลุ่มหนึ่งที่ตั้ง 2 งวด) — ถ้ามี ให้เลือกงวดที่ของเดือนได้
    private async Task LoadPayScheduleAsync()
    {
        var first = new DateOnly(_periodMonth!.Value.Year, _periodMonth.Value.Month, 1);
        await using var context = await DbFactory.CreateDbContextAsync();
        var schedules = await context.Pay_PaySchedules
            .Where(s => s.CompanyId == _model.CompanyId && s.IsActive && s.EffectiveFrom <= first && (s.EffectiveTo == null || s.EffectiveTo >= first))
            .ToListAsync();
        var semi = schedules.Where(s => s.PeriodsPerMonth == 2).OrderByDescending(s => s.EffectiveFrom).FirstOrDefault();
        _periodsPerMonth = semi is null ? 1 : 2;
        _secondTermStartDay = Math.Clamp(semi?.SecondTermStartDay ?? 16, 2, 28);
        if (_periodsPerMonth == 1) _termNo = 1;
    }

    private async Task SaveAsync()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_model.CompanyId) || _periodMonth is null || _payDate is null)
        {
            _error = string.IsNullOrWhiteSpace(_model.CompanyId)
                ? L.Translate("CompanyNotLinkedError")
                : L.Translate("FillAllFieldsError");
            return;
        }

        var periodStart = new DateOnly(_periodMonth.Value.Year, _periodMonth.Value.Month, 1);
        var periodEnd = periodStart.AddMonths(1).AddDays(-1);
        // รอบครึ่งเดือน: งวดที่ 1 = 1..(วันเริ่มงวด 2 − 1), งวดที่ 2 = วันเริ่มงวด 2..สิ้นเดือน; รอบโบนัสเป็นทั้งเดือนเสมอ
        var termNo = _periodsPerMonth == 2 && _model.RunType == PayrollRunType.Regular ? _termNo : 1;
        if (_periodsPerMonth == 2 && _model.RunType == PayrollRunType.Regular)
        {
            if (termNo == 1) periodEnd = new DateOnly(periodStart.Year, periodStart.Month, _secondTermStartDay - 1);
            else periodStart = new DateOnly(periodStart.Year, periodStart.Month, _secondTermStartDay);
        }
        // InvariantCulture: the server's ambient culture is Thai, whose default
        // calendar formats "yyyy" as the Buddhist year (e.g. 2569, not 2026) —
        // PayrollPeriod must stay Gregorian to match Pay_TaxBracket.EffectiveYear.
        var period = periodStart.ToString("yyyyMM", System.Globalization.CultureInfo.InvariantCulture);

        await using var context = await DbFactory.CreateDbContextAsync();

        var duplicate = await context.Pay_PayrollRuns.AnyAsync(r =>
            r.CompanyId == _model.CompanyId && r.PayrollPeriod == period && r.TermNo == termNo && r.RunType == _model.RunType && r.Status != PayrollRunStatus.Cancelled);
        if (duplicate)
        {
            _error = string.Format(L.Translate("PayRunDuplicateError"), _model.RunType, termNo == 1 && _periodsPerMonth == 1 ? period : $"{period} งวดที่ {termNo}", _model.CompanyId);
            return;
        }

        var actorUserId = await GetCurrentUserIdAsync();

        var run = new Pay_PayrollRun
        {
            CompanyId = _model.CompanyId,
            PayrollPeriod = period,
            TermNo = termNo,
            PeriodStart = periodStart,
            PeriodEnd = periodEnd,
            PayDate = DateOnly.FromDateTime(_payDate.Value),
            RunType = _model.RunType,
            Status = PayrollRunStatus.Draft,
            CreatedByUserId = actorUserId,
        };

        context.Pay_PayrollRuns.Add(run);
        await context.SaveChangesAsync();

        Navigation.NavigateTo($"/pay/runs/{run.Id}");
    }

    private async Task<long> GetCurrentUserIdAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        var idClaim = state.User.FindFirstValue("sc_userid");
        return long.TryParse(idClaim, out var id) ? id : 0;
    }
}
