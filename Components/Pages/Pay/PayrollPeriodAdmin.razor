@page "/pay/admin/periods"
@using System.Security.Claims
@using HRM.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@inject JsonLocalizationService L
@attribute [Authorize(Policy = "Menu:PAY_ADMIN")]

<PageTitle>@L.Translate("PeriodAdminPageTitle")</PageTitle>

<MudPaper Class="pa-4 mb-4" MaxWidth="900px">
    <MudText Typo="Typo.h5">@L.Translate("PeriodAdminHeading")</MudText>
    <MudText Typo="Typo.body2" Class="mt-1">
        @L.Translate("PeriodAdminDesc")
    </MudText>

    @if (string.IsNullOrEmpty(_companyId))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">@L.Translate("CompanyNotLinkedError")</MudAlert>
    }
    else
    {
        <MudDivider Class="my-4" />

        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
            <MudText Typo="Typo.h6">@L.Translate("PeriodAdminHeading")</MudText>
            @if (!_showForm)
            {
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="OpenCreate">+ @L.Translate("AddPeriodButton")</MudButton>
            }
        </MudStack>

        @if (_showForm)
        {
            <MudGrid>
                <MudItem xs="12" sm="4">
                    <MudNumericField @bind-Value="_newModel.Year" Label="@L.Translate("YearAdCeLabel")" Min="2020" Max="2100" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect T="int" @bind-Value="_newModel.Month" Label="@L.Translate("MonthLabel")">
                        @for (var m = 1; m <= 12; m++)
                        {
                            var month = m;
                            <MudSelectItem T="int" Value="@month">@ThaiMonthName(month)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField @bind-Value="_newModel.TermNo" Label="@L.Translate("TermNoLabel")" Min="1" Max="9" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="_newPeriodStart" Label="@L.Translate("PeriodStartDateLabel")" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="_newPeriodEnd" Label="@L.Translate("PeriodEndDateLabel")" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_newModel.Label" Label="@L.Translate("DisplayLabelField")"
                        HelperText="@L.Translate("DisplayLabelHelperText")" />
                </MudItem>
            </MudGrid>

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
            }

            <MudStack Row="true" Class="mt-4">
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="AddPeriodAsync">@L.Translate("AddPeriodButton")</MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="@(() => _showForm = false)">@L.Translate("CancelButton")</MudButton>
            </MudStack>
        }

        <MudDivider Class="my-5" />

        <MudTable Items="_periods" Dense="true" Hover="true">
            <HeaderContent>
                <MudTh>@L.Translate("YearAdCeLabel")</MudTh>
                <MudTh>@L.Translate("MonthLabel")</MudTh>
                <MudTh>@L.Translate("TermNoLabel")</MudTh>
                <MudTh>@L.Translate("DisplayLabelField")</MudTh>
                <MudTh>@L.Translate("DateRangeLabel")</MudTh>
                <MudTh>@L.Translate("ColStatus")</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Year</MudTd>
                <MudTd>@ThaiMonthName(context.Month)</MudTd>
                <MudTd>@context.TermNo</MudTd>
                <MudTd>@context.Label</MudTd>
                <MudTd>@context.PeriodStart.ToString("dd/MM/yyyy") - @context.PeriodEnd.ToString("dd/MM/yyyy")</MudTd>
                <MudTd>@(context.IsActive ? L.Translate("PeriodActiveStatus") : L.Translate("PeriodInactiveStatus"))</MudTd>
                <MudTd>
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => ToggleActiveAsync(context))">
                        @(context.IsActive ? L.Translate("DeactivateButton") : L.Translate("ActivateButton"))
                    </MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

@code {
    private string? _companyId;
    private List<Pay_PayrollPeriod> _periods = new();
    private string? _error;
    private bool _showForm;
    private DateTime? _newPeriodStart;
    private DateTime? _newPeriodEnd;

    private class NewPeriodModel
    {
        public int Year { get; set; } = DateTime.Today.Year;
        public int Month { get; set; } = DateTime.Today.Month;
        public int TermNo { get; set; } = 1;
        public string? Label { get; set; }
    }

    private NewPeriodModel _newModel = new();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
        if (string.IsNullOrWhiteSpace(_companyId)) return;

        await LoadAsync();

        _newPeriodStart = new DateTime(_newModel.Year, _newModel.Month, 1);
        _newPeriodEnd = _newPeriodStart.Value.AddMonths(1).AddDays(-1);
    }

    private async Task LoadAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        _periods = await context.Pay_PayrollPeriods
            .Where(p => p.CompanyId == _companyId)
            .OrderByDescending(p => p.Year).ThenByDescending(p => p.Month).ThenBy(p => p.TermNo)
            .ToListAsync();
    }

    private void OpenCreate()
    {
        _error = null;
        _newModel = new NewPeriodModel();
        _newPeriodStart = new DateTime(_newModel.Year, _newModel.Month, 1);
        _newPeriodEnd = _newPeriodStart.Value.AddMonths(1).AddDays(-1);
        _showForm = true;
    }

    private async Task AddPeriodAsync()
    {
        _error = null;

        if (_newPeriodStart is null || _newPeriodEnd is null || _newPeriodEnd < _newPeriodStart)
        {
            _error = L.Translate("InvalidPeriodDateRangeError");
            return;
        }

        var periodStart = DateOnly.FromDateTime(_newPeriodStart.Value);
        var periodEnd = DateOnly.FromDateTime(_newPeriodEnd.Value);

        await using var context = await DbFactory.CreateDbContextAsync();

        var duplicate = await context.Pay_PayrollPeriods.AnyAsync(p =>
            p.CompanyId == _companyId && p.Year == _newModel.Year && p.Month == _newModel.Month && p.TermNo == _newModel.TermNo);
        if (duplicate)
        {
            _error = string.Format(L.Translate("PeriodDuplicateErrorTemplate"), _newModel.Year, ThaiMonthName(_newModel.Month), _newModel.TermNo);
            return;
        }

        var label = string.IsNullOrWhiteSpace(_newModel.Label)
            ? string.Format(L.Translate("PeriodAutoLabelTemplate"), ThaiMonthName(_newModel.Month), _newModel.Year + 543, _newModel.TermNo)
            : _newModel.Label;

        context.Pay_PayrollPeriods.Add(new Pay_PayrollPeriod
        {
            CompanyId = _companyId!,
            Year = _newModel.Year,
            Month = _newModel.Month,
            TermNo = _newModel.TermNo,
            Label = label,
            PeriodStart = periodStart,
            PeriodEnd = periodEnd,
            IsActive = true,
        });
        await context.SaveChangesAsync();

        Snackbar.Add(L.Translate("PeriodAddedSuccess"), Severity.Success);
        _newModel = new NewPeriodModel();
        _showForm = false;
        await LoadAsync();
    }

    private async Task ToggleActiveAsync(Pay_PayrollPeriod period)
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var existing = await context.Pay_PayrollPeriods.FirstOrDefaultAsync(p => p.Id == period.Id && p.CompanyId == _companyId);
        if (existing is null) return;

        existing.IsActive = !existing.IsActive;
        await context.SaveChangesAsync();
        await LoadAsync();
    }

    private string ThaiMonthName(int month) => month switch
    {
        1 => L.Translate("MonthJanuary"),
        2 => L.Translate("MonthFebruary"),
        3 => L.Translate("MonthMarch"),
        4 => L.Translate("MonthApril"),
        5 => L.Translate("MonthMay"),
        6 => L.Translate("MonthJune"),
        7 => L.Translate("MonthJuly"),
        8 => L.Translate("MonthAugust"),
        9 => L.Translate("MonthSeptember"),
        10 => L.Translate("MonthOctober"),
        11 => L.Translate("MonthNovember"),
        12 => L.Translate("MonthDecember"),
        _ => month.ToString(System.Globalization.CultureInfo.InvariantCulture),
    };
}
