@page "/pay/admin/insurance-plans"
@using System.Security.Claims
@using HRM.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@using HRM.Services.Pay
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@inject InsuranceAutoEnrollService AutoEnrollService
@inject IDialogService DialogService
@inject JsonLocalizationService L
@attribute [Authorize(Policy = "Menu:PAY_ADMIN")]

<PageTitle>@L.Translate("InsurancePlanPageTitle")</PageTitle>

<MudPaper Class="pa-4 mb-4" MaxWidth="900px">
    <MudText Typo="Typo.h5">@L.Translate("InsurancePlanHeading")</MudText>
    <MudText Typo="Typo.body2" Class="mt-1">
        @L.Translate("InsurancePlanDesc")
    </MudText>

    @if (string.IsNullOrEmpty(_companyId))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">@L.Translate("CompanyNotLinkedError")</MudAlert>
        return;
    }

    <MudDivider Class="my-4" />

    <MudText Typo="Typo.h6">@(_editingId is null ? L.Translate("AddNewPlanHeading") : string.Format(L.Translate("EditPlanHeadingTemplate"), _form.PlanCode))</MudText>
    <MudGrid Class="mt-1">
        <MudItem xs="12" sm="4">
            <MudTextField @bind-Value="_form.PlanCode" Label="@L.Translate("PlanCodeLabel")" Required="true" />
        </MudItem>
        <MudItem xs="12" sm="8">
            <MudTextField @bind-Value="_form.PlanName" Label="@L.Translate("PlanNameLabel")" Required="true" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudSelect T="Pay_InsurancePlanType" @bind-Value="_form.PlanType" Label="@L.Translate("PlanTypeFieldLabel")">
                <MudSelectItem T="Pay_InsurancePlanType" Value="Pay_InsurancePlanType.Health">@L.Translate("InsuranceTypeHealth")</MudSelectItem>
                <MudSelectItem T="Pay_InsurancePlanType" Value="Pay_InsurancePlanType.Life">@L.Translate("InsuranceTypeLife")</MudSelectItem>
                <MudSelectItem T="Pay_InsurancePlanType" Value="Pay_InsurancePlanType.Accident">@L.Translate("InsuranceTypeAccident")</MudSelectItem>
                <MudSelectItem T="Pay_InsurancePlanType" Value="Pay_InsurancePlanType.Other">@L.Translate("InsuranceTypeOther")</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="8">
            <MudTextField @bind-Value="_form.Provider" Label="@L.Translate("ProviderLabel")" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudTextField @bind-Value="_form.GroupPolicyNumber" Label="@L.Translate("GroupPolicyNumberLabel")" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudNumericField @bind-Value="_form.CoverageAmount" Label="@L.Translate("CoverageAmountLabel")" Format="N2" Min="0" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudNumericField @bind-Value="_form.DefaultEmployeeAmount" Label="@L.Translate("DefaultEmployeeAmountLabel")" Format="N2" Min="0" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudNumericField @bind-Value="_form.DefaultCompanyAmount" Label="@L.Translate("DefaultCompanyAmountLabel")" Format="N2" Min="0" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudNumericField @bind-Value="_form.SortOrder" Label="@L.Translate("SortOrderLabel")" Min="0" />
        </MudItem>
    </MudGrid>

    <MudDivider Class="my-4" />
    <MudText Typo="Typo.subtitle1">@L.Translate("AutoEnrollEligibilityHeading")</MudText>
    <MudText Typo="Typo.body2" Class="mb-2">@L.Translate("LeaveBlankUnlimitedNote")</MudText>
    <MudGrid Class="mt-1">
        <MudItem xs="12">
            <MudText Typo="Typo.body2">@L.Translate("EmploymentTypeLabel")</MudText>
            <MudCheckBox T="bool" @bind-Value="_form.EligibleType01" Label="@L.Translate("RegularEmployeeCheckbox")" />
            <MudCheckBox T="bool" @bind-Value="_form.EligibleType02" Label="@L.Translate("TemporaryEmployeeCheckbox")" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudNumericField @bind-Value="_form.MinTenureDays" Label="@L.Translate("MinTenureDaysLabel")" Min="0" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudNumericField @bind-Value="_form.MinAge" Label="@L.Translate("MinAgeLabel")" Min="0" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudNumericField @bind-Value="_form.MaxAge" Label="@L.Translate("MaxAgeLabel")" Min="0" />
        </MudItem>
        <MudItem xs="12">
            <MudSwitch T="bool" @bind-Value="_form.AutoEnrollEnabled" Label="@L.Translate("AutoEnrollSwitchLabel")" Color="Color.Primary" />
        </MudItem>
    </MudGrid>

    @if (!string.IsNullOrEmpty(_error))
    {
        <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
    }

    <MudStack Row="true" Spacing="2" Class="mt-3">
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">
            @(_editingId is null ? L.Translate("AddPlanButton") : L.Translate("SaveEditButton"))
        </MudButton>
        @if (_editingId is not null)
        {
            <MudButton Variant="Variant.Text" OnClick="CancelEdit">@L.Translate("CancelButton")</MudButton>
        }
    </MudStack>

    <MudDivider Class="my-5" />

    <MudTable Items="_plans" Dense="true" Hover="true">
        <HeaderContent>
            <MudTh>@L.Translate("ColCode")</MudTh>
            <MudTh>@L.Translate("PlanNameLabel")</MudTh>
            <MudTh>@L.Translate("ColPlanType")</MudTh>
            <MudTh>@L.Translate("ColGroupPolicyNumber")</MudTh>
            <MudTh>@L.Translate("ColPremiumEmpCompany")</MudTh>
            <MudTh>@L.Translate("ColStatus")</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.PlanCode</MudTd>
            <MudTd>@context.PlanName</MudTd>
            <MudTd>@PlanTypeLabel(context.PlanType)</MudTd>
            <MudTd>@(context.GroupPolicyNumber ?? "-")</MudTd>
            <MudTd>@context.DefaultEmployeeAmount.ToString("N2") / @context.DefaultCompanyAmount.ToString("N2")</MudTd>
            <MudTd>@(context.IsActive ? L.Translate("PeriodActiveStatus") : L.Translate("PeriodInactiveStatus"))</MudTd>
            <MudTd>
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => StartEdit(context))">@L.Translate("EditButton")</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => ToggleActiveAsync(context))">
                    @(context.IsActive ? L.Translate("DeactivateButton") : L.Translate("ActivateButton"))
                </MudButton>
                @if (context.AutoEnrollEnabled)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => SyncNowAsync(context))">
                        @L.Translate("SyncNowButton")
                    </MudButton>
                }
            </MudTd>
        </RowTemplate>
    </MudTable>
</MudPaper>

@code {
    private string? _companyId;
    private List<Pay_InsurancePlan> _plans = new();
    private string? _error;
    private long? _editingId;

    private class PlanForm
    {
        public string PlanCode { get; set; } = "";
        public string PlanName { get; set; } = "";
        public Pay_InsurancePlanType PlanType { get; set; } = Pay_InsurancePlanType.Health;
        public string? Provider { get; set; }
        public string? GroupPolicyNumber { get; set; }
        public decimal? CoverageAmount { get; set; }
        public decimal DefaultEmployeeAmount { get; set; }
        public decimal DefaultCompanyAmount { get; set; }
        public int SortOrder { get; set; }
        public bool EligibleType01 { get; set; }
        public bool EligibleType02 { get; set; }
        public int? MinTenureDays { get; set; }
        public int? MinAge { get; set; }
        public int? MaxAge { get; set; }
        public bool AutoEnrollEnabled { get; set; }
    }

    private PlanForm _form = new();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
        if (string.IsNullOrWhiteSpace(_companyId)) return;

        await LoadAsync();
    }

    private string PlanTypeLabel(Pay_InsurancePlanType type) => type switch
    {
        Pay_InsurancePlanType.Health => L.Translate("InsuranceTypeHealth"),
        Pay_InsurancePlanType.Life => L.Translate("InsuranceTypeLife"),
        Pay_InsurancePlanType.Accident => L.Translate("InsuranceTypeAccident"),
        _ => L.Translate("InsuranceTypeOther"),
    };

    private async Task LoadAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        _plans = await context.Pay_InsurancePlans
            .Where(p => p.CompanyId == _companyId)
            .OrderBy(p => p.SortOrder).ThenBy(p => p.PlanCode)
            .ToListAsync();
    }

    private void StartEdit(Pay_InsurancePlan plan)
    {
        _editingId = plan.Id;
        _form = new PlanForm
        {
            PlanCode = plan.PlanCode,
            PlanName = plan.PlanName,
            PlanType = plan.PlanType,
            Provider = plan.Provider,
            GroupPolicyNumber = plan.GroupPolicyNumber,
            CoverageAmount = plan.CoverageAmount,
            DefaultEmployeeAmount = plan.DefaultEmployeeAmount,
            DefaultCompanyAmount = plan.DefaultCompanyAmount,
            SortOrder = plan.SortOrder,
            EligibleType01 = (plan.EligibleEmploymentTypes ?? "").Split(',', StringSplitOptions.TrimEntries).Contains("01"),
            EligibleType02 = (plan.EligibleEmploymentTypes ?? "").Split(',', StringSplitOptions.TrimEntries).Contains("02"),
            MinTenureDays = plan.MinTenureDays,
            MinAge = plan.MinAge,
            MaxAge = plan.MaxAge,
            AutoEnrollEnabled = plan.AutoEnrollEnabled,
        };
        _error = null;
    }

    private static string? BuildEligibleTypesCsv(PlanForm form)
    {
        var types = new List<string>();
        if (form.EligibleType01) types.Add("01");
        if (form.EligibleType02) types.Add("02");
        return types.Count == 0 ? null : string.Join(",", types);
    }

    private void CancelEdit()
    {
        _editingId = null;
        _form = new PlanForm();
        _error = null;
    }

    private async Task SaveAsync()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_form.PlanCode) || string.IsNullOrWhiteSpace(_form.PlanName))
        {
            _error = L.Translate("FillPlanCodeNameError");
            return;
        }

        await using var context = await DbFactory.CreateDbContextAsync();

        var duplicate = await context.Pay_InsurancePlans.AnyAsync(p =>
            p.CompanyId == _companyId && p.PlanCode == _form.PlanCode && p.Id != (_editingId ?? 0));
        if (duplicate)
        {
            _error = string.Format(L.Translate("PlanCodeDuplicateErrorTemplate"), _form.PlanCode);
            return;
        }

        if (_editingId is long id)
        {
            var existing = await context.Pay_InsurancePlans.FirstOrDefaultAsync(p => p.Id == id && p.CompanyId == _companyId);
            if (existing is null)
            {
                _error = L.Translate("PlanNotFoundError");
                return;
            }
            existing.PlanCode = _form.PlanCode;
            existing.PlanName = _form.PlanName;
            existing.PlanType = _form.PlanType;
            existing.Provider = _form.Provider;
            existing.GroupPolicyNumber = _form.GroupPolicyNumber;
            existing.CoverageAmount = _form.CoverageAmount;
            existing.DefaultEmployeeAmount = _form.DefaultEmployeeAmount;
            existing.DefaultCompanyAmount = _form.DefaultCompanyAmount;
            existing.SortOrder = _form.SortOrder;
            existing.EligibleEmploymentTypes = BuildEligibleTypesCsv(_form);
            existing.MinTenureDays = _form.MinTenureDays;
            existing.MinAge = _form.MinAge;
            existing.MaxAge = _form.MaxAge;
            existing.AutoEnrollEnabled = _form.AutoEnrollEnabled;
        }
        else
        {
            context.Pay_InsurancePlans.Add(new Pay_InsurancePlan
            {
                CompanyId = _companyId!,
                PlanCode = _form.PlanCode,
                PlanName = _form.PlanName,
                PlanType = _form.PlanType,
                Provider = _form.Provider,
                GroupPolicyNumber = _form.GroupPolicyNumber,
                CoverageAmount = _form.CoverageAmount,
                DefaultEmployeeAmount = _form.DefaultEmployeeAmount,
                DefaultCompanyAmount = _form.DefaultCompanyAmount,
                SortOrder = _form.SortOrder,
                IsActive = true,
                EligibleEmploymentTypes = BuildEligibleTypesCsv(_form),
                MinTenureDays = _form.MinTenureDays,
                MinAge = _form.MinAge,
                MaxAge = _form.MaxAge,
                AutoEnrollEnabled = _form.AutoEnrollEnabled,
            });
        }

        await context.SaveChangesAsync();
        Snackbar.Add(_editingId is null ? L.Translate("PlanAddedSuccess") : L.Translate("GradeEditSavedSuccess"), Severity.Success);
        CancelEdit();
        await LoadAsync();
    }

    private async Task ToggleActiveAsync(Pay_InsurancePlan plan)
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var existing = await context.Pay_InsurancePlans.FirstOrDefaultAsync(p => p.Id == plan.Id && p.CompanyId == _companyId);
        if (existing is null) return;

        existing.IsActive = !existing.IsActive;
        await context.SaveChangesAsync();
        await LoadAsync();
    }

    private async Task SyncNowAsync(Pay_InsurancePlan plan)
    {
        var eligibleCount = await AutoEnrollService.PreviewEligibleCountAsync(plan.Id);
        if (eligibleCount == 0)
        {
            Snackbar.Add(L.Translate("NoEligibleEmployeesInfo"), Severity.Info);
            return;
        }

        var confirmed = await DialogService.ShowMessageBox(
            L.Translate("ConfirmSyncTitle"),
            string.Format(L.Translate("ConfirmSyncMessageTemplate"), eligibleCount, plan.PlanName),
            yesText: L.Translate("ConfirmButton"), cancelText: L.Translate("CancelButton"));
        if (confirmed != true) return;

        var state = await AuthProvider.GetAuthenticationStateAsync();
        var userIdClaim = state.User.FindFirstValue("sc_userid");
        var userId = long.TryParse(userIdClaim, out var uid) ? uid : 0;

        var enrolledCount = await AutoEnrollService.SyncNowAsync(plan.Id, userId);
        Snackbar.Add(string.Format(L.Translate("SyncCompletedSuccessTemplate"), enrolledCount), Severity.Success);
    }
}
