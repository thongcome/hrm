@page "/pay/employees/{HremployeeId:long}/insurance"
@layout PayrollEmployeeHubLayout
@using System.Security.Claims
@using HRM.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject JsonLocalizationService L
@attribute [Authorize(Policy = "Menu:PAY_ADMIN")]

<PageTitle>@L.Translate("EmployeeInsurancePageTitle")</PageTitle>

@if (_notFound)
{
    <MudAlert Severity="Severity.Warning">@L.Translate("EmployeeDataNotFoundOrOutsideCompanyError")</MudAlert>
}
else if (_employee is null)
{
    <MudText>@L.Translate("LoadingText")</MudText>
}
else
{
    <MudPaper Class="pa-4 mb-4" MaxWidth="900px">
        <MudText Typo="Typo.h6">@L.Translate("EnrollNewPlanHeading")</MudText>
        <MudText Typo="Typo.body2" Class="mt-1">
            @L.Translate("EnrollNewPlanDesc")
        </MudText>

        @if (_availablePlans.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Class="mt-3">
                @L.Translate("NoPlansAvailablePrefix") <MudLink Href="/pay/admin/insurance-plans">@L.Translate("NoPlansAvailableLinkText")</MudLink> @L.Translate("NoPlansAvailableSuffix")
            </MudAlert>
        }
        else
        {
            <MudGrid Class="mt-2">
                <MudItem xs="12" sm="6">
                    <MudSelect T="long?" Value="_selectedPlanId" ValueChanged="OnPlanSelected" Label="@L.Translate("InsurancePlanFieldLabel")">
                        @foreach (var plan in _availablePlans)
                        {
                            <MudSelectItem T="long?" Value="@((long?)plan.Id)">@plan.PlanCode — @plan.PlanName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker Date="_effectiveFrom" DateChanged="@(d => _effectiveFrom = d)" Label="@L.Translate("EffectiveFromLabel")"
                        Editable="true" DateFormat="dd/MM/yyyy" PickerVariant="PickerVariant.Dialog" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="_employeeAmount" Label="@L.Translate("DefaultEmployeeAmountLabel")" Format="N2" Min="0" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="_companyAmount" Label="@L.Translate("DefaultCompanyAmountLabel")" Format="N2" Min="0" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_memberCertificateNumber" Label="@L.Translate("MemberCertificateNumberLabel")" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudDatePicker Date="_cardIssueDate" DateChanged="@(d => _cardIssueDate = d)" Label="@L.Translate("CardIssueDateLabel")"
                        Editable="true" DateFormat="dd/MM/yyyy" PickerVariant="PickerVariant.Dialog" Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudDatePicker Date="_cardExpiryDate" DateChanged="@(d => _cardExpiryDate = d)" Label="@L.Translate("CardExpiryDateLabel")"
                        Editable="true" DateFormat="dd/MM/yyyy" PickerVariant="PickerVariant.Dialog" Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_beneficiaryName" Label="@L.Translate("BeneficiaryNameLabel")" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_beneficiaryRelationship" Label="@L.Translate("BeneficiaryRelationshipLabel")" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_remark" Label="@L.Translate("RemarkSpecialConditionsLabel")" Lines="2" />
                </MudItem>
            </MudGrid>

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
            }

            <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="mt-3" OnClick="EnrollAsync">@L.Translate("EnrollButton")</MudButton>
        }
    </MudPaper>

    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6">@L.Translate("EnrollmentHistoryHeading")</MudText>

        @if (_enrollments.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Class="mt-3">@L.Translate("NoEnrollmentsMessage")</MudAlert>
        }
        else
        {
            <MudSimpleTable Dense="true" Class="mt-2">
                <thead>
                    <tr><th>@L.Translate("ColPlan")</th><th>@L.Translate("ColMemberCertNo")</th><th>@L.Translate("ColPremiumEmpCompany")</th><th>@L.Translate("EffectiveFromLabel")</th><th>@L.Translate("ColEnds")</th><th>@L.Translate("ColBeneficiary")</th><th>@L.Translate("ColStatus")</th><th></th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var enrollment in _enrollments)
                    {
                        <tr>
                            <td>@enrollment.Pay_InsurancePlan.PlanCode — @enrollment.Pay_InsurancePlan.PlanName</td>
                            <td>@(enrollment.MemberCertificateNumber ?? "-")</td>
                            <td>@enrollment.EmployeeAmount.ToString("N2") / @enrollment.CompanyAmount.ToString("N2")</td>
                            <td>@enrollment.EffectiveFrom.ToString("dd/MM/yyyy")</td>
                            <td>@(enrollment.EffectiveTo?.ToString("dd/MM/yyyy") ?? "-")</td>
                            <td>@(string.IsNullOrEmpty(enrollment.BeneficiaryName) ? "-" : $"{enrollment.BeneficiaryName} ({enrollment.BeneficiaryRelationship ?? "-"})")</td>
                            <td>
                                @(enrollment.IsActive ? L.Translate("PeriodActiveStatus") : L.Translate("EndedStatus"))
                                @if (enrollment.NeedsReview)
                                {
                                    <MudChip T="string" Color="Color.Warning" Size="Size.Small" Class="ml-1">@L.Translate("NeedsReviewChip")</MudChip>
                                }
                            </td>
                            <td>
                                @if (enrollment.NeedsReview)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => MarkReviewedAsync(enrollment.Id))">@L.Translate("MarkReviewedButton")</MudButton>
                                }
                            </td>
                            <td>
                                @if (enrollment.IsActive)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Warning" OnClick="@(() => EndEnrollmentAsync(enrollment.Id))">@L.Translate("EndCoverageButton")</MudButton>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    </MudPaper>
}

@code {
    [Parameter] public long HremployeeId { get; set; }

    private Hremployee? _employee;
    private bool _notFound;
    private List<Pay_InsurancePlan> _availablePlans = new();
    private List<Pay_EmployeeInsuranceEnrollment> _enrollments = new();
    private string? _companyId;

    private long? _selectedPlanId;
    private DateTime? _effectiveFrom = DateTime.Today;
    private decimal _employeeAmount;
    private decimal _companyAmount;
    private string? _memberCertificateNumber;
    private DateTime? _cardIssueDate;
    private DateTime? _cardExpiryDate;
    private string? _beneficiaryName;
    private string? _beneficiaryRelationship;
    private string? _remark;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");

        await using var context = await DbFactory.CreateDbContextAsync();

        _employee = await context.Hremployee.FirstOrDefaultAsync(e => e.id == HremployeeId && e.companyid == _companyId);
        if (_employee is null)
        {
            _notFound = true;
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();

        _availablePlans = await context.Pay_InsurancePlans
            .Where(p => p.CompanyId == _companyId && p.IsActive)
            .OrderBy(p => p.SortOrder).ThenBy(p => p.PlanCode)
            .ToListAsync();

        _enrollments = await context.Pay_EmployeeInsuranceEnrollments
            .Include(e => e.Pay_InsurancePlan)
            .Where(e => e.HremployeeId == HremployeeId)
            .OrderByDescending(e => e.EffectiveFrom)
            .ToListAsync();
    }

    private void OnPlanSelected(long? planId)
    {
        _selectedPlanId = planId;
        var plan = _availablePlans.FirstOrDefault(p => p.Id == planId);
        if (plan is not null)
        {
            _employeeAmount = plan.DefaultEmployeeAmount;
            _companyAmount = plan.DefaultCompanyAmount;
        }
    }

    private async Task EnrollAsync()
    {
        _error = null;

        if (_selectedPlanId is null)
        {
            _error = L.Translate("SelectInsurancePlanError");
            return;
        }
        if (_effectiveFrom is null)
        {
            _error = L.Translate("InvalidEffectiveDateError");
            return;
        }

        var state = await AuthProvider.GetAuthenticationStateAsync();
        var userIdClaim = state.User.FindFirstValue("sc_userid");
        var userId = long.TryParse(userIdClaim, out var uid) ? uid : 0;

        await using var context = await DbFactory.CreateDbContextAsync();

        var alreadyEnrolled = await context.Pay_EmployeeInsuranceEnrollments.AnyAsync(e =>
            e.HremployeeId == HremployeeId && e.PlanId == _selectedPlanId && e.IsActive);
        if (alreadyEnrolled)
        {
            _error = L.Translate("AlreadyEnrolledActiveError");
            return;
        }

        context.Pay_EmployeeInsuranceEnrollments.Add(new Pay_EmployeeInsuranceEnrollment
        {
            HremployeeId = HremployeeId,
            PlanId = _selectedPlanId.Value,
            EmployeeAmount = _employeeAmount,
            CompanyAmount = _companyAmount,
            EffectiveFrom = DateOnly.FromDateTime(_effectiveFrom.Value),
            IsActive = true,
            EnrolledByUserId = userId,
            MemberCertificateNumber = _memberCertificateNumber,
            CardIssueDate = _cardIssueDate is DateTime issueDate ? DateOnly.FromDateTime(issueDate) : null,
            CardExpiryDate = _cardExpiryDate is DateTime expiryDate ? DateOnly.FromDateTime(expiryDate) : null,
            BeneficiaryName = _beneficiaryName,
            BeneficiaryRelationship = _beneficiaryRelationship,
            Remark = _remark,
        });

        await context.SaveChangesAsync();
        Snackbar.Add(L.Translate("EnrolledSuccess"), Severity.Success);

        _selectedPlanId = null;
        _employeeAmount = 0;
        _companyAmount = 0;
        _memberCertificateNumber = null;
        _cardIssueDate = null;
        _cardExpiryDate = null;
        _beneficiaryName = null;
        _beneficiaryRelationship = null;
        _remark = null;
        await LoadAsync();
    }

    private async Task EndEnrollmentAsync(long enrollmentId)
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var existing = await context.Pay_EmployeeInsuranceEnrollments
            .FirstOrDefaultAsync(e => e.Id == enrollmentId && e.HremployeeId == HremployeeId);
        if (existing is null) return;

        existing.IsActive = false;
        existing.EffectiveTo = DateOnly.FromDateTime(DateTime.Today);
        await context.SaveChangesAsync();
        Snackbar.Add(L.Translate("CoverageEndedSuccess"), Severity.Success);
        await LoadAsync();
    }

    private async Task MarkReviewedAsync(long enrollmentId)
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var existing = await context.Pay_EmployeeInsuranceEnrollments
            .FirstOrDefaultAsync(e => e.Id == enrollmentId && e.HremployeeId == HremployeeId);
        if (existing is null) return;

        existing.NeedsReview = false;
        await context.SaveChangesAsync();
        Snackbar.Add(L.Translate("MarkReviewedButton"), Severity.Success);
        await LoadAsync();
    }
}
