@page "/pay/admin/prior-employer-income"
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Audit
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject IAuditLogger AuditLogger
@inject ISnackbar Snackbar
@attribute [Authorize(Policy = "Menu:PAY_ADMIN")]

<PageTitle>เงินได้จากนายจ้างเดิม</PageTitle>

<MudPaper Class="pa-4 mb-4" MaxWidth="900px">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudText Typo="Typo.h5">เงินได้จากนายจ้างเดิม (พนักงานเข้าใหม่กลางปี)</MudText>
        <MudChip T="string" Color="Color.Warning" Size="Size.Small">PDPA</MudChip>
    </MudStack>
    <MudText Typo="Typo.body2" Class="mt-1">
        กรอกจากหนังสือรับรองการหักภาษี ณ ที่จ่าย (50 ทวิ) ของนายจ้างเดิมที่พนักงานนำมายื่นตอนเข้างาน — ใช้เพื่อคำนวณภาษีหัก ณ ที่จ่ายรายเดือนให้ตรงกับเงินได้สะสมทั้งปีจริงเท่านั้น
        <b>ไม่นำไปออกหนังสือรับรองฯ ของบริษัทนี้</b> (แต่ละนายจ้างต้องออกแยกตามที่กฎหมายกำหนด)
    </MudText>

    <MudGrid Class="mt-3">
        <MudItem xs="12" sm="6">
            <MudAutocomplete T="Hremployee" Label="พนักงาน" Value="_selectedEmployee" ValueChanged="OnEmployeeChangedAsync" SearchFunc="SearchEmployeesAsync"
                ToStringFunc="@(e => e is null ? "" : $"{e.EmpNo} - {e.EmpName} {e.EmpSurname}")" ResetValueOnEmptyText="true" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudNumericField T="int" @bind-Value="_selectedYear" @bind-Value:after="LoadAsync" Label="ปีภาษี (ค.ศ.)" Min="2020" Max="2100" />
        </MudItem>
    </MudGrid>

    @if (_selectedEmployee is not null)
    {
        <MudDivider Class="my-4" />

        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
        }
        @if (!string.IsNullOrEmpty(_info))
        {
            <MudAlert Severity="Severity.Success" Class="mb-3">@_info</MudAlert>
        }

        <MudTable Items="_records" Dense="true" Hover="true">
            <HeaderContent>
                <MudTh>นายจ้างเดิม</MudTh>
                <MudTh>เงินได้สะสม</MudTh>
                <MudTh>ค่าลดหย่อนที่หักไปแล้ว</MudTh>
                <MudTh>ภาษีที่หักไว้</MudTh>
                <MudTh>สถานะ</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@(context.PriorEmployerName ?? "-")</MudTd>
                <MudTd>@context.IncomeAmount.ToString("N2")</MudTd>
                <MudTd>@context.DeductionAmount.ToString("N2")</MudTd>
                <MudTd>@context.TaxWithheldAmount.ToString("N2")</MudTd>
                <MudTd>@(context.IsActive ? "ใช้งาน" : "ปิดใช้งาน")</MudTd>
                <MudTd>
                    @if (context.IsActive)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="@(() => DeactivateAsync(context.Id))">ปิดใช้งาน</MudButton>
                    }
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.body2">ยังไม่มีข้อมูลเงินได้จากนายจ้างเดิมของพนักงานคนนี้ในปีนี้</MudText>
            </NoRecordsContent>
        </MudTable>

        <MudDivider Class="my-4" />
        <MudText Typo="Typo.subtitle1" Class="mb-2">เพิ่มข้อมูลเงินได้จากนายจ้างเดิม</MudText>
        <MudGrid>
            <MudItem xs="12" sm="6"><MudTextField T="string" @bind-Value="_newEmployerName" Label="ชื่อนายจ้างเดิม" /></MudItem>
            <MudItem xs="12" sm="6"><MudNumericField T="decimal" @bind-Value="_newIncome" Label="เงินได้สะสม (บาท)" Format="N2" Min="0" /></MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField T="decimal" @bind-Value="_newDeduction" Label="ค่าลดหย่อนที่หักไปแล้ว (บาท, ถ้าทราบ)" Format="N2" Min="0" />
            </MudItem>
            <MudItem xs="12" sm="6"><MudNumericField T="decimal" @bind-Value="_newTaxWithheld" Label="ภาษีที่หักไว้สะสม (บาท)" Format="N2" Min="0" /></MudItem>
            <MudItem xs="12"><MudTextField T="string" @bind-Value="_newNote" Label="หมายเหตุ" Lines="2" /></MudItem>
            <MudItem xs="12">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddRecordAsync">+ เพิ่มข้อมูล</MudButton>
            </MudItem>
        </MudGrid>
    }
</MudPaper>

@code {
    private Hremployee? _selectedEmployee;
    private int _selectedYear = DateTime.Today.Year;

    private List<Pay_EmployeePriorEmployerIncome> _records = new();

    private string? _newEmployerName;
    private decimal _newIncome;
    private decimal _newDeduction;
    private decimal _newTaxWithheld;
    private string? _newNote;

    private string? _error;
    private string? _info;

    private long _actorUserId;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _actorUserId = long.TryParse(state.User.FindFirst("sc_userid")?.Value, out var uid) ? uid : 0;
    }

    private async Task OnEmployeeChangedAsync(Hremployee? employee)
    {
        _selectedEmployee = employee;
        await LoadAsync();
    }

    private async Task<IEnumerable<Hremployee>> SearchEmployeesAsync(string term, CancellationToken ct)
    {
        await using var context = await DbFactory.CreateDbContextAsync(ct);
        var query = context.Hremployee.AsQueryable();
        if (!string.IsNullOrWhiteSpace(term))
            query = query.Where(e => e.EmpNo.Contains(term) || (e.EmpName != null && e.EmpName.Contains(term)) || (e.EmpSurname != null && e.EmpSurname.Contains(term)));
        return await query.OrderBy(e => e.EmpNo).Take(20).ToListAsync(ct);
    }

    private async Task LoadAsync()
    {
        _error = null;
        if (_selectedEmployee is null) return;

        await using var context = await DbFactory.CreateDbContextAsync();
        _records = await context.Pay_EmployeePriorEmployerIncomes
            .Where(p => p.HremployeeId == _selectedEmployee.id && p.TaxYear == _selectedYear)
            .OrderByDescending(p => p.EnteredDate)
            .ToListAsync();

        await AuditLogger.LogAccessAsync("Pay_EmployeePriorEmployerIncome", _selectedEmployee.id.ToString(), isSensitive: true, note: "view");
    }

    private async Task AddRecordAsync()
    {
        _error = null;
        _info = null;
        if (_selectedEmployee is null)
        {
            _error = "กรุณาเลือกพนักงาน";
            return;
        }
        if (_newIncome <= 0)
        {
            _error = "กรุณาระบุเงินได้สะสมจากนายจ้างเดิม";
            return;
        }

        await using var context = await DbFactory.CreateDbContextAsync();
        var duplicate = await context.Pay_EmployeePriorEmployerIncomes
            .AnyAsync(p => p.HremployeeId == _selectedEmployee.id && p.TaxYear == _selectedYear && p.IsActive);
        if (duplicate)
        {
            _error = $"มีข้อมูลเงินได้จากนายจ้างเดิมของพนักงานคนนี้สำหรับปี {_selectedYear} อยู่แล้ว — ปิดใช้งานรายการเดิมก่อนถ้าต้องการแก้ไข";
            return;
        }

        context.Pay_EmployeePriorEmployerIncomes.Add(new Pay_EmployeePriorEmployerIncome
        {
            HremployeeId = _selectedEmployee.id,
            TaxYear = _selectedYear,
            PriorEmployerName = _newEmployerName,
            IncomeAmount = _newIncome,
            DeductionAmount = _newDeduction,
            TaxWithheldAmount = _newTaxWithheld,
            Note = _newNote,
            EnteredByUserId = _actorUserId,
        });
        await context.SaveChangesAsync();

        _info = "บันทึกข้อมูลเงินได้จากนายจ้างเดิมเรียบร้อย — มีผลกับการคำนวณเงินเดือนงวดถัดไป";
        Snackbar.Add(_info, Severity.Success);
        _newEmployerName = null;
        _newIncome = 0;
        _newDeduction = 0;
        _newTaxWithheld = 0;
        _newNote = null;
        await LoadAsync();
    }

    private async Task DeactivateAsync(long id)
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var record = await context.Pay_EmployeePriorEmployerIncomes.FirstOrDefaultAsync(p => p.Id == id);
        if (record is null) return;

        record.IsActive = false;
        await context.SaveChangesAsync();

        Snackbar.Add("ปิดใช้งานเรียบร้อย", Severity.Success);
        await LoadAsync();
    }
}
