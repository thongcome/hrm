@page "/com_organize_layers/delete"
@using Microsoft.EntityFrameworkCore
@using HRM.Models
@inject IDbContextFactory<HRM.Models.HRMContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>com_organize_layer</h2>
    <hr />
    @if (com_organize_layer is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">layercode</dt>
            <dd class="col-sm-10">@com_organize_layer.layercode</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">name</dt>
            <dd class="col-sm-10">@com_organize_layer.name</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">name_en</dt>
            <dd class="col-sm-10">@com_organize_layer.name_en</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">layer</dt>
            <dd class="col-sm-10">@com_organize_layer.layer</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">modby</dt>
            <dd class="col-sm-10">@com_organize_layer.modby</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">moddate</dt>
            <dd class="col-sm-10">@com_organize_layer.moddate</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">isActive</dt>
            <dd class="col-sm-10">@com_organize_layer.isActive</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">remark</dt>
            <dd class="col-sm-10">@com_organize_layer.remark</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">group_layer</dt>
            <dd class="col-sm-10">@com_organize_layer.group_layer</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">abbr</dt>
            <dd class="col-sm-10">@com_organize_layer.abbr</dd>
        </dl>
        <EditForm method="post" Model="com_organize_layer" OnValidSubmit="Deletecom_organize_layer" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(com_organize_layer is null)">Delete</button> |
            <a href="/com_organize_layers">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private com_organize_layer? com_organize_layer;

    [SupplyParameterFromQuery]
    private long id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        com_organize_layer = await context.com_organize_layers.FirstOrDefaultAsync(m => m.id == id);

        if (com_organize_layer is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task Deletecom_organize_layer()
    {
        using var context = DbFactory.CreateDbContext();
        context.com_organize_layers.Remove(com_organize_layer!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/com_organize_layers");
    }
}
