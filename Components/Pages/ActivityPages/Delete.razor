@page "/activities/delete"
@using Microsoft.EntityFrameworkCore
@using LeaderDevelop.Model
@inject IDbContextFactory<LeaderDevelop.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Activity</h2>
    <hr />
    @if (activity is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">TaskId</dt>
            <dd class="col-sm-10">@activity.TaskId</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Name</dt>
            <dd class="col-sm-10">@activity.Name</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">StartDate</dt>
            <dd class="col-sm-10">@activity.StartDate</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">EndDate</dt>
            <dd class="col-sm-10">@activity.EndDate</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Order</dt>
            <dd class="col-sm-10">@activity.Orders</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Description</dt>
            <dd class="col-sm-10">@activity.Description</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Lesson1</dt>
            <dd class="col-sm-10">@activity.Lesson1</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Lesson2</dt>
            <dd class="col-sm-10">@activity.Lesson2</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">ThankFully</dt>
            <dd class="col-sm-10">@activity.ThankFully</dd>
        </dl>
   @*      <dl class="row">
            <dt class="col-sm-2">IsActive</dt>
            <dd class="col-sm-10">@activity.IsActive</dd>
        </dl> *@
        <dl class="row">
            <dt class="col-sm-2">StatusCode</dt>
            <dd class="col-sm-10">@activity.StatusCode</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Modby</dt>
            <dd class="col-sm-10">@activity.Modby</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">CreateBy</dt>
            <dd class="col-sm-10">@activity.CreateBy</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">CreateDate</dt>
            <dd class="col-sm-10">@activity.CreateDate</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">ModDate</dt>
            <dd class="col-sm-10">@activity.ModDate</dd>
        </dl>
        <EditForm method="post" Model="activity" OnValidSubmit="DeleteActivity" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(activity is null)">Delete</button> |
            <a href="/activities">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private Activity? activity;

    [SupplyParameterFromQuery]
    private int SubId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        activity = await context.Activity.FirstOrDefaultAsync(m => m.Id == SubId);

        if (activity is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteActivity()
    {
        using var context = DbFactory.CreateDbContext();
        context.Activity.Remove(activity!);
        // await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/activities");
    }
}
