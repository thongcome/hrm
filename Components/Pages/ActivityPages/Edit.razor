@page "/activities/edit"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using LeaderDevelop.Model
@using System.ComponentModel.DataAnnotations
@inject IDbContextFactory<LeaderDevelop.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@inject ActivityService ActivityService


@attribute [Authorize]

<PageTitle>จัดการกิจกรรม/Manage Activities</PageTitle>



<h2>จัดการกิจกรรม/Manage Activities</h2>
<hr />
@if (Activity is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Activity" OnValidSubmit="UpdateActivity" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary />
                <input type="hidden" name="Activity.SubId" value="@Activity.Id" />
                <div class="mb-3">
                    @*                     <label for="taskid" class="form-label">TaskId:</label>
 *@          
                    <InputNumber id="taskid" @bind-Value="Activity.TaskId" class="form-control" hidden />
                    <ValidationMessage For="() => Activity.TaskId" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="order" class="form-label">
                        @((typeof(Activity).GetProperty(nameof(Activity.Orders))?.GetCustomAttributes(typeof(DisplayAttribute), false)
                                            .FirstOrDefault() as DisplayAttribute)?.Name ?? "Order")
                    </label>
                    <InputNumber id="order" @bind-Value="Activity.Orders" class="form-control" readonly />
                    <ValidationMessage For="() => Activity.Orders" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="name" class="form-label">
                        @((typeof(Activity).GetProperty(nameof(Activity.Name))?.GetCustomAttributes(typeof(DisplayAttribute), false)
                                            .FirstOrDefault() as DisplayAttribute)?.Name ?? "Start Date")
                    </label>
                    <InputText id="name" @bind-Value="Activity.Name" class="form-control"  />
                    <ValidationMessage For="() => Activity.Name" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="startdate" class="form-label">
                        @((typeof(Activity).GetProperty(nameof(Activity.StartDate))?.GetCustomAttributes(typeof(DisplayAttribute), false)
                                            .FirstOrDefault() as DisplayAttribute)?.Name ?? "Start Date")
                    </label>
                    <InputDate id="startdate" @bind-Value="Activity.StartDate" class="form-control"  />
                    <ValidationMessage For="() => Activity.StartDate" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="enddate" class="form-label">
                        @((typeof(Activity).GetProperty(nameof(Activity.EndDate))?.GetCustomAttributes(typeof(DisplayAttribute), false)
                                            .FirstOrDefault() as DisplayAttribute)?.Name ?? "End Date")
                    </label>
                    <InputDate id="enddate" @bind-Value="Activity.EndDate" class="form-control"  />
                    <ValidationMessage For="() => Activity.EndDate" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label for="description" class="form-label">
                        @((typeof(Activity).GetProperty(nameof(Activity.Description))?.GetCustomAttributes(typeof(DisplayAttribute), false)
                                            .FirstOrDefault() as DisplayAttribute)?.Name ?? "Note")
                    </label>
                    <InputText id="description" @bind-Value="Activity.Description" class="form-control" />
                    <ValidationMessage For="() => Activity.Description" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="statuscode" class="form-label">
                        @((typeof(Activity).GetProperty(nameof(Activity.StatusCode))?.GetCustomAttributes(typeof(DisplayAttribute), false)
                                            .FirstOrDefault() as DisplayAttribute)?.Name ?? "Status")
                    </label>
                    <p> @Activity.StatusCode</p>

                </div>

                <div class="mb-3">
                    <label for="progress" class="form-label">
                        @((typeof(Activity).GetProperty(nameof(Activity.progress))?.GetCustomAttributes(typeof(DisplayAttribute), false)
                                            .FirstOrDefault() as DisplayAttribute)?.Name ?? "Progress")
                    </label>
                    <InputNumber id="progress" @bind-Value="Activity.progress" class="form-control" />
                    <ValidationMessage For="() => Activity.progress" class="text-danger" />
                </div>
                @*  <div class="mb-3">
                    <label for="lesson1" class="form-label">Lesson1:</label>
                    <InputText id="lesson1" @bind-Value="Activity.Lesson1" class="form-control" />
                    <ValidationMessage For="() => Activity.Lesson1" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="lesson2" class="form-label">Lesson2:</label>
                    <InputText id="lesson2" @bind-Value="Activity.Lesson2" class="form-control" />
                    <ValidationMessage For="() => Activity.Lesson2" class="text-danger" />
                </div> *@
                <div class="mb-3">
                    <label for="thankfully" class="form-label">
                        @((typeof(Activity).GetProperty(nameof(Activity.ThankFully))?.GetCustomAttributes(typeof(DisplayAttribute), false)
                                            .FirstOrDefault() as DisplayAttribute)?.Name ?? "Order")
                    </label>
                    <InputTextArea id="ThankFully" @bind-Value="Activity.ThankFully" class="form-control" />

                    @*                     <InputText id="thankfully" @bind-Value="Activity.ThankFully" class="form-control" />
 *@                    <ValidationMessage For="() => Activity.ThankFully" class="text-danger" />
                </div>
                @*        <div class="mb-3">
            <label for="isactive" class="form-label">IsActive:</label>
            <InputCheckbox id="isactive" @bind-Value="Activity.IsActive" class="form-check-input" />
            <ValidationMessage For="() => Activity.IsActive" class="text-danger" />
            </div> *@
                @*  <div class="mb-3">
            <label for="statuscode" class="form-label">StatusCode:</label>
            <InputText id="statuscode" @bind-Value="Activity.StatusCode" class="form-control" />
            <ValidationMessage For="() => Activity.StatusCode" class="text-danger" />
            </div> *@

                @*  <div class="mb-3">
                    <label for="statuscode" class="form-label">Progress:</label>
                    <InputNumber id="progress" @bind-Value="Activity.progress" class="form-control" />
                    <ValidationMessage For="() => Activity.progress" class="text-danger" />
                </div> *@

                <button type="submit" class="btn btn-primary">Update</button>       
                <button type="button" class="btn btn-success" @onclick="SucessActivity">สำเร้จ/Sucess</button>
@*                 <button type="submit" class="btn btn-danger" @onclick="DeleteActivityAsync">ลบกิจกรรม/Delete </button>
 *@               
                <a href="@($"activities/delete?subid={Activity.Id}")" class="btn btn-danger">Delete</a>

            </EditForm>

        </div>
    </div>
}


@code {
    [SupplyParameterFromQuery]
    private int SubId { get; set; }

    private const int V = 0;


    private Activity? Activity { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Activity ??= await context.Activity.FirstOrDefaultAsync(m => m.Id == SubId);

        if (Activity is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateActivity()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(Activity!).State = EntityState.Modified;
        if (Activity is not null)
        {
            Activity.ModDate = DateTime.Now;
            Activity.StatusCode = Activity.ActivityStatus.Active;


            try
            {
                if(Activity.progress == 100)
                {
                    await SucessActivity();
                }
                else
                {
                    await ActivityService.UpdateActivityAsync(Activity);

                }
                await ActivityService.UpdateActivityAsync(Activity);

                // await updateProgressToGoal(Activity.TaskId);

                await context.SaveChangesAsync();
            }
            catch (DbUpdateConcurrencyException)
            {
                if (!ActivityExists(Activity!.Id))
                {
                    NavigationManager.NavigateTo("notfound");
                }
                else
                {
                    throw;
                }
            }
        }
        NavigationManager.NavigateTo("/goaltasks/details/" + Activity!.TaskId);
    }
    private async Task DeleteActivityAsync()
    {
        try
        {
            await ActivityService.DeleteActivityAsync(SubId);

        }catch(Exception e){

            e.Message.ToString();
            return;
        }
    NavigationManager.NavigateTo("/goaltasks/details/" + Activity!.TaskId);

    }
    private async Task SucessActivity()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(Activity!).State = EntityState.Modified;
        if (Activity is not null)
        {
            Activity.ModDate = DateTime.Now;
            Activity.progress = 100;
            Activity.StatusCode = Activity.ActivityStatus.Success;


            try
            {
                await ActivityService.UpdateActivityAsync(Activity);

                // await updateProgressToGoal(Activity.TaskId);
                // await context.SaveChangesAsync();

            }
            catch (DbUpdateConcurrencyException)
            {
                if (!ActivityExists(Activity!.Id))
                {
                    NavigationManager.NavigateTo("notfound");
                }
                else
                {
                    throw;
                }
            }
        }

        NavigationManager.NavigateTo("/goaltasks/details/" + Activity!.TaskId);
    }
    private bool ActivityExists(int subid)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Activity.Any(e => e.Id == subid);
    }

    public async Task updateProgressToGoal(int taskid)
    {
        try
        {
            decimal sum = 0.00M;
            decimal avg = 0.00M;
            using var context = DbFactory.CreateDbContext();
            List<Activity> activitires = new List<Activity>();
            var goal = await context.GoalTasks.FindAsync(taskid);
            if (goal is not null)
            {


                activitires = await context.Activity.Where(b => b.TaskId == taskid && b.StatusCode == Activity.ActivityStatus.Active).ToListAsync();

                foreach (var item in activitires)
                {
                    if (item.progress is null)
                    {
                        item.progress = 0;
                    }
                    sum += (decimal)item.progress;

                }
                avg = sum / activitires.Count();

                goal.progress = avg;
                 context.SaveChanges();
            }

        }
        catch (Exception e)
        {
            e.Message.ToString();
        }






    }
}
