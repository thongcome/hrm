@page "/activities/editfull"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using HRM.Model
@inject IDbContextFactory<HRM.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>Activity</h2>
<hr />
@if (Activity is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Activity" OnValidSubmit="UpdateActivity" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary />
                <input type="hidden" name="Activity.SubId" value="@Activity.Id" />
                <div class="mb-3">
                    <label for="taskid" class="form-label">TaskId:</label>
                    <InputNumber id="taskid" @bind-Value="Activity.TaskId" class="form-control" />
                    <ValidationMessage For="() => Activity.TaskId" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="name" class="form-label">Name:</label>
                    <InputText id="name" @bind-Value="Activity.Name" class="form-control" />
                    <ValidationMessage For="() => Activity.Name" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="startdate" class="form-label">StartDate:</label>
                    <InputDate id="startdate" @bind-Value="Activity.StartDate" class="form-control" />
                    <ValidationMessage For="() => Activity.StartDate" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="enddate" class="form-label">EndDate:</label>
                    <InputDate id="enddate" @bind-Value="Activity.EndDate" class="form-control" />
                    <ValidationMessage For="() => Activity.EndDate" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="order" class="form-label">Order:</label>
                    <InputNumber id="order" @bind-Value="Activity.Orders" class="form-control" />
                    <ValidationMessage For="() => Activity.Orders" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="description" class="form-label">Description:</label>
                    <InputText id="description" @bind-Value="Activity.Description" class="form-control" />
                    <ValidationMessage For="() => Activity.Description" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="lesson1" class="form-label">Lesson1:</label>
                    <InputText id="lesson1" @bind-Value="Activity.Lesson1" class="form-control" />
                    <ValidationMessage For="() => Activity.Lesson1" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="lesson2" class="form-label">Lesson2:</label>
                    <InputText id="lesson2" @bind-Value="Activity.Lesson2" class="form-control" />
                    <ValidationMessage For="() => Activity.Lesson2" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="thankfully" class="form-label">ThankFully:</label>
                    <InputText id="thankfully" @bind-Value="Activity.ThankFully" class="form-control" />
                    <ValidationMessage For="() => Activity.ThankFully" class="text-danger" />
                </div>
         @*        <div class="mb-3">
                    <label for="isactive" class="form-label">IsActive:</label>
                    <InputCheckbox id="isactive" @bind-Value="Activity.IsActive" class="form-check-input" />
                    <ValidationMessage For="() => Activity.IsActive" class="text-danger" />
                </div> *@
                <div class="mb-3">
                    <label for="statuscode" class="form-label">Status Code:</label>
                    <InputSelect id="statuscode" @bind-Value="Activity.StatusCode" class="form-control">
                        @foreach (var status in Enum.GetValues(typeof(System.Diagnostics.ActivityStatusCode)))
                        {
                            <option value="@status">@status</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => Activity.StatusCode" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="modby" class="form-label">Modby:</label>
                    <InputText id="modby" @bind-Value="Activity.Modby" class="form-control" />
                    <ValidationMessage For="() => Activity.Modby" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="createby" class="form-label">CreateBy:</label>
                    <InputText id="createby" @bind-Value="Activity.CreateBy" class="form-control" />
                    <ValidationMessage For="() => Activity.CreateBy" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="createdate" class="form-label">CreateDate:</label>
                    <InputDate id="createdate" @bind-Value="Activity.CreateDate" class="form-control" />
                    <ValidationMessage For="() => Activity.CreateDate" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="moddate" class="form-label">ModDate:</label>
                    <InputDate id="moddate" @bind-Value="Activity.ModDate" class="form-control" />
                    <ValidationMessage For="() => Activity.ModDate" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/activities">Back to List</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int SubId { get; set; }

    [SupplyParameterFromForm]
    private Activity? Activity { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Activity ??= await context.Activity.FirstOrDefaultAsync(m => m.Id == SubId);

        if (Activity is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateActivity()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(Activity!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!ActivityExists(Activity!.Id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/activities");
    }

    private bool ActivityExists(int subid)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Activity.Any(e => e.Id == subid);
    }
}
