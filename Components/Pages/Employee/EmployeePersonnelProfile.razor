@page "/employee/personnel-profile"
@page "/employee/personnel-profile/{Id:long}"
@using HRM.Models
@using HRM.Services.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject NavigationManager Nav
@attribute [Authorize(Policy = "Menu:PAY_ADMIN")]

@* Additional employee master-record screen — mirrors the layout of the legacy
   "ข้อมูลบุคลากร" (Personnel Information) screen (header bar + horizontal
   tabs covering general info / family / education / experience / evaluation /
   position history / committee history / file upload) requested alongside a
   reference screenshot. Deliberately additive: does not replace or remove
   /employee, /employee/{id}/*, or /pay/employees — those keep working exactly
   as before. Everywhere a tab's data already has a home in this codebase
   (Hrd_Family/Hrd_Education/Hrd_Experience/Hrd_ContactPerson/address/
   Pay_PositionSalaryHistory/Perf_EvaluationInstance/doc_center) this page
   reads that same table rather than inventing a parallel copy. Committee
   history ("ประวัติทำงานในคณะทำงาน") is no exception: it has no table of its
   own either — it reads Hrd_EmploymentHistory rows whose position is tagged
   Pos_EmployeeType "กรรมการ" (see the query in OnParametersSetAsync), and the
   tab hides itself entirely when the employee has none, per instruction —
   no separate committee module needed. *@

<PageTitle>ข้อมูลบุคลากร</PageTitle>

<MudPaper Class="pa-4 mb-4">
    <MudText Typo="Typo.h5" Class="mb-2">ข้อมูลบุคลากร</MudText>
    <MudAutocomplete T="Hremployee" Label="ค้นหา (รหัสพนักงาน / ชื่อ / นามสกุล / ชื่อเล่น / เลขบัตรประชาชน / รหัสตำแหน่ง / รหัสกลุ่มงาน)"
        Value="_selected" ValueChanged="OnPickedAsync"
        SearchFunc="SearchAsync" ToStringFunc="@(e => e == null ? null : $"{e.EmpNo} — {e.EmpName} {e.EmpSurname}")"
        ResetValueOnEmptyText="true" CoerceText="true" MinCharacters="1"
        AdornmentIcon="@Icons.Material.Filled.Search" Adornment="Adornment.Start" />
</MudPaper>

@if (Id == 0)
{
    <MudAlert Severity="Severity.Info" Class="ma-4">พิมพ์คำค้นด้านบนแล้วเลือกพนักงานเพื่อดูข้อมูล — ค้นได้จากรหัสพนักงาน ชื่อ นามสกุล ชื่อเล่น เลขบัตรประชาชน หรือรหัสตำแหน่ง/กลุ่มงาน ทีเดียวพร้อมกัน</MudAlert>
}
else
{
    <PersonnelProfileView HremployeeId="@Id" />
}

@code {
    [Parameter] public long Id { get; set; }

    private Hremployee? _selected;

    // Only loads enough to show the picked employee's name back in the search
    // box above — the actual profile data (all tabs, PDPA audit log call
    // included) is loaded independently by <PersonnelProfileView> itself.
    protected override async Task OnParametersSetAsync()
    {
        if (Id == 0) { _selected = null; return; }

        await using var context = await DbFactory.CreateDbContextAsync();
        _selected = await context.Hremployee.FirstOrDefaultAsync(e => e.id == Id);
    }

    private async Task<IEnumerable<Hremployee>> SearchAsync(string search, CancellationToken ct)
    {
        try
        {
            await using var context = await DbFactory.CreateDbContextAsync(ct);
            var query = EntitySearchHelper.ApplyTextSearch(context.Hremployee.AsQueryable(), search,
                nameof(Hremployee.EmpNo), nameof(Hremployee.EmpName), nameof(Hremployee.EmpSurname),
                nameof(Hremployee.EmpNickname), nameof(Hremployee.EmpEname), nameof(Hremployee.EmpEsurname),
                nameof(Hremployee.IdCard), nameof(Hremployee.DeptgrpCode), nameof(Hremployee.PosCode));
            return await query.OrderBy(e => e.EmpNo).Take(20).ToListAsync(ct);
        }
        catch (OperationCanceledException)
        {
            // MudAutocomplete cancels the in-flight search on every further
            // keystroke — routine, not an error worth a console stack trace.
            return Enumerable.Empty<Hremployee>();
        }
    }

    private Task OnPickedAsync(Hremployee? emp)
    {
        if (emp is not null) Nav.NavigateTo($"/employee/personnel-profile/{emp.id}");
        return Task.CompletedTask;
    }
}
