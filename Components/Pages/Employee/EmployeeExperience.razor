@page "/employee/{Id:long}/experience"
@layout EmployeeHubLayout
@using HRM.Models
@using HRM.Services.Audit
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject IAuditLogger AuditLogger
@inject ISnackbar Snackbar
@attribute [Authorize(Policy = "Menu:PAY_ADMIN")]

<PageTitle>ประสบการณ์ก่อนเข้าทำงาน</PageTitle>

@if (_emp is null)
{
    <MudAlert Severity="Severity.Warning" Class="ma-4">ไม่พบข้อมูลพนักงาน</MudAlert>
}
else
{
    <MudPaper Class="pa-4 mb-4" MaxWidth="900px">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudText Typo="Typo.h5">ประสบการณ์ก่อนเข้าทำงาน — @_emp.EmpName @_emp.EmpSurname (@_emp.EmpNo)</MudText>
            <MudChip T="string" Color="Color.Warning" Size="Size.Small">PDPA</MudChip>
        </MudStack>
        <MudDivider Class="my-4" />

        <MudStack Row="true" Justify="Justify.FlexEnd" Class="mb-2">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreate">+ เพิ่มประสบการณ์</MudButton>
        </MudStack>

        @if (_showForm)
        {
            <MudText Typo="Typo.h6">@(_editingId is null ? "เพิ่มประสบการณ์" : "แก้ไข")</MudText>
            <MudGrid Class="mt-1">
                <MudItem xs="12" sm="6"><MudTextField @bind-Value="_company" Label="บริษัท" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField @bind-Value="_position" Label="ตำแหน่ง" /></MudItem>
                <MudItem xs="12" sm="6"><MudDatePicker Label="วันที่เริ่มงาน" @bind-Date="_startDate" Editable="true" DateFormat="dd/MM/yyyy" /></MudItem>
                <MudItem xs="12" sm="6"><MudDatePicker Label="วันที่สิ้นสุด" @bind-Date="_endDate" Editable="true" DateFormat="dd/MM/yyyy" /></MudItem>
                <MudItem xs="12"><MudTextField @bind-Value="_remark" Label="หมายเหตุ" /></MudItem>
            </MudGrid>

            <MudStack Row="true" Spacing="2" Class="mt-3">
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">บันทึก</MudButton>
                <MudButton Variant="Variant.Text" OnClick="CancelEdit">ยกเลิก</MudButton>
            </MudStack>

            <MudDivider Class="my-5" />
        }

        <MudTable Items="_items" Dense="true" Hover="true">
            <HeaderContent>
                <MudTh>บริษัท</MudTh>
                <MudTh>ตำแหน่ง</MudTh>
                <MudTh>ช่วงเวลา</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Company</MudTd>
                <MudTd>@context.Position</MudTd>
                <MudTd>@(context.StartDate?.ToString("dd/MM/yyyy")) - @(context.EndDate?.ToString("dd/MM/yyyy"))</MudTd>
                <MudTd>
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => StartEdit(context))">แก้ไข</MudButton>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.body2">ยังไม่มีข้อมูล</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
}

@code {
    [Parameter] public long Id { get; set; }

    private Hremployee? _emp;
    private List<Hrd_Experience> _items = new();
    private long? _editingId;
    private bool _showForm;

    private string? _company;
    private string? _position;
    private DateTime? _startDate;
    private DateTime? _endDate;
    private string? _remark;

    protected override async Task OnParametersSetAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        _emp = await context.Hremployee.FirstOrDefaultAsync(e => e.id == Id);
        if (_emp is null) return;

        await AuditLogger.LogAccessAsync("Hrd_Experience", Id.ToString(), isSensitive: true, note: "employee experience history view");
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        _items = await context.Hrd_Experiences.Where(e => e.HremployeeId == Id).OrderByDescending(e => e.StartDate).ToListAsync();
    }

    private void OpenCreate()
    {
        CancelEdit();
        _showForm = true;
    }

    private void StartEdit(Hrd_Experience item)
    {
        _editingId = item.Id;
        _company = item.Company;
        _position = item.Position;
        _startDate = item.StartDate?.ToDateTime(TimeOnly.MinValue);
        _endDate = item.EndDate?.ToDateTime(TimeOnly.MinValue);
        _remark = item.Remark;
        _showForm = true;
    }

    private void CancelEdit()
    {
        _editingId = null;
        _company = null; _position = null; _startDate = null; _endDate = null; _remark = null;
        _showForm = false;
    }

    private async Task SaveAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var startDate = _startDate is null ? (DateOnly?)null : DateOnly.FromDateTime(_startDate.Value);
        var endDate = _endDate is null ? (DateOnly?)null : DateOnly.FromDateTime(_endDate.Value);

        if (_editingId is long id)
        {
            var existing = await context.Hrd_Experiences.FirstOrDefaultAsync(e => e.Id == id && e.HremployeeId == Id);
            if (existing is null) return;
            existing.Company = _company; existing.Position = _position;
            existing.StartDate = startDate; existing.EndDate = endDate;
            existing.Remark = _remark; existing.ModDate = DateTime.Now;
        }
        else
        {
            context.Hrd_Experiences.Add(new Hrd_Experience
            {
                HremployeeId = Id, Company = _company, Position = _position,
                StartDate = startDate, EndDate = endDate, Remark = _remark, ModDate = DateTime.Now,
            });
        }

        await context.SaveChangesAsync();
        Snackbar.Add("บันทึกเรียบร้อย", Severity.Success);
        CancelEdit();
        await LoadAsync();
    }
}
