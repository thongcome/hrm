<div>
    <a href="/emp_overtime_requests">Back to List</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private long id { get; set; }

    [SupplyParameterFromForm]
    private emp_overtime_request? emp_overtime_request { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        emp_overtime_request ??= await context.emp_overtime_requests.FirstOrDefaultAsync(m => m.id == id);

        if (emp_overtime_request is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task Updateemp_overtime_request()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(emp_overtime_request!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!emp_overtime_requestExists(emp_overtime_request!.id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/emp_overtime_requests");
    }

    private bool emp_overtime_requestExists(long id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.emp_overtime_requests.Any(e => e.id == id);
    }
}
