@page "/org/set-boss"
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Shared
@using HRM.Services.Org
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthProvider
@inject OrgChangeRequestService ChangeRequestService
@attribute [Authorize(Policy = "Menu:ORG_ADMIN")]

<PageTitle>แสดงกำหนดหัวหน้า</PageTitle>

<MudPaper Class="pa-4 mb-4" MaxWidth="1000px">
    <MudText Typo="Typo.h5">แสดงกำหนดหัวหน้า (Set Boss)</MudText>
    <MudText Typo="Typo.body2" Class="mt-1">
        กำหนดผู้อนุมัติ/หัวหน้าประจำแต่ละสังกัด — ใช้ค่านี้เป็นผู้อนุมัติจริงของสาย Vertical ใน workflow (ตรงกับ com_organization.approver_empid ที่มีอยู่แล้ว)
    </MudText>

    <MudDivider Class="my-4" />

    @if (_assigningOrg is not null)
    {
        <MudPaper Class="pa-3 mb-3" Outlined="true">
            <MudText Typo="Typo.subtitle1" Class="mb-2">กำหนดหัวหน้าให้: @_assigningOrg.code — @_assigningOrg.name</MudText>
            <MudAutocomplete T="Hremployee" Label="หัวหน้า" Value="_selectedEmployee" ValueChanged="OnEmployeeSelected"
                SearchFunc="SearchEmployeesAsync"
                ToStringFunc="@(e => e == null ? null : $"{e.EmpNo} — {e.EmpName} {e.EmpSurname}")"
                ResetValueOnEmptyText="true" CoerceText="true" MinCharacters="0" Clearable="true" />
            <MudDatePicker Label="วันที่มีผล" @bind-Date="_effectiveFrom" Editable="true" DateFormat="dd/MM/yyyy" Required="true" Class="mt-2" />
            <MudTextField @bind-Value="_requestNote" Label="เหตุผล/หมายเหตุคำขอ (ถ้ามี)" Class="mt-2" />
            <MudAlert Severity="Severity.Info" Class="mt-2">การเปลี่ยนหัวหน้าต้องผ่านการอนุมัติก่อนจึงจะมีผลจริง</MudAlert>
            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mt-2">@_error</MudAlert>
            }
            <MudStack Row="true" Spacing="2" Class="mt-3">
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveBossAsync">ส่งคำขอ</MudButton>
                <MudButton Variant="Variant.Text" OnClick="@(() => _assigningOrg = null)">ยกเลิก</MudButton>
            </MudStack>
        </MudPaper>
    }

    <MudTextField T="string" Value="_searchTerm" Label="ค้นหา (รหัสสังกัด / ชื่อสังกัด)" Immediate="true"
        DebounceInterval="300" ValueChanged="OnSearchChanged"
        AdornmentIcon="@Icons.Material.Filled.Search" Adornment="Adornment.Start" Class="mb-3" />

    <MudTable Items="_organizations" Dense="true" Hover="true">
        <HeaderContent>
            <MudTh>ลำดับ</MudTh>
            <MudTh>รหัสสังกัด</MudTh>
            <MudTh>สังกัด</MudTh>
            <MudTh>หัวหน้า</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@(_organizations.IndexOf(context) + 1)</MudTd>
            <MudTd>@context.code</MudTd>
            <MudTd>@context.name</MudTd>
            <MudTd>@(context.approver_name ?? "— ยังไม่ได้กำหนด —")</MudTd>
            <MudTd>
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => StartAssign(context))">กำหนดหัวหน้า</MudButton>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2">ไม่พบข้อมูล</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private List<com_organization> _organizations = new();
    private string? _searchTerm;
    private com_organization? _assigningOrg;
    private Hremployee? _selectedEmployee;
    private DateTime? _effectiveFrom = DateTime.Today.AddDays(1);
    private string? _requestNote;
    private string? _error;
    private long _actorUserId;
    private string? _actorEmpId;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _actorUserId = long.TryParse(state.User.FindFirstValue("sc_userid"), out var uid) ? uid : 0;
        _actorEmpId = state.User.FindFirstValue("empno");

        await ChangeRequestService.ApplyDueChangesAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var query = context.com_organizations.Where(o => o.isActive);
        query = EntitySearchHelper.ApplyTextSearch(query, _searchTerm, nameof(com_organization.code), nameof(com_organization.name));
        _organizations = await query.OrderBy(o => o.orgcodefull).ToListAsync();
    }

    private async Task OnSearchChanged(string term)
    {
        _searchTerm = term;
        await LoadAsync();
    }

    private void StartAssign(com_organization org)
    {
        _assigningOrg = org;
        _selectedEmployee = null;
        _effectiveFrom = DateTime.Today.AddDays(1);
        _requestNote = null;
        _error = null;
    }

    private void OnEmployeeSelected(Hremployee? emp) => _selectedEmployee = emp;

    private async Task<IEnumerable<Hremployee>> SearchEmployeesAsync(string search, CancellationToken ct)
    {
        await using var context = await DbFactory.CreateDbContextAsync(ct);
        var query = context.Hremployee.AsQueryable();
        if (!string.IsNullOrWhiteSpace(search))
        {
            query = query.Where(e => e.EmpNo.Contains(search)
                || (e.EmpName != null && e.EmpName.Contains(search))
                || (e.EmpSurname != null && e.EmpSurname.Contains(search)));
        }
        return await query.OrderBy(e => e.EmpNo).Take(20).ToListAsync(ct);
    }

    private async Task SaveBossAsync()
    {
        _error = null;
        if (_assigningOrg is null || _selectedEmployee is null) return;
        if (_effectiveFrom is null)
        {
            _error = "กรุณาระบุวันที่มีผล";
            return;
        }

        try
        {
            var reqId = await ChangeRequestService.SubmitAsync(new Org_OrganizationChangeRequest
            {
                ChangeType = OrgOrganizationChangeType.ChangeApprover,
                TargetOrganizationId = _assigningOrg.id,
                TargetOrganizationCode = _assigningOrg.code,
                OldApproverEmpId = _assigningOrg.approver_empid,
                OldApproverName = _assigningOrg.approver_name,
                NewApproverEmpId = _selectedEmployee.EmpNo,
                NewApproverName = $"{_selectedEmployee.EmpName} {_selectedEmployee.EmpSurname}",
                EffectiveFrom = DateOnly.FromDateTime(_effectiveFrom.Value),
                RequestNote = _requestNote,
            }, _actorUserId, _actorEmpId);

            Snackbar.Add($"ส่งคำขอเปลี่ยนหัวหน้าเข้าสู่การอนุมัติแล้ว (คำขอ #{reqId}) — จะมีผลวันที่ {_effectiveFrom:dd/MM/yyyy} หลังได้รับอนุมัติ", Severity.Info);
            _assigningOrg = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = "ส่งคำขอไม่สำเร็จ: " + ex.Message;
        }
    }
}
