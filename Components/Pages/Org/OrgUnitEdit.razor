@page "/org/organizations/{Id:long}/edit"
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Shared
@using HRM.Services.Org
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject OrgChangeRequestService ChangeRequestService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@attribute [Authorize(Policy = "Menu:ORG_ADMIN")]

<PageTitle>แก้ไขข้อมูลสังกัด</PageTitle>

@if (_notFound)
{
    <MudAlert Severity="Severity.Warning" Class="ma-4">ไม่พบข้อมูลสังกัดนี้</MudAlert>
}
else if (_loaded is false)
{
    <MudText Class="ma-4">กำลังโหลด...</MudText>
}
else
{
    <MudPaper Class="pa-4 mb-4" MaxWidth="900px">
        <MudButton Class="mb-2" Variant="Variant.Text" Href="@($"/org/organizations/{Id}")">← กลับไปหน้าดูข้อมูล</MudButton>
        <MudText Typo="Typo.h5">แก้ไขข้อมูลสังกัด: @_name</MudText>

        <MudGrid Class="mt-1">
            <MudItem xs="12" sm="6">
                <MudSelect T="long?" Value="_sectionTypeId" ValueChanged="v => _sectionTypeId = v" Label="ประเภทสังกัด" Clearable="true">
                    @foreach (var st in _sectionTypes)
                    {
                        <MudSelectItem T="long?" Value="@((long?)st.Id)">@st.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudAutocomplete T="com_organization" Label="อยู่ภายใต้สังกัด (Parent)" Value="_selectedParent" ValueChanged="v => _selectedParent = v"
                    SearchFunc="SearchOrganizationsAsync"
                    ToStringFunc="@(o => o == null ? null : $"{o.code} — {o.name}")"
                    ResetValueOnEmptyText="true" CoerceText="true" MinCharacters="0" Clearable="true" Disabled="_isTop" />
            </MudItem>
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="_code" Label="รหัสสังกัด" Required="true" /></MudItem>
            <MudItem xs="12" sm="6">
                <MudAutocomplete T="Com_ChartOfAccount" Label="รหัสสังกัด (การเงิน) / Cost Center" Value="_selectedCostCenter" ValueChanged="v => _selectedCostCenter = v"
                    SearchFunc="SearchCostCentersAsync"
                    ToStringFunc="@(a => a == null ? null : $"{a.Code} — {a.NameTh}{(string.IsNullOrWhiteSpace(a.NameEn) ? "" : $" ({a.NameEn})")}")"
                    ResetValueOnEmptyText="true" CoerceText="true" MinCharacters="0" Clearable="true" />
            </MudItem>
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="_name" Label="ชื่อสังกัด" Required="true" /></MudItem>
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="_abbr" Label="ชื่อย่อ" /></MudItem>
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="_nameEn" Label="Name (English)" /></MudItem>
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="_abbrEn" Label="Abb. Name (English)" /></MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="long?" @bind-Value="_subSectionTypeId" Label="ลักษณะของหน่วยงาน" Clearable="true">
                    @foreach (var sst in _subSectionTypes)
                    {
                        <MudSelectItem T="long?" Value="@((long?)sst.Id)">@sst.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="string" @bind-Value="_layerCode" Label="ระดับชั้น (Org Layer)" Clearable="true"
                    HelperText="สังกัดนี้อยู่ระดับชั้นใด เช่น ชั้น 1 = บริษัท, ชั้น 2 = ฝ่าย">
                    @foreach (var ly in _layers)
                    {
                        <MudSelectItem T="string" Value="@ly.layercode">@ly.layercode — @ly.name (ชั้น @ly.layer)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="4">
                <MudText Typo="Typo.body2" Class="mb-1">สถานะ</MudText>
                <MudRadioGroup T="bool" @bind-Value="_isActive">
                    <MudRadio T="bool" Value="true" Color="Color.Primary">ใช้งาน</MudRadio>
                    <MudRadio T="bool" Value="false" Color="Color.Default">ไม่ใช้งาน</MudRadio>
                </MudRadioGroup>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudText Typo="Typo.body2" Class="mb-1">เงื่อนไขอัตรากำลัง</MudText>
                <MudRadioGroup T="bool" @bind-Value="_isManPowerCount">
                    <MudRadio T="bool" Value="true" Color="Color.Primary">นับอัตรากำลัง</MudRadio>
                    <MudRadio T="bool" Value="false" Color="Color.Default">ไม่นับอัตรากำลัง</MudRadio>
                </MudRadioGroup>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudText Typo="Typo.body2" Class="mb-1">สังกัดสูงสุด</MudText>
                <MudRadioGroup T="bool" Value="_isTop" ValueChanged="OnIsTopChanged">
                    <MudRadio T="bool" Value="true" Color="Color.Primary">สูงสุด</MudRadio>
                    <MudRadio T="bool" Value="false" Color="Color.Default">ไม่ใช่สูงสุด</MudRadio>
                </MudRadioGroup>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.body2" Class="mb-1">ประเภทหน่วยงาน</MudText>
                <MudStack Row="true">
                    <MudCheckBox T="bool" @bind-Value="_isCompany" Label="เป็นบริษัท (Company)" Color="Color.Primary" />
                    <MudCheckBox T="bool" @bind-Value="_isBranch" Label="เป็นสาขา (Branch)" Color="Color.Primary" />
                </MudStack>
            </MudItem>
            <MudItem xs="12" sm="6" />

            <MudItem xs="12" sm="6"><MudDatePicker Label="วันที่เริ่มต้นสังกัด" @bind-Date="_startDate" Editable="true" DateFormat="dd/MM/yyyy" /></MudItem>
            <MudItem xs="12" sm="6"><MudDatePicker Label="วันที่ยกเลิกสังกัด" @bind-Date="_endDate" Editable="true" DateFormat="dd/MM/yyyy" /></MudItem>
            <MudItem xs="12"><MudTextField @bind-Value="_remark" Label="หมายเหตุ" Lines="3" /></MudItem>
        </MudGrid>

        @if (ParentWillChange())
        {
            <MudAlert Severity="Severity.Info" Class="mt-3">
                การย้ายสังกัดต้องผ่านการอนุมัติ — ระบุวันที่ต้องการให้มีผลจริง (ฟิลด์อื่นที่แก้ไขพร้อมกันจะถูกบันทึกทันที)
            </MudAlert>
            <MudGrid Class="mt-1">
                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="วันที่มีผล" @bind-Date="_pendingEffectiveFrom" Editable="true" DateFormat="dd/MM/yyyy" Required="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_pendingRequestNote" Label="เหตุผล/หมายเหตุคำขอ (ถ้ามี)" />
                </MudItem>
            </MudGrid>
        }

        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
        }

        <MudStack Row="true" Spacing="2" Class="mt-3">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">บันทึก</MudButton>
            <MudButton Variant="Variant.Text" Href="@($"/org/organizations/{Id}")">ยกเลิก</MudButton>
        </MudStack>
    </MudPaper>
}

@code {
    [Parameter] public long Id { get; set; }

    private bool _notFound;
    private bool? _loaded;
    private string? _companyId;
    private List<Com_SectionType> _sectionTypes = new();
    private List<Com_SubSectionType> _subSectionTypes = new();
    private List<com_organize_layer> _layers = new();
    private string? _layerCode;
    private string? _error;

    private string _code = "";
    private string _name = "";
    private string? _nameEn;
    private string? _abbr;
    private string? _abbrEn;
    private bool _isTop;
    private bool _isActive = true;
    private bool _isManPowerCount = true;
    private bool _isCompany;
    private bool _isBranch;
    private long? _sectionTypeId;
    private long? _subSectionTypeId;
    private DateTime? _startDate;
    private DateTime? _endDate;
    private string? _remark;
    private com_organization? _selectedParent;
    private Com_ChartOfAccount? _selectedCostCenter;
    private string? _originalParentCode;
    private byte[]? _originalRowVersion;
    private DateTime? _pendingEffectiveFrom = DateTime.Today.AddDays(1);
    private string? _pendingRequestNote;
    private long _actorUserId;
    private string? _actorEmpId;

    protected override async Task OnParametersSetAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
        _actorUserId = long.TryParse(state.User.FindFirstValue("sc_userid"), out var uid) ? uid : 0;
        _actorEmpId = state.User.FindFirstValue("empno");

        await using var context = await DbFactory.CreateDbContextAsync();
        var org = await context.com_organizations.FirstOrDefaultAsync(o => o.id == Id);
        if (org is null)
        {
            _notFound = true;
            _loaded = true;
            return;
        }

        _sectionTypes = await context.Com_SectionTypes.Where(t => t.CompanyId == _companyId && t.IsActive).OrderBy(t => t.LevelNo).ToListAsync();
        _subSectionTypes = await context.Com_SubSectionTypes.Where(t => t.CompanyId == _companyId && t.IsActive).OrderBy(t => t.Name).ToListAsync();
        _layers = await context.com_organize_layers.Where(l => l.isActive).OrderBy(l => l.layer).ThenBy(l => l.name).ToListAsync();

        _code = org.code ?? "";
        _name = org.name ?? "";
        _nameEn = org.name_en;
        _abbr = org.abbr;
        _abbrEn = org.abbr_en;
        _isTop = org.istop;
        _isActive = org.isActive;
        _isManPowerCount = org.isManPowerCount;
        _isCompany = org.isCompany;
        _isBranch = org.isBranch;
        _sectionTypeId = _sectionTypes.FirstOrDefault(t => t.Code == org.SectionTypeCode)?.Id;
        _subSectionTypeId = org.SubSectionTypeId;
        _layerCode = org.layer_code;
        _startDate = org.startdate;
        _endDate = org.enddate;
        _remark = org.remark;
        _originalParentCode = org.parent_code;
        _originalRowVersion = org.RowVersion;

        if (!string.IsNullOrWhiteSpace(org.parent_code))
            _selectedParent = await context.com_organizations.FirstOrDefaultAsync(o => o.code == org.parent_code);
        if (!string.IsNullOrWhiteSpace(org.CostCenterCode))
            _selectedCostCenter = await context.Com_ChartOfAccounts.FirstOrDefaultAsync(a => a.CompanyId == _companyId && a.Code == org.CostCenterCode);

        _loaded = true;
    }

    private bool ParentWillChange()
    {
        var newParentCode = _isTop ? null : _selectedParent?.code;
        return newParentCode != _originalParentCode;
    }

    private async Task<IEnumerable<com_organization>> SearchOrganizationsAsync(string search, CancellationToken ct)
    {
        await using var context = await DbFactory.CreateDbContextAsync(ct);
        var query = context.com_organizations.Where(o => o.isActive && o.id != Id);
        query = EntitySearchHelper.ApplyTextSearch(query, search, nameof(com_organization.code), nameof(com_organization.name));
        return await query.OrderBy(o => o.orgcodefull).Take(20).ToListAsync(ct);
    }

    private async Task<IEnumerable<Com_ChartOfAccount>> SearchCostCentersAsync(string search, CancellationToken ct)
    {
        await using var context = await DbFactory.CreateDbContextAsync(ct);
        var query = context.Com_ChartOfAccounts.Where(a => a.CompanyId == _companyId && a.IsCostCenter && a.IsActive);
        query = EntitySearchHelper.ApplyTextSearch(query, search, nameof(Com_ChartOfAccount.Code), nameof(Com_ChartOfAccount.NameTh), nameof(Com_ChartOfAccount.NameEn));
        return await query.OrderBy(a => a.Code).Take(20).ToListAsync(ct);
    }

    private void OnIsTopChanged(bool value)
    {
        _isTop = value;
        if (value) _selectedParent = null;
    }

    private async Task SaveAsync()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_code) || string.IsNullOrWhiteSpace(_name))
        {
            _error = "กรุณาระบุรหัสและชื่อสังกัด";
            return;
        }
        if (!_isTop && _selectedParent is null)
        {
            _error = "กรุณาเลือกสังกัดที่อยู่ภายใต้ หรือติ๊กว่าเป็นสังกัดสูงสุด";
            return;
        }

        var newParentCode = _isTop ? null : _selectedParent?.code;
        var newCostCenterCode = _selectedCostCenter?.Code;
        var newSectionTypeCode = _sectionTypeId is null ? null : _sectionTypes.FirstOrDefault(t => t.Id == _sectionTypeId)?.Code;

        try
        {
            await using var context = await DbFactory.CreateDbContextAsync();

            var duplicate = await context.com_organizations.AnyAsync(o => o.code == _code && o.id != Id);
            if (duplicate)
            {
                _error = "มีรหัสสังกัดนี้อยู่แล้ว";
                return;
            }

            var existing = await context.com_organizations.FirstOrDefaultAsync(o => o.id == Id);
            if (existing is null)
            {
                _error = "ไม่พบข้อมูลสังกัดที่ต้องการแก้ไข";
                return;
            }

            var parentChanged = existing.parent_code != newParentCode;

            // Minor fields save directly — parent_code/istop/orgcodefull are
            // never touched here, only via the gated ChangeParent request
            // below. Same split as OrganizationAdmin.razor's SaveAsync.
            existing.code = _code;
            existing.name = _name;
            existing.name_en = _nameEn;
            existing.abbr = _abbr;
            existing.abbr_en = _abbrEn;
            existing.isActive = _isActive;
            existing.isManPowerCount = _isManPowerCount;
            existing.isCompany = _isCompany;
            existing.isBranch = _isBranch;
            existing.SectionTypeCode = newSectionTypeCode;
            existing.SubSectionTypeId = _subSectionTypeId;
            existing.layer_code = _layerCode;
            existing.CostCenterCode = newCostCenterCode;
            existing.startdate = _startDate;
            existing.enddate = _endDate;
            existing.remark = _remark;

            // Concurrency guard: tell EF this UPDATE should only succeed if
            // the row's RowVersion still matches what THIS form loaded (not
            // whatever `existing` just got fetched with above, which would
            // always match itself and never detect a conflict). If someone
            // else saved this org in between, RowVersion in the DB has
            // already moved on, the UPDATE affects 0 rows, and EF throws
            // DbUpdateConcurrencyException instead of silently overwriting.
            context.Entry(existing).Property(e => e.RowVersion).OriginalValue = _originalRowVersion;

            await context.SaveChangesAsync();

            if (parentChanged)
            {
                if (_pendingEffectiveFrom is null)
                {
                    _error = "กรุณาระบุวันที่มีผลสำหรับการย้ายสังกัด";
                    return;
                }
                var reqId = await ChangeRequestService.SubmitAsync(new Org_OrganizationChangeRequest
                {
                    ChangeType = OrgOrganizationChangeType.ChangeParent,
                    TargetOrganizationId = Id,
                    TargetOrganizationCode = existing.code,
                    OldParentCode = existing.parent_code,
                    NewParentCode = newParentCode,
                    NewIsTop = _isTop,
                    EffectiveFrom = DateOnly.FromDateTime(_pendingEffectiveFrom.Value),
                    RequestNote = _pendingRequestNote,
                }, _actorUserId, _actorEmpId);
                Snackbar.Add($"บันทึกข้อมูลอื่นเรียบร้อย และส่งคำขอย้ายสังกัดเข้าสู่การอนุมัติแล้ว (คำขอ #{reqId}) — จะมีผลวันที่ {_pendingEffectiveFrom:dd/MM/yyyy} หลังได้รับอนุมัติ", Severity.Info);
            }
            else
            {
                Snackbar.Add("บันทึกการแก้ไขเรียบร้อย", Severity.Success);
            }

            Nav.NavigateTo($"/org/organizations/{Id}");
        }
        catch (DbUpdateConcurrencyException)
        {
            _error = "ข้อมูลนี้ถูกแก้ไขโดยผู้อื่นไปแล้วระหว่างที่คุณกำลังแก้ไข — กรุณาโหลดหน้านี้ใหม่แล้วลองอีกครั้ง เพื่อไม่ให้เขียนทับการแก้ไขของอีกฝ่าย";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
