@page "/org/units"
@using HRM.Models
@using HRM.Services.Shared
@using HRM.Services.Org
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject OrgChangeRequestService ChangeRequestService
@inject NavigationManager Nav
@attribute [Authorize(Policy = "Menu:ORG_ADMIN")]

@* Parallel rebuild of /org/organizations following the CRUD skill's
   List -> View -> Edit flow as separate pages/routes, rather than the
   original page's list+inline-form-on-one-screen layout. The original page
   is untouched and still reachable — this is an additional link, not a
   replacement. View is shared with the original flow at
   /org/organizations/{Id} (OrganizationDetail.razor), which already matches
   the skill's View shape; only Create (/org/units/new) and Edit
   (/org/units/{Id}/edit) are new pages. *@

<PageTitle>ข้อมูลสังกัด (แบบใหม่)</PageTitle>

<MudPaper Class="pa-4 mb-4" MaxWidth="1100px">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.h5">ข้อมูลสังกัด (Organization) — แบบใหม่</MudText>
        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/org/units/new">เพิ่มหน่วยงานใหม่</MudButton>
            <MudButton Variant="Variant.Text" Href="/org/organizations">หน้าเดิม</MudButton>
        </MudStack>
    </MudStack>

    <MudTextField T="string" Value="_searchTerm" Label="ค้นหาข้อมูลสังกัด (รหัส / ชื่อ / ชื่อย่อ)" Immediate="true"
        DebounceInterval="300" ValueChanged="OnSearchChanged"
        AdornmentIcon="@Icons.Material.Filled.Search" Adornment="Adornment.Start" Class="mt-3 mb-3" />

    <MudTable Items="_organizations" Dense="true" Hover="true">
        <HeaderContent>
            <MudTh>ประเภทสังกัด</MudTh>
            <MudTh>รหัสสังกัด</MudTh>
            <MudTh>ชื่อสังกัด (ไทย)</MudTh>
            <MudTh>ชื่อย่อ</MudTh>
            <MudTh>รหัสการเงิน</MudTh>
            <MudTh>ลักษณะของหน่วยงาน</MudTh>
            <MudTh>ประเภท</MudTh>
            <MudTh>สถานะ</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@SectionTypeName(context.SectionTypeCode)</MudTd>
            <MudTd>@context.code</MudTd>
            <MudTd><MudLink Href="@($"/org/organizations/{context.id}")">@context.name</MudLink></MudTd>
            <MudTd>@context.abbr</MudTd>
            <MudTd>@context.CostCenterCode</MudTd>
            <MudTd>@SubSectionTypeName(context.SubSectionTypeId)</MudTd>
            <MudTd>
                @if (context.isCompany)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Class="mr-1">บริษัท</MudChip>
                }
                @if (context.isBranch)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary">สาขา</MudChip>
                }
            </MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Color="@(context.isActive ? Color.Success : Color.Default)">
                    @(context.isActive ? "ใช้งาน" : "ไม่ใช้งาน")
                </MudChip>
            </MudTd>
            <MudTd>
                <MudButton Size="Size.Small" Variant="Variant.Text" Href="@($"/org/organizations/{context.id}")">ดู</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Text" Href="@($"/org/units/{context.id}/edit")">แก้ไข</MudButton>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2">ยังไม่มีข้อมูลสังกัด</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private List<com_organization> _organizations = new();
    private string? _searchTerm;
    private List<Com_SectionType> _sectionTypes = new();
    private List<Com_SubSectionType> _subSectionTypes = new();

    protected override async Task OnInitializedAsync()
    {
        // Lazy apply-on-read for effective-dated changes (creates/moves that
        // came due) — same call as OrganizationAdmin.razor makes, since both
        // pages read/write the same com_organization table.
        await ChangeRequestService.ApplyDueChangesAsync();

        await using var context = await DbFactory.CreateDbContextAsync();
        _sectionTypes = await context.Com_SectionTypes.Where(t => t.IsActive).OrderBy(t => t.LevelNo).ToListAsync();
        _subSectionTypes = await context.Com_SubSectionTypes.Where(t => t.IsActive).OrderBy(t => t.Name).ToListAsync();

        await LoadAsync();
    }

    private string SectionTypeName(string? code) => string.IsNullOrEmpty(code) ? "" : (_sectionTypes.FirstOrDefault(t => t.Code == code)?.Name ?? code);
    private string SubSectionTypeName(long? id) => id is null ? "" : (_subSectionTypes.FirstOrDefault(t => t.Id == id)?.Name ?? "");

    private async Task LoadAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var query = context.com_organizations.AsQueryable();
        query = EntitySearchHelper.ApplyTextSearch(query, _searchTerm,
            nameof(com_organization.code), nameof(com_organization.name), nameof(com_organization.name_en), nameof(com_organization.abbr));
        _organizations = await query.OrderBy(o => o.orgcodefull).ToListAsync();
    }

    private async Task OnSearchChanged(string term)
    {
        _searchTerm = term;
        await LoadAsync();
    }
}
