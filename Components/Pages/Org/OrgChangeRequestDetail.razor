@page "/org/change-requests/{Id:long}"
@using HRM.Models
@using HRM.Services.Org
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@attribute [Authorize(Policy = "Menu:WF_WORKFLOW_ADMIN")]

<PageTitle>รายละเอียดคำขอเปลี่ยนแปลงผังองค์กร</PageTitle>

<MudPaper Class="pa-4 mb-4">
    @if (_notFound)
    {
        <MudAlert Severity="Severity.Error">ไม่พบคำขอนี้</MudAlert>
    }
    else if (_request is not null)
    {
        <MudText Typo="Typo.h5" Class="mb-2">คำขอเปลี่ยนแปลงผังองค์กร #@_request.Id</MudText>
        <MudText Typo="Typo.body1" Class="mb-3">@OrgChangeAuditFormatter.DescribeRequest(_request)</MudText>

        <MudGrid Class="mt-1">
            <MudItem xs="12" sm="4"><MudTextField Value="@ChangeTypeLabel(_request.ChangeType)" Label="ประเภทคำขอ" ReadOnly="true" /></MudItem>
            <MudItem xs="12" sm="4"><MudTextField Value="@_request.EffectiveFrom.ToString("dd/MM/yyyy")" Label="วันที่มีผล" ReadOnly="true" /></MudItem>
            <MudItem xs="12" sm="4"><MudTextField Value="@(_request.IsApplied ? $"มีผลแล้วเมื่อ {_request.AppliedDate:dd/MM/yyyy HH:mm}" : "ยังไม่มีผล")" Label="สถานะการนำไปใช้" ReadOnly="true" /></MudItem>
            <MudItem xs="12" sm="6"><MudTextField Value="@_requesterName" Label="ผู้ขอ" ReadOnly="true" /></MudItem>
            <MudItem xs="12" sm="6"><MudTextField Value="@_request.RequestedDate.ToString("dd/MM/yyyy HH:mm")" Label="วันที่ขอ" ReadOnly="true" /></MudItem>
            @if (!string.IsNullOrWhiteSpace(_request.RequestNote))
            {
                <MudItem xs="12"><MudTextField Value="@_request.RequestNote" Label="เหตุผล/หมายเหตุ" ReadOnly="true" Lines="2" /></MudItem>
            }
        </MudGrid>

        <MudDivider Class="my-4" />

        @if (_job is not null)
        {
            <MudText Typo="Typo.h6" Class="mb-2">สถานะการอนุมัติ</MudText>
            <MudText Typo="Typo.body1" Class="mb-2">
                สถานะ: <b>@_job.status</b> | ระดับปัจจุบัน: @_job.lastLevel / @_job.maxlevel
                @(_job.isJobClosed == true ? " (ปิดงานแล้ว)" : "")
            </MudText>
            <MudTable Items="_job.job_user_lists" Dense="true">
                <HeaderContent>
                    <MudTh>ระดับ</MudTh>
                    <MudTh>ผู้อนุมัติ</MudTh>
                    <MudTh>สถานะ</MudTh>
                    <MudTh>วันที่</MudTh>
                    <MudTh>ความเห็น</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.wlevel</MudTd>
                    <MudTd>
                        @if (context.userid is long uid && _approverEmployeeIds.TryGetValue(uid, out var empIdAndName))
                        {
                            <MudLink Href="@($"/employee/{empIdAndName.Id}")">@empIdAndName.Name</MudLink>
                        }
                        else
                        {
                            @context.userid
                        }
                    </MudTd>
                    <MudTd>@context.jobstatus</MudTd>
                    <MudTd>@context.approvedate?.ToString("dd/MM/yyyy HH:mm")</MudTd>
                    <MudTd>@context.comment</MudTd>
                </RowTemplate>
            </MudTable>
        }
        else
        {
            <MudAlert Severity="Severity.Info">คำขอนี้ยังไม่ถูกส่งเข้าสู่กระบวนการอนุมัติ (ร่าง)</MudAlert>
        }

        <MudButton Class="mt-4" Variant="Variant.Text" Href="/org/change-history">กลับไปหน้าประวัติการปรับผังองค์กร</MudButton>
    }
</MudPaper>

@code {
    [Parameter] public long Id { get; set; }

    private Org_OrganizationChangeRequest? _request;
    private job_master? _job;
    private string _requesterName = "";
    private bool _notFound;
    private Dictionary<long, (long Id, string Name)> _approverEmployeeIds = new();

    protected override async Task OnInitializedAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        _request = await context.Org_OrganizationChangeRequests.FirstOrDefaultAsync(r => r.Id == Id);
        if (_request is null)
        {
            _notFound = true;
            return;
        }

        if (!string.IsNullOrEmpty(_request.RequestedByEmpId))
        {
            var emp = await context.Hremployee.FirstOrDefaultAsync(e => e.EmpNo == _request.RequestedByEmpId);
            _requesterName = emp is null ? _request.RequestedByEmpId : $"{emp.EmpName} {emp.EmpSurname} ({emp.EmpNo})";
        }
        else
        {
            _requesterName = _request.RequestedByUserId.ToString();
        }

        if (_request.JobMasterId is not null)
        {
            _job = await context.job_masters
                .Include(j => j.job_user_lists.OrderBy(a => a.wlevel).ThenBy(a => a.jobapproverid))
                .FirstOrDefaultAsync(j => j.jobmasterid == _request.JobMasterId);

            if (_job is not null)
            {
                // Drill-down: resolve each approver row's userid -> sc_user.empid
                // -> Hremployee, so the table links to the employee record
                // instead of showing a raw internal userid.
                var userIds = _job.job_user_lists.Where(a => a.userid != null).Select(a => a.userid!.Value).Distinct().ToList();
                var scUsers = await context.sc_users.Where(u => userIds.Contains(u.userid) && u.empid != null).ToListAsync();
                var empNos = scUsers.Select(u => u.empid!).Distinct().ToList();
                var employees = await context.Hremployee.Where(e => empNos.Contains(e.EmpNo)).ToListAsync();
                foreach (var su in scUsers)
                {
                    var emp = employees.FirstOrDefault(e => e.EmpNo == su.empid);
                    if (emp is not null)
                        _approverEmployeeIds[su.userid] = (emp.id, $"{emp.EmpName} {emp.EmpSurname}");
                }
            }
        }
    }

    private static string ChangeTypeLabel(OrgOrganizationChangeType t) => t switch
    {
        OrgOrganizationChangeType.NewOrganization => "สร้างหน่วยงานใหม่",
        OrgOrganizationChangeType.ChangeParent => "ย้ายสังกัด",
        OrgOrganizationChangeType.ChangeApprover => "เปลี่ยนหัวหน้า",
        _ => t.ToString(),
    };
}
