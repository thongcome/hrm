@page "/org/organizations"
@using System.Security.Claims
@using System.Text.Json
@using HRM.Models
@using HRM.Services.Shared
@using HRM.Services.Org
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@implements IDisposable
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject OrgChangeRequestService ChangeRequestService
@inject HRM.Services.Hr.SeparationRequestService SeparationService
@inject HRM.Services.Audit.IAuditLogger AuditLogger
@inject IJSRuntime JS
@inject NavigationManager Nav
@attribute [Authorize(Policy = "Menu:ORG_ADMIN")]

@* Pure list page — CRUD skill rule 9 (landing state is always List/View,
   never a Create/Edit form). This page used to have its add/edit form
   ABOVE the list, which meant opening it landed users on an empty form
   with the actual data scrolled out of view below a divider. Create/Edit
   now live on their own dedicated routes (OrgUnitCreate.razor,
   OrgUnitEdit.razor — reachable at /org/organizations/new and
   /org/organizations/{id}/edit) and View is still the existing
   /org/organizations/{id} route (OrganizationDetail.razor). *@

<PageTitle>ข้อมูลสังกัด</PageTitle>

@* Same org-chart-card-* classes/markup as OrgChart.razor's <style> block —
   duplicated (not shared) because this is a plain <style> tag, not an
   isolated *.razor.css file, and it needs to be visible to elements the
   d3-org-chart library injects into the "ผังองค์กร (ภาพ)" tab below (see
   OrgChart.razor's own comment on why isolation wouldn't work here). *@
<style>
    .org-chart-canvas-wrap {
        height: 70vh;
        border: 1px solid var(--mud-palette-lines-default, #ddd);
        border-radius: 8px;
        overflow: hidden;
    }

    .org-chart-card {
        background: var(--mud-palette-surface, #fff);
        border-radius: 8px;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.18);
        text-align: left;
        user-select: none;
    }

    .org-chart-card-header {
        color: #fff;
        font-weight: 600;
        font-size: 0.7rem;
        padding: 6px 8px;
        border-radius: 8px 8px 0 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .org-chart-card-body {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px;
        min-height: 44px;
    }

    .org-chart-card.org-chart-vacant .org-chart-card-body {
        border: 1px dashed var(--mud-palette-lines-default, #ccc);
        border-top: none;
        border-radius: 0 0 8px 8px;
    }

    .org-chart-card-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        object-fit: cover;
        flex-shrink: 0;
        background: #ccc;
    }

    .org-chart-card-avatar.org-chart-avatar-initials {
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--mud-palette-primary, #594AE2);
        color: var(--mud-palette-primary-text, #fff);
        font-weight: 700;
        font-size: 0.85rem;
    }

    .org-chart-card-avatar.org-chart-avatar-vacant {
        display: flex;
        align-items: center;
        justify-content: center;
        background: transparent;
        border: 1px dashed var(--mud-palette-lines-default, #ccc);
        color: var(--mud-palette-text-secondary, #999);
        font-size: 1.1rem;
    }

    .org-chart-card-info {
        min-width: 0;
    }

    .org-chart-card-name {
        font-weight: 700;
        font-size: 0.75rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .org-chart-card-title {
        font-size: 0.65rem;
        color: var(--mud-palette-text-secondary, #777);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .org-chart-card-vacant-label {
        font-size: 0.7rem;
        font-style: italic;
        color: var(--mud-palette-text-secondary, #999);
    }

    .org-chart-clickable {
        cursor: pointer;
    }

    .org-chart-card-header.org-chart-clickable:hover {
        text-decoration: underline;
    }

    .org-chart-card-body.org-chart-clickable:hover {
        background: var(--mud-palette-action-default-hover, rgba(0, 0, 0, 0.04));
    }

    /* Browser Fullscreen API target — see OrgChartD3.toggleFullscreen in
       org-chart-d3.js. Overrides the fixed 70vh so the chart fills the whole
       screen instead of staying pinned at its normal-page size. */
    .org-chart-canvas-wrap:fullscreen,
    .org-chart-canvas-wrap:-webkit-full-screen {
        height: 100vh;
        width: 100vw;
        border-radius: 0;
        background: var(--mud-palette-background, #fff);
    }

    /* "ผังต้นไม้" tab node cards — same visual language as the d3 image-chart
       cards above (rounded, subtle shadow, accent-colored header strip) so
       the plain-text tree and the picture chart read as the same product,
       just two zoom levels. A left accent bar (not a full colored header)
       keeps depth-nested rows scannable without every row shouting for
       attention the way a full-color header block would at 4-5 levels deep. */
    .org-tree-row {
        display: flex;
        align-items: flex-start;
        gap: 4px;
        padding: 3px 0;
    }

    .org-tree-toggle {
        cursor: pointer;
        border: none;
        background: none;
        padding: 0;
        width: 22px;
        height: 34px;
        flex-shrink: 0;
        color: var(--mud-palette-text-secondary, #777);
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .org-tree-card {
        flex: 1;
        min-width: 0;
        display: block;
        background: var(--mud-palette-surface, #fff);
        border: 1px solid var(--mud-palette-lines-default, #e0e0e0);
        border-left: 3px solid var(--mud-palette-primary, #594AE2);
        border-radius: 6px;
        padding: 6px 10px;
        text-decoration: none;
        transition: box-shadow .12s ease, background .12s ease;
    }

    .org-tree-card:hover {
        box-shadow: 0 1px 5px rgba(0, 0, 0, 0.12);
        background: var(--mud-palette-action-default-hover, rgba(0, 0, 0, 0.02));
    }

    .org-tree-card.org-tree-inactive {
        border-left-color: var(--mud-palette-lines-default, #bbb);
        opacity: 0.7;
    }

    .org-tree-card-title {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
    }

    .org-tree-card-name {
        font-weight: 600;
        font-size: 0.85rem;
        color: var(--mud-palette-text-primary, #212121);
    }

    .org-tree-card-code {
        font-size: 0.7rem;
        color: var(--mud-palette-text-secondary, #888);
    }

    .org-tree-card-meta {
        font-size: 0.7rem;
        color: var(--mud-palette-text-secondary, #888);
        margin-top: 1px;
    }
</style>

<MudPaper Class="pa-4 mb-4" MaxWidth="1100px">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.h5">ข้อมูลสังกัด (Organization)</MudText>
        @* ข้อมูลประเภทสังกัด/ลักษณะของหน่วยงาน are reference-data master pages
           reachable from the "ผังองค์กร (Organization)" nav group already —
           per CRUD skill rule 8 this operational page shouldn't also carry
           shortcut buttons to manage them (redundant, and it dilutes this
           page's own focus). แสดงกำหนดหัวหน้า/ประวัติการปรับผังองค์กร stay —
           they're different *views* of this same entity (all-orgs boss
           roster, all-orgs change log), not reference data to manage
           elsewhere; OrganizationDetail.razor now also shows both scoped to
           one org, so this page keeps the whole-company versions. *@
        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/org/organizations/new">เพิ่มหน่วยงานใหม่</MudButton>
            <MudButton Variant="Variant.Text" Href="/org/set-boss">แสดงกำหนดหัวหน้า</MudButton>
            <MudButton Variant="Variant.Text" Href="/org/change-history">ประวัติการปรับผังองค์กร</MudButton>
        </MudStack>
    </MudStack>

    @if (string.IsNullOrEmpty(_companyId))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">บัญชีของคุณยังไม่ได้ผูกกับบริษัทใดๆ — ติดต่อแอดมินให้ตั้งค่า empid ก่อน</MudAlert>
        return;
    }

    <MudTabs Class="mt-3" Elevation="0" Rounded="true" PanelClass="pt-4" ActivePanelIndex="_activeTabIndex" ActivePanelIndexChanged="OnActiveTabChangedAsync">
        <MudTabPanel Text="รายการ">
            @* Search is explicit-trigger only — this table can grow large, so the
               page must not pull every row on every visit. Typing + Enter, or the
               "ค้นหา" button, both call SearchAsync(); nothing loads on page load. *@
            <MudStack Row="true" Spacing="2" Class="mb-3" AlignItems="AlignItems.Center">
                <MudTextField T="string" @bind-Value="_searchTerm" Label="ค้นหาข้อมูลสังกัด (รหัส / ชื่อ / ชื่อย่อ)"
                    AdornmentIcon="@Icons.Material.Filled.Search" Adornment="Adornment.Start"
                    @onkeydown="OnSearchKeyDown" Class="flex-grow-1" />
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="SearchAsync">ค้นหา</MudButton>
            </MudStack>

            @if (!_hasSearched)
            {
                <MudAlert Severity="Severity.Info">กรอกคำค้น (เว้นว่างได้ถ้าต้องการดูทั้งหมด) แล้วกด "ค้นหา" เพื่อแสดงรายการ</MudAlert>
            }
            else
            {
                <MudTable Items="_organizations" Dense="true" Hover="true">
                    <HeaderContent>
                        <MudTh>ประเภทสังกัด</MudTh>
                        <MudTh>รหัสสังกัด</MudTh>
                        <MudTh>ชื่อสังกัด (ไทย)</MudTh>
                        <MudTh>ชื่อย่อ</MudTh>
                        <MudTh>รหัสการเงิน</MudTh>
                        <MudTh>ลักษณะของหน่วยงาน</MudTh>
                        <MudTh>ระดับชั้น</MudTh>
                        <MudTh>ประเภท</MudTh>
                        <MudTh>สถานะ</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@SectionTypeName(context.SectionTypeCode)</MudTd>
                        <MudTd>@context.code</MudTd>
                        <MudTd><MudLink Href="@($"/org/organizations/{context.id}")">@context.name</MudLink></MudTd>
                        <MudTd>@context.abbr</MudTd>
                        <MudTd>@context.CostCenterCode</MudTd>
                        <MudTd>@SubSectionTypeName(context.SubSectionTypeId)</MudTd>
                        <MudTd>@LayerName(context.layer_code)</MudTd>
                        <MudTd>
                            @if (context.isCompany)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Class="mr-1">บริษัท</MudChip>
                            }
                            @if (context.isBranch)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Secondary">สาขา</MudChip>
                            }
                        </MudTd>
                        <MudTd>
                            <MudChip T="string" Size="Size.Small" Color="@(context.isActive ? Color.Success : Color.Default)">
                                @(context.isActive ? "ใช้งาน" : "ไม่ใช้งาน")
                            </MudChip>
                        </MudTd>
                        <MudTd>
                            <MudButton Size="Size.Small" Variant="Variant.Text" Href="@($"/org/organizations/{context.id}")">ดู</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Text" Href="@($"/org/organizations/{context.id}/edit")">แก้ไข</MudButton>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Typo="Typo.body2">ไม่พบข้อมูลสังกัดที่ตรงกับคำค้น</MudText>
                    </NoRecordsContent>
                    <PagerContent>
                        <MudTablePager />
                    </PagerContent>
                </MudTable>
            }
        </MudTabPanel>

        <MudTabPanel Text="ผังต้นไม้">
            @* Same recursive render pattern as OrgHeadcountTree.razor (roots =
               istop||no parent_code, children matched by parent_code==node.code,
               ordered by orgcodefull) — minus the headcount/position-slot data,
               since that's a different page's concern. Loaded eagerly (not
               search-gated) because com_organization is a small table (a few
               dozen rows in practice) and a tree is naturally browsable/collapsed
               by default, unlike the flat list above which can genuinely grow large. *@
            <MudStack Row="true" Spacing="2" Class="mb-3">
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => SetAllTreeExpanded(false))">ย่อทั้งหมด</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => SetAllTreeExpanded(true))">ขยายทั้งหมด</MudButton>
            </MudStack>

            @if (_treeRoots.Count == 0)
            {
                <MudAlert Severity="Severity.Info">ไม่พบข้อมูลผังองค์กร</MudAlert>
            }
            else
            {
                @foreach (var root in _treeRoots)
                {
                    @RenderTreeNode(root, 0)
                }
            }
        </MudTabPanel>

        <MudTabPanel Text="ผังองค์กร (ภาพ)">
            @* Reuses the same d3-org-chart rendering as OrgChart.razor
               (Services/Shared/OrgChartNodeBuilder.cs + wwwroot/js/org-chart-d3.js)
               but lets HR pick which สังกัด to root the chart at, instead of
               always showing the whole company — pick a node here and the
               chart starts from exactly that unit's own subtree. Rendered
               lazily (only once this tab is actually opened, via
               OnActiveTabChangedAsync) since MudTabs keeps every panel's
               markup in the DOM even while hidden, and an SVG-based chart
               measured while display:none'd would size itself to 0×0. *@
            @if (_chartEmployeeCount > 0)
            {
                <MudChip T="string" Color="Color.Warning" Size="Size.Small" Class="mb-2">PDPA</MudChip>
            }
            <MudGrid Class="mb-3">
                <MudItem xs="12" sm="6">
                    <MudSelect T="long?" Value="_chartRootOrgId" ValueChanged="OnRootOrgChangedAsync" Label="เริ่มผังจากสังกัด">
                        <MudSelectItem T="long?" Value="@((long?)null)">- ทั้งบริษัท -</MudSelectItem>
                        @foreach (var org in _allOrgsForTree.OrderBy(o => o.orgcodefull))
                        {
                            <MudSelectItem T="long?" Value="@((long?)org.id)">@org.orgcodefull - @org.name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" Class="d-flex align-center ga-2">
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.UnfoldMore" OnClick="ExpandAllChartAsync">ขยายทั้งหมด</MudButton>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.UnfoldLess" OnClick="CollapseAllChartAsync">ย่อทั้งหมด</MudButton>
                    <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                        <MudIconButton Icon="@Icons.Material.Filled.ZoomOut" OnClick="ZoomOutChartAsync" Title="ซูมออก" />
                        <MudIconButton Icon="@Icons.Material.Filled.CenterFocusStrong" OnClick="ResetZoomChartAsync" Title="พอดีหน้าจอ" />
                        <MudIconButton Icon="@Icons.Material.Filled.ZoomIn" OnClick="ZoomInChartAsync" Title="ซูมเข้า" />
                    </MudButtonGroup>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@(_chartIsFullscreen ? Icons.Material.Filled.FullscreenExit : Icons.Material.Filled.Fullscreen)" OnClick="ToggleChartFullscreenAsync">@(_chartIsFullscreen ? "ออกจากเต็มจอ" : "เต็มจอ")</MudButton>
                </MudItem>
            </MudGrid>

            @* The canvas-wrap div (fixed 70vh) stays mounted at a constant size
               across loading/empty/loaded — only its overlay content changes —
               so switching states never reflows the rest of the page. Before
               this, the wrapper only existed in the "loaded" branch, so the
               page's total height jumped every time loading finished (or the
               root-org selection changed), which read as the screen "jumping
               around" on every interaction. *@
            <MudText Typo="Typo.caption" Class="d-block mb-1" Style="color:var(--mud-palette-text-secondary);">
                เคล็ดลับ: ลากเพื่อเลื่อนผัง · หมุนล้อเมาส์ หรือกดปุ่มซูม (+ / −) เพื่อขยาย-ย่อ · กดไอคอนตรงกลางเพื่อพอดีหน้าจอ
            </MudText>
            <div class="org-chart-canvas-wrap" style="position:relative;">
                @if (_chartLoading)
                {
                    <div class="d-flex align-center justify-center" style="position:absolute; inset:0; z-index:1; background:var(--mud-palette-surface, #fff);">
                        <MudProgressCircular Indeterminate="true" />
                    </div>
                }
                else if (_chartNodes.Count == 0)
                {
                    <div class="d-flex align-center justify-center pa-4" style="position:absolute; inset:0; z-index:1;">
                        <MudAlert Severity="Severity.Info">ไม่พบข้อมูลผังองค์กรสำหรับสังกัดที่เลือก</MudAlert>
                    </div>
                }
                <div id="orgChartCanvasOrgAdmin" style="width:100%; height:100%;"></div>
            </div>
        </MudTabPanel>
    </MudTabs>
</MudPaper>

@code {
    private string? _companyId;
    private List<com_organization> _organizations = new();
    private List<Com_SectionType> _sectionTypes = new();
    private List<Com_SubSectionType> _subSectionTypes = new();
    private List<com_organize_layer> _layers = new();
    private string? _searchTerm;
    private bool _hasSearched;

    // Tree tab state — mirrors OrgHeadcountTree.razor's _allOrgs/_roots/_expanded
    // fields exactly, just without the position-slot/headcount join.
    private List<com_organization> _allOrgsForTree = new();
    private List<com_organization> _treeRoots = new();
    private HashSet<long> _expandedTreeNodes = new();
    private HashSet<long> _expandedEmployeeNodes = new();
    private Dictionary<long, List<EmpLite>> _employeesByOrg = new();
    private sealed record EmpLite(long Id, string EmpNo, string Name);
    private void ToggleEmployeeExpand(long orgId)
    {
        if (!_expandedEmployeeNodes.Add(orgId)) _expandedEmployeeNodes.Remove(orgId);
    }

    // "ผังองค์กร (ภาพ)" tab state — lazy: only loaded/rendered the first time
    // the user actually opens this tab (see OnActiveTabChangedAsync).
    private int _activeTabIndex;
    private bool _chartLoaded;
    private bool _chartLoading;
    private bool _chartNeedsRender;
    private long? _chartRootOrgId;
    private List<OrgChartNodeBuilder.ChartNode> _chartNodes = new();
    private int _chartEmployeeCount;
    private DotNetObjectReference<OrganizationAdmin>? _chartDotNetRef;
    private bool _chartIsFullscreen;
    private bool _chartFullscreenListenerAttached;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
        if (string.IsNullOrWhiteSpace(_companyId)) return;

        await ChangeRequestService.ApplyDueChangesAsync();
        // Free any อัตรา whose occupant's separation effective date has arrived,
        // so the chart's vacant/occupied nodes are current (lazy, no scheduler).
        await SeparationService.ApplyDueSeparationsAsync();

        await using var context = await DbFactory.CreateDbContextAsync();
        _sectionTypes = await context.Com_SectionTypes.Where(t => t.CompanyId == _companyId && t.IsActive).OrderBy(t => t.LevelNo).ToListAsync();
        _subSectionTypes = await context.Com_SubSectionTypes.Where(t => t.CompanyId == _companyId && t.IsActive).OrderBy(t => t.Name).ToListAsync();
        _layers = await context.com_organize_layers.Where(l => l.isActive).OrderBy(l => l.layer).ThenBy(l => l.name).ToListAsync();

        // Deliberately no initial load here — see the page-level comment on
        // why this list waits for an explicit search.

        // CEO 1 ก.ย. 2569: "ดึงใน com_organization เลย ผูกอย่างไรดึงแบบนั้น" —
        // the org table is its own source of truth. Load everything; the
        // tree renders from ACTIVE roots only (root = istop/no parent), and
        // children follow parent_code linkage, so an inactive root's whole
        // tree (e.g. the retired CEO Office tree) drops out naturally with
        // no com_company join involved.
        _allOrgsForTree = await context.com_organizations.ToListAsync();

        // CEO 1 ก.ย. 2569: "ในผังองค์กร ช่วย Link พนักงาน มาใส่ด้วย" — the
        // tree shows each node's ACTIVE employees (linked by
        // Hremployee.OrganizationId, so no companyid/comp_code join needed)
        // as clickable links to their personnel profile. Names load once as
        // a light projection; the list per node renders only when expanded.
        var treeOrgIds = _allOrgsForTree.Select(o => o.id).ToList();
        _employeesByOrg = (await context.Hremployee
                .Where(e => e.IsActive == true && e.OrganizationId != null && treeOrgIds.Contains(e.OrganizationId.Value))
                .Select(e => new { e.id, e.EmpNo, e.EmpName, e.EmpSurname, OrgId = e.OrganizationId!.Value })
                .ToListAsync())
            .GroupBy(e => e.OrgId)
            .ToDictionary(g => g.Key, g => g
                .OrderBy(e => e.EmpNo)
                .Select(e => new EmpLite(e.id, e.EmpNo, $"{e.EmpName} {e.EmpSurname}".Trim()))
                .ToList());
        _treeRoots = _allOrgsForTree.Where(o => (o.istop || string.IsNullOrEmpty(o.parent_code)) && o.isActive).OrderBy(o => o.orgcodefull).ToList();
        foreach (var root in _treeRoots) _expandedTreeNodes.Add(root.id);
    }

    private void SetAllTreeExpanded(bool expand)
    {
        _expandedTreeNodes = expand ? _allOrgsForTree.Select(o => o.id).ToHashSet() : _treeRoots.Select(o => o.id).ToHashSet();
    }

    private void ToggleTreeExpand(long id)
    {
        if (!_expandedTreeNodes.Add(id)) _expandedTreeNodes.Remove(id);
    }

    private RenderFragment RenderTreeNode(com_organization node, int depth) => builder =>
    {
        var children = _allOrgsForTree.Where(o => o.parent_code == node.code).OrderBy(o => o.orgcodefull).ToList();
        var isExpanded = _expandedTreeNodes.Contains(node.id);
        var meta = OrgChangeAuditFormatter.DescribeBossApprover(node);

        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "org-tree-row");
        builder.AddAttribute(2, "style", $"margin-left:{depth * 22}px;");

        if (children.Count > 0)
        {
            builder.OpenElement(3, "button");
            builder.AddAttribute(4, "type", "button");
            builder.AddAttribute(5, "class", "org-tree-toggle");
            builder.AddAttribute(6, "onclick", EventCallback.Factory.Create(this, () => ToggleTreeExpand(node.id)));
            builder.AddContent(7, isExpanded ? "▾" : "▸");
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(8, "span");
            builder.AddAttribute(9, "class", "org-tree-toggle");
            builder.CloseElement();
        }

        builder.OpenElement(10, "a");
        builder.AddAttribute(11, "class", node.isActive ? "org-tree-card" : "org-tree-card org-tree-inactive");
        builder.AddAttribute(12, "href", $"/org/organizations/{node.id}");

        builder.OpenElement(13, "div");
        builder.AddAttribute(14, "class", "org-tree-card-title");
        builder.OpenElement(15, "span");
        builder.AddAttribute(16, "class", "org-tree-card-name");
        builder.AddContent(17, node.name);
        builder.CloseElement();
        builder.OpenElement(18, "span");
        builder.AddAttribute(19, "class", "org-tree-card-code");
        builder.AddContent(20, $"{node.orgcodefull} · {node.abbr}");
        builder.CloseElement();
        if (!node.isActive)
        {
            builder.OpenComponent<MudChip<string>>(21);
            builder.AddAttribute(22, "Color", Color.Default);
            builder.AddAttribute(23, "Size", Size.Small);
            builder.AddAttribute(24, "ChildContent", (RenderFragment)(b2 => b2.AddContent(0, "ไม่ใช้งาน")));
            builder.CloseComponent();
        }
        builder.CloseElement();

        if (meta is not null)
        {
            builder.OpenElement(25, "div");
            builder.AddAttribute(26, "class", "org-tree-card-meta");
            builder.AddContent(27, meta);
            builder.CloseElement();
        }

        builder.CloseElement(); // </a> — the employee block below must sit OUTSIDE the card link (no nested <a>)

        // "Link พนักงาน" (CEO 1 ก.ย. 2569): direct employees of this node —
        // a count toggle, expanding to profile links.
        if (_employeesByOrg.TryGetValue(node.id, out var emps) && emps.Count > 0)
        {
            var empExpanded = _expandedEmployeeNodes.Contains(node.id);
            builder.OpenElement(29, "button");
            builder.AddAttribute(30, "type", "button");
            builder.AddAttribute(31, "class", "org-tree-emp-toggle");
            builder.AddAttribute(32, "style", "margin-left:8px;border:none;background:none;cursor:pointer;color:var(--mud-palette-primary);font-size:0.8rem;white-space:nowrap;");
            builder.AddAttribute(33, "onclick", EventCallback.Factory.Create(this, () => ToggleEmployeeExpand(node.id)));
            builder.AddContent(34, $"{(empExpanded ? "▾" : "▸")} พนักงาน {emps.Count} คน");
            builder.CloseElement();
        }

        builder.CloseElement(); // row div

        if (_employeesByOrg.TryGetValue(node.id, out var empList) && empList.Count > 0
            && _expandedEmployeeNodes.Contains(node.id))
        {
            builder.OpenElement(35, "div");
            builder.AddAttribute(36, "style", $"margin-left:{depth * 22 + 46}px;padding:2px 0 6px 0;display:flex;flex-wrap:wrap;gap:4px 14px;font-size:0.8rem;");
            foreach (var emp in empList)
            {
                builder.OpenElement(37, "a");
                builder.AddAttribute(38, "href", $"/employee/personnel-profile/{emp.Id}");
                builder.AddAttribute(39, "style", "text-decoration:none;color:var(--mud-palette-primary);");
                builder.AddContent(40, $"{emp.EmpNo} — {emp.Name}");
                builder.CloseElement();
            }
            builder.CloseElement();
        }

        if (isExpanded)
        {
            foreach (var child in children)
            {
                builder.AddContent(200, RenderTreeNode(child, depth + 1));
            }
        }
    };

    private string SectionTypeName(string? code) => string.IsNullOrEmpty(code) ? "" : (_sectionTypes.FirstOrDefault(t => t.Code == code)?.Name ?? code);
    private string SubSectionTypeName(long? id) => id is null ? "" : (_subSectionTypes.FirstOrDefault(t => t.Id == id)?.Name ?? "");
    private string LayerName(string? code) => string.IsNullOrEmpty(code) ? "" : (_layers.FirstOrDefault(l => l.layercode == code)?.name ?? code);

    private async Task SearchAsync()
    {
        _hasSearched = true;
        await using var context = await DbFactory.CreateDbContextAsync();
        // Admin list searches the WHOLE com_organization table (CEO: ดึงใน
        // com_organization เลย) — inactive trees stay findable here even
        // though the tree tab hides them.
        var query = context.com_organizations.AsQueryable();
        query = EntitySearchHelper.ApplyTextSearch(query, _searchTerm,
            nameof(com_organization.code), nameof(com_organization.name), nameof(com_organization.name_en), nameof(com_organization.abbr));
        _organizations = await query.OrderBy(o => o.orgcodefull).ToListAsync();
    }

    private async Task OnSearchKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SearchAsync();
    }

    private async Task OnActiveTabChangedAsync(int index)
    {
        _activeTabIndex = index;
        if (index == 2 && !_chartLoaded)
        {
            _chartLoaded = true;
            await LoadChartAsync(_chartRootOrgId);
        }
    }

    private async Task LoadChartAsync(long? rootOrgId)
    {
        if (string.IsNullOrWhiteSpace(_companyId)) return;

        _chartLoading = true;
        StateHasChanged();

        var rootOrgCode = rootOrgId is long id ? _allOrgsForTree.FirstOrDefault(o => o.id == id)?.code : null;

        await using var context = await DbFactory.CreateDbContextAsync();
        _chartNodes = await OrgChartNodeBuilder.BuildAsync(context, _companyId, rootOrgCode);

        _chartEmployeeCount = _chartNodes.Count(n => !n.IsVacant);
        if (_chartEmployeeCount > 0)
        {
            await AuditLogger.LogAccessAsync("Hremployee", null, isSensitive: true,
                note: $"org chart tab view (root org id={(object?)rootOrgId ?? "whole company"}) — {_chartEmployeeCount} employee photo(s)/name(s) shown across {_chartNodes.Count} position card(s)");
        }

        _chartLoading = false;
        _chartNeedsRender = _chartNodes.Count > 0;
    }

    private async Task OnRootOrgChangedAsync(long? newRootOrgId)
    {
        _chartRootOrgId = newRootOrgId;
        await LoadChartAsync(newRootOrgId);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_chartNeedsRender && _chartNodes.Count > 0)
        {
            _chartNeedsRender = false;
            _chartDotNetRef ??= DotNetObjectReference.Create(this);
            var json = JsonSerializer.Serialize(_chartNodes, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });
            await JS.InvokeVoidAsync("OrgChartD3.render", "orgChartCanvasOrgAdmin", json, _chartDotNetRef);

            if (!_chartFullscreenListenerAttached)
            {
                _chartFullscreenListenerAttached = true;
                await JS.InvokeVoidAsync("OrgChartD3.onFullscreenChange", _chartDotNetRef);
            }
        }
    }

    [JSInvokable]
    public void OnOrgNodeClicked(long orgId) => Nav.NavigateTo($"/org/organizations/{orgId}");

    [JSInvokable]
    public void OnEmployeeNodeClicked(long employeeId) => Nav.NavigateTo($"/employee/{employeeId}");

    // Driven by the actual fullscreenchange event (see
    // OrgChartD3.onFullscreenChange), not toggled optimistically, since the
    // browser can exit fullscreen on its own (Esc key) without ever going
    // through ToggleChartFullscreenAsync below.
    [JSInvokable]
    public void OnFullscreenChanged(bool isFullscreen)
    {
        _chartIsFullscreen = isFullscreen;
        StateHasChanged();
    }

    private async Task ExpandAllChartAsync() => await JS.InvokeVoidAsync("OrgChartD3.expandAll");
    private async Task CollapseAllChartAsync() => await JS.InvokeVoidAsync("OrgChartD3.collapseAll");
    private async Task ZoomInChartAsync() => await JS.InvokeVoidAsync("OrgChartD3.zoomIn");
    private async Task ZoomOutChartAsync() => await JS.InvokeVoidAsync("OrgChartD3.zoomOut");
    private async Task ResetZoomChartAsync() => await JS.InvokeVoidAsync("OrgChartD3.resetZoom");
    private async Task ToggleChartFullscreenAsync() => await JS.InvokeVoidAsync("OrgChartD3.toggleFullscreen", "orgChartCanvasOrgAdmin");

    public void Dispose() => _chartDotNetRef?.Dispose();
}
