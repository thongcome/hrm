@page "/org/chart"
@using System.Security.Claims
@using System.Text.Json
@using HRM.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject HRM.Services.Audit.IAuditLogger AuditLogger
@inject IJSRuntime JS
@attribute [Authorize(Policy = "Menu:ORG_ADMIN")]

<PageTitle>ผังองค์กร (Org Chart)</PageTitle>

@* Plain <style> — NOT a *.razor.css companion file. This page's card HTML
   is generated inside wwwroot/js/org-chart-d3.js (the d3-org-chart
   library owns node placement/pan/zoom), so these classes need to be
   visible to elements the library injects — Blazor's CSS-isolation scope
   attribute is only ever added to markup written directly in a .razor
   file, so an isolated .razor.css file here would silently never match. *@
<style>
    .org-chart-canvas-wrap {
        height: 78vh;
        border: 1px solid var(--mud-palette-lines-default, #ddd);
        border-radius: 8px;
        overflow: hidden;
    }

    .org-chart-card {
        background: var(--mud-palette-surface, #fff);
        border-radius: 8px;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.18);
        text-align: left;
        user-select: none;
    }

    .org-chart-card-header {
        color: #fff;
        font-weight: 600;
        font-size: 0.7rem;
        padding: 6px 8px;
        border-radius: 8px 8px 0 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .org-chart-card-body {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px;
        min-height: 44px;
    }

    .org-chart-card.org-chart-vacant .org-chart-card-body {
        border: 1px dashed var(--mud-palette-lines-default, #ccc);
        border-top: none;
        border-radius: 0 0 8px 8px;
    }

    .org-chart-card-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        object-fit: cover;
        flex-shrink: 0;
        background: #ccc;
    }

    .org-chart-card-avatar.org-chart-avatar-initials {
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--mud-palette-primary, #594AE2);
        color: var(--mud-palette-primary-text, #fff);
        font-weight: 700;
        font-size: 0.85rem;
    }

    .org-chart-card-avatar.org-chart-avatar-vacant {
        display: flex;
        align-items: center;
        justify-content: center;
        background: transparent;
        border: 1px dashed var(--mud-palette-lines-default, #ccc);
        color: var(--mud-palette-text-secondary, #999);
        font-size: 1.1rem;
    }

    .org-chart-card-info {
        min-width: 0;
    }

    .org-chart-card-name {
        font-weight: 700;
        font-size: 0.75rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .org-chart-card-title {
        font-size: 0.65rem;
        color: var(--mud-palette-text-secondary, #777);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .org-chart-card-vacant-label {
        font-size: 0.7rem;
        font-style: italic;
        color: var(--mud-palette-text-secondary, #999);
    }
</style>

<MudPaper Class="pa-4 mb-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudText Typo="Typo.h5">ผังองค์กร (Org Chart)</MudText>
        <MudChip T="string" Color="Color.Warning" Size="Size.Small">PDPA</MudChip>
    </MudStack>
    <MudText Typo="Typo.body2" Class="mt-1 mb-2">
        1 การ์ด = 1 ตำแหน่ง/เลขที่อัตรา (รวมตำแหน่งว่าง) — ลากพื้นหลังเพื่อเลื่อนดู, scroll เพื่อซูม, คลิกที่การ์ดเพื่อย่อ/ขยายสายงานใต้หน่วยงานนั้น
        สีของแถบหัวการ์ดแสดงระดับชั้นหน่วยงาน — ผังนี้ขับเคลื่อนด้วยไลบรารี <a href="https://github.com/bumbeishvili/org-chart" target="_blank">d3-org-chart</a> (MIT license)
    </MudText>

    @if (string.IsNullOrEmpty(_companyId))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">บัญชีของคุณยังไม่ได้ผูกกับบริษัทใดๆ — ติดต่อแอดมินให้ตั้งค่า empid ก่อน</MudAlert>
    }
    else if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_nodes.Count == 0)
    {
        <MudAlert Severity="Severity.Info">ไม่พบข้อมูลผังองค์กร</MudAlert>
    }
    else
    {
        <div id="orgChartCanvas" class="org-chart-canvas-wrap"></div>
    }
</MudPaper>

@code {
    private bool _loading = true;
    private string? _companyId;
    private List<ChartNode> _nodes = new();
    private bool _jsInitialized;

    private record ChartNode(string Id, string? ParentId, string OrgName, string? PersonName,
        string? Title, string? PhotoUrl, string? Initials, bool IsVacant);

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
        if (string.IsNullOrWhiteSpace(_companyId)) { _loading = false; return; }

        await using var context = await DbFactory.CreateDbContextAsync();

        var allOrgs = await context.com_organizations.ToListAsync();
        var orgsByCode = allOrgs.Where(o => !string.IsNullOrEmpty(o.code))
            .GroupBy(o => o.code!).ToDictionary(g => g.Key, g => g.First());
        var roots = allOrgs.Where(o => o.istop || string.IsNullOrEmpty(o.parent_code)).OrderBy(o => o.orgcodefull).ToList();

        var slots = await context.Pos_PositionSlots
            .Where(s => s.CompanyId == _companyId && s.IsActive && s.OrganizationId != null)
            .ToListAsync();
        var orgIdToCode = allOrgs.ToDictionary(o => o.id, o => o.code);
        var slotsByOrgCode = slots
            .Where(s => orgIdToCode.ContainsKey(s.OrganizationId!.Value) && orgIdToCode[s.OrganizationId!.Value] != null)
            .ToLookup(s => orgIdToCode[s.OrganizationId!.Value]!);

        var empIds = slots.Where(s => s.HremployeeId is not null).Select(s => s.HremployeeId!.Value).Distinct().ToList();
        var employeesById = await context.Hremployee
            .Where(e => empIds.Contains(e.id))
            .ToDictionaryAsync(e => e.id, e => e);

        // Every org unit contributes one node per position slot (a vacant
        // placeholder node if it has none). Only the org's first slot
        // (index 0 — the "representative" card) is wired into the
        // org-hierarchy chain via ParentId; any additional slots in the
        // same org hang directly off that representative card, matching
        // the same visual grouping the previous hand-rolled layout used.
        void AddOrgNodes(com_organization org, string? parentId)
        {
            var orgSlots = slotsByOrgCode[org.code!].OrderBy(s => s.PosCode).ToList();
            string? representativeId = null;

            if (orgSlots.Count == 0)
            {
                var id = $"{org.code}_0";
                representativeId = id;
                _nodes.Add(new ChartNode(id, parentId, org.name ?? org.code!, null, null, null, null, IsVacant: true));
            }
            else
            {
                for (var i = 0; i < orgSlots.Count; i++)
                {
                    var slot = orgSlots[i];
                    var id = $"{org.code}_{i}";
                    if (i == 0) representativeId = id;

                    if (slot.HremployeeId is long empId && employeesById.TryGetValue(empId, out var emp))
                    {
                        var name = $"{emp.EmpName} {emp.EmpSurname}".Trim();
                        var photoUrl = !string.IsNullOrEmpty(emp.PhotoStoragePath) ? $"/org/files/employee-photo/{emp.id}" : null;
                        var initials = !string.IsNullOrEmpty(emp.EmpName) ? emp.EmpName!.Substring(0, 1).ToUpperInvariant() : "?";
                        _nodes.Add(new ChartNode(id, i == 0 ? parentId : representativeId, org.name ?? org.code!,
                            name, slot.Name, photoUrl, initials, IsVacant: false));
                    }
                    else
                    {
                        _nodes.Add(new ChartNode(id, i == 0 ? parentId : representativeId, org.name ?? org.code!,
                            null, slot.Name, null, null, IsVacant: true));
                    }
                }
            }

            var children = allOrgs.Where(o => o.parent_code == org.code).OrderBy(o => o.orgcodefull).ToList();
            foreach (var child in children)
            {
                AddOrgNodes(child, representativeId);
            }
        }

        var validRoots = roots.Where(o => !string.IsNullOrEmpty(o.code)).ToList();

        // d3-org-chart (via d3.stratify internally) requires exactly one node
        // with a null parentId. This org structure can have more than one
        // top-level unit (istop=true) at once, so synthesize a single
        // invisible wrapper root when that happens.
        string? syntheticRootId = null;
        if (validRoots.Count > 1)
        {
            syntheticRootId = "__root__";
            _nodes.Add(new ChartNode(syntheticRootId, null, "บริษัท", null, null, null, null, IsVacant: true));
        }

        foreach (var root in validRoots)
        {
            AddOrgNodes(root, syntheticRootId);
        }

        var employeeCount = _nodes.Count(n => !n.IsVacant);
        if (employeeCount > 0)
        {
            await AuditLogger.LogAccessAsync("Hremployee", null, isSensitive: true,
                note: $"org chart view — {employeeCount} employee photo(s)/name(s) shown across {_nodes.Count} position card(s)");
        }

        _loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_jsInitialized && !_loading && _nodes.Count > 0)
        {
            _jsInitialized = true;
            var json = JsonSerializer.Serialize(_nodes, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });
            await JS.InvokeVoidAsync("OrgChartD3.render", "orgChartCanvas", json);
        }
    }
}
