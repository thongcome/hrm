@page "/org/chart"
@using System.Security.Claims
@using System.Text.Json
@using HRM.Models
@using HRM.Services.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@implements IDisposable
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject HRM.Services.Audit.IAuditLogger AuditLogger
@inject IJSRuntime JS
@inject NavigationManager Nav
@attribute [Authorize(Policy = "Menu:ORG_ADMIN")]

<PageTitle>ผังองค์กร (Org Chart)</PageTitle>

@* Plain <style> — NOT a *.razor.css companion file. This page's card HTML
   is generated inside wwwroot/js/org-chart-d3.js (the d3-org-chart
   library owns node placement/pan/zoom), so these classes need to be
   visible to elements the library injects — Blazor's CSS-isolation scope
   attribute is only ever added to markup written directly in a .razor
   file, so an isolated .razor.css file here would silently never match. *@
<style>
    .org-chart-canvas-wrap {
        height: 78vh;
        border: 1px solid var(--mud-palette-lines-default, #ddd);
        border-radius: 8px;
        overflow: hidden;
    }

    /* Browser Fullscreen API target — see OrgChartD3.toggleFullscreen in
       org-chart-d3.js. Overrides the fixed 78vh so the chart actually fills
       the whole screen instead of staying pinned at its normal-page size. */
    .org-chart-canvas-wrap:fullscreen,
    .org-chart-canvas-wrap:-webkit-full-screen {
        height: 100vh;
        width: 100vw;
        border-radius: 0;
        background: var(--mud-palette-background, #fff);
    }

    .org-chart-card {
        background: var(--mud-palette-surface, #fff);
        border-radius: 8px;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.18);
        text-align: left;
        user-select: none;
    }

    .org-chart-card-header {
        color: #fff;
        font-weight: 600;
        font-size: 0.7rem;
        padding: 6px 8px;
        border-radius: 8px 8px 0 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .org-chart-card-body {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px;
        min-height: 44px;
    }

    .org-chart-card.org-chart-vacant .org-chart-card-body {
        border: 1px dashed var(--mud-palette-lines-default, #ccc);
        border-top: none;
        border-radius: 0 0 8px 8px;
    }

    .org-chart-card-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        object-fit: cover;
        flex-shrink: 0;
        background: #ccc;
    }

    .org-chart-card-avatar.org-chart-avatar-initials {
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--mud-palette-primary, #594AE2);
        color: var(--mud-palette-primary-text, #fff);
        font-weight: 700;
        font-size: 0.85rem;
    }

    .org-chart-card-avatar.org-chart-avatar-vacant {
        display: flex;
        align-items: center;
        justify-content: center;
        background: transparent;
        border: 1px dashed var(--mud-palette-lines-default, #ccc);
        color: var(--mud-palette-text-secondary, #999);
        font-size: 1.1rem;
    }

    .org-chart-card-info {
        min-width: 0;
    }

    .org-chart-card-name {
        font-weight: 700;
        font-size: 0.75rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .org-chart-card-title {
        font-size: 0.65rem;
        color: var(--mud-palette-text-secondary, #777);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .org-chart-card-vacant-label {
        font-size: 0.7rem;
        font-style: italic;
        color: var(--mud-palette-text-secondary, #999);
    }

    .org-chart-clickable {
        cursor: pointer;
    }

    .org-chart-card-header.org-chart-clickable:hover {
        text-decoration: underline;
    }

    .org-chart-card-body.org-chart-clickable:hover {
        background: var(--mud-palette-action-default-hover, rgba(0, 0, 0, 0.04));
    }
</style>

<MudPaper Class="pa-4 mb-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudText Typo="Typo.h5">ผังองค์กร (Org Chart)</MudText>
        <MudChip T="string" Color="Color.Warning" Size="Size.Small">PDPA</MudChip>
    </MudStack>
    <MudText Typo="Typo.body2" Class="mt-1 mb-2">
        1 การ์ด = 1 ตำแหน่ง/เลขที่อัตรา (รวมตำแหน่งว่าง) — ลากพื้นหลังเพื่อเลื่อนดู, scroll เพื่อซูม, กดปุ่มเล็กใต้การ์ดเพื่อย่อ/ขยายสายงานใต้หน่วยงานนั้น
        คลิกที่ชื่อสังกัด (แถบหัวการ์ด) เพื่อไปหน้ารายละเอียดสังกัด, คลิกที่ชื่อพนักงานเพื่อไปหน้าประวัติพนักงาน —
        สีของแถบหัวการ์ดแสดงระดับชั้นหน่วยงาน — ผังนี้ขับเคลื่อนด้วยไลบรารี <a href="https://github.com/bumbeishvili/org-chart" target="_blank">d3-org-chart</a> (MIT license)
    </MudText>

    @if (string.IsNullOrEmpty(_companyId))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">บัญชีของคุณยังไม่ได้ผูกกับบริษัทใดๆ — ติดต่อแอดมินให้ตั้งค่า empid ก่อน</MudAlert>
    }
    else if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_nodes.Count == 0)
    {
        <MudAlert Severity="Severity.Info">ไม่พบข้อมูลผังองค์กร</MudAlert>
    }
    else
    {
        <MudStack Row="true" Spacing="2" Class="mb-2">
            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.UnfoldMore" OnClick="ExpandAllAsync">ขยายทั้งหมด</MudButton>
            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.UnfoldLess" OnClick="CollapseAllAsync">ย่อทั้งหมด</MudButton>
            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@(_isFullscreen ? Icons.Material.Filled.FullscreenExit : Icons.Material.Filled.Fullscreen)" OnClick="ToggleFullscreenAsync">@(_isFullscreen ? "ออกจากเต็มจอ" : "เต็มจอ")</MudButton>
        </MudStack>
        <div id="orgChartCanvas" class="org-chart-canvas-wrap"></div>
    }
</MudPaper>

@code {
    private bool _loading = true;
    private string? _companyId;
    private List<OrgChartNodeBuilder.ChartNode> _nodes = new();
    private bool _jsInitialized;
    private DotNetObjectReference<OrgChart>? _dotNetRef;
    private bool _isFullscreen;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
        if (string.IsNullOrWhiteSpace(_companyId)) { _loading = false; return; }

        await using var context = await DbFactory.CreateDbContextAsync();
        _nodes = await OrgChartNodeBuilder.BuildAsync(context, _companyId, rootOrgCode: null);

        var employeeCount = _nodes.Count(n => !n.IsVacant);
        if (employeeCount > 0)
        {
            await AuditLogger.LogAccessAsync("Hremployee", null, isSensitive: true,
                note: $"org chart view — {employeeCount} employee photo(s)/name(s) shown across {_nodes.Count} position card(s)");
        }

        _loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_jsInitialized && !_loading && _nodes.Count > 0)
        {
            _jsInitialized = true;
            _dotNetRef = DotNetObjectReference.Create(this);
            var json = JsonSerializer.Serialize(_nodes, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });
            await JS.InvokeVoidAsync("OrgChartD3.render", "orgChartCanvas", json, _dotNetRef);
            await JS.InvokeVoidAsync("OrgChartD3.onFullscreenChange", _dotNetRef);
        }
    }

    [JSInvokable]
    public void OnOrgNodeClicked(long orgId) => Nav.NavigateTo($"/org/organizations/{orgId}");

    [JSInvokable]
    public void OnEmployeeNodeClicked(long employeeId) => Nav.NavigateTo($"/employee/{employeeId}");

    // The browser can exit fullscreen on its own (user presses Esc) without
    // ever going through ToggleFullscreenAsync below, so _isFullscreen has to
    // be driven by the actual fullscreenchange event (see
    // OrgChartD3.onFullscreenChange), not just toggled optimistically here.
    [JSInvokable]
    public void OnFullscreenChanged(bool isFullscreen)
    {
        _isFullscreen = isFullscreen;
        StateHasChanged();
    }

    private async Task ToggleFullscreenAsync() => await JS.InvokeVoidAsync("OrgChartD3.toggleFullscreen", "orgChartCanvas");

    public void Dispose() => _dotNetRef?.Dispose();

    private async Task ExpandAllAsync() => await JS.InvokeVoidAsync("OrgChartD3.expandAll");
    private async Task CollapseAllAsync() => await JS.InvokeVoidAsync("OrgChartD3.collapseAll");
}
