@page "/org/organizations/{Id:long}"
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Org
@using HRM.Services.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject NavigationManager Nav
@inject OrgBossApproverService BossApproverService
@inject HRM.Services.Pay.PrivateFileStorage FileStorage
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@attribute [Authorize(Policy = "Menu:ORG_ADMIN")]

<PageTitle>ข้อมูลสังกัด</PageTitle>

@* Same org-tree-* classes/markup as OrganizationAdmin.razor's "ผังต้นไม้"
   tab — duplicated (plain <style> tag, not an isolated *.razor.css file)
   rather than shared, matching that page's own comment on why its d3-chart
   CSS is duplicated too. Keeps this page's sub-tree looking like the same
   product as the full tree view. *@
<style>
    .org-tree-row { display: flex; align-items: flex-start; gap: 4px; padding: 3px 0; }
    .org-tree-toggle {
        cursor: pointer; border: none; background: none; padding: 0;
        width: 22px; height: 34px; flex-shrink: 0;
        color: var(--mud-palette-text-secondary, #777); font-size: 0.85rem;
        display: flex; align-items: center; justify-content: center;
    }
    .org-tree-card {
        flex: 1; min-width: 0; display: block;
        background: var(--mud-palette-surface, #fff);
        border: 1px solid var(--mud-palette-lines-default, #e0e0e0);
        border-left: 3px solid var(--mud-palette-primary, #594AE2);
        border-radius: 6px; padding: 6px 10px; text-decoration: none;
        transition: box-shadow .12s ease, background .12s ease;
    }
    .org-tree-card:hover { box-shadow: 0 1px 5px rgba(0, 0, 0, 0.12); background: var(--mud-palette-action-default-hover, rgba(0, 0, 0, 0.02)); }
    .org-tree-card.org-tree-inactive { border-left-color: var(--mud-palette-lines-default, #bbb); opacity: 0.7; }
    .org-tree-card-title { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
    .org-tree-card-name { font-weight: 600; font-size: 0.85rem; color: var(--mud-palette-text-primary, #212121); }
    .org-tree-card-code { font-size: 0.7rem; color: var(--mud-palette-text-secondary, #888); }
    .org-tree-card-meta { font-size: 0.7rem; color: var(--mud-palette-text-secondary, #888); margin-top: 1px; }
</style>

@if (_org is null)
{
    <MudAlert Severity="Severity.Warning" Class="ma-4">ไม่พบข้อมูลสังกัดนี้</MudAlert>
}
else
{
    <MudPaper Class="pa-4 mb-4" MaxWidth="900px">
        <MudText Typo="Typo.h5">ข้อมูลสังกัด</MudText>
        <MudSimpleTable Dense="true" Class="mt-3">
            <tbody>
                <tr><td>ประเภทสังกัด</td><td>@_sectionTypeName</td><td>รหัสสังกัด</td><td>@_org.code</td></tr>
                <tr><td>ชื่อสังกัด</td><td>@_org.name (@_org.abbr)</td><td>Name (English)</td><td>@_org.name_en (@_org.abbr_en)</td></tr>
                <tr>
                    <td>อยู่ภายใต้สังกัด</td>
                    <td colspan="3">
                        @if (_parentOrgId is long parentId)
                        {
                            <MudLink Href="@($"/org/organizations/{parentId}")">@_parentName</MudLink>
                        }
                        else
                        {
                            @:— ไม่มี (สังกัดสูงสุด) —
                        }
                    </td>
                </tr>
                <tr><td>รหัสสังกัด (การเงิน)</td><td>@_org.CostCenterCode</td><td>รหัสเต็ม</td><td>@_org.orgcodefull</td></tr>
                <tr><td>ลักษณะของหน่วยงาน</td><td>@_subSectionTypeName</td><td>สังกัดสูงสุด</td><td>@(_org.istop ? "ใช่" : "ไม่ใช่")</td></tr>
                <tr><td>นับอัตรากำลัง</td><td>@(_org.isManPowerCount ? "ใช่" : "ไม่ใช่")</td><td>สถานะ</td><td>@(_org.isActive ? "ใช้งาน" : "ไม่ใช้งาน")</td></tr>
                <tr><td>วันที่เริ่มต้นสังกัด</td><td>@(_org.startdate?.ToString("dd/MM/yyyy") ?? "-")</td><td>วันที่ยกเลิกสังกัด</td><td>@(_org.enddate?.ToString("dd/MM/yyyy") ?? "-")</td></tr>
                <tr>
                    <td>หัวหน้าแผนก</td>
                    <td>
                        @(_org.boss_name ?? "— ยังไม่ได้กำหนด —")
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Title="แก้ไขหัวหน้าโดยตรง" OnClick="StartBossEdit" />
                    </td>
                    <td>ผู้อนุมัติ (Workflow)</td>
                    <td>
                        @_org.approver_name
                        @if (_activeDelegation is not null)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ml-1">
                                มอบหมายชั่วคราว @(_activeDelegation.EndDate is { } ed ? $"ถึง {ed:dd/MM/yyyy}" : "(ไม่มีกำหนด)")
                            </MudChip>
                            <MudIconButton Icon="@Icons.Material.Filled.Cancel" Size="Size.Small" Title="สิ้นสุดการมอบหมาย" OnClick="EndDelegationAsync" />
                        }
                        else
                        {
                            @if (!string.IsNullOrWhiteSpace(_org.approver_name) && !string.IsNullOrWhiteSpace(_org.boss_name) && _org.approver_name == _org.boss_name)
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary d-inline"> (คนเดียวกับหัวหน้าแผนก)</MudText>
                            }
                            else if (string.IsNullOrWhiteSpace(_org.approver_name))
                            {
                                @:— ยังไม่ได้กำหนด —
                            }
                            <MudIconButton Icon="@Icons.Material.Filled.SwapHoriz" Size="Size.Small" Title="มอบหมายอนุมัติแทนชั่วคราว" OnClick="@(() => _showDelegationForm = true)" />
                        }
                    </td>
                </tr>
                <tr><td>หมายเหตุ</td><td colspan="3">@_org.remark</td></tr>
            </tbody>
        </MudSimpleTable>

        @if (_showBossEdit)
        {
            <MudPaper Class="pa-3 mt-3" Outlined="true">
                <MudText Typo="Typo.subtitle2" Class="mb-2">แก้ไขหัวหน้าแผนกโดยตรง</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">
                    ปกติหัวหน้าจะถูกกำหนดอัตโนมัติจากผู้ที่ครองเลขที่อัตราที่ตั้งเป็น "หัวหน้า" ในหน่วยงานนี้ (จัดการที่ <MudLink Href="@($"/pos/position-slots?orgId={Id}")">อัตราในสังกัด</MudLink>) — การแก้ตรงนี้เป็นการกำหนดเอง ใช้เมื่อยังไม่ได้ตั้งค่าเลขที่อัตราไว้
                </MudText>
                <MudAutocomplete T="Hremployee" Label="หัวหน้าแผนก" Value="_selectedBossEmployee" ValueChanged="v => _selectedBossEmployee = v"
                    SearchFunc="SearchEmployeesAsync"
                    ToStringFunc="@(e => e == null ? null : $"{e.EmpNo} — {e.EmpName} {e.EmpSurname}")"
                    ResetValueOnEmptyText="true" CoerceText="true" MinCharacters="0" Clearable="true" />
                @if (!string.IsNullOrEmpty(_bossError))
                {
                    <MudAlert Severity="Severity.Error" Class="mt-2">@_bossError</MudAlert>
                }
                <MudStack Row="true" Spacing="2" Class="mt-3">
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveBossAsync">บันทึก</MudButton>
                    <MudButton Variant="Variant.Text" OnClick="@(() => _showBossEdit = false)">ยกเลิก</MudButton>
                </MudStack>
            </MudPaper>
        }

        @if (_showDelegationForm)
        {
            <MudPaper Class="pa-3 mt-3" Outlined="true">
                <MudText Typo="Typo.subtitle2" Class="mb-2">มอบหมายอนุมัติแทนชั่วคราว</MudText>
                <MudAutocomplete T="Hremployee" Label="ผู้อนุมัติแทน" Value="_selectedDelegate" ValueChanged="v => _selectedDelegate = v"
                    SearchFunc="SearchEmployeesAsync"
                    ToStringFunc="@(e => e == null ? null : $"{e.EmpNo} — {e.EmpName} {e.EmpSurname}")"
                    ResetValueOnEmptyText="true" CoerceText="true" MinCharacters="0" Clearable="true" />
                <MudGrid Class="mt-2">
                    <MudItem xs="12" sm="6">
                        <MudDatePicker Label="วันที่เริ่มมอบหมาย" @bind-Date="_delegationStart" Editable="true" DateFormat="dd/MM/yyyy" Required="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudDatePicker Label="วันที่สิ้นสุด (ไม่ระบุ = ไม่มีกำหนด)" @bind-Date="_delegationEnd" Editable="true" DateFormat="dd/MM/yyyy" Clearable="true" />
                    </MudItem>
                </MudGrid>
                <MudTextField @bind-Value="_delegationReason" Label="เหตุผล/หมายเหตุ" Class="mt-2" Lines="2" />
                <MudFileUpload T="IBrowserFile" FilesChanged="OnDelegationFileSelected" Class="mt-2">
                    <ActivatorContent>
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AttachFile">
                            @(_delegationFile?.Name ?? "แนบอีเมล/เอกสารอ้างอิง (ถ้ามี)")
                        </MudButton>
                    </ActivatorContent>
                </MudFileUpload>
                @if (!string.IsNullOrEmpty(_delegationError))
                {
                    <MudAlert Severity="Severity.Error" Class="mt-2">@_delegationError</MudAlert>
                }
                <MudStack Row="true" Spacing="2" Class="mt-3">
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveDelegationAsync">บันทึก</MudButton>
                    <MudButton Variant="Variant.Text" OnClick="@(() => _showDelegationForm = false)">ยกเลิก</MudButton>
                </MudStack>
            </MudPaper>
        }

        <MudStack Row="true" Spacing="2" Class="mt-4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@($"/org/organizations/{Id}/edit")">แก้ไข</MudButton>
            <MudButton Variant="Variant.Text" Href="/org/organizations">กลับไปหน้ารายการ</MudButton>
            <MudButton Variant="Variant.Text" OnClick="@(() => _showTree = !_showTree)">
                @(_showTree ? "ซ่อนสังกัดภายใต้" : "แสดงสังกัดภายใต้")
            </MudButton>
            <MudButton Variant="Variant.Text" OnClick="ToggleHistoryAsync">
                @(_showHistory ? "ซ่อนประวัติการปรับผังองค์กร" : "แสดงประวัติการปรับผังองค์กร")
            </MudButton>
            <MudButton Variant="Variant.Text" Href="@($"/pos/position-slots?orgId={Id}")">แสดงอัตราในสังกัด</MudButton>
        </MudStack>
    </MudPaper>

    @if (_showTree)
    {
        <MudPaper Class="pa-4 mb-4" MaxWidth="900px">
            <MudText Typo="Typo.h6" Class="mb-2">โครงสร้างองค์กร (สังกัดภายใต้ @_org.name)</MudText>
            <MudStack Row="true" Spacing="2" Class="mb-3">
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => SetAllExpanded(false))">ย่อทั้งหมด</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => SetAllExpanded(true))">ขยายทั้งหมด</MudButton>
            </MudStack>
            @RenderNode(_org, 0)
        </MudPaper>
    }

    @if (_showHistory)
    {
        <MudPaper Class="pa-4 mb-4" MaxWidth="900px">
            <MudText Typo="Typo.h6" Class="mb-2">ประวัติการปรับผังองค์กร — เฉพาะ @_org.name</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                ดูทุกหน่วยงานพร้อมกันได้ที่ <MudLink Href="/org/change-history">ประวัติการปรับผังองค์กร (ทั้งหมด)</MudLink>
            </MudText>

            @if (_pendingForOrg.Count > 0)
            {
                <MudText Typo="Typo.subtitle2" Class="mb-1">รอมีผล / อยู่ระหว่างดำเนินการ</MudText>
                <MudSimpleTable Dense="true" Class="mb-4">
                    <tbody>
                        @foreach (var (req, statusText, statusColor) in _pendingForOrg)
                        {
                            <tr>
                                <td>@OrgChangeAuditFormatter.DescribeRequest(req)</td>
                                <td>@req.EffectiveFrom.ToString("dd/MM/yyyy")</td>
                                <td><MudChip T="string" Color="@statusColor" Size="Size.Small">@statusText</MudChip></td>
                                <td><MudButton Size="Size.Small" Variant="Variant.Text" Href="@($"/org/change-requests/{req.Id}")">ดู</MudButton></td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }

            @if (_appliedForOrg.Count == 0)
            {
                <MudAlert Severity="Severity.Info">ไม่พบประวัติที่มีผลแล้วสำหรับหน่วยงานนี้</MudAlert>
            }
            else
            {
                <MudSimpleTable Dense="true">
                    <thead>
                        <tr><th>เวลา</th><th>รายละเอียด</th><th>ผู้ทำรายการ</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var (log, description, actor) in _appliedForOrg)
                        {
                            <tr>
                                <td>@log.EventDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@description</td>
                                <td>@actor</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }

            @if (_delegationHistory.Count > 0)
            {
                <MudText Typo="Typo.subtitle2" Class="mt-4 mb-1">ประวัติการมอบหมายอนุมัติแทน</MudText>
                <MudSimpleTable Dense="true">
                    <thead>
                        <tr><th>ผู้ได้รับมอบหมาย</th><th>ช่วงเวลา</th><th>เหตุผล</th><th>สถานะ</th><th>ไฟล์แนบ</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var (d, statusLabel) in _delegationHistory)
                        {
                            <tr>
                                <td>@d.DelegateName</td>
                                <td>@d.StartDate?.ToString("dd/MM/yyyy") - @(d.EndDate?.ToString("dd/MM/yyyy") ?? "ไม่มีกำหนด")</td>
                                <td>@d.remark</td>
                                <td>@statusLabel</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(d.AttachmentStoragePath))
                                    {
                                        <MudLink Href="@($"/org/files/approver-delegation/{d.toaid}")" Target="_blank">@d.AttachmentFileName</MudLink>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }
        </MudPaper>
    }
}

@code {
    [Parameter] public long Id { get; set; }

    private com_organization? _org;
    private string? _parentName;
    private long? _parentOrgId;
    private string? _sectionTypeName;
    private string? _subSectionTypeName;
    private bool _showTree;
    private List<com_organization> _allOrgs = new();
    private HashSet<long> _expanded = new();

    // Per-org slice of OrgChangeHistory.razor's data — same queries filtered
    // to this org's id, so "รอมีผล"/"ประวัติที่มีผลแล้ว" read identically
    // whether viewed from there or from here. Loaded lazily (only once the
    // section is actually opened), same as the tree above.
    private bool _showHistory;
    private bool _historyLoaded;
    private List<(Org_OrganizationChangeRequest Req, string StatusText, Color StatusColor)> _pendingForOrg = new();
    private List<(AuditLog Log, string Description, string Actor)> _appliedForOrg = new();
    private List<(toa Delegation, string StatusLabel)> _delegationHistory = new();

    // Boss direct-override inline form
    private bool _showBossEdit;
    private Hremployee? _selectedBossEmployee;
    private string? _bossError;

    // Temporary approver-delegation inline form
    private toa? _activeDelegation;
    private bool _showDelegationForm;
    private Hremployee? _selectedDelegate;
    private DateTime? _delegationStart = DateTime.Today;
    private DateTime? _delegationEnd;
    private string? _delegationReason;
    private IBrowserFile? _delegationFile;
    private string? _delegationError;

    protected override async Task OnParametersSetAsync()
    {
        // Lazy apply-on-read: revert an expired delegation (or activate a
        // future-dated one whose start date just arrived) before reading
        // approver_name/approver_empid below — no scheduler exists anywhere
        // in this app.
        await BossApproverService.SyncEffectiveApproverAsync(Id);

        await using var context = await DbFactory.CreateDbContextAsync();
        _org = await context.com_organizations.FirstOrDefaultAsync(o => o.id == Id);
        if (_org is null) return;

        _activeDelegation = await BossApproverService.GetActiveDelegationAsync(Id);

        // Relatives resolve purely by com_organization's own linkage
        // (parent_code by code) — codes are globally unique, no scoping
        // needed (CEO: ดึงใน com_organization เลย ผูกอย่างไรดึงแบบนั้น).
        _allOrgs = await context.com_organizations.ToListAsync();

        var parentOrg = _allOrgs.FirstOrDefault(o => o.code == _org.parent_code);
        _parentName = parentOrg is { } p ? $"{p.code} — {p.name}" : null;
        _parentOrgId = parentOrg?.id;

        if (!string.IsNullOrWhiteSpace(_org.SectionTypeCode))
        {
            var st = await context.Com_SectionTypes.FirstOrDefaultAsync(t => t.Code == _org.SectionTypeCode);
            _sectionTypeName = st?.Name;
        }
        if (_org.SubSectionTypeId is not null)
        {
            var sst = await context.Com_SubSectionTypes.FirstOrDefaultAsync(t => t.Id == _org.SubSectionTypeId);
            _subSectionTypeName = sst?.Name;
        }

        _expanded.Add(_org.id);
    }

    private void SetAllExpanded(bool expand)
    {
        if (expand)
        {
            _expanded = _allOrgs.Where(o => o.orgcodefull != null && _org!.orgcodefull != null && o.orgcodefull.StartsWith(_org.orgcodefull)).Select(o => o.id).ToHashSet();
        }
        else
        {
            _expanded = new HashSet<long> { _org!.id };
        }
    }

    private RenderFragment RenderNode(com_organization node, int depth) => builder =>
    {
        var children = _allOrgs.Where(o => o.parent_code == node.code).OrderBy(o => o.orgcodefull).ToList();
        var isExpanded = _expanded.Contains(node.id);
        var meta = OrgChangeAuditFormatter.DescribeBossApprover(node);

        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "org-tree-row");
        builder.AddAttribute(2, "style", $"margin-left:{depth * 22}px;");

        if (children.Count > 0)
        {
            builder.OpenElement(3, "button");
            builder.AddAttribute(4, "type", "button");
            builder.AddAttribute(5, "class", "org-tree-toggle");
            builder.AddAttribute(6, "onclick", Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, () => ToggleExpand(node.id)));
            builder.AddContent(7, isExpanded ? "▾" : "▸");
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(8, "span");
            builder.AddAttribute(9, "class", "org-tree-toggle");
            builder.CloseElement();
        }

        builder.OpenElement(10, "a");
        builder.AddAttribute(11, "class", node.isActive ? "org-tree-card" : "org-tree-card org-tree-inactive");
        builder.AddAttribute(12, "href", $"/org/organizations/{node.id}");

        builder.OpenElement(13, "div");
        builder.AddAttribute(14, "class", "org-tree-card-title");
        builder.OpenElement(15, "span");
        builder.AddAttribute(16, "class", "org-tree-card-name");
        builder.AddContent(17, node.name);
        builder.CloseElement();
        builder.OpenElement(18, "span");
        builder.AddAttribute(19, "class", "org-tree-card-code");
        builder.AddContent(20, $"{node.orgcodefull} · {node.abbr}");
        builder.CloseElement();
        builder.CloseElement();

        if (meta is not null)
        {
            builder.OpenElement(21, "div");
            builder.AddAttribute(22, "class", "org-tree-card-meta");
            builder.AddContent(23, meta);
            builder.CloseElement();
        }

        builder.CloseElement();
        builder.CloseElement();

        if (isExpanded)
        {
            foreach (var child in children)
            {
                builder.AddContent(24, RenderNode(child, depth + 1));
            }
        }
    };

    private void ToggleExpand(long id)
    {
        if (!_expanded.Add(id)) _expanded.Remove(id);
    }

    private async Task ToggleHistoryAsync()
    {
        _showHistory = !_showHistory;
        if (_showHistory && !_historyLoaded)
        {
            _historyLoaded = true;
            await LoadHistoryAsync();
        }
    }

    private async Task LoadHistoryAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();

        var pending = await context.Org_OrganizationChangeRequests
            .Where(r => !r.IsApplied && r.TargetOrganizationId == Id)
            .OrderBy(r => r.EffectiveFrom)
            .ToListAsync();
        var jobIds = pending.Where(r => r.JobMasterId != null).Select(r => r.JobMasterId!.Value).Distinct().ToList();
        var jobs = await context.job_masters.Where(j => jobIds.Contains(j.jobmasterid)).ToDictionaryAsync(j => j.jobmasterid);
        var today = DateOnly.FromDateTime(DateTime.Today);
        _pendingForOrg = pending.Select(r =>
        {
            job_master? job = r.JobMasterId is long jid && jobs.TryGetValue(jid, out var j) ? j : null;
            var (text, color) = DescribeStatus(r, job, today);
            return (r, text, color);
        }).ToList();

        var logs = await context.AuditLogs
            .Where(a => a.EntityType == "com_organization" && a.RecordId == Id.ToString())
            .OrderByDescending(a => a.EventDate)
            .Take(100)
            .ToListAsync();

        var appliedRequests = await context.Org_OrganizationChangeRequests
            .Where(r => r.IsApplied && r.TargetOrganizationId == Id)
            .ToListAsync();
        var empIds = appliedRequests.Select(r => r.RequestedByEmpId).Where(e => !string.IsNullOrEmpty(e)).Select(e => e!).Distinct().ToList();
        var employeeNames = empIds.Count == 0
            ? new Dictionary<string, string>()
            : await context.Hremployee.Where(e => empIds.Contains(e.EmpNo)).ToDictionaryAsync(e => e.EmpNo, e => $"{e.EmpName} {e.EmpSurname}".Trim());

        _appliedForOrg = logs.Select(log =>
        {
            var description = OrgChangeAuditFormatter.Describe(log);
            var actor = ResolveActor(log, appliedRequests, employeeNames);
            return (log, description, actor);
        }).ToList();

        _delegationHistory = await BossApproverService.GetHistoryAsync(Id);
    }

    private void StartBossEdit()
    {
        _bossError = null;
        _selectedBossEmployee = null;
        _showBossEdit = true;
    }

    private async Task SaveBossAsync()
    {
        _bossError = null;
        if (_selectedBossEmployee is null)
        {
            _bossError = "กรุณาเลือกพนักงาน";
            return;
        }

        try
        {
            await BossApproverService.SetBossDirectAsync(Id, _selectedBossEmployee.EmpNo,
                $"{_selectedBossEmployee.EmpName} {_selectedBossEmployee.EmpSurname}".Trim());
        }
        catch (InvalidOperationException ex)
        {
            _bossError = ex.Message;
            return;
        }

        Snackbar.Add("บันทึกหัวหน้าแผนกเรียบร้อย", Severity.Success);
        _showBossEdit = false;
        await OnParametersSetAsync();
        if (_historyLoaded) await LoadHistoryAsync();
    }

    private async Task<IEnumerable<Hremployee>> SearchEmployeesAsync(string search, CancellationToken ct)
    {
        await using var context = await DbFactory.CreateDbContextAsync(ct);
        var query = context.Hremployee.AsQueryable();
        query = EntitySearchHelper.ApplyTextSearch(query, search, nameof(Hremployee.EmpNo), nameof(Hremployee.EmpName), nameof(Hremployee.EmpSurname));
        return await query.OrderBy(e => e.EmpNo).Take(20).ToListAsync(ct);
    }

    private void OnDelegationFileSelected(IBrowserFile file) => _delegationFile = file;

    private async Task SaveDelegationAsync()
    {
        _delegationError = null;
        if (_selectedDelegate is null)
        {
            _delegationError = "กรุณาเลือกผู้อนุมัติแทน";
            return;
        }
        if (_delegationStart is null)
        {
            _delegationError = "กรุณาระบุวันที่เริ่มมอบหมาย";
            return;
        }

        byte[]? fileBytes = null;
        if (_delegationFile is not null)
        {
            const long maxSize = 10 * 1024 * 1024; // 10 MB
            if (_delegationFile.Size > maxSize)
            {
                _delegationError = "ไฟล์แนบใหญ่เกินไป (จำกัด 10 MB)";
                return;
            }
            await using var stream = _delegationFile.OpenReadStream(maxSize);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            fileBytes = buffer.ToArray();
        }

        try
        {
            await BossApproverService.CreateDelegationAsync(Id, _selectedDelegate.EmpNo,
                $"{_selectedDelegate.EmpName} {_selectedDelegate.EmpSurname}".Trim(),
                DateOnly.FromDateTime(_delegationStart.Value),
                _delegationEnd is null ? null : DateOnly.FromDateTime(_delegationEnd.Value),
                _delegationReason, _delegationFile?.Name, fileBytes);
        }
        catch (InvalidOperationException ex)
        {
            _delegationError = ex.Message;
            return;
        }

        Snackbar.Add("มอบหมายผู้อนุมัติแทนเรียบร้อย", Severity.Success);
        _showDelegationForm = false;
        _selectedDelegate = null;
        _delegationStart = DateTime.Today;
        _delegationEnd = null;
        _delegationReason = null;
        _delegationFile = null;
        await OnParametersSetAsync();
        if (_historyLoaded) await LoadHistoryAsync();
    }

    private async Task EndDelegationAsync()
    {
        if (_activeDelegation is null) return;
        await BossApproverService.EndDelegationAsync(_activeDelegation.toaid);
        Snackbar.Add("สิ้นสุดการมอบหมายเรียบร้อย — คืนสิทธิ์ผู้อนุมัติให้หัวหน้าแผนกแล้ว", Severity.Success);
        await OnParametersSetAsync();
        if (_historyLoaded) await LoadHistoryAsync();
    }

    // Same status wording as OrgChangeHistory.razor's DescribeStatus/ResolveActor
    // — kept as page-local copies rather than a shared service call, matching
    // this codebase's precedent (OrganizationAdmin.razor's own tree-render
    // comment) of duplicating small page-specific render helpers rather than
    // introducing a shared abstraction for a two-caller need.
    private static (string, Color) DescribeStatus(Org_OrganizationChangeRequest req, job_master? job, DateOnly today)
    {
        if (job is null) return ("รอเริ่มงานอนุมัติ", Color.Warning);
        if (job.isJobClosed != true) return ($"รออนุมัติ (ระดับ {job.lastLevel}/{job.maxlevel})", Color.Warning);
        if (job.status == HRM.Services.Workflow.WorkflowEngineService.StatusRejected) return ("ถูกปฏิเสธ", Color.Error);
        if (job.status == HRM.Services.Workflow.WorkflowEngineService.StatusCompleted)
            return req.EffectiveFrom <= today ? ("อนุมัติแล้ว รอนำไปใช้", Color.Success) : ($"อนุมัติแล้ว รอถึงวันที่มีผล ({req.EffectiveFrom:dd/MM/yyyy})", Color.Info);
        return (job.status ?? "ไม่ทราบสถานะ", Color.Default);
    }

    private static string ResolveActor(AuditLog log, List<Org_OrganizationChangeRequest> appliedRequests, Dictionary<string, string> employeeNames)
    {
        var match = appliedRequests.FirstOrDefault(r =>
            r.TargetOrganizationId!.Value.ToString() == log.RecordId &&
            r.AppliedDate is not null &&
            Math.Abs((r.AppliedDate.Value - log.EventDate).TotalSeconds) < 30);

        if (match is not null)
        {
            if (!string.IsNullOrEmpty(match.RequestedByEmpId) && employeeNames.TryGetValue(match.RequestedByEmpId, out var name))
                return name;
            return match.RequestedByEmpId ?? match.RequestedByUserId.ToString();
        }

        return log.ActorName ?? log.ActorUserId?.ToString() ?? "ไม่ทราบผู้ทำรายการ";
    }
}
