@page "/com_positions/create"
@using Microsoft.EntityFrameworkCore
@using HRM.Models
@inject IDbContextFactory<HRM.Models.HRMContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>com_position</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="com_position" OnValidSubmit="Addcom_position" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert"/>
            <div class="mb-3">
                <label for="code" class="form-label">code:</label> 
                <InputText id="code" @bind-Value="com_position.code" class="form-control" /> 
                <ValidationMessage For="() => com_position.code" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="name" class="form-label">name:</label> 
                <InputText id="name" @bind-Value="com_position.name" class="form-control" /> 
                <ValidationMessage For="() => com_position.name" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="name_en" class="form-label">name_en:</label> 
                <InputText id="name_en" @bind-Value="com_position.name_en" class="form-control" /> 
                <ValidationMessage For="() => com_position.name_en" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="comp_code_all" class="form-label">comp_code_all:</label> 
                <InputText id="comp_code_all" @bind-Value="com_position.comp_code_all" class="form-control" /> 
                <ValidationMessage For="() => com_position.comp_code_all" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="pos_type" class="form-label">pos_type:</label> 
                <InputText id="pos_type" @bind-Value="com_position.pos_type" class="form-control" /> 
                <ValidationMessage For="() => com_position.pos_type" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="isactive" class="form-label">isActive:</label> 
                <InputCheckbox id="isactive" @bind-Value="com_position.isActive" class="form-check-input" /> 
                <ValidationMessage For="() => com_position.isActive" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="startdate" class="form-label">startdate:</label> 
                <InputDate id="startdate" @bind-Value="com_position.startdate" class="form-control" /> 
                <ValidationMessage For="() => com_position.startdate" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="enddate" class="form-label">enddate:</label> 
                <InputDate id="enddate" @bind-Value="com_position.enddate" class="form-control" /> 
                <ValidationMessage For="() => com_position.enddate" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="moddate" class="form-label">moddate:</label> 
                <InputDate id="moddate" @bind-Value="com_position.moddate" class="form-control" /> 
                <ValidationMessage For="() => com_position.moddate" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="modby" class="form-label">modby:</label> 
                <InputText id="modby" @bind-Value="com_position.modby" class="form-control" /> 
                <ValidationMessage For="() => com_position.modby" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="min_salary" class="form-label">min_salary:</label> 
                <InputNumber id="min_salary" @bind-Value="com_position.min_salary" class="form-control" /> 
                <ValidationMessage For="() => com_position.min_salary" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="max_salary" class="form-label">max_salary:</label> 
                <InputNumber id="max_salary" @bind-Value="com_position.max_salary" class="form-control" /> 
                <ValidationMessage For="() => com_position.max_salary" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="remark" class="form-label">remark:</label> 
                <InputText id="remark" @bind-Value="com_position.remark" class="form-control" /> 
                <ValidationMessage For="() => com_position.remark" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="costcentercode" class="form-label">costcentercode:</label> 
                <InputText id="costcentercode" @bind-Value="com_position.costcentercode" class="form-control" /> 
                <ValidationMessage For="() => com_position.costcentercode" class="text-danger" /> 
            </div>        
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/com_positions">Back to List</a>
</div>

@code {
    [SupplyParameterFromForm]
    private com_position com_position { get; set; } = new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task Addcom_position()
    {
        using var context = DbFactory.CreateDbContext();
        context.com_positions.Add(com_position);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/com_positions");
    }
}
