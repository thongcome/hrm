@page "/admin/system/permissions"
@using System.Security.Claims
@using HRM.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@attribute [Authorize(Policy = "Menu:SYS_ADMIN")]

<PageTitle>จัดการสิทธิ์การใช้ระบบ</PageTitle>

<MudPaper Class="pa-4 mb-4">
    <MudText Typo="Typo.h5">จัดการสิทธิ์การใช้ระบบ (Permission)</MudText>
    <MudText Typo="Typo.body2" Class="mt-1">
        กำหนดว่ากลุ่มผู้ใช้ (Role) ใดเห็นเมนูใดได้บ้าง — ผูกตรงกับ sc_role_menu ที่ระบบใช้ authorize จริง (นโยบาย Menu:{code})
        การเปลี่ยนแปลงจะมีผลตั้งแต่การ login ครั้งถัดไปของผู้ใช้ในกลุ่มนั้น
    </MudText>

    <MudGrid Class="mt-3">
        <MudItem xs="12" sm="6">
            <MudSelect T="long?" @bind-Value="_selectedRoleId" Label="กลุ่มผู้ใช้ (Role)" @bind-Value:after="LoadPermissionsAsync">
                @foreach (var r in _roles)
                {
                    <MudSelectItem T="long?" Value="@((long?)r.roleid)">@r.abbr - @r.name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
    </MudGrid>

    @if (_selectedRoleId is null)
    {
        <MudAlert Severity="Severity.Info" Class="mt-4">กรุณาเลือกกลุ่มผู้ใช้ก่อน</MudAlert>
    }
    else
    {
        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
        }

        <MudText Typo="Typo.subtitle1" Class="mt-4 mb-1">กรุณาเลือก เมนูที่ต้องการกำหนดให้กับกลุ่มผู้ใช้นี้</MudText>
        <MudPaper Class="pa-2" Outlined="true" Style="max-height:600px; overflow-y:auto;">
            @foreach (var row in _menuRows)
            {
                <div style="padding-left:@(row.Depth * 24)px;" class="py-1 d-flex align-center">
                    <MudCheckBox T="bool" Value="@_checkedMenuIds.Contains(row.Menu.menuid)"
                        ValueChanged="@((bool v) => ToggleMenu(row.Menu.menuid, v))"
                        Label="@($"{row.Menu.menuname} ({row.Menu.menucode})")" Dense="true" />
                    <MudCheckBox T="bool" Value="@_editableMenuIds.Contains(row.Menu.menuid)"
                        ValueChanged="@((bool v) => ToggleEditable(row.Menu.menuid, v))"
                        Disabled="@(!_checkedMenuIds.Contains(row.Menu.menuid))"
                        Label="แก้ไขได้ (ไม่ติ๊ก = อ่านอย่างเดียว)" Dense="true" Class="ml-4" />
                </div>
            }
        </MudPaper>

        <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="mt-4" OnClick="SaveAsync">บันทึก</MudButton>

        <MudDivider Class="my-6" />

        <MudText Typo="Typo.subtitle1" Class="mb-1">สิทธิ์ปุ่ม เพิ่ม/แก้ไข/ลบ ต่อรายการ (sc_program)</MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">
            แยกจากสิทธิ์เห็นเมนูด้านบน — ควบคุมว่ากลุ่มผู้ใช้นี้เห็นปุ่ม "เพิ่ม/แก้ไข/ลบ" ในหน้าไหนได้บ้าง (เฉพาะหน้าที่ผูกกลไกนี้ไว้แล้ว — ดูวิธีผูกใน CRUD skill)
        </MudText>

        @if (_programGroups.Count == 0)
        {
            <MudAlert Severity="Severity.Info">ยังไม่มีหน้าใดผูกกลไกนี้ไว้</MudAlert>
        }
        else
        {
            <MudSimpleTable Dense="true">
                <thead><tr><th>รายการ</th><th>เพิ่ม</th><th>แก้ไข</th><th>ลบ</th></tr></thead>
                <tbody>
                    @foreach (var group in _programGroups)
                    {
                        <tr>
                            <td>@group.EntityLabel</td>
                            <td>
                                @if (group.CreateId is long cid)
                                {
                                    <MudCheckBox T="bool" Value="@_checkedProgramIds.Contains(cid)" ValueChanged="@((bool v) => ToggleProgram(cid, v))" Dense="true" />
                                }
                            </td>
                            <td>
                                @if (group.EditId is long eid)
                                {
                                    <MudCheckBox T="bool" Value="@_checkedProgramIds.Contains(eid)" ValueChanged="@((bool v) => ToggleProgram(eid, v))" Dense="true" />
                                }
                            </td>
                            <td>
                                @if (group.DeleteId is long did)
                                {
                                    <MudCheckBox T="bool" Value="@_checkedProgramIds.Contains(did)" ValueChanged="@((bool v) => ToggleProgram(did, v))" Dense="true" />
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="mt-3" OnClick="SaveProgramsAsync">บันทึกสิทธิ์ปุ่ม</MudButton>
        }
    }
</MudPaper>

@code {
    private long? _selectedRoleId;
    private List<sc_role> _roles = new();
    private List<(sc_menu Menu, int Depth)> _menuRows = new();
    private HashSet<long> _checkedMenuIds = new();
    private HashSet<long> _editableMenuIds = new();
    private string? _error;
    private string _actor = "admin";

    // sc_program rows for the same (entity, action) triple grouped into one
    // row — "EMPLOYEE_CREATE"/"EMPLOYEE_EDIT"/"EMPLOYEE_DELETE" collapse into
    // one "EMPLOYEE" line with 3 checkbox columns, matching the CRUD skill's
    // seeding convention (see .claude/skills/CRUD/SKILL.md).
    private record ProgramGroup(string EntityLabel, long? CreateId, long? EditId, long? DeleteId);
    private List<ProgramGroup> _programGroups = new();
    private HashSet<long> _checkedProgramIds = new();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _actor = state.User.Identity?.Name ?? "admin";

        await using var context = await DbFactory.CreateDbContextAsync();
        _roles = await context.sc_roles.Where(r => r.isactive).OrderBy(r => r.roleid).ToListAsync();
    }

    private async Task LoadPermissionsAsync()
    {
        _error = null;
        _menuRows = new();
        _checkedMenuIds = new();
        _editableMenuIds = new();
        if (_selectedRoleId is null) return;

        await using var context = await DbFactory.CreateDbContextAsync();
        var allMenus = await context.sc_menus.Where(m => m.isactive).ToListAsync();

        var byParent = allMenus
            .GroupBy(m => m.uppermenucode ?? string.Empty)
            .ToDictionary(g => g.Key, g => g.OrderBy(m => m.menuorder).ToList());

        var roots = byParent.TryGetValue(string.Empty, out var r) ? r : new List<sc_menu>();
        Flatten(roots, 0, byParent, new HashSet<string>());

        var grants = await context.sc_role_menus
            .Where(rm => rm.roleid == _selectedRoleId && rm.isactive)
            .Select(rm => new { rm.menuid, rm.canedit })
            .ToListAsync();
        _checkedMenuIds = grants.Select(g => g.menuid).ToHashSet();
        _editableMenuIds = grants.Where(g => g.canedit).Select(g => g.menuid).ToHashSet();

        // Seeding convention (see CRUD skill): progcode = "{ENTITY}_{ACTION}",
        // progname = "{entity label} — {action label}" — split on the em-dash
        // to recover the shared entity label for grouping.
        var allPrograms = await context.sc_programs.Where(p => p.isactive == true).ToListAsync();
        _programGroups = allPrograms
            .Select(p => new { Program = p, Underscore = p.progcode.LastIndexOf('_') })
            .Where(x => x.Underscore > 0)
            .GroupBy(x => x.Program.progcode[..x.Underscore])
            .Select(g =>
            {
                var label = g.First().Program.progname;
                var dashIdx = label.IndexOf(" — ", StringComparison.Ordinal);
                if (dashIdx > 0) label = label[..dashIdx];
                return new ProgramGroup(
                    label,
                    g.FirstOrDefault(x => x.Program.progcode.EndsWith("_CREATE"))?.Program.progid,
                    g.FirstOrDefault(x => x.Program.progcode.EndsWith("_EDIT"))?.Program.progid,
                    g.FirstOrDefault(x => x.Program.progcode.EndsWith("_DELETE"))?.Program.progid);
            })
            .OrderBy(g => g.EntityLabel)
            .ToList();

        var programGrants = await context.sc_role_programs
            .Where(rp => rp.roleid == _selectedRoleId && rp.isactive)
            .Select(rp => rp.progid)
            .ToListAsync();
        _checkedProgramIds = programGrants.Where(id => id.HasValue).Select(id => id!.Value).ToHashSet();
    }

    private void Flatten(List<sc_menu> nodes, int depth, Dictionary<string, List<sc_menu>> byParent, HashSet<string> visitedCodes)
    {
        foreach (var node in nodes)
        {
            _menuRows.Add((node, depth));

            if (string.IsNullOrWhiteSpace(node.menucode) || !visitedCodes.Add(node.menucode))
                continue; // no menucode = can't have children; guard against accidental cycles

            if (byParent.TryGetValue(node.menucode, out var children))
                Flatten(children, depth + 1, byParent, visitedCodes);
        }
    }

    private void ToggleMenu(long menuId, bool selected)
    {
        if (selected) _checkedMenuIds.Add(menuId);
        else
        {
            _checkedMenuIds.Remove(menuId);
            _editableMenuIds.Remove(menuId); // revoking the grant also clears any edit-rights on it
        }
    }

    private void ToggleEditable(long menuId, bool editable)
    {
        if (editable) _editableMenuIds.Add(menuId);
        else _editableMenuIds.Remove(menuId);
    }

    private async Task SaveAsync()
    {
        _error = null;
        if (_selectedRoleId is null) return;

        await using var context = await DbFactory.CreateDbContextAsync();
        var existingLinks = await context.sc_role_menus.Where(rm => rm.roleid == _selectedRoleId).ToListAsync();
        var existingByMenuId = existingLinks.ToDictionary(l => l.menuid);

        foreach (var row in _menuRows)
        {
            var desired = _checkedMenuIds.Contains(row.Menu.menuid);
            var desiredEditable = _editableMenuIds.Contains(row.Menu.menuid);

            if (existingByMenuId.TryGetValue(row.Menu.menuid, out var link))
            {
                if (link.isactive != desired || link.canedit != desiredEditable)
                {
                    link.isactive = desired;
                    link.canedit = desiredEditable;
                    link.moddate = DateTime.Now;
                    link.modby = _actor;
                }
            }
            else if (desired)
            {
                context.sc_role_menus.Add(new sc_role_menu
                {
                    roleid = _selectedRoleId.Value,
                    menuid = row.Menu.menuid,
                    isactive = true,
                    canedit = desiredEditable,
                    moddate = DateTime.Now,
                    modby = _actor,
                });
            }
        }

        await context.SaveChangesAsync();
        Snackbar.Add("บันทึกสิทธิ์เรียบร้อย — มีผลตั้งแต่การ login ครั้งถัดไป", Severity.Success);
    }

    private void ToggleProgram(long progId, bool granted)
    {
        if (granted) _checkedProgramIds.Add(progId);
        else _checkedProgramIds.Remove(progId);
    }

    private async Task SaveProgramsAsync()
    {
        _error = null;
        if (_selectedRoleId is null) return;

        await using var context = await DbFactory.CreateDbContextAsync();
        var existingLinks = await context.sc_role_programs.Where(rp => rp.roleid == _selectedRoleId).ToListAsync();
        var existingByProgId = existingLinks.Where(l => l.progid.HasValue).ToDictionary(l => l.progid!.Value);

        var allProgIds = _programGroups.SelectMany(g => new[] { g.CreateId, g.EditId, g.DeleteId }).Where(id => id.HasValue).Select(id => id!.Value);
        foreach (var progId in allProgIds)
        {
            var desired = _checkedProgramIds.Contains(progId);

            if (existingByProgId.TryGetValue(progId, out var link))
            {
                if (link.isactive != desired)
                {
                    link.isactive = desired;
                    link.moddate = DateTime.Now;
                    link.modby = _actor;
                }
            }
            else if (desired)
            {
                context.sc_role_programs.Add(new sc_role_program
                {
                    roleid = _selectedRoleId.Value,
                    progid = progId,
                    isactive = true,
                    moddate = DateTime.Now,
                    modby = _actor,
                });
            }
        }

        await context.SaveChangesAsync();
        Snackbar.Add("บันทึกสิทธิ์ปุ่มเรียบร้อย — มีผลตั้งแต่การ login ครั้งถัดไป", Severity.Success);
    }
}
