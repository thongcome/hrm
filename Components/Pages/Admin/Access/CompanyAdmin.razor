@page "/admin/system/companies"
@using HRM.Models
@using HRM.Services.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject JsonLocalizationService L
@inject NavigationManager Nav
@attribute [Authorize(Policy = "Menu:SYS_ADMIN")]

<PageTitle>@L.Translate("CompanyAdminPageTitle")</PageTitle>

<MudPaper Class="pa-4 mb-4" MaxWidth="1300px">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudText Typo="Typo.h5">@L.Translate("CompanyAdminPageTitle")</MudText>
        <MudChip T="string" Color="Color.Warning" Size="Size.Small">PDPA</MudChip>
    </MudStack>
    <MudText Typo="Typo.body2" Class="mt-1">
        @L.Translate("CompanyAdminDesc")
    </MudText>

    <MudDivider Class="my-4" />

    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
        <MudTextField T="string" Value="_searchTerm" Label="@L.Translate("SearchLabel")" Immediate="true"
            DebounceInterval="300" ValueChanged="OnSearchChanged"
            AdornmentIcon="@Icons.Material.Filled.Search" Adornment="Adornment.Start" Style="max-width:400px" />
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add"
            OnClick="@(() => Nav.NavigateTo("/admin/system/companies/new"))">@L.Translate("AddCompanyHeading")</MudButton>
    </MudStack>

    <MudGrid>
        @foreach (var item in _items)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudCard Outlined="true" Class="pa-2" Style="height:100%;cursor:pointer;" @onclick="@(() => Nav.NavigateTo($"/admin/system/companies/{item.id}"))">
                    <MudCardContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            @if (!string.IsNullOrEmpty(item.logp_path))
                            {
                                <MudAvatar Size="Size.Medium" Square="true">
                                    <MudImage Src="@($"/company/files/logo/{item.id}")" ObjectFit="ObjectFit.Contain" />
                                </MudAvatar>
                            }
                            else
                            {
                                <MudAvatar Size="Size.Medium" Color="Color.Primary" Square="true">
                                    <MudIcon Icon="@Icons.Material.Filled.Apartment" Size="Size.Small" />
                                </MudAvatar>
                            }
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.subtitle1">@item.name</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Default">@item.code @(string.IsNullOrWhiteSpace(item.name_en) ? "" : $"· {item.name_en}")</MudText>
                            </MudStack>
                        </MudStack>
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mt-3">
                            <MudChip T="string" Size="Size.Small" Color="@(item.isActive == true ? Color.Success : Color.Default)">
                                @(item.isActive == true ? L.Translate("PeriodActiveStatus") : L.Translate("NotActiveChip"))
                            </MudChip>
                            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => Nav.NavigateTo($"/admin/system/companies/{item.id}"))">@L.Translate("EditButton")</MudButton>
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }
        @if (_items.Count == 0)
        {
            <MudItem xs="12">
                <MudText Typo="Typo.body2">@L.Translate("NoDataYetMessage")</MudText>
            </MudItem>
        }
    </MudGrid>
</MudPaper>

@code {
    private List<com_company> _items = new();
    private string? _searchTerm;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var query = context.com_companies.AsQueryable();
        query = EntitySearchHelper.ApplyTextSearch(query, _searchTerm,
            nameof(com_company.code), nameof(com_company.name), nameof(com_company.name_en), nameof(com_company.abbr));
        _items = await query.OrderBy(c => c.name).ToListAsync();
    }

    private async Task OnSearchChanged(string term)
    {
        _searchTerm = term;
        await LoadAsync();
    }
}
