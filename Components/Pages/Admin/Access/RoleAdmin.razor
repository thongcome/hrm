@page "/admin/system/roles"
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Security
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject ProgramRoleService ProgramRoles
@inject ISnackbar Snackbar
@attribute [Authorize(Policy = "Menu:SYS_ADMIN")]

<PageTitle>จัดการกลุ่มผู้ใช้</PageTitle>

<MudPaper Class="pa-4 mb-4">
    <MudText Typo="Typo.h5">จัดการกลุ่มผู้ใช้ (Role)</MudText>
    <MudText Typo="Typo.body2" Class="mt-1">
        กลุ่มผู้ใช้ (sc_role) เป็นตัวกำหนดสิทธิ์จริงของระบบ ผูกกับเมนูผ่านหน้า "จัดการสิทธิ์การใช้ระบบ"
    </MudText>

    @if (_rights is not null && !_rights.CanCreate && !_rights.CanEdit && !_rights.CanDelete)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">หน้านี้ยังไม่ได้เปิดสิทธิ์แก้ไขให้บทบาทของคุณ</MudAlert>
    }

    @if (_rights?.CanCreate == true)
    {
        <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Add" Class="my-2" OnClick="StartAdd">เพิ่มกลุ่มผู้ใช้</MudButton>
    }

    @if (!string.IsNullOrEmpty(_error))
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
    }

    <MudTable Items="_roles" Dense="true" Hover="true">
        <HeaderContent>
            <MudTh>รหัส</MudTh>
            <MudTh>ชื่อกลุ่มผู้ใช้</MudTh>
            <MudTh>ชื่อย่อ</MudTh>
            <MudTh>ระดับสิทธิ์</MudTh>
            <MudTh>Upper Role</MudTh>
            <MudTh>สถานะ</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.roleid</MudTd>
            <MudTd>@context.name</MudTd>
            <MudTd>@context.abbr</MudTd>
            <MudTd>@context.rolelevel</MudTd>
            <MudTd>@context.upperrole</MudTd>
            <MudTd>@(context.isactive ? "ใช้งาน" : "ปิดใช้งาน")</MudTd>
            <MudTd>
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => ShowDetailAsync(context))">รายละเอียด</MudButton>
                @if (_rights?.CanEdit == true)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => StartEdit(context))">แก้ไข</MudButton>
                }
                @if (_rights?.CanDelete == true)
                {
                    @if (context.isactive)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="@(() => ToggleActiveAsync(context))">ปิดใช้งาน</MudButton>
                    }
                    else
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => ToggleActiveAsync(context))">เปิดใช้งาน</MudButton>
                    }
                }
            </MudTd>
        </RowTemplate>
    </MudTable>
</MudPaper>

@* CEO 2026-09-07: "เปิดหน้า Role มา ก็ต้องเห็นว่าใครอยู่ใน Role นี้ เมนูไหนผูกกับ role นี้"
   — sc_role's own model already declares sc_user_roles/sc_role_menus as
   inverse collections, but nothing on this page ever queried them before
   this. Read-only here (still one place to actually EDIT membership/menu
   grants — UserAdmin's role checkboxes, PermissionAdmin's menu tree — this
   panel is the "see everything about this role" hub those pages don't
   provide standing alone). *@
@if (_detailRole is not null)
{
    <MudPaper Class="pa-4 mb-4" Outlined="true">
        <MudText Typo="Typo.h6" Class="mb-1">รายละเอียดกลุ่มผู้ใช้: @_detailRole.name (@_detailRole.abbr)</MudText>
        <MudButton Size="Size.Small" Variant="Variant.Text" Class="mb-2" OnClick="@(() => _detailRole = null)">ปิด</MudButton>

        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.subtitle1" Class="mb-1">ผู้ใช้ในกลุ่มนี้ (@_detailUsers.Count)</MudText>
                <MudSimpleTable Dense="true" Style="max-height:400px; overflow-y:auto;">
                    <thead><tr><th>ชื่อเข้าสู่ระบบ</th><th>ชื่อ-สกุล</th></tr></thead>
                    <tbody>
                        @foreach (var u in _detailUsers)
                        {
                            <tr><td>@u.loginname</td><td>@u.firstname @u.lastname</td></tr>
                        }
                    </tbody>
                </MudSimpleTable>
                @if (_detailUsers.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">ยังไม่มีผู้ใช้ในกลุ่มนี้</MudText>
                }
                <MudButton Size="Size.Small" Variant="Variant.Text" Href="/admin/system/users" Class="mt-1">ไปหน้าจัดการผู้ใช้ (เพิ่ม/ถอดสมาชิก)</MudButton>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.subtitle1" Class="mb-1">เมนูที่ผูกกับกลุ่มนี้ (@_detailMenus.Count)</MudText>
                <MudSimpleTable Dense="true" Style="max-height:400px; overflow-y:auto;">
                    <thead><tr><th>กลุ่มเมนู</th><th>เมนู</th><th>แก้ไขได้</th></tr></thead>
                    <tbody>
                        @foreach (var m in _detailMenus)
                        {
                            <tr>
                                <td>@m.GroupName</td>
                                <td>@m.Menu.menuname</td>
                                <td>@(m.CanEdit ? "✓" : "")</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
                @if (_detailMenus.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">ยังไม่ได้ผูกเมนูใดให้กลุ่มนี้</MudText>
                }
                <MudButton Size="Size.Small" Variant="Variant.Text" Href="/admin/system/permissions" Class="mt-1">ไปหน้าจัดการสิทธิ์การใช้ระบบ (แก้ไขเมนู)</MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>
}

@if (_editing is not null)
{
    <MudPaper Class="pa-4" Outlined="true">
        <MudText Typo="Typo.h6" Class="mb-3">@(_editing.roleid == 0 ? "เพิ่มกลุ่มผู้ใช้" : $"แก้ไขกลุ่มผู้ใช้ #{_editing.roleid}")</MudText>
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_editing.name" Label="ชื่อกลุ่มผู้ใช้" Required="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_editing.abbr" Label="ชื่อย่อ" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_editing.rolelevel" Label="ระดับสิทธิ์ (Role Level)" Required="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="string" @bind-Value="_editing.upperrole" Label="Upper Role" Clearable="true">
                    @foreach (var r in _roles.Where(r => r.roleid != _editing.roleid && !string.IsNullOrWhiteSpace(r.name)))
                    {
                        var roleName = r.name!;
                        <MudSelectItem T="string" Value="@roleName">@roleName</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="string" @bind-Value="_editing.employeetype_code"
                           Label="ประเภทพนักงานที่ได้ role นี้อัตโนมัติ (employeeType)" Clearable="true"
                           HelperText="ตอน set user ครั้งแรก พนักงานประเภทนี้จะได้ role นี้อัตโนมัติ (เว้นว่าง = ไม่ auto-assign)">
                    @foreach (var t in _employeeTypes)
                    {
                        <MudSelectItem T="string" Value="@t.code">@($"{t.code} — {t.name}")</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="string" @bind-Value="_editing.pos_exec_code"
                           Label="ตำแหน่งที่ได้ role นี้อัตโนมัติ (Pos_ExecType)" Clearable="true"
                           HelperText="เช็คใหม่ทุกครั้งที่ระบบ start (ไม่ใช่แค่ตอน set user ครั้งแรก) — เลื่อนตำแหน่ง/ย้ายแผนกแล้วได้ role ตามจริงเสมอ (เว้นว่าง = ไม่ auto-assign)">
                    @foreach (var t in _posExecTypes)
                    {
                        <MudSelectItem T="string" Value="@t.Code">@($"{t.Code} — {t.Name}")</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>

        @if (!string.IsNullOrEmpty(_editError))
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_editError</MudAlert>
        }

        <MudStack Row="true" Spacing="2" Class="mt-4">
            @if (_editing.roleid == 0 ? _rights?.CanCreate == true : _rights?.CanEdit == true)
            {
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">บันทึก</MudButton>
            }
            <MudButton Variant="Variant.Text" OnClick="@(() => _editing = null)">ยกเลิก</MudButton>
        </MudStack>
    </MudPaper>
}

@code {
    private List<sc_role> _roles = new();
    private List<Employeetype> _employeeTypes = new();
    private List<Pos_ExecType> _posExecTypes = new();
    private sc_role? _editing;
    private sc_role? _detailRole;
    private List<sc_user> _detailUsers = new();
    private record MenuGrantRow(sc_menu Menu, string GroupName, bool CanEdit);
    private List<MenuGrantRow> _detailMenus = new();
    private string? _error;
    private string? _editError;
    private string _actor = "admin";
    private const long DefaultCompanyId = 1;
    private const string ProgramPath = "/admin/system/roles";
    private ProgramRoleService.ProgramRights? _rights;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _actor = state.User.Identity?.Name ?? "admin";
        _rights = await ProgramRoles.GetRightsAsync(state.User, ProgramPath);
        await LoadAsync();
    }

    // Second enforcement layer (AD.CRUDManage, both layers always) — returns
    // the denial message, or null when the action is allowed.
    private async Task<string?> RequireRightAsync(ProgramRoleService.ProgramAction action)
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        try
        {
            await ProgramRoles.RequireAsync(state.User, ProgramPath, action);
            return null;
        }
        catch (InvalidOperationException ex)
        {
            return ex.Message;
        }
    }

    private async Task LoadAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        _roles = await context.sc_roles.OrderBy(r => r.roleid).ToListAsync();
        _employeeTypes = await context.employeetypes.OrderBy(t => t.code).ToListAsync();
        _posExecTypes = await context.Pos_ExecTypes.Where(t => t.IsActive).OrderBy(t => t.Code).ToListAsync();
    }

    private async Task ShowDetailAsync(sc_role role)
    {
        _detailRole = role;
        await using var context = await DbFactory.CreateDbContextAsync();

        _detailUsers = await context.sc_user_roles
            .Where(ur => ur.roleid == role.roleid && ur.isactive)
            .Select(ur => ur.user)
            .OrderBy(u => u.loginname)
            .ToListAsync();

        var grants = await context.sc_role_menus
            .Where(rm => rm.roleid == role.roleid && rm.isactive)
            .Select(rm => new { rm.menuid, rm.canedit })
            .ToListAsync();
        var menuIds = grants.Select(g => g.menuid).ToList();
        var menus = await context.sc_menus.Where(m => menuIds.Contains(m.menuid)).ToListAsync();
        var byCode = await context.sc_menus
            .Where(m => m.menucode != null)
            .ToDictionaryAsync(m => m.menucode!, m => m.menuname ?? m.menucode!);

        _detailMenus = grants
            .Select(g =>
            {
                var menu = menus.First(m => m.menuid == g.menuid);
                var groupName = !string.IsNullOrWhiteSpace(menu.uppermenucode) && byCode.TryGetValue(menu.uppermenucode, out var gn)
                    ? gn : "(บนสุด)";
                return new MenuGrantRow(menu, groupName, g.canedit);
            })
            .OrderBy(r => r.GroupName).ThenBy(r => r.Menu.menuorder)
            .ToList();
    }

    private void StartAdd()
    {
        _editError = null;
        _editing = new sc_role { rolelevel = "1", isactive = true };
    }

    private void StartEdit(sc_role role)
    {
        _editError = null;
        _editing = new sc_role
        {
            roleid = role.roleid,
            company_id = role.company_id,
            name = role.name,
            abbr = role.abbr,
            rolelevel = role.rolelevel,
            upperrole = role.upperrole,
            rolecode = role.rolecode,
            isactive = role.isactive,
            employeetype_code = role.employeetype_code,
            pos_exec_code = role.pos_exec_code,
        };
    }

    private async Task SaveAsync()
    {
        _editError = null;
        if (_editing is null) return;
        if (await RequireRightAsync(_editing.roleid == 0 ? ProgramRoleService.ProgramAction.Create : ProgramRoleService.ProgramAction.Edit) is string denied)
        {
            _editError = denied;
            return;
        }

        if (string.IsNullOrWhiteSpace(_editing.name))
        {
            _editError = "กรุณากรอกชื่อกลุ่มผู้ใช้";
            return;
        }
        if (string.IsNullOrWhiteSpace(_editing.rolelevel))
        {
            _editError = "กรุณากรอกระดับสิทธิ์";
            return;
        }

        await using var context = await DbFactory.CreateDbContextAsync();

        if (_editing.roleid == 0)
        {
            _editing.company_id = DefaultCompanyId;
            _editing.rolecode = string.IsNullOrWhiteSpace(_editing.abbr) ? _editing.name : _editing.abbr;
            _editing.moddate = DateTime.Now;
            _editing.modby = _actor;
            context.sc_roles.Add(_editing);
        }
        else
        {
            var existing = await context.sc_roles.FirstOrDefaultAsync(r => r.roleid == _editing.roleid);
            if (existing is null)
            {
                _editError = "ไม่พบกลุ่มผู้ใช้นี้ในระบบแล้ว";
                return;
            }

            existing.name = _editing.name;
            existing.abbr = _editing.abbr;
            existing.rolelevel = _editing.rolelevel;
            existing.upperrole = _editing.upperrole;
            existing.employeetype_code = _editing.employeetype_code;
            existing.pos_exec_code = _editing.pos_exec_code;
            existing.moddate = DateTime.Now;
            existing.modby = _actor;
        }

        await context.SaveChangesAsync();
        Snackbar.Add("บันทึกกลุ่มผู้ใช้เรียบร้อย", Severity.Success);
        _editing = null;
        await LoadAsync();
    }

    private async Task ToggleActiveAsync(sc_role role)
    {
        _error = null;
        if (await RequireRightAsync(ProgramRoleService.ProgramAction.Delete) is string denied)
        {
            _error = denied;
            return;
        }
        await using var context = await DbFactory.CreateDbContextAsync();
        var existing = await context.sc_roles.FirstOrDefaultAsync(r => r.roleid == role.roleid);
        if (existing is null) return;

        if (existing.isactive)
        {
            var inUse = await context.sc_user_roles.AnyAsync(ur => ur.roleid == role.roleid && ur.isactive);
            if (inUse)
            {
                _error = $"ปิดใช้งานกลุ่มผู้ใช้ '{role.name}' ไม่ได้ เพราะยังมีผู้ใช้ผูกกับกลุ่มนี้อยู่";
                return;
            }
        }

        existing.isactive = !existing.isactive;
        existing.moddate = DateTime.Now;
        existing.modby = _actor;
        await context.SaveChangesAsync();
        await LoadAsync();
    }
}
