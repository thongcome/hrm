    // Toggle เดียวใช้ร่วมกันทุกตาราง — ลด boilerplate ที่จะซ้ำ 7 รอบถ้าเขียนแยก
    private async Task ToggleActiveAsync<T>(List<T> list, T item, Func<T, long> idSelector, Action<T, bool> setActive, Func<Task> refresh)
        where T : class
    {
        if (Id is not long companyId) return;
        var id = idSelector(item);
        await using var context = await DbFactory.CreateDbContextAsync();
        var existing = await context.Set<T>().FirstOrDefaultAsync(BuildIdPredicate<T>(id));
        if (existing is null) return;

        var current = (bool)typeof(T).GetProperty("IsActive")!.GetValue(existing)!;
        setActive(existing, !current);
        await context.SaveChangesAsync();
        await refresh();
    }

    private static System.Linq.Expressions.Expression<Func<T, bool>> BuildIdPredicate<T>(long id)
    {
        var param = System.Linq.Expressions.Expression.Parameter(typeof(T), "x");
        var prop = System.Linq.Expressions.Expression.Property(param, "Id");
        var constant = System.Linq.Expressions.Expression.Constant(id);
        var equal = System.Linq.Expressions.Expression.Equal(prop, constant);
        return System.Linq.Expressions.Expression.Lambda<Func<T, bool>>(equal, param);
    }

