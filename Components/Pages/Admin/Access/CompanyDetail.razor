@page "/admin/system/companies/new"
@page "/admin/system/companies/{Id:long}"
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Audit
@using HRM.Services.Pay
@using HRM.Services.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@inject PrivateFileStorage FileStorage
@inject IAuditLogger AuditLogger
@inject JsonLocalizationService L
@inject NavigationManager Nav
@attribute [Authorize(Policy = "Menu:SYS_ADMIN")]

<PageTitle>@(Id is null ? L.Translate("AddCompanyHeading") : L.Translate("EditButton")) — @L.Translate("CompanyAdminPageTitle")</PageTitle>

<MudPaper Class="pa-4 mb-4" MaxWidth="1300px">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => Nav.NavigateTo("/admin/system/companies"))" />
            <MudText Typo="Typo.h5">@(Id is null ? L.Translate("AddCompanyHeading") : _name)</MudText>
        </MudStack>
    </MudStack>

    <MudDivider Class="my-4" />

    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-4">
        @if (Id is not null && !string.IsNullOrEmpty(_logoPath))
        {
            <MudAvatar Size="Size.Large" Style="width:88px;height:88px;" Square="true">
                <MudImage Src="@($"/company/files/logo/{Id}?v={_logoCacheBust}")" ObjectFit="ObjectFit.Contain" />
            </MudAvatar>
        }
        else
        {
            <MudAvatar Size="Size.Large" Style="width:88px;height:88px;" Color="Color.Primary" Square="true">
                <MudIcon Icon="@Icons.Material.Filled.Apartment" />
            </MudAvatar>
        }
        <MudStack Spacing="1">
            <MudFileUpload T="IBrowserFile" FilesChanged="OnLogoSelected" Accept=".jpg,.jpeg,.png" Disabled="Id is null">
                <ActivatorContent>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Image" Disabled="Id is null">
                        @(string.IsNullOrEmpty(_logoPath) ? L.Translate("UploadLogoButton") : L.Translate("ChangeLogoButton"))
                    </MudButton>
                </ActivatorContent>
            </MudFileUpload>
            @if (Id is null)
            {
                <MudText Typo="Typo.caption" Color="Color.Default">@L.Translate("SaveCompanyFirstForLogoNote")</MudText>
            }
            @if (_logoError is not null)
            {
                <MudText Typo="Typo.caption" Color="Color.Error">@_logoError</MudText>
            }
        </MudStack>
    </MudStack>

    @if (!string.IsNullOrEmpty(_error))
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
    }

    <!-- แต่ละหมวดแยกเป็น Tab แทนการสกรอลยาวหน้าเดียว (แก้ตามที่ CEO สั่ง 12 ก.ย. 2569:
         "ทุกหัวข้อดูเป็นปื้นเดียวกันหมด ต้องแยกสัดส่วนให้ชัดเจน") -->
    <MudTabs Elevation="0" Rounded="true" Color="Color.Primary" PanelClass="pt-4" ApplyEffectsToContainer="true">
        <MudTabPanel Text="@L.Translate("GeneralInfoHeading")" Icon="@Icons.Material.Filled.Info">
            <MudGrid>
                <MudItem xs="12" sm="3"><MudTextField @bind-Value="_code" Label="@L.Translate("CompanyCodeLabel")" Required="true" MaxLength="50" /></MudItem>
                <MudItem xs="12" sm="3"><MudTextField @bind-Value="_abbr" Label="@L.Translate("AbbreviationLabel")" MaxLength="50" /></MudItem>
                <MudItem xs="12" sm="3"><MudTextField @bind-Value="_name" Label="@L.Translate("CompanyNameThLabel")" Required="true" MaxLength="500" /></MudItem>
                <MudItem xs="12" sm="3"><MudTextField @bind-Value="_nameEn" Label="@L.Translate("CompanyNameEnLabel")" MaxLength="500" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField @bind-Value="_slogan" Label="@L.Translate("SloganLabel")" MaxLength="500" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField @bind-Value="_website" Label="@L.Translate("WebsiteLabel")" MaxLength="500" /></MudItem>
                <MudItem xs="12"><MudTextField @bind-Value="_mission" Label="@L.Translate("MissionLabel")" Lines="2" MaxLength="2000" /></MudItem>
                <MudItem xs="12" sm="4">
                    <MudSwitch T="bool" @bind-Value="_isActive" Color="Color.Success" Label="@L.Translate("ActiveSwitchLabel")" />
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        <MudTabPanel Text="@L.Translate("LegalRegistrationHeading")" Icon="@Icons.Material.Filled.Gavel">
            <MudGrid>
                <MudItem xs="12" sm="4"><MudTextField @bind-Value="_taxId" Label="@L.Translate("TaxIdLabel")" MaxLength="50" /></MudItem>
                <MudItem xs="12" sm="4"><MudTextField @bind-Value="_businessTypeName" Label="@L.Translate("BusinessTypeNameLabel")" MaxLength="100" HelperText="@L.Translate("BusinessTypeNameHelperText")" /></MudItem>
                <MudItem xs="12" sm="4"><MudDatePicker @bind-Date="_registeredDate" Label="@L.Translate("RegisteredDateLabel")" /></MudItem>
                <MudItem xs="12" sm="4"><MudNumericField @bind-Value="_capitalRegister" Label="@L.Translate("RegisteredCapitalLabel")" Format="N2" /></MudItem>
                <MudItem xs="12" sm="4"><MudNumericField @bind-Value="_amountEmp" Label="@L.Translate("ApproxEmployeeCountLabel")" /></MudItem>
                <MudItem xs="12" sm="4">
                    <MudSwitch T="bool" @bind-Value="_vatRegistered" Color="Color.Primary" Label="@L.Translate("VatRegisteredSwitchLabel")" />
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        <MudTabPanel Text="@L.Translate("LocationContactHeading")" Icon="@Icons.Material.Filled.LocationOn">
            <MudGrid>
                <MudItem xs="12"><MudTextField @bind-Value="_addressHq" Label="@L.Translate("HqAddressLabel")" Lines="2" MaxLength="500" /></MudItem>
                <MudItem xs="12" sm="4"><MudTextField @bind-Value="_tel" Label="@L.Translate("FieldPhone")" MaxLength="500" /></MudItem>
                <MudItem xs="12" sm="4"><MudTextField @bind-Value="_email" Label="@L.Translate("FieldEmail")" MaxLength="250" InputType="InputType.Email" /></MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="_mapUrl" Label="@L.Translate("MapLinkLabel")" MaxLength="500" />
                    @if (!string.IsNullOrWhiteSpace(_mapUrl))
                    {
                        <MudLink Href="@_mapUrl" Target="_blank" Typo="Typo.caption">@L.Translate("OpenMapNewTabLink")</MudLink>
                    }
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        <MudTabPanel Text="@L.Translate("CrmHeading")" Icon="@Icons.Material.Filled.Handshake">
            <MudGrid>
                <MudItem xs="12" sm="3">
                    <MudSelect T="CustomerStatusType?" @bind-Value="_customerStatus" Label="@L.Translate("CustomerStatusLabel")" Clearable="true">
                        <MudSelectItem T="CustomerStatusType?" Value="@CustomerStatusType.Prospect">@L.Translate("CustomerStatusProspect")</MudSelectItem>
                        <MudSelectItem T="CustomerStatusType?" Value="@CustomerStatusType.Active">@L.Translate("CustomerStatusActive")</MudSelectItem>
                        <MudSelectItem T="CustomerStatusType?" Value="@CustomerStatusType.Inactive">@L.Translate("CustomerStatusInactive")</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudAutocomplete T="sc_user" Label="@L.Translate("AccountOwnerLabel")" @bind-Value="_accountOwner"
                        SearchFunc="SearchUsersAsync"
                        ToStringFunc="@(u => u == null ? null : $"{u.loginname} — {u.firstname} {u.lastname}")"
                        ResetValueOnEmptyText="true" CoerceText="true" MinCharacters="0" Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="3"><MudDatePicker @bind-Date="_nextRenewalDate" Label="@L.Translate("NextRenewalDateLabel")" /></MudItem>
                <MudItem xs="12" sm="3"><MudNumericField @bind-Value="_paymentTermsDays" Label="@L.Translate("PaymentTermsDaysLabel")" Min="0" /></MudItem>
                <MudItem xs="12"><MudTextField @bind-Value="_salesNote" Label="@L.Translate("SalesNoteLabel")" Lines="3" /></MudItem>
                <MudItem xs="12" sm="4"><MudDatePicker @bind-Date="_startDate" Label="@L.Translate("StartDateOperationLabel")" /></MudItem>
                <MudItem xs="12" sm="4"><MudDatePicker @bind-Date="_endDate" Label="@L.Translate("EndDateIfAnyLabel")" /></MudItem>
                <MudItem xs="12"><MudTextField @bind-Value="_remark" Label="@L.Translate("ColRemark")" Lines="2" MaxLength="2000" /></MudItem>
            </MudGrid>
        </MudTabPanel>

        @if (Id is not null)
        {
            <MudTabPanel Text="@L.Translate("ContactsHeading")" Icon="@Icons.Material.Filled.ContactPage">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                    <MudChip T="string" Color="Color.Warning" Size="Size.Small">PDPA</MudChip>
                </MudStack>
                <MudText Typo="Typo.body2" Class="mb-3">
                    @L.Translate("ContactsDesc")
                </MudText>

                <MudGrid>
                    <MudItem xs="12" sm="3"><MudTextField @bind-Value="_newContact.Name" Label="@L.Translate("FullNameLabel")" Required="true" MaxLength="200" /></MudItem>
                    <MudItem xs="12" sm="2"><MudTextField @bind-Value="_newContact.Position" Label="@L.Translate("PositionLabel")" MaxLength="150" /></MudItem>
                    <MudItem xs="12" sm="2"><MudTextField @bind-Value="_newContact.Department" Label="@L.Translate("ContactDepartmentLabel")" MaxLength="150" /></MudItem>
                    <MudItem xs="12" sm="2">
                        <MudSelect T="CompanyContactType" @bind-Value="_newContact.ContactType" Label="@L.Translate("ContactTypeFieldLabel")">
                            <MudSelectItem T="CompanyContactType" Value="@CompanyContactType.General">@L.Translate("ContactTypeGeneral")</MudSelectItem>
                            <MudSelectItem T="CompanyContactType" Value="@CompanyContactType.Billing">@L.Translate("ContactTypeBilling")</MudSelectItem>
                            <MudSelectItem T="CompanyContactType" Value="@CompanyContactType.Technical">@L.Translate("ContactTypeTechnical")</MudSelectItem>
                            <MudSelectItem T="CompanyContactType" Value="@CompanyContactType.DecisionMaker">@L.Translate("ContactTypeDecisionMaker")</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="3"><MudCheckBox T="bool" @bind-Value="_newContact.IsPrimary" Label="@L.Translate("PrimaryContactLabel")" /></MudItem>
                    <MudItem xs="12" sm="3"><MudTextField @bind-Value="_newContact.Phone" Label="@L.Translate("FieldPhone")" MaxLength="50" /></MudItem>
                    <MudItem xs="12" sm="3"><MudTextField @bind-Value="_newContact.Mobile" Label="@L.Translate("FieldMobile")" MaxLength="50" /></MudItem>
                    <MudItem xs="12" sm="3"><MudTextField @bind-Value="_newContact.Email" Label="@L.Translate("FieldEmail")" MaxLength="250" InputType="InputType.Email" /></MudItem>
                    <MudItem xs="12" sm="3"><MudTextField @bind-Value="_newContact.Note" Label="@L.Translate("ColRemark")" MaxLength="1000" /></MudItem>
                </MudGrid>

                @if (!string.IsNullOrEmpty(_contactError))
                {
                    <MudAlert Severity="Severity.Error" Class="mt-2">@_contactError</MudAlert>
                }

                <MudStack Row="true" Spacing="2" Class="mt-3">
                    <MudButton Color="Color.Primary" Variant="Variant.Outlined" OnClick="SaveContactAsync">
                        @(_editingContactId is null ? L.Translate("AddContactButton") : L.Translate("SaveEditButton"))
                    </MudButton>
                    @if (_editingContactId is not null)
                    {
                        <MudButton Variant="Variant.Text" OnClick="CancelContactEdit">@L.Translate("CancelButton")</MudButton>
                    }
                </MudStack>

                <MudTable Items="_contacts" Dense="true" Hover="true" Class="mt-4">
                    <HeaderContent>
                        <MudTh>@L.Translate("ColName")</MudTh>
                        <MudTh>@L.Translate("PositionDepartmentColLabel")</MudTh>
                        <MudTh>@L.Translate("ColType")</MudTh>
                        <MudTh>@L.Translate("ContactColLabel")</MudTh>
                        <MudTh>@L.Translate("PrimaryColLabel")</MudTh>
                        <MudTh>@L.Translate("ColStatus")</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Name</MudTd>
                        <MudTd>@context.Position @(string.IsNullOrWhiteSpace(context.Department) ? "" : $"/ {context.Department}")</MudTd>
                        <MudTd>@ContactTypeLabel(context.ContactType)</MudTd>
                        <MudTd>@(context.Mobile ?? context.Phone ?? context.Email ?? "-")</MudTd>
                        <MudTd>@(context.IsPrimary ? "✓" : "")</MudTd>
                        <MudTd>
                            <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                                @(context.IsActive ? L.Translate("PeriodActiveStatus") : L.Translate("PeriodInactiveStatus"))
                            </MudChip>
                        </MudTd>
                        <MudTd>
                            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => StartEditContact(context))">@L.Translate("EditButton")</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => ToggleContactActiveAsync(context))">
                                @(context.IsActive ? L.Translate("DeactivateButton") : L.Translate("ActivateButton"))
                            </MudButton>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
                @if (_contacts.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mt-2">@L.Translate("NoContactsYetMessage")</MudText>
                }
            </MudTabPanel>
        }
    </MudTabs>

    <MudDivider Class="my-4" />

    <MudStack Row="true" Spacing="2">
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">@L.Translate("SaveButton")</MudButton>
        <MudButton Variant="Variant.Text" OnClick="@(() => Nav.NavigateTo("/admin/system/companies"))">@L.Translate("CancelButton")</MudButton>
    </MudStack>
</MudPaper>

@code {
    [Parameter] public long? Id { get; set; }

    private string? _logoPath;
    private string _logoCacheBust = "0";
    private string? _logoError;
    private string? _error;

    private string _code = "";
    private string? _abbr;
    private string _name = "";
    private string? _nameEn;
    private string? _slogan;
    private string? _website;
    private string? _mission;
    private bool _isActive = true;
    private string? _taxId;
    private decimal? _capitalRegister;
    private int? _amountEmp;
    private string? _addressHq;
    private string? _tel;
    private string? _email;
    private DateTime? _startDate;
    private DateTime? _endDate;
    private string? _remark;

    private string? _businessTypeName;
    private DateTime? _registeredDate;
    private bool _vatRegistered;
    private string? _mapUrl;
    private CustomerStatusType? _customerStatus;
    private sc_user? _accountOwner;
    private DateTime? _nextRenewalDate;
    private string? _salesNote;
    private int? _paymentTermsDays;

    private List<Com_CompanyContact> _contacts = new();
    private Com_CompanyContact _newContact = new();
    private long? _editingContactId;
    private string? _contactError;

    protected override async Task OnParametersSetAsync()
    {
        if (Id is long id)
            await LoadAsync(id);
    }

    private async Task LoadAsync(long id)
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var item = await context.com_companies.FirstOrDefaultAsync(c => c.id == id);
        if (item is null) { _error = L.Translate("OtRuleNotFoundError"); return; }

        _logoPath = item.logp_path;
        _logoCacheBust = DateTime.Now.Ticks.ToString();
        _code = item.code;
        _abbr = item.abbr;
        _name = item.name;
        _nameEn = item.name_en;
        _slogan = item.slogan;
        _website = item.website;
        _mission = item.mission;
        _isActive = item.isActive ?? true;
        _taxId = item.tax_id;
        _capitalRegister = item.capital_register;
        _amountEmp = item.amount_emp;
        _addressHq = item.address_HQ;
        _tel = item.tel;
        _email = item.email;
        _startDate = item.startdate;
        _endDate = item.enddate;
        _remark = item.remark;

        _businessTypeName = item.BusinessTypeName;
        _registeredDate = item.RegisteredDate?.ToDateTime(TimeOnly.MinValue);
        _vatRegistered = item.VatRegistered;
        _mapUrl = item.MapUrl;
        _customerStatus = item.CustomerStatus;
        _nextRenewalDate = item.NextRenewalDate?.ToDateTime(TimeOnly.MinValue);
        _salesNote = item.SalesNote;
        _paymentTermsDays = item.PaymentTermsDays;

        _accountOwner = item.AccountOwnerUserId is long ownerId
            ? await context.sc_users.FirstOrDefaultAsync(u => u.userid == ownerId)
            : null;

        _contacts = await context.Com_CompanyContacts
            .Where(c => c.CompanyId == item.id)
            .OrderByDescending(c => c.IsPrimary).ThenBy(c => c.Name)
            .ToListAsync();

        // Editing here surfaces contact names/phone/email — PDPA access log.
        await AuditLogger.LogAccessAsync("com_company", item.id.ToString(), isSensitive: true, note: "view company profile incl. contacts");
    }

    private async Task<IEnumerable<sc_user>> SearchUsersAsync(string search, CancellationToken ct)
    {
        await using var context = await DbFactory.CreateDbContextAsync(ct);
        var query = context.sc_users.AsQueryable();
        if (!string.IsNullOrWhiteSpace(search))
        {
            query = query.Where(u => u.loginname.Contains(search)
                || u.firstname.Contains(search)
                || u.lastname.Contains(search));
        }
        return await query.OrderBy(u => u.loginname).Take(20).ToListAsync(ct);
    }

    private async Task SaveAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_code)) { _error = L.Translate("CompanyCodeRequiredError"); return; }
        if (string.IsNullOrWhiteSpace(_name)) { _error = L.Translate("CompanyNameRequiredError"); return; }

        await using var context = await DbFactory.CreateDbContextAsync();

        var codeTaken = await context.com_companies.AnyAsync(c =>
            c.code == _code && (Id == null || c.id != Id));
        if (codeTaken) { _error = L.Translate("CompanyCodeTakenError"); return; }

        var registeredDate = _registeredDate is DateTime rd ? DateOnly.FromDateTime(rd) : (DateOnly?)null;
        var nextRenewalDate = _nextRenewalDate is DateTime nrd ? DateOnly.FromDateTime(nrd) : (DateOnly?)null;

        // CEO rule (1 ก.ย. 2569): "บริษัท active ได้ 1" — the whole system
        // (org charts, new root org nodes) keys off THE active company, so
        // activating this one automatically deactivates every other row.
        if (_isActive)
        {
            var others = await context.com_companies
                .Where(c => c.isActive == true && (Id == null || c.id != Id))
                .ToListAsync();
            foreach (var o in others) { o.isActive = false; o.moddate = DateTime.Now; }
            if (others.Count > 0)
                Snackbar.Add($"สลับบริษัทที่ใช้งานเป็น '{_name}' — ปิดใช้งาน {others.Count} บริษัทเดิมอัตโนมัติ (ระบบใช้งานได้ทีละ 1 บริษัท)", Severity.Info);
        }

        long savedId;
        if (Id is long id)
        {
            var existing = await context.com_companies.FirstOrDefaultAsync(c => c.id == id);
            if (existing is null) { _error = L.Translate("OtRuleNotFoundError"); return; }
            existing.code = _code;
            existing.abbr = _abbr;
            existing.name = _name;
            existing.name_en = _nameEn;
            existing.slogan = _slogan;
            existing.website = _website;
            existing.mission = _mission;
            existing.isActive = _isActive;
            existing.tax_id = _taxId;
            existing.capital_register = _capitalRegister;
            existing.amount_emp = _amountEmp;
            existing.address_HQ = _addressHq;
            existing.tel = _tel;
            existing.email = _email;
            existing.startdate = _startDate;
            existing.enddate = _endDate;
            existing.remark = _remark;
            existing.moddate = DateTime.Now;

            existing.BusinessTypeName = _businessTypeName;
            existing.RegisteredDate = registeredDate;
            existing.VatRegistered = _vatRegistered;
            existing.MapUrl = _mapUrl;
            existing.CustomerStatus = _customerStatus;
            existing.AccountOwnerUserId = _accountOwner?.userid;
            existing.NextRenewalDate = nextRenewalDate;
            existing.SalesNote = _salesNote;
            existing.PaymentTermsDays = _paymentTermsDays;
            savedId = id;
        }
        else
        {
            var newItem = new com_company
            {
                code = _code,
                abbr = _abbr,
                name = _name,
                name_en = _nameEn,
                slogan = _slogan,
                website = _website,
                mission = _mission,
                isActive = _isActive,
                tax_id = _taxId,
                capital_register = _capitalRegister,
                amount_emp = _amountEmp,
                address_HQ = _addressHq,
                tel = _tel,
                email = _email,
                startdate = _startDate,
                enddate = _endDate,
                remark = _remark,
                moddate = DateTime.Now,

                BusinessTypeName = _businessTypeName,
                RegisteredDate = registeredDate,
                VatRegistered = _vatRegistered,
                MapUrl = _mapUrl,
                CustomerStatus = _customerStatus,
                AccountOwnerUserId = _accountOwner?.userid,
                NextRenewalDate = nextRenewalDate,
                SalesNote = _salesNote,
                PaymentTermsDays = _paymentTermsDays,
            };
            context.com_companies.Add(newItem);
            await context.SaveChangesAsync();
            savedId = newItem.id;
            Snackbar.Add(L.Translate("SavedSuccessGeneric"), Severity.Success);
            // เพิ่งสร้างใหม่ — ไปหน้า edit ของบริษัทนี้ต่อ (ปลดล็อกโลโก้/ผู้ติดต่อ)
            Nav.NavigateTo($"/admin/system/companies/{savedId}");
            return;
        }

        await context.SaveChangesAsync();
        Snackbar.Add(L.Translate("SavedSuccessGeneric"), Severity.Success);
        await LoadAsync(savedId);
    }

    private async Task OnLogoSelected(IBrowserFile file)
    {
        _logoError = null;
        if (Id is not long id) return;

        const long maxSize = 5 * 1024 * 1024; // 5 MB
        if (file.Size > maxSize)
        {
            _logoError = L.Translate("LogoFileTooLargeError");
            return;
        }
        var ext = Path.GetExtension(file.Name).ToLowerInvariant();
        if (ext != ".jpg" && ext != ".jpeg" && ext != ".png")
        {
            _logoError = L.Translate("LogoFileTypeError");
            return;
        }

        using var stream = file.OpenReadStream(maxSize);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        var bytes = ms.ToArray();

        var storedFileName = $"{id}_{DateTime.Now.Ticks}{ext}";
        var (relativePath, _) = await FileStorage.SaveAsync("company-logos", storedFileName, bytes);

        await using var context = await DbFactory.CreateDbContextAsync();
        var existing = await context.com_companies.FirstAsync(c => c.id == id);
        existing.logo_file = file.Name;
        existing.logp_path = relativePath;
        existing.moddate = DateTime.Now;
        await context.SaveChangesAsync();

        _logoPath = relativePath;
        _logoCacheBust = DateTime.Now.Ticks.ToString();
        Snackbar.Add(L.Translate("LogoUploadedSuccess"), Severity.Success);
    }

    // ----- contacts -----

    private string ContactTypeLabel(CompanyContactType type) => type switch
    {
        CompanyContactType.Billing => L.Translate("ContactTypeBilling"),
        CompanyContactType.Technical => L.Translate("ContactTypeTechnical"),
        CompanyContactType.DecisionMaker => L.Translate("ContactTypeDecisionMaker"),
        _ => L.Translate("ContactTypeGeneral"),
    };

    private void StartEditContact(Com_CompanyContact contact)
    {
        _editingContactId = contact.Id;
        _newContact = new Com_CompanyContact
        {
            Name = contact.Name,
            Position = contact.Position,
            Department = contact.Department,
            Phone = contact.Phone,
            Mobile = contact.Mobile,
            Email = contact.Email,
            ContactType = contact.ContactType,
            IsPrimary = contact.IsPrimary,
            Note = contact.Note,
        };
        _contactError = null;
    }

    private void CancelContactEdit()
    {
        _editingContactId = null;
        _newContact = new();
        _contactError = null;
    }

    private async Task SaveContactAsync()
    {
        _contactError = null;
        if (Id is not long companyId) return;
        if (string.IsNullOrWhiteSpace(_newContact.Name)) { _contactError = L.Translate("ContactNameRequiredError"); return; }

        await using var context = await DbFactory.CreateDbContextAsync();

        if (_editingContactId is long contactId)
        {
            var existing = await context.Com_CompanyContacts.FirstOrDefaultAsync(c => c.Id == contactId && c.CompanyId == companyId);
            if (existing is null) { _contactError = L.Translate("ContactNotFoundError"); return; }
            existing.Name = _newContact.Name;
            existing.Position = _newContact.Position;
            existing.Department = _newContact.Department;
            existing.Phone = _newContact.Phone;
            existing.Mobile = _newContact.Mobile;
            existing.Email = _newContact.Email;
            existing.ContactType = _newContact.ContactType;
            existing.IsPrimary = _newContact.IsPrimary;
            existing.Note = _newContact.Note;
        }
        else
        {
            context.Com_CompanyContacts.Add(new Com_CompanyContact
            {
                CompanyId = companyId,
                Name = _newContact.Name,
                Position = _newContact.Position,
                Department = _newContact.Department,
                Phone = _newContact.Phone,
                Mobile = _newContact.Mobile,
                Email = _newContact.Email,
                ContactType = _newContact.ContactType,
                IsPrimary = _newContact.IsPrimary,
                Note = _newContact.Note,
                IsActive = true,
                CreatedDate = DateTime.Now,
            });
        }

        await context.SaveChangesAsync();
        Snackbar.Add(L.Translate("ContactSavedSuccess"), Severity.Success);
        CancelContactEdit();

        _contacts = await context.Com_CompanyContacts
            .Where(c => c.CompanyId == companyId)
            .OrderByDescending(c => c.IsPrimary).ThenBy(c => c.Name)
            .ToListAsync();
    }

    private async Task ToggleContactActiveAsync(Com_CompanyContact contact)
    {
        if (Id is not long companyId) return;
        await using var context = await DbFactory.CreateDbContextAsync();
        var existing = await context.Com_CompanyContacts.FirstOrDefaultAsync(c => c.Id == contact.Id && c.CompanyId == companyId);
        if (existing is null) return;

        existing.IsActive = !existing.IsActive;
        await context.SaveChangesAsync();

        _contacts = await context.Com_CompanyContacts
            .Where(c => c.CompanyId == companyId)
            .OrderByDescending(c => c.IsPrimary).ThenBy(c => c.Name)
            .ToListAsync();
    }
}
