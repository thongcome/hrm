@page "/admin/workflow-design"
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using System.Text.Json
@using System.Text.RegularExpressions
@using HRM.Models
@using HRM.Services.Admin
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@inject IWebHostEnvironment Env
@attribute [Authorize(Policy = "Menu:SYS_ADMIN")]

<PageTitle>WorkflowDesign</PageTitle>

<MudText Typo="Typo.h5" Class="mb-1">WorkflowDesign — ออกแบบหน้าจอด้วย Drag &amp; Drop</MudText>
<MudText Typo="Typo.body2" Class="mb-4">
    ลาก field type จากพาเล็ตด้านซ้ายมาวางที่ผังด้านขวาเพื่อออกแบบหน้าจอ ลากแถวเพื่อจัดลำดับ แล้วกด "สร้างตาราง" เพื่อสร้างตารางจริงในฐานข้อมูลจากผังนี้
</MudText>

<MudGrid>
    <MudItem xs="12" md="3">
        <MudPaper Class="pa-3">
            <MudText Typo="Typo.subtitle1" Class="mb-2">พาเล็ต (ลากไปวางขวามือ)</MudText>
            @foreach (var pt in _paletteTypes)
            {
                <MudPaper Class="pa-2 mb-2 d-flex align-center" Elevation="2" Style="cursor:grab;"
                    draggable="true" @ondragstart="@(() => _draggedNewType = pt.Type)">
                    <MudIcon Icon="@pt.Icon" Class="mr-2" />
                    <MudText Typo="Typo.body2">@pt.LabelTh</MudText>
                </MudPaper>
            }
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="9">
        <MudPaper Class="pa-3 mb-4">
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_tableName" Label="ชื่อตาราง (ภาษาอังกฤษ)" HelperText="a-z, A-Z, 0-9, _ เท่านั้น ขึ้นต้นด้วยตัวอักษร" Required="true" />
                </MudItem>
                <MudItem xs="12" sm="6" Class="d-flex align-end">
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="CreateTableAsync">สร้างตาราง</MudButton>
                </MudItem>
            </MudGrid>
            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
            }
            @if (_generatedSql is not null)
            {
                <MudAlert Severity="Severity.Success" Class="mt-3">@_successMessage</MudAlert>
                <MudTextField Value="@_generatedSql" T="string" Lines="6" ReadOnly="true" Variant="Variant.Outlined" Class="mt-2" Label="SQL ที่ใช้สร้างตาราง" />
            }
        </MudPaper>

        <MudPaper Class="pa-3" @ondragover:preventDefault="true" @ondrop="DropNewField" Style="min-height:200px;">
            <MudText Typo="Typo.subtitle1" Class="mb-2">ผังหน้าจอ (@_fields.Count ฟิลด์)</MudText>
            @if (_fields.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">ลากประเภทฟิลด์จากพาเล็ตมาวางตรงนี้</MudText>
            }
            @for (var i = 0; i < _fields.Count; i++)
            {
                var idx = i;
                var f = _fields[idx];
                <MudPaper Class="pa-3 mb-2" Elevation="1" draggable="true"
                    @ondragstart="@(() => _draggedIndex = idx)"
                    @ondragover:preventDefault="true"
                    @ondrop="@(() => DropReorder(idx))">
                    <MudGrid AlignItems="Center.Center">
                        <MudItem xs="1"><MudIcon Icon="@Icons.Material.Filled.DragIndicator" Style="cursor:grab;" /></MudItem>
                        <MudItem xs="3"><MudTextField @bind-Value="f.ColumnName" Label="ชื่อคอลัมน์ (Column Name)" Dense="true" /></MudItem>
                        <MudItem xs="3"><MudTextField @bind-Value="f.LabelTh" Label="ป้ายชื่อ (Label)" Dense="true" /></MudItem>
                        <MudItem xs="2">
                            <MudSelect T="DesignFieldType" @bind-Value="f.Type" Label="ประเภท" Dense="true">
                                @foreach (var pt in _paletteTypes)
                                {
                                    <MudSelectItem T="DesignFieldType" Value="pt.Type">@pt.LabelTh</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        @if (f.Type == DesignFieldType.Text)
                        {
                            <MudItem xs="1"><MudNumericField @bind-Value="f.Length" Label="ความยาว" Dense="true" Min="1" Max="4000" /></MudItem>
                        }
                        else
                        {
                            <MudItem xs="1"></MudItem>
                        }
                        <MudItem xs="1"><MudCheckBox @bind-Value="f.Required" Label="บังคับ" Dense="true" /></MudItem>
                        <MudItem xs="1">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="@(() => _fields.RemoveAt(idx))" />
                        </MudItem>
                    </MudGrid>
                    @if (f.Type == DesignFieldType.Reference)
                    {
                        <MudGrid Class="mt-1">
                            <MudItem xs="12" sm="4">
                                <MudSelect T="string" Value="f.RefEntityType" ValueChanged="@(v => OnRefEntityChanged(f, v))" Label="อ้างอิงตาราง (Reference table)" Dense="true">
                                    @foreach (var t in _referenceTargets)
                                    {
                                        <MudSelectItem T="string" Value="t.EntityTypeName">@t.EntityTypeName</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudSelect T="string" @bind-Value="f.RefDisplayProperty" Label="ฟิลด์แสดงผล (Display column)" Dense="true"
                                    Disabled="@(f.RefEntityType is null)">
                                    @foreach (var p in RefStringPropertiesFor(f.RefEntityType))
                                    {
                                        <MudSelectItem T="string" Value="p">@p</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudSelect T="ReferencePickerMode" @bind-Value="f.RefPickerMode" Label="รูปแบบตัวเลือก (Picker)" Dense="true">
                                    <MudSelectItem T="ReferencePickerMode" Value="ReferencePickerMode.Dropdown">Dropdown (รายการน้อย)</MudSelectItem>
                                    <MudSelectItem T="ReferencePickerMode" Value="ReferencePickerMode.Autocomplete">Autocomplete (ค้นหา, รายการเยอะ)</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                        </MudGrid>
                    }
                </MudPaper>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

<MudPaper Class="pa-3 mt-4">
    <MudText Typo="Typo.subtitle1" Class="mb-2">ตารางที่เคยสร้างจากหน้านี้</MudText>
    @if (_history.Count == 0)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">ยังไม่เคยสร้างตารางจากหน้านี้</MudText>
    }
    else
    {
        @foreach (var h in _history)
        {
            <MudExpansionPanels Class="mb-2">
                <MudExpansionPanel Text="@($"{h.TableName} — สร้างเมื่อ {h.CreatedDate:dd/MM/yyyy HH:mm}")">
                    <MudSimpleTable Dense="true">
                        <thead>
                            <tr><th>Column Name</th><th>Label</th><th>ประเภท</th><th>บังคับ</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var f in DeserializeFields(h.FieldsJson))
                            {
                                <tr>
                                    <td>@f.ColumnName</td>
                                    <td>@f.LabelTh</td>
                                    <td>@f.Type</td>
                                    <td>@(f.Required ? "Yes" : "No")</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                    <MudStack Row="true" Spacing="2" Class="mt-3" AlignItems="AlignItems.Center">
                        <MudButton Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled"
                            Disabled="@EntityExists(h.TableName)"
                            OnClick="@(() => GenerateEntityAsync(h))">
                            @(EntityExists(h.TableName) ? "สร้าง Entity แล้ว" : "สร้าง Entity")
                        </MudButton>
                        <MudButton Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Filled"
                            Disabled="@(!EntityExists(h.TableName) || CrudExists(h.TableName))"
                            OnClick="@(() => GenerateCrudAsync(h))">
                            @(CrudExists(h.TableName) ? "สร้าง CRUD แล้ว" : "สร้าง CRUD")
                        </MudButton>
                        @if (CrudExists(h.TableName))
                        {
                            <MudText Typo="Typo.body2">route: /@WorkflowDesignCodeGenerator.RouteSlug(h.TableName)</MudText>
                        }
                    </MudStack>
                    @if (_rowMessages.TryGetValue(h.Id, out var msg))
                    {
                        <MudAlert Severity="Severity.Info" Class="mt-2" Dense="true">@msg</MudAlert>
                    }
                </MudExpansionPanel>
            </MudExpansionPanels>
        }
    }
</MudPaper>

@code {
    // DesignField/DesignFieldType live in HRM.Services.Admin.WorkflowDesignCodeGenerator
    // so the entity/CRUD code generator can share them with this page.
    private record PaletteType(DesignFieldType Type, string LabelTh, string Icon);

    private static readonly Regex IdentifierRegex = new(@"^[A-Za-z][A-Za-z0-9_]{0,63}$", RegexOptions.Compiled);

    private readonly List<PaletteType> _paletteTypes = new()
    {
        new(DesignFieldType.Text, "ข้อความ (Text)", Icons.Material.Filled.ShortText),
        new(DesignFieldType.Number, "ตัวเลข (Number)", Icons.Material.Filled.Numbers),
        new(DesignFieldType.Decimal, "ทศนิยม (Decimal)", Icons.Material.Filled.Percent),
        new(DesignFieldType.Date, "วันที่ (Date)", Icons.Material.Filled.CalendarToday),
        new(DesignFieldType.DateTime, "วันที่-เวลา (DateTime)", Icons.Material.Filled.Schedule),
        new(DesignFieldType.Checkbox, "ใช่/ไม่ใช่ (Checkbox)", Icons.Material.Filled.CheckBox),
        new(DesignFieldType.Reference, "อ้างอิง (Reference / FK)", Icons.Material.Filled.Link),
    };

    private List<DesignField> _fields = new();
    private string _tableName = "";
    private DesignFieldType? _draggedNewType;
    private int? _draggedIndex;
    private string? _error;
    private string? _successMessage;
    private string? _generatedSql;
    private List<WorkflowDesignTable> _history = new();
    private readonly Dictionary<long, string> _rowMessages = new();
    private List<ReferenceTarget> _referenceTargets = new();

    protected override async Task OnInitializedAsync()
    {
        LoadReferenceTargets();
        await LoadHistoryAsync();
    }

    // Reflects over HRMContext's DbSet<T> properties instead of the raw DB
    // schema — this way the picker always names a real DbSet property + a
    // real CLR type + a real string property, which the generated CRUD
    // pages can reference directly without guessing at naming conventions
    // (DbSet property names in this codebase don't consistently follow
    // "TypeName + s", e.g. context.Hremployee vs context.wf_workflows).
    // Only entities with a [Key]-or-"Id" numeric key AND at least one
    // string property are offered — anything else can't be resolved to a
    // Dictionary<long,string> label lookup or a long/long? soft-link
    // column safely (see WorkflowDesignCodeGenerator's ReferenceTarget doc).
    private void LoadReferenceTargets()
    {
        var numericKeyTypes = new HashSet<Type> { typeof(long), typeof(int), typeof(short), typeof(uint), typeof(ulong) };
        var targets = new List<ReferenceTarget>();

        foreach (var prop in typeof(HRMContext).GetProperties())
        {
            if (!prop.PropertyType.IsGenericType || prop.PropertyType.GetGenericTypeDefinition() != typeof(DbSet<>))
                continue;
            var entityType = prop.PropertyType.GetGenericArguments()[0];
            if (entityType.Namespace != "HRM.Models") continue;

            var keyProp = entityType.GetProperties()
                .FirstOrDefault(p => p.GetCustomAttributes(typeof(KeyAttribute), true).Length > 0)
                ?? entityType.GetProperty("Id") ?? entityType.GetProperty("id");
            if (keyProp is null) continue;
            var underlyingKeyType = Nullable.GetUnderlyingType(keyProp.PropertyType) ?? keyProp.PropertyType;
            if (!numericKeyTypes.Contains(underlyingKeyType)) continue;

            var stringProps = entityType.GetProperties()
                .Where(p => p.PropertyType == typeof(string) && p.CanRead && p.GetIndexParameters().Length == 0)
                .Select(p => p.Name)
                .OrderBy(n => n)
                .ToList();
            if (stringProps.Count == 0) continue;

            targets.Add(new ReferenceTarget(prop.Name, entityType.Name, keyProp.Name, stringProps));
        }

        _referenceTargets = targets.OrderBy(t => t.EntityTypeName).ToList();
    }

    private List<string> RefStringPropertiesFor(string? entityTypeName) =>
        entityTypeName is null ? new() : _referenceTargets.FirstOrDefault(t => t.EntityTypeName == entityTypeName)?.StringProperties ?? new();

    private void OnRefEntityChanged(DesignField f, string entityTypeName)
    {
        var target = _referenceTargets.FirstOrDefault(t => t.EntityTypeName == entityTypeName);
        if (target is null) return;
        f.RefEntityType = target.EntityTypeName;
        f.RefDbSetProperty = target.DbSetProperty;
        f.RefKeyProperty = target.KeyProperty;
        f.RefDisplayProperty = target.StringProperties.Contains(f.RefDisplayProperty ?? "")
            ? f.RefDisplayProperty
            : target.StringProperties.FirstOrDefault();
    }

    private async Task LoadHistoryAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        _history = await context.WorkflowDesignTables.OrderByDescending(t => t.CreatedDate).ToListAsync();
    }

    private static List<DesignField> DeserializeFields(string json) =>
        JsonSerializer.Deserialize<List<DesignField>>(json) ?? new();

    private void DropNewField()
    {
        if (_draggedNewType is null) return;
        var n = _fields.Count + 1;
        _fields.Add(new DesignField
        {
            ColumnName = $"Field{n}",
            LabelTh = "ฟิลด์ใหม่",
            Type = _draggedNewType.Value,
        });
        _draggedNewType = null;
    }

    private void DropReorder(int targetIndex)
    {
        if (_draggedIndex is null || _draggedIndex == targetIndex)
        {
            _draggedIndex = null;
            return;
        }
        var item = _fields[_draggedIndex.Value];
        _fields.RemoveAt(_draggedIndex.Value);
        var insertAt = targetIndex > _draggedIndex.Value ? targetIndex - 1 : targetIndex;
        _fields.Insert(insertAt, item);
        _draggedIndex = null;
    }

    private static string ColumnSqlType(DesignField f) => f.Type switch
    {
        DesignFieldType.Text => $"nvarchar({(f.Length is > 0 and <= 4000 ? f.Length : 200)})",
        DesignFieldType.Number => "int",
        DesignFieldType.Decimal => "decimal(18,2)",
        DesignFieldType.Date => "date",
        DesignFieldType.DateTime => "datetime2",
        DesignFieldType.Checkbox => "bit",
        DesignFieldType.Reference => "bigint",
        _ => "nvarchar(200)",
    };

    private async Task<long> GetCurrentUserIdAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        var idClaim = state.User.FindFirstValue("sc_userid");
        return long.TryParse(idClaim, out var id) ? id : 0;
    }

    // Table/column identifiers are validated against IdentifierRegex (alnum
    // + underscore only, starts with a letter) AND bracket-quoted in the
    // generated DDL — both together rule out SQL injection through this
    // user-controlled DDL string, since bracket-quoted alnum/underscore
    // text can't break out of the identifier position.
    private async Task CreateTableAsync()
    {
        _error = null;
        _successMessage = null;
        _generatedSql = null;

        if (string.IsNullOrWhiteSpace(_tableName) || !IdentifierRegex.IsMatch(_tableName))
        {
            _error = "ชื่อตารางต้องขึ้นต้นด้วยตัวอักษร และมีเฉพาะ a-z, A-Z, 0-9, _ เท่านั้น";
            return;
        }
        if (_fields.Count == 0)
        {
            _error = "ต้องมีอย่างน้อย 1 ฟิลด์";
            return;
        }
        foreach (var f in _fields)
        {
            if (string.IsNullOrWhiteSpace(f.ColumnName) || !IdentifierRegex.IsMatch(f.ColumnName))
            {
                _error = $"ชื่อคอลัมน์ \"{f.ColumnName}\" ไม่ถูกต้อง — ต้องขึ้นต้นด้วยตัวอักษร และมีเฉพาะ a-z, A-Z, 0-9, _ เท่านั้น";
                return;
            }
        }
        var dupCols = _fields.GroupBy(f => f.ColumnName, StringComparer.OrdinalIgnoreCase)
            .Where(g => g.Count() > 1).Select(g => g.Key).ToList();
        if (dupCols.Count > 0)
        {
            _error = $"มีชื่อคอลัมน์ซ้ำกัน: {string.Join(", ", dupCols)}";
            return;
        }
        // Every generated table always gets an auto Id (PK) and CreatedDate
        // column tacked on (see the DDL below) — a user field with either
        // name collides with those under SQL Server's default
        // case-insensitive collation and makes CREATE TABLE fail outright.
        var reservedCols = _fields.Where(f => f.ColumnName.Equals("Id", StringComparison.OrdinalIgnoreCase)
            || f.ColumnName.Equals("CreatedDate", StringComparison.OrdinalIgnoreCase)).Select(f => f.ColumnName).ToList();
        if (reservedCols.Count > 0)
        {
            _error = $"ชื่อคอลัมน์ {string.Join(", ", reservedCols)} ชนกับคอลัมน์ระบบ (Id/CreatedDate) ที่สร้างให้อัตโนมัติ — กรุณาตั้งชื่ออื่น";
            return;
        }
        var incompleteRefs = _fields.Where(f => f.Type == DesignFieldType.Reference
            && (string.IsNullOrEmpty(f.RefEntityType) || string.IsNullOrEmpty(f.RefDisplayProperty))).Select(f => f.ColumnName).ToList();
        if (incompleteRefs.Count > 0)
        {
            _error = $"ฟิลด์อ้างอิง {string.Join(", ", incompleteRefs)} ยังไม่ได้เลือกตาราง/ฟิลด์แสดงผล — กรุณาเลือกให้ครบ";
            return;
        }

        try
        {
            await using var context = await DbFactory.CreateDbContextAsync();

            var exists = await context.Database
                .SqlQueryRaw<int>("SELECT COUNT(*) AS [Value] FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_NAME = {0}", _tableName)
                .FirstAsync();
            if (exists > 0)
            {
                _error = $"มีตารางชื่อ \"{_tableName}\" อยู่แล้วในฐานข้อมูล — กรุณาตั้งชื่ออื่น";
                return;
            }

            var columnDefs = _fields.Select(f => $"    [{f.ColumnName}] {ColumnSqlType(f)} {(f.Required ? "NOT NULL" : "NULL")}");
            var sql = $"CREATE TABLE [dbo].[{_tableName}] (\n    [Id] bigint IDENTITY(1,1) PRIMARY KEY,\n{string.Join(",\n", columnDefs)},\n    [CreatedDate] datetime2 NOT NULL DEFAULT (getdate())\n);";

            await context.Database.ExecuteSqlRawAsync(sql);

            context.WorkflowDesignTables.Add(new WorkflowDesignTable
            {
                TableName = _tableName,
                FieldsJson = JsonSerializer.Serialize(_fields),
                CreatedByUserId = await GetCurrentUserIdAsync(),
            });
            await context.SaveChangesAsync();

            _generatedSql = sql;
            _successMessage = $"สร้างตาราง \"{_tableName}\" สำเร็จ";
            Snackbar.Add(_successMessage, Severity.Success);

            _tableName = "";
            _fields = new();
        }
        catch (Exception ex)
        {
            // Never fail silently — a raw-DDL statement can hit errors this
            // form's own validation can't fully anticipate (reserved SQL
            // keywords as column names, server-side permission issues,
            // etc.), so surface whatever SQL Server actually said.
            _error = $"สร้างตารางไม่สำเร็จ: {ex.Message}";
        }
        await LoadHistoryAsync();
    }

    private string EntityModelPath(string tableName) => Path.Combine(Env.ContentRootPath, "Model", $"{tableName}.cs");
    private string CrudPagesDir(string tableName) => Path.Combine(Env.ContentRootPath, "Components", "Pages", $"{tableName}Pages");

    private bool EntityExists(string tableName) => File.Exists(EntityModelPath(tableName));
    private bool CrudExists(string tableName) => Directory.Exists(CrudPagesDir(tableName));

    // Writes Model/{TableName}.cs and inserts a matching DbSet line into
    // HRMContext.cs. This only writes SOURCE files — the running app can't
    // pick up a brand new type without a rebuild, so the generated code
    // isn't usable until the next dotnet build / dev-server restart (same
    // as any other scaffolding tool).
    private async Task GenerateEntityAsync(WorkflowDesignTable h)
    {
        _rowMessages.Remove(h.Id);
        if (EntityExists(h.TableName))
        {
            _rowMessages[h.Id] = $"มีไฟล์ Model/{h.TableName}.cs อยู่แล้ว — ไม่เขียนทับ";
            return;
        }

        try
        {
            var fields = DeserializeFields(h.FieldsJson);
            var entityCode = WorkflowDesignCodeGenerator.GenerateEntityCode(h.TableName, fields);
            await File.WriteAllTextAsync(EntityModelPath(h.TableName), entityCode);

            var contextPath = Path.Combine(Env.ContentRootPath, "Model", "HRMContext.cs");
            var contextCode = await File.ReadAllTextAsync(contextPath);
            if (!contextCode.Contains($"DbSet<{h.TableName}>"))
            {
                const string anchor = "public virtual DbSet<WorkflowDesignTable> WorkflowDesignTables { get; set; }";
                var dbSetLine = WorkflowDesignCodeGenerator.GenerateDbSetLine(h.TableName);
                contextCode = contextCode.Replace(anchor, anchor + "\n\n" + dbSetLine);
                await File.WriteAllTextAsync(contextPath, contextCode);
            }

            _rowMessages[h.Id] = $"สร้าง Model/{h.TableName}.cs และเพิ่ม DbSet ใน HRMContext.cs แล้ว — ต้อง build/restart แอปก่อนใช้งานได้";
            Snackbar.Add(_rowMessages[h.Id], Severity.Success);
        }
        catch (Exception ex)
        {
            _rowMessages[h.Id] = $"สร้าง Entity ไม่สำเร็จ: {ex.Message}";
        }
    }

    // Writes the 5-file CRUD page set into Components/Pages/{TableName}Pages/
    // — same "requires rebuild" caveat as GenerateEntityAsync.
    private async Task GenerateCrudAsync(WorkflowDesignTable h)
    {
        _rowMessages.Remove(h.Id);
        if (CrudExists(h.TableName))
        {
            _rowMessages[h.Id] = $"มีโฟลเดอร์ CRUD ของ {h.TableName} อยู่แล้ว — ไม่เขียนทับ";
            return;
        }

        try
        {
            var fields = DeserializeFields(h.FieldsJson);
            var dir = CrudPagesDir(h.TableName);
            Directory.CreateDirectory(dir);

            await File.WriteAllTextAsync(Path.Combine(dir, "Index.razor"), WorkflowDesignCodeGenerator.GenerateIndexPage(h.TableName, fields));
            await File.WriteAllTextAsync(Path.Combine(dir, "Create.razor"), WorkflowDesignCodeGenerator.GenerateCreatePage(h.TableName, fields));
            await File.WriteAllTextAsync(Path.Combine(dir, "Edit.razor"), WorkflowDesignCodeGenerator.GenerateEditPage(h.TableName, fields));
            await File.WriteAllTextAsync(Path.Combine(dir, "Details.razor"), WorkflowDesignCodeGenerator.GenerateDetailsPage(h.TableName, fields));
            await File.WriteAllTextAsync(Path.Combine(dir, "Delete.razor"), WorkflowDesignCodeGenerator.GenerateDeletePage(h.TableName, fields));

            _rowMessages[h.Id] = $"สร้างหน้า CRUD ที่ /{WorkflowDesignCodeGenerator.RouteSlug(h.TableName)} แล้ว — ต้อง build/restart แอปก่อนใช้งานได้";
            Snackbar.Add(_rowMessages[h.Id], Severity.Success);
        }
        catch (Exception ex)
        {
            _rowMessages[h.Id] = $"สร้าง CRUD ไม่สำเร็จ: {ex.Message}";
        }
    }
}
