@page "/admin/super-master/tax-brackets"
@using HRM.Models
@using HRM.Services.Security
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject ProgramRoleService ProgramRoles
@inject ISnackbar Snackbar
@attribute [Authorize(Policy = "Menu:SYS_ADMIN")]

<PageTitle>ตารางอัตราภาษีขั้นบันได</PageTitle>

<MudPaper Class="pa-4 mb-4" MaxWidth="900px">
    <MudText Typo="Typo.h5">ตารางอัตราภาษีขั้นบันได (Pay_TaxBracket)</MudText>
    <MudText Typo="Typo.body2" Class="mt-1">
        ช่วงเงินได้สุทธิต่อปีและอัตราภาษีของแต่ละขั้น ต่อปีภาษี — ตัวคำนวณหัก ณ ที่จ่ายอ่านจากตารางนี้ ปีที่ไม่มีแถวคำนวณไม่ได้
        (ระบบจะแจ้งตอนคำนวณ) เปลี่ยนแล้วมีผลกับรอบที่คำนวณหลังจากนี้
    </MudText>
    @if (_rights is { CanEdit: false, CanCreate: false })
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">หน้านี้ยังไม่ได้เปิดสิทธิ์แก้ไขให้บทบาทของคุณ</MudAlert>
    }

    <MudGrid Class="mt-3">
        <MudItem xs="12" sm="4">
            <MudNumericField T="int" @bind-Value="_year" @bind-Value:after="LoadAsync" Label="ปีภาษี (ค.ศ.)" Min="2020" Max="2100" />
        </MudItem>
        <MudItem xs="12" sm="8" Class="d-flex align-center">
            @if (_rights?.CanCreate == true && _rows.Count == 0)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="CopyFromPreviousYearAsync">คัดลอกจากปี @(_year - 1)</MudButton>
            }
        </MudItem>
    </MudGrid>

    <MudTable Items="_rows" Dense="true" Hover="true" Class="mt-3">
        <HeaderContent>
            <MudTh>ขั้น</MudTh>
            <MudTh>เงินได้สุทธิ ตั้งแต่</MudTh>
            <MudTh>ถึง (ว่าง = ไม่จำกัด)</MudTh>
            <MudTh>อัตรา %</MudTh>
            <MudTh>สถานะ</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            @if (_editing is not null && _editing.Id == context.Id)
            {
                <MudTd><MudNumericField T="int" @bind-Value="_editing.Step" Min="1" Margin="Margin.Dense" Variant="Variant.Outlined" Style="width:80px;" /></MudTd>
                <MudTd><MudNumericField T="decimal" @bind-Value="_editing.MinIncome" Format="N0" Min="0" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudTd>
                <MudTd><MudNumericField T="decimal?" @bind-Value="_editing.MaxIncome" Format="N0" Min="0" Clearable="true" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudTd>
                <MudTd><MudNumericField T="decimal" @bind-Value="_editing.RatePercent" Format="0.##" Min="0" Max="100" Margin="Margin.Dense" Variant="Variant.Outlined" Style="width:100px;" /></MudTd>
                <MudTd><MudCheckBox T="bool" @bind-Value="_editing.IsActive" Dense="true" /></MudTd>
                <MudTd style="white-space:nowrap;">
                    <MudIconButton Icon="@Icons.Material.Filled.Save" Color="Color.Primary" Size="Size.Small" OnClick="SaveEditAsync" />
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => _editing = null)" />
                </MudTd>
            }
            else
            {
                <MudTd>@context.Step</MudTd>
                <MudTd>@context.MinIncome.ToString("N0")</MudTd>
                <MudTd>@(context.MaxIncome?.ToString("N0") ?? "ไม่จำกัด")</MudTd>
                <MudTd>@context.RatePercent.ToString("0.##") %</MudTd>
                <MudTd>@(context.IsActive ? "ใช้งาน" : "ปิด")</MudTd>
                <MudTd>
                    @if (_rights?.CanEdit == true)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => BeginEdit(context))" />
                    }
                </MudTd>
            }
        </RowTemplate>
        <NoRecordsContent><MudText Typo="Typo.body2">ปี @_year ยังไม่มีตารางอัตราภาษี — คัดลอกจากปีก่อน หรือเพิ่มทีละขั้น</MudText></NoRecordsContent>
    </MudTable>

    @if (_rights?.CanCreate == true)
    {
        <MudDivider Class="my-4" />
        <MudText Typo="Typo.subtitle1" Class="mb-2">เพิ่มขั้น ปี @_year</MudText>
        <MudGrid>
            <MudItem xs="6" sm="2"><MudNumericField T="int" @bind-Value="_newStep" Label="ขั้น" Min="1" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="6" sm="3"><MudNumericField T="decimal" @bind-Value="_newMin" Label="ตั้งแต่" Format="N0" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="6" sm="3"><MudNumericField T="decimal?" @bind-Value="_newMax" Label="ถึง" Format="N0" Min="0" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="6" sm="2"><MudNumericField T="decimal" @bind-Value="_newRate" Label="อัตรา %" Format="0.##" Min="0" Max="100" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="12" sm="2"><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddAsync">เพิ่ม</MudButton></MudItem>
        </MudGrid>
    }
</MudPaper>

@code {
    private const string ProgramPath = "/admin/super-master/tax-brackets";

    private ProgramRoleService.ProgramRights? _rights;
    private int _year = DateTime.Today.Year;
    private List<Pay_TaxBracket> _rows = new();
    private Pay_TaxBracket? _editing;
    private int _newStep = 1;
    private decimal _newMin;
    private decimal? _newMax;
    private decimal _newRate;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _rights = await ProgramRoles.GetRightsAsync(state.User, ProgramPath);
        await LoadAsync();
    }

    private async Task<string?> RequireRightAsync(ProgramRoleService.ProgramAction action)
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        try { await ProgramRoles.RequireAsync(state.User, ProgramPath, action); return null; }
        catch (InvalidOperationException ex) { return ex.Message; }
    }

    private async Task LoadAsync()
    {
        await using var ctx = await DbFactory.CreateDbContextAsync();
        _rows = await ctx.Pay_TaxBrackets.Where(b => b.EffectiveYear == _year).OrderBy(b => b.Step).ToListAsync();
        _newStep = (_rows.LastOrDefault()?.Step ?? 0) + 1;
        _newMin = _rows.LastOrDefault()?.MaxIncome ?? 0m;
    }

    private void BeginEdit(Pay_TaxBracket b) => _editing = new Pay_TaxBracket
    {
        Id = b.Id, EffectiveYear = b.EffectiveYear, Step = b.Step, MinIncome = b.MinIncome, MaxIncome = b.MaxIncome, RatePercent = b.RatePercent, IsActive = b.IsActive,
    };

    private async Task SaveEditAsync()
    {
        if (_editing is null) return;
        if (await RequireRightAsync(ProgramRoleService.ProgramAction.Edit) is string denied) { Snackbar.Add(denied, Severity.Error); return; }
        if (_editing.MaxIncome is decimal mx && mx <= _editing.MinIncome) { Snackbar.Add("ค่า 'ถึง' ต้องมากกว่า 'ตั้งแต่'", Severity.Warning); return; }
        await using var ctx = await DbFactory.CreateDbContextAsync();
        var row = await ctx.Pay_TaxBrackets.FirstOrDefaultAsync(b => b.Id == _editing.Id);
        if (row is null) return;
        row.Step = _editing.Step; row.MinIncome = _editing.MinIncome; row.MaxIncome = _editing.MaxIncome; row.RatePercent = _editing.RatePercent; row.IsActive = _editing.IsActive;
        await ctx.SaveChangesAsync();
        _editing = null;
        Snackbar.Add("บันทึกแล้ว — มีผลกับรอบที่คำนวณหลังจากนี้", Severity.Success);
        await LoadAsync();
    }

    private async Task AddAsync()
    {
        if (await RequireRightAsync(ProgramRoleService.ProgramAction.Create) is string denied) { Snackbar.Add(denied, Severity.Error); return; }
        if (_newMax is decimal mx && mx <= _newMin) { Snackbar.Add("ค่า 'ถึง' ต้องมากกว่า 'ตั้งแต่'", Severity.Warning); return; }
        await using var ctx = await DbFactory.CreateDbContextAsync();
        if (await ctx.Pay_TaxBrackets.AnyAsync(b => b.EffectiveYear == _year && b.Step == _newStep)) { Snackbar.Add($"ปี {_year} มีขั้นที่ {_newStep} แล้ว", Severity.Warning); return; }
        ctx.Pay_TaxBrackets.Add(new Pay_TaxBracket { EffectiveYear = _year, Step = _newStep, MinIncome = _newMin, MaxIncome = _newMax, RatePercent = _newRate, IsActive = true });
        await ctx.SaveChangesAsync();
        Snackbar.Add("เพิ่มขั้นแล้ว", Severity.Success);
        _newMax = null; _newRate = 0m;
        await LoadAsync();
    }

    private async Task CopyFromPreviousYearAsync()
    {
        if (await RequireRightAsync(ProgramRoleService.ProgramAction.Create) is string denied) { Snackbar.Add(denied, Severity.Error); return; }
        await using var ctx = await DbFactory.CreateDbContextAsync();
        var prev = await ctx.Pay_TaxBrackets.Where(b => b.EffectiveYear == _year - 1 && b.IsActive).OrderBy(b => b.Step).ToListAsync();
        if (prev.Count == 0) { Snackbar.Add($"ปี {_year - 1} ไม่มีตารางให้คัดลอก", Severity.Warning); return; }
        foreach (var p in prev)
            ctx.Pay_TaxBrackets.Add(new Pay_TaxBracket { EffectiveYear = _year, Step = p.Step, MinIncome = p.MinIncome, MaxIncome = p.MaxIncome, RatePercent = p.RatePercent, IsActive = true });
        await ctx.SaveChangesAsync();
        Snackbar.Add($"คัดลอก {prev.Count} ขั้นจากปี {_year - 1} แล้ว", Severity.Success);
        await LoadAsync();
    }
}
