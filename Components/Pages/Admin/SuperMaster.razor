@page "/admin/super-master"
@using HRM.Models
@using HRM.Services.Security
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject ProgramRoleService ProgramRoles
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@attribute [Authorize(Policy = "Menu:PAY_ADMIN")]

<PageTitle>Super Master</PageTitle>

<MudPaper Class="pa-4 mb-4">
    <div class="d-flex align-center gap-2">
        <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Color="Color.Primary" Size="Size.Large" />
        <div>
            <MudText Typo="Typo.h5">Super Master — ค่าตั้งต้นของระบบ</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                ค่าที่กระทบการคำนวณทั้งระบบ (ภาษี ประกันสังคม กองทุน รอบจ่าย) รวมไว้ที่เดียว — ไม่ใช่งานประจำวันของ HR
                ด้านล่างคือทะเบียนว่าค่าไหนต้องควบคุม และใครแก้ได้ (ยังไม่บังคับสิทธิ์จนกว่าจะตัดสิน)
            </MudText>
        </div>
    </div>
</MudPaper>

@foreach (var section in Sections.Where(s => !s.SystemOnly || _isSystemAdmin))
{
    <MudText Typo="Typo.h6" Class="mt-4 mb-2">@section.Title</MudText>
    <MudGrid>
        @foreach (var card in section.Cards)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudCard Outlined="true" Class="cursor-pointer" @onclick="@(() => Nav.NavigateTo(card.Url))" Style="height:100%">
                    <MudCardContent>
                        <div class="d-flex align-center gap-3">
                            <MudIcon Icon="@card.Icon" Color="Color.Primary" Size="Size.Large" />
                            <div>
                                <MudText Typo="Typo.subtitle1"><b>@card.Title</b></MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">@card.Description</MudText>
                            </div>
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

<MudPaper Class="pa-4 mt-6">
    <MudText Typo="Typo.h6">ทะเบียนค่าที่ต้องควบคุม</MudText>
    <MudText Typo="Typo.body2" Class="mt-1 mb-3">
        หนึ่งแถว = หนึ่งค่า (ตาราง/ฟิลด์) พร้อมเหตุผลและหน้าที่ใช้แก้ · ช่อง "ใครแก้ได้" ยังเป็น "ยังไม่ตัดสิน" ได้ —
        เมื่อตัดสินแล้วระบบจะใช้ค่านี้บังคับสิทธิ์ (ลูกค้าเห็นเป็นอ่านอย่างเดียวถ้าเป็น "เจ้าของซอฟต์แวร์เท่านั้น")
    </MudText>
    @if (_rights is { CanEdit: false, CanCreate: false })
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">หน้านี้ยังไม่ได้เปิดสิทธิ์แก้ไขให้บทบาทของคุณ</MudAlert>
    }

    <MudTable Items="_rows" Dense="true" Hover="true" GroupBy="@_groupBy">
        <GroupHeaderTemplate>
            <MudTh colspan="7"><b>@context.Key</b></MudTh>
        </GroupHeaderTemplate>
        <HeaderContent>
            <MudTh>ค่า</MudTh>
            <MudTh>ตาราง.ฟิลด์</MudTh>
            <MudTh>เหตุผลที่ต้องควบคุม</MudTh>
            <MudTh>หน้าที่ใช้แก้</MudTh>
            <MudTh>ใครแก้ได้</MudTh>
            <MudTh>สถานะ</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            @if (_editing is not null && _editing.Id == context.Id)
            {
                <MudTd><MudTextField T="string" @bind-Value="_editing.DisplayName" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudTd>
                <MudTd><span class="mud-text-secondary">@context.TableName.@context.FieldName</span></MudTd>
                <MudTd><MudTextField T="string" @bind-Value="_editing.Reason" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudTd>
                <MudTd><MudTextField T="string" @bind-Value="_editing.PageRoute" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudTd>
                <MudTd>
                    <MudSelect T="ProtectedSettingEditor" @bind-Value="_editing.EditableBy" Margin="Margin.Dense" Variant="Variant.Outlined">
                        <MudSelectItem T="ProtectedSettingEditor" Value="ProtectedSettingEditor.Undecided">ยังไม่ตัดสิน</MudSelectItem>
                        <MudSelectItem T="ProtectedSettingEditor" Value="ProtectedSettingEditor.Customer">ลูกค้าแก้เองได้</MudSelectItem>
                        <MudSelectItem T="ProtectedSettingEditor" Value="ProtectedSettingEditor.VendorOnly">เจ้าของซอฟต์แวร์เท่านั้น</MudSelectItem>
                    </MudSelect>
                </MudTd>
                <MudTd><MudCheckBox T="bool" @bind-Value="_editing.IsActive" Dense="true" /></MudTd>
                <MudTd style="white-space:nowrap;">
                    <MudIconButton Icon="@Icons.Material.Filled.Save" Color="Color.Primary" Size="Size.Small" OnClick="SaveEditAsync" />
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => _editing = null)" />
                </MudTd>
            }
            else
            {
                <MudTd><b>@context.DisplayName</b><br /><span class="mud-text-secondary" style="font-size:.8em">@context.SettingKey</span></MudTd>
                <MudTd>@context.TableName.@context.FieldName</MudTd>
                <MudTd>@context.Reason</MudTd>
                <MudTd>@if (!string.IsNullOrWhiteSpace(context.PageRoute)) { <MudLink Href="@context.PageRoute">@context.PageRoute</MudLink> }</MudTd>
                <MudTd>
                    <MudChip T="string" Size="Size.Small" Color="@EditorColor(context.EditableBy)">@EditorLabel(context.EditableBy)</MudChip>
                </MudTd>
                <MudTd>@(context.IsActive ? "ใช้งาน" : "ปิด")</MudTd>
                <MudTd>
                    @if (_rights?.CanEdit == true)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => BeginEdit(context))" />
                    }
                </MudTd>
            }
        </RowTemplate>
        <NoRecordsContent><MudText Typo="Typo.body2">ยังไม่มีรายการ</MudText></NoRecordsContent>
    </MudTable>

    @if (_rights?.CanCreate == true)
    {
        <MudDivider Class="my-4" />
        <MudText Typo="Typo.subtitle1" Class="mb-2">เพิ่มค่าที่ต้องควบคุม</MudText>
        <MudGrid>
            <MudItem xs="12" sm="3"><MudTextField T="string" @bind-Value="_new.SettingKey" Label="รหัส (เช่น PAY.TAX.X)" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="12" sm="2"><MudTextField T="string" @bind-Value="_new.Area" Label="ระบบ" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="12" sm="3"><MudTextField T="string" @bind-Value="_new.TableName" Label="ตาราง" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="12" sm="4"><MudTextField T="string" @bind-Value="_new.FieldName" Label="ฟิลด์ (* = ทั้งตาราง)" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="12" sm="4"><MudTextField T="string" @bind-Value="_new.DisplayName" Label="ชื่อที่แสดง" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="12" sm="5"><MudTextField T="string" @bind-Value="_new.Reason" Label="เหตุผลที่ต้องควบคุม" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="12" sm="3"><MudTextField T="string" @bind-Value="_new.PageRoute" Label="หน้าที่ใช้แก้ (/...)" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="12" sm="3"><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddAsync">เพิ่ม</MudButton></MudItem>
        </MudGrid>
    }
</MudPaper>

@code {
    private const string ProgramPath = "/admin/super-master";

    private record Card(string Title, string Description, string Icon, string Url);
    private record Section(string Title, Card[] Cards, bool SystemOnly = false);

    private static readonly Section[] Sections =
    {
        new("เงินเดือน — ค่าที่กระทบการคำนวณทั้งระบบ", new[]
        {
            new Card("รอบจ่ายเงินเดือน", "กี่งวดต่อเดือน ต่อกลุ่มพนักงาน ทับรายคน เปลี่ยนกลางปี", Icons.Material.Filled.EventRepeat, "/pay/admin/pay-schedules"),
            new Card("จัดการงวดเงินเดือน", "ปี/เดือน/งวด วันเริ่ม-สิ้นสุด", Icons.Material.Filled.CalendarMonth, "/pay/admin/periods"),
            new Card("ตารางอัตราภาษีขั้นบันได", "ช่วงเงินได้และอัตราภาษีต่อปีภาษี", Icons.Material.Filled.Percent, "/admin/super-master/tax-brackets"),
            new Card("ค่าลดหย่อนมาตรฐาน", "ลดหย่อนส่วนตัว ค่าใช้จ่ายเหมา เพดานลดหย่อนกองทุน", Icons.Material.Filled.Calculate, "/pay/admin/tax-deduction-config"),
            new Card("อัตราและเพดานประกันสังคม", "เปอร์เซ็นต์และเพดานค่าจ้างต่อเดือน", Icons.Material.Filled.HealthAndSafety, "/hrucfsecurities"),
            new Card("นโยบายหักสาย/ขาด และอัตราต่อวัน", "ตัวหารวันต่อเดือน วิธีคิดสัดส่วน วิธีนับวันรายวัน", Icons.Material.Filled.Rule, "/pay/admin/attendance-deduction"),
            new Card("รายการรับ-จ่าย (Pay Element)", "ธงเสียภาษี ฐานประกันสังคม ฐานกองทุน", Icons.Material.Filled.ListAlt, "/pay/admin/pay-item-types"),
            new Card("กองทุนสำรองเลี้ยงชีพ", "อัตราสะสม/สมทบ vesting", Icons.Material.Filled.Savings, "/pay/admin/provident-fund-policy"),
            new Card("บัญชี GL ฝั่งนายจ้าง", "บัญชีของประกันสังคม/กองทุน/ประกันส่วนนายจ้าง และเงินเดือนค้างจ่าย", Icons.Material.Filled.AccountBalance, "/pay/admin/gl-account-mapping"),
        }),
        // ส่วนระบบเห็นเฉพาะ system admin (CEO 12 ก.ย. 2569: HR ดูแลค่าเงินเดือน, admin ดูแลสิทธิ์/เมนู)
        new("ระบบ", SystemOnly: true, Cards: new[]
        {
            new Card("สิทธิ์การใช้งานรายหน้า", "ใครสร้าง/แก้/ลบได้ในแต่ละหน้า", Icons.Material.Filled.Rule, "/admin/system/program-rights"),
            new Card("จัดการเมนู", "โครงสร้างเมนูและการมองเห็น", Icons.Material.Filled.AccountTree, "/admin/system/menus"),
        }),
    };

    private ProgramRoleService.ProgramRights? _rights;
    private bool _isSystemAdmin;
    private long _actorUserId;
    private List<Sys_ProtectedSetting> _rows = new();
    private Sys_ProtectedSetting? _editing;
    private Sys_ProtectedSetting _new = new() { Area = "Payroll" };
    private readonly TableGroupDefinition<Sys_ProtectedSetting> _groupBy = new() { GroupName = "ระบบ", Indentation = false, Expandable = false, Selector = r => r.Area };

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _actorUserId = long.TryParse(state.User.FindFirst("sc_userid")?.Value, out var uid) ? uid : 0;
        _rights = await ProgramRoles.GetRightsAsync(state.User, ProgramPath);
        _isSystemAdmin = state.User.HasClaim("menu", "SYS_ADMIN");
        await LoadAsync();
    }

    private async Task<string?> RequireRightAsync(ProgramRoleService.ProgramAction action)
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        try { await ProgramRoles.RequireAsync(state.User, ProgramPath, action); return null; }
        catch (InvalidOperationException ex) { return ex.Message; }
    }

    private static string EditorLabel(ProtectedSettingEditor e) => e switch
    {
        ProtectedSettingEditor.Customer => "ลูกค้าแก้เองได้",
        ProtectedSettingEditor.VendorOnly => "เจ้าของซอฟต์แวร์เท่านั้น",
        _ => "ยังไม่ตัดสิน",
    };
    private static Color EditorColor(ProtectedSettingEditor e) => e switch
    {
        ProtectedSettingEditor.Customer => Color.Success,
        ProtectedSettingEditor.VendorOnly => Color.Warning,
        _ => Color.Default,
    };

    private async Task LoadAsync()
    {
        await using var ctx = await DbFactory.CreateDbContextAsync();
        _rows = await ctx.Sys_ProtectedSettings.OrderBy(r => r.Area).ThenBy(r => r.SortOrder).ThenBy(r => r.SettingKey).ToListAsync();
    }

    private void BeginEdit(Sys_ProtectedSetting r) => _editing = new Sys_ProtectedSetting
    {
        Id = r.Id, SettingKey = r.SettingKey, Area = r.Area, TableName = r.TableName, FieldName = r.FieldName,
        DisplayName = r.DisplayName, Reason = r.Reason, PageRoute = r.PageRoute, EditableBy = r.EditableBy,
        SortOrder = r.SortOrder, IsActive = r.IsActive,
    };

    private async Task SaveEditAsync()
    {
        if (_editing is null) return;
        if (await RequireRightAsync(ProgramRoleService.ProgramAction.Edit) is string denied) { Snackbar.Add(denied, Severity.Error); return; }
        await using var ctx = await DbFactory.CreateDbContextAsync();
        var row = await ctx.Sys_ProtectedSettings.FirstOrDefaultAsync(r => r.Id == _editing.Id);
        if (row is null) return;
        row.DisplayName = _editing.DisplayName.Trim();
        row.Reason = string.IsNullOrWhiteSpace(_editing.Reason) ? null : _editing.Reason.Trim();
        row.PageRoute = string.IsNullOrWhiteSpace(_editing.PageRoute) ? null : _editing.PageRoute.Trim();
        row.EditableBy = _editing.EditableBy;
        row.IsActive = _editing.IsActive;
        row.ModifiedByUserId = _actorUserId;
        row.ModifiedDate = DateTime.Now;
        await ctx.SaveChangesAsync();
        _editing = null;
        Snackbar.Add("บันทึกแล้ว", Severity.Success);
        await LoadAsync();
    }

    private async Task AddAsync()
    {
        if (await RequireRightAsync(ProgramRoleService.ProgramAction.Create) is string denied) { Snackbar.Add(denied, Severity.Error); return; }
        if (string.IsNullOrWhiteSpace(_new.SettingKey) || string.IsNullOrWhiteSpace(_new.TableName) || string.IsNullOrWhiteSpace(_new.FieldName) || string.IsNullOrWhiteSpace(_new.DisplayName))
        { Snackbar.Add("ต้องระบุรหัส ตาราง ฟิลด์ และชื่อที่แสดง", Severity.Warning); return; }
        await using var ctx = await DbFactory.CreateDbContextAsync();
        var key = _new.SettingKey.Trim().ToUpperInvariant();
        if (await ctx.Sys_ProtectedSettings.AnyAsync(r => r.SettingKey == key)) { Snackbar.Add($"รหัส {key} มีอยู่แล้ว", Severity.Warning); return; }
        ctx.Sys_ProtectedSettings.Add(new Sys_ProtectedSetting
        {
            SettingKey = key, Area = (_new.Area ?? "Payroll").Trim(), TableName = _new.TableName.Trim(), FieldName = _new.FieldName.Trim(),
            DisplayName = _new.DisplayName.Trim(), Reason = _new.Reason?.Trim(), PageRoute = _new.PageRoute?.Trim(),
            EditableBy = ProtectedSettingEditor.Undecided, SortOrder = 999, IsActive = true,
            ModifiedByUserId = _actorUserId, ModifiedDate = DateTime.Now,
        });
        await ctx.SaveChangesAsync();
        Snackbar.Add($"เพิ่ม {key} แล้ว", Severity.Success);
        _new = new() { Area = "Payroll" };
        await LoadAsync();
    }
}
