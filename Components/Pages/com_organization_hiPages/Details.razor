@code {
    private com_organization_hi? com_organization_hi;

    [SupplyParameterFromQuery]
    private long idn { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        com_organization_hi = await context.com_organization_his.FirstOrDefaultAsync(m => m.idn == idn);

        if (com_organization_hi is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
