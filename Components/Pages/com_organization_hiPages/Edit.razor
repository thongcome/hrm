@code {
    [SupplyParameterFromQuery]
    private long idn { get; set; }

    [SupplyParameterFromForm]
    private com_organization_hi? com_organization_hi { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        com_organization_hi ??= await context.com_organization_his.FirstOrDefaultAsync(m => m.idn == idn);

        if (com_organization_hi is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task Updatecom_organization_hi()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(com_organization_hi!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!com_organization_hiExists(com_organization_hi!.idn))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/com_organization_his");
    }

    private bool com_organization_hiExists(long idn)
    {
        using var context = DbFactory.CreateDbContext();
        return context.com_organization_his.Any(e => e.idn == idn);
    }
}
