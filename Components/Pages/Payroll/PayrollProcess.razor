    private async Task Save()
    {
        using var transaction = await context.Database.BeginTransactionAsync(); // เริ่ม Transaction

        try
        {

            int maxSeq = 0;

            try
            {
                maxSeq = context.Hrpayrolldet.Max(x => x.SeqNo);
            }
            catch (Exception e)
            {
                maxSeq = 0;
                message = e.Message;
            }

            // try
            // {
            //     using var context = DbFactory.CreateDbContext();
            //     // maxSeq = context.Hrpayrolldet.Select(x => x.SeqNo).FirstOrDefaultAsync().Max();
            //     if (context.Hrpayrolldet.Any())
            //     {
            //         maxSeq = context.Hrpayrolldet.Max(x => x.SeqNo);
            //     }
            //     else
            //     {
            //         maxSeq = 0;
            //     }

            //     // maxSeq = context.Hrpayrolldet.Max(x => x.SeqNo);
            // }
            // catch (Exception e)
            // {
            //     maxSeq = 0;
            //     message = e.Message.ToString();
            // }
            context.Hrpayroll.AddRange(hrpayrollsList);
            await context.SaveChangesAsync(); // บันทึกเฉพาะ Payroll



            foreach (var item in hrpayrollsDetList)
            {
                maxSeq++;
                item.SeqNo = maxSeq;
            }

            context.Hrpayrolldet.AddRange(hrpayrollsDetList);
            await context.SaveChangesAsync(); // บันทึกข้อมูล รายละเอียดการจ่าย Payroll

            await transaction.CommitAsync(); // ยืนยันการบันทึกทั้งหมด
            message = "ข้อมูล Payroll และ รายละเอียดการจ่าย Payroll บันทึกข้อมูลเรียบร้อย";
        }
        catch (Exception e)
        {
            await transaction.RollbackAsync(); // ยกเลิกการทำงานถ้ามีข้อผิดพลาด
            message = "บันทึกไม่สำเร็จ: " + e.Message;
        }
    }


