    private async Task GetEmployee()
    {
        hrEmployeeList = new();

        if (string.IsNullOrWhiteSpace(_companyId) || _selectedPeriodId is null) return;

        var selectedPeriod = _periods.FirstOrDefault(p => p.Id == _selectedPeriodId);
        if (selectedPeriod is null) return;

        // Keep formModel.Year/Month/TermOfPay populated from the selected
        // period — Step 2/3 below (CalculatePayroll/CalculateTax) still read
        // these fields directly and are intentionally left untouched.
        formModel.Year = selectedPeriod.Year.ToString(System.Globalization.CultureInfo.InvariantCulture);
        formModel.Month = selectedPeriod.Month.ToString("D2", System.Globalization.CultureInfo.InvariantCulture);
        formModel.TermOfPay = selectedPeriod.TermNo;

        var periodStartDt = selectedPeriod.PeriodStart.ToDateTime(TimeOnly.MinValue);
        var periodEndDt = selectedPeriod.PeriodEnd.ToDateTime(TimeOnly.MaxValue);

        await using var context = DbFactory.CreateDbContext();
        hrEmployeeList = await context.Hremployee
            .Where(e => e.companyid == _companyId
                && e.WorkDate != null && e.WorkDate <= periodEndDt
                && (e.ResignDate == null || e.ResignDate >= periodStartDt))
            .ToListAsync();
    }


