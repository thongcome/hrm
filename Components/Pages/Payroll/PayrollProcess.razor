    private async Task<decimal> CalculateTax(string year, int month, int totalmonth, Hremployee employee, decimal? totalDeduct)
    {
        decimal taxAccumThisEmp = 0.00m;
        string empNo = "";
        if (employee is null)
        {
            throw new ArgumentNullException(nameof(employee));
        }
        if (employee != null)
        {
            empNo = employee.EmpNo;
        }
        await using var context = DbFactory.CreateDbContext();
        HRPayAccum? hrPayAccumsTax = new HRPayAccum();
        // var Iemployee = context.Hremployee.Where(e => e.EmpNo == empNo).FirstOrDefaultAsync();
        // hrPayAccumsTax = await context.HRPayAccums.Where(e => e.EmpNo == empNo & e.YEAR == year).FirstOrDefaultAsync();
        try
        {
            hrPayAccumsTax = await context.HRPayAccums.Where(e => e.EmpNo == empNo).FirstOrDefaultAsync();


            if (hrPayAccumsTax == null)
            {
                if (employee != null)
                {

                    HRPayAccum hRPayAccum = new HRPayAccum();
                    hRPayAccum.StartMonth = month;
                    hRPayAccum.companyid = employee.companyid;
                    DateTime lastMonthOfYear = new DateTime(DateTime.Now.Year, 12, 1);
                    hRPayAccum.EndMonth = totalmonth;
                    hRPayAccum.WORKMONTH = (totalmonth - month) + 1;
                    hRPayAccum.EmpNo = employee.EmpNo;
                    hRPayAccum.YEAR = year;
                    hRPayAccum.IncomeForwardAmt = 0.00m;
                    hRPayAccum.IncomeYearAmt = 0.00m;
                    hRPayAccum.TaxYearAmt = 0.00m;
                    hRPayAccum.IncomePredictAmt = hRPayAccum.WORKMONTH * employee.SalaryAmt;
                    hRPayAccum.LastPeriodCode = this.period;
                    hRPayAccum.MODIFIED_BY = "system";
                    hRPayAccum.MODIFIED_DATE = DateTime.Now;

                    context.HRPayAccums.Add(hRPayAccum);
                    await context.SaveChangesAsync();
                    hrPayAccumsTax = hRPayAccum;
                    //   var thisid = hRPayAccum.id;

                }

            }

            var currentMaxSaraly = hrPayAccumsTax?.IncomeForwardAmt + (((totalmonth - month) + 1) * employee?.SalaryAmt);

            currentMaxSaraly -= totalDeduct ?? 0m;
            //  var taxRate = await context.HRUcfTaxRates.Where(e => currentMaxSaraly > e.minRate && currentMaxSaraly < e.maxRate).FirstOrDefaultAsync();
            List<HRUcfTaxRate> taxRateAllofEmp = await context.HRUcfTaxRates.Where(e => currentMaxSaraly > e.minRate && currentMaxSaraly < e.maxRate).OrderByDescending(e => e.step).ToListAsync();
            bool topRate = true;


            List<HREmpTaxRateDet> hREmpTaxRateDetList = new List<HREmpTaxRateDet>();
            foreach (var item in taxRateAllofEmp)
            {
                HREmpTaxRateDet taxDet = new HREmpTaxRateDet();

                decimal taxTopLevel = 0.00m; // Ensure initialization
                decimal onTopRate = 0.00m;


                if (topRate == true && item != null)
                {
                    onTopRate = (currentMaxSaraly - item.minRate) ?? 0; // Ensure minRate is not null
                    taxTopLevel = onTopRate * ((item?.PercentRate ?? 0) / 100); // Ensure  PercentRate is not null
                    taxAccumThisEmp += taxTopLevel;
                    topRate = false;
                }



                if (item != null)
                {
                    if (employee != null)
                    {
                        taxDet.CoopId = employee.companyid;
                        taxDet.EmpNo = employee.EmpNo;
                        taxDet.Name = employee.EmpName;
                        taxDet.NameEn = employee.EmpEname;
                    }
                    if (topRate == false)
                    {
                        taxAccumThisEmp += taxTopLevel;
                    }
                    taxDet.minRate = item.minRate;
                    taxDet.maxRate = item.maxRate;
                    taxDet.PercentRate = item.PercentRate;
                    taxDet.taxLevelRate = item.taxLevelRate;
                    taxDet.taxAccumLevelRate = onTopRate;
                    taxDet.BaseLevelTax = taxTopLevel;
                    taxDet.Peroid = period;
                    taxDet.code = item.code;
                    taxDet.isActive = item.isActive;


                    taxDet.year = year;
                    taxDet.step = item.step;
                    taxDet.MODIFIED_BY = "system";
                    taxDet.MODIFIED_DATE = DateTime.Now;


                }
            }
        }
        catch (Exception e)
        {
            e.Message.ToString();
        }

        // if (totalDeduct != null)
        // {
        //     taxAccumThisEmp -=  (totalDeduct ?? 0m);

        // }


        taxAccumThisEmp = taxAccumThisEmp / totalmonth;
        // if(taxRate !=null){
        // var onTopRate = currentMaxSaraly - taxRate?.minRate;
        // var taxTopLevel = onTopRate * (taxRate?.PercentRate / 100);
        // // var taxRateAll = await context.HRUcfTaxRates.Where(e => currentMaxSaraly < e.maxRate).ToListAsync();

        // var taxRateList = await context.HRUcfTaxRates.Where(e => e.isActive == 1 & e.step <= taxRate.step).ToListAsync();
        return taxAccumThisEmp;
    }

