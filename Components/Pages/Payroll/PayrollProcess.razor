        }

        // If no search term, include
        if (string.IsNullOrWhiteSpace(searchTerm)) return true;

        var q = searchTerm.Trim().ToLowerInvariant();
        if (!string.IsNullOrWhiteSpace(emp.EmpNo) && emp.EmpNo.ToLowerInvariant().Contains(q)) return true;
        if (!string.IsNullOrWhiteSpace(emp.EmpName) && emp.EmpName.ToLowerInvariant().Contains(q)) return true;
        if (!string.IsNullOrWhiteSpace(emp.EmpSurname) && emp.EmpSurname.ToLowerInvariant().Contains(q)) return true;

        return false;
    }

