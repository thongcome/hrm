    private async Task<(List<Hrextenuatetax> empDeduct, decimal totalDeduct)> GetEmployeeDeduct(string empno)
    {
        await using var context = DbFactory.CreateDbContext();

        List<Hrextenuatetax> empDeduct = await context.Hrextenuatetaxs.Where(e => e.EmpNo == empno).ToListAsync();
        decimal totalDeduct = 0.00m;

        if (empDeduct != null)
        {
            foreach (var item in empDeduct)
            {
                try
                {
                    totalDeduct += item.PayTravel ?? 0m;
                    totalDeduct += item.PayChild ?? 0m;
                    totalDeduct += item.PayParent ?? 0m;
                    totalDeduct += item.PayIntaddr ?? 0m;
                    totalDeduct += item.PayInsoth ?? 0m;
                    totalDeduct += item.PayInsretry ?? 0m;
                    totalDeduct += item.PayDisabled ?? 0m;
                    totalDeduct += item.PayInsparent ?? 0m;
                    totalDeduct += item.PayMate ?? 0m;
                    totalDeduct += item.PayLtf ?? 0m;
                    totalDeduct += item.PayRmf ?? 0m;
                    totalDeduct += item.PayDonateoth ?? 0m;
