@page "/AIpayrollprocess"
@using HRM.Data
@using HRM.Models
@using HRM.Services.Payroll
@using Microsoft.EntityFrameworkCore
@using HRM.BusinessModel;
@inject IDbContextFactory<HRM.Models.HRMContext> DbFactory
@inject HRM.Services.Payroll.PayrollCalculationService PayrollService
@inject HRM.Services.Payroll.PayrollAnalysisService AiAnalysisService

@using MudBlazor
@using System.ComponentModel.DataAnnotations


@*   <Dashboard />     *@ 
<MudPaper Class="pa-4" Elevation="4">
    <MudText Color="Color.Error">@message</MudText>
    <MudStepper @bind-ActiveStep="_currentStep" Linear="false">

        <!-- STEP 1: กำหนดงวดการจ่าย -->
        <MudStep Label="กำหนดงวดการจ่าย">
            <EditForm Model="@formModel" OnValidSubmit="GetEmployee">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="row mb-3">
                    <div class="col-sm-6">
                        <label class="form-label">งวดที่</label>
                        <InputNumber class="form-control" @bind-Value="formModel.TermOfPay" />
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label">ประเภทพนักงาน</label>
                        <InputSelect class="form-select" @bind-Value="formModel.EmployeeType">
                            <option value="">-- เลือกประเภท --</option>
                            <option value="01">พนักงานประจำ</option>
                            <option value="02">พนักงานชั่วคราว</option>
                        </InputSelect>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-6">
                        <label class="form-label">ปี</label>
                        <InputText class="form-control" @bind-Value="formModel.Year" />
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label">เดือน</label>
                        <InputSelect class="form-select" @bind-Value="formModel.Month">
                            <option value="">-- เลือกเดือน --</option>
                            <option value="01">มกราคม</option>
                            <option value="02">กุมภาพันธ์</option>
                            <option value="03">มีนาคม</option>
                            <option value="04">เมษายน</option>
                            <option value="05">พฤษภาคม</option>
                            <option value="06">มิถุนายน</option>
                            <option value="07">กรกฎาคม</option>
                            <option value="08">สิงหาคม</option>
                            <option value="09">กันยายน</option>
                            <option value="10">ตุลาคม</option>
                            <option value="11">พฤศจิกายน</option>
                            <option value="12">ธันวาคม</option>
                        </InputSelect>
                    </div>
                </div>

                <div class="mb-3">
                    <button type="submit" class="btn btn-primary" Click="GetEmployee">ตรวจสอบรายชื่อพนักงาน</button>

                </div>
            </EditForm>

            <MudTable Items="@hrEmployeeList" Dense="true" Hover="true" Elevation="0">
                <HeaderContent>
                    <MudTh>รหัสพนักงาน</MudTh>
                    <MudTh>ชื่อ</MudTh>
                    <MudTh>เงินเดือน</MudTh>
                    <MudTh>สถานะ</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.EmpNo</MudTd>
                    <MudTd>@context.EmpName</MudTd>
                    <MudTd>@context.SalaryAmt?.ToString("N2")</MudTd>
                    <MudTd>@context.EmpStatus</MudTd>
                </RowTemplate>
            </MudTable>
        </MudStep>

        <!-- STEP 2: ประมวลผล -->
        <MudStep Label="ประมวลผลเงินเดือน">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CalculatePayroll">ประมวลผล</MudButton>
@*                 <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CalculatePayrollAI" Class="mr-2">ประมวลผล</MudButton>
 *@
    @if (hrpayrollsList.Any())
    {
        <MudButton Variant="Variant.Filled" Color="Color.Warning" OnClick="RunAiAnalysis">ตรวจสอบด้วย AI</MudButton>
    }

            <MudText Class="mt-4">พนักงานจำนวน @hrpayrollsList.Count คน</MudText>

            <MudTable Items="@hrpayrollsList" Dense="true" Hover="true" Elevation="0">
                <HeaderContent>
                    <MudTh>รหัสพนักงาน</MudTh>
                    <MudTh>เงินเดือน</MudTh>
                    <MudTh>รวมได้อื่น</MudTh>
                    <MudTh>รวมหัก</MudTh>
                    <MudTh>สุทธิ</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.EmpNo</MudTd>
                    <MudTd>@context.SalarybaseAmt?.ToString("N2")</MudTd>
                    <MudTd>@context.SalaryothAmt?.ToString("N2")</MudTd>
                    <MudTd>@context.SalarysubtAmt?.ToString("N2")</MudTd>
                    <MudTd>@context.SalarynetAmt?.ToString("N2")</MudTd>
                </RowTemplate>
            </MudTable>

            <MudText Class="mt-4">รายละเอียดหัก/ได้: @hrpayrollsDetList.Count รายการ</MudText>

            <MudExpansionPanels>
                <MudExpansionPanel Text="รายละเอียดทั้งหมด">
                    <MudTable Items="@hrpayrollsDetList" Dense="true" Hover="true">
                        <HeaderContent>
                            <MudTh>Slip No</MudTh>
                            <MudTh>รหัสพนักงาน</MudTh>
                            <MudTh>จำนวนเงิน</MudTh>
                            <MudTh>รายการ</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.PayrollslipNo</MudTd>
                            <MudTd>@context.EmpNo</MudTd>
                            <MudTd>@context.ItemAmt?.ToString("N2")</MudTd>
                            <MudTd>@context.Description</MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudExpansionPanel>
            </MudExpansionPanels>
        </MudStep>

        <!-- STEP 3: สรุปและบันทึก -->
        <MudStep Label="สรุปผลและบันทึก">
            <MudGrid Class="mb-2">
                <MudItem xs="12" sm="6">
                    <MudText>งวด: @period</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText>จำนวนพนักงาน: @hrpayrollsList.Count คน</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText>จำนวนเงินรวม: @hrpayrollsList.Sum(x => x.SalarynetAmt ?? 0).ToString("N2")</MudText>
                </MudItem>
            </MudGrid>
            <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="Save">บันทึก</MudButton>
        </MudStep>
    </MudStepper>
</MudPaper>

@if (_aiHasBeenRun)
{
    <MudText Typo="Typo.h6" Class="mt-4">ผลการตรวจสอบโดย AI</MudText>
    @if (_anomalyResults.Any())
    {
        <MudTable Items="@_anomalyResults" Dense="true" Hover="true" Elevation="2">
            <HeaderContent>
                <MudTh>รหัสพนักงาน</MudTh>
                <MudTh>รายการที่ผิดปกติ</MudTh>
                <MudTh>ค่าที่ตรวจพบ</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="รหัสพนักงาน">@context.EmpNo</MudTd>
                <MudTd DataLabel="รายการที่ผิดปกติ">@context.FeatureName</MudTd>
                <MudTd DataLabel="ค่าที่ตรวจพบ">@context.Value.ToString("N2")</MudTd>
            </RowTemplate>
        </MudTable>
    }
    else
    {
        <MudAlert Severity="Severity.Success" Class="mt-2">ไม่พบรายการที่ผิดปกติ</MudAlert>
    }
}

@code {
    private HRMContext context = default!;
    private FormModel formModel = new FormModel();
    private MudForm _form = new();

    private HashSet<string> _anomalyEmployeeNos = new();
    private bool _aiHasBeenRun = false;
    // จากเดิม: private HashSet<string> _anomalyEmployeeNos = new();
    // เปลี่ยนเป็น:
    private List<AnomalyResult> _anomalyResults = new();

    private List<Hremployee> hrEmployeeList = new();
    private List<Hrpayroll> hrpayrollsList = new();
    private List<Hrpayrolldet> hrpayrollsDetList = new();
    private List<Hrpayrolldet> hrpayrollsDetListOneEmp = new();

    private List<Hrbasepayrollfixed> fixIncomeList = new();
    private string period = "";
    private String empSelect = "";

    private int _currentStep = 0; // ค่าเริ่มต้นควรเป็น 0 (Step แรก)
    private string message = "กรุณากรอกข้อมูลให้ครบถ้วนก่อนดำเนินการต่อ";

    private Hremployee hremployee = new();


    List<HRBaseSalaryFixWithSignModel> hrBaseSalaryFixWithSignModelList = new();

    private int totalMonthCal = 12; // ค่าดีฟอลต์คือ 12 เดือน เพื่อหาร ภาษี 1 ปี

    // private int currentStep = 0; // ค่าดีฟอลต์คือ Step 1

    private void GoToNextStep()
    {
        if (_currentStep < 3) // ตรวจสอบไม่ให้เกิน Step ที่มีอยู่
        {
            _currentStep++;
        }
    }

private void RunAiAnalysis()
{
    if (hrpayrollsList.Any())
    {
        _anomalyResults = AiAnalysisService.DetectAnomalies(hrpayrollsList);
        _aiHasBeenRun = true;
        message = $"AI ตรวจพบรายการที่อาจผิดปกติจำนวน {_anomalyResults.Count} รายการ";
    }
}
    private async Task Calculate()
    {
        // Logic for calculation goes here
        int i = 0;
        period = formModel.Year + formModel.Month;
        ClearCal();
        foreach (var item in hrEmployeeList)
        {
            // 1.check employee and salary  ->  (EmpStatus == 1) resign date
            // 2. check fix income /deduct
            // 2.1 เงินกู้อยู่ในนี้
            // 3. check not fix income/deduct
            // 4. check ค่าล่วงเวลา
            // 5. check ประกันสังคม
            // 6. check กองทุน ต่างๆ
            // 7. check ลดหย่อนภาษี
            // 8. คำนวณ รายได้  คงเหลือ
            // 9. คำนวณ ภาษี จ่าย
            // 10. คงเหลือสุทธิ
            // 11.บันทึก หรือ คำนวณใหม่ -> บันอทึก งวด payroll
            // 12. แก้ไข หรือ ลบ รายการ แล้วทำใหม่

            i++;
            // เพิ่ม Hrpayroll 1.startdatepayment , 2.enddatepayment
            // เพิ่ม Hrpayroll payment ratio  เช่น 20/31 กับ date/fulldate

            //         COOP_ID CHAR(6 BYTE)	No  null    รหัสสหกรณ์
            // PAYROLLSLIP_NO  VARCHAR2(12 BYTE)   No  null    เลขสลิปเงินเดือน
            // EMP_NO  CHAR(6 BYTE)    Yes null    รหัสพนักงาน
            // PAYROLL_DATE    DATE Yes null    วันที่ทำเงินเดือน
            // PAYROLL_PERIOD  VARCHAR2(8 BYTE)    No  null    งวดเงินเดือน
            // SALARYBASE_AMT  NUMBER(9, 2) Yes null    เงินเดือน
            // SALARYOTH_AMT   NUMBER(9, 2) Yes null    รวมรายได้อื่นๆ
            // SALARYSUBT_AMT  NUMBER(9, 2) Yes null    รวมรายจ่ายอื่นๆ
            // SALARYNET_AMT   NUMBER(9, 2) Yes null    เงินเดือนคงเหลือ
            // PAYROLL_STATUS  NUMBER(2, 0) Yes null    สถานะประมวลเงินดือน
            // EXPENSE_CODE    CHAR(3 BYTE)    Yes null    วิธีจ่ายเงินเดือน
            // EXPENSE_BANK    CHAR(3 BYTE)    Yes null    ธนาคาร
            // EXPENSE_BRANCH  CHAR(4 BYTE)    Yes null    สาขาธนาคาร
            // EXPENSE_ACCID   VARCHAR2(15 BYTE)   Yes null    เลขบัญชี
            // POST_STATUS NUMBER(1, 0) Yes 0   สถานะผ่านรายการ 1 = ผ่านรายการ , 0 = ยังไม่ผ่านรายการ
            // MEMBER_NO CHAR(8 BYTE)	Yes null    เลขสมาชิก
            // PERCENMG_SECURITY   NUMBER(3, 2) Yes 0   เรทประกันสังคมนายจ้างสมทบ
            // PERCEN_SECURITY NUMBER(3, 2) Yes 0   เรทประกัันสังคม
            // SOFMG_SECURITY  NUMBER(10, 2)    Yes 0   ค่าประกันสังคมนายจ้างสมทบ
            // POST_SOF_STATUS NUMBER(1, 0) Yes 0   สถานะ post เงินประกันสังคม 1 = ผ่านรายการ , 0 = ยังไม่ผ่านรายการ

            Hrpayroll hrpayroll = new Hrpayroll();// set init value
            hrpayroll.SalarysubtAmt = 0.00m;
            hrpayroll.SalaryothAmt = 0.00m;
            hrpayroll.companyid = item.companyid;
            hrpayroll.EmpNo = item.EmpNo;
            hrpayroll.PayrollPeriod = period;
            hrpayroll.PostStatus = 0;//ยังไม่ผ่านรายการ
            hrpayroll.PayrollStatus = 0;// check status
            hrpayroll.ExpenseCode = item.SalexpCode;
            hrpayroll.ExpenseBank = item.SalexpBank;
            hrpayroll.ExpenseBranch = item.SalexpBranch;
            hrpayroll.ExpenseAccid = item.SalexpAccid;
            var dateget = DateTime.Now.ToString("HHmmss");
            hrpayroll.PayrollslipNo = period + dateget;// not finished
            hrpayroll.SalarybaseAmt = item.SalaryAmt; // not finished

            hrpayroll.MemberNo = item.RefMembno;

            try
            {
                hrpayroll.SalarynetAmt = item.SalaryAmt;// not finished
            }
            catch (Exception e)
            {
                e.Message.ToString();
            }


            // Do not  know 100% yet
            hrpayroll.PercenmgSecurity = 3;
            hrpayroll.PercenSecurity = 3;
            hrpayroll.SofmgSecurity = 3;
            hrpayroll.PostSofStatus = false;
            hrpayroll.PostStaStatus = false;
            string dateString = period + "";
            if (DateTime.TryParseExact(dateString, "yyyyMMdd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out DateTime date))
            {
                hrpayroll.PayrollDate = date;
                System.Console.WriteLine(date);
            }
            else
            {
                System.Console.WriteLine("Invalid date format.");
            }


            await GetFixIncome();
            // Payroll detail
            foreach (var incomeItem in hrBaseSalaryFixWithSignModelList.Where(x => x.EmpNo == item.EmpNo))
            {
                Hrpayrolldet paydet = new Hrpayrolldet();
                paydet.companyid = hrpayroll.companyid;
                paydet.PayrollslipNo = hrpayroll.PayrollslipNo;
                paydet.EmpNo = hrpayroll.EmpNo;
                paydet.PayrollPeriod = hrpayroll.PayrollPeriod;
                paydet.SeqNo = i;
                paydet.SalitemCode = incomeItem.SalitemCode;
                paydet.Description = incomeItem.description;

                try
                {
                    paydet.ItemAmt = incomeItem.ItemAmt;
                }
                catch (Exception e)
                {
                    paydet.ItemAmt = 0.00m;
                    e.Message.ToString();
                }

                try
                {
                    if (incomeItem.SignFlag == -1)
                    {
                        try
                        {
                            hrpayroll.SalarynetAmt -= incomeItem.ItemAmt;

                        }
                        catch (Exception e)
                        {
                            e.Message.ToString();
                        }
                        try
                        {
                            hrpayroll.SalarysubtAmt += incomeItem.ItemAmt;

                        }
                        catch (Exception e)
                        {
                            e.Message.ToString();
                        }
                    }
                    else if (incomeItem.SignFlag == 1)
                    {
                        try
                        {
                            hrpayroll.SalarynetAmt += incomeItem.ItemAmt;

                        }
                        catch (Exception e)
                        {
                            e.Message.ToString();
                        }

                        try
                        {
                            hrpayroll.SalaryothAmt += incomeItem.ItemAmt;
                        }
                        catch (Exception e)
                        {
                            e.Message.ToString();
                        }
                    }
                }
                catch (Exception e)
                {
                    e.Message.ToString();
                }

                hrpayrollsDetList.Add(paydet);
            }

            hrpayrollsList.Add(hrpayroll);
            // await hrPayRollsGrid.Reload();

        }
        StateHasChanged();



    }

