@page "/perf/pip"
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Perf
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject PerfImprovementPlanService PipService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@attribute [Authorize(Policy = "Menu:PERF_ADMIN")]

<PageTitle>Performance Improvement Plan (PIP)</PageTitle>

<MudPaper Class="pa-4 mb-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudText Typo="Typo.h5">Performance Improvement Plan (PIP)</MudText>
        <MudChip T="string" Color="Color.Warning" Size="Size.Small">PDPA</MudChip>
    </MudStack>
    <MudText Typo="Typo.body2" Class="mt-1">
        แผนปรับปรุงผลการปฏิบัติงานสำหรับพนักงานที่ผลประเมินต่ำกว่าเกณฑ์ หรือมีปัญหาผลงานที่ต้องติดตามอย่างเป็นทางการ —
        ทุกฉบับต้องผ่านการอนุมัติก่อนมีผลจริง
    </MudText>
</MudPaper>

<MudPaper Class="pa-4 mb-4">
    @if (!_showForm)
    {
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateForm">เริ่ม PIP ใหม่</MudButton>
    }
    else
    {
        <MudText Typo="Typo.h6" Class="mb-2">เริ่ม PIP ใหม่</MudText>
        <MudGrid>
            <MudItem xs="12" sm="4">
                <MudAutocomplete T="Hremployee" Label="พนักงาน" @bind-Value="_selectedEmployee"
                    SearchFunc="SearchEmployeesAsync" ToStringFunc="@(e => e == null ? null : $"{e.EmpNo} — {e.EmpName} {e.EmpSurname}")"
                    ResetValueOnEmptyText="true" CoerceText="true" MinCharacters="0" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudAutocomplete T="sc_user" Label="หัวหน้าผู้ติดตาม PIP (ไม่บังคับ)" @bind-Value="_selectedManager"
                    SearchFunc="SearchUsersAsync" ToStringFunc="@(u => u == null ? null : $"{u.firstname} {u.lastname}")"
                    ResetValueOnEmptyText="true" CoerceText="true" MinCharacters="0" />
            </MudItem>
            <MudItem xs="12" sm="2"><MudDatePicker Label="วันที่เริ่ม" @bind-Date="_startDate" Editable="true" DateFormat="dd/MM/yyyy" /></MudItem>
            <MudItem xs="12" sm="2"><MudDatePicker Label="วันที่สิ้นสุด" @bind-Date="_endDate" Editable="true" DateFormat="dd/MM/yyyy" /></MudItem>
            <MudItem xs="12"><MudTextField @bind-Value="_reason" Label="เหตุผล/ปัญหาผลงานที่ต้องปรับปรุง" Lines="2" /></MudItem>
            <MudItem xs="12">
                <MudStack Row="true" Spacing="2">
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="CreateAsync">สร้างฉบับร่าง</MudButton>
                    <MudButton Variant="Variant.Text" OnClick="CloseCreateForm">ยกเลิก</MudButton>
                </MudStack>
            </MudItem>
        </MudGrid>
        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-2">@_error</MudAlert>
        }
    }
</MudPaper>

<MudPaper Class="pa-4 mb-4">
    <MudText Typo="Typo.h6" Class="mb-2">รายการ PIP ทั้งหมด</MudText>
    <MudTable Items="_plans" Dense="true" Hover="true">
        <HeaderContent>
            <MudTh>พนักงาน</MudTh>
            <MudTh>ช่วงเวลา</MudTh>
            <MudTh>สถานะ</MudTh>
            <MudTh>เหตุผล</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@GetEmployeeLabel(context.HremployeeId)</MudTd>
            <MudTd>@context.StartDate.ToString("dd/MM/yyyy") - @context.EndDate.ToString("dd/MM/yyyy")</MudTd>
            <MudTd><MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Status)">@StatusLabel(context.Status)</MudChip></MudTd>
            <MudTd>@context.Reason</MudTd>
            <MudTd><MudButton Size="Size.Small" Variant="Variant.Text" Href="@($"/perf/pip/{context.Id}")">ดูรายละเอียด</MudButton></MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText Typo="Typo.body2">ยังไม่มี PIP ในระบบ</MudText></NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    [SupplyParameterFromQuery(Name = "employeeId")]
    public long? EmployeeId { get; set; }

    [SupplyParameterFromQuery(Name = "sourceInstanceId")]
    public long? SourceInstanceId { get; set; }

    private string? _companyId;
    private List<Perf_ImprovementPlan> _plans = new();
    private Dictionary<long, Hremployee> _employees = new();

    private bool _showForm;

    private Hremployee? _selectedEmployee;
    private sc_user? _selectedManager;
    private DateTime? _startDate = DateTime.Today;
    private DateTime? _endDate = DateTime.Today.AddDays(60);
    private string? _reason;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");

        if (EmployeeId is long empId)
        {
            await using var context = await DbFactory.CreateDbContextAsync();
            _selectedEmployee = await context.Hremployee.FirstOrDefaultAsync(e => e.id == empId);
            _showForm = true;
        }

        await LoadAsync();
    }

    private void OpenCreateForm()
    {
        _selectedEmployee = null;
        _selectedManager = null;
        _startDate = DateTime.Today;
        _endDate = DateTime.Today.AddDays(60);
        _reason = null;
        _error = null;
        _showForm = true;
    }

    private void CloseCreateForm()
    {
        _showForm = false;
        _error = null;
    }

    private async Task LoadAsync()
    {
        if (string.IsNullOrEmpty(_companyId)) return;
        _plans = await PipService.GetAllPlansAsync(_companyId);

        await using var context = await DbFactory.CreateDbContextAsync();
        var employeeIds = _plans.Select(p => p.HremployeeId).Distinct().ToList();
        _employees = await context.Hremployee.Where(e => employeeIds.Contains(e.id)).ToDictionaryAsync(e => e.id);
    }

    private string GetEmployeeLabel(long hremployeeId)
        => _employees.TryGetValue(hremployeeId, out var e) ? $"{e.EmpNo} — {e.EmpName} {e.EmpSurname}" : $"#{hremployeeId}";

    private async Task<IEnumerable<Hremployee>> SearchEmployeesAsync(string search, CancellationToken ct)
    {
        await using var context = await DbFactory.CreateDbContextAsync(ct);
        var query = context.Hremployee.Where(e => e.companyid == _companyId && e.ResignDate == null);
        if (!string.IsNullOrWhiteSpace(search))
        {
            query = query.Where(e => e.EmpNo.Contains(search)
                || (e.EmpName != null && e.EmpName.Contains(search))
                || (e.EmpSurname != null && e.EmpSurname.Contains(search)));
        }
        return await query.OrderBy(e => e.EmpNo).Take(20).ToListAsync(ct);
    }

    private async Task<IEnumerable<sc_user>> SearchUsersAsync(string search, CancellationToken ct)
    {
        await using var context = await DbFactory.CreateDbContextAsync(ct);
        var query = context.sc_users.AsQueryable();
        if (!string.IsNullOrWhiteSpace(search))
        {
            query = query.Where(u => (u.firstname != null && u.firstname.Contains(search))
                || (u.lastname != null && u.lastname.Contains(search)));
        }
        return await query.OrderBy(u => u.firstname).Take(20).ToListAsync(ct);
    }

    private async Task CreateAsync()
    {
        _error = null;
        if (_selectedEmployee is null) { _error = "กรุณาเลือกพนักงาน"; return; }
        if (string.IsNullOrWhiteSpace(_reason)) { _error = "กรุณาระบุเหตุผล"; return; }
        if (_startDate is null || _endDate is null) { _error = "กรุณาระบุช่วงเวลา"; return; }

        var state = await AuthProvider.GetAuthenticationStateAsync();
        var userId = long.TryParse(state.User.FindFirstValue("sc_userid"), out var uid) ? uid : 0;

        try
        {
            var planId = await PipService.CreateDraftAsync(_selectedEmployee.id, _reason,
                DateOnly.FromDateTime(_startDate.Value), DateOnly.FromDateTime(_endDate.Value),
                _selectedManager?.userid, userId, SourceInstanceId);
            Nav.NavigateTo($"/perf/pip/{planId}");
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
    }

    private static string StatusLabel(PipStatus status) => status switch
    {
        PipStatus.Draft => "ฉบับร่าง",
        PipStatus.PendingApproval => "รออนุมัติ",
        PipStatus.Active => "กำลังดำเนินการ",
        PipStatus.Rejected => "ไม่อนุมัติ",
        PipStatus.Passed => "ผ่าน",
        PipStatus.Extended => "ขยายเวลา",
        PipStatus.Failed => "ไม่ผ่าน",
        PipStatus.Cancelled => "ยกเลิก",
        _ => status.ToString(),
    };

    private static Color StatusColor(PipStatus status) => status switch
    {
        PipStatus.Draft => Color.Default,
        PipStatus.PendingApproval => Color.Warning,
        PipStatus.Active => Color.Info,
        PipStatus.Rejected => Color.Error,
        PipStatus.Passed => Color.Success,
        PipStatus.Extended => Color.Warning,
        PipStatus.Failed => Color.Error,
        PipStatus.Cancelled => Color.Default,
        _ => Color.Default,
    };
}
