@page "/perf/topics/{EvaluationTypeId:long}"
@using HRM.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject HRM.Services.Perf.PerfKpiSetService KpiSetService
@inject ISnackbar Snackbar
@attribute [Authorize(Policy = "Menu:PERF_ADMIN")]

<PageTitle>Topic / SubTopic / ตัวชี้วัด — @(_evalType?.Name)</PageTitle>

@if (_evalType is null)
{
    <MudAlert Severity="Severity.Warning" Class="ma-4">ไม่พบแบบประเมินนี้</MudAlert>
}
else
{
    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h5">Topic / SubTopic / ตัวชี้วัด — @_evalType.Name</MudText>
        <MudText Typo="Typo.body2" Class="mt-1 mb-2">
            โครงสร้าง 2 ชั้น: Topic → SubTopic → ตัวชี้วัด — น้ำหนักรวมของ Topic ทุกตัวต้อง = 100%,
            น้ำหนักรวมของ SubTopic ในแต่ละ Topic ต้อง = 100%, น้ำหนักรวมของตัวชี้วัดในแต่ละ SubTopic ต้อง = 100%
        </MudText>

        <MudAlert Severity="@(_topicWeightTotal == 100 ? Severity.Success : Severity.Warning)" Dense="true" Class="mb-3">
            น้ำหนักรวมของ Topic ทั้งหมด: @_topicWeightTotal.ToString("0.#")% @(_topicWeightTotal == 100 ? "(ครบ)" : "— ยังไม่ครบ 100%")
        </MudAlert>

        @if (!_showTopicForm)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenTopicForm">เพิ่ม Topic</MudButton>
        }
        else
        {
            <MudGrid>
                <MudItem xs="6" sm="3"><MudTextField @bind-Value="_newTopicCode" Label="รหัส Topic" /></MudItem>
                <MudItem xs="6" sm="5"><MudTextField @bind-Value="_newTopicName" Label="ชื่อ Topic" /></MudItem>
                <MudItem xs="8" sm="2"><MudNumericField T="decimal" @bind-Value="_newTopicWeight" Label="น้ำหนัก (%)" Min="0" Max="100" /></MudItem>
                <MudItem xs="4" sm="2">
                    <MudStack Row="true" Spacing="2">
                        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="AddTopicAsync">เพิ่ม Topic</MudButton>
                        <MudButton Variant="Variant.Text" OnClick="CloseTopicForm">ยกเลิก</MudButton>
                    </MudStack>
                </MudItem>
            </MudGrid>

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mt-2">@_error</MudAlert>
            }
        }
    </MudPaper>

    @if (_topics.Count == 0)
    {
        <MudPaper Class="pa-4 mb-4" Outlined="true">
            <MudText Typo="Typo.subtitle1"><MudIcon Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" Class="mr-1" />คัดลอกชุดตัวชี้วัดจากแบบประเมินอื่น</MudText>
            <MudText Typo="Typo.caption" Class="mb-2">ไม่ต้องสร้างใหม่ทั้งหมด — เลือกแบบประเมินที่มีโครงสร้าง Topic/SubTopic/ตัวชี้วัดครบแล้ว ระบบจะคัดลอกทั้งชุดมาให้ (ใช้ได้เฉพาะตอนที่ยังไม่มีตัวชี้วัด)</MudText>
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudSelect T="long?" @bind-Value="_cloneSourceTypeId" Label="แบบประเมินต้นทาง" Variant="Variant.Outlined" Dense="true">
                        @foreach (var t in _otherTypes)
                        {
                            <MudSelectItem T="long?" Value="@((long?)t.Id)">@t.Code — @t.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" Class="d-flex align-center">
                    <MudButton Color="Color.Secondary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.ContentCopy"
                        OnClick="CloneTreeAsync" Disabled="_cloneSourceTypeId is null || _busy">คัดลอกชุดตัวชี้วัด</MudButton>
                </MudItem>
            </MudGrid>
            @if (_otherTypes.Count == 0)
            {
                <MudText Typo="Typo.caption" Class="mt-2">ยังไม่มีแบบประเมินอื่นที่มีตัวชี้วัดให้คัดลอก</MudText>
            }
        </MudPaper>
    }

    @foreach (var topic in _topics)
    {
        <MudExpansionPanels Class="mb-3">
            <MudExpansionPanel>
                <TitleContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudText Typo="Typo.h6">@topic.Code — @topic.Name</MudText>
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary">น้ำหนัก @topic.Weight.ToString("0.#")%</MudChip>
                        <MudChip T="string" Size="Size.Small" Color="@(SubTopicWeightTotal(topic.Id) == 100 ? Color.Success : Color.Warning)">
                            SubTopic รวม @SubTopicWeightTotal(topic.Id).ToString("0.#")%
                        </MudChip>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                            OnClick="@(() => RemoveTopicAsync(topic.Id))" />
                    </MudStack>
                </TitleContent>
                <ChildContent>
                    @if (_showSubTopicFormForTopicId != topic.Id)
                    {
                        <MudButton Color="Color.Primary" Variant="Variant.Text" Class="mb-2" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => OpenSubTopicForm(topic.Id))">เพิ่ม SubTopic</MudButton>
                    }
                    else
                    {
                        <MudGrid Class="mb-2">
                            <MudItem xs="6" sm="3"><MudTextField @bind-Value="_newSubTopicCode" Label="รหัส SubTopic" /></MudItem>
                            <MudItem xs="6" sm="5"><MudTextField @bind-Value="_newSubTopicName" Label="ชื่อ SubTopic" /></MudItem>
                            <MudItem xs="8" sm="2"><MudNumericField T="decimal" @bind-Value="_newSubTopicWeight" Label="น้ำหนัก (%)" Min="0" Max="100" /></MudItem>
                            <MudItem xs="4" sm="2">
                                <MudStack Row="true" Spacing="2">
                                    <MudButton Color="Color.Primary" Variant="Variant.Text" OnClick="@(() => AddSubTopicAsync(topic.Id))">เพิ่ม SubTopic</MudButton>
                                    <MudButton Variant="Variant.Text" OnClick="CloseSubTopicForm">ยกเลิก</MudButton>
                                </MudStack>
                            </MudItem>
                        </MudGrid>
                    }

                    @foreach (var subTopic in _subTopics.Where(s => s.TopicId == topic.Id))
                    {
                        <MudPaper Class="pa-3 mb-2" Outlined="true">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                                <MudText Typo="Typo.subtitle1">@subTopic.Code — @subTopic.Name</MudText>
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary">น้ำหนัก @subTopic.Weight.ToString("0.#")%</MudChip>
                                <MudChip T="string" Size="Size.Small" Color="@(IndicatorWeightTotal(subTopic.Id) == 100 ? Color.Success : Color.Warning)">
                                    ตัวชี้วัดรวม @IndicatorWeightTotal(subTopic.Id).ToString("0.#")%
                                </MudChip>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                    OnClick="@(() => RemoveSubTopicAsync(subTopic.Id))" />
                            </MudStack>

                            <MudTable Items="_indicators.Where(i => i.SubTopicId == subTopic.Id)" Dense="true" Hover="true">
                                <HeaderContent>
                                    <MudTh>รหัส</MudTh>
                                    <MudTh>ชื่อตัวชี้วัด</MudTh>
                                    <MudTh>Competency</MudTh>
                                    <MudTh>น้ำหนัก</MudTh>
                                    <MudTh></MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd>@context.Code</MudTd>
                                    <MudTd>@context.Name</MudTd>
                                    <MudTd>
                                        @if (context.CompetencyId is long compId && _competencyNames.TryGetValue(compId, out var compName))
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Info">@compName</MudChip>
                                        }
                                    </MudTd>
                                    <MudTd>@context.Weight.ToString("0.#")%</MudTd>
                                    <MudTd><MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="@(() => RemoveIndicatorAsync(context.Id))">ลบ</MudButton></MudTd>
                                </RowTemplate>
                                <NoRecordsContent><MudText Typo="Typo.body2">ยังไม่มีตัวชี้วัด</MudText></NoRecordsContent>
                            </MudTable>

                            @if (_showIndicatorFormForSubTopicId != subTopic.Id)
                            {
                                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mt-2 flex-wrap">
                                    <MudButton Color="Color.Primary" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => OpenIndicatorForm(subTopic.Id))">เพิ่มตัวชี้วัด</MudButton>
                                    @if (_posExecTypes.Count > 0)
                                    {
                                        <MudSelect T="long?" Value="@GetKpiSeedSource(subTopic.Id)" ValueChanged="@(v => SetKpiSeedSource(subTopic.Id, v))"
                                            Label="ดึง KPI จากกลุ่มตำแหน่ง" Dense="true" Style="max-width:260px;" Clearable="true">
                                            @foreach (var pet in _posExecTypes)
                                            {
                                                <MudSelectItem T="long?" Value="@((long?)pet.Id)">@pet.Name</MudSelectItem>
                                            }
                                        </MudSelect>
                                        <MudButton Color="Color.Tertiary" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Download"
                                            OnClick="@(() => SeedFromKpiAsync(subTopic.Id))" Disabled="GetKpiSeedSource(subTopic.Id) is null || _busy">ดึงเข้ามาเป็นตัวชี้วัด</MudButton>
                                    }
                                </MudStack>
                            }
                            else
                            {
                                <MudGrid Class="mt-2">
                                    <MudItem xs="6" sm="2"><MudTextField @bind-Value="_newIndicatorCode" Label="รหัส" /></MudItem>
                                    <MudItem xs="6" sm="3"><MudTextField @bind-Value="_newIndicatorName" Label="ชื่อตัวชี้วัด" /></MudItem>
                                    <MudItem xs="12" sm="3">
                                        <MudSelect T="long?" @bind-Value="_newIndicatorCompetencyId" Label="ผูก Competency (ถ้ามี)" Clearable="true">
                                            @foreach (var comp in _competencies)
                                            {
                                                <MudSelectItem T="long?" Value="comp.Id">@comp.Name</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="12" sm="2"><MudTextField @bind-Value="_newIndicatorTarget" Label="คำอธิบายเกณฑ์เต็มคะแนน" /></MudItem>
                                    <MudItem xs="8" sm="1"><MudNumericField T="decimal" @bind-Value="_newIndicatorWeight" Label="น้ำหนัก (%)" Min="0" Max="100" /></MudItem>
                                    <MudItem xs="4" sm="1">
                                        <MudStack Row="true" Spacing="2">
                                            <MudButton Color="Color.Primary" Variant="Variant.Text" OnClick="@(() => AddIndicatorAsync(subTopic.Id))">เพิ่ม</MudButton>
                                            <MudButton Variant="Variant.Text" OnClick="CloseIndicatorForm">ยกเลิก</MudButton>
                                        </MudStack>
                                    </MudItem>
                                </MudGrid>
                            }
                        </MudPaper>
                    }
                </ChildContent>
            </MudExpansionPanel>
        </MudExpansionPanels>
    }

    <MudButton Variant="Variant.Text" Href="/perf/evaluation-types">กลับไปหน้าประเภทแบบประเมิน</MudButton>
}

@code {
    [Parameter] public long EvaluationTypeId { get; set; }

    private Perf_EvaluationType? _evalType;
    private List<Perf_Topic> _topics = new();
    private List<Perf_SubTopic> _subTopics = new();
    private List<Perf_Indicator> _indicators = new();
    private string? _error;

    private decimal _topicWeightTotal => _topics.Sum(t => t.Weight);

    private bool _showTopicForm;
    private long? _showSubTopicFormForTopicId;
    private long? _showIndicatorFormForSubTopicId;

    private string _newTopicCode = ""; private string _newTopicName = ""; private decimal _newTopicWeight;
    private string _newSubTopicCode = ""; private string _newSubTopicName = ""; private decimal _newSubTopicWeight;
    private string _newIndicatorCode = ""; private string _newIndicatorName = ""; private string _newIndicatorTarget = ""; private decimal _newIndicatorWeight;
    private long? _newIndicatorCompetencyId;
    private List<Comp_Competency> _competencies = new();
    private Dictionary<long, string> _competencyNames = new();

    // KPI-set helpers (AutoX gap #1): clone a whole tree from another type,
    // or pull a position-group's Job_ProfileKpi into a SubTopic.
    private List<Perf_EvaluationType> _otherTypes = new();
    private List<Pos_ExecType> _posExecTypes = new();
    private long? _cloneSourceTypeId;
    private readonly Dictionary<long, long?> _kpiSeedSourceBySubTopic = new();
    private bool _busy;

    private long? GetKpiSeedSource(long subTopicId) => _kpiSeedSourceBySubTopic.TryGetValue(subTopicId, out var v) ? v : null;
    private void SetKpiSeedSource(long subTopicId, long? v) => _kpiSeedSourceBySubTopic[subTopicId] = v;

    private void OpenTopicForm()
    {
        _newTopicCode = ""; _newTopicName = ""; _newTopicWeight = 0;
        _error = null;
        _showTopicForm = true;
    }

    private void CloseTopicForm()
    {
        _showTopicForm = false;
        _error = null;
    }

    private void OpenSubTopicForm(long topicId)
    {
        _newSubTopicCode = ""; _newSubTopicName = ""; _newSubTopicWeight = 0;
        _error = null;
        _showSubTopicFormForTopicId = topicId;
    }

    private void CloseSubTopicForm()
    {
        _showSubTopicFormForTopicId = null;
        _error = null;
    }

    private void OpenIndicatorForm(long subTopicId)
    {
        _newIndicatorCode = ""; _newIndicatorName = ""; _newIndicatorTarget = ""; _newIndicatorWeight = 0; _newIndicatorCompetencyId = null;
        _error = null;
        _showIndicatorFormForSubTopicId = subTopicId;
    }

    private void CloseIndicatorForm()
    {
        _showIndicatorFormForSubTopicId = null;
        _error = null;
    }

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        _evalType = await context.Perf_EvaluationTypes.FirstOrDefaultAsync(t => t.Id == EvaluationTypeId);
        if (_evalType is null) return;

        _topics = await context.Perf_Topics.Where(t => t.EvaluationTypeId == EvaluationTypeId && t.IsActive).OrderBy(t => t.SortOrder).ToListAsync();
        var topicIds = _topics.Select(t => t.Id).ToList();
        _subTopics = await context.Perf_SubTopics.Where(s => topicIds.Contains(s.TopicId) && s.IsActive).OrderBy(s => s.SortOrder).ToListAsync();
        var subTopicIds = _subTopics.Select(s => s.Id).ToList();
        _indicators = await context.Perf_Indicators.Where(i => subTopicIds.Contains(i.SubTopicId) && i.IsActive).OrderBy(i => i.Code).ToListAsync();

        _competencies = await context.Comp_Competencies.Where(c => c.IsActive).OrderBy(c => c.Name).ToListAsync();
        _competencyNames = _competencies.ToDictionary(c => c.Id, c => c.Name);

        // Clone-source candidates: other types that actually HAVE a tree to copy.
        var typesWithTopics = await context.Perf_Topics.Where(t => t.IsActive).Select(t => t.EvaluationTypeId).Distinct().ToListAsync();
        _otherTypes = await context.Perf_EvaluationTypes
            .Where(t => t.Id != EvaluationTypeId && t.IsActive && typesWithTopics.Contains(t.Id))
            .OrderBy(t => t.Code).ToListAsync();

        // Position-groups that have KPIs to pull in.
        var groupsWithKpi = await context.Job_ProfileKpis.Where(k => k.IsActive).Select(k => k.PosExecTypeId).Distinct().ToListAsync();
        _posExecTypes = await context.Pos_ExecTypes
            .Where(p => groupsWithKpi.Contains(p.Id))
            .OrderBy(p => p.Name).ToListAsync();
    }

    private async Task CloneTreeAsync()
    {
        _error = null;
        if (_cloneSourceTypeId is not long src) return;
        _busy = true;
        try
        {
            var n = await KpiSetService.CloneTopicTreeAsync(src, EvaluationTypeId);
            Snackbar.Add($"คัดลอกชุดตัวชี้วัดสำเร็จ ({n} ตัวชี้วัด)", Severity.Success);
            _cloneSourceTypeId = null;
            await LoadAsync();
        }
        catch (InvalidOperationException ex) { _error = ex.Message; Snackbar.Add(ex.Message, Severity.Warning); }
        finally { _busy = false; }
    }

    private async Task SeedFromKpiAsync(long subTopicId)
    {
        _error = null;
        if (GetKpiSeedSource(subTopicId) is not long petId) return;
        _busy = true;
        try
        {
            var n = await KpiSetService.SeedIndicatorsFromJobKpiAsync(subTopicId, petId);
            Snackbar.Add(n == 0 ? "ไม่มีตัวชี้วัดใหม่ให้เพิ่ม (มีครบแล้ว)" : $"ดึง KPI เข้ามาเป็นตัวชี้วัด {n} รายการ", n == 0 ? Severity.Info : Severity.Success);
            SetKpiSeedSource(subTopicId, null);
            await LoadAsync();
        }
        catch (InvalidOperationException ex) { _error = ex.Message; Snackbar.Add(ex.Message, Severity.Warning); }
        finally { _busy = false; }
    }

    private decimal SubTopicWeightTotal(long topicId) => _subTopics.Where(s => s.TopicId == topicId).Sum(s => s.Weight);
    private decimal IndicatorWeightTotal(long subTopicId) => _indicators.Where(i => i.SubTopicId == subTopicId).Sum(i => i.Weight);

    private async Task AddTopicAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_newTopicCode) || string.IsNullOrWhiteSpace(_newTopicName)) { _error = "กรุณาระบุรหัสและชื่อ Topic"; return; }
        await using var context = await DbFactory.CreateDbContextAsync();
        context.Perf_Topics.Add(new Perf_Topic
        {
            EvaluationTypeId = EvaluationTypeId,
            Code = _newTopicCode,
            Name = _newTopicName,
            Weight = _newTopicWeight,
            SortOrder = _topics.Count,
            IsActive = true,
        });
        await context.SaveChangesAsync();
        _newTopicCode = ""; _newTopicName = ""; _newTopicWeight = 0;
        _showTopicForm = false;
        await LoadAsync();
    }

    private async Task RemoveTopicAsync(long id)
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var hasChildren = await context.Perf_SubTopics.AnyAsync(s => s.TopicId == id && s.IsActive);
        if (hasChildren) { _error = "ลบไม่ได้ — ยังมี SubTopic อยู่ภายใต้ Topic นี้"; return; }
        var row = await context.Perf_Topics.FirstOrDefaultAsync(t => t.Id == id);
        if (row is null) return;
        row.IsActive = false;
        await context.SaveChangesAsync();
        await LoadAsync();
    }

    private async Task AddSubTopicAsync(long topicId)
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_newSubTopicCode) || string.IsNullOrWhiteSpace(_newSubTopicName)) { _error = "กรุณาระบุรหัสและชื่อ SubTopic"; return; }
        await using var context = await DbFactory.CreateDbContextAsync();
        context.Perf_SubTopics.Add(new Perf_SubTopic
        {
            TopicId = topicId,
            Code = _newSubTopicCode,
            Name = _newSubTopicName,
            Weight = _newSubTopicWeight,
            SortOrder = _subTopics.Count(s => s.TopicId == topicId),
            IsActive = true,
        });
        await context.SaveChangesAsync();
        _newSubTopicCode = ""; _newSubTopicName = ""; _newSubTopicWeight = 0;
        _showSubTopicFormForTopicId = null;
        await LoadAsync();
    }

    private async Task RemoveSubTopicAsync(long id)
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var hasChildren = await context.Perf_Indicators.AnyAsync(i => i.SubTopicId == id && i.IsActive);
        if (hasChildren) { _error = "ลบไม่ได้ — ยังมีตัวชี้วัดอยู่ภายใต้ SubTopic นี้"; return; }
        var row = await context.Perf_SubTopics.FirstOrDefaultAsync(s => s.Id == id);
        if (row is null) return;
        row.IsActive = false;
        await context.SaveChangesAsync();
        await LoadAsync();
    }

    private async Task AddIndicatorAsync(long subTopicId)
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_newIndicatorCode) || string.IsNullOrWhiteSpace(_newIndicatorName)) { _error = "กรุณาระบุรหัสและชื่อตัวชี้วัด"; return; }
        await using var context = await DbFactory.CreateDbContextAsync();
        context.Perf_Indicators.Add(new Perf_Indicator
        {
            SubTopicId = subTopicId,
            Code = _newIndicatorCode,
            Name = _newIndicatorName,
            TargetDescription = string.IsNullOrWhiteSpace(_newIndicatorTarget) ? null : _newIndicatorTarget,
            Weight = _newIndicatorWeight,
            CompetencyId = _newIndicatorCompetencyId,
            IsActive = true,
        });
        await context.SaveChangesAsync();
        _newIndicatorCode = ""; _newIndicatorName = ""; _newIndicatorTarget = ""; _newIndicatorWeight = 0; _newIndicatorCompetencyId = null;
        _showIndicatorFormForSubTopicId = null;
        await LoadAsync();
    }

    private async Task RemoveIndicatorAsync(long id)
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var hasScores = await context.Perf_Scores.AnyAsync(s => s.IndicatorId == id);
        if (hasScores) { _error = "ลบไม่ได้ — มีคะแนนที่บันทึกไว้กับตัวชี้วัดนี้แล้ว"; return; }
        var row = await context.Perf_Indicators.FirstOrDefaultAsync(i => i.Id == id);
        if (row is null) return;
        row.IsActive = false;
        await context.SaveChangesAsync();
        await LoadAsync();
    }
}
