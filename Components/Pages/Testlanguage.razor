@page "/testlanguage"
@using HRM.Services
@using HRM.Components.Shared
@inherits LocalizedComponentBase

@inject JsonLocalizationService L

<h3>@L.Translate("Hello")</h3>

<button class="btn btn-primary" @onclick='() => L.SetLanguageAsync("en")'>EN</button>
<button class="btn btn-secondary" @onclick='() => L.SetLanguageAsync("th")'>TH</button>
