@page "/masterdata"
@using Microsoft.AspNetCore.Components

<PageTitle>Master Data</PageTitle>

<h3>Master Data Home</h3>

<p class="lead">Quick access to master data maintenance pages / เมนูหลักข้อมูลตั้งต้น</p>

<div class="row masterdata-grid">
    <div class="col-12 col-md-6 col-lg-4 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Titles / คำนำหน้า</h5>
                <p class="card-text">Manage system titles (mas_titles)</p>
                <NavLink class="btn btn-primary" href="/mas_titles">Open</NavLink>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6 col-lg-4 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Organizations / องค์กร</h5>
                <p class="card-text">Organization master data (com_organization)</p>
                <NavLink class="btn btn-primary" href="/com_organizations">Open</NavLink>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6 col-lg-4 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Positions / ตำแหน่ง</h5>
                <p class="card-text">Manage positions (pos_positions)</p>
                <NavLink class="btn btn-primary" href="/pos_positions">Open</NavLink>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6 col-lg-4 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Position Levels / ระดับตำแหน่ง</h5>
                <p class="card-text">Manage position levels (pos_position_levels)</p>
                <NavLink class="btn btn-primary" href="/pos_position_levels">Open</NavLink>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6 col-lg-4 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Menus / เมนูระบบ</h5>
                <p class="card-text">System menus (sc_menus)</p>
                <NavLink class="btn btn-primary" href="/sc_menus">Open</NavLink>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6 col-lg-4 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Roles / สิทธิ์</h5>
                <p class="card-text">Manage roles (sc_roles)</p>
                <NavLink class="btn btn-primary" href="/sc_roles">Open</NavLink>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6 col-lg-4 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Users / ผู้ใช้</h5>
                <p class="card-text">User administration (sc_users)</p>
                <NavLink class="btn btn-primary" href="/sc_users">Open</NavLink>
            </div>
        </div>
    </div>
</div>

<style>
    .masterdata-grid .card { border: 1px solid #e9ecef; }
    .masterdata-grid .card .card-body { display:flex; flex-direction:column; justify-content:space-between; }
    .masterdata-grid .card-title { font-weight:600; }
</style>
