@page "/sc_user_roles/create"
@using Microsoft.EntityFrameworkCore
@using hrm.Models
@inject IDbContextFactory<hrm.Models.HRMContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>sc_user_role</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="sc_user_role" OnValidSubmit="Addsc_user_role" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert"/>
            <div class="mb-3">
                <label for="roleid" class="form-label">roleid:</label> 
                <InputNumber id="roleid" @bind-Value="sc_user_role.roleid" class="form-control" /> 
                <ValidationMessage For="() => sc_user_role.roleid" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="modate" class="form-label">modate:</label> 
                <InputDate id="modate" @bind-Value="sc_user_role.modate" class="form-control" /> 
                <ValidationMessage For="() => sc_user_role.modate" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="modby" class="form-label">modby:</label> 
                <InputText id="modby" @bind-Value="sc_user_role.modby" class="form-control" /> 
                <ValidationMessage For="() => sc_user_role.modby" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="isactive" class="form-label">isactive:</label> 
                <InputCheckbox id="isactive" @bind-Value="sc_user_role.isactive" class="form-check-input" aria-required="true"/> 
                <ValidationMessage For="() => sc_user_role.isactive" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="startdate" class="form-label">startdate:</label> 
                <InputDate id="startdate" @bind-Value="sc_user_role.startdate" class="form-control" /> 
                <ValidationMessage For="() => sc_user_role.startdate" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="enddate" class="form-label">enddate:</label> 
                <InputDate id="enddate" @bind-Value="sc_user_role.enddate" class="form-control" /> 
                <ValidationMessage For="() => sc_user_role.enddate" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="userid" class="form-label">userid:</label> 
                <InputNumber id="userid" @bind-Value="sc_user_role.userid" class="form-control" /> 
                <ValidationMessage For="() => sc_user_role.userid" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="empid" class="form-label">empid:</label> 
                <InputText id="empid" @bind-Value="sc_user_role.empid" class="form-control" /> 
                <ValidationMessage For="() => sc_user_role.empid" class="text-danger" /> 
            </div>        
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/sc_user_roles">Back to List</a>
</div>

@code {
    [SupplyParameterFromForm]
    private sc_user_role sc_user_role { get; set; } = new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task Addsc_user_role()
    {
        using var context = DbFactory.CreateDbContext();
        context.sc_user_roles.Add(sc_user_role);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/sc_user_roles");
    }
}
