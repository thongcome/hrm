@page "/leave-requests/policy"
@using System.Security.Claims
@using HRM.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@attribute [Authorize(Policy = "Menu:WF_WORKFLOW_ADMIN")]

<PageTitle>สิทธิการลา (Leave Policy)</PageTitle>

<MudPaper Class="pa-4 mb-4" MaxWidth="900px">
    <MudText Typo="Typo.h5">สิทธิการลาต่อปี (Leave Policy)</MudText>
    <MudText Typo="Typo.body2" Class="mt-1">
        กำหนดจำนวนวันลาต่อปีของแต่ละประเภท — ใช้คำนวณ "ยอดคงเหลือ" ที่หน้ายื่นคำขอลา ค่าเริ่มต้นตั้งไว้ตามขั้นต่ำ พ.ร.บ.คุ้มครองแรงงาน ปรับได้ตามนโยบายบริษัท
    </MudText>

    @if (string.IsNullOrEmpty(_companyId))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">บัญชีของคุณยังไม่ได้ผูกกับบริษัทใดๆ — ติดต่อแอดมินให้ตั้งค่า empid ก่อน</MudAlert>
        return;
    }

    <MudGrid Class="mt-2">
        <MudItem xs="12" sm="6">
            <MudSelect T="string" Value="_countryCode" ValueChanged="OnCountryChangedAsync" Label="ประเทศของบริษัท" Clearable="true">
                @foreach (var c in HRM.Services.Leave.LeaveCountryHelper.CommonCountries)
                {
                    <MudSelectItem T="string" Value="@c.Code">@c.Label</MudSelectItem>
                }
            </MudSelect>
            <MudText Typo="Typo.caption" Class="mt-1">
                ใช้กำหนดว่าสิทธิการลาเฉพาะกฎหมาย (เช่น ลาบวช) จะเสนอให้ตั้งค่า/เลือกใช้หรือไม่ — ยังไม่ระบุ = ถือเป็นไทยเหมือนเดิม
            </MudText>
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudText Typo="Typo.body2" Class="mb-1">วันทำงานของบริษัท (ใช้คำนวณจำนวนวันลา)</MudText>
            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                @foreach (var day in _weekDays)
                {
                    <MudCheckBox T="bool" Value="@_workDaysSelected.Contains(day)" ValueChanged="@((bool v) => OnWorkDayToggledAsync(day, v))" Label="@DayLabel(day)" Dense="true" />
                }
            </MudStack>
            <MudText Typo="Typo.caption" Class="mt-1">ค่าเริ่มต้น = จันทร์-ศุกร์</MudText>
        </MudItem>
    </MudGrid>

    <MudDivider Class="my-4" />

    @if (!string.IsNullOrEmpty(_error))
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
    }

    <MudTable Items="_policies" Dense="true" Hover="true">
        <HeaderContent>
            <MudTh>ประเภทการลา</MudTh>
            <MudTh>สิทธิ (วัน/ปี)</MudTh>
            <MudTh>จ่ายเงิน</MudTh>
            <MudTh>ทบวันลาไปปีถัดไป</MudTh>
            <MudTh>สถานะ</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@LeaveTypeLabel(context.LeaveType)</MudTd>
            <MudTd>
                @if (_editingId == context.Id)
                {
                    <MudNumericField T="decimal" @bind-Value="_editDays" Min="0" Format="0.#" />
                }
                else
                {
                    @context.EntitlementDaysPerYear.ToString("0.#")
                }
            </MudTd>
            <MudTd>
                @if (_editingId == context.Id)
                {
                    <MudCheckBox T="bool" @bind-Value="_editIsPaid" Dense="true" />
                }
                else
                {
                    @(context.IsPaid ? "จ่าย" : "ไม่จ่าย")
                }
            </MudTd>
            <MudTd>
                @if (_editingId == context.Id)
                {
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                        <MudSelect T="LeaveCarryOverMode" @bind-Value="_editCarryOverMode" Dense="true" Style="min-width:140px">
                            <MudSelectItem T="LeaveCarryOverMode" Value="LeaveCarryOverMode.None">ไม่ทบ</MudSelectItem>
                            <MudSelectItem T="LeaveCarryOverMode" Value="LeaveCarryOverMode.Capped">ทบได้ (จำกัด)</MudSelectItem>
                            <MudSelectItem T="LeaveCarryOverMode" Value="LeaveCarryOverMode.Unlimited">ทบได้ไม่จำกัด</MudSelectItem>
                        </MudSelect>
                        @if (_editCarryOverMode == LeaveCarryOverMode.Capped)
                        {
                            <MudNumericField T="decimal?" @bind-Value="_editMaxCarryOverDays" Min="0" Format="0.#" Label="สูงสุด (วัน)" Style="width:120px" />
                        }
                    </MudStack>
                }
                else
                {
                    @(context.CarryOverMode switch
                    {
                        LeaveCarryOverMode.None => "ไม่ทบ",
                        LeaveCarryOverMode.Capped => $"ทบได้สูงสุด {context.MaxCarryOverDays?.ToString("0.#") ?? "-"} วัน",
                        LeaveCarryOverMode.Unlimited => "ทบได้ไม่จำกัด",
                        _ => "-",
                    })
                }
            </MudTd>
            <MudTd>@(context.IsActive ? "ใช้งาน" : "ปิดใช้งาน")</MudTd>
            <MudTd>
                @if (_editingId == context.Id)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">บันทึก</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="CancelEdit">ยกเลิก</MudButton>
                }
                else
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => StartEdit(context))">แก้ไข</MudButton>
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2">ยังไม่มีการตั้งค่าสิทธิการลาสำหรับบริษัทนี้</MudText>
        </NoRecordsContent>
    </MudTable>

    @if (_missingTypes.Count > 0)
    {
        <MudDivider Class="my-4" />
        <MudText Typo="Typo.body2" Class="mb-2">ประเภทที่ยังไม่ได้ตั้งค่า:</MudText>
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
            @foreach (var type in _missingTypes)
            {
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => AddPolicyAsync(type))">+ @LeaveTypeLabel(type)</MudButton>
            }
        </MudStack>
    }
</MudPaper>

@code {
    private string? _companyId;
    private List<Lve_LeavePolicy> _policies = new();
    private string? _error;
    private long? _editingId;
    private decimal _editDays;
    private bool _editIsPaid;
    private LeaveCarryOverMode _editCarryOverMode;
    private decimal? _editMaxCarryOverDays;

    private List<LeaveType> _missingTypes = new();
    private string? _countryCode;

    private static readonly DayOfWeek[] _weekDays =
    [
        DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday,
        DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday,
    ];
    private HashSet<DayOfWeek> _workDaysSelected = new();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
        if (string.IsNullOrWhiteSpace(_companyId)) return;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        _policies = await context.Lve_LeavePolicies
            .Where(p => p.CompanyId == _companyId)
            .OrderBy(p => p.LeaveType)
            .ToListAsync();

        var setting = await context.Lve_CompanySettings.FirstOrDefaultAsync(s => s.CompanyId == _companyId);
        _countryCode = setting?.CountryCode;
        _workDaysSelected = DecodeWorkDaysMask(setting?.WorkDaysMask);

        var existingTypes = _policies.Select(p => p.LeaveType).ToHashSet();
        _missingTypes = Enum.GetValues<LeaveType>()
            .Where(t => !existingTypes.Contains(t) && HRM.Services.Leave.LeaveCountryHelper.IsApplicable(t, _countryCode))
            .ToList();
    }

    private static HashSet<DayOfWeek> DecodeWorkDaysMask(int? mask)
    {
        var resolved = HRM.Services.Leave.LeaveDayCalculator.ResolveWorkDaysMask(mask);
        return Enum.GetValues<DayOfWeek>().Where(d => (resolved & (1 << (int)d)) != 0).ToHashSet();
    }

    private static string DayLabel(DayOfWeek day) => day switch
    {
        DayOfWeek.Monday => "จันทร์",
        DayOfWeek.Tuesday => "อังคาร",
        DayOfWeek.Wednesday => "พุธ",
        DayOfWeek.Thursday => "พฤหัสบดี",
        DayOfWeek.Friday => "ศุกร์",
        DayOfWeek.Saturday => "เสาร์",
        _ => "อาทิตย์",
    };

    private async Task OnWorkDayToggledAsync(DayOfWeek day, bool selected)
    {
        if (selected) _workDaysSelected.Add(day);
        else _workDaysSelected.Remove(day);

        var mask = _workDaysSelected.Aggregate(0, (acc, d) => acc | (1 << (int)d));

        await using var context = await DbFactory.CreateDbContextAsync();
        var setting = await context.Lve_CompanySettings.FirstOrDefaultAsync(s => s.CompanyId == _companyId);
        if (setting is null)
        {
            context.Lve_CompanySettings.Add(new Lve_CompanySetting { CompanyId = _companyId!, WorkDaysMask = mask });
        }
        else
        {
            setting.WorkDaysMask = mask;
        }
        await context.SaveChangesAsync();
        Snackbar.Add("บันทึกวันทำงานเรียบร้อย", Severity.Success);
    }

    private async Task OnCountryChangedAsync(string? value)
    {
        _countryCode = value;

        await using var context = await DbFactory.CreateDbContextAsync();
        var setting = await context.Lve_CompanySettings.FirstOrDefaultAsync(s => s.CompanyId == _companyId);
        if (setting is null)
        {
            context.Lve_CompanySettings.Add(new Lve_CompanySetting { CompanyId = _companyId!, CountryCode = value });
        }
        else
        {
            setting.CountryCode = value;
        }
        await context.SaveChangesAsync();

        Snackbar.Add("บันทึกประเทศของบริษัทเรียบร้อย", Severity.Success);
        await LoadAsync();
    }

    private static string LeaveTypeLabel(LeaveType type) => type switch
    {
        LeaveType.Sick => "ลาป่วย",
        LeaveType.Personal => "ลากิจ",
        LeaveType.Vacation => "ลาพักร้อน",
        LeaveType.Maternity => "ลาคลอด",
        LeaveType.Ordination => "ลาบวช",
        _ => "อื่นๆ",
    };

    private void StartEdit(Lve_LeavePolicy policy)
    {
        _editingId = policy.Id;
        _editDays = policy.EntitlementDaysPerYear;
        _editIsPaid = policy.IsPaid;
        _editCarryOverMode = policy.CarryOverMode;
        _editMaxCarryOverDays = policy.MaxCarryOverDays;
        _error = null;
    }

    private void CancelEdit()
    {
        _editingId = null;
        _error = null;
    }

    private async Task SaveAsync()
    {
        if (_editingId is not long id) return;

        await using var context = await DbFactory.CreateDbContextAsync();
        var existing = await context.Lve_LeavePolicies.FirstOrDefaultAsync(p => p.Id == id && p.CompanyId == _companyId);
        if (existing is null)
        {
            _error = "ไม่พบข้อมูลที่ต้องการแก้ไข";
            return;
        }

        existing.EntitlementDaysPerYear = _editDays;
        existing.IsPaid = _editIsPaid;
        existing.CarryOverMode = _editCarryOverMode;
        existing.MaxCarryOverDays = _editCarryOverMode == LeaveCarryOverMode.Capped ? _editMaxCarryOverDays : null;
        await context.SaveChangesAsync();

        Snackbar.Add("บันทึกสิทธิการลาเรียบร้อย", Severity.Success);
        _editingId = null;
        await LoadAsync();
    }

    private async Task AddPolicyAsync(LeaveType type)
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        context.Lve_LeavePolicies.Add(new Lve_LeavePolicy
        {
            CompanyId = _companyId!,
            LeaveType = type,
            EntitlementDaysPerYear = 0,
            IsActive = true,
        });
        await context.SaveChangesAsync();
        await LoadAsync();
    }
}
