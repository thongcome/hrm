@page "/leave-requests/leave-types"
@using HRM.Models
@using HRM.Services.Leave
@using HRM.Services.Security
@using HRM.Services.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider
@inject ProgramRoleService ProgramRoles
@inject JsonLocalizationService L
@attribute [Authorize(Policy = "Menu:WF_WORKFLOW_ADMIN")]

@* Shape B master-detail reference page (see .claude/skills/CRUD/SKILL.md
   rule 7): this list is the master; clicking a row drills into
   LeaveTypeDetail.razor (/leave-requests/leave-types/{Id}) for the full
   grouped edit form. Id=0 on that route = create mode, so the whole pair
   shares one AD.CRUDManage program path ("/leave-requests/leave-types"). *@

<PageTitle>ตั้งค่าประเภทการลา</PageTitle>

<MudPaper Class="pa-4 mb-4">
    <MudText Typo="Typo.h5">ตั้งค่าประเภทการลา (Leave Type Catalog)</MudText>
    <MudText Typo="Typo.body2" Class="mt-1">
        รายการประเภทการลาที่ระบบรองรับ (ใช้ร่วมกันทุกบริษัท) — HR เพิ่ม/แก้ไข/ปิดใช้งานเองได้โดยไม่ต้องแก้โค้ด
        แต่ละบริษัทยังต้องไปเปิดใช้และตั้งจำนวนวันของตัวเองที่หน้า <MudLink Href="/leave-requests/policy">สิทธิการลา</MudLink> อีกครั้งหนึ่ง
        — คลิกที่รายการเพื่อดู/แก้ไขกติกาทั้งหมดของประเภทนั้น
    </MudText>

    @if (_rights is not null && !_rights.CanCreate && !_rights.CanEdit && !_rights.CanDelete)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">@L.Translate("LeaveTypeNoWriteAccess")</MudAlert>
    }

    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mt-3">
        <MudTextField T="string" Value="_searchTerm" Label="ค้นหา" Immediate="true"
            DebounceInterval="300" ValueChanged="OnSearchChanged" Style="max-width:360px;"
            AdornmentIcon="@Icons.Material.Filled.Search" Adornment="Adornment.Start" />
        @if (_rights?.CanCreate == true)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                OnClick="@(() => Nav.NavigateTo("/leave-requests/leave-types/0"))">@L.Translate("LeaveTypeAddNew")</MudButton>
        }
    </MudStack>

    <MudTable Items="_types" Dense="true" Hover="true" Class="mt-3"
        T="Lve_LeaveType" OnRowClick="OnRowClick" RowClass="cursor-pointer">
        <HeaderContent>
            <MudTh>ไอคอน</MudTh>
            <MudTh>รหัส</MudTh>
            <MudTh>ชื่อ (ไทย / อังกฤษ)</MudTh>
            <MudTh>@L.Translate("LeaveTypeColRuleSummary")</MudTh>
            <MudTh>ลำดับ</MudTh>
            <MudTh>สถานะ</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd><MudIcon Icon="@LeaveIconCatalog.Resolve(context.IconName)" /></MudTd>
            <MudTd>
                @context.Code
                @if (context.IsStatutory)
                {
                    <MudTooltip Text="ประเภทตามกฎหมายแรงงาน — ไม่สามารถแก้รหัสได้">
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Class="ml-1">กฎหมาย</MudChip>
                    </MudTooltip>
                }
            </MudTd>
            <MudTd>
                @context.NameTh <MudText Typo="Typo.caption" Color="Color.Secondary">@context.NameEn</MudText>
            </MudTd>
            <MudTd>
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                    @foreach (var chip in RuleChips(context))
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@chip.Color">@chip.Label</MudChip>
                    }
                </MudStack>
            </MudTd>
            <MudTd>@context.SortOrder</MudTd>
            <MudTd>
                @if (context.IsActive)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success">ใช้งาน</MudChip>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Default">ปิดใช้งาน</MudChip>
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2">ยังไม่มีประเภทการลาในระบบ</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
</MudPaper>

@code {
    private List<Lve_LeaveType> _types = new();
    private string? _searchTerm;
    private ProgramRoleService.ProgramRights? _rights;

    private record RuleChip(string Label, Color Color);

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _rights = await ProgramRoles.GetRightsAsync(state.User, "/leave-requests/leave-types");
        await LoadAsync();
    }

    // Bounded catalog table (14 rows today, grows one row per new HR
    // category) — debounced live search per the CRUD skill's small-lookup
    // allowance, no explicit search gate needed.
    private async Task LoadAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var query = context.Lve_LeaveTypes.AsQueryable();
        query = EntitySearchHelper.ApplyTextSearch(query, _searchTerm,
            nameof(Lve_LeaveType.Code), nameof(Lve_LeaveType.NameTh), nameof(Lve_LeaveType.NameEn),
            nameof(Lve_LeaveType.LawReference), nameof(Lve_LeaveType.AttachmentDocName));
        _types = await query.OrderBy(t => t.SortOrder).ThenBy(t => t.Code).ToListAsync();
    }

    private async Task OnSearchChanged(string value)
    {
        _searchTerm = value;
        await LoadAsync();
    }

    private void OnRowClick(TableRowClickEventArgs<Lve_LeaveType> args)
    {
        if (args.Item is not null)
            Nav.NavigateTo($"/leave-requests/leave-types/{args.Item.Id}");
    }

    // Compact summary of the non-default rules on a row — the full editable
    // set lives on the detail page.
    private List<RuleChip> RuleChips(Lve_LeaveType t)
    {
        var chips = new List<RuleChip>();
        if (t.AllowHalfDay)
            chips.Add(new(L.Translate("LeaveTypeChipHalfDay"), Color.Default));
        if (t.MustBeConsecutive)
            chips.Add(new(L.Translate("LeaveTypeChipConsecutive"), Color.Warning));
        if (!t.AllowRetroactive)
            chips.Add(new(L.Translate("LeaveTypeChipNoRetro"), Color.Warning));
        if (t.AdvanceNoticeDays is int notice && notice > 0)
            chips.Add(new(string.Format(L.Translate("LeaveTypeChipNotice"), notice), Color.Info));
        if (!string.IsNullOrWhiteSpace(t.AttachmentDocName))
            chips.Add(new(t.AttachmentMinDays is decimal min && min > 0
                ? string.Format(L.Translate("LeaveTypeChipAttachMin"), t.AttachmentDocName, min.ToString("0.#"))
                : string.Format(L.Translate("LeaveTypeChipAttach"), t.AttachmentDocName), Color.Secondary));
        if (t.DayCountMethod == LeaveDayCountMethod.CalendarDays)
            chips.Add(new(L.Translate("LeaveTypeChipCalendarDays"), Color.Info));
        if (t.EntitlementFrequency == LeaveEntitlementFrequency.PerEvent)
            chips.Add(new(L.Translate("LeaveTypeFreqPerEvent"), Color.Tertiary));
        else if (t.EntitlementFrequency == LeaveEntitlementFrequency.OncePerEmployment)
            chips.Add(new(L.Translate("LeaveTypeFreqOncePerEmployment"), Color.Tertiary));
        if (t.ApplicableGender == "F")
            chips.Add(new("เฉพาะหญิง", Color.Default));
        else if (t.ApplicableGender == "M")
            chips.Add(new("เฉพาะชาย", Color.Default));
        return chips;
    }
}
