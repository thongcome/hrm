@page "/leave-requests/leave-types"
@using HRM.Models
@using HRM.Services.Leave
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject ISnackbar Snackbar
@attribute [Authorize(Policy = "Menu:WF_WORKFLOW_ADMIN")]

<PageTitle>ตั้งค่าประเภทการลา</PageTitle>

<MudPaper Class="pa-4 mb-4">
    <MudText Typo="Typo.h5">ตั้งค่าประเภทการลา (Leave Type Catalog)</MudText>
    <MudText Typo="Typo.body2" Class="mt-1">
        รายการประเภทการลาที่ระบบรองรับ (ใช้ร่วมกันทุกบริษัท) — HR เพิ่ม/แก้ไข/ปิดใช้งานเองได้โดยไม่ต้องแก้โค้ด
        แต่ละบริษัทยังต้องไปเปิดใช้และตั้งจำนวนวันของตัวเองที่หน้า <MudLink Href="/leave-requests/policy">สิทธิการลา</MudLink> อีกครั้งหนึ่ง
    </MudText>

    @if (!string.IsNullOrEmpty(_error))
    {
        <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
    }

    <MudTable Items="_types" Dense="true" Hover="true" Class="mt-3">
        <HeaderContent>
            <MudTh>รหัส</MudTh>
            <MudTh>ชื่อ (ไทย / อังกฤษ)</MudTh>
            <MudTh>กฎหมาย</MudTh>
            <MudTh>ขั้นต่ำ/ปี</MudTh>
            <MudTh>เพศ</MudTh>
            <MudTh>ประเทศ</MudTh>
            <MudTh>ใบรับรองแพทย์</MudTh>
            <MudTh>ลาครึ่งวันได้</MudTh>
            <MudTh>ลำดับ</MudTh>
            <MudTh>สถานะ</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                @context.Code
                @if (context.IsStatutory)
                {
                    <MudTooltip Text="ประเภทตามกฎหมายแรงงาน — ไม่สามารถแก้รหัสได้">
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Class="ml-1">กฎหมาย</MudChip>
                    </MudTooltip>
                }
            </MudTd>
            <MudTd>
                @if (_editingId == context.Id)
                {
                    <MudStack Spacing="1">
                        <MudTextField T="string" @bind-Value="_editNameTh" Label="ไทย" Margin="Margin.Dense" />
                        <MudTextField T="string" @bind-Value="_editNameEn" Label="อังกฤษ" Margin="Margin.Dense" />
                    </MudStack>
                }
                else
                {
                    @context.NameTh <MudText Typo="Typo.caption" Color="Color.Secondary">@context.NameEn</MudText>
                }
            </MudTd>
            <MudTd>
                @if (_editingId == context.Id)
                {
                    <MudTextField T="string" @bind-Value="_editLawReference" Label="มาตรา" Margin="Margin.Dense" Style="width:120px" />
                }
                else
                {
                    @(context.LawReference ?? "-")
                }
            </MudTd>
            <MudTd>
                @if (_editingId == context.Id)
                {
                    <MudNumericField T="decimal?" @bind-Value="_editStatutoryMinDays" Format="0.#" Min="0" Style="width:100px" />
                }
                else
                {
                    @(context.StatutoryMinDaysPerYear?.ToString("0.#") ?? "-")
                }
            </MudTd>
            <MudTd>
                @if (_editingId == context.Id)
                {
                    <MudSelect T="string" @bind-Value="_editApplicableGender" Clearable="true" Style="width:110px">
                        <MudSelectItem T="string" Value="@("F")">หญิงเท่านั้น</MudSelectItem>
                        <MudSelectItem T="string" Value="@("M")">ชายเท่านั้น</MudSelectItem>
                    </MudSelect>
                }
                else
                {
                    @(context.ApplicableGender switch { "F" => "หญิง", "M" => "ชาย", _ => "ทุกเพศ" })
                }
            </MudTd>
            <MudTd>
                @if (_editingId == context.Id)
                {
                    <MudSelect T="string" @bind-Value="_editApplicableCountryCode" Clearable="true" Style="width:140px">
                        @foreach (var c in LeaveCountryHelper.CommonCountries)
                        {
                            <MudSelectItem T="string" Value="@c.Code">@c.Label</MudSelectItem>
                        }
                    </MudSelect>
                }
                else
                {
                    @(context.ApplicableCountryCode ?? "ทุกประเทศ")
                }
            </MudTd>
            <MudTd>
                @if (_editingId == context.Id)
                {
                    <MudCheckBox T="bool" @bind-Value="_editRequiresMedicalCert" Dense="true" />
                }
                else
                {
                    @(context.RequiresMedicalCert ? "ต้องแนบ" : "-")
                }
            </MudTd>
            <MudTd>
                @if (_editingId == context.Id)
                {
                    <MudCheckBox T="bool" @bind-Value="_editAllowHalfDay" Dense="true" />
                }
                else
                {
                    @(context.AllowHalfDay ? "ได้" : "ไม่ได้")
                }
            </MudTd>
            <MudTd>
                @if (_editingId == context.Id)
                {
                    <MudNumericField T="int" @bind-Value="_editSortOrder" Style="width:70px" />
                }
                else
                {
                    @context.SortOrder
                }
            </MudTd>
            <MudTd>
                @if (_editingId == context.Id)
                {
                    <MudCheckBox T="bool" @bind-Value="_editIsActive" Dense="true" />
                    @if (context.IsStatutory && !_editIsActive)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Warning">ประเภทนี้เป็นสิทธิ์ขั้นต่ำตามกฎหมายแรงงานไทย ปิดใช้งานอาจขัดกับกฎหมาย</MudText>
                    }
                }
                else
                {
                    @(context.IsActive ? "ใช้งาน" : "ปิดใช้งาน")
                }
            </MudTd>
            <MudTd>
                @if (_editingId == context.Id)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">บันทึก</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="CancelEdit">ยกเลิก</MudButton>
                }
                else
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => StartEdit(context))">แก้ไข</MudButton>
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2">ยังไม่มีประเภทการลาในระบบ</MudText>
        </NoRecordsContent>
    </MudTable>

    <MudDivider Class="my-4" />
    <MudText Typo="Typo.subtitle1" Class="mb-2">เพิ่มประเภทการลาใหม่</MudText>
    <MudGrid>
        <MudItem xs="12" sm="3"><MudTextField T="string" @bind-Value="_newCode" Label="รหัส (Code, ไม่ซ้ำ)" /></MudItem>
        <MudItem xs="12" sm="4"><MudTextField T="string" @bind-Value="_newNameTh" Label="ชื่อ (ไทย)" /></MudItem>
        <MudItem xs="12" sm="4"><MudTextField T="string" @bind-Value="_newNameEn" Label="Name (English)" /></MudItem>
        <MudItem xs="12" sm="4">
            <MudSelect T="string" @bind-Value="_newApplicableCountryCode" Label="เฉพาะประเทศ (เว้นว่าง = ทุกประเทศ)" Clearable="true">
                @foreach (var c in LeaveCountryHelper.CommonCountries)
                {
                    <MudSelectItem T="string" Value="@c.Code">@c.Label</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="4"><MudCheckBox T="bool" @bind-Value="_newRequiresMedicalCert" Label="ต้องแนบใบรับรองแพทย์" /></MudItem>
        <MudItem xs="12" sm="4"><MudCheckBox T="bool" @bind-Value="_newAllowHalfDay" Label="ลาครึ่งวันได้" /></MudItem>
        <MudItem xs="12">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="AddTypeAsync">+ เพิ่มประเภทการลา</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@code {
    private List<Lve_LeaveType> _types = new();
    private string? _error;

    private int? _editingId;
    private string? _editNameTh;
    private string? _editNameEn;
    private string? _editLawReference;
    private decimal? _editStatutoryMinDays;
    private string? _editApplicableGender;
    private string? _editApplicableCountryCode;
    private bool _editRequiresMedicalCert;
    private bool _editAllowHalfDay;
    private int _editSortOrder;
    private bool _editIsActive;

    private string? _newCode;
    private string? _newNameTh;
    private string? _newNameEn;
    private string? _newApplicableCountryCode;
    private bool _newRequiresMedicalCert;
    private bool _newAllowHalfDay = true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _error = null;
        await using var context = await DbFactory.CreateDbContextAsync();
        _types = await context.Lve_LeaveTypes.OrderBy(t => t.SortOrder).ThenBy(t => t.Code).ToListAsync();
    }

    private void StartEdit(Lve_LeaveType type)
    {
        _editingId = type.Id;
        _editNameTh = type.NameTh;
        _editNameEn = type.NameEn;
        _editLawReference = type.LawReference;
        _editStatutoryMinDays = type.StatutoryMinDaysPerYear;
        _editApplicableGender = type.ApplicableGender;
        _editApplicableCountryCode = type.ApplicableCountryCode;
        _editRequiresMedicalCert = type.RequiresMedicalCert;
        _editAllowHalfDay = type.AllowHalfDay;
        _editSortOrder = type.SortOrder;
        _editIsActive = type.IsActive;
        _error = null;
    }

    private void CancelEdit()
    {
        _editingId = null;
        _error = null;
    }

    private async Task SaveAsync()
    {
        if (_editingId is not int id) return;
        if (string.IsNullOrWhiteSpace(_editNameTh) || string.IsNullOrWhiteSpace(_editNameEn))
        {
            _error = "กรุณากรอกชื่อไทยและอังกฤษให้ครบ";
            return;
        }

        await using var context = await DbFactory.CreateDbContextAsync();
        var existing = await context.Lve_LeaveTypes.FirstOrDefaultAsync(t => t.Id == id);
        if (existing is null)
        {
            _error = "ไม่พบประเภทการลาที่ต้องการแก้ไข";
            return;
        }

        existing.NameTh = _editNameTh;
        existing.NameEn = _editNameEn;
        existing.LawReference = string.IsNullOrWhiteSpace(_editLawReference) ? null : _editLawReference;
        existing.StatutoryMinDaysPerYear = _editStatutoryMinDays;
        existing.ApplicableGender = _editApplicableGender;
        existing.ApplicableCountryCode = _editApplicableCountryCode;
        existing.RequiresMedicalCert = _editRequiresMedicalCert;
        existing.AllowHalfDay = _editAllowHalfDay;
        existing.SortOrder = _editSortOrder;
        existing.IsActive = _editIsActive;
        await context.SaveChangesAsync();

        Snackbar.Add("บันทึกประเภทการลาเรียบร้อย", Severity.Success);
        _editingId = null;
        await LoadAsync();
    }

    private async Task AddTypeAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_newCode) || string.IsNullOrWhiteSpace(_newNameTh) || string.IsNullOrWhiteSpace(_newNameEn))
        {
            _error = "กรุณากรอกรหัสและชื่อให้ครบ";
            return;
        }

        var code = _newCode.Trim();
        await using var context = await DbFactory.CreateDbContextAsync();
        if (await context.Lve_LeaveTypes.AnyAsync(t => t.Code == code))
        {
            _error = $"มีรหัส '{code}' อยู่แล้ว";
            return;
        }

        var nextSortOrder = (await context.Lve_LeaveTypes.MaxAsync(t => (int?)t.SortOrder) ?? 0) + 1;
        context.Lve_LeaveTypes.Add(new Lve_LeaveType
        {
            Code = code,
            NameTh = _newNameTh,
            NameEn = _newNameEn,
            IsStatutory = false,
            ApplicableCountryCode = _newApplicableCountryCode,
            RequiresMedicalCert = _newRequiresMedicalCert,
            AllowHalfDay = _newAllowHalfDay,
            SortOrder = nextSortOrder,
            IsActive = true,
        });
        await context.SaveChangesAsync();

        Snackbar.Add("เพิ่มประเภทการลาใหม่เรียบร้อย", Severity.Success);
        _newCode = null;
        _newNameTh = null;
        _newNameEn = null;
        _newApplicableCountryCode = null;
        _newRequiresMedicalCert = false;
        _newAllowHalfDay = true;
        await LoadAsync();
    }
}
