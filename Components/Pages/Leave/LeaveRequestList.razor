@page "/leave-requests"
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Ess
@using HRM.Services.Leave
@using HRM.Services.Pay
@using HRM.Services.Workflow
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject WorkflowEngineService Engine
@inject LeaveBalanceService LeaveBalanceSvc
@inject LeaveRequestService LeaveRequestSvc
@inject PrivateFileStorage FileStorage
@inject AuthenticationStateProvider AuthProvider
@attribute [Authorize(Policy = "Menu:LEAVE_ACCESS")]

<PageTitle>คำขอลางาน</PageTitle>

@if (!_isInitialized)
{
    <MudPaper Class="pa-4 mb-4"><MudProgressCircular Indeterminate="true" Size="Size.Small" /></MudPaper>
}
else if (!_isAdmin && _selectedEmployee is null)
{
    <MudPaper Class="pa-4 mb-4">
        <MudAlert Severity="Severity.Error">บัญชีของคุณยังไม่ได้ผูกกับข้อมูลพนักงาน — ติดต่อแอดมิน</MudAlert>
    </MudPaper>
}
else
{
<MudPaper Class="pa-4 mb-4">
    <MudText Typo="Typo.h5">คำขอลางาน</MudText>
    <MudText Typo="Typo.body2" Class="mb-3" Color="Color.Secondary">
        @(_isAdmin
            ? "ยื่นคำขอลาแทนพนักงาน → หัวหน้าอนุมัติตามผังองค์กร → ฝ่ายบุคคลอนุมัติ — วิ่งผ่าน Workflow Approval Engine เดียวกับคำขอ OT"
            : "ยื่นคำขอลาของคุณเอง → หัวหน้าอนุมัติตามผังองค์กร → ฝ่ายบุคคลอนุมัติ")
    </MudText>

    @if (!string.IsNullOrEmpty(_error))
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
    }
    @if (!string.IsNullOrEmpty(_info))
    {
        <MudAlert Severity="Severity.Success" Class="mb-3">@_info</MudAlert>
    }

    <MudTable Items="_requests" Dense="true" Hover="true">
        <HeaderContent>
            <MudTh>#</MudTh>
            @if (_isAdmin)
            {
                <MudTh>พนักงาน</MudTh>
            }
            <MudTh>ประเภทการลา</MudTh>
            <MudTh>วันที่ลา</MudTh>
            <MudTh>จำนวนวัน</MudTh>
            <MudTh>สถานะ</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Request.Id</MudTd>
            @if (_isAdmin)
            {
                <MudTd>@context.EmployeeName</MudTd>
            }
            <MudTd>@LeaveRequestService.LeaveTypeLabel(context.Request.LeaveType)@(context.Request.IsHalfDay ? " (ครึ่งวัน)" : "")</MudTd>
            <MudTd>@context.Request.StartDate.ToString("dd/MM/yyyy") - @context.Request.EndDate.ToString("dd/MM/yyyy")</MudTd>
            <MudTd>@context.Request.TotalDays.ToString("0.#")</MudTd>
            <MudTd>
                @if (context.Request.JobMasterId is null)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Default">ร่าง (ยังไม่ส่ง)</MudChip>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.JobStatus)">@context.JobStatus</MudChip>
                }
            </MudTd>
            <MudTd>
                <MudStack Row="true" Spacing="1">
                    <MudButton Size="Size.Small" Variant="Variant.Text" Href="@($"/leave-requests/detail/{context.Request.Id}")">ดูรายละเอียด</MudButton>
                    @if (context.Request.JobMasterId is null)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => SubmitAsync(context.Request.Id))">ส่งขออนุมัติ</MudButton>
                    }
                </MudStack>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2">ยังไม่มีคำขอลางาน</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

<MudPaper Class="pa-4 mb-4">
    <MudText Typo="Typo.h6">ยื่นคำขอลาใหม่</MudText>
    <MudGrid Class="mt-1">
        <MudItem xs="12" sm="6">
            @if (_isAdmin)
            {
                <MudAutocomplete T="Hremployee" Label="พนักงาน" Value="_selectedEmployee" ValueChanged="OnEmployeeChangedAsync"
                    SearchFunc="SearchEmployeesAsync" ToStringFunc="@(e => e is null ? "" : $"{e.EmpNo} - {e.EmpName} {e.EmpSurname}")" ResetValueOnEmptyText="true" />
            }
            else
            {
                <MudTextField T="string" Label="พนักงาน" Value="@($"{_selectedEmployee!.EmpNo} - {_selectedEmployee.EmpName} {_selectedEmployee.EmpSurname}")" ReadOnly="true" />
            }
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudSelect T="LeaveType" @bind-Value="_leaveType" @bind-Value:after="RecomputeBalanceAsync" Label="ประเภทการลา">
                <MudSelectItem T="LeaveType" Value="LeaveType.Sick">ลาป่วย</MudSelectItem>
                <MudSelectItem T="LeaveType" Value="LeaveType.Personal">ลากิจ</MudSelectItem>
                <MudSelectItem T="LeaveType" Value="LeaveType.Vacation">ลาพักร้อน</MudSelectItem>
                <MudSelectItem T="LeaveType" Value="LeaveType.Maternity">ลาคลอด</MudSelectItem>
                @if (LeaveCountryHelper.IsApplicable(LeaveType.Ordination, _selectedEmployeeCountryCode))
                {
                    <MudSelectItem T="LeaveType" Value="LeaveType.Ordination">ลาบวช</MudSelectItem>
                }
                <MudSelectItem T="LeaveType" Value="LeaveType.Other">อื่นๆ</MudSelectItem>
            </MudSelect>
        </MudItem>
        @if (_selectedEmployee is not null)
        {
            <MudItem xs="12">
                @if (_remainingBalance is decimal remaining)
                {
                    <MudAlert Severity="@(remaining > 0 ? Severity.Info : Severity.Warning)" Dense="true">
                        สิทธิ@(LeaveRequestService.LeaveTypeLabel(_leaveType))คงเหลือปีนี้: @remaining.ToString("0.#") วัน
                        @if (_carriedOverDays is decimal carried && carried > 0)
                        {
                            <text> (รวมทบจากปีก่อน @carried.ToString("0.#") วัน)</text>
                        }
                    </MudAlert>
                }
                else
                {
                    <MudAlert Severity="Severity.Warning" Dense="true">ยังไม่ได้ตั้งค่าสิทธิ@(LeaveRequestService.LeaveTypeLabel(_leaveType))สำหรับบริษัทนี้ — ไปตั้งค่าที่หน้า <MudLink Href="/leave-requests/policy">สิทธิการลา</MudLink></MudAlert>
                }
            </MudItem>
        }
        <MudItem xs="12" sm="6"><MudDatePicker Label="วันที่เริ่มลา" @bind-Date="_startDate" Editable="true" DateFormat="dd/MM/yyyy" /></MudItem>
        <MudItem xs="12" sm="6"><MudDatePicker Label="วันที่สิ้นสุด" @bind-Date="_endDate" Editable="true" DateFormat="dd/MM/yyyy" Disabled="_isHalfDay" /></MudItem>
        @if (_startDate is not null && _endDate is not null && _startDate.Value.Date == _endDate.Value.Date)
        {
            <MudItem xs="12" sm="@(_isHalfDay ? 6 : 12)">
                <MudCheckBox T="bool" @bind-Value="_isHalfDay" Label="ลาครึ่งวัน" />
            </MudItem>
            @if (_isHalfDay)
            {
                <MudItem xs="12" sm="6">
                    <MudSelect T="HalfDayPeriod" @bind-Value="_halfDayPeriod" Label="ช่วงเวลา">
                        <MudSelectItem T="HalfDayPeriod" Value="HalfDayPeriod.Morning">ช่วงเช้า</MudSelectItem>
                        <MudSelectItem T="HalfDayPeriod" Value="HalfDayPeriod.Afternoon">ช่วงบ่าย</MudSelectItem>
                    </MudSelect>
                </MudItem>
            }
        }
        <MudItem xs="12"><MudTextField @bind-Value="_reason" Label="เหตุผล" Lines="2" /></MudItem>
        @if (_leaveType == LeaveType.Sick)
        {
            <MudItem xs="12">
                <MudText Typo="Typo.body2" Class="mb-1">แนบใบรับรองแพทย์ (ไม่บังคับ)</MudText>
                <InputFile OnChange="OnMedCertSelectedAsync" />
                @if (_pendingMedCertName is not null)
                {
                    <MudText Typo="Typo.caption" Color="Color.Success">เลือกไฟล์แล้ว: @_pendingMedCertName</MudText>
                }
            </MudItem>
        }
        <MudItem xs="12">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateRequestAsync">บันทึกคำขอ (ร่าง)</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>
}

@code {
    private record RequestRow(Lve_LeaveRequest Request, string EmployeeName, string JobStatus);

    private List<RequestRow> _requests = new();
    private string? _error;
    private string? _info;

    private long _actorUserId;
    private bool _isAdmin;

    private Hremployee? _selectedEmployee;
    private string? _selectedEmployeeCountryCode;
    private LeaveType _leaveType = LeaveType.Sick;
    private DateTime? _startDate = DateTime.Today;
    private DateTime? _endDate = DateTime.Today;
    private bool _isHalfDay;
    private HalfDayPeriod _halfDayPeriod = HalfDayPeriod.Morning;
    private string? _reason;
    private decimal? _remainingBalance;
    private decimal? _carriedOverDays;

    private IBrowserFile? _pendingMedCertFile;
    private string? _pendingMedCertName;

    // Blazor Server renders once immediately if OnInitializedAsync doesn't
    // complete synchronously (it never does here — the first await always
    // yields), using field defaults at that point. Without this flag, that
    // transient render sees _isAdmin=false/_selectedEmployee=null (both
    // defaults) and would otherwise hit the non-admin form branch before
    // _selectedEmployee is actually resolved, dereferencing null.
    private bool _isInitialized;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _actorUserId = long.Parse(state.User.FindFirst("sc_userid")?.Value ?? "0");
        _isAdmin = state.User.HasClaim("menu", "WF_WORKFLOW_ADMIN");

        if (!_isAdmin)
        {
            await using var context = await DbFactory.CreateDbContextAsync();
            var self = await EssEmployeeResolver.ResolveAsync(context, state.User);
            if (self is not null)
                await OnEmployeeChangedAsync(self);
        }

        await RefreshAsync();
        _isInitialized = true;
    }

    private async Task RefreshAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var query = context.Lve_LeaveRequests.AsQueryable();
        if (!_isAdmin && _selectedEmployee is not null)
            query = query.Where(r => r.HremployeeId == _selectedEmployee.id);
        var requests = await query.OrderByDescending(r => r.Id).ToListAsync();

        var empIds = requests.Select(r => r.HremployeeId).Distinct().ToList();
        var employees = await context.Hremployee.Where(e => empIds.Contains(e.id))
            .ToDictionaryAsync(e => e.id, e => $"{e.EmpName} {e.EmpSurname} ({e.EmpNo})");

        var jobIds = requests.Where(r => r.JobMasterId is not null).Select(r => r.JobMasterId!.Value).ToList();
        var jobStatuses = await context.job_masters.Where(j => jobIds.Contains(j.jobmasterid))
            .ToDictionaryAsync(j => j.jobmasterid, j => j.status);

        _requests = requests.Select(r => new RequestRow(
            r,
            employees.TryGetValue(r.HremployeeId, out var name) ? name : r.EmpNo,
            r.JobMasterId is not null && jobStatuses.TryGetValue(r.JobMasterId.Value, out var s) ? s : "-")).ToList();
    }

    private static Color StatusColor(string status) => status switch
    {
        "COMPLETED" => Color.Success,
        "REJECTED" or "RETURNED" => Color.Error,
        _ => Color.Warning,
    };

    private async Task OnEmployeeChangedAsync(Hremployee? employee)
    {
        _selectedEmployee = employee;

        if (employee is not null)
        {
            await using var context = await DbFactory.CreateDbContextAsync();
            _selectedEmployeeCountryCode = (await context.Lve_CompanySettings
                .FirstOrDefaultAsync(s => s.CompanyId == employee.companyid))?.CountryCode;

            if (_leaveType == LeaveType.Ordination && !LeaveCountryHelper.IsApplicable(LeaveType.Ordination, _selectedEmployeeCountryCode))
            {
                _leaveType = LeaveType.Other;
            }
        }
        else
        {
            _selectedEmployeeCountryCode = null;
        }

        await RecomputeBalanceAsync();
    }

    private async Task RecomputeBalanceAsync()
    {
        if (_selectedEmployee is null)
        {
            _remainingBalance = null;
            _carriedOverDays = null;
            return;
        }

        var balances = await LeaveBalanceSvc.GetBalancesAsync(_selectedEmployee.id, _selectedEmployee.companyid, _leaveType);
        _remainingBalance = balances.Count > 0 ? balances[0].RemainingDays : (decimal?)null;
        _carriedOverDays = balances.Count > 0 ? balances[0].CarriedOverDays : (decimal?)null;
    }

    private async Task<IEnumerable<Hremployee>> SearchEmployeesAsync(string term, CancellationToken ct)
    {
        await using var context = await DbFactory.CreateDbContextAsync(ct);
        var query = context.Hremployee.AsQueryable();
        if (!string.IsNullOrWhiteSpace(term))
            query = query.Where(e => e.EmpNo.Contains(term) || (e.EmpName != null && e.EmpName.Contains(term)) || (e.EmpSurname != null && e.EmpSurname.Contains(term)));
        return await query.OrderBy(e => e.EmpNo).Take(20).ToListAsync(ct);
    }

    private void OnMedCertSelectedAsync(InputFileChangeEventArgs e)
    {
        _pendingMedCertFile = e.File;
        _pendingMedCertName = e.File.Name;
    }

    private async Task CreateRequestAsync()
    {
        _error = null;
        _info = null;
        if (_selectedEmployee is null || _startDate is null || _endDate is null)
        {
            _error = "กรุณาเลือกพนักงานและระบุวันที่ให้ครบ";
            return;
        }

        // Defense in depth — the UI already locks non-admins to themselves,
        // but never trust that alone for a write.
        if (!_isAdmin)
        {
            var state = await AuthProvider.GetAuthenticationStateAsync();
            await using var checkContext = await DbFactory.CreateDbContextAsync();
            var self = await EssEmployeeResolver.ResolveAsync(checkContext, state.User);
            if (self is null || self.id != _selectedEmployee.id)
            {
                _error = "ยื่นคำขอลาได้เฉพาะของตัวเองเท่านั้น";
                return;
            }
        }

        try
        {
            var start = DateOnly.FromDateTime(_startDate.Value);
            var end = DateOnly.FromDateTime(_endDate.Value);
            var requestId = await LeaveRequestSvc.CreateDraftAsync(_selectedEmployee.id, _leaveType, start, end,
                _isHalfDay, _isHalfDay ? _halfDayPeriod : null, _reason);

            if (_pendingMedCertFile is not null)
            {
                const long maxSize = 10 * 1024 * 1024;
                await using var stream = _pendingMedCertFile.OpenReadStream(maxSize);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                var storedFileName = $"{requestId}_{Guid.NewGuid():N}_{_pendingMedCertFile.Name}";
                var (relativePath, _) = await FileStorage.SaveAsync("leave-medcerts", storedFileName, ms.ToArray());
                await LeaveRequestSvc.AttachMedCertAsync(requestId, _pendingMedCertFile.Name, relativePath);
            }

            _info = "บันทึกคำขอลาสำเร็จ (ยังเป็นร่าง กด \"ส่งขออนุมัติ\" เพื่อเข้าสู่ workflow)";
            var keepEmployee = _isAdmin ? null : _selectedEmployee;
            _reason = null;
            _remainingBalance = null;
            _isHalfDay = false;
            _pendingMedCertFile = null;
            _pendingMedCertName = null;
            await OnEmployeeChangedAsync(keepEmployee);
            await RefreshAsync();
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
    }

    private async Task SubmitAsync(long requestId)
    {
        _error = null;
        _info = null;
        try
        {
            var state = await AuthProvider.GetAuthenticationStateAsync();
            var actorEmpNo = state.User.FindFirstValue("empno");
            var jobId = await LeaveRequestSvc.SubmitAsync(requestId, _actorUserId, actorEmpNo);
            _info = $"ส่งขออนุมัติสำเร็จ (Job #{jobId})";
            await RefreshAsync();
        }
        catch (InvalidOperationException ex)
        {
            _error = "ส่งขออนุมัติไม่สำเร็จ: " + ex.Message;
        }
    }
}
