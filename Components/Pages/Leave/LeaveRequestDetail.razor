@page "/leave-requests/detail/{Id:long}"
@using HRM.Models
@using HRM.Services.Ess
@using HRM.Services.Leave
@using HRM.Services.Workflow
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject LeaveRequestService LeaveRequestSvc
@inject NavigationManager NavigationManager
@attribute [Authorize(Policy = "Menu:LEAVE_ACCESS")]

<PageTitle>รายละเอียดคำขอลางาน</PageTitle>

<MudPaper Class="pa-4 mb-4">
    @if (_notFound)
    {
        <MudAlert Severity="Severity.Error">ไม่พบคำขอลางานรายการนี้</MudAlert>
    }
    else if (_request is not null)
    {
        <MudText Typo="Typo.h5" Class="mb-2">คำขอลางาน #@_request.Id</MudText>

        <MudGrid Class="mt-1">
            <MudItem xs="12" sm="6"><MudTextField Value="@_employeeName" Label="พนักงานผู้ขอ" ReadOnly="true" /></MudItem>
            <MudItem xs="12" sm="6"><MudTextField Value="@(_request.Lve_LeaveType.NameTh + (_request.IsHalfDay ? " (ครึ่งวัน)" : ""))" Label="ประเภทการลา" ReadOnly="true" /></MudItem>
            <MudItem xs="12" sm="4"><MudTextField Value="@_request.RequestedDate.ToString("dd/MM/yyyy HH:mm")" Label="วันที่ยื่นคำขอ" ReadOnly="true" /></MudItem>
            <MudItem xs="12" sm="4"><MudTextField Value="@_request.StartDate.ToString("dd/MM/yyyy")" Label="เริ่มลา" ReadOnly="true" /></MudItem>
            <MudItem xs="12" sm="4"><MudTextField Value="@_request.EndDate.ToString("dd/MM/yyyy")" Label="สิ้นสุดลา" ReadOnly="true" /></MudItem>
            <MudItem xs="12" sm="4"><MudTextField Value="@_request.TotalDays.ToString("0.#")" Label="จำนวนวัน" ReadOnly="true" /></MudItem>
            @if (!string.IsNullOrWhiteSpace(_request.Reason))
            {
                <MudItem xs="12"><MudTextField Value="@_request.Reason" Label="เหตุผล" ReadOnly="true" Lines="2" /></MudItem>
            }
            @if (_request.MedCertDocCenterId is not null)
            {
                <MudItem xs="12">
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AttachFile"
                        Href="@($"/leave-requests/files/medcert/{_request.MedCertDocCenterId}")" Target="_blank">ดาวน์โหลดใบรับรองแพทย์</MudButton>
                </MudItem>
            }
        </MudGrid>

        <MudDivider Class="my-4" />

        @if (_job is not null)
        {
            <MudText Typo="Typo.h6" Class="mb-2">สถานะการอนุมัติ</MudText>
            <MudText Typo="Typo.body1" Class="mb-2">
                สถานะ: <b>@_job.status</b> | ระดับปัจจุบัน: @_job.lastLevel / @_job.maxlevel
                @(_job.isJobClosed == true ? " (ปิดงานแล้ว)" : "")
            </MudText>
            <MudTable Items="_job.job_user_lists" Dense="true">
                <HeaderContent>
                    <MudTh>ระดับ</MudTh>
                    <MudTh>ผู้อนุมัติ (userid)</MudTh>
                    <MudTh>สถานะ</MudTh>
                    <MudTh>วันที่</MudTh>
                    <MudTh>ความเห็น</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.wlevel</MudTd>
                    <MudTd>@context.userid</MudTd>
                    <MudTd>@context.jobstatus</MudTd>
                    <MudTd>@context.approvedate?.ToString("dd/MM/yyyy HH:mm")</MudTd>
                    <MudTd>@context.comment</MudTd>
                </RowTemplate>
            </MudTable>

            @if (_isAdmin && !_isPaidLeaveType && _request.AdhocPayItemId is null && _job.isJobClosed == true && _job.status == WorkflowEngineService.StatusCompleted)
            {
                <MudButton Class="mt-3" Variant="Variant.Filled" Color="Color.Warning" OnClick="PushToPayrollAsync">ผลักเข้าระบบเงินเดือน (หักเงินลาไม่รับค่าจ้าง)</MudButton>
            }
            @if (_request.AdhocPayItemId is not null)
            {
                <MudChip T="string" Class="mt-3" Color="Color.Success">ผลักเข้าระบบเงินเดือนแล้ว (รายการ #@_request.AdhocPayItemId)</MudChip>
            }
            @if (_job.isJobClosed != true)
            {
                <MudButton Class="mt-3" Variant="Variant.Text" Color="Color.Error" OnClick="CancelAsync">ยกเลิกคำขอ</MudButton>
            }
        }
        else
        {
            <MudAlert Severity="Severity.Info">คำขอนี้ยังไม่ถูกส่งเข้าสู่กระบวนการอนุมัติ (ร่าง)</MudAlert>
            <MudButton Class="mt-3" Variant="Variant.Text" Color="Color.Error" OnClick="CancelAsync">ลบร่าง</MudButton>
        }

        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
        }
        @if (!string.IsNullOrEmpty(_info))
        {
            <MudAlert Severity="Severity.Success" Class="mt-3">@_info</MudAlert>
        }

        <MudButton Class="mt-4" Variant="Variant.Text" Href="@BackHref">กลับไปหน้ารายการคำขอลางาน</MudButton>
    }
</MudPaper>

@code {
    [Parameter] public long Id { get; set; }
    [SupplyParameterFromQuery] public string? From { get; set; }

    // Reached either from the ESS self-service list or the HR on-behalf
    // list (LeaveRequestForm.razor tags its links with ?from=proxy) —
    // send the user back to whichever one they came from.
    private string BackHref => From == "proxy" ? "/leave-requests/on-behalf" : "/leave-requests";

    private Lve_LeaveRequest? _request;
    private job_master? _job;
    private string _employeeName = "";
    private bool _notFound;
    private bool _isAdmin;
    private bool _isPaidLeaveType = true;
    private long _actorUserId;
    private string? _error;
    private string? _info;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _actorUserId = long.TryParse(state.User.FindFirst("sc_userid")?.Value, out var uid) ? uid : 0;
        _isAdmin = state.User.HasClaim("menu", "WF_WORKFLOW_ADMIN");

        await using var context = await DbFactory.CreateDbContextAsync();
        _request = await context.Lve_LeaveRequests.Include(r => r.Lve_LeaveType).FirstOrDefaultAsync(r => r.Id == Id);
        if (_request is null)
        {
            _notFound = true;
            return;
        }

        if (!_isAdmin)
        {
            var self = await EssEmployeeResolver.ResolveAsync(context, state.User);
            if (self is null || self.id != _request.HremployeeId)
            {
                _notFound = true;
                _request = null;
                return;
            }
        }

        var emp = await context.Hremployee.FirstOrDefaultAsync(e => e.id == _request.HremployeeId);
        _employeeName = emp is null ? _request.EmpNo : $"{emp.EmpName} {emp.EmpSurname} ({emp.EmpNo})";

        var policy = await context.Lve_LeavePolicies.FirstOrDefaultAsync(p => p.CompanyId == _request.CompanyId && p.LeaveTypeId == _request.LeaveTypeId);
        _isPaidLeaveType = policy is null || policy.IsPaid;

        if (_request.JobMasterId is not null)
        {
            _job = await context.job_masters
                .Include(j => j.job_user_lists.OrderBy(a => a.wlevel).ThenBy(a => a.jobapproverid))
                .FirstOrDefaultAsync(j => j.jobmasterid == _request.JobMasterId);
        }
    }

    private async Task PushToPayrollAsync()
    {
        _error = null;
        _info = null;
        try
        {
            var itemId = await LeaveRequestSvc.PushUnpaidToPayrollAsync(Id, _actorUserId);
            _info = $"ผลักเข้าระบบเงินเดือนสำเร็จ (รายการ #{itemId})";
            await using var context = await DbFactory.CreateDbContextAsync();
            _request = await context.Lve_LeaveRequests.FirstOrDefaultAsync(r => r.Id == Id);
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
    }

    private async Task CancelAsync()
    {
        _error = null;
        try
        {
            var wasDraft = _request!.JobMasterId is null;
            await LeaveRequestSvc.CancelAsync(Id, _actorUserId, _isAdmin, reason: null);
            if (wasDraft)
            {
                NavigationManager.NavigateTo(BackHref);
                return;
            }

            await using var context = await DbFactory.CreateDbContextAsync();
            _job = await context.job_masters
                .Include(j => j.job_user_lists.OrderBy(a => a.wlevel).ThenBy(a => a.jobapproverid))
                .FirstOrDefaultAsync(j => j.jobmasterid == _request.JobMasterId);
            _info = "ยกเลิกคำขอลาเรียบร้อย";
        }
        catch (InvalidOperationException ex)
        {
            _error = "ยกเลิกไม่สำเร็จ: " + ex.Message;
        }
    }
}
