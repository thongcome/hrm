@page "/talent/pool"
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Talent
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject TalentGridService GridService
@inject RetentionRiskService RiskService
@inject ISnackbar Snackbar
@attribute [Authorize(Policy = "Menu:TALENT_ADMIN")]

<PageTitle>Talent Pool</PageTitle>

@if (string.IsNullOrEmpty(_companyId))
{
    <MudAlert Severity="Severity.Error" Class="ma-4">บัญชีของคุณยังไม่ได้ผูกกับบริษัทใดๆ</MudAlert>
}
else
{
    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h5">Talent Pool</MudText>
        <MudText Typo="Typo.body2" Class="mt-1 mb-3">
            รายชื่อพนักงานที่ HR เลือกเข้า Talent Pool ด้วยตนเอง — ไม่มีการเพิ่มอัตโนมัติจาก 9-Box Grid
        </MudText>

        <MudGrid>
            <MudItem xs="12" sm="5">
                <MudAutocomplete T="Hremployee" Label="ค้นหาพนักงาน" @bind-Value="_selectedEmployee"
                    SearchFunc="SearchEmployeesAsync"
                    ToStringFunc="@(e => e == null ? null : $"{e.EmpNo} — {e.EmpName} {e.EmpSurname}")"
                    ResetValueOnEmptyText="true" CoerceText="true" MinCharacters="0" />
            </MudItem>
            <MudItem xs="12" sm="5">
                <MudTextField T="string" @bind-Value="_reason" Label="เหตุผล (ถ้ามี)" />
            </MudItem>
            <MudItem xs="12" sm="2" Class="d-flex align-center">
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="AddAsync" Disabled="@(_selectedEmployee is null)">
                    เพิ่มเข้า Pool
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4">
        <MudTable Items="_entries" Dense="true" Hover="true">
            <HeaderContent>
                <MudTh>พนักงาน</MudTh>
                <MudTh>วันที่เพิ่ม</MudTh>
                <MudTh>เหตุผล</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@EmployeeName(context.HremployeeId)</MudTd>
                <MudTd>@context.AddedDate.ToString("dd/MM/yyyy")</MudTd>
                <MudTd>@(context.Reason ?? "-")</MudTd>
                <MudTd><MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Text" OnClick="@(() => RemoveAsync(context.Id))">ถอดออก</MudButton></MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText Typo="Typo.body2">ยังไม่มีพนักงานใน Talent Pool</MudText></NoRecordsContent>
        </MudTable>
    </MudPaper>

    @if (_riskRows.Count > 0)
    {
        <MudPaper Class="pa-4 mb-4">
            <MudText Typo="Typo.h5">ความเสี่ยงการลาออก (Retention Risk)</MudText>
            <MudText Typo="Typo.body2" Class="mt-1 mb-3">
                คะแนนบวกสะสมจากสัญญาณที่ตั้งค่าไว้ (ดู/ปรับเกณฑ์ที่หน้า <MudLink Href="/talent/settings">ตั้งค่า</MudLink>) —
                แสดงพร้อมเหตุผลเสมอ ใช้เป็นจุดเริ่มบทสนทนา ไม่ใช่คำตัดสิน
            </MudText>
            <MudTable Items="_riskRows" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh>พนักงาน</MudTh>
                    <MudTh>คะแนน</MudTh>
                    <MudTh>เหตุผล</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.EmployeeName (@context.EmpNo)</MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small" Color="@(context.IsHighRisk ? Color.Error : Color.Warning)">
                            @context.Score @(context.IsHighRisk ? "— เสี่ยงสูง" : "")
                        </MudChip>
                    </MudTd>
                    <MudTd>@string.Join(" · ", context.Reasons)</MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    }
}

@code {
    private string? _companyId;
    private List<Talent_PoolEntry> _entries = new();
    private List<RetentionRiskService.RiskRow> _riskRows = new();
    private Dictionary<long, string> _employeeNames = new();
    private Hremployee? _selectedEmployee;
    private string? _reason;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
        if (string.IsNullOrWhiteSpace(_companyId)) return;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (string.IsNullOrEmpty(_companyId)) return;

        _entries = await GridService.GetPoolEntriesAsync(_companyId);
        _riskRows = await RiskService.ComputeAsync(_companyId); // empty unless the company opted in

        await using var context = await DbFactory.CreateDbContextAsync();
        var employeeIds = _entries.Select(e => e.HremployeeId).ToList();
        var names = await context.Hremployee.Where(e => employeeIds.Contains(e.id))
            .Select(e => new { e.id, e.EmpNo, e.EmpName, e.EmpSurname }).ToListAsync();
        _employeeNames = names.ToDictionary(e => e.id, e => $"{e.EmpName} {e.EmpSurname} ({e.EmpNo})");
    }

    private string EmployeeName(long hremployeeId) => _employeeNames.TryGetValue(hremployeeId, out var n) ? n : $"#{hremployeeId}";

    private async Task<IEnumerable<Hremployee>> SearchEmployeesAsync(string search, CancellationToken ct)
    {
        await using var context = await DbFactory.CreateDbContextAsync(ct);
        // Same semantics as EmployeeStatusHelper.CanTransact, inlined so it
        // stays SQL-translatable ahead of Take(20) — a raw ResignDate==null
        // here silently hid notice-period employees who are still working
        // (the recurring bug this codebase already fixed in OrgEmployee
        // ResolverHelper and BlockLeaveComplianceService).
        var today = DateTime.Today;
        var query = context.Hremployee.Where(e => e.companyid == _companyId && e.IsActive
            && (e.ResignDate == null || e.ResignDate >= today));
        if (!string.IsNullOrWhiteSpace(search))
        {
            query = query.Where(e => e.EmpNo.Contains(search)
                || (e.EmpName != null && e.EmpName.Contains(search))
                || (e.EmpSurname != null && e.EmpSurname.Contains(search)));
        }
        return await query.OrderBy(e => e.EmpNo).Take(20).ToListAsync(ct);
    }

    private async Task AddAsync()
    {
        if (_selectedEmployee is null) return;

        var state = await AuthProvider.GetAuthenticationStateAsync();
        var userId = long.TryParse(state.User.FindFirstValue("sc_userid"), out var uid) ? uid : 0;

        await GridService.AddToPoolAsync(_selectedEmployee.id, userId, _reason);
        Snackbar.Add("เพิ่มเข้า Talent Pool เรียบร้อย", Severity.Success);
        _selectedEmployee = null;
        _reason = null;
        await LoadAsync();
    }

    private async Task RemoveAsync(long entryId)
    {
        await GridService.RemoveFromPoolAsync(entryId);
        Snackbar.Add("ถอดออกจาก Talent Pool แล้ว", Severity.Success);
        await LoadAsync();
    }
}
