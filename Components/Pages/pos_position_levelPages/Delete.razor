@page "/pos_position_levels/delete"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using HRM.Models
@inject IDbContextFactory<HRM.Models.HRMContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>pos_position_level</h2>
    <hr />
    @if (pos_position_level is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">name</dt>
            <dd class="col-sm-10">@pos_position_level.name</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">pol_note</dt>
            <dd class="col-sm-10">@pos_position_level.pol_note</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">update_by</dt>
            <dd class="col-sm-10">@pos_position_level.update_by</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">update_date</dt>
            <dd class="col-sm-10">@pos_position_level.update_date</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">code</dt>
            <dd class="col-sm-10">@pos_position_level.code</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">engname</dt>
            <dd class="col-sm-10">@pos_position_level.engname</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">plevel</dt>
            <dd class="col-sm-10">@pos_position_level.plevel</dd>
        </dl>
        <EditForm method="post" Model="pos_position_level" OnValidSubmit="Deletepos_position_level" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(pos_position_level is null)">Delete</button> |
            <a href="/pos_position_levels">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private pos_position_level? pos_position_level;

    [SupplyParameterFromQuery]
    private int id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        pos_position_level = await context.pos_position_levels.FirstOrDefaultAsync(m => m.id == id);

        if (pos_position_level is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task Deletepos_position_level()
    {
        using var context = DbFactory.CreateDbContext();
        context.pos_position_levels.Remove(pos_position_level!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/pos_position_levels");
    }
}
