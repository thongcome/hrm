    @page "/"

@code {
    private bool isAuthenticated = false;
    private bool _loadedPublic;
    private List<info_message> _publicAnnouncements = new();
    private Dictionary<long, List<doc_center>> _attachmentsByMessage = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        // Check if the user and their identity is not null
        if (user != null && user.Identity != null)
        {
            isAuthenticated = user.Identity.IsAuthenticated;
        }

        if (!isAuthenticated)
        {
            _publicAnnouncements = await InfoService.GetPublicAnonymousAnnouncementsAsync();
            foreach (var m in _publicAnnouncements)
            {
                var files = await InfoService.GetAttachmentsAsync(m.Id);
                if (files.Count > 0) _attachmentsByMessage[m.Id] = files;
            }
            _loadedPublic = true;
        }
    }
}

