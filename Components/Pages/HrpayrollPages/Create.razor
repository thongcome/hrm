@page "/hrpayrolls/create"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using HRM.Models
@inject IDbContextFactory<HRM.Models.HRMContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>Hrpayroll</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Hrpayroll" OnValidSubmit="AddHrpayroll" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert"/>
            <div class="mb-3">
                <label for="companyid" class="form-label">companyid:</label> 
                <InputText id="companyid" @bind-Value="Hrpayroll.companyid" class="form-control" /> 
                <ValidationMessage For="() => Hrpayroll.companyid" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="payrollslipno" class="form-label">PayrollslipNo:</label> 
                <InputText id="payrollslipno" @bind-Value="Hrpayroll.PayrollslipNo" class="form-control" /> 
                <ValidationMessage For="() => Hrpayroll.PayrollslipNo" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="empno" class="form-label">EmpNo:</label> 
                <InputText id="empno" @bind-Value="Hrpayroll.EmpNo" class="form-control" /> 
                <ValidationMessage For="() => Hrpayroll.EmpNo" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="payrolldate" class="form-label">PayrollDate:</label> 
                <InputDate id="payrolldate" @bind-Value="Hrpayroll.PayrollDate" class="form-control" /> 
                <ValidationMessage For="() => Hrpayroll.PayrollDate" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="payrollperiod" class="form-label">PayrollPeriod:</label> 
                <InputText id="payrollperiod" @bind-Value="Hrpayroll.PayrollPeriod" class="form-control" /> 
                <ValidationMessage For="() => Hrpayroll.PayrollPeriod" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="salarybaseamt" class="form-label">SalarybaseAmt:</label> 
                <InputNumber id="salarybaseamt" @bind-Value="Hrpayroll.SalarybaseAmt" class="form-control" /> 
                <ValidationMessage For="() => Hrpayroll.SalarybaseAmt" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="salaryothamt" class="form-label">SalaryothAmt:</label> 
                <InputNumber id="salaryothamt" @bind-Value="Hrpayroll.SalaryothAmt" class="form-control" /> 
                <ValidationMessage For="() => Hrpayroll.SalaryothAmt" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="salarysubtamt" class="form-label">SalarysubtAmt:</label> 
                <InputNumber id="salarysubtamt" @bind-Value="Hrpayroll.SalarysubtAmt" class="form-control" /> 
                <ValidationMessage For="() => Hrpayroll.SalarysubtAmt" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="salarynetamt" class="form-label">SalarynetAmt:</label> 
                <InputNumber id="salarynetamt" @bind-Value="Hrpayroll.SalarynetAmt" class="form-control" /> 
                <ValidationMessage For="() => Hrpayroll.SalarynetAmt" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="payrollstatus" class="form-label">PayrollStatus:</label> 
                <InputNumber id="payrollstatus" @bind-Value="Hrpayroll.PayrollStatus" class="form-control" /> 
                <ValidationMessage For="() => Hrpayroll.PayrollStatus" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="expensecode" class="form-label">ExpenseCode:</label> 
                <InputText id="expensecode" @bind-Value="Hrpayroll.ExpenseCode" class="form-control" /> 
                <ValidationMessage For="() => Hrpayroll.ExpenseCode" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="expensebank" class="form-label">ExpenseBank:</label> 
                <InputText id="expensebank" @bind-Value="Hrpayroll.ExpenseBank" class="form-control" /> 
                <ValidationMessage For="() => Hrpayroll.ExpenseBank" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="expensebranch" class="form-label">ExpenseBranch:</label> 
                <InputText id="expensebranch" @bind-Value="Hrpayroll.ExpenseBranch" class="form-control" /> 
                <ValidationMessage For="() => Hrpayroll.ExpenseBranch" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="expenseaccid" class="form-label">ExpenseAccid:</label> 
                <InputText id="expenseaccid" @bind-Value="Hrpayroll.ExpenseAccid" class="form-control" /> 
                <ValidationMessage For="() => Hrpayroll.ExpenseAccid" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="poststatus" class="form-label">PostStatus:</label> 
                <InputNumber id="poststatus" @bind-Value="Hrpayroll.PostStatus" class="form-control" /> 
                <ValidationMessage For="() => Hrpayroll.PostStatus" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="memberno" class="form-label">MemberNo:</label> 
                <InputText id="memberno" @bind-Value="Hrpayroll.MemberNo" class="form-control" /> 
                <ValidationMessage For="() => Hrpayroll.MemberNo" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="percensecurity" class="form-label">PercenSecurity:</label> 
                <InputNumber id="percensecurity" @bind-Value="Hrpayroll.PercenSecurity" class="form-control" /> 
                <ValidationMessage For="() => Hrpayroll.PercenSecurity" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="percenmgsecurity" class="form-label">PercenmgSecurity:</label> 
                <InputNumber id="percenmgsecurity" @bind-Value="Hrpayroll.PercenmgSecurity" class="form-control" /> 
                <ValidationMessage For="() => Hrpayroll.PercenmgSecurity" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="sofmgsecurity" class="form-label">SofmgSecurity:</label> 
                <InputNumber id="sofmgsecurity" @bind-Value="Hrpayroll.SofmgSecurity" class="form-control" /> 
                <ValidationMessage For="() => Hrpayroll.SofmgSecurity" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="postsofstatus" class="form-label">PostSofStatus:</label> 
                <InputCheckbox id="postsofstatus" @bind-Value="Hrpayroll.PostSofStatus" class="form-check-input" /> 
                <ValidationMessage For="() => Hrpayroll.PostSofStatus" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="poststastatus" class="form-label">PostStaStatus:</label> 
                <InputCheckbox id="poststastatus" @bind-Value="Hrpayroll.PostStaStatus" class="form-check-input" /> 
                <ValidationMessage For="() => Hrpayroll.PostStaStatus" class="text-danger" /> 
            </div>        
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/hrpayrolls">Back to List</a>
</div>

@code {
    [SupplyParameterFromForm]
    private Hrpayroll Hrpayroll { get; set; } = new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddHrpayroll()
    {
        using var context = DbFactory.CreateDbContext();
        context.Hrpayroll.Add(Hrpayroll);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/hrpayrolls");
    }
}
