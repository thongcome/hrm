@page "/wf_loa_users/create"
@using HRM.Models
@using HRM.Services.Workflow
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@attribute [Authorize(Policy = "Menu:WF_WORKFLOW_ADMIN")]
@inject IDbContextFactory<HRMContext> DbFactory
@inject NavigationManager NavigationManager

<h3>Create LOA User</h3>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}

<EditForm Model="loaUser" OnValidSubmit="Save">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <h5 class="mt-3">อ้างอิง</h5>
    <div class="mb-3">
        <label class="form-label">LOA Id (loaid)</label>
        <InputNumber @bind-Value="loaUser.loaid" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Workflow Id (workflowid)</label>
        <InputNumber @bind-Value="loaUser.workflowid" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Level (wlevel)</label>
        <InputNumber @bind-Value="loaUser.wlevel" class="form-control" />
    </div>

    <h5 class="mt-4">ผู้ใช้สิทธิ์อนุมัติ</h5>
    <div class="mb-3">
        <label class="form-label">User Id (userid)</label>
        <InputNumber @bind-Value="loaUser.userid" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">รหัสพนักงาน (empid)</label>
        <InputText @bind-Value="loaUser.empid" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">รหัสตำแหน่ง (poscode)</label>
        <InputText @bind-Value="loaUser.poscode" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">รหัสหน่วยงาน (orgcode)</label>
        <InputText @bind-Value="loaUser.orgcode" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Cost Center (costcenter)</label>
        <InputText @bind-Value="loaUser.costcenter" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">ระดับพนักงาน (emplevel)</label>
        <InputText @bind-Value="loaUser.emplevel" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">บทบาทในหน่วยงาน (orgrole)</label>
        <InputText @bind-Value="loaUser.orgrole" class="form-control" />
    </div>

    <h5 class="mt-4">ช่วงเวลาที่มีผล</h5>
    <div class="mb-3">
        <label class="form-label">วันที่เริ่ม (startdate)</label>
        <InputDate @bind-Value="loaUser.startdate" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">วันที่สิ้นสุด (enddate)</label>
        <InputDate @bind-Value="loaUser.enddate" class="form-control" />
    </div>
    <div class="mb-3 form-check">
        <input type="checkbox" class="form-check-input" @bind="loaUser.isactive" /> <label class="form-check-label">เปิดใช้งาน (isactive)</label>
    </div>

    <p class="text-muted small">หมายเหตุ: field <code>moddate</code> ระบบตั้งค่าอัตโนมัติตอนบันทึก ไม่ต้องกรอกเอง</p>

    <button class="btn btn-primary">Save</button>
    <a class="btn btn-secondary ms-2" href="/wf_loa_users">Cancel</a>
</EditForm>

@code {
    private wf_loa_user loaUser = new() { isactive = true };
    private string? _error;

    private async Task Save()
    {
        _error = null;
        try
        {
            loaUser.moddate = DateTime.Now;
            using var db = DbFactory.CreateDbContext();
            await WorkflowLockGuard.EnsureWorkflowEditableAsync(db, loaUser.workflowid);
            db.wf_loa_users.Add(loaUser);
            await db.SaveChangesAsync();
            NavigationManager.NavigateTo("/wf_loa_users");
        }
        catch (Exception ex)
        {
            _error = "บันทึกไม่สำเร็จ: " + ex.Message;
        }
    }
}
