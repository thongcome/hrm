@page "/wf_loa_users/details/{id:long}"
@using HRM.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@attribute [Authorize(Policy = "Menu:WF_WORKFLOW_ADMIN")]
@inject IDbContextFactory<HRMContext> DbFactory
@inject NavigationManager NavigationManager

@if (loaUser is null)
{
    <p><em>Not found</em></p>
}
else
{
    <h3>LOA User #@loaUser.id</h3>

    <h5 class="mt-3">อ้างอิง</h5>
    <dl class="row">
        <dt class="col-sm-3">LOA Id (loaid)</dt>
        <dd class="col-sm-9">@loaUser.loaid</dd>
        <dt class="col-sm-3">Workflow Id (workflowid)</dt>
        <dd class="col-sm-9">@loaUser.workflowid</dd>
        <dt class="col-sm-3">Level (wlevel)</dt>
        <dd class="col-sm-9">@loaUser.wlevel</dd>
    </dl>

    <h5 class="mt-4">ผู้ใช้สิทธิ์อนุมัติ</h5>
    <dl class="row">
        <dt class="col-sm-3">User Id (userid)</dt>
        <dd class="col-sm-9">@loaUser.userid</dd>
        <dt class="col-sm-3">รหัสพนักงาน (empid)</dt>
        <dd class="col-sm-9">@loaUser.empid</dd>
        <dt class="col-sm-3">รหัสตำแหน่ง (poscode)</dt>
        <dd class="col-sm-9">@loaUser.poscode</dd>
        <dt class="col-sm-3">รหัสหน่วยงาน (orgcode)</dt>
        <dd class="col-sm-9">@loaUser.orgcode</dd>
        <dt class="col-sm-3">Cost Center (costcenter)</dt>
        <dd class="col-sm-9">@loaUser.costcenter</dd>
        <dt class="col-sm-3">ระดับพนักงาน (emplevel)</dt>
        <dd class="col-sm-9">@loaUser.emplevel</dd>
        <dt class="col-sm-3">บทบาทในหน่วยงาน (orgrole)</dt>
        <dd class="col-sm-9">@loaUser.orgrole</dd>
    </dl>

    <h5 class="mt-4">ช่วงเวลาที่มีผล</h5>
    <dl class="row">
        <dt class="col-sm-3">วันที่เริ่ม (startdate)</dt>
        <dd class="col-sm-9">@loaUser.startdate</dd>
        <dt class="col-sm-3">วันที่สิ้นสุด (enddate)</dt>
        <dd class="col-sm-9">@loaUser.enddate</dd>
        <dt class="col-sm-3">เปิดใช้งาน (isactive)</dt>
        <dd class="col-sm-9">@(loaUser.isactive ? "Yes" : "No")</dd>
    </dl>

    <h5 class="mt-4">ระบบ</h5>
    <dl class="row">
        <dt class="col-sm-3">แก้ไขล่าสุด (moddate)</dt>
        <dd class="col-sm-9">@loaUser.moddate</dd>
        <dt class="col-sm-3">แก้ไขโดย (modby)</dt>
        <dd class="col-sm-9">@loaUser.modby</dd>
    </dl>

    <a class="btn btn-secondary" href="/wf_loa_users">Back</a>
    <a class="btn btn-info" href="/wf_loa_users/edit/@loaUser.id">Edit</a>
}

@code {
    [Parameter]
    public long id { get; set; }

    private wf_loa_user? loaUser;

    protected override async Task OnInitializedAsync()
    {
        using var db = DbFactory.CreateDbContext();
        loaUser = await db.wf_loa_users.FindAsync(id);
    }
}
