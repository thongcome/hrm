@page "/asset_owners/edit"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using HRM.Models
@inject IDbContextFactory<HRM.Models.HRMContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>asset_owner</h2>
<hr />
@if (asset_owner is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="asset_owner" OnValidSubmit="Updateasset_owner" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                <input type="hidden" name="asset_owner.id" value="@asset_owner.id" />
                <div class="mb-3">
                    <label for="location" class="form-label">location:</label>
                    <InputText id="location" @bind-Value="asset_owner.location" class="form-control" />
                    <ValidationMessage For="() => asset_owner.location" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="costcenter" class="form-label">costCenter:</label>
                    <InputText id="costcenter" @bind-Value="asset_owner.costCenter" class="form-control" />
                    <ValidationMessage For="() => asset_owner.costCenter" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="category" class="form-label">category:</label>
                    <InputText id="category" @bind-Value="asset_owner.category" class="form-control" />
                    <ValidationMessage For="() => asset_owner.category" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="assetno" class="form-label">assetNo:</label>
                    <InputText id="assetno" @bind-Value="asset_owner.assetNo" class="form-control" />
                    <ValidationMessage For="() => asset_owner.assetNo" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="comcode" class="form-label">comCode:</label>
                    <InputText id="comcode" @bind-Value="asset_owner.comCode" class="form-control" />
                    <ValidationMessage For="() => asset_owner.comCode" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="place" class="form-label">place:</label>
                    <InputText id="place" @bind-Value="asset_owner.place" class="form-control" />
                    <ValidationMessage For="() => asset_owner.place" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="tag" class="form-label">tag:</label>
                    <InputText id="tag" @bind-Value="asset_owner.tag" class="form-control" />
                    <ValidationMessage For="() => asset_owner.tag" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="description" class="form-label">description:</label>
                    <InputText id="description" @bind-Value="asset_owner.description" class="form-control" />
                    <ValidationMessage For="() => asset_owner.description" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="brand" class="form-label">brand:</label>
                    <InputText id="brand" @bind-Value="asset_owner.brand" class="form-control" />
                    <ValidationMessage For="() => asset_owner.brand" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="model" class="form-label">model:</label>
                    <InputText id="model" @bind-Value="asset_owner.model" class="form-control" />
                    <ValidationMessage For="() => asset_owner.model" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="serial" class="form-label">serial:</label>
                    <InputText id="serial" @bind-Value="asset_owner.serial" class="form-control" />
                    <ValidationMessage For="() => asset_owner.serial" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="year" class="form-label">year:</label>
                    <InputText id="year" @bind-Value="asset_owner.year" class="form-control" />
                    <ValidationMessage For="() => asset_owner.year" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="month" class="form-label">month:</label>
                    <InputText id="month" @bind-Value="asset_owner.month" class="form-control" />
                    <ValidationMessage For="() => asset_owner.month" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="inservicedate" class="form-label">inServiceDate:</label>
                    <InputText id="inservicedate" @bind-Value="asset_owner.inServiceDate" class="form-control" />
                    <ValidationMessage For="() => asset_owner.inServiceDate" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="qty" class="form-label">qty:</label>
                    <InputText id="qty" @bind-Value="asset_owner.qty" class="form-control" />
                    <ValidationMessage For="() => asset_owner.qty" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="currentcost" class="form-label">currentCost:</label>
                    <InputText id="currentcost" @bind-Value="asset_owner.currentCost" class="form-control" />
                    <ValidationMessage For="() => asset_owner.currentCost" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="accdp" class="form-label">AccDP:</label>
                    <InputText id="accdp" @bind-Value="asset_owner.AccDP" class="form-control" />
                    <ValidationMessage For="() => asset_owner.AccDP" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="nbv" class="form-label">nbv:</label>
                    <InputText id="nbv" @bind-Value="asset_owner.nbv" class="form-control" />
                    <ValidationMessage For="() => asset_owner.nbv" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="empname" class="form-label">empName:</label>
                    <InputText id="empname" @bind-Value="asset_owner.empName" class="form-control" />
                    <ValidationMessage For="() => asset_owner.empName" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="status" class="form-label">status:</label>
                    <InputText id="status" @bind-Value="asset_owner.status" class="form-control" />
                    <ValidationMessage For="() => asset_owner.status" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="empid" class="form-label">empid:</label>
                    <InputText id="empid" @bind-Value="asset_owner.empid" class="form-control" />
                    <ValidationMessage For="() => asset_owner.empid" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/asset_owners">Back to List</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private long id { get; set; }

    [SupplyParameterFromForm]
    private asset_owner? asset_owner { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        asset_owner ??= await context.asset_owners.FirstOrDefaultAsync(m => m.id == id);

        if (asset_owner is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task Updateasset_owner()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(asset_owner!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!asset_ownerExists(asset_owner!.id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/asset_owners");
    }

    private bool asset_ownerExists(long id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.asset_owners.Any(e => e.id == id);
    }
}
