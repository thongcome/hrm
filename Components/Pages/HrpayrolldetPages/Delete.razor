@page "/hrpayrolldets/delete"
@using Microsoft.EntityFrameworkCore
@using HRM.Models
@inject IDbContextFactory<HRM.Models.HRMContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Hrpayrolldet</h2>
    <hr />
    @if (hrpayrolldet is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">companyid</dt>
            <dd class="col-sm-10">@hrpayrolldet.companyid</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">PayrollslipNo</dt>
            <dd class="col-sm-10">@hrpayrolldet.PayrollslipNo</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">SeqNo</dt>
            <dd class="col-sm-10">@hrpayrolldet.SeqNo</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">EmpNo</dt>
            <dd class="col-sm-10">@hrpayrolldet.EmpNo</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">PayrollPeriod</dt>
            <dd class="col-sm-10">@hrpayrolldet.PayrollPeriod</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">SalitemCode</dt>
            <dd class="col-sm-10">@hrpayrolldet.SalitemCode</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Description</dt>
            <dd class="col-sm-10">@hrpayrolldet.Description</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">ItemAmt</dt>
            <dd class="col-sm-10">@hrpayrolldet.ItemAmt</dd>
        </dl>
        <EditForm method="post" Model="hrpayrolldet" OnValidSubmit="DeleteHrpayrolldet" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(hrpayrolldet is null)">Delete</button> |
            <a href="/hrpayrolldets">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private Hrpayrolldet? hrpayrolldet;

    [SupplyParameterFromQuery]
    private long id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        hrpayrolldet = await context.Hrpayrolldet.FirstOrDefaultAsync(m => m.id == id);

        if (hrpayrolldet is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteHrpayrolldet()
    {
        using var context = DbFactory.CreateDbContext();
        context.Hrpayrolldet.Remove(hrpayrolldet!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/hrpayrolldets");
    }
}
