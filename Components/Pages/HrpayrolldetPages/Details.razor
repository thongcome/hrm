@page "/hrpayrolldets/details"
@using Microsoft.EntityFrameworkCore
@using HRM.Models
@inject IDbContextFactory<HRM.Models.HRMContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<div>
    <h2>Hrpayrolldet</h2>
    <hr />
    @if (hrpayrolldet is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">companyid</dt>
            <dd class="col-sm-10">@hrpayrolldet.companyid</dd>
            <dt class="col-sm-2">PayrollslipNo</dt>
            <dd class="col-sm-10">@hrpayrolldet.PayrollslipNo</dd>
            <dt class="col-sm-2">SeqNo</dt>
            <dd class="col-sm-10">@hrpayrolldet.SeqNo</dd>
            <dt class="col-sm-2">EmpNo</dt>
            <dd class="col-sm-10">@hrpayrolldet.EmpNo</dd>
            <dt class="col-sm-2">PayrollPeriod</dt>
            <dd class="col-sm-10">@hrpayrolldet.PayrollPeriod</dd>
            <dt class="col-sm-2">SalitemCode</dt>
            <dd class="col-sm-10">@hrpayrolldet.SalitemCode</dd>
            <dt class="col-sm-2">Description</dt>
            <dd class="col-sm-10">@hrpayrolldet.Description</dd>
            <dt class="col-sm-2">ItemAmt</dt>
            <dd class="col-sm-10">@hrpayrolldet.ItemAmt</dd>
        </dl>
        <div>
            <a href="@($"/hrpayrolldets/edit?id={hrpayrolldet.id}")">Edit</a> |
            <a href="@($"/hrpayrolldets")">Back to List</a>
        </div>
    }
</div>

@code {
    private Hrpayrolldet? hrpayrolldet;

    [SupplyParameterFromQuery]
    private long id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        hrpayrolldet = await context.Hrpayrolldet.FirstOrDefaultAsync(m => m.id == id);

        if (hrpayrolldet is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
