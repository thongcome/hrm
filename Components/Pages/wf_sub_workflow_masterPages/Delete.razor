@code {
    private wf_sub_workflow_master? wf_sub_workflow_master;
    private bool _locked;
    private string? _error;

    [SupplyParameterFromQuery]
    private long subworkflowid { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        wf_sub_workflow_master = await context.wf_sub_workflow_masters.FirstOrDefaultAsync(m => m.subworkflowid == subworkflowid);

        if (wf_sub_workflow_master is null)
        {
            NavigationManager.NavigateTo("notfound");
            return;
        }

        var parentWorkflow = await context.wf_workflows.FirstOrDefaultAsync(w => w.workflowid == wf_sub_workflow_master.workflowid);
        _locked = parentWorkflow?.isactive == true;
    }

    private async Task Deletewf_sub_workflow_master()
    {
        _error = null;
        try
        {
            using var context = DbFactory.CreateDbContext();
            await WorkflowLockGuard.EnsureWorkflowEditableAsync(context, wf_sub_workflow_master!.workflowid);
            context.wf_sub_workflow_masters.Remove(wf_sub_workflow_master!);
            await context.SaveChangesAsync();
            NavigationManager.NavigateTo("/wf_sub_workflow_masters");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
