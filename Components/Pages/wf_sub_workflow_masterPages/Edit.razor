@code {
    [SupplyParameterFromQuery]
    private long subworkflowid { get; set; }

    [SupplyParameterFromForm]
    private wf_sub_workflow_master? wf_sub_workflow_master { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        wf_sub_workflow_master ??= await context.wf_sub_workflow_masters.FirstOrDefaultAsync(m => m.subworkflowid == subworkflowid);

        if (wf_sub_workflow_master is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task Updatewf_sub_workflow_master()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(wf_sub_workflow_master!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!wf_sub_workflow_masterExists(wf_sub_workflow_master!.subworkflowid))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/wf_sub_workflow_masters");
    }

    private bool wf_sub_workflow_masterExists(long subworkflowid)
    {
        using var context = DbFactory.CreateDbContext();
        return context.wf_sub_workflow_masters.Any(e => e.subworkflowid == subworkflowid);
    }
}
