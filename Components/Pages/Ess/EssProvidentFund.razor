@page "/ess/provident-fund"
@using HRM.Models
@using HRM.Services.Audit
@using HRM.Services.Ess
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject IAuditLogger AuditLogger
@inject ISnackbar Snackbar
@inject JsonLocalizationService L
@inject HRM.Services.Pay.ProvidentFundRateChangeRequestService RateChangeRequestService
@attribute [Authorize(Policy = "Menu:ESS_ACCESS")]

<PageTitle>@L.Translate("ProvidentFund")</PageTitle>

<MudPaper Class="pa-4 mb-4">
    <MudText Typo="Typo.h5">@L.Translate("ProvidentFund")</MudText>

    @if (!_loaded)
    {
        <MudProgressCircular Indeterminate="true" Class="mt-4" />
    }
    else if (_employee is null)
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">@L.Translate("NoEmployeeLinkedError")</MudAlert>
    }
    else if (_currentElection is null)
    {
        <MudAlert Severity="Severity.Info" Class="mt-4">
            @L.Translate("PfNotEnrolledAlert")
        </MudAlert>
    }
    else
    {
        <MudText Typo="Typo.h6" Class="mt-4">@L.Translate("PfCurrentStatusTitle")</MudText>
        <MudGrid Class="mt-1">
            <MudItem xs="12" sm="4"><MudTextField Value="@($"{_currentElection.EmployeeContributionRate:0.00}%")" Label="@L.Translate("FieldEmployeeRate")" ReadOnly="true" /></MudItem>
            <MudItem xs="12" sm="4"><MudTextField Value="@($"{_currentElection.CompanyContributionRate:0.00}%")" Label="@L.Translate("FieldCompanyRate")" ReadOnly="true" /></MudItem>
            <MudItem xs="12" sm="4"><MudTextField Value="@_currentElection.EffectiveFrom.ToString("dd/MM/yyyy")" Label="@L.Translate("FieldEffectiveFrom")" ReadOnly="true" /></MudItem>
        </MudGrid>

        <MudDivider Class="my-4" />

        <MudText Typo="Typo.h6">ขอเปลี่ยนอัตราเงินสะสม</MudText>

        @if (_openWindow is null)
        {
            <MudAlert Severity="Severity.Info" Class="mt-3">ขณะนี้ไม่อยู่ในช่วงเวลาที่เปิดให้ยื่นคำขอเปลี่ยนอัตรา — ติดต่อฝ่ายบุคคลถ้ามีความจำเป็นเร่งด่วน</MudAlert>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mt-1">
                เปิดรับคำขอถึงตามรอบ "@_openWindow.Name" — ถ้าอนุมัติ จะมีผลวันที่ @ResolveWindowEffectiveDate(_openWindow).ToString("dd/MM/yyyy")
                (ช่วงเงินสะสม @_activePolicy?.MinEmployeeRate.ToString("0.0")-@_activePolicy?.MaxEmployeeRate.ToString("0.0")%)
            </MudText>
            <MudGrid Class="mt-2">
                <MudItem xs="12" sm="6"><MudNumericField @bind-Value="_newEmployeeRate" Label="อัตราเงินสะสมที่ต้องการ (%)" Format="0.00" Min="0" Max="100" /></MudItem>
            </MudGrid>

            @if (!string.IsNullOrEmpty(_rateError))
            {
                <MudAlert Severity="Severity.Error" Class="mt-3">@_rateError</MudAlert>
            }

            <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="mt-3" OnClick="SubmitRateChangeRequestAsync" Disabled="_saving">
                ยื่นคำขอ (ต้องผ่านการอนุมัติจากฝ่ายบุคคล)
            </MudButton>
        }

        @if (_requests.Count > 0)
        {
            <MudText Typo="Typo.subtitle2" Class="mt-4">ประวัติคำขอเปลี่ยนอัตรา</MudText>
            <MudSimpleTable Dense="true" Class="mt-1">
                <thead><tr><th>วันที่ยื่น</th><th>ขอสะสม</th><th>อัตราสมทบที่เสนอ</th><th>มีผล</th><th>สถานะ</th></tr></thead>
                <tbody>
                    @foreach (var r in _requests)
                    {
                        <tr>
                            <td>@r.RequestedDate.ToString("dd/MM/yyyy")</td>
                            <td>@r.RequestedEmployeeRate.ToString("0.00")%</td>
                            <td>@r.RequestedCompanyRate.ToString("0.00")%</td>
                            <td>@r.RequestedEffectiveFrom.ToString("dd/MM/yyyy")</td>
                            <td>@RequestStatusLabel(r.Status)</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }

        <MudDivider Class="my-4" />

        <MudText Typo="Typo.h6">@L.Translate("PfChangeInvestmentTitle")</MudText>
        <MudText Typo="Typo.body2" Class="mt-1">@L.Translate("PfChangeInvestmentDesc")</MudText>
        <MudGrid Class="mt-2">
            <MudItem xs="12" sm="8">
                <MudSelect T="long?" @bind-Value="_newInvestmentPolicyId" Label="@L.Translate("FieldInvestmentPolicy")">
                    @foreach (var inv in _investmentPolicies)
                    {
                        <MudSelectItem T="long?" Value="@((long?)inv.Id)">@inv.Code — @inv.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>

        @if (!string.IsNullOrEmpty(_invError))
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_invError</MudAlert>
        }

        <MudButton Color="Color.Secondary" Variant="Variant.Filled" Class="mt-3" OnClick="ChangeInvestmentPolicyAsync" Disabled="_saving">
            @L.Translate("PfSaveInvestmentButton")
        </MudButton>
    }
</MudPaper>

@code {
    private bool _loaded;
    private bool _saving;
    private Hremployee? _employee;
    private Pay_ProvidentFundPolicy? _activePolicy;
    private Pay_ProvidentFundElection? _currentElection;
    private List<Pay_ProvidentFundInvestmentPolicy> _investmentPolicies = new();

    private decimal _newEmployeeRate;
    private string? _rateError;
    private Pay_ProvidentFundRateChangeWindow? _openWindow;
    private List<Pay_ProvidentFundRateChangeRequest> _requests = new();

    private long? _newInvestmentPolicyId;
    private string? _invError;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        await using var context = await DbFactory.CreateDbContextAsync();
        _employee = await EssEmployeeResolver.ResolveAsync(context, state.User);

        if (_employee is not null)
        {
            await LoadAsync();
            await AuditLogger.LogAccessAsync("Pay_ProvidentFundElection", _employee.id.ToString(), isSensitive: true, note: "ESS provident fund view");
        }

        _loaded = true;
    }

    private async Task LoadAsync()
    {
        if (_employee is null) return;
        await using var context = await DbFactory.CreateDbContextAsync();

        var today = DateOnly.FromDateTime(DateTime.Today);
        _activePolicy = await context.Pay_ProvidentFundPolicies
            .Where(p => p.CompanyId == _employee.companyid && p.IsEnabled
                        && p.EffectiveFrom <= today && (p.EffectiveTo == null || p.EffectiveTo >= today))
            .FirstOrDefaultAsync();

        _investmentPolicies = await context.Pay_ProvidentFundInvestmentPolicies
            .Where(p => p.CompanyId == _employee.companyid && p.IsActive)
            .OrderBy(p => p.SortOrder)
            .ToListAsync();

        _currentElection = await context.Pay_ProvidentFundElections
            .Where(e => e.HremployeeId == _employee.id && e.IsActive)
            .OrderByDescending(e => e.EffectiveFrom)
            .FirstOrDefaultAsync();

        if (_currentElection is not null)
        {
            _newEmployeeRate = _currentElection.EmployeeContributionRate;
            _newInvestmentPolicyId = _currentElection.InvestmentPolicyId;
        }

        if (_activePolicy is not null)
        {
            _openWindow = await RateChangeRequestService.GetOpenWindowAsync(_activePolicy.Id);
        }
        _requests = await RateChangeRequestService.GetRequestsForEmployeeAsync(_employee.id);
    }

    private static DateOnly ResolveWindowEffectiveDate(Pay_ProvidentFundRateChangeWindow w)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        var effective = new DateOnly(today.Year, w.EffectiveMonth, w.EffectiveDay);
        return effective < today ? effective.AddYears(1) : effective;
    }

    private static string RequestStatusLabel(ProvidentFundRequestStatus status) => status switch
    {
        ProvidentFundRequestStatus.PendingApproval => "รออนุมัติ",
        ProvidentFundRequestStatus.Approved => "อนุมัติแล้ว",
        ProvidentFundRequestStatus.Rejected => "ไม่อนุมัติ",
        _ => status.ToString(),
    };

    // Submits a request to the Workflow Approval Engine instead of writing
    // Pay_ProvidentFundElection directly — HR must approve before the new
    // rate ever takes effect (see ProvidentFundRateChangeRequestService).
    private async Task SubmitRateChangeRequestAsync()
    {
        _rateError = null;
        if (_employee is null || _openWindow is null) return;

        _saving = true;
        try
        {
            var state = await AuthProvider.GetAuthenticationStateAsync();
            var userId = long.TryParse(state.User.FindFirst("sc_userid")?.Value, out var uid) ? uid : 0;
            var empNo = state.User.FindFirst("empno")?.Value;

            await RateChangeRequestService.SubmitAsync(_employee.id, _newEmployeeRate, userId, empNo, isEmployeeInitiated: true);

            Snackbar.Add("ยื่นคำขอเรียบร้อยแล้ว รอฝ่ายบุคคลอนุมัติ", Severity.Success);
            await LoadAsync();
        }
        catch (InvalidOperationException ex)
        {
            _rateError = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ChangeInvestmentPolicyAsync()
    {
        _invError = null;
        if (_employee is null || _currentElection is null) return;

        _saving = true;
        try
        {
            await using var context = await DbFactory.CreateDbContextAsync();
            var existing = await context.Pay_ProvidentFundElections
                .FirstOrDefaultAsync(e => e.Id == _currentElection.Id);
            if (existing is null)
            {
                _invError = L.Translate("PfElectionNotFoundError");
                return;
            }

            existing.InvestmentPolicyId = _newInvestmentPolicyId;
            await context.SaveChangesAsync();
            await AuditLogger.LogChangeAsync(AuditActionType.Update, "Pay_ProvidentFundElection", _employee.id.ToString(),
                oldValues: null, newValues: new { _newInvestmentPolicyId }, isSensitive: false);

            Snackbar.Add(L.Translate("PfInvestmentSaveSuccess"), Severity.Success);
            await LoadAsync();
        }
        finally
        {
            _saving = false;
        }
    }
}
