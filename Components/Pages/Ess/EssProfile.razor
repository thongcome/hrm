@page "/ess/profile"
@using HRM.Models
@using HRM.Services.Audit
@using HRM.Services.Ess
@using HRM.Services.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject IAuditLogger AuditLogger
@inject ISnackbar Snackbar
@inject JsonLocalizationService L
@attribute [Authorize(Policy = "Menu:ESS_ACCESS")]

<PageTitle>@L.Translate("PersonalInfo")</PageTitle>

<MudPaper Class="pa-4 mb-4">
    <MudText Typo="Typo.h5">@L.Translate("PersonalInfo")</MudText>

    @if (!_loaded)
    {
        <MudProgressCircular Indeterminate="true" Class="mt-4" />
    }
    else if (_employee is null)
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">@L.Translate("NoEmployeeLinkedError")</MudAlert>
    }
    else
    {
        <MudText Typo="Typo.h6" Class="mt-4">@L.Translate("ProfileGeneralInfoTitle")</MudText>
        <MudGrid Class="mt-1">
            <MudItem xs="12" sm="4"><MudTextField Value="@_employee.EmpNo" Label="@L.Translate("EmpNoLabel")" ReadOnly="true" /></MudItem>
            <MudItem xs="12" sm="4"><MudTextField Value="@($"{_employee.EmpName} {_employee.EmpSurname}")" Label="@L.Translate("FieldFullName")" ReadOnly="true" /></MudItem>
            <MudItem xs="12" sm="4"><MudTextField Value="@_employee.PosCode" Label="@L.Translate("FieldPosCode")" ReadOnly="true" /></MudItem>
            <MudItem xs="12" sm="4"><MudTextField Value="@(_employee.WorkDate?.ToString("dd/MM/yyyy"))" Label="@L.Translate("FieldWorkDate")" ReadOnly="true" /></MudItem>
            <MudItem xs="12" sm="4"><MudTextField Value="@_employee.SalexpBank" Label="@L.Translate("FieldBankCode")" ReadOnly="true" /></MudItem>
            <MudItem xs="12" sm="4"><MudTextField Value="@MaskAccountNo(_employee.SalexpAccid)" Label="@L.Translate("FieldAccountNo")" ReadOnly="true" /></MudItem>
        </MudGrid>

        @if (_registeredAddress is not null)
        {
            <MudText Typo="Typo.h6" Class="mt-4">@L.Translate("ProfileRegisteredAddressTitle")</MudText>
            <MudText Typo="Typo.body2" Class="mt-1">@FormatAddress(_registeredAddress)</MudText>
        }

        <MudDivider Class="my-4" />

        <MudText Typo="Typo.h6">@L.Translate("ProfileCurrentAddressTitle")</MudText>
        <MudGrid Class="mt-1">
            <MudItem xs="12" sm="4"><MudTextField @bind-Value="_currentAddress.no" Label="@L.Translate("FieldAddressNo")" /></MudItem>
            <MudItem xs="12" sm="4"><MudTextField @bind-Value="_currentAddress.subdistrict" Label="@L.Translate("FieldSubdistrict")" /></MudItem>
            <MudItem xs="12" sm="4"><MudTextField @bind-Value="_currentAddress.districtid" Label="@L.Translate("FieldDistrict")" /></MudItem>
            <MudItem xs="12" sm="4"><MudTextField @bind-Value="_currentAddress.province" Label="@L.Translate("FieldProvince")" /></MudItem>
            <MudItem xs="12" sm="4"><MudTextField @bind-Value="_currentAddress.postcode" Label="@L.Translate("FieldPostcode")" /></MudItem>
            <MudItem xs="12" sm="4"><MudTextField @bind-Value="_currentAddress.tel" Label="@L.Translate("FieldPhone")" /></MudItem>
            <MudItem xs="12" sm="4"><MudTextField @bind-Value="_currentAddress.mobileno" Label="@L.Translate("FieldMobile")" /></MudItem>
            <MudItem xs="12" sm="8"><MudTextField @bind-Value="_currentAddress.email" Label="@L.Translate("FieldEmail")" Required="true" InputType="InputType.Email"
                HelperText="@L.Translate("ProfileEmailHelperText")" /></MudItem>
        </MudGrid>

        <MudText Typo="Typo.h6" Class="mt-4">@L.Translate("ProfileEmergencyContactTitle")</MudText>
        <MudGrid Class="mt-1">
            <MudItem xs="12" sm="3"><MudTextField @bind-Value="_emerName" Label="@L.Translate("FieldFirstName")" /></MudItem>
            <MudItem xs="12" sm="3"><MudTextField @bind-Value="_emerSurname" Label="@L.Translate("FieldLastName")" /></MudItem>
            <MudItem xs="12" sm="3"><MudTextField @bind-Value="_emerPhone" Label="@L.Translate("FieldPhoneNumber")" /></MudItem>
            <MudItem xs="12" sm="3"><MudTextField @bind-Value="_emerAddress" Label="@L.Translate("FieldEmergencyAddress")" /></MudItem>
        </MudGrid>

        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
        }

        <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="mt-4" OnClick="SaveAsync" Disabled="_saving">
            @L.Translate("ProfileSaveButton")
        </MudButton>
    }
</MudPaper>

@code {
    private const long CurrentAddressTypeId = 2; // mas_address_type code "CUR"
    private const long RegisteredAddressTypeId = 1; // mas_address_type code "REG"

    private bool _loaded;
    private bool _saving;
    private string? _error;
    private Hremployee? _employee;
    private address? _registeredAddress;
    private address _currentAddress = new();
    private string? _emerName, _emerSurname, _emerPhone, _emerAddress;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        await using var context = await DbFactory.CreateDbContextAsync();
        _employee = await EssEmployeeResolver.ResolveAsync(context, state.User);

        if (_employee is not null)
        {
            _registeredAddress = await context.addresses
                .Where(a => a.hremployeeid == _employee.id && a.address_type_id == RegisteredAddressTypeId && a.isactive)
                .OrderByDescending(a => a.moddate ?? a.createdate)
                .FirstOrDefaultAsync();

            _currentAddress = await context.addresses
                .Where(a => a.hremployeeid == _employee.id && a.address_type_id == CurrentAddressTypeId && a.isactive)
                .OrderByDescending(a => a.moddate ?? a.createdate)
                .FirstOrDefaultAsync() ?? new address { hremployeeid = _employee.id, address_type_id = CurrentAddressTypeId };

            _emerName = _employee.EmerName;
            _emerSurname = _employee.EmerSurname;
            _emerPhone = _employee.EmerPhone;
            _emerAddress = _employee.EmerAddress;

            await AuditLogger.LogAccessAsync("Hremployee", _employee.id.ToString(), isSensitive: true, note: "ESS profile view");
        }

        _loaded = true;
    }

    private async Task SaveAsync()
    {
        _error = null;
        if (_employee is null) return;

        if (string.IsNullOrWhiteSpace(_currentAddress.email))
        {
            _error = L.Translate("ProfileEmailRequiredError");
            return;
        }
        if (!EmployeeEmailResolver.IsValidFormat(_currentAddress.email))
        {
            _error = L.Translate("InvalidEmailFormatError");
            return;
        }

        _saving = true;
        try
        {
            await using var context = await DbFactory.CreateDbContextAsync();

            var addr = await context.addresses
                .FirstOrDefaultAsync(a => a.id == _currentAddress.id && _currentAddress.id != 0);
            if (addr is null)
            {
                addr = new address { hremployeeid = _employee.id, address_type_id = CurrentAddressTypeId, createdate = DateTime.Now };
                context.addresses.Add(addr);
            }
            addr.no = _currentAddress.no;
            addr.subdistrict = _currentAddress.subdistrict;
            addr.districtid = _currentAddress.districtid;
            addr.province = _currentAddress.province;
            addr.postcode = _currentAddress.postcode;
            addr.tel = _currentAddress.tel;
            addr.mobileno = _currentAddress.mobileno;
            addr.email = _currentAddress.email;
            addr.moddate = DateTime.Now;

            var emp = await context.Hremployee.FirstOrDefaultAsync(e => e.id == _employee.id);
            if (emp is not null)
            {
                emp.EmerName = _emerName;
                emp.EmerSurname = _emerSurname;
                emp.EmerPhone = _emerPhone;
                emp.EmerAddress = _emerAddress;
            }

            await context.SaveChangesAsync();
            await AuditLogger.LogChangeAsync(AuditActionType.Update, "Hremployee", _employee.id.ToString(),
                oldValues: null, newValues: new { addr.no, addr.subdistrict, addr.province, _emerName, _emerPhone },
                isSensitive: true);

            _currentAddress.id = addr.id;
            Snackbar.Add(L.Translate("ProfileSaveSuccess"), Severity.Success);
        }
        catch (Exception ex)
        {
            _error = L.Translate("ProfileSaveError");
            Serilog.Log.Error(ex, "ESS profile save failed for employee {Id}", _employee.id);
        }
        finally
        {
            _saving = false;
        }
    }

    private static string MaskAccountNo(string? accId)
    {
        if (string.IsNullOrWhiteSpace(accId) || accId.Length <= 4) return accId ?? "";
        return new string('x', accId.Length - 4) + accId[^4..];
    }

    private static string FormatAddress(address a)
    {
        var parts = new[] { a.no, a.subdistrict, a.districtid, a.province, a.postcode }
            .Where(p => !string.IsNullOrWhiteSpace(p));
        return string.Join(" ", parts);
    }
}
