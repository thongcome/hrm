@page "/ess"
@using HRM.Models
@using HRM.Services.Ess
@using HRM.Services.Hr
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject InfoMessageService InfoService
@inject AuthenticationStateProvider AuthProvider
@inject JsonLocalizationService L
@attribute [Authorize(Policy = "Menu:ESS_ACCESS")]

<PageTitle>@L.Translate("EssHomeTitle")</PageTitle>

<MudPaper Class="pa-4 mb-4">
    @if (!_loaded)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (_employee is null)
    {
        <MudAlert Severity="Severity.Error">@L.Translate("NoEmployeeLinkedError")</MudAlert>
    }
    else
    {
        <MudText Typo="Typo.h5">@string.Format(L.Translate("GreetingTemplate"), _employee.EmpName, _employee.EmpSurname)</MudText>
        <MudText Typo="Typo.body2" Class="mt-1" Style="opacity:.75;">
            @string.Format(L.Translate("EmployeeCodeLabel"), _employee.EmpNo)
            @if (!string.IsNullOrWhiteSpace(_employee.PosCode)) { <text>@string.Format(L.Translate("PositionSuffixTemplate"), _employee.PosCode)</text> }
        </MudText>

        @if (_pinnedAnnouncements.Count > 0)
        {
            <MudPaper Class="pa-4 mt-4" Elevation="2">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.h6">
                        <MudIcon Icon="@Icons.Material.Filled.Campaign" Class="mr-1" Style="vertical-align:middle;" />@L.Translate("ImportantAnnouncements")
                    </MudText>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Href="/hr/announcements">@L.Translate("ViewAllAnnouncements")</MudButton>
                </MudStack>
                <MudStack Spacing="1" Class="mt-2">
                    @foreach (var m in _pinnedAnnouncements)
                    {
                        <MudLink Href="@($"/hr/announcements/{m.Id}")" Class="d-flex align-center">
                            <MudIcon Icon="@PriorityIcon(m.PriorityLevel)" Color="@PriorityColor(m.PriorityLevel)" Size="Size.Small" Class="mr-2" />@m.subject
                        </MudLink>
                    }
                </MudStack>
            </MudPaper>
        }

        <MudGrid Class="mt-4">
            <MudItem xs="12" sm="6">
                <MudPaper Class="pa-4" Elevation="2">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                        <MudIcon Icon="@Icons.Material.Filled.Badge" Size="Size.Large" Color="Color.Primary" />
                        <div>
                            <MudText Typo="Typo.h6">@L.Translate("PersonalInfo")</MudText>
                            <MudText Typo="Typo.body2">@L.Translate("PersonalInfoDesc")</MudText>
                        </div>
                    </MudStack>
                    <MudButton Href="/ess/profile" Variant="Variant.Text" Color="Color.Primary" Class="mt-3">@L.Translate("GoToPersonalInfo")</MudButton>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudPaper Class="pa-4" Elevation="2">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                        <MudIcon Icon="@Icons.Material.Filled.Receipt" Size="Size.Large" Color="Color.Primary" />
                        <div>
                            <MudText Typo="Typo.h6">@L.Translate("Payslips")</MudText>
                            <MudText Typo="Typo.body2">@L.Translate("PayslipsDesc")</MudText>
                        </div>
                    </MudStack>
                    <MudButton Href="/ess/payslips" Variant="Variant.Text" Color="Color.Primary" Class="mt-3">@L.Translate("GoToPayslips")</MudButton>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudPaper Class="pa-4" Elevation="2">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                        <MudIcon Icon="@Icons.Material.Filled.Savings" Size="Size.Large" Color="Color.Primary" />
                        <div>
                            <MudText Typo="Typo.h6">@L.Translate("ProvidentFund")</MudText>
                            <MudText Typo="Typo.body2">@L.Translate("ProvidentFundDesc")</MudText>
                        </div>
                    </MudStack>
                    <MudButton Href="/ess/provident-fund" Variant="Variant.Text" Color="Color.Primary" Class="mt-3">@L.Translate("GoToProvidentFund")</MudButton>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudPaper>

@code {
    private bool _loaded;
    private Hremployee? _employee;
    private List<info_message> _pinnedAnnouncements = new();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        await using var context = await DbFactory.CreateDbContextAsync();
        _employee = await EssEmployeeResolver.ResolveAsync(context, state.User);
        if (_employee is not null)
        {
            _pinnedAnnouncements = (await InfoService.GetVisibleAnnouncementsAsync(context, _employee, pinnedOnly: true))
                .Take(5).ToList();
        }
        _loaded = true;
    }

    private static string PriorityIcon(InfoMessagePriority p) => p switch
    {
        InfoMessagePriority.Urgent => Icons.Material.Filled.ReportProblem,
        InfoMessagePriority.Important => Icons.Material.Filled.PriorityHigh,
        _ => Icons.Material.Filled.Campaign,
    };

    private static Color PriorityColor(InfoMessagePriority p) => p switch
    {
        InfoMessagePriority.Urgent => Color.Error,
        InfoMessagePriority.Important => Color.Warning,
        _ => Color.Default,
    };
}
