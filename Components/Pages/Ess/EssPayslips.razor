@page "/ess/payslips"
@using HRM.Models
@using HRM.Services.Ess
@using HRM.Services.Shared
@using HRM.Components.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inherits LocalizedComponentBase
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject HRM.Services.Pay.PayslipEmailService PayslipEmail
@inject ISnackbar Snackbar
@inject JsonLocalizationService L
@attribute [Authorize(Policy = "Menu:ESS_ACCESS")]

<PageTitle>@L.Translate("Payslips")</PageTitle>

<MudPaper Class="pa-4 mb-4">
    <MudText Typo="Typo.h5">@L.Translate("MyPayslips")</MudText>

    @if (!_loaded)
    {
        <MudProgressCircular Indeterminate="true" Class="mt-4" />
    }
    else if (_employee is null)
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">@L.Translate("NoEmployeeLinkedError")</MudAlert>
    }
    else
    {
        @if (string.IsNullOrWhiteSpace(_ownEmail))
        {
            <MudAlert Severity="Severity.Warning" Class="mt-3">
                @L.Translate("NoEmailWarningPrefix")<MudLink Href="/ess/profile">@L.Translate("FillEmailAtProfileLink")</MudLink>@L.Translate("NoEmailWarningSuffix")
            </MudAlert>
        }

        @if (_rows.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Class="mt-4">@L.Translate("NoPayslipsYet")</MudAlert>
        }
        else
        {
            <MudSimpleTable Dense="true" Class="mt-3">
                <thead><tr><th>@L.Translate("Period")</th><th>@L.Translate("PeriodDateRange")</th><th style="text-align:right">@L.Translate("NetPay")</th><th></th><th></th></tr></thead>
                <tbody>
                    @foreach (var row in _rows)
                    {
                        <tr>
                            <td>@row.Run.PayrollPeriod</td>
                            <td>@row.Run.PeriodStart.ToString("dd/MM/yyyy") - @row.Run.PeriodEnd.ToString("dd/MM/yyyy")</td>
                            <td style="text-align:right">@row.PayrollEmployee.NetPay.ToString("N2")</td>
                            <td>
                                <MudLink Href="@($"/ess/files/payslip/{row.Payslip.Id}")" Target="_blank">
                                    <MudIcon Icon="@Icons.Material.Filled.Download" Size="Size.Small" /> @L.Translate("Download")
                                </MudLink>
                            </td>
                            <td>
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                    Disabled="@(string.IsNullOrWhiteSpace(_ownEmail) || _sendingIds.Contains(row.Payslip.Id))"
                                    OnClick="@(() => SendPayslipAsync(row))">
                                    <MudIcon Icon="@Icons.Material.Filled.Send" Size="Size.Small" /> @L.Translate("SendEmail")
                                </MudButton>
                                @if (_lastSent.TryGetValue(row.Payslip.Id, out var sentAt))
                                {
                                    <MudText Typo="Typo.caption" Class="d-block">@string.Format(L.Translate("LastSentTemplate"), sentAt.ToString("dd/MM/yyyy HH:mm"))</MudText>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    }
</MudPaper>

@code {
    private record Row(Pay_PayrollRun Run, Pay_PayrollEmployee PayrollEmployee, Pay_Payslip Payslip);

    private bool _loaded;
    private Hremployee? _employee;
    private List<Row> _rows = new();
    private string? _ownEmail;
    private HashSet<long> _sendingIds = new();
    private Dictionary<long, DateTime> _lastSent = new();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        await using var context = await DbFactory.CreateDbContextAsync();
        _employee = await EssEmployeeResolver.ResolveAsync(context, state.User);

        if (_employee is not null)
        {
            var payEmployees = await context.Pay_PayrollEmployees
                .Include(pe => pe.Pay_PayrollRun)
                .Include(pe => pe.Pay_Payslip)
                .Where(pe => pe.HremployeeId == _employee.id && pe.Pay_Payslip != null && pe.Pay_Payslip!.IsPublishedToEmployee)
                .OrderByDescending(pe => pe.Pay_PayrollRun.PeriodStart)
                .ToListAsync();

            _rows = payEmployees.Select(pe => new Row(pe.Pay_PayrollRun, pe, pe.Pay_Payslip!)).ToList();

            _ownEmail = await EmployeeEmailResolver.ResolveAsync(context, _employee.id);

            if (_rows.Count > 0)
            {
                var payslipIdStrings = _rows.Select(r => r.Payslip.Id.ToString()).ToList();
                var latestByRecordId = await context.AuditLogs
                    .Where(a => a.EntityType == "Pay_PayslipEmail" && payslipIdStrings.Contains(a.RecordId!))
                    .GroupBy(a => a.RecordId)
                    .Select(g => new { RecordId = g.Key!, Latest = g.Max(x => x.EventDate) })
                    .ToListAsync();
                _lastSent = latestByRecordId.ToDictionary(x => long.Parse(x.RecordId), x => x.Latest);
            }
        }

        _loaded = true;
    }

    private async Task SendPayslipAsync(Row row)
    {
        if (_employee is null || string.IsNullOrWhiteSpace(_ownEmail)) return;

        _sendingIds.Add(row.Payslip.Id);
        try
        {
            // Shared with the HR-side send (PayrollRunDetail) via PayslipEmailService
            // so the two never drift on file-name/audit/email-resolution.
            var result = await PayslipEmail.SendToEmployeeAsync(row.Payslip.Id, "ESS พนักงานส่งเอง");
            if (result.Success)
            {
                _lastSent[row.Payslip.Id] = DateTime.Now;
                Snackbar.Add(string.Format(L.Translate("PayslipSentSuccess"), result.Email), Severity.Success);
            }
            else
            {
                Snackbar.Add(result.ErrorReason ?? L.Translate("EmailSendFailed"), Severity.Error);
            }
        }
        finally
        {
            _sendingIds.Remove(row.Payslip.Id);
        }
    }
}
