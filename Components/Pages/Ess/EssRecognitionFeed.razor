@page "/ess/recognition"
@using HRM.Models
@using HRM.Services.Ess
@using HRM.Services.Engagement
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject RecognitionService RecognitionService
@inject EngagementService EngagementService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@inject JsonLocalizationService L
@attribute [Authorize(Policy = "Menu:ESS_ACCESS")]

<PageTitle>@L.Translate("KudosPageTitle")</PageTitle>

@if (!_loaded)
{
    <MudProgressCircular Indeterminate="true" Class="mt-4" />
    return;
}

@if (_employee is null)
{
    <MudAlert Severity="Severity.Error" Class="ma-4">@L.Translate("NoEmployeeLinkedError")</MudAlert>
    return;
}

<MudPaper Class="pa-4 mb-4" Style="background:linear-gradient(135deg,#0d47a1,#1976d2);color:#fff;">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <div>
            <MudText Typo="Typo.overline" Style="opacity:.85;">แต้มสะสมของฉัน (Kudos Points)</MudText>
            <MudText Typo="Typo.h4">@_balance.Available <span style="font-size:.5em;opacity:.85;">แต้มใช้ได้</span></MudText>
            <MudText Typo="Typo.caption" Style="opacity:.85;">ได้รับสะสม @_balance.Earned · ใช้ไปแล้ว @_balance.Spent</MudText>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Surface" StartIcon="@Icons.Material.Filled.Redeem"
            OnClick="@(() => Nav.NavigateTo("/ess/rewards"))">แลกของรางวัล</MudButton>
    </MudStack>
</MudPaper>

<MudPaper Class="pa-4 mb-4">
    <MudText Typo="Typo.h5">@L.Translate("KudosGiveTitle")</MudText>
    <MudGrid Class="mt-2">
        <MudItem xs="12" sm="5">
            <MudAutocomplete T="Hremployee" Label="@L.Translate("KudosColleagueLabel")" Value="_toEmployee" ValueChanged="v => _toEmployee = v"
                SearchFunc="SearchEmployeesAsync" ToStringFunc="@(e => e == null ? null : $"{e.EmpNo} — {e.EmpName} {e.EmpSurname}")"
                ResetValueOnEmptyText="true" CoerceText="true" MinCharacters="0" />
        </MudItem>
        <MudItem xs="8" sm="3">
            <MudTextField @bind-Value="_coreValueTag" Label="@L.Translate("KudosTagLabel")" Placeholder="@L.Translate("KudosTagPlaceholder")" />
        </MudItem>
        <MudItem xs="4" sm="1">
            <MudNumericField T="int" @bind-Value="_points" Label="แต้ม" Min="0" Max="100" />
        </MudItem>
        <MudItem xs="12">
            <MudTextField @bind-Value="_message" Label="@L.Translate("KudosMessageLabel")" Lines="3" />
        </MudItem>
        @if (!string.IsNullOrEmpty(_error))
        {
            <MudItem xs="12"><MudAlert Severity="Severity.Error">@_error</MudAlert></MudItem>
        }
        <MudItem xs="12">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GiveAsync">@L.Translate("KudosSendButton")</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudPaper Class="pa-4 mb-4">
    <MudText Typo="Typo.h5">@L.Translate("KudosFeedTitle")</MudText>
    <MudStack Spacing="2" Class="mt-3">
        @foreach (var r in _feed)
        {
            <MudPaper Class="pa-3" Outlined="true">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start">
                    <div>
                        <MudText Typo="Typo.body1"><b>@r.FromName</b> → <b>@r.ToName</b></MudText>
                        <MudText Typo="Typo.body2" Class="mt-1">@r.Message</MudText>
                        @if (!string.IsNullOrWhiteSpace(r.CoreValueTag))
                        {
                            <MudChip T="string" Size="Size.Small" Class="mt-1">@r.CoreValueTag</MudChip>
                        }
                        @if (r.Points > 0)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Icon="@Icons.Material.Filled.Stars" Class="mt-1">+@r.Points แต้ม</MudChip>
                        }
                    </div>
                    <MudText Typo="Typo.caption" Style="opacity:.6;white-space:nowrap;">@r.CreatedDate.ToString("dd/MM/yyyy HH:mm")</MudText>
                </MudStack>
            </MudPaper>
        }
        @if (_feed.Count == 0)
        {
            <MudText Typo="Typo.body2" Style="opacity:.7;">@L.Translate("KudosFeedEmpty")</MudText>
        }
    </MudStack>
</MudPaper>

@code {
    private bool _loaded;
    private Hremployee? _employee;
    private List<RecognitionService.RecognitionRow> _feed = new();

    private Hremployee? _toEmployee;
    private string? _coreValueTag;
    private int _points = RecognitionService.DefaultKudosPoints;
    private string _message = "";
    private string? _error;
    private EngagementService.BalanceSummary _balance = new(0, 0, 0);

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        await using var context = await DbFactory.CreateDbContextAsync();
        _employee = await EssEmployeeResolver.ResolveAsync(context, state.User);
        if (_employee is not null)
        {
            _feed = await RecognitionService.GetFeedAsync(_employee.companyid);
            _balance = await EngagementService.GetBalanceAsync(_employee.id);
        }
        _loaded = true;
    }

    private async Task<IEnumerable<Hremployee>> SearchEmployeesAsync(string search, CancellationToken ct)
    {
        await using var context = await DbFactory.CreateDbContextAsync(ct);
        var query = context.Hremployee.Where(e => e.companyid == _employee!.companyid && e.ResignDate == null && e.id != _employee.id);
        if (!string.IsNullOrWhiteSpace(search))
        {
            query = query.Where(e => e.EmpNo.Contains(search)
                || (e.EmpName != null && e.EmpName.Contains(search))
                || (e.EmpSurname != null && e.EmpSurname.Contains(search)));
        }
        return await query.OrderBy(e => e.EmpNo).Take(20).ToListAsync(ct);
    }

    private async Task GiveAsync()
    {
        _error = null;
        if (_toEmployee is null) { _error = L.Translate("KudosSelectColleagueError"); return; }
        if (string.IsNullOrWhiteSpace(_message)) { _error = L.Translate("KudosMessageRequiredError"); return; }

        try
        {
            await RecognitionService.GiveAsync(_employee!.companyid, _employee.id, _toEmployee.id, _message, _coreValueTag, _points);
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
            return;
        }

        Snackbar.Add(L.Translate("KudosSentSuccess"), Severity.Success);
        _toEmployee = null;
        _coreValueTag = null;
        _points = RecognitionService.DefaultKudosPoints;
        _message = "";
        _feed = await RecognitionService.GetFeedAsync(_employee.companyid);
    }
}
