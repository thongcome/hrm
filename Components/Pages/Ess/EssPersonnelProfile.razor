@page "/ess/my-profile"
@using HRM.Models
@using HRM.Services.Ess
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@attribute [Authorize(Policy = "Menu:ESS_ACCESS")]

@* ESS-facing wrapper around the same rich personnel-profile view HR uses at
   /employee/personnel-profile/{id} (Components/Pages/Employee/
   EmployeePersonnelProfile.razor). No search box, no way to pick anyone
   else's record — the employeeid comes only from the logged-in user's own
   claims via EssEmployeeResolver, per product owner instruction. All the
   real display/loading logic lives in the shared
   Components/Shared/PersonnelProfileView.razor component. *@

<PageTitle>ข้อมูลบุคลากรของฉัน</PageTitle>

<MudPaper Class="pa-4 mb-4">
    <MudText Typo="Typo.h5">ข้อมูลบุคลากรของฉัน</MudText>
</MudPaper>

@if (!_loaded)
{
    <MudProgressCircular Indeterminate="true" Class="ma-4" />
}
else if (_myEmployeeId is null)
{
    <MudAlert Severity="Severity.Warning" Class="ma-4">ไม่พบข้อมูลพนักงานของคุณ</MudAlert>
}
else
{
    @* ReadOnlyDocuments: employees see their own ACTIVE documents only — no
       upload, no active/superseded toggle (CEO order). Downloads go through
       the ESS self-ownership route in Endpoints/EssFileEndpoints.cs, not the
       Menu:PAY_ADMIN-gated HR route. PDPA access logging happens inside
       PersonnelProfileView itself, unchanged. *@
    <PersonnelProfileView HremployeeId="@_myEmployeeId.Value"
                          ReadOnlyDocuments="true"
                          DocumentDownloadRoute="/ess/files/profile-doc" />
}

@code {
    private bool _loaded;
    private long? _myEmployeeId;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        await using var context = await DbFactory.CreateDbContextAsync();
        var emp = await EssEmployeeResolver.ResolveAsync(context, state.User);
        _myEmployeeId = emp?.id;
        _loaded = true;
    }
}
