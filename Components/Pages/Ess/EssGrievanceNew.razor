@page "/ess/grievance/new"
@using HRM.Models
@using HRM.Services.Ess
@using HRM.Services.Hr
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject GrievanceService GrievanceService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject JsonLocalizationService L
@attribute [Authorize(Policy = "Menu:ESS_ACCESS")]

<PageTitle>@L.Translate("GrievanceFormPageTitle")</PageTitle>

<MudPaper Class="pa-4 mb-4">
    <MudText Typo="Typo.h5">@L.Translate("GrievanceFormTitle")</MudText>
    <MudText Typo="Typo.body2" Class="mt-1">
        @L.Translate("GrievanceFormDesc")
    </MudText>

    @if (_notFound)
    {
        <MudAlert Severity="Severity.Warning" Class="mt-4">@L.Translate("GrievanceNoEmployee")</MudAlert>
    }
    else
    {
        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
        }

        <MudGrid Class="mt-3">
            <MudItem xs="12">
                <MudSwitch @bind-Value="_isAnonymous" Label="@L.Translate("GrievanceAnonymousLabel")" Color="Color.Warning" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="GrievanceCategory" @bind-Value="_category" Label="@L.Translate("ColCategory")">
                    <MudSelectItem T="GrievanceCategory" Value="GrievanceCategory.Harassment">@L.Translate("GrievanceCatHarassment")</MudSelectItem>
                    <MudSelectItem T="GrievanceCategory" Value="GrievanceCategory.Discrimination">@L.Translate("GrievanceCatDiscrimination")</MudSelectItem>
                    <MudSelectItem T="GrievanceCategory" Value="GrievanceCategory.WorkingConditions">@L.Translate("GrievanceCatWorkingConditions")</MudSelectItem>
                    <MudSelectItem T="GrievanceCategory" Value="GrievanceCategory.Compensation">@L.Translate("GrievanceCatCompensation")</MudSelectItem>
                    <MudSelectItem T="GrievanceCategory" Value="GrievanceCategory.Management">@L.Translate("GrievanceCatManagement")</MudSelectItem>
                    <MudSelectItem T="GrievanceCategory" Value="GrievanceCategory.Other">@L.Translate("GrievanceCatOther")</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudDatePicker Date="_incidentDate" DateChanged="@(d => _incidentDate = d)" Label="@L.Translate("GrievanceIncidentDateLabel")" Editable="true" DateFormat="dd/MM/yyyy" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_subject" Label="@L.Translate("ColSubject")" Required="true" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_description" Label="@L.Translate("DescriptionLabel")" Lines="6" Required="true" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_involvedPersons" Label="@L.Translate("GrievanceInvolvedPersonsLabel")" />
            </MudItem>
        </MudGrid>

        <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="mt-4" OnClick="SubmitAsync">@L.Translate("SubmitGrievanceButton")</MudButton>
    }
</MudPaper>

@code {
    private bool _notFound;
    private Hremployee? _employee;

    private bool _isAnonymous;
    private GrievanceCategory _category = GrievanceCategory.Other;
    private DateTime? _incidentDate;
    private string _subject = "";
    private string _description = "";
    private string? _involvedPersons;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        await using var context = await DbFactory.CreateDbContextAsync();
        _employee = await EssEmployeeResolver.ResolveAsync(context, state.User);
        if (_employee is null) _notFound = true;
    }

    private async Task SubmitAsync()
    {
        _error = null;
        if (_employee is null) return;

        try
        {
            var id = await GrievanceService.SubmitAsync(_employee.id, _employee.companyid, _isAnonymous, _category,
                _subject, _description, _incidentDate is null ? null : DateOnly.FromDateTime(_incidentDate.Value), _involvedPersons);
            Snackbar.Add(string.Format(L.Translate("GrievanceSubmitSuccessTemplate"), id), Severity.Success);
            Nav.NavigateTo(_isAnonymous ? "/ess" : "/ess/grievance/my");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
