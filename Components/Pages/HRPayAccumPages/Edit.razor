@page "/hrpayaccums/edit"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using HRM.Models
@inject IDbContextFactory<HRM.Models.HRMContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>HRPayAccum</h2>
<hr />
@if (HRPayAccum is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="HRPayAccum" OnValidSubmit="UpdateHRPayAccum" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                <input type="hidden" name="HRPayAccum.id" value="@HRPayAccum.id" />
                <div class="mb-3">
                    <label for="companyid" class="form-label">companyid:</label>
                    <InputText id="companyid" @bind-Value="HRPayAccum.companyid" class="form-control" />
                    <ValidationMessage For="() => HRPayAccum.companyid" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="year" class="form-label">YEAR:</label>
                    <InputText id="year" @bind-Value="HRPayAccum.YEAR" class="form-control" />
                    <ValidationMessage For="() => HRPayAccum.YEAR" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="empno" class="form-label">EmpNo:</label>
                    <InputText id="empno" @bind-Value="HRPayAccum.EmpNo" class="form-control" />
                    <ValidationMessage For="() => HRPayAccum.EmpNo" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="salary" class="form-label">Salary:</label>
                    <InputNumber id="salary" @bind-Value="HRPayAccum.Salary" class="form-control" />
                    <ValidationMessage For="() => HRPayAccum.Salary" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="otherincome" class="form-label">OtherIncome:</label>
                    <InputNumber id="otherincome" @bind-Value="HRPayAccum.OtherIncome" class="form-control" />
                    <ValidationMessage For="() => HRPayAccum.OtherIncome" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="incomepredictamt" class="form-label">IncomePredictAmt:</label>
                    <InputNumber id="incomepredictamt" @bind-Value="HRPayAccum.IncomePredictAmt" class="form-control" />
                    <ValidationMessage For="() => HRPayAccum.IncomePredictAmt" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="incomeyearamt" class="form-label">IncomeYearAmt:</label>
                    <InputNumber id="incomeyearamt" @bind-Value="HRPayAccum.IncomeYearAmt" class="form-control" />
                    <ValidationMessage For="() => HRPayAccum.IncomeYearAmt" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="taxyearamt" class="form-label">TaxYearAmt:</label>
                    <InputNumber id="taxyearamt" @bind-Value="HRPayAccum.TaxYearAmt" class="form-control" />
                    <ValidationMessage For="() => HRPayAccum.TaxYearAmt" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="incomeforwardamt" class="form-label">IncomeForwardAmt:</label>
                    <InputNumber id="incomeforwardamt" @bind-Value="HRPayAccum.IncomeForwardAmt" class="form-control" />
                    <ValidationMessage For="() => HRPayAccum.IncomeForwardAmt" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="startmonth" class="form-label">StartMonth:</label>
                    <InputNumber id="startmonth" @bind-Value="HRPayAccum.StartMonth" class="form-control" />
                    <ValidationMessage For="() => HRPayAccum.StartMonth" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="endmonth" class="form-label">EndMonth:</label>
                    <InputNumber id="endmonth" @bind-Value="HRPayAccum.EndMonth" class="form-control" />
                    <ValidationMessage For="() => HRPayAccum.EndMonth" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="workmonth" class="form-label">WORKMONTH:</label>
                    <InputNumber id="workmonth" @bind-Value="HRPayAccum.WORKMONTH" class="form-control" />
                    <ValidationMessage For="() => HRPayAccum.WORKMONTH" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="lastmonthcal" class="form-label">LastMonthCal:</label>
                    <InputNumber id="lastmonthcal" @bind-Value="HRPayAccum.LastMonthCal" class="form-control" />
                    <ValidationMessage For="() => HRPayAccum.LastMonthCal" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="lastperiodcode" class="form-label">LastPeriodCode:</label>
                    <InputText id="lastperiodcode" @bind-Value="HRPayAccum.LastPeriodCode" class="form-control" />
                    <ValidationMessage For="() => HRPayAccum.LastPeriodCode" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="modified_by" class="form-label">MODIFIED_BY:</label>
                    <InputText id="modified_by" @bind-Value="HRPayAccum.MODIFIED_BY" class="form-control" />
                    <ValidationMessage For="() => HRPayAccum.MODIFIED_BY" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="modified_date" class="form-label">MODIFIED_DATE:</label>
                    <InputDate id="modified_date" @bind-Value="HRPayAccum.MODIFIED_DATE" class="form-control" />
                    <ValidationMessage For="() => HRPayAccum.MODIFIED_DATE" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/hrpayaccums">Back to List</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private long id { get; set; }

    [SupplyParameterFromForm]
    private HRPayAccum? HRPayAccum { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        HRPayAccum ??= await context.HRPayAccums.FirstOrDefaultAsync(m => m.id == id);

        if (HRPayAccum is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateHRPayAccum()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(HRPayAccum!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!HRPayAccumExists(HRPayAccum!.id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/hrpayaccums");
    }

    private bool HRPayAccumExists(long id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.HRPayAccums.Any(e => e.id == id);
    }
}
