@page "/sc_role_menus/create"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using HRM.Models
@inject IDbContextFactory<HRM.Models.HRMContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>sc_role_menu</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="sc_role_menu" OnValidSubmit="Addsc_role_menu" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert"/>
           @*  <div class="mb-3">
                <label for="menuid" class="form-label">menuid:</label> 
                <InputNumber id="menuid" @bind-Value="sc_role_menu.menuid" class="form-control" /> 
                <ValidationMessage For="() => sc_role_menu.menuid" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="roleid" class="form-label">roleid:</label> 
                <InputNumber id="roleid" @bind-Value="sc_role_menu.roleid" class="form-control" /> 
                <ValidationMessage For="() => sc_role_menu.roleid" class="text-danger" /> 
            </div>         *@

            <!-- 🔽 Dropdown เลือกเมนู (sc_menu) -->
            <div class="mb-3">
                <label for="menuid" class="form-label">Menu:</label>
                <InputSelect id="menuid"
                             class="form-control"
                             @bind-Value="sc_role_menu.menuid">
                    <option value="0">-- เลือกเมนู --</option>
                    @if (Menus is not null)
                    {
                        @foreach (var m in Menus)
                        {
                            <option value="@m.menuid">@m.menuname</option>
                        }
                    }
                </InputSelect>
                <ValidationMessage For="() => sc_role_menu.menuid" class="text-danger" /> 
            </div>

            <!-- 🔽 Dropdown เลือก role (sc_role) -->
            <div class="mb-3">
                <label for="roleid" class="form-label">Role:</label>
                <InputSelect id="roleid"
                             class="form-control"
                             @bind-Value="sc_role_menu.roleid">
                    <option value="0">-- เลือก Role --</option>
                    @if (Roles is not null)
                    {
                        @foreach (var r in Roles)
                        {
                            <option value="@r.roleid">@r.name</option>
                        }
                    }
                </InputSelect>
                <ValidationMessage For="() => sc_role_menu.roleid" class="text-danger" /> 
            </div>

            <div class="mb-3">
                <label for="startdate" class="form-label">startdate:</label> 
                <InputDate id="startdate" @bind-Value="sc_role_menu.startdate" class="form-control" /> 
                <ValidationMessage For="() => sc_role_menu.startdate" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="enddate" class="form-label">enddate:</label> 
                <InputDate id="enddate" @bind-Value="sc_role_menu.enddate" class="form-control" /> 
                <ValidationMessage For="() => sc_role_menu.enddate" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="isactive" class="form-label">isactive:</label> 
                <InputCheckbox id="isactive" @bind-Value="sc_role_menu.isactive" class="form-check-input" aria-required="true"/> 
                <ValidationMessage For="() => sc_role_menu.isactive" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="remark" class="form-label">remark:</label> 
                <InputText id="remark" @bind-Value="sc_role_menu.remark" class="form-control" /> 
                <ValidationMessage For="() => sc_role_menu.remark" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="moddate" class="form-label">moddate:</label> 
                <InputDate id="moddate" @bind-Value="sc_role_menu.moddate" class="form-control" /> 
                <ValidationMessage For="() => sc_role_menu.moddate" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="modby" class="form-label">modby:</label> 
                <InputText id="modby" @bind-Value="sc_role_menu.modby" class="form-control" /> 
                <ValidationMessage For="() => sc_role_menu.modby" class="text-danger" /> 
            </div>        
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/sc_role_menus">Back to List</a>
</div>

@code {
    [SupplyParameterFromForm]
    private sc_role_menu sc_role_menu { get; set; } = new();

    // list สำหรับ dropdown
    private List<sc_role> Roles { get; set; } = new();
    private List<sc_menu> Menus { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();

        // 👇 โหลด sc_role
        Roles = await context.sc_roles.ToListAsync();
        

        // 👇 โหลด sc_menu
        Menus = await context.sc_menus.ToListAsync();
    }

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task Addsc_role_menu()
    {
        using var context = DbFactory.CreateDbContext();
        context.sc_role_menus.Add(sc_role_menu);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/sc_role_menus");
    }
}
