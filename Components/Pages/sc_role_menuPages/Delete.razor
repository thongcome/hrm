@page "/sc_role_menus/delete"
@using Microsoft.EntityFrameworkCore
@using HRM.Models
@inject IDbContextFactory<HRM.Models.HRMContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>sc_role_menu</h2>
    <hr />
    @if (sc_role_menu is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">menuid</dt>
            <dd class="col-sm-10">@sc_role_menu.menuid</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">roleid</dt>
            <dd class="col-sm-10">@sc_role_menu.roleid</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">startdate</dt>
            <dd class="col-sm-10">@sc_role_menu.startdate</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">enddate</dt>
            <dd class="col-sm-10">@sc_role_menu.enddate</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">isactive</dt>
            <dd class="col-sm-10">@sc_role_menu.isactive</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">remark</dt>
            <dd class="col-sm-10">@sc_role_menu.remark</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">moddate</dt>
            <dd class="col-sm-10">@sc_role_menu.moddate</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">modby</dt>
            <dd class="col-sm-10">@sc_role_menu.modby</dd>
        </dl>
        <EditForm method="post" Model="sc_role_menu" OnValidSubmit="Deletesc_role_menu" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(sc_role_menu is null)">Delete</button> |
            <a href="/sc_role_menus">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private sc_role_menu? sc_role_menu;

    [SupplyParameterFromQuery]
    private long rolemenuid { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        sc_role_menu = await context.sc_role_menus.FirstOrDefaultAsync(m => m.rolemenuid == rolemenuid);

        if (sc_role_menu is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task Deletesc_role_menu()
    {
        using var context = DbFactory.CreateDbContext();
        context.sc_role_menus.Remove(sc_role_menu!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/sc_role_menus");
    }
}
