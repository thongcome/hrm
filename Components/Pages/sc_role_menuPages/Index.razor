@page "/sc_role_menus"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using hrm.Models
@using hrm.Models
@implements IAsyncDisposable
@inject IDbContextFactory<hrm.Models.HRMContext> DbFactory

<PageTitle>Index</PageTitle>

<h1>Index</h1>

<p>
    <a href="sc_role_menus/create">Create New</a>
</p>

<QuickGrid Class="table" Items="context.sc_role_menus">
