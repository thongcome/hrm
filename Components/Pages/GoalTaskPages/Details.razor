@page "/goaltasks/details/{Id:int}"
@using Microsoft.EntityFrameworkCore
@using LeaderDevelop.Model
@using System.ComponentModel.DataAnnotations
@inject IDbContextFactory<LeaderDevelop.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@inject ActivityService ActivityService

<PageTitle>Goal Task Details</PageTitle>

<h1>เพิ่มการวางแผนกิจกรรมอย่างเป็นระบบสู่เป้าหมาย</h1>

<!-- Goal Task Details Section -->
<div class="card border-danger mb-4">
    <div class="card-header bg-danger text-white d-flex justify-content-between">
        <h2>รายละเอียดเป้าหมาย</h2>
        <div>


            @*  <button class="btn btn-light btn-sm text-danger mr-2" @onclick="EditGoalTask">แก้ไขเป้าหมาย</button>

            <button class="btn btn-success btn-sm" @onclick="CancelGoalTask">ยกเลิกเป้าหมาย</button> *@

        </div>
    </div>
    <div class="card-body">
        @if (goaltask is null)
        {
            <p><em>Loading...</em></p>
        }
        else
        {
            <div class="row">
                <div class="col-md-6">
                    <p>
                        <strong>
                            @((typeof(GoalTask).GetProperty(nameof(GoalTask.Name))?.GetCustomAttributes(typeof(DisplayAttribute), false)
                                .FirstOrDefault() as DisplayAttribute)?.Name ?? "Name") :
                        </strong> @goaltask.Name
                    </p>
                    <p>
                        <strong>
                            @((typeof(GoalTask).GetProperty(nameof(GoalTask.Description))?.GetCustomAttributes(typeof(DisplayAttribute), false)
                                .FirstOrDefault() as DisplayAttribute)?.Name ?? "Name") :
                        </strong> @goaltask.Description
                    </p>
                    <p>
                        <strong>
                            @((typeof(GoalTask).GetProperty(nameof(GoalTask.progress))?.GetCustomAttributes(typeof(DisplayAttribute), false)
                                .FirstOrDefault() as DisplayAttribute)?.Name ?? "Name") :
                        </strong> @goaltask.progress %

                    </p>

                </div>





                <div class="col-md-6">
                    <p>
                        <strong>
                            @((typeof(GoalTask).GetProperty(nameof(GoalTask.Lesson1))?.GetCustomAttributes(typeof(DisplayAttribute), false)
                                .FirstOrDefault() as DisplayAttribute)?.Name ?? "Name") :
                        </strong> @goaltask.Lesson1
                    </p>
                    <p>
                        <strong>
                            @((typeof(GoalTask).GetProperty(nameof(GoalTask.Lesson2))?.GetCustomAttributes(typeof(DisplayAttribute), false)
                                .FirstOrDefault() as DisplayAttribute)?.Name ?? "Name") :
                        </strong> @goaltask.Lesson2
                    </p>
                    <p>
                        <strong>
                            @((typeof(GoalTask).GetProperty(nameof(GoalTask.ThankFully))?.GetCustomAttributes(typeof(DisplayAttribute), false)
                                .FirstOrDefault() as DisplayAttribute)?.Name ?? "Name") :
                        </strong> @goaltask.ThankFully
                    </p>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="progress">
                        <div class="progress-bar" role="progressbar" style="width: @goaltask.progress%" aria-valuenow="@goaltask.progress" aria-valuemin="0" aria-valuemax="100">
                            @goaltask.progress%
                        </div>
                    </div>
                </div>

            </div>
            <hr />
            <button id="editgoal" class="btn btn-primary btn-sm" @onclick="EditGoalTask">แก้ไขเป้าหมาย</button>

            @if (goaltask.IsActive == true)
            {
                <button id="cancelgoal" class="btn btn-danger btn-sm" @onclick="CancelGoalTask">ยกเลิกเป้าหมาย</button>
            }
            else
            {
                <button id="activegoal" class="btn btn-danger btn-sm" @onclick="ActiveGoalTask">Activeเป้าหมาย</button>

            }

        }
    </div>
</div>

<!-- Activity Section -->
<div class="card mb-4">
    <div class="mb-2">
        <div class="card-header  text-danger">
            <h4>รายละเอียดกิจกรรม</h4>
        </div>
    </div> <div class="mb-2"> <link href=""> คำแนะนำการวางแผนอย่างเป็นระบบ</div>

    <div class="card-body">
        <button class="btn btn-danger mb-3" @onclick="ShowAddActivityForm">เพิ่ม</button>
        <p class="text-muted">รายการกิจกรรม  ไม่ควรเกิน 14 กืจกรรม</p>

        <ul class="list-group">
            @if (Activities != null && Activities.Any())
            {
                @foreach (var activity in Activities)
                {
                    <li class="list-group-item">
                        @if (activity.StatusCode == Activity.ActivityStatus.Success)
                        {
                            <button id="successshow" class="btn btn-success btn-sm">สำเร็จ</button>
                        }
                        <strong>@(activity.Orders?.ToString() ?? "-"). </strong> @activity.Name - ความก้าวหน้า: @activity.progress % วันที่เริ่ม: @activity.StartDate ถึง @activity.EndDate

                        <a href="@($"activities/edit?subid={activity.Id}")"> จัดการกิจกรรม/ Manage</a>

                    </li>
                }
            }
            else
            {
                <li class="list-group-item">No activities added yet.</li>
            }
        </ul>
    </div>
</div>

<!-- Add Activity Form -->
@if (ShowActivityForm)
{
    <div class="card">
        <div class="card-body bg-light">
            <h4>เพิ่มกิจกรรม</h4>
            <EditForm Model="NewActivity" OnValidSubmit="AddActivity">


                <div class="mb-3">
                    <label for="taskid" class="form-label">Task ID:</label>
                    <InputNumber id="taskid" @bind-Value="NewActivity.TaskId" class="form-control" hidden />
                    <ValidationMessage For="() => NewActivity.TaskId" />
                </div>
                <!-- Order Input -->
                <div class="mb-3">
                    <label for="order" class="form-label">(auto)Order:</label>
                    <InputNumber id="order" @bind-Value="NewActivity.Orders" class="form-control" readonly />
                    <ValidationMessage For="() => NewActivity.Orders" />
                </div>

                <!-- Name Input -->
                <div class="mb-3">
                    <label for="Name" class="form-label">Activity:</label>
                    <InputText id="Name" @bind-Value="NewActivity.Name" class="form-control" />
                    <ValidationMessage For="() => NewActivity.Name" />
                </div>

                <!-- StartDate Input -->
                <div class="mb-3">
                    <label for="StartDate" class="form-label">Start Date:</label>
                    <InputDate id="StartDate" @bind-Value="NewActivity.StartDate" class="form-control" />
                    <ValidationMessage For="() => NewActivity.StartDate" />
                </div>

                <!-- EndDate Input -->
                <div class="mb-3">
                    <label for="EndDate" class="form-label">End Date:</label>
                    <InputDate id="EndDate" @bind-Value="NewActivity.EndDate" class="form-control" />
                    <ValidationMessage For="() => NewActivity.EndDate" />
                </div>

                <button type="submit" class="btn btn-primary">Save</button>
                <button type="button" class="btn btn-secondary ml-2" @onclick="HideAddActivityForm">ยกเลิก</button>
            </EditForm>


        </div>
    </div>
}
@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger">
        @ErrorMessage
    </div>
}

<div class="mt-4">
    <a href="@($"/goaltasks/maingoal")" class="btn btn-outline-danger">ไปรายการเป้าหมาย</a>
</div>

@code {
    private GoalTask? goaltask;
    private List<Activity> Activities = new List<Activity>();
    private Activity NewActivity = new Activity();
    private bool ShowActivityForm = false;


    [Parameter]
    public int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        goaltask = await context.GoalTasks.FindAsync(Id);

        if (goaltask is null)
        {
            NavigationManager.NavigateTo("notfound");
        }

        // Load related activities for this goal task
        Activities = await context.Activity.Where(a => a.TaskId == Id).ToListAsync();
    }

    private void ShowAddActivityForm()
    {
        ShowActivityForm = true;
        NewActivity = new Activity();
        NewActivity.TaskId = Id;  // This ensures the activity is linked to the current GoalTask
    }


    private void HideAddActivityForm()
    {
        ShowActivityForm = false;
    }
    private string ErrorMessage = string.Empty;



    private async Task AddActivity()
    {
        try
        {
            using var context = DbFactory.CreateDbContext();

            // Set the TaskId (foreign key) to the current GoalTask Id
            NewActivity.TaskId = Id;
            NewActivity.CreateDate = DateTime.UtcNow;
            NewActivity.ModDate = DateTime.UtcNow;
            NewActivity.progress = 0m;
            NewActivity.StatusCode = Activity.ActivityStatus.Active;



            // Add the new Activity without manually setting the Id
            await ActivityService.CreateNewActivityAsync(NewActivity);

            // context.Activity.Add(NewActivity);
            // await context.SaveChangesAsync();

            // Update the list of activities to reflect the newly added one
            Activities.Add(NewActivity);

            // Hide the form after adding
            HideAddActivityForm();
        }
        catch (Exception ex)
        {
            // Log the error message
            ErrorMessage = $"Error: {ex.Message}";
            Console.WriteLine(ErrorMessage);
        }
    }

    // private async Task CancelGoalTask()
    // {
    //     if (goaltask != null)
    //     {
    //         using var context = DbFactory.CreateDbContext();
    //         goaltask.IsActive = false;
    //         await context.SaveChangesAsync();
    //         NavigationManager.NavigateTo("/goaltasks");
    //     }
    // }



    private async Task StartGoalTask()
    {
        if (goaltask != null)
        {
            using var context = DbFactory.CreateDbContext();
            goaltask.IsActive = true;
            await context.SaveChangesAsync();
            NavigationManager.NavigateTo("/goaltasks");
        }
    }

    //// button click
    private void EditGoalTask()
    {
        // Logic for starting the goal task
        // e.g., change the task status to "In Progress" or something similar
        Console.WriteLine("Goal task started");
        NavigationManager.NavigateTo("/goaltasks/edit?id=" + Id);

    }

    private void CancelGoalTask()
    {
        // Logic for starting the goal task
        // e.g., change the task status to "In Progress" or something similar
        Console.WriteLine("Goal task started");
        NavigationManager.NavigateTo("/goaltasks/cancel?id=" + Id);

    }

    private void ActiveGoalTask()
    {
        // Logic for starting the goal task
        // e.g., change the task status to "In Progress" or something similar
        Console.WriteLine("Goal task started");
        NavigationManager.NavigateTo("/goaltasks/active?id=" + Id);

    }
}