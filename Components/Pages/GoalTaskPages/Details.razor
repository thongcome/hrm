@page "/goaltasks/details/{Id:int}"
@using Microsoft.EntityFrameworkCore
@using LeaderDevelop.Model
@inject IDbContextFactory<LeaderDevelop.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Goal Task Details</PageTitle>

<h1>เพิ่มการวางแผนสู่เป้าหมาย</h1>

<!-- Goal Task Details Section -->
<div class="card border-danger mb-4">
    <div class="card-header bg-danger text-white d-flex justify-content-between">
        <h2>รายละเอียดเป้าหมาย</h2>
        <div>
            <button class="btn btn-light btn-sm text-danger mr-2" @onclick="CancelGoalTask">ยกเลิกเป้าหมาย</button>
            <button class="btn btn-success btn-sm" @onclick="StartGoalTask">เริ่มกำหนดเป้าหมาย</button>
        </div>
    </div>
    <div class="card-body">
        @if (goaltask is null)
        {
            <p><em>Loading...</em></p>
        }
        else
        {
            <div class="row">
                <div class="col-md-6">
                    <p><strong>ชื่อเป้าหมาย (Goal Name):</strong> @goaltask.Name</p>
                    <p><strong>วันที่เริ่ม:</strong> @goaltask.Startdate?.ToString("dd/MM/yyyy")</p>
                    <p><strong>วันที่สิ้นสุด:</strong> @goaltask.EndDate?.ToString("dd/MM/yyyy")</p>
                    <p><strong>Wheel of Life:</strong> @(goaltask.WOL?.Name ?? "N/A")</p>
                </div>
                <div class="col-md-6">
                    <p><strong>ความก้าวหน้า (Progress):</strong> @goaltask.progress</p>
                    <p><strong>คำอธิบายเพิ่มเติม (Description):</strong> @goaltask.Description</p>
                    <p><strong>สิ่งที่ได้เรียนรู้ (Learning):</strong> @goaltask.Lesson2</p>
                </div>
            </div>
        }
    </div>
</div>

<!-- Activity Section -->
<div class="card mb-4">
    <div class="card-header  text-danger">
        <h3>รายละเอียดกิจกรรม</h3>
    </div>
    <div class="card-body">
        <button class="btn btn-danger mb-3" @onclick="ShowAddActivityForm">เพิ่ม</button>
        <p class="text-muted">รายการกิจกรรม ลด ได้อีกหรือไม่ / ไม่เกิน 14 item e</p>

        <ul class="list-group">
            @if (Activities != null && Activities.Any())
            {
                @foreach (var activity in Activities)
                {
                    <li class="list-group-item">
                        <strong>@(activity.Order?.ToString() ?? "-"). </strong> @activity.Name - สถานะ: @activity.StatusCode
                    </li>
                }
            }
            else
            {
                <li class="list-group-item">No activities added yet.</li>
            }
        </ul>
    </div>
</div>

<!-- Add Activity Form -->
@if (ShowActivityForm)
{
    <div class="card">
        <div class="card-body bg-light">
            <h4>เพิ่มกิจกรรม</h4>
            <EditForm Model="NewActivity" OnValidSubmit="AddActivity">
                <div class="mb-3">
                    <label for="order" class="form-label">Order:</label>
                    <InputNumber id="order" @bind-Value="NewActivity.Order" class="form-control" />
                    <ValidationMessage For="() => NewActivity.Order" />
                </div>

                <div class="mb-3">
                    <label for="Name" class="form-label">Activity:</label>
                    <InputText id="Name" @bind-Value="NewActivity.Name" class="form-control" />
                    <ValidationMessage For="() => NewActivity.Name" />
                </div>


                <button type="submit" class="btn btn-primary">Save</button>
                <button type="button" class="btn btn-secondary ml-2" @onclick="HideAddActivityForm">ยกเลิก</button>
            </EditForm>
        </div>
    </div>
}

<div class="mt-4">
    <a href="@($"/goaltasks")" class="btn btn-outline-danger">Back to List</a>
</div>

@code {
    private GoalTask? goaltask;
    private List<Activity> Activities = new List<Activity>();
    private Activity NewActivity = new Activity();
    private bool ShowActivityForm = false;

    [Parameter]
    public int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        goaltask = await context.GoalTasks.Include(g => g.WOL).FirstOrDefaultAsync(m => m.Id == Id);

        if (goaltask is null)
        {
            NavigationManager.NavigateTo("notfound");
        }

        // Load related activities for this goal task
        Activities = await context.Activity.Where(a => a.TaskId == goaltask.Id).ToListAsync();
    }

    private void ShowAddActivityForm()
    {
        ShowActivityForm = true;
        NewActivity = new Activity
            {
                TaskId = goaltask.Id,
                GoalTask = goaltask // Set GoalTask to the current goal task
            };
    }

    private void HideAddActivityForm()
    {
        ShowActivityForm = false;
    }

    private async Task AddActivity()
    {
        using var context = DbFactory.CreateDbContext();
        context.Activity.Add(NewActivity);
        await context.SaveChangesAsync();

        Activities.Add(NewActivity);
        HideAddActivityForm();
    }

    private async Task CancelGoalTask()
    {
        if (goaltask != null)
        {
            using var context = DbFactory.CreateDbContext();
            goaltask.IsActive = false;
            await context.SaveChangesAsync();
            NavigationManager.NavigateTo("/goaltasks");
        }
    }

    private async Task StartGoalTask()
    {
        if (goaltask != null)
        {
            using var context = DbFactory.CreateDbContext();
            goaltask.IsActive = true;
            await context.SaveChangesAsync();
            NavigationManager.NavigateTo("/goaltasks");
        }
    }
}
