@page "/goaltasks/details/{Id:int}"
@using HRM.Data
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using HRM.Model
@using System.ComponentModel.DataAnnotations
@inject IDbContextFactory<HRM.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@inject ActivityService ActivityService
@inject UserService UserService

@attribute [Authorize]

<PageTitle>Goal Task Details</PageTitle>
@if (isOwner)
{
    <h4>เพิ่มการวางแผนกิจกรรมอย่างเป็นระบบสู่เป้าหมาย</h4>
}
else
{
    <h4>การวางแผนกิจกรรมอย่างเป็นระบบสู่เป้าหมาย @* ของ @currentUser *@ </h4>
}

<!-- Goal Task Details Section -->
<div class="card border-danger mb-4">
    <div class="card-header bg-info text-white d-flex justify-content-between">
        <h2>รายละเอียดเป้าหมาย</h2>
        <div>


            @*  <button class="btn btn-light btn-sm text-danger mr-2" @onclick="EditGoalTask">แก้ไขเป้าหมาย</button>

            <button class="btn btn-success btn-sm" @onclick="CancelGoalTask">ยกเลิกเป้าหมาย</button> *@

        </div>
    </div>
    <div class="card-body">
        @if (goaltask is null)
        {
            <p><em>Loading...</em></p>
        }
        else
        {
            <div class="row">
                <div class="col-md-6">
                    <p>
                        <strong>

                              @((typeof(GoalTask).GetProperty(nameof(GoalTask.Name))?.GetCustomAttributes(typeof(DisplayAttribute), false)
                           .FirstOrDefault() as DisplayAttribute)?.Name ?? "Name") : @goaltask.Name
                        </strong>  
                    </p>
                    <p>
                        <strong>
                            สถานะ/Status : @goaltask.status     ระยะเวลา   @goaltask.DayofGoal วัน วันที่สิ้นสุด @goaltask.EndDate?.ToString("dd/MM/yyyy") 
                        </strong>
                    </p>


                </div>





                <div class="col-md-6">
                    @*   <p>
                        <strong>
                            @((typeof(GoalTask).GetProperty(nameof(GoalTask.Lesson1))?.GetCustomAttributes(typeof(DisplayAttribute), false)
                                .FirstOrDefault() as DisplayAttribute)?.Name ?? "Name") :
                        </strong> @goaltask.Lesson1
                    </p>
                    <p>
                        <strong>
                            @((typeof(GoalTask).GetProperty(nameof(GoalTask.Lesson2))?.GetCustomAttributes(typeof(DisplayAttribute), false)
                                .FirstOrDefault() as DisplayAttribute)?.Name ?? "Name") :
                        </strong> @goaltask.Lesson2
                    </p> *@
                    @if ((goaltask.status == GoalTask.GoalTaskStatus.Success || goaltask.status == GoalTask.GoalTaskStatus.Cancel || goaltask.status == GoalTask.GoalTaskStatus.Overtime))
                    {
                        <p>
                            <strong>
                                     @((typeof(GoalTask).GetProperty(nameof(GoalTask.ThankFully))?.GetCustomAttributes(typeof(DisplayAttribute), false)
                            .FirstOrDefault() as DisplayAttribute)?.Name ?? "ThankFully") :
                            </strong> @goaltask.ThankFully
                        </p>
                    }
                    <p>
                        <strong>
                                    @((typeof(GoalTask).GetProperty(nameof(GoalTask.progress))?.GetCustomAttributes(typeof(DisplayAttribute), false)
                        .FirstOrDefault() as DisplayAttribute)?.Name ?? "Progress") :
                        </strong> @goaltask.progress %

                    </p>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <strong>
                        @*                         (5)   @((typeof(GoalTask).GetProperty(nameof(GoalTask.progress))?.GetCustomAttributes(typeof(DisplayAttribute), false)
 *@             
 
                    </strong> @* @goaltask.progress % *@
                    (หมายเหตุ: เป้าหมายจะสำเร็จ ต้องมี ความก้าวหน้า 80% ขึ้น ไป /  Progress equal 80% or more , you can finish of your goal )
                </div>

            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="progress">
                        <div class="progress-bar" role="progressbar" style="width: @goaltask.progress%" aria-valuenow="@goaltask.progress" aria-valuemin="0" aria-valuemax="100">
                            @goaltask.progress%
                        </div>
                    </div>
                </div>

            </div>
            <hr />

            @*             <div>Status: @goaltask.status | Owner: @isOwner</div>
 *@            @if (isOwner)
            {
                @if (!(goaltask.status == GoalTask.GoalTaskStatus.Success) && !(goaltask.status == GoalTask.GoalTaskStatus.Overtime))
                {
                    <button id="editgoal" class="btn btn-primary btn-sm" @onclick="EditGoalTask">แก้ไขเป้าหมาย</button>

                    @if (!(goaltask.status == GoalTask.GoalTaskStatus.Cancel))
                    {
                        <button id="cancelgoal" class="btn btn-danger btn-sm" @onclick="CancelGoalTask">ยกเลิกเป้าหมาย</button>
                        @if (goaltask.progress >= 80)
                        {
                            <button id="cancelgoal" class="btn btn-outline-primary btn-sm" @onclick="FinishGoalTask">เป้าหมายสำเร็จ/Finished</button>

                        }

                    }
                    @if ((goaltask.status == GoalTask.GoalTaskStatus.Cancel))
                    {
                        <button id="activegoal" class="btn btn-light btn-sm" @onclick="ActiveGoalTask">Active/เป้าหมาย</button>

                    }

                }
            }
        }
    </div>
</div>

<!-- Activity Section -->
<div class="card mb-4">
    <div class="mb-2">
        <div class="card-header  text-danger">
            <h4>รายละเอียดกิจกรรม</h4>
        </div>
    </div> <div class="mb-2"> <a href="/pdf/การวางแผนกิจกรรมเพื่อให้เป้าหมาย.pdf" target="_blank"> คำแนะนำการวางแผนอย่างเป็นระบบ</a></div>

    <div class="card-body">
        @if (goaltask is not null)
        {
            @if (!((goaltask.status == GoalTask.GoalTaskStatus.Success) || (goaltask.status == GoalTask.GoalTaskStatus.Cancel) || (goaltask.status == GoalTask.GoalTaskStatus.Overtime)))
            {
                @if (isOwner)
                {
                    <button class="btn btn-danger mb-3" @onclick="ShowAddActivityForm">เพิ่มกิจกรรม/Add Activity</button>
                }
            }
        }
        <p class="text-muted">รายการกิจกรรม  ไม่ควรเกิน 14 กิจกรรม</p>

        <ul class="list-group">
            @if (Activities != null && Activities.Any())
            {
                @foreach (var activity in Activities)
                {
                    <li class="list-group-item">

                        <strong>
                            @*   @(activity.Orders?.ToString() ?? "-").  *@
                            @if (activity.StatusCode == Activity.ActivityStatus.Success)
                            {
                                <button id="successshow" class="btn btn-success btn-sm">สำเร็จ</button>
                            }
                        </strong> @activity.Name - ความก้าวหน้า: @activity.progress % วันที่เริ่ม: @activity.StartDate?.ToString("dd/MM/yyyy")  ถึง  @activity.EndDate?.ToString("dd/MM/yyyy")
                        @if (isOwner)
                        {
                            @*                               <button class="btn btn-primary mb-3" @onclick="ManageActivity">จัดการกิจกรรม/ Manage</button>
 *@@* 
                            <a href="@($"activities/edit?subid={activity.Id}")"> จัดการกิจกรรม/ Manage</a> *@

                            @*    @if (!(goaltask?.status == GoalTask.GoalTaskStatus.Success) || !(goaltask?.status == GoalTask.GoalTaskStatus.Cancel) || !(goaltask?.status == GoalTask.GoalTaskStatus.Overtime))
                            {
                                <a class="btn btn-primary" href="@($"activities/edit?subid={activity.Id}")">
                                    จัดการกิจกรรม/ Manage
                                </a>

                            } *@

                            @if ((goaltask?.status == GoalTask.GoalTaskStatus.Active))
                            {
                                <a class="btn btn-primary" href="@($"activities/edit?subid={activity.Id}")">
                                    จัดการกิจกรรม/ Manage
                                </a>

                            }

                        }

                    </li>
                }
            }
            else
            {
                <li class="list-group-item">No activities added yet.</li>
            }
        </ul>
    </div>
</div>

<!-- Add Activity Form -->
@if (ShowActivityForm)
{
    <div class="card">
        <div class="card-body bg-light">
            <h4>เพิ่มกิจกรรม</h4>
            <EditForm Model="NewActivity" OnValidSubmit="AddActivity">


                <div class="mb-3">
                    @*                     <label for="taskid" class="form-label">Task ID:</label>
 *@                    <InputNumber id="taskid" @bind-Value="NewActivity.TaskId" class="form-control" hidden />
                    <ValidationMessage For="() => NewActivity.TaskId" />
                </div>
                <!-- Order Input -->
                <div class="mb-3">
                    <label for="order" class="form-label">
                        (auto) @((typeof(Activity).GetProperty(nameof(Activity.Orders))?.GetCustomAttributes(typeof(DisplayAttribute), false)
                     .FirstOrDefault() as DisplayAttribute)?.Name ?? "Order") :
                    </label>
                    <InputNumber id="order" @bind-Value="NewActivity.Orders" class="form-control" readonly />
                    <ValidationMessage For="() => NewActivity.Orders" />
                </div>

                <!-- Name Input -->
                <div class="mb-3">
                    <label for="Name" class="form-label">
                        @((typeof(Activity).GetProperty(nameof(Activity.Name))?.GetCustomAttributes(typeof(DisplayAttribute), false)
                            .FirstOrDefault() as DisplayAttribute)?.Name ?? "Name")
                    </label>
                    <InputText id="Name" @bind-Value="NewActivity.Name" class="form-control" />
                    <ValidationMessage For="() => NewActivity.Name" />
                </div>

                <!-- StartDate Input -->
                <div class="mb-3">
                    <label for="StartDate" class="form-label">
                        @((typeof(Activity).GetProperty(nameof(Activity.StartDate))?.GetCustomAttributes(typeof(DisplayAttribute), false)
                            .FirstOrDefault() as DisplayAttribute)?.Name ?? "Start Date")
                    </label>
                    <InputDate id="StartDate" @bind-Value="NewActivity.StartDate" class="form-control" />
                    <ValidationMessage For="() => NewActivity.StartDate" />
                </div>

                <!-- EndDate Input -->
                <div class="mb-3">
                    <label for="EndDate" class="form-label">
                        @((typeof(Activity).GetProperty(nameof(Activity.EndDate))?.GetCustomAttributes(typeof(DisplayAttribute), false)
                            .FirstOrDefault() as DisplayAttribute)?.Name ?? "End Date")
                    </label>
                    <InputDate id="EndDate" @bind-Value="NewActivity.EndDate" class="form-control" />
                    <ValidationMessage For="() => NewActivity.EndDate" />
                </div>

                <button type="submit" class="btn btn-primary">Save</button>
                <button type="button" class="btn btn-secondary ml-2" @onclick="HideAddActivityForm">Cancel</button>
            </EditForm>


        </div>
    </div>
}
@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger">
        @ErrorMessage
    </div>
}

<div class="mt-4">
    <a href="@($"/goaltasks/maingoal")" class="btn btn-outline-danger">ไปรายการเป้าหมาย</a>
</div>

@code {
    private GoalTask? goaltask;
    private List<Activity> Activities = new List<Activity>();
    private Activity NewActivity = new Activity();
    private bool ShowActivityForm = false;
    private bool isOwner = false;
    private ApplicationDbContext context = default!;
    private string currentUser = "";



    [Parameter]
    public int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        context = DbFactory.CreateDbContext();
        goaltask = await context.GoalTasks.FindAsync(Id);
        isOwner = false;

        if (goaltask is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
        try
        {
            var loggedIn = UserService.GetUserId();
            currentUser = UserService.GetUserName();
            if (loggedIn is not null && goaltask is not null)
            {
                if (loggedIn == goaltask.OwnerID)
                {
                    isOwner = true;
                }

            }
        }
        catch (Exception e)
        {
            e.Message.ToString();
        }

        // Load related activities for this goal task
        Activities = await context.Activity.Where(a => a.TaskId == Id).ToListAsync();
    }

    private void ShowAddActivityForm()
    {
        ShowActivityForm = true;
        NewActivity = new Activity();
        NewActivity.TaskId = Id;  // This ensures the activity is linked to the current GoalTask
    }


    private void HideAddActivityForm()
    {
        ShowActivityForm = false;
    }
    private string ErrorMessage = string.Empty;



    private async Task AddActivity()
    {
        try
        {
            context = DbFactory.CreateDbContext();

            // Set the TaskId (foreign key) to the current GoalTask Id
            NewActivity.TaskId = Id;
            NewActivity.CreateDate = DateTime.UtcNow;
            NewActivity.ModDate = DateTime.UtcNow;
            NewActivity.progress = 0m;
            NewActivity.StatusCode = Activity.ActivityStatus.Active;


            // Add the new Activity without manually setting the Id
            await ActivityService.CreateNewActivityAsync(NewActivity);
            goaltask = await context.GoalTasks.FindAsync(Id);
            // context.Activity.Add(NewActivity);
            // await context.SaveChangesAsync();

            // Update the list of activities to reflect the newly added one
            Activities.Add(NewActivity);

            // Hide the form after adding
            HideAddActivityForm();
        }
        catch (Exception ex)
        {
            // Log the error message
            ErrorMessage = $"Error: {ex.Message}";
            System.Console.WriteLine(ErrorMessage);
        }
    }

    // private async Task CancelGoalTask()
    // {
    //     if (goaltask != null)
    //     {
    //         using var context = DbFactory.CreateDbContext();
    //         goaltask.IsActive = false;
    //         await context.SaveChangesAsync();
    //         NavigationManager.NavigateTo("/goaltasks");
    //     }
    // }



    private async Task StartGoalTask()
    {
        if (goaltask != null)
        {
            context = DbFactory.CreateDbContext();
            goaltask.IsActive = true;
            await context.SaveChangesAsync();
            NavigationManager.NavigateTo("/goaltasks");
        }
    }

    //// button click
    private void EditGoalTask()
    {
        // Logic for starting the goal task
        // e.g., change the task status to "In Progress" or something similar
        System.Console.WriteLine("Goal task started");
        NavigationManager.NavigateTo("/goaltasks/edit?id=" + Id);

    }

    private void CancelGoalTask()
    {
        // Logic for starting the goal task
        // e.g., change the task status to "In Progress" or something similar
        System.Console.WriteLine("Goal task started");
        NavigationManager.NavigateTo("/goaltasks/cancel?id=" + Id);

    }


    private void FinishGoalTask()
    {

        NavigationManager.NavigateTo("/goaltasks/finish?id=" + Id);

    }
    private void ManageActivity()
    {
        // Logic for starting the goal task
        // e.g., change the task status to "In Progress" or something similar
        System.Console.WriteLine("Goal task started");
        NavigationManager.NavigateTo("activities/edit?subid=" + Id);

    }

    private void ActiveGoalTask()
    {
        // Logic for starting the goal task
        // e.g., change the task status to "In Progress" or something similar
        System.Console.WriteLine("Goal task started");
        NavigationManager.NavigateTo("/goaltasks/active?id=" + Id);

    }

    // Dispose the DbContext
    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}