@code {

    private List<ScUser> coaches = new List<ScUser>();
    private List<ScUser> filteredCoaches = new List<ScUser>(); // List of coaches filtered by search
    private string searchQuery = ""; // Search input
    private string selectedCoachId = "";  // The selected coach's ID
    private List<WOL> wolOptions = new List<WOL>();

    private ApplicationDbContext context = default!;

    // Dispose the DbContext
    public async ValueTask DisposeAsync() => await context.DisposeAsync();

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    [SupplyParameterFromForm]
    private GoalTask? GoalTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        GoalTask ??= await context.GoalTasks.FirstOrDefaultAsync(m => m.Id == Id);
        coaches = await context.ScUsers.Where(u => u.IsCoach).ToListAsync();
        wolOptions = context.WOLs.ToList();

        // coaches = await GoalTaskService.GetAllCoachesAsync();
        filteredCoaches = coaches; // Initialize the filtered list
        if (GoalTask is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateGoalTask()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(GoalTask!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!GoalTaskExists(GoalTask!.Id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/goaltasks/maingoal");
    }


    // Method to filter coaches based on search query
    private void FilterCoaches(ChangeEventArgs e)
    {
        if (string.IsNullOrWhiteSpace(searchQuery))
        {
            filteredCoaches = coaches; // Show all coaches if no search query
        }
        else
        {
            //  filteredCoaches = coaches.Where(c => c.Firstname.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)).ToList();
            filteredCoaches = coaches.Where(c => c.Firstname.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)).ToList();

        }


    }

    private void OnStartDateChanged(ChangeEventArgs e)
    {
        if (GoalTask is not null)
        {
            if (DateTime.TryParse(e.Value?.ToString(), out DateTime newStartDate))
            {
                GoalTask.Startdate = newStartDate;  // Update the GoalTask's Startdate
                CheckAndUpdateEndDate(); // Recalculate EndDate
            }
        }
    }

    private void CheckAndUpdateEndDate()
    {
        if (GoalTask is not null)
        {
            if (GoalTask.DayofGoal.HasValue && GoalTask.Startdate.HasValue)
            {
                GoalTask.CalculateEndDate(); // Update EndDate based on DayofGoal and Startdate
                StateHasChanged(); // Ensure the UI refreshes
            }
        }
    }

    private void OnDayOfGoalChanged(ChangeEventArgs e)
    {
        if (GoalTask is not null)
        {
            if (double.TryParse(e.Value?.ToString(), out double newDayofGoal))
            {
                GoalTask.DayofGoal = newDayofGoal;  // Update the GoalTask's DayofGoal
                CheckAndUpdateEndDate(); // Recalculate EndDate
            }
        }
    }


    private bool GoalTaskExists(int id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.GoalTasks.Any(e => e.Id == id);
    }
}
