    private async Task AddActivity()
    {
        try
        {
            using var context = DbFactory.CreateDbContext();

            // Set the TaskId (foreign key) to the current GoalTask Id
            NewActivity.TaskId = Id;
            NewActivity.CreateDate = DateTime.UtcNow;
            NewActivity.ModDate = DateTime.UtcNow;

            // Add the new Activity without manually setting the Id
            context.Activity.Add(NewActivity);
            await context.SaveChangesAsync();

            // Update the list of activities to reflect the newly added one
            Activities.Add(NewActivity);

            // Hide the form after adding
            HideAddActivityForm();
        }
        catch (Exception ex)
        {
            // Log the error message
            ErrorMessage = $"Error: {ex.Message}";
            Console.WriteLine(ErrorMessage);
        }
    }


    private async Task CancelGoalTask()
    {
        if (goaltask != null)
        {
            using var context = DbFactory.CreateDbContext();
            goaltask.IsActive = false;
            await context.SaveChangesAsync();
            NavigationManager.NavigateTo("/goaltasks");
        }
    }

    private async Task StartGoalTask()
    {
        if (goaltask != null)
        {
            using var context = DbFactory.CreateDbContext();
            goaltask.IsActive = true;
            await context.SaveChangesAsync();
            NavigationManager.NavigateTo("/goaltasks");
        }
    }
}
