@page "/goaltasks/Maingoal"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using LeaderDevelop.Model
@using LeaderDevelop.Data
@implements IAsyncDisposable
@inject IDbContextFactory<LeaderDevelop.Data.ApplicationDbContext> DbFactory

<PageTitle>รายการเป้าหมาย</PageTitle>

<h1>รายการเป้าหมาย</h1>

<p>
    <a href="goaltasks/create">เพิ่มเป้าหมาย/Add New Goal</a>
</p>

<QuickGrid Class="table" Items="context.GoalTasks">
    <PropertyColumn Property="goaltask => goaltask.wol" Title="ประเภท/Mode" />
    <PropertyColumn Property="goaltask => goaltask.Name" Title="เป้าหมาย/Goal" />
    <PropertyColumn Property="goaltask => goaltask.progress" Title="ความก้าวหน้า/Progress" />
    <PropertyColumn Property="goaltask => goaltask.Startdate" Title="วันที่เริ่ม/Start Date" />
    <PropertyColumn Property="goaltask => goaltask.EndDate" Title="วันที่สิ้นสุด/End Date" />
    <PropertyColumn Property="goaltask => goaltask.Description" Title="อธิบายเพิ่มเติม/Description" />
    <PropertyColumn Property="goaltask => goaltask.Lesson1" Title="สิ่งที่ได้รับ/got idea" />
    <PropertyColumn Property="goaltask => goaltask.Lesson2" Title="สิ่งที่ได้เรียนรู้/Learning" />
    <PropertyColumn Property="goaltask => goaltask.ThankFully" Title="คำขอบคุณ/ThankFully" />

@* 
    <PropertyColumn Property="goaltask => goaltask.Name" />
    <PropertyColumn Property="goaltask => goaltask.Startdate" />
    <PropertyColumn Property="goaltask => goaltask.EndDate" />
    <PropertyColumn Property="goaltask => goaltask.progress" />
    <PropertyColumn Property="goaltask => goaltask.Description" />
    <PropertyColumn Property="goaltask => goaltask.wol" />
    <PropertyColumn Property="goaltask => goaltask.Lesson1" />
    <PropertyColumn Property="goaltask => goaltask.Lesson2" />
    <PropertyColumn Property="goaltask => goaltask.ThankFully" />
    <PropertyColumn Property="goaltask => goaltask.ModDate" Title="วันที่แก้/Modify Date" /> *@

    <!-- Add the ModDate property here -->
    <PropertyColumn Property="goaltask => goaltask.ModDate" Title="วันที่แก้/Modify Date" />

    <TemplateColumn Context="goaltask">
        <a href="@($"goaltasks/edit?id={goaltask.Id}")">แก้ไข</a> |
        <a href="@($"goaltasks/details/{goaltask.Id}")">ดู</a>
    </TemplateColumn>
</QuickGrid>


@code {
    private ApplicationDbContext context = default!;

    protected override void OnInitialized()
    {
        try
        {
            context = DbFactory.CreateDbContext();
        }catch(Exception e)
        {
            e.Message.ToString();
        }
    }
    
    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
