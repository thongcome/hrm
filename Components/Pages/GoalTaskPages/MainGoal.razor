@page "/goaltasks/Maingoal"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using LeaderDevelop.Model
@using LeaderDevelop.Data
@implements IAsyncDisposable
@inject IDbContextFactory<LeaderDevelop.Data.ApplicationDbContext> DbFactory
@inject UserService UserService;

@attribute [Authorize]

<PageTitle>รายการเป้าหมาย</PageTitle>

@* <h3>รายการเป้าหมาย</h3> 

 *@<p>
<p>
    <h4> % of Goal completion : @facililatorScore.ToString("0.00")</h4>
</p>
    <a href="goaltasks/create">เพิ่มเป้าหมาย/Add New Goal</a>
</p>
@if (GoalTaskList != null && GoalTaskList.Any())
{
    <QuickGrid Class="table" Items="GoalTaskList" TItem="GoalTask" Sortable="true">


        <PropertyColumn Property="goaltask => goaltask.wol" Title="ประเภท/Mode" />
        <PropertyColumn Property="goaltask => goaltask.Name" Title="เป้าหมาย/Goal" />
        <PropertyColumn Property="goaltask => goaltask.progress" Title="% of Goal completion" />
@*         <PropertyColumn Property="goaltask => goaltask.Startdate" Title="วันที่เริ่ม/Start Date" />
 *@        <PropertyColumn Property="goaltask => goaltask.EndDate" Title="วันที่สิ้นสุด/End Date" />
  
    @*     <PropertyColumn Property="goaltask => goaltask.Lesson1" Title="สิ่งที่ได้รับ/got idea" />
        <PropertyColumn Property="goaltask => goaltask.Lesson2" Title="สิ่งที่ได้เรียนรู้/Learning" /> *@
        <PropertyColumn Property="goaltask => goaltask.ThankFully" Title="สิ่งที่ได้เรียนรู้" />



        <TemplateColumn Context="goaltask">
            <a href="@($"goaltasks/edit?id={goaltask.Id}")">แก้ไข</a> |
            <a href="@($"goaltasks/details/{goaltask.Id}")">รายการกิจกรรม</a>
        </TemplateColumn>
    </QuickGrid>
}
@code {
    private ApplicationDbContext context = default!;
    private IQueryable<GoalTask> GoalTaskList = default!;
    private decimal facililatorScore = 0.00M;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            context = await DbFactory.CreateDbContextAsync();
            var userId = UserService.GetUserId();
            if (!String.IsNullOrEmpty(userId))
            {
                // Use AsQueryable for deferred execution
                GoalTaskList = context.GoalTasks
                    .Where(b => b.OwnerID == userId)
                    .OrderByDescending(b => b.Startdate)
                    .AsQueryable();
            }
            // var avgScore = GoalTaskList.Where(x => x.status != GoalTask.GoalTaskStatus.Cancel).Average(x => x.progress);

            var avgScore = GoalTaskList.Average(x => x.progress);
            if (avgScore != null)
            {
                facililatorScore = (decimal)avgScore;
                // var user = context.ScUsers.Where(x => x.Id == userId).FirstOrDefault();
                // if(user is not null)
                // {
                //     user.score = facililatorScore;
                //     await context.SaveChangesAsync();

                // }

            }
        }
        catch (Exception e)
        {
            Console.WriteLine(e.Message); // Log the exception
           
        }
    }

    // Dispose the DbContext
    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}