                <InputNumber id="salarycalseq" @bind-Value="HrwOt.SalaryCalSeq" class="form-control" /> 
                <ValidationMessage For="() => HrwOt.SalaryCalSeq" class="text-danger" /> 
            </div>        
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/hrwots">Back to List</a>
</div>

@code {
    [SupplyParameterFromForm]
    private HrwOt HrwOt { get; set; } = new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddHrwOt()
    {
        using var context = DbFactory.CreateDbContext();
        context.HrwOts.Add(HrwOt);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/hrwots");
    }
}
