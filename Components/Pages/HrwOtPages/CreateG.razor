            </div>        
            <div class="mb-3">
                <label for="otamt" class="form-label">OtAmt:</label> 
                <InputNumber id="otamt" @bind-Value="HrwOt.OtAmt" class="form-control" /> 
                <ValidationMessage For="() => HrwOt.OtAmt" class="text-danger" /> 
            </div>        
            <div class="mb-3">
