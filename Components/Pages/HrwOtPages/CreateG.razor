                <InputText id="workin" @bind-Value="HrwOt.WorkIn" class="form-control" /> 
                <ValidationMessage For="() => HrwOt.WorkIn" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="workout" class="form-label">WorkOut:</label> 
                <InputText id="workout" @bind-Value="HrwOt.WorkOut" class="form-control" /> 
                <ValidationMessage For="() => HrwOt.WorkOut" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="workotin" class="form-label">WorkotIn:</label> 
