@page "/hrwots/create"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using HRM.Models
@inject IDbContextFactory<HRM.Models.HRMContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>HrwOt</h2>
<hr />
<div class="row">
