            <dd class="col-sm-10">@hrwot.SalaryCalSeq</dd>
        </dl>
        <EditForm method="post" Model="hrwot" OnValidSubmit="DeleteHrwOt" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(hrwot is null)">Delete</button> |
            <a href="/hrwots">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private HrwOt? hrwot;

    [SupplyParameterFromQuery]
    private long ID { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        hrwot = await context.HrwOts.FirstOrDefaultAsync(m => m.ID == ID);

        if (hrwot is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteHrwOt()
    {
        using var context = DbFactory.CreateDbContext();
        context.HrwOts.Remove(hrwot!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/hrwots");
    }
}
