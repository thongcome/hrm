@page "/hrwot/index"
@inject HRMContext Db
@using HRM.Models
@using Microsoft.EntityFrameworkCore
@using MudBlazor

<PageTitle>OT Records</PageTitle>

<MudPaper Class="pa-4">
    <MudText Typo="Typo.h5">OT Records</MudText>
    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Create">Add New</MudButton>
    <MudTable Items="_data" Hover="true" Dense="true">
        <HeaderContent>
            <MudTh>EmpNo</MudTh>
            <MudTh>SeqNo</MudTh>
            <MudTh>Remark</MudTh>
            <MudTh>DateWork</MudTh>
            <MudTh>Action</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.EmpNo</MudTd>
            <MudTd>@context.SeqNo</MudTd>
            <MudTd>@context.Remark</MudTd>
            <MudTd>@(context.DateWork?.ToString("yyyy-MM-dd"))</MudTd>
            <MudTd>
                <MudButton Color="Color.Info" OnClick="@(() => Edit(context.ID))">Edit</MudButton>
                <MudButton Color="Color.Error" OnClick="@(() => Delete(context.ID))">Delete</MudButton>
            </MudTd>
        </RowTemplate>
    </MudTable>
</MudPaper>

@code {
    private List<HrwOt> _data = new();

    protected override async Task OnInitializedAsync()
    {
        _data = await Db.HrwOts.ToListAsync();
    }

    void Create() => NavTo.NavigateTo("/hrwot/create");
    void Edit(long id) => NavTo.NavigateTo($"/hrwot/edit/{id}");
    void Delete(long id)
    {
        var item = _data.FirstOrDefault(x => x.ID == id);
        if (item != null)
        {
            Db.HrwOts.Remove(item);
            Db.SaveChanges();
            _data.Remove(item);
        }
    }

    [Inject] NavigationManager NavTo { get; set; }
}