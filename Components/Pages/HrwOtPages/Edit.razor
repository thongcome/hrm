@page "/hrwot/edit/{id:long}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@inject HRMContext Db
@inject NavigationManager NavTo
@using HRM.Models
@using MudBlazor

<EditForm Model="_item" OnValidSubmit="Save">
    <MudPaper Class="pa-4">
        <MudText Typo="Typo.h5">Edit OT Record</MudText>
        <MudTextField @bind-Value="_item.EmpNo" Label="Emp No" Required="true" />
        <MudNumericField @bind-Value="_item.SeqNo" Label="Seq No" />
        <MudTextField @bind-Value="_item.Remark" Label="Remark" />
        <MudDatePicker @bind-Date="_item.DateWork" Label="Date Work" />
        <MudButton Type="Submit" Color="Color.Primary">Save</MudButton>
        <MudButton Color="Color.Secondary" OnClick="@(() => NavTo.NavigateTo("/hrwot"))">Cancel</MudButton>
    </MudPaper>
</EditForm>

@code {
    [Parameter] public long id { get; set; }

    private HrwOt _item = new();

    protected override async Task OnInitializedAsync()
    {
        var record = await Db.HrwOts.FindAsync(id);
        if (record != null)
            _item = record;
    }

    async Task Save()
    {
        await Db.SaveChangesAsync();
        NavTo.NavigateTo("/hrwot");
    }
}