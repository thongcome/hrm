<div>
    <a href="/hrwots">Back to List</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private long ID { get; set; }

    [SupplyParameterFromForm]
    private HrwOt? HrwOt { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        HrwOt ??= await context.HrwOts.FirstOrDefaultAsync(m => m.ID == ID);

        if (HrwOt is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateHrwOt()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(HrwOt!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!HrwOtExists(HrwOt!.ID))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/hrwots");
    }

    private bool HrwOtExists(long id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.HrwOts.Any(e => e.ID == id);
    }
}
