@page "/sc_users/details"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using HRM.Models
@inject IDbContextFactory<HRM.Models.HRMContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<div>
    <h2>sc_user</h2>
    <hr />
    @if (sc_user is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">firstname</dt>
            <dd class="col-sm-10">@sc_user.firstname</dd>
            <dt class="col-sm-2">lastname</dt>
            <dd class="col-sm-10">@sc_user.lastname</dd>
            <dt class="col-sm-2">loginname</dt>
            <dd class="col-sm-10">@sc_user.loginname</dd>
            <dt class="col-sm-2">password</dt>
            <dd class="col-sm-10">@sc_user.password</dd>
            <dt class="col-sm-2">phone</dt>
            <dd class="col-sm-10">@sc_user.phone</dd>
            <dt class="col-sm-2">mobilephone</dt>
            <dd class="col-sm-10">@sc_user.mobilephone</dd>
            <dt class="col-sm-2">isforcechanged</dt>
            <dd class="col-sm-10">@sc_user.isforcechanged</dd>
            <dt class="col-sm-2">isdisable</dt>
            <dd class="col-sm-10">@sc_user.isdisable</dd>
            <dt class="col-sm-2">iscancel</dt>
            <dd class="col-sm-10">@sc_user.iscancel</dd>
            <dt class="col-sm-2">pwdexpdate</dt>
            <dd class="col-sm-10">@sc_user.pwdexpdate</dd>
            <dt class="col-sm-2">lasttimelogin</dt>
            <dd class="col-sm-10">@sc_user.lasttimelogin</dd>
            <dt class="col-sm-2">invalidpwcount</dt>
            <dd class="col-sm-10">@sc_user.invalidpwcount</dd>
            <dt class="col-sm-2">lastinvalidpwd</dt>
            <dd class="col-sm-10">@sc_user.lastinvalidpwd</dd>
            <dt class="col-sm-2">remark</dt>
            <dd class="col-sm-10">@sc_user.remark</dd>
            <dt class="col-sm-2">title</dt>
            <dd class="col-sm-10">@sc_user.title</dd>
            <dt class="col-sm-2">upperuserid</dt>
            <dd class="col-sm-10">@sc_user.upperuserid</dd>
            <dt class="col-sm-2">orgname</dt>
            <dd class="col-sm-10">@sc_user.orgname</dd>
            <dt class="col-sm-2">orgcode</dt>
            <dd class="col-sm-10">@sc_user.orgcode</dd>
            <dt class="col-sm-2">startdate</dt>
            <dd class="col-sm-10">@sc_user.startdate</dd>
            <dt class="col-sm-2">enddate</dt>
            <dd class="col-sm-10">@sc_user.enddate</dd>
            <dt class="col-sm-2">remindpwd</dt>
            <dd class="col-sm-10">@sc_user.remindpwd</dd>
            <dt class="col-sm-2">social</dt>
            <dd class="col-sm-10">@sc_user.social</dd>
            <dt class="col-sm-2">langcode</dt>
            <dd class="col-sm-10">@sc_user.langcode</dd>
            <dt class="col-sm-2">sex_sexid</dt>
            <dd class="col-sm-10">@sc_user.sex_sexid</dd>
            <dt class="col-sm-2">title_titleid</dt>
            <dd class="col-sm-10">@sc_user.title_titleid</dd>
            <dt class="col-sm-2">moddate</dt>
            <dd class="col-sm-10">@sc_user.moddate</dd>
            <dt class="col-sm-2">modby</dt>
            <dd class="col-sm-10">@sc_user.modby</dd>
            <dt class="col-sm-2">empid</dt>
            <dd class="col-sm-10">@sc_user.empid</dd>
            <dt class="col-sm-2">orgid</dt>
            <dd class="col-sm-10">@sc_user.orgid</dd>
            <dt class="col-sm-2">isroot</dt>
            <dd class="col-sm-10">@sc_user.isroot</dd>
            <dt class="col-sm-2">email</dt>
            <dd class="col-sm-10">@sc_user.email</dd>
            <dt class="col-sm-2">isEmployee</dt>
            <dd class="col-sm-10">@sc_user.isEmployee</dd>
            <dt class="col-sm-2">poscode</dt>
            <dd class="col-sm-10">@sc_user.poscode</dd>
            <dt class="col-sm-2">pos_name</dt>
            <dd class="col-sm-10">@sc_user.pos_name</dd>
            <dt class="col-sm-2">isActivate</dt>
            <dd class="col-sm-10">@sc_user.isActivate</dd>
            <dt class="col-sm-2">vendorCode</dt>
            <dd class="col-sm-10">@sc_user.vendorCode</dd>
            <dt class="col-sm-2">isVendor</dt>
            <dd class="col-sm-10">@sc_user.isVendor</dd>
            <dt class="col-sm-2">isAccept</dt>
            <dd class="col-sm-10">@sc_user.isAccept</dd>
            <dt class="col-sm-2">vendorid</dt>
            <dd class="col-sm-10">@sc_user.vendorid</dd>
            <dt class="col-sm-2">supervisor</dt>
            <dd class="col-sm-10">@sc_user.supervisor</dd>
            <dt class="col-sm-2">costcenter</dt>
            <dd class="col-sm-10">@sc_user.costcenter</dd>
            <dt class="col-sm-2">verifycode</dt>
            <dd class="col-sm-10">@sc_user.verifycode</dd>
            <dt class="col-sm-2">registerdate</dt>
            <dd class="col-sm-10">@sc_user.registerdate</dd>
            <dt class="col-sm-2">isHeader</dt>
            <dd class="col-sm-10">@sc_user.isHeader</dd>
            <dt class="col-sm-2">ref1</dt>
            <dd class="col-sm-10">@sc_user.ref1</dd>
            <dt class="col-sm-2">ref2</dt>
            <dd class="col-sm-10">@sc_user.ref2</dd>
            <dt class="col-sm-2">Companycode</dt>
            <dd class="col-sm-10">@sc_user.Companycode</dd>
        </dl>
        <div>
            <a href="@($"/sc_users/edit?userid={sc_user.userid}")">Edit</a> |
            <a href="@($"/sc_users")">Back to List</a>
        </div>
    }
</div>

@code {
    private sc_user? sc_user;

    [SupplyParameterFromQuery]
    private long userid { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        sc_user = await context.sc_users.FirstOrDefaultAsync(m => m.userid == userid);

        if (sc_user is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
