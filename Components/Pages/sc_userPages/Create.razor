@code {
    [SupplyParameterFromForm]
    private sc_user sc_user { get; set; } = new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task Addsc_user()
    {
        try
        {
            // รหัสผ่านเริ่มต้น
            string defaultPassword = "Abcd@2025";

            // ทำ Hash ตามมาตรฐาน .NET Identity
            sc_user.password = PasswordHasher.HashPassword(sc_user, defaultPassword);


            // var salt = PasswordHelper.GenerateSalt();
            // var hashed = PasswordHelper.HashPassword(plainPassword, salt);
            sc_user.company_id = 1;
            sc_user.isforcechanged = true;
            sc_user.isActivate = true;
            sc_user.isdisable = false;
            sc_user.iscancel = false;
            sc_user.moddate = DateTime.Now;
            sc_user.modby = "admin";

            using var context = DbFactory.CreateDbContext();
            context.sc_users.Add(sc_user);
            await context.SaveChangesAsync();
            NavigationManager.NavigateTo("/sc_users");

        }
        catch (Exception ex)
        {
            System.Console.WriteLine(ex.Message);
            return;

        }
    }


