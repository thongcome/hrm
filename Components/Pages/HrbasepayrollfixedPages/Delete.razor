@page "/hrbasepayrollfixeds/delete"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using HRM.Models
@inject IDbContextFactory<HRM.Models.HRMContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Hrbasepayrollfixed</h2>
    <hr />
    @if (hrbasepayrollfixed is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">companyid</dt>
            <dd class="col-sm-10">@hrbasepayrollfixed.companyid</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">EmpNo</dt>
            <dd class="col-sm-10">@hrbasepayrollfixed.EmpNo</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">SeqNo</dt>
            <dd class="col-sm-10">@hrbasepayrollfixed.SeqNo</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">SalitemCode</dt>
            <dd class="col-sm-10">@hrbasepayrollfixed.SalitemCode</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">ItemAmt</dt>
            <dd class="col-sm-10">@hrbasepayrollfixed.ItemAmt</dd>
        </dl>
        <EditForm method="post" Model="hrbasepayrollfixed" OnValidSubmit="DeleteHrbasepayrollfixed" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(hrbasepayrollfixed is null)">Delete</button> |
            <a href="/hrbasepayrollfixeds">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private Hrbasepayrollfixed? hrbasepayrollfixed;

    [SupplyParameterFromQuery]
    private long id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        hrbasepayrollfixed = await context.Hrbasepayrollfixed.FirstOrDefaultAsync(m => m.id == id);

        if (hrbasepayrollfixed is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteHrbasepayrollfixed()
    {
        using var context = DbFactory.CreateDbContext();
        context.Hrbasepayrollfixed.Remove(hrbasepayrollfixed!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/hrbasepayrollfixeds");
    }
}
