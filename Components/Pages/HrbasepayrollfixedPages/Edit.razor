@page "/hrbasepayrollfixeds/edit"
@using Microsoft.EntityFrameworkCore
@using HRM.Models
@inject IDbContextFactory<HRM.Models.HRMContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>Hrbasepayrollfixed</h2>
<hr />
@if (Hrbasepayrollfixed is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Hrbasepayrollfixed" OnValidSubmit="UpdateHrbasepayrollfixed" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                <input type="hidden" name="Hrbasepayrollfixed.id" value="@Hrbasepayrollfixed.id" />
                <div class="mb-3">
                    <label for="companyid" class="form-label">companyid:</label>
                    <InputText id="companyid" @bind-Value="Hrbasepayrollfixed.companyid" class="form-control" />
                    <ValidationMessage For="() => Hrbasepayrollfixed.companyid" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="empno" class="form-label">EmpNo:</label>
                    <InputText id="empno" @bind-Value="Hrbasepayrollfixed.EmpNo" class="form-control" />
                    <ValidationMessage For="() => Hrbasepayrollfixed.EmpNo" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="seqno" class="form-label">SeqNo:</label>
                    <InputNumber id="seqno" @bind-Value="Hrbasepayrollfixed.SeqNo" class="form-control" />
                    <ValidationMessage For="() => Hrbasepayrollfixed.SeqNo" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="salitemcode" class="form-label">SalitemCode:</label>
                    <InputText id="salitemcode" @bind-Value="Hrbasepayrollfixed.SalitemCode" class="form-control" />
                    <ValidationMessage For="() => Hrbasepayrollfixed.SalitemCode" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="itemamt" class="form-label">ItemAmt:</label>
                    <InputNumber id="itemamt" @bind-Value="Hrbasepayrollfixed.ItemAmt" class="form-control" />
                    <ValidationMessage For="() => Hrbasepayrollfixed.ItemAmt" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/hrbasepayrollfixeds">Back to List</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private long id { get; set; }

    [SupplyParameterFromForm]
    private Hrbasepayrollfixed? Hrbasepayrollfixed { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Hrbasepayrollfixed ??= await context.Hrbasepayrollfixed.FirstOrDefaultAsync(m => m.id == id);

        if (Hrbasepayrollfixed is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateHrbasepayrollfixed()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(Hrbasepayrollfixed!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!HrbasepayrollfixedExists(Hrbasepayrollfixed!.id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/hrbasepayrollfixeds");
    }

    private bool HrbasepayrollfixedExists(long id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Hrbasepayrollfixed.Any(e => e.id == id);
    }
}
