@code {
    private ALL_EMPLOYEE? all_employee;

    [SupplyParameterFromQuery]
    private long id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        all_employee = await context.ALL_EMPLOYEEs.FirstOrDefaultAsync(m => m.id == id);

        if (all_employee is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteALL_EMPLOYEE()
    {
        using var context = DbFactory.CreateDbContext();
        context.ALL_EMPLOYEEs.Remove(all_employee!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/all_employees");
    }
}
