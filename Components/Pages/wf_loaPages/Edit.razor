@page "/wf_loas/edit/{id:long}"
@using HRM.Models
@using HRM.Services.Workflow
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@attribute [Authorize(Policy = "Menu:WF_WORKFLOW_ADMIN")]
@inject IDbContextFactory<HRMContext> DbFactory
@inject NavigationManager NavigationManager

@if (loa is null)
{
    <p><em>Loading...</em></p>
}
else if (_locked)
{
    <div class="alert alert-warning">
        @WorkflowLockGuard.LockedMessage
        <br /><a href="/wf_loas">← กลับไปหน้ารายการ LOA</a>
    </div>
}
else
{
    <h3>Edit LOA #@loa.id</h3>
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger">@_error</div>
    }
    <EditForm Model="loa" OnValidSubmit="Save">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <h5 class="mt-3">อ้างอิง LOA (loaid / wfid)</h5>
        <div class="mb-3">
            <label class="form-label">LOA Id (loaid) — กลุ่มวงเงินที่ระดับนี้สังกัด</label>
            <InputNumber @bind-Value="loa.loaid" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Workflow ที่ใช้ LOA นี้ (wfid)</label>
            <InputNumber @bind-Value="loa.wfid" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Level Code (levelcode)</label>
            <InputText @bind-Value="loa.levelcode" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Org Code (orgcode) — เว้นว่าง = ใช้ได้ทุกหน่วยงาน</label>
            <InputText @bind-Value="loa.orgcode" class="form-control" />
        </div>

        <h5 class="mt-4">ช่วงวงเงิน (Min - Max)</h5>
        <div class="mb-3">
            <label class="form-label">วงเงินต่ำสุด (min)</label>
            <InputNumber @bind-Value="loa.min" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">วงเงินสูงสุด (max)</label>
            <InputNumber @bind-Value="loa.max" class="form-control" />
        </div>

        <h5 class="mt-4">ผลลัพธ์เมื่อเข้าเงื่อนไข</h5>
        <div class="mb-3">
            <label class="form-label">Workflow ปัจจุบัน (nowWorkflowid)</label>
            <InputNumber @bind-Value="loa.nowWorkflowid" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Level ปัจจุบัน (nowLevel)</label>
            <InputNumber @bind-Value="loa.nowLevel" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Workflow ถัดไป (nextWorkflowId)</label>
            <InputNumber @bind-Value="loa.nextWorkflowId" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Level ถัดไป (nextLevel)</label>
            <InputNumber @bind-Value="loa.nextLevel" class="form-control" />
        </div>
        <div class="mb-3 form-check">
            <input type="checkbox" class="form-check-input" @bind="loa.isactive" /> <label class="form-check-label">เปิดใช้งาน (isactive)</label>
        </div>

        <h5 class="mt-4">คำอธิบาย</h5>
        <div class="mb-3">
            <label class="form-label">หัวข้อ (subject)</label>
            <InputText @bind-Value="loa.subject" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Subject (EN)</label>
            <InputText @bind-Value="loa.subjectEn" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">คำอธิบาย (descript)</label>
            <InputTextArea @bind-Value="loa.descript" class="form-control" rows="2" />
        </div>
        <div class="mb-3">
            <label class="form-label">Description (EN)</label>
            <InputTextArea @bind-Value="loa.descriptEn" class="form-control" rows="2" />
        </div>

        <p class="text-muted small">หมายเหตุ: field <code>moddate</code> ระบบตั้งค่าอัตโนมัติตอนบันทึก ไม่ต้องกรอกเอง</p>

        <button class="btn btn-primary">Save</button>
        <a class="btn btn-secondary ms-2" href="/wf_loas">Cancel</a>
    </EditForm>
}

@code {
    [Parameter]
    public long id { get; set; }

    private wf_loa? loa;
    private bool _locked;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        using var db = DbFactory.CreateDbContext();
        loa = await db.wf_loas.FindAsync(id);
        if (loa is null)
        {
            NavigationManager.NavigateTo("/wf_loas");
            return;
        }
        var workflow = await db.wf_workflows.FindAsync(loa.nowWorkflowid);
        _locked = workflow?.isactive == true;
    }

    private async Task Save()
    {
        if (loa is null) return;
        _error = null;
        try
        {
            loa.moddate = DateTime.Now;
            using var db = DbFactory.CreateDbContext();
            await WorkflowLockGuard.EnsureLoaEditableAsync(db, loa.nowWorkflowid);
            db.wf_loas.Update(loa);
            await db.SaveChangesAsync();
            NavigationManager.NavigateTo("/wf_loas");
        }
        catch (Exception ex)
        {
            _error = "บันทึกไม่สำเร็จ: " + ex.Message;
        }
    }
}
