@page "/wf_loas/delete/{id:long}"
@using HRM.Models
@using HRM.Services.Workflow
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@attribute [Authorize(Policy = "Menu:WF_WORKFLOW_ADMIN")]
@inject IDbContextFactory<HRMContext> DbFactory
@inject NavigationManager NavigationManager

@code {
    [Parameter]
    public long id { get; set; }

    private wf_loa? loa;
    private bool _locked;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        using var db = DbFactory.CreateDbContext();
        loa = await db.wf_loas.FindAsync(id);
        if (loa is null)
        {
            NavigationManager.NavigateTo("/wf_loas");
            return;
        }
        var workflow = await db.wf_workflows.FindAsync(loa.nowWorkflowid);
        _locked = workflow?.isactive == true;
    }

    private async Task DeleteConfirmed()
    {
        if (loa is null) return;
        _error = null;
        try
        {
            using var db = DbFactory.CreateDbContext();
            await WorkflowLockGuard.EnsureLoaEditableAsync(db, loa.nowWorkflowid);
            var tracked = await db.wf_loas.FindAsync(loa.id);
            if (tracked is not null) db.wf_loas.Remove(tracked);
            await db.SaveChangesAsync();
            NavigationManager.NavigateTo("/wf_loas");
        }
        catch (Exception ex)
        {
            _error = "ลบไม่สำเร็จ: " + ex.Message;
        }
    }
}

@if (loa is null)
{
    <p><em>Not found</em></p>
}
else
{
    <h3>Delete LOA</h3>
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger">@_error</div>
    }
    @if (_locked)
    {
        <div class="alert alert-warning">@WorkflowLockGuard.LockedMessage</div>
    }
    <p>Are you sure you want to delete <strong>LOA #@loa.id (loaid @loa.loaid, level @loa.nowLevel, @loa.min - @loa.max)</strong>?</p>
    <button class="btn btn-danger" @onclick="DeleteConfirmed">Delete</button>
    <a class="btn btn-secondary ms-2" href="/wf_loas">Cancel</a>
}
