@page "/att/settings"
@using System.Security.Claims
@using HRM.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@inject JsonLocalizationService L
@attribute [Authorize(Policy = "Menu:ATT_ADMIN")]

<PageTitle>@L.Translate("AttSettingsPageTitle")</PageTitle>

<MudPaper Class="pa-4 mb-4" MaxWidth="700px">
    <MudText Typo="Typo.h5">@L.Translate("AttSettingsHeading")</MudText>
    <MudText Typo="Typo.body2" Class="mt-1">
        @L.Translate("AttSettingsDesc")
    </MudText>

    @if (string.IsNullOrEmpty(_companyId))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">@L.Translate("CompanyNotLinkedError")</MudAlert>
    }
    else if (_settings is null)
    {
        <MudProgressCircular Indeterminate="true" Class="mt-4" />
    }
    else
    {
        <MudDivider Class="my-4" />

        <MudRadioGroup T="AttTrackingMode" @bind-Value="_settings.TrackingMode">
            <MudRadio T="AttTrackingMode" Value="AttTrackingMode.None" Color="Color.Primary">
                @L.Translate("TrackingModeNoneLabel")
            </MudRadio>
            <MudRadio T="AttTrackingMode" Value="AttTrackingMode.SimpleInOut" Color="Color.Primary">
                @L.Translate("TrackingModeSimpleInOutLabel")
            </MudRadio>
            <MudRadio T="AttTrackingMode" Value="AttTrackingMode.ShiftBased" Color="Color.Primary">
                @L.Translate("TrackingModeShiftBasedLabel")
            </MudRadio>
        </MudRadioGroup>

        @if (_settings.TrackingMode == AttTrackingMode.SimpleInOut)
        {
            <MudGrid Class="mt-3">
                <MudItem xs="12" sm="6">
                    <MudTimePicker @bind-Time="_workStart" Label="@L.Translate("DefaultWorkStartLabel")" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTimePicker @bind-Time="_workEnd" Label="@L.Translate("DefaultWorkEndLabel")" />
                </MudItem>
            </MudGrid>
        }

        @if (_settings.TrackingMode != AttTrackingMode.None)
        {
            <MudCheckBox T="bool" @bind-Value="_settings.AllowWfh" Label="@L.Translate("AllowWfhLabel")" Class="mt-3" />
            <MudCheckBox T="bool" @bind-Value="_settings.AllowGpsCheckin" Label="@L.Translate("AllowGpsCheckinLabel")" Class="mt-1" />
            <MudCheckBox T="bool" @bind-Value="_settings.DetectAbsence" Label="ตรวจจับวันขาดงานอัตโนมัติ (วันทำงานที่ไม่มีการลงเวลา ไม่มีใบลาอนุมัติ และไม่ใช่วันหยุดบริษัท → บันทึกเป็นขาดงาน ให้เงินเดือนหักตามนโยบาย)" Class="mt-1" />
        }

        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
        }

        <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="mt-4" OnClick="SaveAsync">@L.Translate("SaveButton")</MudButton>
    }
</MudPaper>

@* เวลาเข้า-ออกงานต่อสาขา/หน่วยงาน (PST, 21 ก.ย. 2569: 2 สาขาเวลาไม่เหมือนกัน) — หน่วยงานลูกใช้ตามแม่จนกว่าจะตั้งเอง *@
@if (!string.IsNullOrEmpty(_companyId) && _settings is not null && _settings.TrackingMode != AttTrackingMode.None)
{
    <MudPaper Class="pa-4 mb-4" MaxWidth="900px">
        <MudText Typo="Typo.h6">เวลาเข้า-ออกงานของสาขา / หน่วยงาน</MudText>
        <MudText Typo="Typo.body2" Class="mt-1">
            ตั้งเฉพาะสาขาหรือหน่วยงานที่เวลาไม่เหมือนบริษัท — หน่วยงานที่อยู่ใต้ลงไปใช้เวลาเดียวกันโดยอัตโนมัติ ·
            ลำดับที่ระบบใช้ตัดสินมาสาย: กะที่มอบรายวัน → เวลาของหน่วยงาน (ไล่ขึ้นตามผัง) → เวลาของบริษัทด้านบน ·
            แก้แล้วให้กด "ประมวลผลเวลา" ของช่วงวันที่เกี่ยวข้องใหม่ที่หน้ารายงานเวลาเข้างาน
        </MudText>

        <MudGrid Class="mt-2">
            <MudItem xs="12" sm="5">
                <MudAutocomplete T="OrgOption" @bind-Value="_newOrg" SearchFunc="SearchOrgsAsync" ToStringFunc="@(o => o is null ? "" : o.Label)"
                    Label="สาขา / หน่วยงาน" Clearable="true" ResetValueOnEmptyText="true" />
            </MudItem>
            <MudItem xs="6" sm="2"><MudTimePicker @bind-Time="_newStart" Label="เวลาเข้า" /></MudItem>
            <MudItem xs="6" sm="2"><MudTimePicker @bind-Time="_newEnd" Label="เวลาออก" /></MudItem>
            <MudItem xs="12" sm="3" Class="d-flex align-center">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddOrgTimeAsync">บันทึกเวลาของหน่วยงานนี้</MudButton>
            </MudItem>
        </MudGrid>

        <MudTable Items="_orgTimes" Dense="true" Hover="true" Elevation="0" Class="mt-3">
            <HeaderContent><MudTh>สาขา / หน่วยงาน</MudTh><MudTh>เวลาเข้า</MudTh><MudTh>เวลาออก</MudTh><MudTh>สถานะ</MudTh><MudTh></MudTh></HeaderContent>
            <RowTemplate>
                <MudTd>@context.Label</MudTd>
                <MudTd>@context.Row.WorkStart.ToString("HH:mm")</MudTd>
                <MudTd>@context.Row.WorkEnd.ToString("HH:mm")</MudTd>
                <MudTd><MudChip T="string" Size="Size.Small" Color="@(context.Row.IsActive ? Color.Success : Color.Default)">@(context.Row.IsActive ? "ใช้งาน" : "ปิด")</MudChip></MudTd>
                <MudTd><MudButton Size="Size.Small" Color="@(context.Row.IsActive ? Color.Error : Color.Success)" OnClick="@(() => ToggleOrgTimeAsync(context.Row.Id))">@(context.Row.IsActive ? "ปิดใช้" : "เปิดใช้")</MudButton></MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText Class="pa-2">ยังไม่ได้ตั้ง — ทุกหน่วยงานใช้เวลาของบริษัท</MudText></NoRecordsContent>
        </MudTable>
    </MudPaper>
}

@code {
    private sealed record OrgOption(long Id, string Label);
    private sealed record OrgTimeRow(Att_OrgWorkTime Row, string Label);
    private List<OrgOption> _orgs = new();
    private List<OrgTimeRow> _orgTimes = new();
    private OrgOption? _newOrg;
    private TimeSpan? _newStart = new TimeSpan(8, 30, 0);
    private TimeSpan? _newEnd = new TimeSpan(17, 30, 0);

    private async Task LoadOrgTimesAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var companyKey = await context.com_companies.Where(c => c.code == _companyId).Select(c => (long?)c.id).FirstOrDefaultAsync();
        _orgs = (await context.com_organizations.Where(o => o.companyid == companyKey && o.isActive)
                .OrderBy(o => o.code).Select(o => new { o.id, o.code, o.name }).ToListAsync())
            .Select(o => new OrgOption(o.id, $"{o.code} · {o.name}")).ToList();
        var rows = await context.Att_OrgWorkTimes.AsNoTracking().Where(o => o.CompanyId == _companyId).ToListAsync();
        _orgTimes = rows.Select(r => new OrgTimeRow(r, _orgs.FirstOrDefault(o => o.Id == r.OrganizationId)?.Label ?? $"(หน่วยงาน #{r.OrganizationId})"))
            .OrderBy(r => r.Label).ToList();
    }

    private Task<IEnumerable<OrgOption>> SearchOrgsAsync(string? text, CancellationToken ct)
        => Task.FromResult(_orgs.Where(o => string.IsNullOrWhiteSpace(text) || o.Label.Contains(text, StringComparison.OrdinalIgnoreCase)).Take(30));

    // หนึ่งหน่วยงานมีแถวเดียว — ตั้งซ้ำ = แก้เวลาของแถวเดิม
    private async Task AddOrgTimeAsync()
    {
        if (_newOrg is null || _newStart is null || _newEnd is null) { Snackbar.Add("เลือกหน่วยงาน และใส่เวลาเข้า-ออกให้ครบ", Severity.Warning); return; }
        await using var context = await DbFactory.CreateDbContextAsync();
        var row = await context.Att_OrgWorkTimes.FirstOrDefaultAsync(o => o.CompanyId == _companyId && o.OrganizationId == _newOrg.Id);
        if (row is null) { row = new Att_OrgWorkTime { CompanyId = _companyId!, OrganizationId = _newOrg.Id }; context.Att_OrgWorkTimes.Add(row); }
        row.WorkStart = TimeOnly.FromTimeSpan(_newStart.Value);
        row.WorkEnd = TimeOnly.FromTimeSpan(_newEnd.Value);
        row.IsActive = true;
        row.ModifiedDate = DateTime.Now;
        await context.SaveChangesAsync();
        _newOrg = null;
        await LoadOrgTimesAsync();
        Snackbar.Add("บันทึกเวลาของหน่วยงานแล้ว", Severity.Success);
    }

    private async Task ToggleOrgTimeAsync(long id)
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var row = await context.Att_OrgWorkTimes.FirstOrDefaultAsync(o => o.Id == id && o.CompanyId == _companyId);
        if (row is null) return;
        row.IsActive = !row.IsActive; row.ModifiedDate = DateTime.Now;
        await context.SaveChangesAsync();
        await LoadOrgTimesAsync();
    }

    private string? _companyId;
    private Att_CompanySetting? _settings;
    private TimeSpan? _workStart;
    private TimeSpan? _workEnd;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
        if (string.IsNullOrWhiteSpace(_companyId)) return;

        await using var context = await DbFactory.CreateDbContextAsync();
        _settings = await context.Att_CompanySettings.FirstOrDefaultAsync(s => s.CompanyId == _companyId);
        if (_settings is null)
        {
            _settings = new Att_CompanySetting { CompanyId = _companyId, TrackingMode = AttTrackingMode.None };
            context.Att_CompanySettings.Add(_settings);
            await context.SaveChangesAsync();
        }

        _workStart = _settings.DefaultWorkStart?.ToTimeSpan();
        _workEnd = _settings.DefaultWorkEnd?.ToTimeSpan();
        await LoadOrgTimesAsync();
    }

    private async Task SaveAsync()
    {
        _error = null;

        if (_settings is null || string.IsNullOrWhiteSpace(_companyId)) return;

        if (_settings.TrackingMode == AttTrackingMode.SimpleInOut && (_workStart is null || _workEnd is null))
        {
            _error = L.Translate("SpecifyDefaultWorkTimeError");
            return;
        }

        await using var context = await DbFactory.CreateDbContextAsync();
        var existing = await context.Att_CompanySettings.FirstOrDefaultAsync(s => s.CompanyId == _companyId);
        if (existing is null)
        {
            _error = L.Translate("SettingsNotFoundError");
            return;
        }

        existing.TrackingMode = _settings.TrackingMode;
        existing.AllowWfh = _settings.AllowWfh;
        existing.DetectAbsence = _settings.DetectAbsence;
        existing.AllowGpsCheckin = _settings.AllowGpsCheckin;
        existing.DefaultWorkStart = _settings.TrackingMode == AttTrackingMode.SimpleInOut && _workStart.HasValue
            ? TimeOnly.FromTimeSpan(_workStart.Value) : null;
        existing.DefaultWorkEnd = _settings.TrackingMode == AttTrackingMode.SimpleInOut && _workEnd.HasValue
            ? TimeOnly.FromTimeSpan(_workEnd.Value) : null;

        await context.SaveChangesAsync();
        Snackbar.Add(L.Translate("SettingsSavedSuccess"), Severity.Success);
    }
}
