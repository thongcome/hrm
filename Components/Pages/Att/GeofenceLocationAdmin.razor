@page "/att/geofence-locations"
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@attribute [Authorize(Policy = "Menu:ATT_ADMIN")]

<PageTitle>พื้นที่อนุญาตให้เช็คอิน (Geofence)</PageTitle>

<MudPaper Class="pa-4 mb-4" MaxWidth="900px">
    <MudText Typo="Typo.h5">พื้นที่อนุญาตให้เช็คอินด้วย GPS (Geofence)</MudText>
    <MudText Typo="Typo.body2" Class="mt-1">
        พนักงานเช็คอินผ่านมือถือที่ /ess/attendance-checkin จะสำเร็จได้ก็ต่อเมื่ออยู่ในรัศมีของสถานที่ใดสถานที่หนึ่งด้านล่างเท่านั้น (บังคับพื้นที่เข้มงวด) —
        เพิ่มได้หลายสถานที่ (สำนักงานใหญ่ สาขา ฯลฯ)
    </MudText>

    @if (string.IsNullOrEmpty(_companyId))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">บัญชีของคุณยังไม่ได้ผูกกับบริษัทใดๆ</MudAlert>
    }
    else
    {
        <MudDivider Class="my-4" />

        <MudTextField T="string" Value="_searchTerm" Label="ค้นหา (ชื่อสถานที่)" Immediate="true" DebounceInterval="300"
            ValueChanged="OnSearchChangedAsync" AdornmentIcon="@Icons.Material.Filled.Search" Adornment="Adornment.Start" Class="mb-3" />

        <MudTable Items="_locations" Dense="true" Hover="true">
            <HeaderContent>
                <MudTh>ชื่อสถานที่</MudTh>
                <MudTh>ละติจูด</MudTh>
                <MudTh>ลองจิจูด</MudTh>
                <MudTh>รัศมี (เมตร)</MudTh>
                <MudTh>สถานะ</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Name</MudTd>
                <MudTd>@context.Latitude</MudTd>
                <MudTd>@context.Longitude</MudTd>
                <MudTd>@context.RadiusMeters</MudTd>
                <MudTd>@(context.IsActive ? "ใช้งาน" : "ปิดใช้งาน")</MudTd>
                <MudTd>
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => EditAsync(context))">แก้ไข</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="@(() => ToggleActiveAsync(context))">
                        @(context.IsActive ? "ปิดใช้งาน" : "เปิดใช้งาน")
                    </MudButton>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText Typo="Typo.body2">ยังไม่มีพื้นที่อนุญาต</MudText></NoRecordsContent>
        </MudTable>

        <MudDivider Class="my-5" />

        <MudText Typo="Typo.h6">@(_editingId is null ? "เพิ่มสถานที่ใหม่" : "แก้ไขสถานที่")</MudText>
        <MudGrid Class="mt-2">
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="_form.Name" Label="ชื่อสถานที่" /></MudItem>
            <MudItem xs="12" sm="6"><MudNumericField @bind-Value="_form.RadiusMeters" Label="รัศมี (เมตร)" Min="10" Max="5000" /></MudItem>
            <MudItem xs="12" sm="6"><MudNumericField T="decimal" @bind-Value="_form.Latitude" Label="ละติจูด (Latitude)" Format="0.000000" /></MudItem>
            <MudItem xs="12" sm="6"><MudNumericField T="decimal" @bind-Value="_form.Longitude" Label="ลองจิจูด (Longitude)" Format="0.000000" /></MudItem>
        </MudGrid>

        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
        }

        <MudStack Row="true" Spacing="2" Class="mt-4">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">@(_editingId is null ? "เพิ่ม" : "บันทึก")</MudButton>
            @if (_editingId is not null)
            {
                <MudButton Variant="Variant.Text" OnClick="CancelEdit">ยกเลิก</MudButton>
            }
        </MudStack>
    }
</MudPaper>

@code {
    private string? _companyId;
    private List<Att_GeofenceLocation> _locations = new();
    private string? _searchTerm;
    private string? _error;
    private long? _editingId;

    private class FormModel
    {
        public string Name { get; set; } = "";
        public decimal Latitude { get; set; }
        public decimal Longitude { get; set; }
        public int RadiusMeters { get; set; } = 100;
    }

    private FormModel _form = new();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
        if (string.IsNullOrWhiteSpace(_companyId)) return;

        await LoadAsync();
    }

    private async Task OnSearchChangedAsync(string term)
    {
        _searchTerm = term;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var query = context.Att_GeofenceLocations.Where(l => l.CompanyId == _companyId);
        query = EntitySearchHelper.ApplyTextSearch(query, _searchTerm, nameof(Att_GeofenceLocation.Name));
        _locations = await query.OrderBy(l => l.Name).ToListAsync();
    }

    private void EditAsync(Att_GeofenceLocation location)
    {
        _editingId = location.Id;
        _form = new FormModel
        {
            Name = location.Name,
            Latitude = location.Latitude,
            Longitude = location.Longitude,
            RadiusMeters = location.RadiusMeters,
        };
    }

    private void CancelEdit()
    {
        _editingId = null;
        _form = new FormModel();
        _error = null;
    }

    private async Task SaveAsync()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_form.Name))
        {
            _error = "กรุณาระบุชื่อสถานที่";
            return;
        }
        if (_form.Latitude == 0 || _form.Longitude == 0)
        {
            _error = "กรุณาระบุพิกัดละติจูด/ลองจิจูดให้ถูกต้อง";
            return;
        }

        await using var context = await DbFactory.CreateDbContextAsync();

        if (_editingId is null)
        {
            context.Att_GeofenceLocations.Add(new Att_GeofenceLocation
            {
                CompanyId = _companyId!,
                Name = _form.Name,
                Latitude = _form.Latitude,
                Longitude = _form.Longitude,
                RadiusMeters = _form.RadiusMeters,
                IsActive = true,
            });
        }
        else
        {
            var existing = await context.Att_GeofenceLocations.FirstOrDefaultAsync(l => l.Id == _editingId && l.CompanyId == _companyId);
            if (existing is null) { _error = "ไม่พบรายการนี้แล้ว กรุณาโหลดหน้าใหม่"; return; }
            existing.Name = _form.Name;
            existing.Latitude = _form.Latitude;
            existing.Longitude = _form.Longitude;
            existing.RadiusMeters = _form.RadiusMeters;
        }

        await context.SaveChangesAsync();
        Snackbar.Add("บันทึกเรียบร้อย", Severity.Success);
        CancelEdit();
        await LoadAsync();
    }

    private async Task ToggleActiveAsync(Att_GeofenceLocation location)
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var existing = await context.Att_GeofenceLocations.FirstOrDefaultAsync(l => l.Id == location.Id && l.CompanyId == _companyId);
        if (existing is null) return;

        existing.IsActive = !existing.IsActive;
        await context.SaveChangesAsync();
        await LoadAsync();
    }
}
