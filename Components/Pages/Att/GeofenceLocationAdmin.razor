@page "/att/geofence-locations"
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@inject JsonLocalizationService L
@inject NavigationManager Navigation
@attribute [Authorize(Policy = "Menu:ATT_ADMIN")]

<PageTitle>@L.Translate("GeofenceAdminPageTitle")</PageTitle>

<MudPaper Class="pa-4 mb-4" MaxWidth="900px">
    <MudText Typo="Typo.h5">@L.Translate("GeofenceAdminHeading")</MudText>
    <MudText Typo="Typo.body2" Class="mt-1">
        @L.Translate("GeofenceAdminDesc")
    </MudText>

    @if (string.IsNullOrEmpty(_companyId))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">@L.Translate("CompanyNotLinkedShortError")</MudAlert>
    }
    else
    {
        <MudDivider Class="my-4" />

        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
            <MudTextField T="string" Value="_searchTerm" Label="@L.Translate("SearchLocationNamePlaceholder")" Immediate="true" DebounceInterval="300"
                ValueChanged="OnSearchChangedAsync" AdornmentIcon="@Icons.Material.Filled.Search" Adornment="Adornment.Start" Class="flex-grow-1 mr-4" />
            @if (!_showForm)
            {
                <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreate">@L.Translate("AddButtonPlain")</MudButton>
            }
        </MudStack>

        <MudTable Items="_locations" Dense="true" Hover="true">
            <HeaderContent>
                <MudTh>@L.Translate("ColLocationName")</MudTh>
                <MudTh>@L.Translate("ColLatitude")</MudTh>
                <MudTh>@L.Translate("ColLongitude")</MudTh>
                <MudTh>@L.Translate("ColRadiusMeters")</MudTh>
                <MudTh>@L.Translate("ColStatus")</MudTh>
                <MudTh>QR</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Name</MudTd>
                <MudTd>@context.Latitude</MudTd>
                <MudTd>@context.Longitude</MudTd>
                <MudTd>@context.RadiusMeters</MudTd>
                <MudTd>@(context.IsActive ? L.Translate("PeriodActiveStatus") : L.Translate("PeriodInactiveStatus"))</MudTd>
                <MudTd>
                    <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.QrCode2" OnClick="@(() => ShowQrAsync(context))">
                        @(string.IsNullOrEmpty(context.QrToken) ? "สร้าง QR" : "แสดง QR")
                    </MudButton>
                </MudTd>
                <MudTd>
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => EditAsync(context))">@L.Translate("EditButton")</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="@(() => ToggleActiveAsync(context))">
                        @(context.IsActive ? L.Translate("DeactivateButton") : L.Translate("ActivateButton"))
                    </MudButton>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText Typo="Typo.body2">@L.Translate("NoLocationsMessage")</MudText></NoRecordsContent>
        </MudTable>

        @if (_qrLocation is not null && _qrPng is not null)
        {
            @* QR check-in (REQ-050): print this and post it at the location. The
               employee scans it with the phone camera; it opens the ESS check-in
               page with the location token and records a QrCheckin punch. *@
            <MudPaper Class="pa-4 mt-3" Outlined="true" Style="max-width:520px;">
                <MudText Typo="Typo.h6">QR เช็คอิน — @_qrLocation.Name</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">พิมพ์ติดไว้ ณ จุดปฏิบัติงาน พนักงานสแกนด้วยกล้องมือถือเพื่อเช็คอิน/เช็คเอาท์</MudText>
                <div class="d-flex justify-center my-3">
                    <img src="data:image/png;base64,@Convert.ToBase64String(_qrPng)" alt="QR" style="width:260px;height:260px;" />
                </div>
                <MudTextField T="string" Value="@_qrUrl" ReadOnly="true" Label="ลิงก์ที่ฝังใน QR" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudStack Row="true" Spacing="2" Class="mt-2">
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" OnClick="@(() => RegenerateQrAsync(_qrLocation))">สร้างรหัสใหม่ (QR เดิมใช้ไม่ได้)</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => { _qrLocation = null; _qrPng = null; })">ปิด</MudButton>
                </MudStack>
            </MudPaper>
        }

        @if (_showForm)
        {
            <MudDivider Class="my-5" />

            <MudText Typo="Typo.h6">@(_editingId is null ? L.Translate("AddNewLocationHeading") : L.Translate("EditLocationHeading"))</MudText>
            <MudGrid Class="mt-2">
                <MudItem xs="12" sm="6"><MudTextField @bind-Value="_form.Name" Label="@L.Translate("ColLocationName")" /></MudItem>
                <MudItem xs="12" sm="6"><MudNumericField @bind-Value="_form.RadiusMeters" Label="@L.Translate("ColRadiusMeters")" Min="10" Max="5000" /></MudItem>
                <MudItem xs="12" sm="6"><MudNumericField T="decimal" @bind-Value="_form.Latitude" Label="@L.Translate("LatitudeFieldLabel")" Format="0.000000" /></MudItem>
                <MudItem xs="12" sm="6"><MudNumericField T="decimal" @bind-Value="_form.Longitude" Label="@L.Translate("LongitudeFieldLabel")" Format="0.000000" /></MudItem>
            </MudGrid>

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
            }

            <MudStack Row="true" Spacing="2" Class="mt-4">
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">@(_editingId is null ? L.Translate("AddButtonPlain") : L.Translate("SaveButton"))</MudButton>
                <MudButton Variant="Variant.Text" OnClick="CancelEdit">@L.Translate("CancelButton")</MudButton>
            </MudStack>
        }
    }
</MudPaper>

@code {
    private string? _companyId;
    private List<Att_GeofenceLocation> _locations = new();
    private string? _searchTerm;
    private string? _error;
    private long? _editingId;
    private bool _showForm;

    private class FormModel
    {
        public string Name { get; set; } = "";
        public decimal Latitude { get; set; }
        public decimal Longitude { get; set; }
        public int RadiusMeters { get; set; } = 100;
    }

    private FormModel _form = new();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
        if (string.IsNullOrWhiteSpace(_companyId)) return;

        await LoadAsync();
    }

    private async Task OnSearchChangedAsync(string term)
    {
        _searchTerm = term;
        await LoadAsync();
    }

    private Att_GeofenceLocation? _qrLocation;
    private byte[]? _qrPng;
    private string _qrUrl = "";

    private async Task ShowQrAsync(Att_GeofenceLocation loc)
    {
        if (string.IsNullOrEmpty(loc.QrToken)) { await RegenerateQrAsync(loc); return; }
        RenderQr(loc);
    }

    private async Task RegenerateQrAsync(Att_GeofenceLocation loc)
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var row = await context.Att_GeofenceLocations.FirstOrDefaultAsync(l => l.Id == loc.Id);
        if (row is null) return;
        row.QrToken = Guid.NewGuid().ToString("N");
        await context.SaveChangesAsync();
        loc.QrToken = row.QrToken;
        RenderQr(loc);
        Snackbar.Add("สร้าง QR ใหม่แล้ว — QR ที่พิมพ์ไว้ก่อนหน้าใช้ไม่ได้อีก", Severity.Info);
    }

    private void RenderQr(Att_GeofenceLocation loc)
    {
        _qrLocation = loc;
        _qrUrl = $"{Navigation.BaseUri.TrimEnd('/')}/ess/attendance-checkin?loc={loc.QrToken}";
        using var gen = new QRCoder.QRCodeGenerator();
        using var data = gen.CreateQrCode(_qrUrl, QRCoder.QRCodeGenerator.ECCLevel.M);
        _qrPng = new QRCoder.PngByteQRCode(data).GetGraphic(8);
    }

    private async Task LoadAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var query = context.Att_GeofenceLocations.Where(l => l.CompanyId == _companyId);
        query = EntitySearchHelper.ApplyTextSearch(query, _searchTerm, nameof(Att_GeofenceLocation.Name));
        _locations = await query.OrderBy(l => l.Name).ToListAsync();
    }

    private void OpenCreate()
    {
        _editingId = null;
        _form = new FormModel();
        _error = null;
        _showForm = true;
    }

    private void EditAsync(Att_GeofenceLocation location)
    {
        _editingId = location.Id;
        _form = new FormModel
        {
            Name = location.Name,
            Latitude = location.Latitude,
            Longitude = location.Longitude,
            RadiusMeters = location.RadiusMeters,
        };
        _error = null;
        _showForm = true;
    }

    private void CancelEdit()
    {
        _editingId = null;
        _form = new FormModel();
        _error = null;
        _showForm = false;
    }

    private async Task SaveAsync()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_form.Name))
        {
            _error = L.Translate("SpecifyLocationNameError");
            return;
        }
        if (_form.Latitude == 0 || _form.Longitude == 0)
        {
            _error = L.Translate("InvalidLatLongError");
            return;
        }

        await using var context = await DbFactory.CreateDbContextAsync();

        if (_editingId is null)
        {
            context.Att_GeofenceLocations.Add(new Att_GeofenceLocation
            {
                CompanyId = _companyId!,
                Name = _form.Name,
                Latitude = _form.Latitude,
                Longitude = _form.Longitude,
                RadiusMeters = _form.RadiusMeters,
                IsActive = true,
            });
        }
        else
        {
            var existing = await context.Att_GeofenceLocations.FirstOrDefaultAsync(l => l.Id == _editingId && l.CompanyId == _companyId);
            if (existing is null) { _error = L.Translate("RecordNotFoundReloadError"); return; }
            existing.Name = _form.Name;
            existing.Latitude = _form.Latitude;
            existing.Longitude = _form.Longitude;
            existing.RadiusMeters = _form.RadiusMeters;
        }

        await context.SaveChangesAsync();
        Snackbar.Add(L.Translate("SavedSuccessGeneric"), Severity.Success);
        CancelEdit();
        await LoadAsync();
    }

    private async Task ToggleActiveAsync(Att_GeofenceLocation location)
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var existing = await context.Att_GeofenceLocations.FirstOrDefaultAsync(l => l.Id == location.Id && l.CompanyId == _companyId);
        if (existing is null) return;

        existing.IsActive = !existing.IsActive;
        await context.SaveChangesAsync();
        await LoadAsync();
    }
}
