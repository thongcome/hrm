@page "/att/ot-rules"
@using System.Security.Claims
@using HRM.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@inject JsonLocalizationService L
@attribute [Authorize(Policy = "Menu:ATT_ADMIN")]

<PageTitle>@L.Translate("OtRuleAdminPageTitle")</PageTitle>

<MudPaper Class="pa-4 mb-4" MaxWidth="900px">
    <MudText Typo="Typo.h5">@L.Translate("OtRuleAdminHeading")</MudText>
    <MudText Typo="Typo.body2" Class="mt-1">
        @L.Translate("OtRuleAdminDesc")
    </MudText>

    @if (string.IsNullOrEmpty(_companyId))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">@L.Translate("CompanyNotLinkedShortError")</MudAlert>
        return;
    }

    <MudDivider Class="my-4" />

    <MudTable Items="_rules" Dense="true" Hover="true">
        <HeaderContent>
            <MudTh>@L.Translate("DayTypeLabel")</MudTh>
            <MudTh>@L.Translate("MultiplierLabel")</MudTh>
            <MudTh>@L.Translate("InUseLabel")</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@DayTypeLabel(context.DayType)</MudTd>
            <MudTd>@context.Multiplier.ToString("0.0#")</MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                    @(context.IsActive ? L.Translate("InUseChip") : L.Translate("DisabledChip"))
                </MudChip>
            </MudTd>
            <MudTd>
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => StartEdit(context))">@L.Translate("EditButton")</MudButton>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2">@L.Translate("OtRuleNoSettingsMessage")</MudText>
        </NoRecordsContent>
    </MudTable>

    <MudDivider Class="my-5" />

    <MudText Typo="Typo.h6">@(_editingId is null ? L.Translate("AddMultiplierHeading") : L.Translate("EditMultiplierHeading"))</MudText>
    <MudGrid Class="mt-1">
        <MudItem xs="12" sm="4">
            <MudSelect T="OtDayType" @bind-Value="_dayType" Label="@L.Translate("DayTypeLabel")" Disabled="_editingId is not null">
                <MudSelectItem T="OtDayType" Value="OtDayType.Workday">@L.Translate("DayTypeWorkday")</MudSelectItem>
                <MudSelectItem T="OtDayType" Value="OtDayType.Holiday">@L.Translate("DayTypeHoliday")</MudSelectItem>
                <MudSelectItem T="OtDayType" Value="OtDayType.RestDay">@L.Translate("DayTypeRestDay")</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="4"><MudNumericField T="decimal" @bind-Value="_multiplier" Label="@L.Translate("MultiplierTimesLabel")" Min="0" Format="0.0#" /></MudItem>
        <MudItem xs="12" sm="4">
            <MudSwitch T="bool" @bind-Value="_isActive" Color="Color.Success" Label="@L.Translate("InUseLabel")" />
        </MudItem>
        <MudItem xs="12">
            <MudStack Row="true" Spacing="2">
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">@L.Translate("SaveButton")</MudButton>
                @if (_editingId is not null)
                {
                    <MudButton Variant="Variant.Text" OnClick="CancelEdit">@L.Translate("CancelButton")</MudButton>
                }
            </MudStack>
        </MudItem>
    </MudGrid>

    @if (!string.IsNullOrEmpty(_error))
    {
        <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
    }
</MudPaper>

@code {
    private string? _companyId;
    private List<Att_OtRule> _rules = new();
    private string? _error;

    private long? _editingId;
    private OtDayType _dayType = OtDayType.Workday;
    private decimal _multiplier = 1.5m;
    private bool _isActive = true;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
        if (string.IsNullOrWhiteSpace(_companyId)) return;
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        _rules = await context.Att_OtRules.Where(r => r.CompanyId == _companyId).OrderBy(r => r.DayType).ToListAsync();
    }

    private string DayTypeLabel(OtDayType t) => t switch
    {
        OtDayType.Workday => L.Translate("DayTypeWorkday"),
        OtDayType.Holiday => L.Translate("DayTypeHoliday"),
        OtDayType.RestDay => L.Translate("DayTypeRestDay"),
        _ => t.ToString(),
    };

    private void StartEdit(Att_OtRule rule)
    {
        _editingId = rule.Id;
        _dayType = rule.DayType;
        _multiplier = rule.Multiplier;
        _isActive = rule.IsActive;
    }

    private void CancelEdit()
    {
        _editingId = null;
        _dayType = OtDayType.Workday;
        _multiplier = 1.5m;
        _isActive = true;
    }

    private async Task SaveAsync()
    {
        _error = null;
        if (_multiplier < 0) { _error = L.Translate("MultiplierNonNegativeError"); return; }

        await using var context = await DbFactory.CreateDbContextAsync();
        if (_editingId is long id)
        {
            var existing = await context.Att_OtRules.FirstOrDefaultAsync(r => r.Id == id && r.CompanyId == _companyId);
            if (existing is null) { _error = L.Translate("OtRuleNotFoundError"); return; }
            existing.Multiplier = _multiplier;
            existing.IsActive = _isActive;
        }
        else
        {
            // Allow-list of one row per (CompanyId, DayType) is a UI-level
            // convention (not a DB constraint) matching every other config
            // table in this app — warn instead of silently duplicating.
            var duplicate = await context.Att_OtRules.AnyAsync(r => r.CompanyId == _companyId && r.DayType == _dayType && r.IsActive);
            if (duplicate) { _error = L.Translate("OtRuleDuplicateActiveError"); return; }

            context.Att_OtRules.Add(new Att_OtRule
            {
                CompanyId = _companyId!,
                DayType = _dayType,
                Multiplier = _multiplier,
                IsActive = _isActive,
            });
        }
        await context.SaveChangesAsync();

        Snackbar.Add(L.Translate("SavedSuccessGeneric"), Severity.Success);
        CancelEdit();
        await RefreshAsync();
    }
}
