@page "/att/report"
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Att
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@inject AttendanceAggregationService AggregationService
@inject JsonLocalizationService L
@attribute [Authorize(Policy = "Menu:ATT_ADMIN")]

<PageTitle>@L.Translate("AttendanceReportPageTitle")</PageTitle>

<MudPaper Class="pa-4 mb-4">
    <MudText Typo="Typo.h5">@L.Translate("AttendanceReportPageTitle")</MudText>

    @if (string.IsNullOrEmpty(_companyId))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">@L.Translate("CompanyNotLinkedError")</MudAlert>
        return;
    }

    @if (_trackingMode == AttTrackingMode.None)
    {
        <MudAlert Severity="Severity.Info" Class="mt-4">
            @L.Translate("AttNotEnabledPrefix") <MudLink Href="/att/settings">@L.Translate("AttSettingsPageTitle")</MudLink> @L.Translate("NoPlansAvailableSuffix")
        </MudAlert>
        return;
    }

    <MudGrid Class="mt-3">
        <MudItem xs="12" sm="4">
            <MudDatePicker @bind-Date="_fromDate" Label="@L.Translate("FromDateLabel")" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudDatePicker @bind-Date="_toDate" Label="@L.Translate("ToDateLabel")" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="RecalculateAsync" Class="mt-2">@L.Translate("RecalculateButton")</MudButton>
        </MudItem>
    </MudGrid>

    @if (_lastResultCount is not null)
    {
        <MudAlert Severity="Severity.Success" Class="mt-2">@string.Format(L.Translate("RecalcSuccessTemplate"), _lastResultCount)</MudAlert>
    }

    <MudTable Items="_rows" Dense="true" Class="mt-3">
        <HeaderContent>
            <MudTh>@L.Translate("EmpNoLabel")</MudTh>
            <MudTh>@L.Translate("ColName")</MudTh>
            <MudTh>@L.Translate("ColDate")</MudTh>
            <MudTh>@L.Translate("ColClockIn")</MudTh>
            <MudTh>@L.Translate("ColClockOut")</MudTh>
            <MudTh>@L.Translate("ColStatus")</MudTh>
            <MudTh>@L.Translate("ColLocation")</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Hremployee.EmpNo</MudTd>
            <MudTd>@context.Hremployee.EmpName @context.Hremployee.EmpSurname</MudTd>
            <MudTd>@context.WorkDate.ToString("dd/MM/yyyy")</MudTd>
            <MudTd>@context.FirstIn?.ToString("HH:mm")</MudTd>
            <MudTd>@context.LastOut?.ToString("HH:mm")</MudTd>
            <MudTd>
                @if (context.IsLate)
                {
                    <MudChip T="string" Color="Color.Warning" Size="Size.Small">@L.Translate("LateChip")</MudChip>
                }
                @if (context.IsEarlyLeave)
                {
                    <MudChip T="string" Color="Color.Warning" Size="Size.Small">@L.Translate("EarlyLeaveChip")</MudChip>
                }
                @if (!context.IsLate && !context.IsEarlyLeave)
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Small">@L.Translate("NormalChip")</MudChip>
                }
            </MudTd>
            <MudTd>@(context.WorkLocation == AttWorkLocation.Wfh ? L.Translate("LocationWfh") : context.WorkLocation == AttWorkLocation.Mixed ? L.Translate("LocationMixed") : L.Translate("LocationOffice"))</MudTd>
        </RowTemplate>
    </MudTable>

    @if (_settings?.AllowWfh == true)
    {
        <MudDivider Class="my-5" />

        <MudText Typo="Typo.h6">@L.Translate("WfhManualEntryHeading")</MudText>
        <MudText Typo="Typo.body2" Class="mt-1">
            @L.Translate("WfhManualEntryDesc")
        </MudText>

        <MudGrid Class="mt-2">
            <MudItem xs="12" sm="4">
                <MudAutocomplete T="Hremployee" Label="@L.Translate("EmployeeFieldLabel")" @bind-Value="_wfhEmployee"
                    SearchFunc="SearchEmployeesAsync"
                    ToStringFunc="@(e => e == null ? null : $"{e.EmpNo} — {e.EmpName} {e.EmpSurname}")"
                    ResetValueOnEmptyText="true" CoerceText="true" MinCharacters="0" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudDatePicker @bind-Date="_wfhDate" Label="@L.Translate("WfhDateLabel")" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudTimePicker @bind-Time="_wfhCheckIn" Label="@L.Translate("ClockInTimeLabel")" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudTimePicker @bind-Time="_wfhCheckOut" Label="@L.Translate("ClockOutTimeLabel")" />
            </MudItem>
            <MudItem xs="12" sm="1">
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveWfhAsync" Class="mt-2">@L.Translate("SaveButton")</MudButton>
            </MudItem>
        </MudGrid>

        @if (!string.IsNullOrEmpty(_wfhError))
        {
            <MudAlert Severity="Severity.Error" Class="mt-2">@_wfhError</MudAlert>
        }
    }
</MudPaper>

@code {
    private string? _companyId;
    private AttTrackingMode _trackingMode = AttTrackingMode.None;
    private Att_CompanySetting? _settings;

    private DateTime? _fromDate = DateTime.Today.AddDays(-7);
    private DateTime? _toDate = DateTime.Today;
    private List<Att_DailyAttendance> _rows = new();
    private int? _lastResultCount;

    private Hremployee? _wfhEmployee;
    private DateTime? _wfhDate = DateTime.Today;
    private TimeSpan? _wfhCheckIn;
    private TimeSpan? _wfhCheckOut;
    private string? _wfhError;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
        if (string.IsNullOrWhiteSpace(_companyId)) return;

        await using var context = await DbFactory.CreateDbContextAsync();
        _settings = await context.Att_CompanySettings.FirstOrDefaultAsync(s => s.CompanyId == _companyId);
        _trackingMode = _settings?.TrackingMode ?? AttTrackingMode.None;
        if (_trackingMode == AttTrackingMode.None) return;

        await LoadRowsAsync();
    }

    private async Task LoadRowsAsync()
    {
        if (_fromDate is null || _toDate is null) return;

        var from = DateOnly.FromDateTime(_fromDate.Value);
        var to = DateOnly.FromDateTime(_toDate.Value);

        await using var context = await DbFactory.CreateDbContextAsync();
        _rows = await context.Att_DailyAttendances
            .Include(a => a.Hremployee)
            .Where(a => a.CompanyId == _companyId && a.WorkDate >= from && a.WorkDate <= to)
            .OrderBy(a => a.WorkDate).ThenBy(a => a.Hremployee.EmpNo)
            .ToListAsync();
    }

    private async Task RecalculateAsync()
    {
        if (_fromDate is null || _toDate is null || string.IsNullOrWhiteSpace(_companyId)) return;

        var from = DateOnly.FromDateTime(_fromDate.Value);
        var to = DateOnly.FromDateTime(_toDate.Value);

        var result = await AggregationService.RunAsync(_companyId, from, to);
        _lastResultCount = result.DaysProcessed;

        Snackbar.Add(L.Translate("RecalcSavedSuccess"), Severity.Success);
        await LoadRowsAsync();
    }

    private async Task<IEnumerable<Hremployee>> SearchEmployeesAsync(string search, CancellationToken ct)
    {
        await using var context = await DbFactory.CreateDbContextAsync(ct);
        var query = context.Hremployee.Where(e => e.companyid == _companyId);
        if (!string.IsNullOrWhiteSpace(search))
        {
            query = query.Where(e => e.EmpNo.Contains(search)
                || (e.EmpName != null && e.EmpName.Contains(search))
                || (e.EmpSurname != null && e.EmpSurname.Contains(search)));
        }
        return await query.OrderBy(e => e.EmpNo).Take(20).ToListAsync(ct);
    }

    private async Task SaveWfhAsync()
    {
        _wfhError = null;

        if (_wfhEmployee is null || _wfhDate is null || _wfhCheckIn is null || _wfhCheckOut is null)
        {
            _wfhError = L.Translate("FillAllFieldsError");
            return;
        }

        var workDate = DateOnly.FromDateTime(_wfhDate.Value);

        await using var context = await DbFactory.CreateDbContextAsync();
        context.Att_PunchLogs.Add(new Att_PunchLog
        {
            CompanyId = _companyId!,
            HremployeeId = _wfhEmployee.id,
            RawEmpCode = _wfhEmployee.EmpNo,
            PunchTime = workDate.ToDateTime(TimeOnly.FromTimeSpan(_wfhCheckIn.Value)),
            Direction = AttPunchDirection.In,
            Source = AttPunchSource.WfhSelfCheckin,
        });
        context.Att_PunchLogs.Add(new Att_PunchLog
        {
            CompanyId = _companyId!,
            HremployeeId = _wfhEmployee.id,
            RawEmpCode = _wfhEmployee.EmpNo,
            PunchTime = workDate.ToDateTime(TimeOnly.FromTimeSpan(_wfhCheckOut.Value)),
            Direction = AttPunchDirection.Out,
            Source = AttPunchSource.WfhSelfCheckin,
        });
        await context.SaveChangesAsync();

        Snackbar.Add(L.Translate("WfhSavedSuccessNote"), Severity.Success);
        _wfhEmployee = null;
        _wfhCheckIn = null;
        _wfhCheckOut = null;
    }
}
