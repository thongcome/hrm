@page "/att/shifts"
@using System.Security.Claims
@using HRM.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@attribute [Authorize(Policy = "Menu:ATT_ADMIN")]

<PageTitle>จัดการกะการทำงาน</PageTitle>

<MudPaper Class="pa-4 mb-4">
    <MudText Typo="Typo.h5">จัดการกะการทำงาน (Shift)</MudText>

    @if (string.IsNullOrEmpty(_companyId))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">บัญชีของคุณยังไม่ได้ผูกกับบริษัทใดๆ — ติดต่อแอดมินให้ตั้งค่า empid ก่อน</MudAlert>
        return;
    }

    @if (_trackingMode != AttTrackingMode.ShiftBased)
    {
        <MudAlert Severity="Severity.Info" Class="mt-4">
            บริษัทนี้ยังไม่ได้เปิดใช้งานระบบกะ — ไปตั้งค่าที่ <MudLink Href="/att/settings">ตั้งค่าบันทึกเวลาเข้างาน</MudLink> เลือก "มีระบบกะ" ก่อน
        </MudAlert>
        return;
    }

    <MudText Typo="Typo.h6" Class="mt-4">รายการกะ</MudText>
    <MudGrid Class="mt-2">
        <MudItem xs="12" sm="3">
            <MudTextField @bind-Value="_newShiftCode" Label="รหัสกะ" />
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudTextField @bind-Value="_newShiftName" Label="ชื่อกะ" />
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudTimePicker @bind-Time="_newStartTime" Label="เวลาเข้ากะ" />
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudTimePicker @bind-Time="_newEndTime" Label="เวลาออกกะ" />
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="AddShiftAsync" Class="mt-2">เพิ่มกะ</MudButton>
        </MudItem>
    </MudGrid>

    @if (!string.IsNullOrEmpty(_shiftError))
    {
        <MudAlert Severity="Severity.Error" Class="mt-2">@_shiftError</MudAlert>
    }

    <MudTable Items="_shifts" Dense="true" Class="mt-3">
        <HeaderContent>
            <MudTh>รหัสกะ</MudTh>
            <MudTh>ชื่อกะ</MudTh>
            <MudTh>เวลา</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.ShiftCode</MudTd>
            <MudTd>@context.ShiftName</MudTd>
            <MudTd>@context.StartTime.ToString("HH:mm") - @context.EndTime.ToString("HH:mm")</MudTd>
        </RowTemplate>
    </MudTable>

    <MudDivider Class="my-5" />

    <MudText Typo="Typo.h6">มอบหมายกะรายบุคคล/รายวัน</MudText>
    <MudText Typo="Typo.body2" Class="mt-1">กำหนดว่าพนักงานคนไหนเข้ากะไหนในวันไหน — รองรับตารางกะหมุนเวียน</MudText>

    <MudGrid Class="mt-2">
        <MudItem xs="12" sm="4">
            <MudAutocomplete T="Hremployee" Label="พนักงาน" @bind-Value="_assignEmployee"
                SearchFunc="SearchEmployeesAsync"
                ToStringFunc="@(e => e == null ? null : $"{e.EmpNo} — {e.EmpName} {e.EmpSurname}")"
                ResetValueOnEmptyText="true" CoerceText="true" MinCharacters="0" />
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudDatePicker @bind-Date="_assignDate" Label="วันที่" />
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudSelect T="long?" @bind-Value="_assignShiftId" Label="กะ">
                @foreach (var s in _shifts)
                {
                    <MudSelectItem T="long?" Value="@((long?)s.Id)">@s.ShiftName (@s.ShiftCode)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="AssignShiftAsync" Class="mt-2">มอบหมาย</MudButton>
        </MudItem>
    </MudGrid>

    @if (!string.IsNullOrEmpty(_assignError))
    {
        <MudAlert Severity="Severity.Error" Class="mt-2">@_assignError</MudAlert>
    }

    <MudTable Items="_assignments" Dense="true" Class="mt-3">
        <HeaderContent>
            <MudTh>รหัสพนักงาน</MudTh>
            <MudTh>ชื่อ</MudTh>
            <MudTh>วันที่</MudTh>
            <MudTh>กะ</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Hremployee.EmpNo</MudTd>
            <MudTd>@context.Hremployee.EmpName @context.Hremployee.EmpSurname</MudTd>
            <MudTd>@context.WorkDate.ToString("dd/MM/yyyy")</MudTd>
            <MudTd>@context.ShiftDefinition.ShiftName</MudTd>
        </RowTemplate>
    </MudTable>

    <MudDivider Class="my-5" />

    <MudText Typo="Typo.h6">มอบหมายกะแบบตาราง (หลายคน/หลายวัน)</MudText>
    <MudText Typo="Typo.body2" Class="mt-1">เลือกทั้งหน่วยงาน หรือเลือกพนักงานเอง แล้วกำหนดช่วงวันที่ + รูปแบบกะ ระบบจะสร้าง/แก้ไขตารางให้ทีเดียว</MudText>

    <MudGrid Class="mt-2">
        <MudItem xs="12" sm="4">
            <MudSelect T="string" Value="_rosterTargetMode" ValueChanged="@(v => { _rosterTargetMode = v; _rosterPreviewCount = null; })" Label="กลุ่มเป้าหมาย">
                <MudSelectItem Value="@("Org")">ทั้งหน่วยงาน (รวมหน่วยงานย่อย)</MudSelectItem>
                <MudSelectItem Value="@("Employees")">เลือกพนักงานเอง</MudSelectItem>
            </MudSelect>
        </MudItem>

        @if (_rosterTargetMode == "Org")
        {
            <MudItem xs="12" sm="8">
                <MudAutocomplete T="com_organization" Label="หน่วยงาน" @bind-Value="_rosterOrg"
                    SearchFunc="SearchOrganizationsAsync" ToStringFunc="@(o => o == null ? null : $"{o.code} — {o.name}")"
                    ResetValueOnEmptyText="true" CoerceText="true" MinCharacters="0" />
            </MudItem>
        }
        else
        {
            <MudItem xs="12" sm="6">
                <MudAutocomplete T="Hremployee" Label="พนักงาน (รหัสหรือชื่อ)" Value="_rosterNewEmployee" ValueChanged="v => _rosterNewEmployee = v"
                    SearchFunc="SearchEmployeesAsync" ToStringFunc="@(e => e == null ? null : $"{e.EmpNo} — {e.EmpName} {e.EmpSurname}")"
                    ResetValueOnEmptyText="true" CoerceText="true" MinCharacters="0" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudButton Variant="Variant.Outlined" OnClick="AddRosterEmployee" Class="mt-2">เพิ่ม</MudButton>
            </MudItem>
        }
    </MudGrid>

    @if (_rosterTargetMode == "Employees" && _rosterEmployees.Count > 0)
    {
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" Class="mt-2">
            @foreach (var e in _rosterEmployees)
            {
                <MudChip T="string" OnClose="@(() => _rosterEmployees.Remove(e))">@e.EmpNo — @e.EmpName @e.EmpSurname</MudChip>
            }
        </MudStack>
    }

    <MudGrid Class="mt-3">
        <MudItem xs="12" sm="3">
            <MudDatePicker @bind-Date="_rosterStartDate" Label="วันเริ่ม" />
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudDatePicker @bind-Date="_rosterEndDate" Label="วันสิ้นสุด" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudSelect T="string" Value="_rosterPatternMode" ValueChanged="@(v => { _rosterPatternMode = v; _rosterPreviewCount = null; })" Label="รูปแบบกะ">
                <MudSelectItem Value="@("Single")">กะเดียวตลอดช่วง</MudSelectItem>
                <MudSelectItem Value="@("Weekly")">รูปแบบรายสัปดาห์ (เว้นว่าง = วันหยุด)</MudSelectItem>
            </MudSelect>
        </MudItem>
    </MudGrid>

    @if (_rosterPatternMode == "Single")
    {
        <MudGrid Class="mt-2">
            <MudItem xs="12" sm="6">
                <MudSelect T="long?" @bind-Value="_rosterSingleShiftId" Label="กะ">
                    @foreach (var s in _shifts)
                    {
                        <MudSelectItem T="long?" Value="@((long?)s.Id)">@s.ShiftName (@s.ShiftCode)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>
    }
    else
    {
        <MudGrid Class="mt-2">
            @foreach (var day in _weekDays)
            {
                <MudItem xs="6" sm="3" md="12" lg="6" xl="3">
                    <MudSelect T="long?" Value="@_rosterWeeklyShiftIds[day]" ValueChanged="@(v => { _rosterWeeklyShiftIds[day] = v; _rosterPreviewCount = null; })"
                        Label="@DayLabel(day)" Clearable="true">
                        @foreach (var s in _shifts)
                        {
                            <MudSelectItem T="long?" Value="@((long?)s.Id)">@s.ShiftName (@s.ShiftCode)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            }
        </MudGrid>
    }

    <MudStack Row="true" Spacing="2" Class="mt-3">
        <MudButton Variant="Variant.Outlined" OnClick="PreviewRosterAsync">ดูตัวอย่างก่อนบันทึก</MudButton>
        @if (_rosterPreviewCount is not null)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CommitRosterAsync">ยืนยันบันทึก (@_rosterPreviewCount รายการ)</MudButton>
        }
    </MudStack>

    @if (!string.IsNullOrEmpty(_rosterError))
    {
        <MudAlert Severity="Severity.Error" Class="mt-2">@_rosterError</MudAlert>
    }
    @if (!string.IsNullOrEmpty(_rosterInfo))
    {
        <MudAlert Severity="Severity.Success" Class="mt-2">@_rosterInfo</MudAlert>
    }
</MudPaper>

@code {
    private string? _companyId;
    private AttTrackingMode _trackingMode = AttTrackingMode.None;

    private List<Att_ShiftDefinition> _shifts = new();
    private string _newShiftCode = "";
    private string _newShiftName = "";
    private TimeSpan? _newStartTime;
    private TimeSpan? _newEndTime;
    private string? _shiftError;

    private List<Att_ShiftAssignment> _assignments = new();
    private Hremployee? _assignEmployee;
    private DateTime? _assignDate = DateTime.Today;
    private long? _assignShiftId;
    private string? _assignError;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
        if (string.IsNullOrWhiteSpace(_companyId)) return;

        await using var context = await DbFactory.CreateDbContextAsync();
        var settings = await context.Att_CompanySettings.FirstOrDefaultAsync(s => s.CompanyId == _companyId);
        _trackingMode = settings?.TrackingMode ?? AttTrackingMode.None;
        if (_trackingMode != AttTrackingMode.ShiftBased) return;

        await LoadShiftsAsync();
        await LoadAssignmentsAsync();
    }

    private async Task LoadShiftsAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        _shifts = await context.Att_ShiftDefinitions
            .Where(s => s.CompanyId == _companyId && s.IsActive)
            .OrderBy(s => s.StartTime)
            .ToListAsync();
    }

    private async Task LoadAssignmentsAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        _assignments = await context.Att_ShiftAssignments
            .Include(a => a.Hremployee)
            .Include(a => a.ShiftDefinition)
            .Where(a => a.Hremployee.companyid == _companyId)
            .OrderByDescending(a => a.WorkDate)
            .Take(50)
            .ToListAsync();
    }

    private async Task AddShiftAsync()
    {
        _shiftError = null;

        if (string.IsNullOrWhiteSpace(_newShiftCode) || string.IsNullOrWhiteSpace(_newShiftName) || _newStartTime is null || _newEndTime is null)
        {
            _shiftError = "กรุณากรอกข้อมูลกะให้ครบถ้วน";
            return;
        }

        await using var context = await DbFactory.CreateDbContextAsync();
        var duplicate = await context.Att_ShiftDefinitions.AnyAsync(s => s.CompanyId == _companyId && s.ShiftCode == _newShiftCode);
        if (duplicate)
        {
            _shiftError = $"มีรหัสกะ {_newShiftCode} อยู่แล้ว";
            return;
        }

        context.Att_ShiftDefinitions.Add(new Att_ShiftDefinition
        {
            CompanyId = _companyId!,
            ShiftCode = _newShiftCode,
            ShiftName = _newShiftName,
            StartTime = TimeOnly.FromTimeSpan(_newStartTime.Value),
            EndTime = TimeOnly.FromTimeSpan(_newEndTime.Value),
            IsActive = true,
        });
        await context.SaveChangesAsync();

        Snackbar.Add("เพิ่มกะเรียบร้อย", Severity.Success);
        _newShiftCode = "";
        _newShiftName = "";
        _newStartTime = null;
        _newEndTime = null;
        await LoadShiftsAsync();
    }

    private async Task<IEnumerable<Hremployee>> SearchEmployeesAsync(string search, CancellationToken ct)
    {
        await using var context = await DbFactory.CreateDbContextAsync(ct);
        var query = context.Hremployee.Where(e => e.companyid == _companyId);
        if (!string.IsNullOrWhiteSpace(search))
        {
            query = query.Where(e => e.EmpNo.Contains(search)
                || (e.EmpName != null && e.EmpName.Contains(search))
                || (e.EmpSurname != null && e.EmpSurname.Contains(search)));
        }
        return await query.OrderBy(e => e.EmpNo).Take(20).ToListAsync(ct);
    }

    private async Task AssignShiftAsync()
    {
        _assignError = null;

        if (_assignEmployee is null || _assignDate is null || _assignShiftId is null)
        {
            _assignError = "กรุณาเลือกพนักงาน วันที่ และกะให้ครบถ้วน";
            return;
        }

        var workDate = DateOnly.FromDateTime(_assignDate.Value);

        await using var context = await DbFactory.CreateDbContextAsync();
        var existing = await context.Att_ShiftAssignments
            .FirstOrDefaultAsync(a => a.HremployeeId == _assignEmployee.id && a.WorkDate == workDate);

        if (existing is not null)
        {
            existing.ShiftDefinitionId = _assignShiftId.Value;
        }
        else
        {
            context.Att_ShiftAssignments.Add(new Att_ShiftAssignment
            {
                HremployeeId = _assignEmployee.id,
                WorkDate = workDate,
                ShiftDefinitionId = _assignShiftId.Value,
            });
        }
        await context.SaveChangesAsync();

        Snackbar.Add("มอบหมายกะเรียบร้อย", Severity.Success);
        await LoadAssignmentsAsync();
    }

    // ---- Shift Roster (bulk assign) ----
    private static readonly DayOfWeek[] _weekDays =
    {
        DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday,
        DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday,
    };

    private string _rosterTargetMode = "Org";
    private com_organization? _rosterOrg;
    private List<Hremployee> _rosterEmployees = new();
    private Hremployee? _rosterNewEmployee;
    private DateTime? _rosterStartDate = DateTime.Today;
    private DateTime? _rosterEndDate = DateTime.Today.AddDays(6);
    private string _rosterPatternMode = "Single";
    private long? _rosterSingleShiftId;
    private Dictionary<DayOfWeek, long?> _rosterWeeklyShiftIds = _weekDays.ToDictionary(d => d, d => (long?)null);
    private int? _rosterPreviewCount;
    private string? _rosterError;
    private string? _rosterInfo;

    private static string DayLabel(DayOfWeek d) => d switch
    {
        DayOfWeek.Monday => "จันทร์",
        DayOfWeek.Tuesday => "อังคาร",
        DayOfWeek.Wednesday => "พุธ",
        DayOfWeek.Thursday => "พฤหัสบดี",
        DayOfWeek.Friday => "ศุกร์",
        DayOfWeek.Saturday => "เสาร์",
        _ => "อาทิตย์",
    };

    private async Task<IEnumerable<com_organization>> SearchOrganizationsAsync(string search, CancellationToken ct)
    {
        await using var context = await DbFactory.CreateDbContextAsync(ct);
        var query = context.com_organizations.Where(o => o.isActive);
        query = HRM.Services.Shared.EntitySearchHelper.ApplyTextSearch(query, search, nameof(com_organization.code), nameof(com_organization.name));
        return await query.OrderBy(o => o.code).Take(20).ToListAsync(ct);
    }

    private void AddRosterEmployee()
    {
        _rosterError = null;
        if (_rosterNewEmployee is null) { _rosterError = "กรุณาเลือกพนักงาน"; return; }
        if (!_rosterEmployees.Any(e => e.id == _rosterNewEmployee.id))
            _rosterEmployees.Add(_rosterNewEmployee);
        _rosterNewEmployee = null;
    }

    // (date, shiftId) pairs the current pattern settings produce over the
    // selected date range — shared by preview and commit so they can never
    // disagree on what "N รายการ" actually means.
    private List<(DateOnly Date, long ShiftId)> ComputeRosterDates()
    {
        var result = new List<(DateOnly, long)>();
        if (_rosterStartDate is null || _rosterEndDate is null) return result;

        var start = DateOnly.FromDateTime(_rosterStartDate.Value);
        var end = DateOnly.FromDateTime(_rosterEndDate.Value);
        if (end < start) return result;

        for (var date = start; date <= end; date = date.AddDays(1))
        {
            long? shiftId = _rosterPatternMode == "Single"
                ? _rosterSingleShiftId
                : _rosterWeeklyShiftIds[date.DayOfWeek];
            if (shiftId is long id)
                result.Add((date, id));
        }
        return result;
    }

    private async Task<List<Hremployee>?> ResolveRosterTargetEmployeesAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        if (_rosterTargetMode == "Org")
        {
            if (_rosterOrg is null) { _rosterError = "กรุณาเลือกหน่วยงาน"; return null; }
            return await HRM.Services.Shared.OrgEmployeeResolverHelper.ResolveOrganizationSubtreeAsync(context, _companyId!, _rosterOrg.id);
        }
        if (_rosterEmployees.Count == 0) { _rosterError = "กรุณาเพิ่มพนักงานอย่างน้อย 1 คน"; return null; }
        return _rosterEmployees;
    }

    private async Task PreviewRosterAsync()
    {
        _rosterError = null;
        _rosterInfo = null;
        _rosterPreviewCount = null;

        var employees = await ResolveRosterTargetEmployeesAsync();
        if (employees is null) return;

        var dates = ComputeRosterDates();
        if (dates.Count == 0) { _rosterError = "ไม่มีวันที่/กะให้บันทึก ตรวจสอบช่วงวันที่และรูปแบบกะอีกครั้ง"; return; }

        _rosterPreviewCount = employees.Count * dates.Count;
    }

    private async Task CommitRosterAsync()
    {
        _rosterError = null;
        _rosterInfo = null;

        var employees = await ResolveRosterTargetEmployeesAsync();
        if (employees is null) return;

        var dates = ComputeRosterDates();
        if (dates.Count == 0) { _rosterError = "ไม่มีวันที่/กะให้บันทึก ตรวจสอบช่วงวันที่และรูปแบบกะอีกครั้ง"; return; }

        await using var context = await DbFactory.CreateDbContextAsync();
        var employeeIds = employees.Select(e => e.id).ToList();
        var minDate = dates.Min(d => d.Date);
        var maxDate = dates.Max(d => d.Date);

        // Load existing rows in range once, so the upsert loop below doesn't
        // round-trip per (employee, date) — same batch-save-once pattern as
        // PayrollCalculationService.
        var existing = await context.Att_ShiftAssignments
            .Where(a => employeeIds.Contains(a.HremployeeId) && a.WorkDate >= minDate && a.WorkDate <= maxDate)
            .ToListAsync();
        var existingByKey = existing.ToDictionary(a => (a.HremployeeId, a.WorkDate));

        var created = 0;
        var updated = 0;
        foreach (var emp in employees)
        {
            foreach (var (date, shiftId) in dates)
            {
                if (existingByKey.TryGetValue((emp.id, date), out var row))
                {
                    row.ShiftDefinitionId = shiftId;
                    updated++;
                }
                else
                {
                    context.Att_ShiftAssignments.Add(new Att_ShiftAssignment
                    {
                        HremployeeId = emp.id,
                        WorkDate = date,
                        ShiftDefinitionId = shiftId,
                    });
                    created++;
                }
            }
        }
        await context.SaveChangesAsync();

        _rosterInfo = $"บันทึกตารางกะสำเร็จ — สร้างใหม่ {created} รายการ, แก้ไข {updated} รายการ";
        _rosterPreviewCount = null;
        _rosterEmployees.Clear();
        await LoadAssignmentsAsync();
    }
}
