@page "/att/projects"
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@inject JsonLocalizationService L
@attribute [Authorize(Policy = "Menu:ATT_ADMIN")]

<PageTitle>@L.Translate("ProjectAdminPageTitle")</PageTitle>

<MudPaper Class="pa-4 mb-4" MaxWidth="900px">
    <MudText Typo="Typo.h5">@L.Translate("ProjectAdminHeading")</MudText>
    <MudText Typo="Typo.body2" Class="mt-1">
        @L.Translate("ProjectAdminDesc")
    </MudText>

    @if (string.IsNullOrEmpty(_companyId))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">@L.Translate("CompanyNotLinkedShortError")</MudAlert>
    }
    else
    {
        <MudDivider Class="my-4" />

        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
            <MudTextField T="string" Value="_searchTerm" Label="@L.Translate("SearchProjectPlaceholder")" Immediate="true" DebounceInterval="300"
                ValueChanged="OnSearchChangedAsync" AdornmentIcon="@Icons.Material.Filled.Search" Adornment="Adornment.Start" Class="flex-grow-1 mr-4" />
            @if (!_showForm)
            {
                <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreate">@L.Translate("AddButtonPlain")</MudButton>
            }
        </MudStack>

        <MudTable Items="_projects" Dense="true" Hover="true">
            <HeaderContent>
                <MudTh>@L.Translate("ColCode")</MudTh>
                <MudTh>@L.Translate("ColProjectName")</MudTh>
                <MudTh>@L.Translate("ColDescription")</MudTh>
                <MudTh>@L.Translate("ColStatus")</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Code</MudTd>
                <MudTd>@context.Name</MudTd>
                <MudTd>@context.Description</MudTd>
                <MudTd>@(context.IsActive ? L.Translate("PeriodActiveStatus") : L.Translate("PeriodInactiveStatus"))</MudTd>
                <MudTd>
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => EditAsync(context))">@L.Translate("EditButton")</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="@(() => ToggleActiveAsync(context))">
                        @(context.IsActive ? L.Translate("DeactivateButton") : L.Translate("ActivateButton"))
                    </MudButton>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText Typo="Typo.body2">@L.Translate("NoProjectsMessage")</MudText></NoRecordsContent>
        </MudTable>

        @if (_showForm)
        {
            <MudDivider Class="my-5" />

            <MudText Typo="Typo.h6">@(_editingId is null ? L.Translate("AddNewProjectHeading") : L.Translate("EditProjectHeading"))</MudText>
            <MudGrid Class="mt-2">
                <MudItem xs="12" sm="4"><MudTextField @bind-Value="_form.Code" Label="@L.Translate("ProjectCodeLabel")" /></MudItem>
                <MudItem xs="12" sm="8"><MudTextField @bind-Value="_form.Name" Label="@L.Translate("ColProjectName")" /></MudItem>
                <MudItem xs="12"><MudTextField @bind-Value="_form.Description" Label="@L.Translate("DescriptionOptionalLabel")" Lines="2" /></MudItem>
            </MudGrid>

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
            }

            <MudStack Row="true" Spacing="2" Class="mt-4">
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">@(_editingId is null ? L.Translate("AddButtonPlain") : L.Translate("SaveButton"))</MudButton>
                <MudButton Variant="Variant.Text" OnClick="CancelEdit">@L.Translate("CancelButton")</MudButton>
            </MudStack>
        }
    }
</MudPaper>

@code {
    private string? _companyId;
    private List<Att_Project> _projects = new();
    private string? _searchTerm;
    private string? _error;
    private long? _editingId;
    private bool _showForm;

    private class FormModel
    {
        public string Code { get; set; } = "";
        public string Name { get; set; } = "";
        public string? Description { get; set; }
    }

    private FormModel _form = new();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
        if (string.IsNullOrWhiteSpace(_companyId)) return;

        await LoadAsync();
    }

    private async Task OnSearchChangedAsync(string term)
    {
        _searchTerm = term;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var query = context.Att_Projects.Where(p => p.CompanyId == _companyId);
        query = EntitySearchHelper.ApplyTextSearch(query, _searchTerm, nameof(Att_Project.Code), nameof(Att_Project.Name));
        _projects = await query.OrderBy(p => p.Name).ToListAsync();
    }

    private void OpenCreate()
    {
        _editingId = null;
        _form = new FormModel();
        _error = null;
        _showForm = true;
    }

    private void EditAsync(Att_Project project)
    {
        _editingId = project.Id;
        _form = new FormModel { Code = project.Code, Name = project.Name, Description = project.Description };
        _error = null;
        _showForm = true;
    }

    private void CancelEdit()
    {
        _editingId = null;
        _form = new FormModel();
        _error = null;
        _showForm = false;
    }

    private async Task SaveAsync()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_form.Code) || string.IsNullOrWhiteSpace(_form.Name))
        {
            _error = L.Translate("SpecifyCodeNameProjectError");
            return;
        }

        await using var context = await DbFactory.CreateDbContextAsync();

        var duplicate = await context.Att_Projects.AnyAsync(p => p.CompanyId == _companyId && p.Code == _form.Code && p.Id != (_editingId ?? 0));
        if (duplicate)
        {
            _error = string.Format(L.Translate("ProjectCodeDuplicateTemplate"), _form.Code);
            return;
        }

        if (_editingId is null)
        {
            context.Att_Projects.Add(new Att_Project
            {
                CompanyId = _companyId!,
                Code = _form.Code,
                Name = _form.Name,
                Description = _form.Description,
                IsActive = true,
            });
        }
        else
        {
            var existing = await context.Att_Projects.FirstOrDefaultAsync(p => p.Id == _editingId && p.CompanyId == _companyId);
            if (existing is null) { _error = L.Translate("RecordNotFoundReloadError"); return; }
            existing.Code = _form.Code;
            existing.Name = _form.Name;
            existing.Description = _form.Description;
        }

        await context.SaveChangesAsync();
        Snackbar.Add(L.Translate("SavedSuccessGeneric"), Severity.Success);
        CancelEdit();
        await LoadAsync();
    }

    private async Task ToggleActiveAsync(Att_Project project)
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var existing = await context.Att_Projects.FirstOrDefaultAsync(p => p.Id == project.Id && p.CompanyId == _companyId);
        if (existing is null) return;

        existing.IsActive = !existing.IsActive;
        await context.SaveChangesAsync();
        await LoadAsync();
    }
}
