@page "/att/import"
@using System.Globalization
@using System.Security.Claims
@using HRM.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@inject JsonLocalizationService L
@attribute [Authorize(Policy = "Menu:ATT_ADMIN")]

<PageTitle>@L.Translate("PunchLogImportPageTitle")</PageTitle>

<MudPaper Class="pa-4 mb-4">
    <MudText Typo="Typo.h5">@L.Translate("PunchLogImportHeading")</MudText>
    <MudText Typo="Typo.body2" Class="mt-1">
        @L.Translate("PunchLogImportDesc")
    </MudText>

    @if (string.IsNullOrEmpty(_companyId))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">@L.Translate("CompanyNotLinkedError")</MudAlert>
        return;
    }

    @if (_trackingMode == AttTrackingMode.None)
    {
        <MudAlert Severity="Severity.Info" Class="mt-4">
            @L.Translate("AttNotEnabledPrefix") <MudLink Href="/att/settings">@L.Translate("AttSettingsPageTitle")</MudLink> @L.Translate("NoPlansAvailableSuffix")
        </MudAlert>
        return;
    }

    <MudExpansionPanels Class="mt-3">
        <MudExpansionPanel Text="@L.Translate("RegisteredDevicesPanelHeading")">
            <MudGrid>
                <MudItem xs="12" sm="3">
                    <MudTextField @bind-Value="_newDeviceCode" Label="@L.Translate("DeviceCodeLabel")" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudTextField @bind-Value="_newDeviceName" Label="@L.Translate("DeviceNameLabel")" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudSelect T="AttDeviceType" @bind-Value="_newDeviceType" Label="@L.Translate("DeviceTypeLabel")">
                        <MudSelectItem T="AttDeviceType" Value="AttDeviceType.Fingerprint">@L.Translate("DeviceTypeFingerprint")</MudSelectItem>
                        <MudSelectItem T="AttDeviceType" Value="AttDeviceType.FaceRecognition">@L.Translate("DeviceTypeFaceRecognition")</MudSelectItem>
                        <MudSelectItem T="AttDeviceType" Value="AttDeviceType.CardReader">@L.Translate("DeviceTypeCardReader")</MudSelectItem>
                        <MudSelectItem T="AttDeviceType" Value="AttDeviceType.Mobile">@L.Translate("DeviceTypeMobile")</MudSelectItem>
                        <MudSelectItem T="AttDeviceType" Value="AttDeviceType.Manual">@L.Translate("DeviceTypeManual")</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="AddDeviceAsync">@L.Translate("AddDeviceButton")</MudButton>
                </MudItem>
            </MudGrid>
            @if (!string.IsNullOrEmpty(_deviceError))
            {
                <MudAlert Severity="Severity.Error" Class="mt-2">@_deviceError</MudAlert>
            }
        </MudExpansionPanel>
    </MudExpansionPanels>

    <MudGrid Class="mt-3">
        <MudItem xs="12" sm="5">
            <MudSelect T="long?" @bind-Value="_deviceId" Label="@L.Translate("ScanDeviceOptionalLabel")">
                <MudSelectItem T="long?" Value="@((long?)null)">@L.Translate("UnspecifiedDashText")</MudSelectItem>
                @foreach (var d in _devices)
                {
                    <MudSelectItem T="long?" Value="@((long?)d.Id)">@d.DeviceName (@d.DeviceCode)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudFileUpload T="IBrowserFile" FilesChanged="OnFileSelected">
                <ActivatorContent>
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AttachFile">
                        @(_uploadFile?.Name ?? L.Translate("SelectCsvFileButton"))
                    </MudButton>
                </ActivatorContent>
            </MudFileUpload>
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ImportAsync" Disabled="_uploadFile is null">@L.Translate("ImportButton")</MudButton>
        </MudItem>
    </MudGrid>

    @if (!string.IsNullOrEmpty(_importError))
    {
        <MudAlert Severity="Severity.Error" Class="mt-3">@_importError</MudAlert>
    }

    @if (_lastResult is not null)
    {
        <MudAlert Severity="@(_lastResult.SkippedRows > 0 ? Severity.Warning : Severity.Success)" Class="mt-3">
            @string.Format(L.Translate("ImportSuccessTemplate"), _lastResult.ImportedRows, _lastResult.TotalRows)
            @if (_lastResult.SkippedRows > 0)
            {
                <span>@string.Format(L.Translate("SkippedRowsInlineTemplate"), _lastResult.SkippedRows, _lastResult.ErrorSummary)</span>
            }
        </MudAlert>
    }

    <MudDivider Class="my-5" />

    <MudText Typo="Typo.h6">@L.Translate("ImportHistoryHeading")</MudText>
    <MudTable Items="_batches" Dense="true" Class="mt-2">
        <HeaderContent>
            <MudTh>@L.Translate("ColImportDate")</MudTh>
            <MudTh>@L.Translate("ColFile")</MudTh>
            <MudTh>@L.Translate("ColTotal")</MudTh>
            <MudTh>@L.Translate("ColSuccess")</MudTh>
            <MudTh>@L.Translate("ColSkipped")</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.ImportedDate.ToString("dd/MM/yyyy HH:mm")</MudTd>
            <MudTd>@context.FileName</MudTd>
            <MudTd>@context.TotalRows</MudTd>
            <MudTd>@context.ImportedRows</MudTd>
            <MudTd>@context.SkippedRows</MudTd>
        </RowTemplate>
    </MudTable>
</MudPaper>

@code {
    private string? _companyId;
    private AttTrackingMode _trackingMode = AttTrackingMode.None;
    private List<Att_Device> _devices = new();
    private long? _deviceId;
    private string _newDeviceCode = "";
    private string _newDeviceName = "";
    private AttDeviceType _newDeviceType = AttDeviceType.Fingerprint;
    private string? _deviceError;
    private IBrowserFile? _uploadFile;
    private string? _importError;
    private Att_ImportBatch? _lastResult;
    private List<Att_ImportBatch> _batches = new();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
        if (string.IsNullOrWhiteSpace(_companyId)) return;

        await using var context = await DbFactory.CreateDbContextAsync();
        var settings = await context.Att_CompanySettings.FirstOrDefaultAsync(s => s.CompanyId == _companyId);
        _trackingMode = settings?.TrackingMode ?? AttTrackingMode.None;
        if (_trackingMode == AttTrackingMode.None) return;

        _devices = await context.Att_Devices.Where(d => d.CompanyId == _companyId && d.IsActive).ToListAsync();
        await LoadBatchesAsync();
    }

    private async Task LoadBatchesAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        _batches = await context.Att_ImportBatches
            .Where(b => b.CompanyId == _companyId)
            .OrderByDescending(b => b.ImportedDate)
            .Take(20)
            .ToListAsync();
    }

    private async Task AddDeviceAsync()
    {
        _deviceError = null;

        if (string.IsNullOrWhiteSpace(_newDeviceCode) || string.IsNullOrWhiteSpace(_newDeviceName))
        {
            _deviceError = L.Translate("FillDeviceCodeNameError");
            return;
        }

        await using var context = await DbFactory.CreateDbContextAsync();
        var duplicate = await context.Att_Devices.AnyAsync(d => d.CompanyId == _companyId && d.DeviceCode == _newDeviceCode);
        if (duplicate)
        {
            _deviceError = string.Format(L.Translate("DeviceCodeDuplicateTemplate"), _newDeviceCode);
            return;
        }

        context.Att_Devices.Add(new Att_Device
        {
            CompanyId = _companyId!,
            DeviceCode = _newDeviceCode,
            DeviceName = _newDeviceName,
            DeviceType = _newDeviceType,
            IsActive = true,
        });
        await context.SaveChangesAsync();

        Snackbar.Add(L.Translate("DeviceAddedSuccess"), Severity.Success);
        _newDeviceCode = "";
        _newDeviceName = "";

        _devices = await context.Att_Devices.Where(d => d.CompanyId == _companyId && d.IsActive).ToListAsync();
    }

    private void OnFileSelected(IBrowserFile file)
    {
        _uploadFile = file;
        _lastResult = null;
    }

    private async Task ImportAsync()
    {
        _importError = null;
        _lastResult = null;

        if (_uploadFile is null || string.IsNullOrWhiteSpace(_companyId)) return;

        const long maxSize = 10 * 1024 * 1024;
        if (_uploadFile.Size > maxSize)
        {
            _importError = L.Translate("FileTooLargeImportError");
            return;
        }

        string content;
        await using (var stream = _uploadFile.OpenReadStream(maxSize))
        using (var reader = new StreamReader(stream))
        {
            content = await reader.ReadToEndAsync();
        }

        var lines = content.Split('\n', StringSplitOptions.RemoveEmptyEntries)
            .Select(l => l.Trim().TrimEnd('\r'))
            .Where(l => l.Length > 0)
            .ToList();

        await using var context = await DbFactory.CreateDbContextAsync();

        var employeesByCode = await context.Hremployee
            .Where(e => e.companyid == _companyId)
            .ToDictionaryAsync(e => e.EmpNo, e => e.id);

        var state = await AuthProvider.GetAuthenticationStateAsync();
        var userIdClaim = state.User.FindFirstValue("sc_userid");
        var userId = long.TryParse(userIdClaim, out var uid) ? uid : 0;

        var batch = new Att_ImportBatch
        {
            CompanyId = _companyId,
            DeviceId = _deviceId,
            FileName = _uploadFile.Name,
            ImportedByUserId = userId,
            ImportedDate = DateTime.Now,
            TotalRows = lines.Count,
        };
        context.Att_ImportBatches.Add(batch);
        await context.SaveChangesAsync();

        var imported = 0;
        var errors = new List<string>();

        foreach (var line in lines)
        {
            var parts = line.Split(',');
            if (parts.Length < 2)
            {
                errors.Add(string.Format(L.Translate("InvalidRowFormatTemplate"), line));
                continue;
            }

            var empCode = parts[0].Trim();
            var dateTimeRaw = parts[1].Trim();
            var directionRaw = parts.Length > 2 ? parts[2].Trim() : "";

            if (!employeesByCode.TryGetValue(empCode, out var hremployeeId))
            {
                errors.Add(string.Format(L.Translate("EmpCodeNotFoundTemplate"), empCode));
                continue;
            }

            if (!DateTime.TryParse(dateTimeRaw, CultureInfo.InvariantCulture, DateTimeStyles.None, out var punchTime))
            {
                errors.Add(string.Format(L.Translate("DateTimeParseErrorTemplate"), dateTimeRaw, empCode));
                continue;
            }

            var direction = directionRaw.ToLowerInvariant() switch
            {
                "in" or "เข้า" => AttPunchDirection.In,
                "out" or "ออก" => AttPunchDirection.Out,
                _ => AttPunchDirection.Unknown,
            };

            context.Att_PunchLogs.Add(new Att_PunchLog
            {
                CompanyId = _companyId,
                HremployeeId = hremployeeId,
                RawEmpCode = empCode,
                DeviceId = _deviceId,
                PunchTime = punchTime,
                Direction = direction,
                Source = AttPunchSource.Device,
                ImportBatchId = batch.Id,
            });
            imported++;
        }

        batch.ImportedRows = imported;
        batch.SkippedRows = lines.Count - imported;
        batch.ErrorSummary = errors.Count > 0 ? string.Join("; ", errors.Take(10)) : null;

        await context.SaveChangesAsync();

        _lastResult = batch;
        _uploadFile = null;
        Snackbar.Add(L.Translate("FileImportedSuccess"), Severity.Success);
        await LoadBatchesAsync();
    }
}
