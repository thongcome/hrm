@page "/sc_roles/details"
@using Microsoft.EntityFrameworkCore
@using HRM.Models
@inject IDbContextFactory<HRM.Models.HRMContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<div>
    <h2>sc_role</h2>
    <hr />
    @if (sc_role is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">name</dt>
            <dd class="col-sm-10">@sc_role.name</dd>
            <dt class="col-sm-2">abbr</dt>
            <dd class="col-sm-10">@sc_role.abbr</dd>
            <dt class="col-sm-2">rolelevel</dt>
            <dd class="col-sm-10">@sc_role.rolelevel</dd>
            <dt class="col-sm-2">upperrole</dt>
            <dd class="col-sm-10">@sc_role.upperrole</dd>
            <dt class="col-sm-2">rolecode</dt>
            <dd class="col-sm-10">@sc_role.rolecode</dd>
            <dt class="col-sm-2">isactive</dt>
            <dd class="col-sm-10">@sc_role.isactive</dd>
            <dt class="col-sm-2">moddate</dt>
            <dd class="col-sm-10">@sc_role.moddate</dd>
            <dt class="col-sm-2">modby</dt>
            <dd class="col-sm-10">@sc_role.modby</dd>
            <dt class="col-sm-2">isHeader</dt>
            <dd class="col-sm-10">@sc_role.isHeader</dd>
            <dt class="col-sm-2">ref1</dt>
            <dd class="col-sm-10">@sc_role.ref1</dd>
            <dt class="col-sm-2">ref2</dt>
            <dd class="col-sm-10">@sc_role.ref2</dd>
        </dl>
        <div>
            <a href="@($"/sc_roles/edit?roleid={sc_role.roleid}")">Edit</a> |
            <a href="@($"/sc_roles")">Back to List</a>
        </div>
    }
</div>

@code {
    private sc_role? sc_role;

    [SupplyParameterFromQuery]
    private long roleid { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        sc_role = await context.sc_roles.FirstOrDefaultAsync(m => m.roleid == roleid);

        if (sc_role is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
