@page "/career/my-path"
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Ess
@using HRM.Services.Career
@using HRM.Services.Idp
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@inject AuthenticationStateProvider AuthProvider
@inject IDbContextFactory<HRMContext> DbFactory
@inject CareerPathService PathService
@inject IdpAssessmentService IdpService
@inject JsonLocalizationService L
@attribute [Authorize(Policy = "Menu:CAREER_ACCESS")]

<PageTitle>@L.Translate("MyCareerPathPageTitle")</PageTitle>

@if (_notFound)
{
    <MudAlert Severity="Severity.Warning" Class="ma-4">@L.Translate("CheckinNotLinked")</MudAlert>
}
else if (_result is null)
{
    <MudText Class="ma-4">@L.Translate("LoadingText")</MudText>
}
else
{
    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h5">@L.Translate("MyCareerPathHeading")</MudText>

        @if (_result.CurrentPosExecTypeName is null)
        {
            <MudAlert Severity="Severity.Info" Class="mt-3">@L.Translate("NoPositionSlotLinkedInfo")</MudAlert>
        }
        else if (_result.JobFamilyId is null)
        {
            <MudAlert Severity="Severity.Info" Class="mt-3">@string.Format(L.Translate("CurrentPositionNoJobFamilyTemplate"), _result.CurrentPosExecTypeName)</MudAlert>
        }
        else if (_result.Steps.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Class="mt-3">@string.Format(L.Translate("JobFamilyNoPathTemplate"), _result.JobFamilyName)</MudAlert>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mt-1 mb-3">@L.Translate("JobFamilyLabelPrefix") @_result.JobFamilyName</MudText>
            <MudStack Row="true" Spacing="2" Class="flex-wrap">
                @foreach (var step in _result.Steps)
                {
                    var isCurrent = _result.CurrentStep?.StepId == step.StepId;
                    var isNext = _result.NextStep?.StepId == step.StepId;
                    <MudPaper Class="pa-3" Outlined="true" Style="@(isCurrent ? "border-color:var(--mud-palette-primary);border-width:2px" : isNext ? "border-color:var(--mud-palette-info);border-width:2px" : "")">
                        <MudText Typo="Typo.body2">@step.PosExecTypeName</MudText>
                        @if (isCurrent)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary">@L.Translate("CurrentPositionChip")</MudChip>
                        }
                        @if (isNext)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Info">@L.Translate("NextStepChip")</MudChip>
                        }
                    </MudPaper>
                }
            </MudStack>

            @if (_result.NextStep is not null)
            {
                <MudText Typo="Typo.h6" Class="mt-4 mb-2">@L.Translate("GapAnalysisNextStepHeadingPrefix") (@_result.NextStep.PosExecTypeName)</MudText>
                @if (_gapRows.Count == 0)
                {
                    <MudAlert Severity="Severity.Info">@L.Translate("NoNextStepRequirementsMessage")</MudAlert>
                }
                else
                {
                    <MudTable Items="_gapRows" Dense="true" Hover="true">
                        <HeaderContent>
                            <MudTh>@L.Translate("ColCompetency")</MudTh>
                            <MudTh>@L.Translate("RequiredLevelColLabel")</MudTh>
                            <MudTh>@L.Translate("CurrentLevelColLabel")</MudTh>
                            <MudTh>@L.Translate("GapColLabel")</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                @context.CompetencyName
                                @if (context.IsCritical)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ml-1">@L.Translate("CriticalChip")</MudChip>
                                }
                            </MudTd>
                            <MudTd>@context.RequiredLevel</MudTd>
                            <MudTd>@(context.EffectiveLevel?.ToString() ?? L.Translate("NotYetAssessedText"))</MudTd>
                            <MudTd>
                                @if (context.Gap is int gap)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="@(gap > 0 ? Color.Error : Color.Success)">@gap</MudChip>
                                }
                                else
                                {
                                    <MudText Typo="Typo.body2">-</MudText>
                                }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            }
            else if (_result.CurrentStep is not null)
            {
                <MudAlert Severity="Severity.Success" Class="mt-3">@L.Translate("TopOfCareerPathMessage")</MudAlert>
            }
        }
    </MudPaper>
}

@code {
    private bool _notFound;
    private Hremployee? _employee;
    private CareerPathService.MyPathResult? _result;
    private List<IdpAssessmentService.CompetencyGapRow> _gapRows = new();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        await using var context = await DbFactory.CreateDbContextAsync();
        _employee = await EssEmployeeResolver.ResolveAsync(context, state.User);
        if (_employee is null)
        {
            _notFound = true;
            return;
        }

        _result = await PathService.GetMyPathAsync(_employee.id);
        if (_result.NextStep is not null)
            _gapRows = await IdpService.GetGapAnalysisForTargetPositionAsync(_employee.id, _result.NextStep.PosExecTypeId);
    }
}
