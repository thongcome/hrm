@page "/career/paths"
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Career
@using HRM.Services.Shared
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject CareerPathService PathService
@inject ISnackbar Snackbar
@inject JsonLocalizationService L
@attribute [Authorize(Policy = "Menu:CAREER_ADMIN")]

<PageTitle>@L.Translate("CareerPathPageTitle")</PageTitle>

@if (string.IsNullOrEmpty(_companyId))
{
    <MudAlert Severity="Severity.Error" Class="ma-4">@L.Translate("CompanyNotLinkedShortError")</MudAlert>
}
else
{
    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h5">@L.Translate("CareerPathHeading")</MudText>
        <MudText Typo="Typo.body2" Class="mt-1 mb-3">
            @L.Translate("CareerPathDesc")
        </MudText>

        <MudSelect T="Job_Family" Value="_selectedFamily" Label="@L.Translate("JobFamilyFieldLabel")" ValueChanged="OnFamilyChangedAsync">
            @foreach (var f in _families)
            {
                <MudSelectItem Value="f">@f.Name</MudSelectItem>
            }
        </MudSelect>
    </MudPaper>

    @if (_selectedFamily is not null)
    {
        <MudPaper Class="pa-4 mb-4">
            <MudTable Items="_steps" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh>@L.Translate("ColOrder")</MudTh>
                    <MudTh>@L.Translate("ColPosition")</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.SortOrder</MudTd>
                    <MudTd>@context.PosExecTypeName</MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" OnClick="@(() => MoveAsync(context.StepId, true))" />
                        <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" OnClick="@(() => MoveAsync(context.StepId, false))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => RemoveAsync(context.StepId))" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText Typo="Typo.body2">@L.Translate("NoStepsInFamilyMessage")</MudText></NoRecordsContent>
            </MudTable>
        </MudPaper>

        <MudPaper Class="pa-4 mb-4">
            <MudText Typo="Typo.h6" Class="mb-2">@L.Translate("AddPositionToStepHeading")</MudText>
            <MudGrid>
                <MudItem xs="12" sm="9">
                    <MudAutocomplete T="Pos_ExecType" Label="@L.Translate("JobFieldLabel")" @bind-Value="_selectedExecType"
                        SearchFunc="SearchExecTypesAsync"
                        ToStringFunc="@(t => t == null ? null : $"{t.Code} — {t.Name}")"
                        ResetValueOnEmptyText="true" CoerceText="true" MinCharacters="0" />
                </MudItem>
                <MudItem xs="12" sm="3" Class="d-flex align-center">
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="AddStepAsync" Disabled="@(_selectedExecType is null)">@L.Translate("AddToStepButton")</MudButton>
                </MudItem>
            </MudGrid>
            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mt-2">@_error</MudAlert>
            }
        </MudPaper>
    }

    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6">เส้นทางแบบแตกสาย (Transitions)</MudText>
        <MudText Typo="Typo.body2" Class="mt-1 mb-3">
            กำหนดว่าจากตำแหน่งหนึ่ง สามารถก้าวไปตำแหน่งใดได้บ้าง (ได้หลายตำแหน่ง รวมถึงข้ามสายงาน) — ถ้าตำแหน่งใดมี transition กำหนดไว้ หน้า "เส้นทางอาชีพของฉัน" จะใช้แทนขั้นถัดไปตามลำดับสายงาน
        </MudText>

        <MudAutocomplete T="Pos_ExecType" Label="ตำแหน่งต้นทาง" Value="_transitionFromExecType"
            ValueChanged="OnTransitionFromChangedAsync"
            SearchFunc="SearchExecTypesAsync"
            ToStringFunc="@(t => t == null ? null : $"{t.Code} — {t.Name}")"
            ResetValueOnEmptyText="true" CoerceText="true" MinCharacters="0" />

        @if (_transitionFromExecType is not null)
        {
            <MudTable Items="_transitions" Dense="true" Hover="true" Class="mt-3">
                <HeaderContent>
                    <MudTh>ตำแหน่งปลายทาง</MudTh>
                    <MudTh>หมายเหตุ/เงื่อนไข</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.ToPosExecTypeName</MudTd>
                    <MudTd>@(context.Note ?? "-")</MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => RemoveTransitionAsync(context.TransitionId))" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText Typo="Typo.body2">ตำแหน่งนี้ยังไม่มีเส้นทางแตกสาย — เพิ่มตำแหน่งปลายทางด้านล่าง</MudText></NoRecordsContent>
            </MudTable>

            <MudGrid Class="mt-2">
                <MudItem xs="12" sm="5">
                    <MudAutocomplete T="Pos_ExecType" Label="ตำแหน่งปลายทาง" @bind-Value="_transitionToExecType"
                        SearchFunc="SearchExecTypesAsync"
                        ToStringFunc="@(t => t == null ? null : $"{t.Code} — {t.Name}")"
                        ResetValueOnEmptyText="true" CoerceText="true" MinCharacters="0" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField T="string" @bind-Value="_transitionNote" Label="หมายเหตุ/เงื่อนไข (ถ้ามี)" MaxLength="500" />
                </MudItem>
                <MudItem xs="12" sm="3" Class="d-flex align-center">
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="AddTransitionAsync" Disabled="@(_transitionToExecType is null)">เพิ่มเส้นทาง</MudButton>
                </MudItem>
            </MudGrid>
            @if (!string.IsNullOrEmpty(_transitionError))
            {
                <MudAlert Severity="Severity.Error" Class="mt-2">@_transitionError</MudAlert>
            }
        }
    </MudPaper>
}

@code {
    private string? _companyId;
    private List<Job_Family> _families = new();
    private Job_Family? _selectedFamily;
    private List<CareerPathService.StepRow> _steps = new();
    private Pos_ExecType? _selectedExecType;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
        if (string.IsNullOrWhiteSpace(_companyId)) return;

        await using var context = await DbFactory.CreateDbContextAsync();
        _families = await context.Job_Families.Where(f => f.CompanyId == _companyId && f.IsActive).OrderBy(f => f.Name).ToListAsync();
    }

    private async Task OnFamilyChangedAsync(Job_Family family)
    {
        _selectedFamily = family;
        await LoadStepsAsync();
    }

    private async Task LoadStepsAsync()
    {
        if (string.IsNullOrEmpty(_companyId) || _selectedFamily is null) return;
        _steps = await PathService.GetStepsAsync(_companyId, _selectedFamily.Id);
    }

    private async Task<IEnumerable<Pos_ExecType>> SearchExecTypesAsync(string search, CancellationToken ct)
    {
        await using var context = await DbFactory.CreateDbContextAsync(ct);
        var query = context.Pos_ExecTypes.Where(t => t.CompanyId == _companyId && t.IsActive);
        query = EntitySearchHelper.ApplyTextSearch(query, search, nameof(Pos_ExecType.Code), nameof(Pos_ExecType.Name));
        return await query.OrderBy(t => t.Name).Take(20).ToListAsync(ct);
    }

    private async Task AddStepAsync()
    {
        if (_selectedExecType is null || string.IsNullOrEmpty(_companyId) || _selectedFamily is null) return;
        _error = null;
        try
        {
            await PathService.AddStepAsync(_companyId, _selectedFamily.Id, _selectedExecType.Id);
            Snackbar.Add(L.Translate("StepAddedSuccess"), Severity.Success);
            _selectedExecType = null;
            await LoadStepsAsync();
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
    }

    private async Task MoveAsync(long stepId, bool moveUp)
    {
        await PathService.MoveStepAsync(stepId, moveUp);
        await LoadStepsAsync();
    }

    private async Task RemoveAsync(long stepId)
    {
        await PathService.RemoveStepAsync(stepId);
        Snackbar.Add(L.Translate("StepRemovedSuccess"), Severity.Success);
        await LoadStepsAsync();
    }

    // ----- Transitions (career lattice) -----

    private Pos_ExecType? _transitionFromExecType;
    private Pos_ExecType? _transitionToExecType;
    private string? _transitionNote;
    private string? _transitionError;
    private List<CareerPathService.TransitionRow> _transitions = new();

    private async Task OnTransitionFromChangedAsync(Pos_ExecType? execType)
    {
        _transitionFromExecType = execType;
        _transitionError = null;
        await LoadTransitionsAsync();
    }

    private async Task LoadTransitionsAsync()
    {
        if (string.IsNullOrEmpty(_companyId) || _transitionFromExecType is null)
        {
            _transitions = new();
            return;
        }
        _transitions = await PathService.GetTransitionsFromAsync(_companyId, _transitionFromExecType.Id);
    }

    private async Task AddTransitionAsync()
    {
        if (string.IsNullOrEmpty(_companyId) || _transitionFromExecType is null || _transitionToExecType is null) return;
        _transitionError = null;

        var state = await AuthProvider.GetAuthenticationStateAsync();
        var userId = long.TryParse(state.User.FindFirstValue("sc_userid"), out var uid) ? uid : 0;

        try
        {
            await PathService.AddTransitionAsync(_companyId, _transitionFromExecType.Id, _transitionToExecType.Id, _transitionNote, userId);
            Snackbar.Add("เพิ่มเส้นทางแล้ว", Severity.Success);
            _transitionToExecType = null;
            _transitionNote = null;
            await LoadTransitionsAsync();
        }
        catch (InvalidOperationException ex)
        {
            _transitionError = ex.Message;
        }
    }

    private async Task RemoveTransitionAsync(long transitionId)
    {
        await PathService.RemoveTransitionAsync(transitionId);
        Snackbar.Add("ลบเส้นทางแล้ว", Severity.Success);
        await LoadTransitionsAsync();
    }
}
