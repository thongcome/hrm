@page "/ot-requests"
@using HRM.Models
@using HRM.Services.Workflow
@using HRM.Services.Att.Calculators
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject WorkflowEngineService Engine
@inject HRM.Services.Att.OtPolicyService OtPolicy
@inject AuthenticationStateProvider AuthProvider
@attribute [Authorize(Policy = "Menu:WF_WORKFLOW_ADMIN")]

<PageTitle>คำขอทำงานล่วงเวลา (OT)</PageTitle>

<MudPaper Class="pa-4 mb-4">
    <MudText Typo="Typo.h5">คำขอทำงานล่วงเวลา (OT)</MudText>
    <MudText Typo="Typo.body2" Class="mb-3" Color="Color.Secondary">
        ตัวอย่างเอกสารจริงตัวแรกที่วิ่งผ่าน Workflow Approval Engine เต็มรูปแบบ (สร้างงาน → หัวหน้าอนุมัติตามผังองค์กร → HR อนุมัติ → ผลักเข้า HRW_OT ให้ payroll)
    </MudText>

    @if (!string.IsNullOrEmpty(_error))
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
    }
    @if (!string.IsNullOrEmpty(_info))
    {
        <MudAlert Severity="Severity.Success" Class="mb-3">@_info</MudAlert>
    }

    <MudTable Items="_requests" Dense="true" Hover="true">
        <HeaderContent>
            <MudTh>#</MudTh>
            <MudTh>พนักงาน</MudTh>
            <MudTh>วันที่ OT</MudTh>
            <MudTh>ชั่วโมง</MudTh>
            <MudTh>สถานะ</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Request.id</MudTd>
            <MudTd>@context.Request.name</MudTd>
            <MudTd>@context.Request.starttime.ToString("dd/MM/yyyy HH:mm") - @context.Request.endtime.ToString("HH:mm")</MudTd>
            <MudTd>@(context.Request.workhour?.ToString("0.##") ?? "-")</MudTd>
            <MudTd>
                @if (context.Request.jobmasterid is null)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Default">ร่าง (ยังไม่ส่ง)</MudChip>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.JobStatus)">@context.JobStatus</MudChip>
                }
            </MudTd>
            <MudTd>
                <MudStack Row="true" Spacing="1">
                    <MudButton Size="Size.Small" Variant="Variant.Text" Href="@($"/ot-requests/detail/{context.Request.id}")">ดูรายละเอียด</MudButton>
                    @if (context.Request.jobmasterid is null)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => SubmitAsync(context.Request.id))">ส่งขออนุมัติ</MudButton>
                    }
                    @if (context.JobStatus == "COMPLETED" && context.Request.hrwOtId is null)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success" OnClick="@(() => PushToPayrollAsync(context.Request.id))">สร้างรายการจ่าย OT</MudButton>
                    }
                    @if (context.Request.hrwOtId is not null)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Info">@(context.Request.hrwOtId < 0
    ? $"เข้า Payroll แล้ว (เงินได้รายครั้ง #{-context.Request.hrwOtId})"
    : $"เข้า Payroll แล้ว (HRW_OT #{context.Request.hrwOtId})")</MudChip>
                    }
                </MudStack>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2">ยังไม่มีคำขอ OT</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

<MudPaper Class="pa-4 mb-4">
    <MudText Typo="Typo.h6">ยื่นคำขอ OT ใหม่</MudText>
    <MudGrid Class="mt-1">
        <MudItem xs="12" sm="6">
            <MudAutocomplete T="Hremployee" Label="พนักงาน" Value="_selectedEmployee" ValueChanged="OnEmployeeChangedAsync"
                SearchFunc="SearchEmployeesAsync" ToStringFunc="@(e => e is null ? "" : $"{e.EmpNo} - {e.EmpName} {e.EmpSurname}")" ResetValueOnEmptyText="true" />
        </MudItem>
        <MudItem xs="12" sm="3"><MudDatePicker Label="วันที่ OT" Date="_otDate" DateChanged="OnOtDateChangedAsync" /></MudItem>
        <MudItem xs="12" sm="3"></MudItem>
        <MudItem xs="12" sm="3"><MudTimePicker Label="เวลาเริ่ม" @bind-Time="_startTime" /></MudItem>
        <MudItem xs="12" sm="3"><MudTimePicker Label="เวลาสิ้นสุด" @bind-Time="_endTime" /></MudItem>
        <MudItem xs="12" sm="3">
            <MudNumericField T="decimal?" @bind-Value="_otRate" Label="อัตรา OT (บาท/ชม.)" />
            @if (!string.IsNullOrEmpty(_rateSuggestionNote))
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">@_rateSuggestionNote</MudText>
            }
        </MudItem>
        <MudItem xs="12"><MudTextField @bind-Value="_objective" Label="วัตถุประสงค์" /></MudItem>
        <MudItem xs="12"><MudTextField @bind-Value="_remark" Label="หมายเหตุ" Lines="2" /></MudItem>
        <MudItem xs="12">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateRequestAsync">บันทึกคำขอ (ร่าง)</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@code {
    private record RequestRow(emp_overtime_request Request, string JobStatus);

    private List<RequestRow> _requests = new();
    private string? _error;
    private string? _info;

    private long _actorUserId;
    private string? _actorEmpId;

    private Hremployee? _selectedEmployee;
    private DateTime? _otDate = DateTime.Today;
    private TimeSpan? _startTime = new TimeSpan(18, 0, 0);
    private TimeSpan? _endTime = new TimeSpan(20, 0, 0);
    private decimal? _otRate = 100m;
    private string? _objective;
    private string? _remark;
    private string? _rateSuggestionNote;
    private string? _capWarning;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _actorUserId = long.Parse(state.User.FindFirst("sc_userid")?.Value ?? "0");
        _actorEmpId = state.User.FindFirst("empno")?.Value;

        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var requests = await context.emp_overtime_requests.OrderByDescending(r => r.id).ToListAsync();
        var jobIds = requests.Where(r => r.jobmasterid is not null).Select(r => r.jobmasterid!.Value).ToList();
        var jobStatuses = await context.job_masters.Where(j => jobIds.Contains(j.jobmasterid))
            .ToDictionaryAsync(j => j.jobmasterid, j => j.status);

        _requests = requests.Select(r => new RequestRow(r,
            r.jobmasterid is not null && jobStatuses.TryGetValue(r.jobmasterid.Value, out var s) ? s : "-")).ToList();
    }

    private static Color StatusColor(string status) => status switch
    {
        "COMPLETED" => Color.Success,
        "REJECTED" or "RETURNED" => Color.Error,
        _ => Color.Warning,
    };

    private async Task<IEnumerable<Hremployee>> SearchEmployeesAsync(string term, CancellationToken ct)
    {
        await using var context = await DbFactory.CreateDbContextAsync(ct);
        var query = context.Hremployee.AsQueryable();
        if (!string.IsNullOrWhiteSpace(term))
            query = query.Where(e => e.EmpNo.Contains(term) || (e.EmpName != null && e.EmpName.Contains(term)) || (e.EmpSurname != null && e.EmpSurname.Contains(term)));
        return await query.OrderBy(e => e.EmpNo).Take(20).ToListAsync(ct);
    }

    private async Task OnEmployeeChangedAsync(Hremployee? employee)
    {
        _selectedEmployee = employee;
        await RecomputeSuggestedRateAsync();
    }

    private async Task OnOtDateChangedAsync(DateTime? date)
    {
        _otDate = date;
        await RecomputeSuggestedRateAsync();
    }

    // Auto-suggests the OT rate (บาท/ชม.) from the employee's monthly wage
    // times the company's configured Att_OtRule multiplier for the day type
    // the selected date falls on — replacing the old "HR types any number"
    // flow. Still just a suggestion: HR can freely overtype _otRate
    // afterwards, and this only recomputes on employee/date change so a
    // manual override isn't clobbered by unrelated field edits.
    private async Task RecomputeSuggestedRateAsync()
    {
        _rateSuggestionNote = null;
        if (_selectedEmployee is null || _otDate is null || _selectedEmployee.SalaryAmt is not decimal salary || salary <= 0)
            return;

        await using var context = await DbFactory.CreateDbContextAsync();
        var suggestion = await OtPolicy.GetMinimumRateAsync(context, _selectedEmployee, DateOnly.FromDateTime(_otDate.Value));
        if (suggestion is null)
        {
            var date = DateOnly.FromDateTime(_otDate.Value);
            var isHoliday = await context.Lve_CompanyHolidays.AnyAsync(h => h.CompanyId == _selectedEmployee.companyid && h.IsActive && h.HolidayDate == date);
            _rateSuggestionNote = $"ยังไม่ได้ตั้งค่าตัวคูณ OT สำหรับ{DayTypeLabel(OtRateCalculator.ClassifyDayType(date, isHoliday))} — ตั้งค่าได้ที่ /att/ot-rules";
            return;
        }

        _otRate = suggestion.Rate;
        _rateSuggestionNote = $"คำนวณอัตโนมัติ: {DayTypeLabel(suggestion.DayType)} × {suggestion.Multiplier:0.0#} เท่า (ค่าจ้างรายชั่วโมง {suggestion.HourlyWage:N2} บาท) — เพิ่มได้ แต่ต่ำกว่านี้ไม่ได้";
    }

    private static string DayTypeLabel(OtDayType t) => t switch
    {
        OtDayType.Workday => "วันทำงานปกติ",
        OtDayType.Holiday => "วันหยุด",
        OtDayType.RestDay => "วันหยุดประจำสัปดาห์",
        _ => t.ToString(),
    };

    private async Task CreateRequestAsync()
    {
        _error = null;
        _info = null;
        if (_selectedEmployee is null || _otDate is null || _startTime is null || _endTime is null)
        {
            _error = "กรุณาเลือกพนักงานและระบุวันเวลาให้ครบ";
            return;
        }

        var start = _otDate.Value.Date + _startTime.Value;
        var end = _otDate.Value.Date + _endTime.Value;
        if (end <= start)
        {
            _error = "เวลาสิ้นสุดต้องอยู่หลังเวลาเริ่ม";
            return;
        }

        await using var context = await DbFactory.CreateDbContextAsync();
        var duration = end - start;

        // อัตรา OT ต่ำกว่าค่าจ้างรายชั่วโมง × ตัวคูณที่ตั้งไว้ไม่ได้ (ตัวคูณคือขั้นต่ำตาม ม.61–63) — ไม่มีตัวคูณตั้งไว้ = ไม่ตรวจ
        var minimum = await OtPolicy.GetMinimumRateAsync(context, _selectedEmployee, DateOnly.FromDateTime(_otDate.Value));
        if (minimum is not null && (_otRate ?? 0m) < minimum.Rate)
        {
            _error = $"อัตรา OT {(_otRate ?? 0m):N2} บาท/ชม. ต่ำกว่าขั้นต่ำ {minimum.Rate:N2} บาท/ชม. ({DayTypeLabel(minimum.DayType)} × {minimum.Multiplier:0.0#} เท่า)";
            return;
        }

        // เพดานชั่วโมง OT ต่อสัปดาห์ (ตั้งที่ /att/ot-policy) — เตือน หรือไม่ให้บันทึก ตามที่ตั้งไว้
        var cap = await OtPolicy.CheckWeeklyCapAsync(_selectedEmployee.companyid, _selectedEmployee.EmpNo, start, (decimal)duration.TotalHours);
        if (cap.Result is { Exceeds: true } over)
        {
            var text = $"OT สัปดาห์นี้จะรวม {over.TotalHours:N1} ชม. เกินเพดาน {over.Cap:N1} ชม./สัปดาห์ อยู่ {over.Excess:N1} ชม. (มีอยู่แล้ว {over.ExistingHours:N1} + คำขอนี้ {over.NewHours:N1})";
            if (cap.Block) { _error = text + " — ไม่สามารถบันทึกได้"; return; }
            _capWarning = text;
        }
        else _capWarning = null;

        context.emp_overtime_requests.Add(new emp_overtime_request
        {
            empid = _selectedEmployee.EmpNo,
            name = $"{_selectedEmployee.EmpName} {_selectedEmployee.EmpSurname}",
            hremployeeid = _selectedEmployee.id,
            companyid = _selectedEmployee.companyid,
            requestDate = DateTime.Now,
            starttime = start,
            endtime = end,
            workhour = (decimal)duration.TotalHours,
            workminute = (decimal)duration.TotalMinutes,
            ot_rate = _otRate,
            objective = _objective,
            remark = _remark,
            orgcode = _selectedEmployee.orgcode,
            orgname = _selectedEmployee.orgcode,
        });
        await context.SaveChangesAsync();

        _info = $"บันทึกคำขอ OT #{_requests.Count + 1} สำเร็จ (ยังเป็นร่าง กด \"ส่งขออนุมัติ\" เพื่อเข้าสู่ workflow)"
                + (_capWarning is null ? "" : $" — คำเตือน: {_capWarning}");
        _selectedEmployee = null;
        _objective = null;
        _remark = null;
        _rateSuggestionNote = null;
        await RefreshAsync();
    }

    private async Task SubmitAsync(long requestId)
    {
        _error = null;
        _info = null;
        try
        {
            await using var context = await DbFactory.CreateDbContextAsync();
            var request = await context.emp_overtime_requests.FirstOrDefaultAsync(r => r.id == requestId)
                ?? throw new InvalidOperationException("ไม่พบคำขอนี้");
            if (request.jobmasterid is not null)
                throw new InvalidOperationException("คำขอนี้ถูกส่งเข้าสู่กระบวนการอนุมัติไปแล้ว");

            // ตรวจเพดานซ้ำตอนส่ง — ระหว่างเป็นร่างอาจมีคำขอ/รายการอื่นเข้ามาในสัปดาห์เดียวกันแล้ว (ตัดคำขอนี้เองออกจากยอดเดิม)
            var capCheck = await OtPolicy.CheckWeeklyCapAsync(request.companyid ?? "", request.empid ?? "", request.starttime,
                request.workhour ?? 0m, request.id);
            if (capCheck is { Block: true, Result.Exceeds: true })
                throw new InvalidOperationException(
                    $"OT สัปดาห์นี้จะรวม {capCheck.Result!.TotalHours:N1} ชม. เกินเพดาน {capCheck.Result.Cap:N1} ชม./สัปดาห์");

            var workflow = await context.wf_workflows.FirstOrDefaultAsync(w => w.workflowcode == "OT_APPROVAL")
                ?? throw new InvalidOperationException("ไม่พบ workflow OT_APPROVAL — ตรวจสอบว่า migration ถูก apply แล้ว");

            var jobId = await Engine.StartJobAsync(workflow.workflowid, "emp_overtime_request", requestId.ToString(),
                _actorUserId, request.empid, $"ขอ OT: {request.name} {request.starttime:dd/MM/yyyy}", null);

            request.jobmasterid = jobId;
            await context.SaveChangesAsync();

            _info = $"ส่งขออนุมัติสำเร็จ (Job #{jobId})";
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            _error = "ส่งขออนุมัติไม่สำเร็จ: " + ex.Message;
        }
    }

    // Explicit, HR-triggered action — mirrors how Pay_AdhocPayItem rows are
    // pulled into a payroll run rather than auto-injected the moment a
    // workflow completes (see plan file). HRW_OT is a live payroll-input
    // table (OvertimeEarningsCalculator reads it unfiltered by any status),
    // so nothing should land there without a human confirming it.
    private async Task PushToPayrollAsync(long requestId)
    {
        _error = null;
        _info = null;
        try
        {
            await using var context = await DbFactory.CreateDbContextAsync();
            var request = await context.emp_overtime_requests.FirstOrDefaultAsync(r => r.id == requestId)
                ?? throw new InvalidOperationException("ไม่พบคำขอนี้");
            if (request.hrwOtId is not null)
                throw new InvalidOperationException("คำขอนี้ถูกสร้างรายการจ่ายไปแล้ว");
            // Server-side approval check (audit H-08) — the hidden button alone is not a control.
            var jobStatus = request.jobmasterid is long jobId
                ? await context.job_masters.Where(j => j.jobmasterid == jobId).Select(j => j.status).FirstOrDefaultAsync()
                : null;
            if (jobStatus != "COMPLETED")
                throw new InvalidOperationException("คำขอ OT นี้ยังไม่ได้รับอนุมัติครบ — ส่งเข้า payroll ไม่ได้");

            var amount = (request.workhour ?? 0) * (request.ot_rate ?? 0);
            var companyId = request.companyid ?? "";
            var otPeriod = request.starttime.ToString("yyyyMM", System.Globalization.CultureInfo.InvariantCulture);
            var periodClosed = await context.Pay_PayrollRuns
                .Where(HRM.Services.Pay.PayrollRunFilters.RunIsFinal)
                .AnyAsync(r => r.CompanyId == companyId && r.PayrollPeriod == otPeriod && r.RunType == PayrollRunType.Regular);
            if (periodClosed)
            {
                // The OT day's period is already closed, so a dated HRW_OT row would never be paid.
                // Per the correction rule (CEO, 17 ก.ย. 2569) it becomes a one-off OT earning in the
                // next period, pending HR approval at /pay/adhoc.
                var otType = await context.Pay_PayItemTypes.FirstAsync(t => t.Code == "OT");
                var nextPeriod = new DateTime(request.starttime.Year, request.starttime.Month, 1).AddMonths(1)
                    .ToString("yyyyMM", System.Globalization.CultureInfo.InvariantCulture);
                var empId = request.hremployeeid
                    ?? await context.Hremployee.Where(e => e.EmpNo == request.empid && e.companyid == companyId).Select(e => (long?)e.id).FirstOrDefaultAsync()
                    ?? throw new InvalidOperationException("ไม่พบพนักงานของคำขอนี้");
                var uid = long.TryParse((await AuthProvider.GetAuthenticationStateAsync()).User.FindFirst("sc_userid")?.Value, out var u) ? u : 0;
                var item = new Pay_AdhocPayItem
                {
                    HremployeeId = empId,
                    PayItemTypeId = otType.Id,
                    TargetPeriod = nextPeriod,
                    TargetRunType = PayrollRunType.Regular,
                    Amount = amount,
                    IsTaxable = true,
                    Reason = $"OT วันที่ {request.starttime:dd/MM/yyyy} (คำขอ OT{request.id:D8}) ส่งหลังปิดงวด {otPeriod}",
                    Status = PayAdhocItemStatus.Pending,
                    RequestedByUserId = uid,
                    RequestedDate = DateTime.Now,
                };
                context.Pay_AdhocPayItems.Add(item);
                // Marks the request as handed to payroll so it can't be pushed twice
                // (hrwOtId has no FK to a real HRW_OT row here; -item id records where it went).
                await context.SaveChangesAsync();
                request.hrwOtId = -item.Id;
                await context.SaveChangesAsync();
                _info = $"งวด {otPeriod} ปิดแล้ว — สร้างเป็นเงินได้ OT รายครั้งในงวด {nextPeriod} (รออนุมัติที่หน้าเงินได้/เงินหักรายครั้ง)";
                await RefreshAsync();
                return;
            }

            var hrwOt = new HrwOt
            {
                companyid = request.companyid ?? "",
                EmpNo = request.empid,
                DateWork = request.starttime.Date,
                WorkotIn = request.starttime.ToString("HH:mm"),
                WorkotOut = request.endtime.ToString("HH:mm"),
                // Approximation for this proof-of-concept: hours * hourly
                // rate entered on the request. A production version should
                // pull the employee's actual wage rate instead of trusting
                // a rate typed on the request form.
                OtAmt = amount,
                OtDocno = $"OT{request.id:D8}",
                Remark = request.objective,
                ApvOtStatus = HRM.Services.Pay.Calculators.OvertimeEarningsCalculator.ApprovedStatus,
            };
            context.HrwOts.Add(hrwOt);
            await context.SaveChangesAsync();

            request.hrwOtId = hrwOt.ID;
            await context.SaveChangesAsync();

            _info = $"สร้างรายการจ่าย OT สำเร็จ (HRW_OT #{hrwOt.ID}) — payroll จะดึงไปคำนวณในงวดถัดไป";
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            _error = "สร้างรายการจ่ายไม่สำเร็จ: " + ex.Message;
        }
    }
}
