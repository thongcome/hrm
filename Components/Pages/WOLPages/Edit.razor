@page "/wols/edit"
@using Microsoft.EntityFrameworkCore
@using LeaderDevelop.Model
@inject IDbContextFactory<LeaderDevelop.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>WOL</h2>
<hr />
@if (WOL is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="WOL" OnValidSubmit="UpdateWOL" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary />
                <input type="hidden" name="WOL.id" value="@WOL.id" />
                <div class="mb-3">
                    <label for="name" class="form-label">Name:</label>
                    <InputText id="name" @bind-Value="WOL.Name" class="form-control" />
                    <ValidationMessage For="() => WOL.Name" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="description" class="form-label">description:</label>
                    <InputText id="description" @bind-Value="WOL.description" class="form-control" />
                    <ValidationMessage For="() => WOL.description" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="code" class="form-label">code:</label>
                    <InputText id="code" @bind-Value="WOL.code" class="form-control" />
                    <ValidationMessage For="() => WOL.code" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="theme" class="form-label">theme:</label>
                    <InputText id="theme" @bind-Value="WOL.theme" class="form-control" />
                    <ValidationMessage For="() => WOL.theme" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/wols">Back to List</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int id { get; set; }

    [SupplyParameterFromForm]
    private WOL? WOL { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        WOL ??= await context.WOLs.FirstOrDefaultAsync(m => m.id == id);

        if (WOL is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateWOL()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(WOL!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!WOLExists(WOL!.id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/wols");
    }

    private bool WOLExists(int id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.WOLs.Any(e => e.id == id);
    }
}
