@page "/modules"
@page "/modules/{GroupCode}"
@using System.Reflection
@using System.Security.Claims
@using HRM.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject JsonLocalizationService L
@inject NavigationManager Nav
@attribute [Authorize]

@* ภาพรวมระบบแบบไอคอน — สองชั้น (CEO, 20 ก.ย. 2569: "คลิก icon ตรงภาพรวม ก็เข้ามาเจอ icon เมนูย่อยทั้งหมด")
   ชั้นที่ 1 (/modules)              = กลุ่มเมนูหลัก เงินเดือนอยู่บนสุดและเป็นการ์ดใหญ่
   ชั้นที่ 2 (/modules/{รหัสกลุ่ม})  = ไอคอนของทุกหน้าจอในกลุ่มนั้น กดแล้วเข้าหน้านั้นเลย

   อ่านจาก sc_menu ชุดเดียวกับแถบเมนูด้านซ้าย (isactive && isshow + สิทธิ์จาก claim "menu"
   ที่ผู้ใช้มีสิทธิ์) จึงไม่มีทางเห็นไอคอนที่กดแล้วเข้าไม่ได้
   และไม่ต้องมาไล่แก้รายการโมดูลด้วยมือทุกครั้งที่เพิ่มหน้าใหม่ — ของเดิมเป็นลิสต์ที่เขียนตายในไฟล์นี้ *@

<PageTitle>@PageTitleText</PageTitle>

@if (_group is null)
{
    <MudText Typo="Typo.h4" Class="mb-1">@L.Translate("ModuleHubPageTitle")</MudText>
    <MudText Typo="Typo.body1" Class="mb-6" Style="opacity:.75;">@L.Translate("ModuleHubPageSubtitle")</MudText>

    @if (_groups.Count == 0)
    {
        <MudAlert Severity="Severity.Info">@L.Translate("ModuleHubNoAccess")</MudAlert>
    }
    else
    {
        @* กลุ่มหลักของผลิตภัณฑ์: การ์ดกว้างกว่า สีแบรนด์ อยู่บนสุด *@
        <MudGrid Spacing="3" Class="mb-2">
            @foreach (var g in _groups.Where(g => g.IsPrimary))
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudPaper Class="pa-5 module-tile module-tile-primary" Elevation="3" @onclick="@(() => Open(g))" Style="cursor:pointer; height:100%;">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4">
                            <div class="module-tile-icon module-tile-icon-lg">
                                <MudIcon Icon="@g.Icon" Style="font-size:2.6rem; color:#fff;" />
                            </div>
                            <div>
                                <MudText Typo="Typo.h6" Style="font-weight:700; line-height:1.25;">@g.Name</MudText>
                                <MudText Typo="Typo.body2" Style="opacity:.7;">@string.Format(L.Translate("ModuleHubPageCountTemplate"), g.Pages.Count)</MudText>
                            </div>
                        </MudStack>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>

        @if (_groups.Any(g => !g.IsPrimary))
        {
            <MudDivider Class="my-5" />
            <MudText Typo="Typo.subtitle1" Class="mb-3" Style="opacity:.75;">@L.Translate("ModuleHubOtherModulesHeading")</MudText>
            <MudGrid Spacing="3">
                @foreach (var g in _groups.Where(g => !g.IsPrimary))
                {
                    <MudItem xs="6" sm="4" md="3" lg="2">
                        <MudPaper Class="pa-4 module-tile" Elevation="2" @onclick="@(() => Open(g))" Style="cursor:pointer; height:100%;">
                            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                                <div class="module-tile-icon" style="@($"background:{g.Color};")">
                                    <MudIcon Icon="@g.Icon" Style="font-size:2rem; color:#fff;" />
                                </div>
                                <MudText Typo="Typo.body2" Align="Align.Center" Style="font-weight:600; line-height:1.3;">@g.Name</MudText>
                                <MudText Typo="Typo.caption" Style="opacity:.65;">@string.Format(L.Translate("ModuleHubPageCountTemplate"), g.Pages.Count)</MudText>
                            </MudStack>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        }
    }
}
else
{
    <MudBreadcrumbs Items="@_crumbs" Class="px-0 pb-1" />
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-5">
        <div class="module-tile-icon" style="@($"background:{_group.Color};")">
            <MudIcon Icon="@_group.Icon" Style="font-size:2rem; color:#fff;" />
        </div>
        <div>
            <MudText Typo="Typo.h5" Style="font-weight:700;">@_group.Name</MudText>
            <MudText Typo="Typo.body2" Style="opacity:.7;">@string.Format(L.Translate("ModuleHubPageCountTemplate"), _group.Pages.Count)</MudText>
        </div>
    </MudStack>

    @if (_group.Pages.Count == 0)
    {
        <MudAlert Severity="Severity.Info">@L.Translate("ModuleHubNoAccess")</MudAlert>
    }
    else
    {
        @* แบ่งตามกลุ่มย่อยของเมนู (เช่น เงินเดือน → เอกสาร/ภาษี, ตั้งค่า Master)
           เมนูที่อยู่ใต้กลุ่มหลักตรง ๆ = งานที่ทำประจำ ขึ้นก่อนเสมอ *@
        @foreach (var section in _group.Pages.GroupBy(p => p.Section).OrderBy(s => s.Key is null ? 0 : 1))
        {
            @if (section.Key is not null)
            {
                <MudText Typo="Typo.subtitle1" Class="mt-5 mb-2" Style="font-weight:700;">@section.Key</MudText>
            }
            <MudGrid Spacing="3">
                @foreach (var p in section)
                {
                    <MudItem xs="6" sm="4" md="3" lg="2">
                        <MudPaper Class="pa-4 module-tile" Elevation="2" @onclick="@(() => Nav.NavigateTo(p.Url))" Style="cursor:pointer; height:100%;">
                            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                                <div class="module-tile-icon" style="@($"background:{p.Color};")">
                                    <MudIcon Icon="@p.Icon" Style="font-size:1.8rem; color:#fff;" />
                                </div>
                                <MudText Typo="Typo.body2" Align="Align.Center" Style="font-weight:600; line-height:1.3;">@p.Name</MudText>
                            </MudStack>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        }
    }
}

<style>
    .module-tile:hover { box-shadow: 0 4px 16px rgba(0,0,0,.15); transform: translateY(-2px); transition: all .15s ease; }
    .module-tile-icon {
        width: 64px; height: 64px; border-radius: 16px;
        display: flex; align-items: center; justify-content: center;
        background: var(--mud-palette-primary);
    }
    .module-tile-icon-lg { width: 84px; height: 84px; border-radius: 20px; background: var(--mud-palette-primary); }
    .module-tile-primary { border: 2px solid var(--mud-palette-primary); }
</style>

@code {
    [Parameter] public string? GroupCode { get; set; }

    // Section = ชื่อกลุ่มย่อยที่เมนูนั้นสังกัด (null = อยู่ใต้กลุ่มหลักตรง ๆ = งานที่ทำประจำ)
    private sealed record PageTile(string Name, string Url, string Icon, string Color, string? Section);
    private sealed record GroupTile(string Code, string Name, string Icon, string Color, bool IsPrimary, List<PageTile> Pages);

    private List<GroupTile> _groups = new();
    private GroupTile? _group;
    private List<BreadcrumbItem> _crumbs = new();
    private HashSet<string> _allowedMenuCodes = new();

    private string PageTitleText => _group?.Name ?? L.Translate("ModuleHubPageTitle");

    // กลุ่มหลักของผลิตภัณฑ์ — เด่นกว่ากลุ่มอื่นบนหน้าภาพรวม
    private static readonly string[] PrimaryGroups = { "GRP_PAYROLL" };

    private static readonly string[] Palette =
    {
        "#3B82F6", "#10B981", "#F59E0B", "#EF4444", "#8B5CF6", "#06B6D4",
        "#EC4899", "#84CC16", "#6366F1", "#F97316", "#14B8A6", "#A855F7",
    };

    protected override async Task OnParametersSetAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = state.User;
        _allowedMenuCodes = user.FindAll("menu").Select(c => c.Value).ToHashSet(StringComparer.OrdinalIgnoreCase);

        await using var db = await DbFactory.CreateDbContextAsync();
        var rows = await db.sc_menus.AsNoTracking()
            .Where(m => m.isactive && m.isshow)
            .OrderBy(m => m.menuorder).ThenBy(m => m.menuid)
            .ToListAsync();

        var byCode = new Dictionary<string, sc_menu>(StringComparer.OrdinalIgnoreCase);
        foreach (var r in rows)
            if (!string.IsNullOrWhiteSpace(r.menucode) && !byCode.ContainsKey(r.menucode))
                byCode[r.menucode] = r;

        var color = 0;
        var groups = new List<GroupTile>();
        foreach (var top in rows.Where(r => string.IsNullOrWhiteSpace(r.uppermenucode) && !string.IsNullOrWhiteSpace(r.menucode)))
        {
            var pages = rows
                .Where(r => Owns(top.menucode!, r, byCode) && IsLeafVisible(r))
                .Select(r => new PageTile(DisplayName(r), r.url!, ResolveIcon(r.icon), Palette[color++ % Palette.Length],
                    SectionName(top.menucode!, r, byCode)))
                .ToList();
            if (pages.Count == 0) continue;   // ไม่มีหน้าที่ผู้ใช้เข้าได้ = ไม่ต้องโชว์กลุ่ม

            groups.Add(new GroupTile(top.menucode!, DisplayName(top), ResolveIcon(top.icon),
                Palette[color++ % Palette.Length],
                PrimaryGroups.Contains(top.menucode, StringComparer.OrdinalIgnoreCase), pages));
        }

        _groups = groups;
        _group = string.IsNullOrWhiteSpace(GroupCode)
            ? null
            : groups.FirstOrDefault(g => string.Equals(g.Code, GroupCode, StringComparison.OrdinalIgnoreCase));

        _crumbs = _group is null ? new() : new()
        {
            new BreadcrumbItem(L.Translate("ModuleHubPageTitle"), "/modules"),
            new BreadcrumbItem(_group.Name, null, disabled: true),
        };
    }

    private void Open(GroupTile g) => Nav.NavigateTo($"/modules/{g.Code}");

    // แถวนี้อยู่ใต้กลุ่มไหน — ไต่ uppermenucode ขึ้นไปจนถึงระดับบนสุด (แบนทุกชั้นเข้ากลุ่มเดียวกับแถบเมนูซ้าย)
    private static bool Owns(string groupCode, sc_menu row, Dictionary<string, sc_menu> byCode)
    {
        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var current = row;
        while (!string.IsNullOrWhiteSpace(current.uppermenucode))
        {
            if (!seen.Add(current.uppermenucode)) return false;          // ข้อมูลวน
            if (string.Equals(current.uppermenucode, groupCode, StringComparison.OrdinalIgnoreCase)) return true;
            if (!byCode.TryGetValue(current.uppermenucode, out var parent)) return false;
            current = parent;
        }
        return false;
    }

    // เมนูนี้อยู่ใต้กลุ่มย่อยชื่ออะไร — null ถ้าแขวนกับกลุ่มหลักโดยตรง
    private string? SectionName(string groupCode, sc_menu row, Dictionary<string, sc_menu> byCode)
    {
        if (string.Equals(row.uppermenucode, groupCode, StringComparison.OrdinalIgnoreCase)) return null;
        return !string.IsNullOrWhiteSpace(row.uppermenucode) && byCode.TryGetValue(row.uppermenucode, out var parent)
            ? DisplayName(parent)
            : null;
    }

    private bool IsLeafVisible(sc_menu row)
        => !string.IsNullOrWhiteSpace(row.url)
           && (string.IsNullOrWhiteSpace(row.menucode) || _allowedMenuCodes.Contains(row.menucode));

    private string DisplayName(sc_menu row)
        => L.CurrentLanguage == "en" && !string.IsNullOrWhiteSpace(row.menuname_en) ? row.menuname_en : row.menuname;

    private static readonly Dictionary<string, string> _iconLookup = BuildIconLookup();

    private static Dictionary<string, string> BuildIconLookup()
    {
        var dict = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var field in typeof(Icons.Material.Filled).GetFields(BindingFlags.Public | BindingFlags.Static))
            if (field.FieldType == typeof(string) && field.GetValue(null) is string svg)
                dict[field.Name] = svg;
        return dict;
    }

    private static string ResolveIcon(string? icon)
    {
        if (string.IsNullOrWhiteSpace(icon)) return Icons.Material.Filled.Circle;
        var name = icon.Trim();
        var lastDot = name.LastIndexOf('.');
        if (lastDot >= 0) name = name[(lastDot + 1)..];
        return _iconLookup.TryGetValue(name, out var svg) ? svg : Icons.Material.Filled.Circle;
    }
}
