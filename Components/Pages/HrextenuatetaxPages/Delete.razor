        <dl class="row">
            <dt class="col-sm-2">PayDonateedu</dt>
            <dd class="col-sm-10">@hrextenuatetax.PayDonateedu</dd>
        </dl>
        <EditForm method="post" Model="hrextenuatetax" OnValidSubmit="DeleteHrextenuatetax" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(hrextenuatetax is null)">Delete</button> |
            <a href="/hrextenuatetaxes">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private Hrextenuatetax? hrextenuatetax;

    [SupplyParameterFromQuery]
    private long id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        hrextenuatetax = await context.Hrextenuatetaxs.FirstOrDefaultAsync(m => m.id == id);

        if (hrextenuatetax is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteHrextenuatetax()
    {
        using var context = DbFactory.CreateDbContext();
        context.Hrextenuatetaxs.Remove(hrextenuatetax!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/hrextenuatetaxes");
    }
}
