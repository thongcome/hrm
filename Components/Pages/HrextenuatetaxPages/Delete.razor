@page "/hrextenuatetaxes/delete"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using HRM.Models
@inject IDbContextFactory<HRM.Models.HRMContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Hrextenuatetax</h2>
    <hr />
    @if (hrextenuatetax is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
