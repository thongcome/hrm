@page "/scusers/coachmanagelists"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using LeaderDevelop.Model
@using LeaderDevelop.Data
@implements IAsyncDisposable
@inject IDbContextFactory<LeaderDevelop.Data.ApplicationDbContext> DbFactory

@attribute [Authorize]

<h3>จัดการผู้ใช้/Manage Users</h3>

<!-- Search inputs -->
<p>
    <label>ค้นหาชื่อ (First Name):</label>
    <input @bind="searchFirstName" @bind:event="oninput" placeholder="First Name" />

    <label>ค้นหานามสกุล (Last Name):</label>
    <input @bind="searchLastName" @bind:event="oninput" placeholder="Last Name" />
</p>

@if (ScUserList != null && ScUserList.Any())
{
    <QuickGrid Class="table" Items="ScUserList" TItem="LeaderDevelop.Model.ScUser" Sortable="true">
        <PropertyColumn Property="scuser => scuser.Firstname" Title="ชื่อ/Name" Sortable="true" />
        <PropertyColumn Property="scuser => scuser.Lastname" Title="นามสกุล/Last Name" Sortable="true" />
        <PropertyColumn Property="scuser => scuser.Loginname" Title="ชื่อในระบบ/Login Name" Sortable="true" />
        <PropertyColumn Property="scuser => scuser.IsCoach" Title="เป็นที่ปรึกษา/ Is Facililator?" Sortable="true" />
        <PropertyColumn Property="scuser => scuser.Mobilephone" Title="เบอร์มือถือ/Mobile" />
        <PropertyColumn Property="scuser => scuser.Email" Title="อีเมล์/Email" />
        <PropertyColumn Property="scuser => scuser.Registerdate" Title="วันลงทะเบียน/Register Date" Sortable="true" />
        <TemplateColumn Context="scuser">
            @if (scuser.Isforcechanged == true)
            {
                <a href="@($"/scusers/managecoach?userid=" + scuser.Userid)">ปรับระดับ Facililator</a>
            }
        </TemplateColumn>
    </QuickGrid>
}
else
{
    <p>No users found.</p>
}
@code {
    private ApplicationDbContext context = default!;
    private IQueryable<ScUser> ScUserList = default!;

    private string searchFirstName = "";
    private string searchLastName = "";

    protected override async Task OnInitializedAsync()
    {
        context = await DbFactory.CreateDbContextAsync();
        LoadScUsers();  // No await needed because the method is now synchronous
    }

    // Synchronous method
    private void LoadScUsers()
    {
        ScUserList = context.ScUsers
            .Where(scuser => (string.IsNullOrEmpty(searchFirstName) || EF.Functions.Like(scuser.Firstname, $"%{searchFirstName}%")) &&
                             (string.IsNullOrEmpty(searchLastName) || EF.Functions.Like(scuser.Lastname, $"%{searchLastName}%")) &&
                             ((scuser.IsCoach==true ) || (scuser.IsCoachRequest ==true))
                            )                
            .OrderBy(scuser => scuser.Firstname)
            .AsQueryable();

    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
