@page "/scusers/all"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using HRM.Model
@using HRM.Data
@implements IAsyncDisposable
@inject IDbContextFactory<HRM.Data.ApplicationDbContext> DbFactory

 @attribute [Authorize] 
@* @attribute [Authorize(Roles = "Admin")]
 *@
<h3>รายชื่อสมาชิก / Member List</h3>

<!-- Search inputs -->
<p>
    <label>ค้นหาชื่อ (First Name):</label>
    <input @bind="searchFirstName" @bind:event="oninput" placeholder="First Name" />

    <label>ค้นหานามสกุล (Last Name):</label>
    <input @bind="searchLastName" @bind:event="oninput" placeholder="Last Name" />

    <div>
        <label>แสดงเฉพาะที่ปรึกษา/Show Only Facilitators</label>
        <InputCheckbox @bind-Value="isFacilitatorOnly" />  แสดงรายชื่อ Facililator <a href="/scusers/coachmanagelists">Click Here</a>
    </div>
</p>

@if (ScUserList != null && ScUserList.Any())
{
    <QuickGrid Class="table" Items="ScUserList" TItem="HRM.Model.ScUser" Sortable="true">
        <PropertyColumn Property="scuser => scuser.Firstname" Title="ชื่อ/Name" Sortable="true" />
        <PropertyColumn Property="scuser => scuser.Lastname" Title="นามสกุล/Last Name" Sortable="true" />
        <PropertyColumn Property="scuser => scuser.Loginname" Title="ชื่อในระบบ/Login Name" Sortable="true" />
        <PropertyColumn Property="scuser => scuser.IsCoach" Title="Facilitator Status" Sortable="true" />
@*         <PropertyColumn Property="scuser => scuser.Mobilephone" Title="เบอร์มือถือ/Mobile" />
 *@        <PropertyColumn Property="scuser => scuser.Email" Title="อีเมล์/Email" />
        <PropertyColumn Property="scuser => scuser.Registerdate" Title="วันลงทะเบียน/Register Date" Sortable="true" />
    </QuickGrid>
}
else
{
    <p>No users found.</p>
}

@code {
    private ApplicationDbContext context = default!;
    private IQueryable<ScUser> ScUserList = default!;
    private string searchFirstName = "";
    private string searchLastName = "";
    private bool isFacilitatorOnly = false;

    protected override async Task OnInitializedAsync()
    {
        context = await DbFactory.CreateDbContextAsync();
        LoadScUsers();
    }

    // Update LoadScUsers to handle the new checkbox
    private void LoadScUsers()
    {
        ScUserList = context.ScUsers
            .Where(scuser => 
                (string.IsNullOrEmpty(searchFirstName) || EF.Functions.Like(scuser.Firstname, $"%{searchFirstName}%")) &&
                (string.IsNullOrEmpty(searchLastName) || EF.Functions.Like(scuser.Lastname, $"%{searchLastName}%")) 
             
            )
            .OrderBy(scuser => scuser.Firstname)
            .AsQueryable();
    }

    // Watch for changes in the checkbox and reload the list accordingly
    private void OnFacilitatorCheckboxChanged(ChangeEventArgs e)
    {
       
        if(e.Value is not null){
        isFacilitatorOnly = (bool)e.Value;
        }
        LoadScUsers();  // Reload the user list based on the new checkbox value
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
