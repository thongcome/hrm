@page "/scusers/managecoach"
@using HRM.Data
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using HRM.Model
@using System.Security.Claims
@using System.ComponentModel.DataAnnotations
@inject IDbContextFactory<HRM.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@inject IDbContextFactory<HRM.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider

@attribute [Authorize]
<PageTitle> จัดการ Facilitator</PageTitle>

<h4>
    จัดการ Learning Facilitator
 
</h4>

 
<hr />
@if (ScUser is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="ScUser" OnValidSubmit="UpdateScUser" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary />
                <input type="hidden" name="ScUser.Userid" value="@ScUser.Userid" />
              
                <div class="mb-3">
