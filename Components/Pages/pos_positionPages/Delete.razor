@code {
    private pos_position? pos_position;

    [SupplyParameterFromQuery]
    private long id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        pos_position = await context.pos_positions.FirstOrDefaultAsync(m => m.id == id);

        if (pos_position is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task Deletepos_position()
    {
        using var context = DbFactory.CreateDbContext();
        context.pos_positions.Remove(pos_position!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/pos_positions");
    }
}
