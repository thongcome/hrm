        <EditForm method="post" Model="pos_position" OnValidSubmit="Deletepos_position" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(pos_position is null)">Delete</button> |
            <a href="/pos_positions">Back to List</a>
        </EditForm>
