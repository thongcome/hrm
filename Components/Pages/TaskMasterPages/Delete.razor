@page "/taskmasters/delete"

@using Microsoft.EntityFrameworkCore
@using HRM.Model
@inject IDbContextFactory<HRM.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager


<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>TaskMaster</h4>
    <hr />
    @if (taskmaster is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Name</dt>
            <dd class="col-sm-10">@taskmaster.Name</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">IsActive</dt>
            <dd class="col-sm-10">@taskmaster.IsActive</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">StatusCode</dt>
            <dd class="col-sm-10">@taskmaster.StatusCode</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Description</dt>
            <dd class="col-sm-10">@taskmaster.Description</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Remark</dt>
            <dd class="col-sm-10">@taskmaster.Remark</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Color</dt>
            <dd class="col-sm-10">@taskmaster.Color</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Level</dt>
            <dd class="col-sm-10">@taskmaster.Level</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">DefaultDay</dt>
            <dd class="col-sm-10">@taskmaster.DefaultDay</dd>
        </dl>
        <EditForm method="post" Model="taskmaster" OnValidSubmit="DeleteTaskMaster" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(taskmaster is null)">Delete</button> |
            <a href="/taskmasters">Back to List</a>
        </EditForm>
    }
</div>

@code {
    TaskMaster? taskmaster;

    [SupplyParameterFromQuery]
    public int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        taskmaster = await context.TaskMasters.FirstOrDefaultAsync(m => m.Id == Id);

        if (taskmaster is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    public async Task DeleteTaskMaster()
    {
        using var context = DbFactory.CreateDbContext();
        context.TaskMasters.Remove(taskmaster!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/taskmasters");
    }
}
