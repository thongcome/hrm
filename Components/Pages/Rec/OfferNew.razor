@page "/rec/offers/new/{ApplicationId:long}"
@using HRM.Models
@using HRM.Services.Rec
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject RecOfferService OfferService
@attribute [Authorize(Policy = "Menu:REC_ADMIN")]

<PageTitle>สร้างข้อเสนอจ้างงาน</PageTitle>

@if (_targetSlotId is null)
{
    <MudAlert Severity="Severity.Error" Class="ma-4">
        ไม่พบเลขที่อัตราเป้าหมายสำหรับใบสมัครนี้ — คำขออัตรากำลังต้นทางอาจยังไม่ได้รับการอนุมัติ หรือยังไม่มีเลขที่อัตราผูกไว้
    </MudAlert>
}
else
{
    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h5">สร้างข้อเสนอจ้างงาน — @_candidateName</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">เลขที่อัตราเป้าหมาย: #@_targetSlotId</MudText>

        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-2">@_error</MudAlert>
        }

        <MudGrid Class="mt-2">
            <MudItem xs="12" sm="6"><MudNumericField T="decimal" @bind-Value="_offeredSalary" Label="เงินเดือนที่เสนอ" Format="N2" /></MudItem>
            <MudItem xs="12" sm="6"><MudDatePicker Label="วันที่คาดว่าจะเริ่มงาน" @bind-Date="_startDate" /></MudItem>
            <MudItem xs="12" sm="6"><MudDatePicker Label="ข้อเสนอมีผลถึงวันที่ (ถ้ามี)" @bind-Date="_expiryDate" /></MudItem>
            <MudItem xs="12">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateAsync">บันทึกข้อเสนอ (ร่าง)</MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>
}

@code {
    [Parameter] public long ApplicationId { get; set; }

    private long? _targetSlotId;
    private string _candidateName = "";
    private decimal _offeredSalary;
    private DateTime? _startDate = DateTime.Today.AddDays(14);
    private DateTime? _expiryDate;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();

        var app = await context.Rec_Applications.FirstOrDefaultAsync(a => a.Id == ApplicationId);
        if (app is null) return;

        var candidate = await context.Rec_Candidates.FirstOrDefaultAsync(c => c.Id == app.CandidateId);
        _candidateName = candidate is null ? "" : $"{candidate.FirstName} {candidate.LastName}";

        var posting = await context.Rec_JobPostings.FirstOrDefaultAsync(p => p.Id == app.JobPostingId);
        if (posting is null) return;

        var requisition = await context.Rec_Requisitions.FirstOrDefaultAsync(r => r.Id == posting.RequisitionId);
        if (requisition is null) return;

        _targetSlotId = requisition.RequisitionType == RequisitionType.Replacement
            ? requisition.TargetPositionSlotId
            : requisition.NewPositionSlotId;

        if (requisition.ProposedMinSalary is decimal min)
            _offeredSalary = min;
    }

    private async Task CreateAsync()
    {
        _error = null;
        if (_targetSlotId is null || _offeredSalary <= 0 || _startDate is null)
        {
            _error = "กรุณาระบุเงินเดือนที่เสนอและวันที่เริ่มงาน";
            return;
        }

        var offerId = await OfferService.CreateDraftAsync(new Rec_Offer
        {
            ApplicationId = ApplicationId,
            TargetPositionSlotId = _targetSlotId.Value,
            OfferedSalary = _offeredSalary,
            StartDate = DateOnly.FromDateTime(_startDate.Value),
            ExpiryDate = _expiryDate is null ? null : DateOnly.FromDateTime(_expiryDate.Value),
        });

        NavigationManager.NavigateTo($"/rec/offers/{offerId}");
    }

    [Microsoft.AspNetCore.Components.Inject]
    private Microsoft.AspNetCore.Components.NavigationManager NavigationManager { get; set; } = null!;
}
