@page "/rec/postings"
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Rec
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject RecJobPostingService PostingService
@inject RecRequisitionService RequisitionService
@inject ISnackbar Snackbar
@attribute [Authorize(Policy = "Menu:REC_ADMIN")]

<PageTitle>ประกาศรับสมัคร (Job Posting)</PageTitle>

@if (string.IsNullOrEmpty(_companyId))
{
    <MudAlert Severity="Severity.Error" Class="ma-4">บัญชีของคุณยังไม่ได้ผูกกับบริษัทใดๆ</MudAlert>
}
else
{
    <MudPaper Class="pa-4 mb-4">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h5">ประกาศรับสมัครงาน</MudText>
            @if (!_showForm)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateForm">สร้างประกาศใหม่</MudButton>
            }
        </MudStack>

        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-2">@_error</MudAlert>
        }
        @if (!string.IsNullOrEmpty(_info))
        {
            <MudAlert Severity="Severity.Success" Class="mt-2">@_info</MudAlert>
        }

        <MudTable Items="_postings" Dense="true" Hover="true" Class="mt-3">
            <HeaderContent>
                <MudTh>#</MudTh>
                <MudTh>ชื่อตำแหน่งที่ประกาศ</MudTh>
                <MudTh>วันเปิด-ปิดรับ</MudTh>
                <MudTh>สถานะ</MudTh>
                <MudTh>ช่องทาง</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Id</MudTd>
                <MudTd>@context.Title</MudTd>
                <MudTd>@(context.OpenDate?.ToString("dd/MM/yyyy") ?? "-") - @(context.CloseDate?.ToString("dd/MM/yyyy") ?? "-")</MudTd>
                <MudTd><MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Status)">@StatusLabel(context.Status)</MudChip></MudTd>
                <MudTd>
                    @if (context.IsInternal)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Info">ภายในเท่านั้น</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Default">สาธารณะ</MudChip>
                    }
                </MudTd>
                <MudTd>
                    <MudStack Row="true" Spacing="1">
                        @if (context.Status == PostingStatus.Draft)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => OpenAsync(context.Id))">เปิดรับสมัคร</MudButton>
                        }
                        @if (context.Status == PostingStatus.Open)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" OnClick="@(() => CloseAsync(context.Id))">ปิดรับสมัคร</MudButton>
                            @if (context.IsInternal)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" Href="/career/internal-jobs" Target="_blank">ดูหน้าภายใน</MudButton>
                            }
                            else
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" Href="@($"/careers/{context.Id}")" Target="_blank">ดูหน้าสาธารณะ</MudButton>
                            }
                        }
                        <MudButton Size="Size.Small" Variant="Variant.Text" Href="@($"/rec/pipeline/{context.Id}")">ผู้สมัคร</MudButton>
                    </MudStack>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText Typo="Typo.body2">ยังไม่มีประกาศรับสมัคร</MudText></NoRecordsContent>
        </MudTable>
    </MudPaper>

    @if (_showForm)
    {
        <MudPaper Class="pa-4 mb-4">
            <MudText Typo="Typo.h6">สร้างประกาศใหม่</MudText>
            <MudText Typo="Typo.body2" Class="mb-2" Color="Color.Secondary">สร้างได้เฉพาะจากคำขออัตรากำลังที่อนุมัติแล้วและยังไม่มีประกาศ</MudText>
            <MudGrid Class="mt-1">
                <MudItem xs="12" sm="6">
                    <MudSelect T="Rec_Requisition" @bind-Value="_selectedRequisition" Label="คำขออัตรากำลังที่อนุมัติแล้ว" ToStringFunc="@(r => r == null ? null : $"#{r.Id} — {ExecTypeName(r.PosExecTypeId)} ({r.OpeningsCount} อัตรา)")">
                        @foreach (var r in _postableRequisitions)
                        {
                            <MudSelectItem Value="r">#@r.Id — @ExecTypeName(r.PosExecTypeId) (@r.OpeningsCount อัตรา)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6"><MudTextField @bind-Value="_title" Label="ชื่อตำแหน่งที่จะประกาศ" /></MudItem>
                <MudItem xs="12" sm="6"><MudDatePicker Label="วันเปิดรับสมัคร" @bind-Date="_openDate" /></MudItem>
                <MudItem xs="12" sm="6"><MudDatePicker Label="วันปิดรับสมัคร" @bind-Date="_closeDate" /></MudItem>
                <MudItem xs="12"><MudTextField @bind-Value="_description" Label="รายละเอียดงาน" Lines="5" /></MudItem>
                <MudItem xs="12">
                    <MudCheckBox T="bool" @bind-Value="_isInternal" Label="เปิดรับเฉพาะพนักงานภายใน (ไม่แสดงบน career site สาธารณะ)" />
                </MudItem>
                <MudItem xs="12">
                    <MudStack Row="true" Spacing="2">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateAsync">บันทึกประกาศ (ร่าง)</MudButton>
                        <MudButton Variant="Variant.Text" OnClick="CancelForm">ยกเลิก</MudButton>
                    </MudStack>
                </MudItem>
            </MudGrid>
        </MudPaper>
    }
}

@code {
    private string? _companyId;
    private List<Rec_JobPosting> _postings = new();
    private List<Rec_Requisition> _postableRequisitions = new();
    private Dictionary<long, string> _execTypeNames = new();
    private string? _error;
    private string? _info;
    private bool _showForm;

    private Rec_Requisition? _selectedRequisition;
    private string? _title;
    private DateTime? _openDate = DateTime.Today;
    private DateTime? _closeDate;
    private string? _description;
    private bool _isInternal;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
        if (string.IsNullOrWhiteSpace(_companyId)) return;

        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        if (string.IsNullOrEmpty(_companyId)) return;

        _postings = await PostingService.GetAllForCompanyAsync(_companyId);
        _postableRequisitions = await RequisitionService.GetPostableAsync(_companyId);

        await using var context = await DbFactory.CreateDbContextAsync();
        var execTypeIds = _postableRequisitions.Select(r => r.PosExecTypeId).Distinct().ToList();
        _execTypeNames = await context.Pos_ExecTypes.Where(t => execTypeIds.Contains(t.Id)).ToDictionaryAsync(t => t.Id, t => t.Name);
    }

    private string ExecTypeName(long id) => _execTypeNames.TryGetValue(id, out var n) ? n : $"#{id}";

    private static string StatusLabel(PostingStatus s) => s switch
    {
        PostingStatus.Draft => "ร่าง",
        PostingStatus.Open => "เปิดรับสมัคร",
        PostingStatus.Closed => "ปิดรับสมัคร",
        PostingStatus.Filled => "บรรจุครบแล้ว",
        PostingStatus.Cancelled => "ยกเลิก",
        _ => s.ToString(),
    };

    private static Color StatusColor(PostingStatus s) => s switch
    {
        PostingStatus.Open => Color.Success,
        PostingStatus.Closed or PostingStatus.Cancelled => Color.Default,
        PostingStatus.Filled => Color.Info,
        _ => Color.Warning,
    };

    private void OpenCreateForm()
    {
        _error = null;
        _info = null;
        _selectedRequisition = null;
        _title = null;
        _openDate = DateTime.Today;
        _closeDate = null;
        _description = null;
        _isInternal = false;
        _showForm = true;
    }

    private void CancelForm()
    {
        _showForm = false;
    }

    private async Task CreateAsync()
    {
        _error = null;
        _info = null;
        if (_selectedRequisition is null || string.IsNullOrWhiteSpace(_title))
        {
            _error = "กรุณาเลือกคำขออัตรากำลังและระบุชื่อตำแหน่งที่จะประกาศ";
            return;
        }

        await PostingService.CreateAsync(new Rec_JobPosting
        {
            RequisitionId = _selectedRequisition.Id,
            Title = _title,
            Description = _description,
            OpenDate = _openDate is null ? null : DateOnly.FromDateTime(_openDate.Value),
            CloseDate = _closeDate is null ? null : DateOnly.FromDateTime(_closeDate.Value),
            IsInternal = _isInternal,
        });

        _info = "บันทึกประกาศ (ร่าง) สำเร็จ — กด \"เปิดรับสมัคร\" เพื่อให้แสดงบนหน้า career site";
        _selectedRequisition = null;
        _title = null;
        _description = null;
        _closeDate = null;
        _isInternal = false;
        _showForm = false;
        await RefreshAsync();
    }

    private async Task OpenAsync(long postingId)
    {
        var posting = await PostingService.GetByIdAsync(postingId);
        if (posting is null) return;
        posting.Status = PostingStatus.Open;
        await PostingService.UpdateAsync(posting);
        Snackbar.Add("เปิดรับสมัครแล้ว", Severity.Success);
        await RefreshAsync();
    }

    private async Task CloseAsync(long postingId)
    {
        var posting = await PostingService.GetByIdAsync(postingId);
        if (posting is null) return;
        posting.Status = PostingStatus.Closed;
        await PostingService.UpdateAsync(posting);
        Snackbar.Add("ปิดรับสมัครแล้ว", Severity.Success);
        await RefreshAsync();
    }
}
