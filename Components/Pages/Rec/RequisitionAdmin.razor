@page "/rec/requisitions"
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Rec
@using HRM.Services.Shared
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject RecRequisitionService RequisitionService
@inject ISnackbar Snackbar
@attribute [Authorize(Policy = "Menu:REC_ADMIN")]

<PageTitle>คำขออัตรากำลัง (Requisition)</PageTitle>

@if (string.IsNullOrEmpty(_companyId))
{
    <MudAlert Severity="Severity.Error" Class="ma-4">บัญชีของคุณยังไม่ได้ผูกกับบริษัทใดๆ</MudAlert>
}
else
{
    <MudPaper Class="pa-4 mb-4">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h5">คำขออัตรากำลัง (Manpower Requisition)</MudText>
            @if (!_showForm)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateForm">สร้างคำขอใหม่</MudButton>
            }
        </MudStack>

        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-2">@_error</MudAlert>
        }
        @if (!string.IsNullOrEmpty(_info))
        {
            <MudAlert Severity="Severity.Success" Class="mt-2">@_info</MudAlert>
        }

        <MudTable Items="_requisitions" Dense="true" Hover="true" Class="mt-3">
            <HeaderContent>
                <MudTh>#</MudTh>
                <MudTh>ประเภท</MudTh>
                <MudTh>ตำแหน่ง (Job)</MudTh>
                <MudTh>หน่วยงาน</MudTh>
                <MudTh>จำนวน</MudTh>
                <MudTh>สถานะ</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Id</MudTd>
                <MudTd>@(context.RequisitionType == RequisitionType.Replacement ? "ทดแทน" : "อัตราใหม่")</MudTd>
                <MudTd>@ExecTypeName(context.PosExecTypeId)</MudTd>
                <MudTd>@OrgName(context.OrganizationId)</MudTd>
                <MudTd>@context.OpeningsCount</MudTd>
                <MudTd><MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Status)">@StatusLabel(context.Status)</MudChip></MudTd>
                <MudTd>
                    <MudStack Row="true" Spacing="1">
                        <MudButton Size="Size.Small" Variant="Variant.Text" Href="@($"/rec/requisitions/{context.Id}")">รายละเอียด</MudButton>
                        @if (context.Status == RequisitionStatus.Draft)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => SubmitAsync(context.Id))">ส่งอนุมัติ</MudButton>
                        }
                    </MudStack>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText Typo="Typo.body2">ยังไม่มีคำขออัตรากำลัง</MudText></NoRecordsContent>
        </MudTable>
    </MudPaper>

    @if (_showForm)
    {
        <MudPaper Class="pa-4 mb-4">
            <MudText Typo="Typo.h6">สร้างคำขอใหม่</MudText>
            <MudGrid Class="mt-1">
                <MudItem xs="12" sm="4">
                    <MudSelect T="RequisitionType" @bind-Value="_requisitionType" Label="ประเภทคำขอ">
                        <MudSelectItem Value="RequisitionType.Replacement">ทดแทน (Replacement)</MudSelectItem>
                        <MudSelectItem Value="RequisitionType.NewHeadcount">อัตราใหม่ (New Headcount)</MudSelectItem>
                    </MudSelect>
                </MudItem>
                @if (_requisitionType == RequisitionType.Replacement)
                {
                    <MudItem xs="12" sm="8">
                        <MudAutocomplete T="Pos_PositionSlot" Label="เลขที่อัตราเดิมที่จะทดแทน (ต้องว่าง)" Value="_selectedSlot" ValueChanged="v => _selectedSlot = v"
                            SearchFunc="SearchVacantSlotsAsync" ToStringFunc="@(s => s == null ? null : $"#{s.Id} — {s.Name}")"
                            ResetValueOnEmptyText="true" CoerceText="true" MinCharacters="0" Clearable="true" />
                    </MudItem>
                }
                <MudItem xs="12" sm="6">
                    <MudAutocomplete T="Pos_ExecType" Label="ตำแหน่ง (Job)" Value="_selectedExecType" ValueChanged="v => _selectedExecType = v"
                        SearchFunc="SearchExecTypesAsync" ToStringFunc="@(t => t == null ? null : $"{t.Code} — {t.Name}")"
                        ResetValueOnEmptyText="true" CoerceText="true" MinCharacters="0" Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudAutocomplete T="com_organization" Label="หน่วยงาน" Value="_selectedOrg" ValueChanged="v => _selectedOrg = v"
                        SearchFunc="SearchOrganizationsAsync" ToStringFunc="@(o => o == null ? null : $"{o.code} — {o.name}")"
                        ResetValueOnEmptyText="true" CoerceText="true" MinCharacters="0" Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="3"><MudNumericField T="int" @bind-Value="_openingsCount" Label="จำนวนอัตรา" Min="1" /></MudItem>
                <MudItem xs="12" sm="3"><MudNumericField T="decimal?" @bind-Value="_minSalary" Label="เงินเดือนเสนอ (ต่ำสุด)" Format="N2" /></MudItem>
                <MudItem xs="12" sm="3"><MudNumericField T="decimal?" @bind-Value="_maxSalary" Label="เงินเดือนเสนอ (สูงสุด)" Format="N2" /></MudItem>
                <MudItem xs="12" sm="3"><MudDatePicker Label="วันที่คาดว่าจะเริ่มงาน" @bind-Date="_targetStartDate" /></MudItem>
                <MudItem xs="12"><MudTextField @bind-Value="_justification" Label="เหตุผล/ความจำเป็น" Lines="3" /></MudItem>
                <MudItem xs="12">
                    <MudStack Row="true" Spacing="2">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateAsync">บันทึกคำขอ (ร่าง)</MudButton>
                        <MudButton Variant="Variant.Text" OnClick="CancelForm">ยกเลิก</MudButton>
                    </MudStack>
                </MudItem>
            </MudGrid>
        </MudPaper>
    }
}

@code {
    private string? _companyId;
    private long _actorUserId;
    private string? _actorEmpId;
    private List<Rec_Requisition> _requisitions = new();
    private Dictionary<long, string> _execTypeNames = new();
    private Dictionary<long, string> _orgNames = new();
    private string? _error;
    private string? _info;
    private bool _showForm;

    private RequisitionType _requisitionType = RequisitionType.Replacement;
    private Pos_PositionSlot? _selectedSlot;
    private Pos_ExecType? _selectedExecType;
    private com_organization? _selectedOrg;
    private int _openingsCount = 1;
    private decimal? _minSalary;
    private decimal? _maxSalary;
    private DateTime? _targetStartDate;
    private string? _justification;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
        _actorUserId = long.TryParse(state.User.FindFirstValue("sc_userid"), out var uid) ? uid : 0;
        _actorEmpId = state.User.FindFirstValue("empno");
        if (string.IsNullOrWhiteSpace(_companyId)) return;

        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        if (string.IsNullOrEmpty(_companyId)) return;

        // Lazy apply-on-read for every requisition still pending, before display.
        var pending = await RequisitionService.GetAllAsync(_companyId);
        foreach (var r in pending.Where(r => r.Status == RequisitionStatus.PendingApproval))
            await RequisitionService.SyncStatusFromJobAsync(r.Id);

        _requisitions = await RequisitionService.GetAllAsync(_companyId);

        await using var context = await DbFactory.CreateDbContextAsync();
        var execTypeIds = _requisitions.Select(r => r.PosExecTypeId).Distinct().ToList();
        _execTypeNames = await context.Pos_ExecTypes.Where(t => execTypeIds.Contains(t.Id)).ToDictionaryAsync(t => t.Id, t => t.Name);
        var orgIds = _requisitions.Select(r => r.OrganizationId).Distinct().ToList();
        _orgNames = await context.com_organizations.Where(o => orgIds.Contains(o.id)).ToDictionaryAsync(o => o.id, o => o.name ?? o.code ?? "-");
    }

    private string ExecTypeName(long id) => _execTypeNames.TryGetValue(id, out var n) ? n : $"#{id}";
    private string OrgName(long id) => _orgNames.TryGetValue(id, out var n) ? n : $"#{id}";

    private static string StatusLabel(RequisitionStatus s) => s switch
    {
        RequisitionStatus.Draft => "ร่าง",
        RequisitionStatus.PendingApproval => "รออนุมัติ",
        RequisitionStatus.Approved => "อนุมัติแล้ว",
        RequisitionStatus.Rejected => "ไม่อนุมัติ",
        RequisitionStatus.Filled => "บรรจุครบแล้ว",
        RequisitionStatus.Cancelled => "ยกเลิก",
        _ => s.ToString(),
    };

    private static Color StatusColor(RequisitionStatus s) => s switch
    {
        RequisitionStatus.Approved or RequisitionStatus.Filled => Color.Success,
        RequisitionStatus.Rejected or RequisitionStatus.Cancelled => Color.Error,
        RequisitionStatus.PendingApproval => Color.Warning,
        _ => Color.Default,
    };

    private async Task<IEnumerable<Pos_ExecType>> SearchExecTypesAsync(string search, CancellationToken ct)
    {
        await using var context = await DbFactory.CreateDbContextAsync(ct);
        var query = context.Pos_ExecTypes.Where(t => t.CompanyId == _companyId && t.IsActive);
        query = EntitySearchHelper.ApplyTextSearch(query, search, nameof(Pos_ExecType.Code), nameof(Pos_ExecType.Name));
        return await query.OrderBy(t => t.Name).Take(20).ToListAsync(ct);
    }

    private async Task<IEnumerable<com_organization>> SearchOrganizationsAsync(string search, CancellationToken ct)
    {
        await using var context = await DbFactory.CreateDbContextAsync(ct);
        var query = context.com_organizations.Where(o => o.isActive);
        query = EntitySearchHelper.ApplyTextSearch(query, search, nameof(com_organization.code), nameof(com_organization.name));
        return await query.OrderBy(o => o.orgcodefull).Take(20).ToListAsync(ct);
    }

    private async Task<IEnumerable<Pos_PositionSlot>> SearchVacantSlotsAsync(string search, CancellationToken ct)
    {
        await using var context = await DbFactory.CreateDbContextAsync(ct);
        var query = context.Pos_PositionSlots.Where(s => s.CompanyId == _companyId && s.IsActive && s.HremployeeId == null);
        query = EntitySearchHelper.ApplyTextSearch(query, search, nameof(Pos_PositionSlot.Name), nameof(Pos_PositionSlot.PosCode));
        return await query.OrderBy(s => s.Id).Take(20).ToListAsync(ct);
    }

    private void OpenCreateForm()
    {
        _error = null;
        _info = null;
        _requisitionType = RequisitionType.Replacement;
        _selectedSlot = null;
        _selectedExecType = null;
        _selectedOrg = null;
        _openingsCount = 1;
        _minSalary = null;
        _maxSalary = null;
        _targetStartDate = null;
        _justification = null;
        _showForm = true;
    }

    private void CancelForm()
    {
        _showForm = false;
    }

    private async Task CreateAsync()
    {
        _error = null;
        _info = null;

        if (_selectedExecType is null || _selectedOrg is null)
        {
            _error = "กรุณาเลือกตำแหน่ง (Job) และหน่วยงาน";
            return;
        }
        if (_requisitionType == RequisitionType.Replacement && _selectedSlot is null)
        {
            _error = "การขอแบบทดแทนต้องเลือกเลขที่อัตราเดิมที่จะทดแทน";
            return;
        }

        try
        {
            await RequisitionService.CreateDraftAsync(new Rec_Requisition
            {
                CompanyId = _companyId!,
                RequisitionType = _requisitionType,
                TargetPositionSlotId = _requisitionType == RequisitionType.Replacement ? _selectedSlot!.Id : null,
                PosExecTypeId = _selectedExecType.Id,
                OrganizationId = _selectedOrg.id,
                OpeningsCount = _openingsCount,
                Justification = _justification,
                ProposedMinSalary = _minSalary,
                ProposedMaxSalary = _maxSalary,
                RequestedByUserId = _actorUserId,
                TargetStartDate = _targetStartDate is null ? null : DateOnly.FromDateTime(_targetStartDate.Value),
            });

            _info = "บันทึกคำขอ (ร่าง) สำเร็จ";
            _selectedSlot = null;
            _selectedExecType = null;
            _selectedOrg = null;
            _openingsCount = 1;
            _minSalary = null;
            _maxSalary = null;
            _targetStartDate = null;
            _justification = null;
            _showForm = false;
            await RefreshAsync();
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
    }

    private async Task SubmitAsync(long requisitionId)
    {
        _error = null;
        _info = null;
        try
        {
            var jobId = await RequisitionService.SubmitForApprovalAsync(requisitionId, _actorUserId, _actorEmpId);
            _info = $"ส่งอนุมัติสำเร็จ (Job #{jobId})";
            await RefreshAsync();
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
    }
}
