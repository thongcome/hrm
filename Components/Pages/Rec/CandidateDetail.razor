@page "/rec/candidates/{Id:long}"
@using HRM.Models
@using HRM.Services.Audit
@using HRM.Services.Rec
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject RecApplicationService ApplicationService
@inject IAuditLogger AuditLogger
@attribute [Authorize(Policy = "Menu:REC_ADMIN")]

<PageTitle>ประวัติผู้สมัคร</PageTitle>

@if (_candidate is null)
{
    <MudAlert Severity="Severity.Warning" Class="ma-4">ไม่พบผู้สมัครนี้</MudAlert>
}
else
{
    <MudPaper Class="pa-4 mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudText Typo="Typo.h5">@_candidate.FirstName @_candidate.LastName</MudText>
            <MudChip T="string" Color="Color.Warning" Size="Size.Small">PDPA</MudChip>
        </MudStack>
        <MudStack Spacing="1" Class="mt-2">
            <MudText Typo="Typo.body1"><b>อีเมล:</b> @_candidate.Email</MudText>
            <MudText Typo="Typo.body1"><b>เบอร์โทร:</b> @(_candidate.Phone ?? "-")</MudText>
            <MudText Typo="Typo.body1"><b>แหล่งที่มา:</b> @(_candidate.Source ?? "-")</MudText>
            <MudText Typo="Typo.body1"><b>ความยินยอม PDPA:</b> @(_candidate.ConsentGiven ? $"ให้ความยินยอมเมื่อ {_candidate.ConsentDate:dd/MM/yyyy}" : "ยังไม่ได้ให้ความยินยอม")</MudText>
            @if (_candidate.ResumeDocCenterId is not null)
            {
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download" Href="@($"/rec/files/resume/{_candidate.ResumeDocCenterId}")" Target="_blank">ดาวน์โหลดเรซูเม่</MudButton>
            }
        </MudStack>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-3">
            <MudTextField T="string" @bind-Value="_idCard" Label="เลขบัตรประชาชน" MaxLength="13" Style="max-width: 260px;"
                HelperText="ไม่บังคับตอนสมัคร แต่ต้องกรอกก่อนส่งอนุมัติการจ้าง" />
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="SaveIdCardAsync">บันทึกเลขบัตรประชาชน</MudButton>
        </MudStack>
        @if (!string.IsNullOrEmpty(_idCardInfo))
        {
            <MudAlert Severity="Severity.Success" Class="mt-2" Dense="true">@_idCardInfo</MudAlert>
        }
    </MudPaper>

    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" Class="mb-2">ประวัติการศึกษา</MudText>
        <MudTable Items="_education" Dense="true" Hover="true">
            <HeaderContent>
                <MudTh>ระดับ</MudTh><MudTh>วุฒิ/สาขา</MudTh><MudTh>สถาบัน</MudTh><MudTh>ปีที่จบ</MudTh><MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Level @(context.IsHighestDegree ? "(สูงสุด)" : "")</MudTd>
                <MudTd>@context.Degree @context.Major</MudTd>
                <MudTd>@context.Institute</MudTd>
                <MudTd>@(context.FinishedDate?.ToString("yyyy") ?? "-")</MudTd>
                <MudTd><MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="@(() => RemoveEducationAsync(context.Id))" /></MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText Typo="Typo.body2">ไม่มีข้อมูลการศึกษา</MudText></NoRecordsContent>
        </MudTable>
        <MudExpansionPanels Class="mt-2">
            <MudExpansionPanel Text="เพิ่มประวัติการศึกษา">
                <MudGrid>
                    <MudItem xs="6"><MudTextField @bind-Value="_newEdu.Level" Label="ระดับ" /></MudItem>
                    <MudItem xs="6"><MudTextField @bind-Value="_newEdu.Degree" Label="วุฒิ" /></MudItem>
                    <MudItem xs="6"><MudTextField @bind-Value="_newEdu.Major" Label="วิชาเอก" /></MudItem>
                    <MudItem xs="6"><MudTextField @bind-Value="_newEdu.Institute" Label="สถาบัน" /></MudItem>
                    <MudItem xs="6"><MudDatePicker @bind-Date="_newEduFinished" Label="ปีที่จบ" /></MudItem>
                    <MudItem xs="6"><MudCheckBox @bind-Value="_newEdu.IsHighestDegree" Label="วุฒิสูงสุด" /></MudItem>
                    <MudItem xs="12"><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddEducationAsync">เพิ่ม</MudButton></MudItem>
                </MudGrid>
            </MudExpansionPanel>
        </MudExpansionPanels>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" Class="mb-2">ประสบการณ์การทำงาน</MudText>
        <MudTable Items="_experience" Dense="true" Hover="true">
            <HeaderContent>
                <MudTh>ตำแหน่ง</MudTh><MudTh>บริษัท</MudTh><MudTh>ช่วงเวลา</MudTh><MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Position</MudTd>
                <MudTd>@context.Company</MudTd>
                <MudTd>@context.StartDate?.ToString("MM/yyyy") - @(context.EndDate?.ToString("MM/yyyy") ?? "ปัจจุบัน")</MudTd>
                <MudTd><MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="@(() => RemoveExperienceAsync(context.Id))" /></MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText Typo="Typo.body2">ไม่มีข้อมูลประสบการณ์</MudText></NoRecordsContent>
        </MudTable>
        <MudExpansionPanels Class="mt-2">
            <MudExpansionPanel Text="เพิ่มประสบการณ์การทำงาน">
                <MudGrid>
                    <MudItem xs="6"><MudTextField @bind-Value="_newExp.Position" Label="ตำแหน่ง" /></MudItem>
                    <MudItem xs="6"><MudTextField @bind-Value="_newExp.Company" Label="บริษัท" /></MudItem>
                    <MudItem xs="6"><MudDatePicker @bind-Date="_newExpStart" Label="วันที่เริ่ม" /></MudItem>
                    <MudItem xs="6"><MudDatePicker @bind-Date="_newExpEnd" Label="วันที่สิ้นสุด (เว้นว่างถ้ายังทำอยู่)" /></MudItem>
                    <MudItem xs="12"><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddExperienceAsync">เพิ่ม</MudButton></MudItem>
                </MudGrid>
            </MudExpansionPanel>
        </MudExpansionPanels>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6">ประวัติการสมัครทั้งหมด</MudText>
        <MudTable Items="_applications" Dense="true" Hover="true" Class="mt-2">
            <HeaderContent>
                <MudTh>ตำแหน่งที่สมัคร</MudTh>
                <MudTh>วันที่สมัคร</MudTh>
                <MudTh>สถานะ</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@PostingTitle(context.JobPostingId)</MudTd>
                <MudTd>@context.AppliedDate.ToString("dd/MM/yyyy")</MudTd>
                <MudTd>@context.Stage</MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText Typo="Typo.body2">ไม่มีประวัติการสมัคร</MudText></NoRecordsContent>
        </MudTable>
    </MudPaper>
}

@code {
    [Parameter] public long Id { get; set; }

    private Rec_Candidate? _candidate;
    private List<Rec_Application> _applications = new();
    private Dictionary<long, string> _postingTitles = new();
    private List<Rec_CandidateEducation> _education = new();
    private List<Rec_CandidateExperience> _experience = new();
    private Rec_CandidateEducation _newEdu = new();
    private DateTime? _newEduFinished;
    private Rec_CandidateExperience _newExp = new();
    private DateTime? _newExpStart;
    private DateTime? _newExpEnd;
    private string? _idCard;
    private string? _idCardInfo;

    protected override async Task OnParametersSetAsync()
    {
        _candidate = await ApplicationService.GetCandidateAsync(Id);
        if (_candidate is null) return;
        _idCard = _candidate.IdCard;

        await AuditLogger.LogAccessAsync("Rec_Candidate", Id.ToString(), isSensitive: true, note: "candidate detail view");

        _applications = await ApplicationService.GetApplicationHistoryForCandidateAsync(Id);
        _education = await ApplicationService.GetCandidateEducationAsync(Id);
        _experience = await ApplicationService.GetCandidateExperienceAsync(Id);

        await using var context = await DbFactory.CreateDbContextAsync();
        var postingIds = _applications.Select(a => a.JobPostingId).Distinct().ToList();
        _postingTitles = await context.Rec_JobPostings.Where(p => postingIds.Contains(p.Id)).ToDictionaryAsync(p => p.Id, p => p.Title);
    }

    private string PostingTitle(long id) => _postingTitles.TryGetValue(id, out var t) ? t : $"#{id}";

    private async Task SaveIdCardAsync()
    {
        _idCardInfo = null;
        await ApplicationService.UpdateCandidateIdCardAsync(Id, _idCard);
        _candidate = await ApplicationService.GetCandidateAsync(Id);
        _idCardInfo = "บันทึกเลขบัตรประชาชนสำเร็จ";
    }

    private async Task AddEducationAsync()
    {
        if (string.IsNullOrWhiteSpace(_newEdu.Level)) return;
        _newEdu.CandidateId = Id;
        _newEdu.FinishedDate = _newEduFinished is null ? null : DateOnly.FromDateTime(_newEduFinished.Value);
        await ApplicationService.AddCandidateEducationAsync(_newEdu);
        _newEdu = new();
        _newEduFinished = null;
        _education = await ApplicationService.GetCandidateEducationAsync(Id);
    }

    private async Task RemoveEducationAsync(long id)
    {
        await ApplicationService.RemoveCandidateEducationAsync(id);
        _education = await ApplicationService.GetCandidateEducationAsync(Id);
    }

    private async Task AddExperienceAsync()
    {
        if (string.IsNullOrWhiteSpace(_newExp.Company) && string.IsNullOrWhiteSpace(_newExp.Position)) return;
        _newExp.CandidateId = Id;
        _newExp.StartDate = _newExpStart is null ? null : DateOnly.FromDateTime(_newExpStart.Value);
        _newExp.EndDate = _newExpEnd is null ? null : DateOnly.FromDateTime(_newExpEnd.Value);
        await ApplicationService.AddCandidateExperienceAsync(_newExp);
        _newExp = new();
        _newExpStart = null;
        _newExpEnd = null;
        _experience = await ApplicationService.GetCandidateExperienceAsync(Id);
    }

    private async Task RemoveExperienceAsync(long id)
    {
        await ApplicationService.RemoveCandidateExperienceAsync(id);
        _experience = await ApplicationService.GetCandidateExperienceAsync(Id);
    }
}
