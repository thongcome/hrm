@page "/orgdev/workforce-plan"
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.OrgDev
@using HRM.Services.Shared
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject WorkforcePlanService PlanService
@inject ISnackbar Snackbar
@attribute [Authorize(Policy = "Menu:ORGDEV_ADMIN")]

<PageTitle>Workforce Planning — Organization Development</PageTitle>

@if (string.IsNullOrEmpty(_companyId))
{
    <MudAlert Severity="Severity.Error" Class="ma-4">บัญชีของคุณยังไม่ได้ผูกกับบริษัทใดๆ</MudAlert>
}
else
{
    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h5">แผนอัตรากำลัง (Workforce Planning)</MudText>
        <MudText Typo="Typo.body2" Class="mt-1 mb-3">ตั้งเป้าอัตรากำลังต่อหน่วยงานต่อปี เทียบกับอัตราจริงที่มีอยู่ (คำนวณสดจากเลขที่อัตรา)</MudText>

        <MudGrid>
            <MudItem xs="12" sm="3">
                <MudNumericField T="int" Value="_selectedYear" Label="ปี" Min="2020" Max="2100" ValueChanged="OnYearChangedAsync" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4">
        <MudTable Items="_plans" Dense="true" Hover="true">
            <HeaderContent>
                <MudTh>หน่วยงาน</MudTh>
                <MudTh>เป้าอัตรากำลัง</MudTh>
                <MudTh>อัตรากำลังจริง</MudTh>
                <MudTh>ตำแหน่งว่าง</MudTh>
                <MudTh>ส่วนต่าง (Gap)</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.OrganizationName</MudTd>
                <MudTd>@context.TargetHeadcount</MudTd>
                <MudTd>@context.ActualHeadcount</MudTd>
                <MudTd>@context.VacantSlots</MudTd>
                <MudTd>
                    <MudChip T="string" Size="Size.Small" Color="@(context.Gap > 0 ? Color.Warning : context.Gap < 0 ? Color.Info : Color.Success)">@context.Gap</MudChip>
                </MudTd>
                <MudTd><MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Text" OnClick="@(() => RemoveAsync(context.PlanId))">ลบ</MudButton></MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText Typo="Typo.body2">ยังไม่มีแผนอัตรากำลังสำหรับปีนี้</MudText></NoRecordsContent>
        </MudTable>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" Class="mb-2">ตั้งเป้าอัตรากำลังใหม่ / แก้ไข</MudText>
        <MudGrid>
            <MudItem xs="12" sm="5">
                <MudAutocomplete T="com_organization" Label="หน่วยงาน" @bind-Value="_selectedOrg"
                    SearchFunc="SearchOrganizationsAsync"
                    ToStringFunc="@(o => o == null ? null : $"{o.code} — {o.name}")"
                    ResetValueOnEmptyText="true" CoerceText="true" MinCharacters="0" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudNumericField T="int" @bind-Value="_targetHeadcount" Label="เป้าอัตรากำลัง" Min="0" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField T="string" @bind-Value="_note" Label="หมายเหตุ (ถ้ามี)" />
            </MudItem>
            <MudItem xs="12">
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync" Disabled="@(_selectedOrg is null)">บันทึก</MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>
}

@code {
    private string? _companyId;
    private int _selectedYear = DateTime.Today.Year;
    private List<WorkforcePlanService.PlanRow> _plans = new();
    private com_organization? _selectedOrg;
    private int _targetHeadcount;
    private string? _note;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
        if (string.IsNullOrWhiteSpace(_companyId)) return;

        await LoadAsync();
    }

    private async Task OnYearChangedAsync(int year)
    {
        _selectedYear = year;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (string.IsNullOrEmpty(_companyId)) return;
        _plans = await PlanService.GetPlansAsync(_companyId, _selectedYear);
    }

    private async Task<IEnumerable<com_organization>> SearchOrganizationsAsync(string search, CancellationToken ct)
    {
        await using var context = await DbFactory.CreateDbContextAsync(ct);
        var query = context.com_organizations.Where(o => o.isActive);
        query = EntitySearchHelper.ApplyTextSearch(query, search, nameof(com_organization.code), nameof(com_organization.name));
        return await query.OrderBy(o => o.orgcodefull).Take(20).ToListAsync(ct);
    }

    private async Task SaveAsync()
    {
        if (_selectedOrg is null || string.IsNullOrEmpty(_companyId)) return;

        var state = await AuthProvider.GetAuthenticationStateAsync();
        var userId = long.TryParse(state.User.FindFirstValue("sc_userid"), out var uid) ? uid : 0;

        await PlanService.SaveAsync(_companyId, _selectedOrg.id, _selectedYear, _targetHeadcount, _note, userId);
        Snackbar.Add("บันทึกแผนอัตรากำลังแล้ว", Severity.Success);
        _selectedOrg = null;
        _targetHeadcount = 0;
        _note = null;
        await LoadAsync();
    }

    private async Task RemoveAsync(long planId)
    {
        await PlanService.RemoveAsync(planId);
        Snackbar.Add("ลบแผนอัตรากำลังแล้ว", Severity.Success);
        await LoadAsync();
    }
}
