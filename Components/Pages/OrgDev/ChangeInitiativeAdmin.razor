@page "/orgdev/change-initiatives"
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.OrgDev
@using HRM.Services.Shared
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject ChangeInitiativeService InitiativeService
@inject ISnackbar Snackbar
@inject JsonLocalizationService L
@attribute [Authorize(Policy = "Menu:ORGDEV_ADMIN")]

<PageTitle>@L.Translate("ChangeInitiativesPageTitle")</PageTitle>

@if (string.IsNullOrEmpty(_companyId))
{
    <MudAlert Severity="Severity.Error" Class="ma-4">@L.Translate("CompanyNotLinkedShortError")</MudAlert>
}
else
{
    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h5">@L.Translate("ChangeInitiativesHeading")</MudText>
        <MudText Typo="Typo.body2" Class="mt-1 mb-3">@L.Translate("ChangeInitiativesDesc")</MudText>

        <MudTable Items="_initiatives" Dense="true" Hover="true">
            <HeaderContent>
                <MudTh>@L.Translate("ColProjectTitle")</MudTh>
                <MudTh>@L.Translate("ColRelatedOrganization")</MudTh>
                <MudTh>@L.Translate("ColStatus")</MudTh>
                <MudTh>@L.Translate("ColProgress")</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Title</MudTd>
                <MudTd>@(context.ImpactedOrganizationName ?? "-")</MudTd>
                <MudTd>
                    <MudSelect T="ChangeInitiativeStatus" Value="context.Status" ValueChanged="@(v => UpdateStatusAsync(context.Id, v))" Dense="true">
                        @foreach (var v in Enum.GetValues<ChangeInitiativeStatus>())
                        {
                            <MudSelectItem Value="@v">@StatusLabel(v)</MudSelectItem>
                        }
                    </MudSelect>
                </MudTd>
                <MudTd>@context.CompletedMilestones / @context.TotalMilestones</MudTd>
                <MudTd><MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => ToggleMilestonesAsync(context.Id))">@(_expandedId == context.Id ? L.Translate("HideButton") : L.Translate("ManageItemsButton"))</MudButton></MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText Typo="Typo.body2">@L.Translate("NoChangeInitiativesMessage")</MudText></NoRecordsContent>
        </MudTable>
    </MudPaper>

    @if (_expandedId is not null)
    {
        <MudPaper Class="pa-4 mb-4">
            <MudText Typo="Typo.h6" Class="mb-2">@L.Translate("TrackingItemsHeading")</MudText>
            <MudTable Items="_milestones" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh>@L.Translate("ColItemLabel")</MudTh>
                    <MudTh>@L.Translate("ColDueDate")</MudTh>
                    <MudTh>@L.Translate("ColStatus")</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Title</MudTd>
                    <MudTd>@(context.TargetDate?.ToString("dd/MM/yyyy") ?? "-")</MudTd>
                    <MudTd><MudChip T="string" Size="Size.Small" Color="@(context.Status == OrgDevMilestoneStatus.Completed ? Color.Success : Color.Default)">@(context.Status == OrgDevMilestoneStatus.Completed ? L.Translate("CompletedChip") : L.Translate("PendingChip"))</MudChip></MudTd>
                    <MudTd>
                        @if (context.Status == OrgDevMilestoneStatus.Pending)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => CompleteMilestoneAsync(context.Id))">@L.Translate("CompleteButton")</MudButton>
                        }
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText Typo="Typo.body2">@L.Translate("NoItemsYet")</MudText></NoRecordsContent>
            </MudTable>

            <MudGrid Class="mt-2">
                <MudItem xs="12" sm="8"><MudTextField T="string" @bind-Value="_newMilestoneTitle" Label="@L.Translate("NewItemLabel")" /></MudItem>
                <MudItem xs="12" sm="4"><MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="AddMilestoneAsync" Disabled="@string.IsNullOrWhiteSpace(_newMilestoneTitle)">@L.Translate("AddButtonPlain")</MudButton></MudItem>
            </MudGrid>
        </MudPaper>
    }

    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" Class="mb-2">@L.Translate("CreateNewInitiativeHeading")</MudText>
        <MudGrid>
            <MudItem xs="12" sm="6"><MudTextField T="string" @bind-Value="_title" Label="@L.Translate("ColProjectTitle")" /></MudItem>
            <MudItem xs="12" sm="6">
                <MudAutocomplete T="com_organization" Label="@L.Translate("RelatedOrganizationOptionalLabel")" @bind-Value="_selectedOrg"
                    SearchFunc="SearchOrganizationsAsync"
                    ToStringFunc="@(o => o == null ? null : $"{o.code} — {o.name}")"
                    ResetValueOnEmptyText="true" CoerceText="true" MinCharacters="0" Clearable="true" />
            </MudItem>
            <MudItem xs="12" sm="6"><MudDatePicker Label="@L.Translate("ProjectStartDateLabel")" @bind-Date="_startDate" /></MudItem>
            <MudItem xs="12" sm="6"><MudDatePicker Label="@L.Translate("ColDueDate")" @bind-Date="_targetDate" /></MudItem>
            <MudItem xs="12"><MudTextField T="string" @bind-Value="_description" Label="@L.Translate("DescriptionLabel")" Lines="4" /></MudItem>
            <MudItem xs="12"><MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="CreateAsync" Disabled="@string.IsNullOrWhiteSpace(_title)">@L.Translate("CreateProjectButton")</MudButton></MudItem>
        </MudGrid>
    </MudPaper>
}

@code {
    private string? _companyId;
    private List<ChangeInitiativeService.InitiativeRow> _initiatives = new();
    private long? _expandedId;
    private List<OrgDev_ChangeMilestone> _milestones = new();
    private string? _newMilestoneTitle;

    private string? _title;
    private com_organization? _selectedOrg;
    private DateTime? _startDate;
    private DateTime? _targetDate;
    private string? _description;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
        if (string.IsNullOrWhiteSpace(_companyId)) return;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (string.IsNullOrEmpty(_companyId)) return;
        _initiatives = await InitiativeService.GetInitiativesAsync(_companyId);
    }

    private async Task<IEnumerable<com_organization>> SearchOrganizationsAsync(string search, CancellationToken ct)
    {
        await using var context = await DbFactory.CreateDbContextAsync(ct);
        var query = context.com_organizations.Where(o => o.isActive);
        query = EntitySearchHelper.ApplyTextSearch(query, search, nameof(com_organization.code), nameof(com_organization.name));
        return await query.OrderBy(o => o.orgcodefull).Take(20).ToListAsync(ct);
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_title) || string.IsNullOrEmpty(_companyId)) return;

        var state = await AuthProvider.GetAuthenticationStateAsync();
        var userId = long.TryParse(state.User.FindFirstValue("sc_userid"), out var uid) ? uid : 0;

        await InitiativeService.CreateAsync(_companyId, _title, _description, userId, _selectedOrg?.id,
            _startDate is null ? null : DateOnly.FromDateTime(_startDate.Value),
            _targetDate is null ? null : DateOnly.FromDateTime(_targetDate.Value), userId);

        Snackbar.Add(L.Translate("InitiativeCreatedSuccess"), Severity.Success);
        _title = null;
        _selectedOrg = null;
        _startDate = null;
        _targetDate = null;
        _description = null;
        await LoadAsync();
    }

    private async Task UpdateStatusAsync(long id, ChangeInitiativeStatus status)
    {
        await InitiativeService.UpdateStatusAsync(id, status);
        await LoadAsync();
    }

    private async Task ToggleMilestonesAsync(long id)
    {
        if (_expandedId == id)
        {
            _expandedId = null;
            return;
        }
        _expandedId = id;
        _milestones = await InitiativeService.GetMilestonesAsync(id);
    }

    private async Task AddMilestoneAsync()
    {
        if (_expandedId is null || string.IsNullOrWhiteSpace(_newMilestoneTitle)) return;
        await InitiativeService.AddMilestoneAsync(_expandedId.Value, _newMilestoneTitle, null);
        _newMilestoneTitle = null;
        _milestones = await InitiativeService.GetMilestonesAsync(_expandedId.Value);
        await LoadAsync();
    }

    private async Task CompleteMilestoneAsync(long milestoneId)
    {
        await InitiativeService.CompleteMilestoneAsync(milestoneId);
        if (_expandedId is not null)
            _milestones = await InitiativeService.GetMilestonesAsync(_expandedId.Value);
        await LoadAsync();
    }

    private string StatusLabel(ChangeInitiativeStatus s) => s switch
    {
        ChangeInitiativeStatus.Planned => L.Translate("ChangeStatusPlanned"),
        ChangeInitiativeStatus.InProgress => L.Translate("LeadershipStatusInProgress"),
        ChangeInitiativeStatus.Completed => L.Translate("LeadershipStatusCompleted"),
        ChangeInitiativeStatus.OnHold => L.Translate("LeadershipStatusOnHold"),
        ChangeInitiativeStatus.Cancelled => L.Translate("ChangeStatusCancelled"),
        _ => s.ToString(),
    };
}
