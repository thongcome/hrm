@page "/orgdev/culture-assessment"
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Engagement
@using HRM.Services.OrgDev
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@inject AuthenticationStateProvider AuthProvider
@inject CultureAssessmentService AssessmentService
@inject SurveyService SurveyService
@inject ISnackbar Snackbar
@inject JsonLocalizationService L
@attribute [Authorize(Policy = "Menu:ORGDEV_ADMIN")]

@* Culture assessment now runs as anonymous Culture-type campaigns on the
   Engagement survey engine (one survey engine, per the HRD maturity audit) —
   this page seeds the standard question bank, lists Culture campaigns with
   their aggregate scores, and keeps the old manual entries as read-only
   history. *@

<PageTitle>@L.Translate("CultureAssessmentPageTitle")</PageTitle>

@if (string.IsNullOrEmpty(_companyId))
{
    <MudAlert Severity="Severity.Error" Class="ma-4">@L.Translate("CompanyNotLinkedShortError")</MudAlert>
}
else
{
    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h5">@L.Translate("CultureAssessmentHeading")</MudText>
        <MudText Typo="Typo.body2" Class="mt-1 mb-3">
            การประเมินวัฒนธรรมองค์กรเปลี่ยนมาใช้ระบบแบบสำรวจนิรนามของโมดูล Employee Engagement แล้ว —
            สร้างแคมเปญประเภท "ประเมินวัฒนธรรมองค์กร (Culture)" ให้พนักงานตอบเอง แทนการที่ HR กรอกคะแนนเอง
            เริ่มจากสร้างชุดคำถามมาตรฐาน 4 ด้าน (การสื่อสาร / ความไว้วางใจ / การทำงานร่วมกัน / ภาวะผู้นำ)
            เข้าคลังคำถาม แล้วไปสร้างแคมเปญจากหน้าแคมเปญของ Engagement
        </MudText>
        <MudStack Row="true" Spacing="2">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.PlaylistAdd"
                       Disabled="_seeding" OnClick="SeedTemplatesAsync">สร้างชุดคำถามวัฒนธรรมมาตรฐาน</MudButton>
            <MudButton Color="Color.Secondary" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Campaign"
                       Href="/eng/campaigns">ไปสร้าง/จัดการแคมเปญ (Engagement)</MudButton>
        </MudStack>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" Class="mb-2">แคมเปญประเมินวัฒนธรรมองค์กร</MudText>
        <MudTable Items="_cultureCampaigns" Dense="true" Hover="true">
            <HeaderContent>
                <MudTh>ชื่อแคมเปญ</MudTh>
                <MudTh>สถานะ</MudTh>
                <MudTh>ช่วงเปิดรับ</MudTh>
                <MudTh>จำนวนคำตอบ</MudTh>
                <MudTh>คะแนนเฉลี่ย (1-5)</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Title</MudTd>
                <MudTd><MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Status)">@StatusLabel(context.Status)</MudChip></MudTd>
                <MudTd>@(context.OpenDate?.ToString("dd/MM/yyyy") ?? "-") — @(context.CloseDate?.ToString("dd/MM/yyyy") ?? "-")</MudTd>
                <MudTd>@context.ResponseCount / @context.InvitedCount</MudTd>
                <MudTd>@(_avgByCampaign.TryGetValue(context.Id, out var avg) && avg is not null ? avg.Value.ToString("0.00") : "-")</MudTd>
                <MudTd>
                    @if (context.Status == Eng_CampaignStatus.Draft)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Href="@($"/eng/campaigns/{context.Id}")">จัดการ</MudButton>
                    }
                    else
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Href="@($"/eng/campaigns/{context.Id}/results")">ผลลัพธ์</MudButton>
                    }
                </MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText Typo="Typo.body2">ยังไม่มีแคมเปญประเมินวัฒนธรรม — สร้างได้จากหน้าแคมเปญ Engagement</MudText></NoRecordsContent>
        </MudTable>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" Class="mb-2">ประวัติการประเมินแบบเดิม (อ่านอย่างเดียว)</MudText>
        <MudText Typo="Typo.body2" Class="mb-2">คะแนนที่ HR เคยบันทึกเองก่อนย้ายมาใช้แบบสำรวจนิรนาม — เก็บไว้เป็นประวัติ ไม่รับข้อมูลใหม่แล้ว</MudText>
        <MudTable Items="_history" Dense="true" Hover="true">
            <HeaderContent>
                <MudTh>@L.Translate("ColDate")</MudTh>
                <MudTh>@L.Translate("ColCommunication")</MudTh>
                <MudTh>@L.Translate("ColTrust")</MudTh>
                <MudTh>@L.Translate("ColCollaboration")</MudTh>
                <MudTh>@L.Translate("ColLeadership")</MudTh>
                <MudTh>@L.Translate("ColAverage")</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.AssessmentDate.ToString("dd/MM/yyyy")</MudTd>
                <MudTd>@context.CommunicationScore</MudTd>
                <MudTd>@context.TrustScore</MudTd>
                <MudTd>@context.CollaborationScore</MudTd>
                <MudTd>@context.LeadershipScore</MudTd>
                <MudTd>@(((context.CommunicationScore + context.TrustScore + context.CollaborationScore + context.LeadershipScore) / 4.0).ToString("0.0"))</MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText Typo="Typo.body2">@L.Translate("NoAssessmentsYetMessage")</MudText></NoRecordsContent>
        </MudTable>
    </MudPaper>
}

@code {
    private string? _companyId;
    private List<OrgDev_CultureAssessment> _history = new();
    private List<Eng_SurveyCampaign> _cultureCampaigns = new();
    private readonly Dictionary<long, double?> _avgByCampaign = new();
    private bool _seeding;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
        if (string.IsNullOrWhiteSpace(_companyId)) return;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (string.IsNullOrEmpty(_companyId)) return;
        _history = await AssessmentService.GetHistoryAsync(_companyId);

        var all = await SurveyService.GetCampaignsForAdminAsync(_companyId);
        _cultureCampaigns = all.Where(c => c.CampaignType == Eng_CampaignType.Culture).ToList();

        // Overall campaign score = mean of the per-dimension (per rating
        // question) averages from the engine's own aggregation — same
        // semantics as the legacy "average of the 4 dimension scores".
        _avgByCampaign.Clear();
        foreach (var campaign in _cultureCampaigns.Where(c => c.Status != Eng_CampaignStatus.Draft))
        {
            var results = await SurveyService.GetResultsAsync(campaign.Id);
            var dimensionAverages = results.Questions
                .Where(q => q.QuestionType == Eng_QuestionType.Rating && q.AverageRating != null)
                .Select(q => q.AverageRating!.Value)
                .ToList();
            _avgByCampaign[campaign.Id] = dimensionAverages.Count > 0 ? Math.Round(dimensionAverages.Average(), 2) : null;
        }
    }

    private async Task SeedTemplatesAsync()
    {
        if (string.IsNullOrEmpty(_companyId)) return;
        _seeding = true;
        try
        {
            var state = await AuthProvider.GetAuthenticationStateAsync();
            var userId = long.TryParse(state.User.FindFirstValue("sc_userid"), out var uid) ? uid : 0;

            var created = await SurveyService.EnsureCultureQuestionTemplatesAsync(_companyId, userId);
            Snackbar.Add(created > 0
                ? $"เพิ่มคำถามวัฒนธรรมมาตรฐานเข้าคลังคำถามแล้ว {created} ข้อ"
                : "คลังคำถามมีชุดคำถามวัฒนธรรมมาตรฐานครบแล้ว", Severity.Success);
        }
        finally
        {
            _seeding = false;
        }
    }

    private static string StatusLabel(Eng_CampaignStatus s) => s switch
    {
        Eng_CampaignStatus.Draft => "ฉบับร่าง",
        Eng_CampaignStatus.Open => "เปิดรับคำตอบ",
        Eng_CampaignStatus.Closed => "ปิดแล้ว",
        _ => "-",
    };

    private static Color StatusColor(Eng_CampaignStatus s) => s switch
    {
        Eng_CampaignStatus.Draft => Color.Default,
        Eng_CampaignStatus.Open => Color.Success,
        Eng_CampaignStatus.Closed => Color.Info,
        _ => Color.Default,
    };
}
