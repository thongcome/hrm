@page "/orgdev/culture-assessment"
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.OrgDev
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@inject AuthenticationStateProvider AuthProvider
@inject CultureAssessmentService AssessmentService
@inject ISnackbar Snackbar
@inject JsonLocalizationService L
@attribute [Authorize(Policy = "Menu:ORGDEV_ADMIN")]

<PageTitle>@L.Translate("CultureAssessmentPageTitle")</PageTitle>

@if (string.IsNullOrEmpty(_companyId))
{
    <MudAlert Severity="Severity.Error" Class="ma-4">@L.Translate("CompanyNotLinkedShortError")</MudAlert>
}
else
{
    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h5">@L.Translate("CultureAssessmentHeading")</MudText>
        <MudText Typo="Typo.body2" Class="mt-1 mb-3">
            @L.Translate("CultureAssessmentDesc")
        </MudText>

        <MudGrid>
            <MudItem xs="12" sm="3"><MudDatePicker Label="@L.Translate("AssessmentDateLabel")" @bind-Date="_assessmentDate" /></MudItem>
            <MudItem xs="12" sm="2"><MudNumericField T="int" @bind-Value="_communication" Label="@L.Translate("CommunicationScoreLabel")" Min="1" Max="5" /></MudItem>
            <MudItem xs="12" sm="2"><MudNumericField T="int" @bind-Value="_trust" Label="@L.Translate("TrustScoreLabel")" Min="1" Max="5" /></MudItem>
            <MudItem xs="12" sm="2"><MudNumericField T="int" @bind-Value="_collaboration" Label="@L.Translate("CollaborationScoreLabel")" Min="1" Max="5" /></MudItem>
            <MudItem xs="12" sm="2"><MudNumericField T="int" @bind-Value="_leadership" Label="@L.Translate("LeadershipScoreLabel")" Min="1" Max="5" /></MudItem>
            <MudItem xs="12"><MudTextField T="string" @bind-Value="_note" Label="@L.Translate("ColRemark")" Lines="3" /></MudItem>
            <MudItem xs="12"><MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">@L.Translate("SaveAssessmentButton")</MudButton></MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" Class="mb-2">@L.Translate("AssessmentHistoryHeading")</MudText>
        <MudTable Items="_history" Dense="true" Hover="true">
            <HeaderContent>
                <MudTh>@L.Translate("ColDate")</MudTh>
                <MudTh>@L.Translate("ColCommunication")</MudTh>
                <MudTh>@L.Translate("ColTrust")</MudTh>
                <MudTh>@L.Translate("ColCollaboration")</MudTh>
                <MudTh>@L.Translate("ColLeadership")</MudTh>
                <MudTh>@L.Translate("ColAverage")</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.AssessmentDate.ToString("dd/MM/yyyy")</MudTd>
                <MudTd>@context.CommunicationScore</MudTd>
                <MudTd>@context.TrustScore</MudTd>
                <MudTd>@context.CollaborationScore</MudTd>
                <MudTd>@context.LeadershipScore</MudTd>
                <MudTd>@(((context.CommunicationScore + context.TrustScore + context.CollaborationScore + context.LeadershipScore) / 4.0).ToString("0.0"))</MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText Typo="Typo.body2">@L.Translate("NoAssessmentsYetMessage")</MudText></NoRecordsContent>
        </MudTable>
    </MudPaper>
}

@code {
    private string? _companyId;
    private List<OrgDev_CultureAssessment> _history = new();

    private DateTime? _assessmentDate = DateTime.Today;
    private int _communication = 3;
    private int _trust = 3;
    private int _collaboration = 3;
    private int _leadership = 3;
    private string? _note;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
        if (string.IsNullOrWhiteSpace(_companyId)) return;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (string.IsNullOrEmpty(_companyId)) return;
        _history = await AssessmentService.GetHistoryAsync(_companyId);
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrEmpty(_companyId) || _assessmentDate is null) return;

        var state = await AuthProvider.GetAuthenticationStateAsync();
        var userId = long.TryParse(state.User.FindFirstValue("sc_userid"), out var uid) ? uid : 0;

        await AssessmentService.RecordAsync(_companyId, null, DateOnly.FromDateTime(_assessmentDate.Value),
            _communication, _trust, _collaboration, _leadership, _note, userId);

        Snackbar.Add(L.Translate("AssessmentSavedSuccess"), Severity.Success);
        _note = null;
        await LoadAsync();
    }
}
