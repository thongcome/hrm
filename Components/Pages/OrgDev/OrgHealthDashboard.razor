@page "/orgdev/dashboard"
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.OrgDev
@using HRM.Services.Succession
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@inject AuthenticationStateProvider AuthProvider
@inject WorkforcePlanService WorkforcePlanService
@inject ChangeInitiativeService ChangeInitiativeService
@inject CultureAssessmentService CultureAssessmentService
@inject HRM.Services.Engagement.SurveyService SurveyService
@inject SuccessionService SuccessionService
@inject JsonLocalizationService L
@attribute [Authorize(Policy = "Menu:ORGDEV_ADMIN")]

<PageTitle>@L.Translate("OrgHealthPageTitle")</PageTitle>

@if (string.IsNullOrEmpty(_companyId))
{
    <MudAlert Severity="Severity.Error" Class="ma-4">@L.Translate("CompanyNotLinkedShortError")</MudAlert>
}
else
{
    <MudText Typo="Typo.h4" Class="ma-4">@L.Translate("OrgHealthHeading")</MudText>
    <MudText Typo="Typo.body2" Class="mx-4 mb-4">@L.Translate("OrgHealthDesc")</MudText>

    <MudGrid Class="pa-4">
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.body2">@string.Format(L.Translate("WorkforcePlanYearTemplate"), _currentYear)</MudText>
                <MudText Typo="Typo.h4">@_workforcePlans.Sum(p => p.Gap)</MudText>
                <MudText Typo="Typo.caption">@L.Translate("WorkforceGapCaption")</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.body2">@L.Translate("InProgressInitiativesLabel")</MudText>
                <MudText Typo="Typo.h4">@_initiatives.Count(i => i.Status == ChangeInitiativeStatus.InProgress)</MudText>
                <MudText Typo="Typo.caption">@string.Format(L.Translate("OutOfTotalInitiativesTemplate"), _initiatives.Count)</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.body2">@L.Translate("LatestCultureScoreLabel")</MudText>
                @if (_cultureCampaignAvg is not null)
                {
                    <MudText Typo="Typo.h4">@_cultureCampaignAvg.Value.ToString("0.0") / 5</MudText>
                    <MudText Typo="Typo.caption">จากแบบสำรวจวัฒนธรรม (Engagement) ปิดรับ @(_cultureCampaignCloseDate?.ToString("dd/MM/yyyy") ?? "-")</MudText>
                }
                else if (_latestCulture is not null)
                {
                    <MudText Typo="Typo.h4">@(((_latestCulture.CommunicationScore + _latestCulture.TrustScore + _latestCulture.CollaborationScore + _latestCulture.LeadershipScore) / 4.0).ToString("0.0")) / 5</MudText>
                    <MudText Typo="Typo.caption">@string.Format(L.Translate("AssessedOnTemplate"), _latestCulture.AssessmentDate.ToString("dd/MM/yyyy")) (บันทึกแบบเดิม)</MudText>
                }
                else
                {
                    <MudText Typo="Typo.h4">-</MudText>
                    <MudText Typo="Typo.caption">@L.Translate("NoAssessmentsYetMessage")</MudText>
                }
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.body2">@L.Translate("KeyPositionsNoSuccessorLabel")</MudText>
                <MudText Typo="Typo.h4" Style="@(_benchStrength.Any(b => b.IsSinglePointOfFailure) ? "color:var(--mud-palette-error)" : "")">@_benchStrength.Count(b => b.IsSinglePointOfFailure)</MudText>
                <MudText Typo="Typo.caption">@string.Format(L.Translate("OutOfTotalKeyPositionsTemplate"), _benchStrength.Count)</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid Class="pa-4">
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-2">@L.Translate("TopWorkforceGapsHeading")</MudText>
                <MudTable Items="_workforcePlans.Where(p => p.Gap > 0).OrderByDescending(p => p.Gap).Take(5)" Dense="true">
                    <HeaderContent>
                        <MudTh>@L.Translate("OrganizationFieldLabel")</MudTh>
                        <MudTh>@L.Translate("ColTargetShort")</MudTh>
                        <MudTh>@L.Translate("ColActualShort")</MudTh>
                        <MudTh>@L.Translate("ColGapShort")</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.OrganizationName</MudTd>
                        <MudTd>@context.TargetHeadcount</MudTd>
                        <MudTd>@context.ActualHeadcount</MudTd>
                        <MudTd><MudChip T="string" Size="Size.Small" Color="Color.Warning">@context.Gap</MudChip></MudTd>
                    </RowTemplate>
                    <NoRecordsContent><MudText Typo="Typo.body2">@L.Translate("NoUnderstaffedOrgsMessage")</MudText></NoRecordsContent>
                </MudTable>
                <MudButton Class="mt-2" Variant="Variant.Text" Href="/orgdev/workforce-plan">@L.Translate("ViewAllButton")</MudButton>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-2">@L.Translate("RiskyKeyPositionsHeading")</MudText>
                <MudTable Items="_benchStrength.Where(b => b.IsSinglePointOfFailure || b.ReadyNowCount == 0)" Dense="true">
                    <HeaderContent>
                        <MudTh>@L.Translate("ColPosition")</MudTh>
                        <MudTh>@L.Translate("ColSuccessorsShort")</MudTh>
                        <MudTh>@L.Translate("ColStatus")</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.PosExecTypeName</MudTd>
                        <MudTd>@context.TotalSuccessorCount</MudTd>
                        <MudTd>
                            @if (context.IsSinglePointOfFailure)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Error">@L.Translate("NoSuccessorChipShort")</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning">@L.Translate("NoReadyNowChip")</MudChip>
                            }
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent><MudText Typo="Typo.body2">@L.Translate("NoRiskyKeyPositionsMessage")</MudText></NoRecordsContent>
                </MudTable>
                <MudButton Class="mt-2" Variant="Variant.Text" Href="/succession/bench-strength">@L.Translate("ViewAllButton")</MudButton>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private string? _companyId;
    private int _currentYear = DateTime.Today.Year;
    private List<WorkforcePlanService.PlanRow> _workforcePlans = new();
    private List<ChangeInitiativeService.InitiativeRow> _initiatives = new();
    private OrgDev_CultureAssessment? _latestCulture;
    private double? _cultureCampaignAvg;
    private DateOnly? _cultureCampaignCloseDate;
    private List<SuccessionService.BenchStrengthRow> _benchStrength = new();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
        if (string.IsNullOrWhiteSpace(_companyId)) return;

        _workforcePlans = await WorkforcePlanService.GetPlansAsync(_companyId, _currentYear);
        _initiatives = await ChangeInitiativeService.GetInitiativesAsync(_companyId);
        _latestCulture = await CultureAssessmentService.GetLatestAsync(_companyId);
        await LoadCultureCampaignScoreAsync(_companyId);
        _benchStrength = await SuccessionService.GetBenchStrengthAsync(_companyId);
    }

    // Culture score now prefers the newest closed Culture-type Engagement
    // campaign (anonymous survey), falling back to the legacy manual
    // OrgDev_CultureAssessment row when no such campaign has scores yet.
    // Overall score = mean of the engine's per-question rating averages,
    // matching the legacy "average of the 4 dimension scores" semantics.
    private async Task LoadCultureCampaignScoreAsync(string companyId)
    {
        var campaigns = await SurveyService.GetCampaignsForAdminAsync(companyId);
        var closedCulture = campaigns
            .Where(c => c.CampaignType == Eng_CampaignType.Culture && c.Status == Eng_CampaignStatus.Closed)
            .OrderByDescending(c => c.CloseDate)
            .ThenByDescending(c => c.CreatedDate);

        foreach (var campaign in closedCulture)
        {
            var results = await SurveyService.GetResultsAsync(campaign.Id);
            var dimensionAverages = results.Questions
                .Where(q => q.QuestionType == Eng_QuestionType.Rating && q.AverageRating != null)
                .Select(q => q.AverageRating!.Value)
                .ToList();
            if (dimensionAverages.Count == 0) continue; // closed but no rating answers — keep looking

            _cultureCampaignAvg = Math.Round(dimensionAverages.Average(), 2);
            _cultureCampaignCloseDate = campaign.CloseDate;
            break;
        }
    }
}
