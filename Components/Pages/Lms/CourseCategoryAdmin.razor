@page "/lms/categories"
@using System.Security.Claims
@using HRM.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@attribute [Authorize(Policy = "Menu:LMS_ADMIN")]

<PageTitle>หมวดหมู่หลักสูตร</PageTitle>

<MudPaper Class="pa-4 mb-4" MaxWidth="800px">
    <MudText Typo="Typo.h5">หมวดหมู่หลักสูตร (Course Category)</MudText>

    @if (string.IsNullOrEmpty(_companyId))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">บัญชีของคุณยังไม่ได้ผูกกับบริษัทใดๆ</MudAlert>
        return;
    }

    <MudGrid Class="mt-3">
        <MudItem xs="12" sm="3"><MudTextField @bind-Value="_newCode" Label="รหัส" /></MudItem>
        <MudItem xs="12" sm="4"><MudTextField @bind-Value="_newName" Label="ชื่อหมวดหมู่" /></MudItem>
        <MudItem xs="12" sm="4"><MudTextField @bind-Value="_newNameEn" Label="ชื่อ (อังกฤษ)" /></MudItem>
        <MudItem xs="12" sm="1"><MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="AddAsync" Class="mt-2">เพิ่ม</MudButton></MudItem>
    </MudGrid>

    @if (!string.IsNullOrEmpty(_error))
    {
        <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
    }

    <MudTable Items="_categories" Dense="true" Hover="true" Class="mt-4">
        <HeaderContent>
            <MudTh>รหัส</MudTh>
            <MudTh>ชื่อ</MudTh>
            <MudTh>ชื่อ (อังกฤษ)</MudTh>
            <MudTh>สถานะ</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Code</MudTd>
            <MudTd>@context.Name</MudTd>
            <MudTd>@context.NameEn</MudTd>
            <MudTd>@(context.IsActive ? "ใช้งาน" : "ปิดใช้งาน")</MudTd>
            <MudTd><MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => ToggleActiveAsync(context))">@(context.IsActive ? "ปิดใช้งาน" : "เปิดใช้งาน")</MudButton></MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText Typo="Typo.body2">ยังไม่มีหมวดหมู่หลักสูตร</MudText></NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private string? _companyId;
    private List<Lms_CourseCategory> _categories = new();
    private string? _error;
    private string _newCode = "";
    private string _newName = "";
    private string? _newNameEn;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
        if (string.IsNullOrWhiteSpace(_companyId)) return;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        _categories = await context.Lms_CourseCategories
            .Where(c => c.CompanyId == _companyId)
            .OrderBy(c => c.SortOrder).ThenBy(c => c.Name)
            .ToListAsync();
    }

    private async Task AddAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_newCode) || string.IsNullOrWhiteSpace(_newName))
        {
            _error = "กรุณากรอกรหัสและชื่อหมวดหมู่";
            return;
        }

        await using var context = await DbFactory.CreateDbContextAsync();
        var duplicate = await context.Lms_CourseCategories.AnyAsync(c => c.CompanyId == _companyId && c.Code == _newCode);
        if (duplicate)
        {
            _error = "มีรหัสนี้อยู่แล้ว";
            return;
        }

        var sortOrder = await context.Lms_CourseCategories.CountAsync(c => c.CompanyId == _companyId);
        context.Lms_CourseCategories.Add(new Lms_CourseCategory
        {
            CompanyId = _companyId!,
            Code = _newCode,
            Name = _newName,
            NameEn = _newNameEn,
            SortOrder = sortOrder,
            IsActive = true,
        });
        await context.SaveChangesAsync();

        Snackbar.Add("เพิ่มหมวดหมู่เรียบร้อย", Severity.Success);
        _newCode = ""; _newName = ""; _newNameEn = null;
        await LoadAsync();
    }

    private async Task ToggleActiveAsync(Lms_CourseCategory category)
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var existing = await context.Lms_CourseCategories.FirstOrDefaultAsync(c => c.Id == category.Id && c.CompanyId == _companyId);
        if (existing is null) return;
        existing.IsActive = !existing.IsActive;
        await context.SaveChangesAsync();
        await LoadAsync();
    }
}
