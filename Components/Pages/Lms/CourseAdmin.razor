@page "/lms/courses"
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Lms
@using HRM.Services.Pay
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject PrivateFileStorage FileStorage
@inject LmsMandatoryTrainingService MandatoryTrainingSvc
@inject ISnackbar Snackbar
@attribute [Authorize(Policy = "Menu:LMS_ADMIN")]

<PageTitle>คลังหลักสูตร</PageTitle>

<MudPaper Class="pa-4 mb-4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.h5">คลังหลักสูตร (Course Catalog)</MudText>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="StartCreate">+ หลักสูตรใหม่</MudButton>
    </MudStack>

    @if (string.IsNullOrEmpty(_companyId))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">บัญชีของคุณยังไม่ได้ผูกกับบริษัทใดๆ</MudAlert>
        return;
    }

    <MudTable Items="_courses" Dense="true" Hover="true" Class="mt-4">
        <HeaderContent>
            <MudTh>รหัส</MudTh>
            <MudTh>ชื่อหลักสูตร</MudTh>
            <MudTh>รูปแบบ</MudTh>
            <MudTh>ชั่วโมง</MudTh>
            <MudTh>ต้องอนุมัติ</MudTh>
            <MudTh>เกณฑ์ผ่าน</MudTh>
            <MudTh>สถานะ</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Code</MudTd>
            <MudTd>@context.Title</MudTd>
            <MudTd>@DeliveryLabel(context.DeliveryType)</MudTd>
            <MudTd>@context.DurationHours</MudTd>
            <MudTd>@(context.RequiresApproval ? "ต้องอนุมัติ" : "ไม่ต้อง")</MudTd>
            <MudTd>@(context.PassingScorePercent is int p ? $"{p}%" : "ไม่มีแบบทดสอบ")</MudTd>
            <MudTd>@(context.IsActive ? "ใช้งาน" : "ปิดใช้งาน")</MudTd>
            <MudTd>
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => SelectAsync(context.Id))">แก้ไข</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Text" Href="@($"/lms/courses/{context.Id}/sessions")">รอบอบรม</MudButton>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText Typo="Typo.body2">ยังไม่มีหลักสูตร</MudText></NoRecordsContent>
    </MudTable>
</MudPaper>

@if (_showForm)
{
    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6">@(_editingId is null ? "สร้างหลักสูตรใหม่" : "แก้ไขหลักสูตร")</MudText>

        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-2">@_error</MudAlert>
        }

        <MudGrid Class="mt-2">
            <MudItem xs="12" sm="6">
                <MudSelect T="long?" @bind-Value="_form.CategoryId" Label="หมวดหมู่" Clearable="true">
                    @foreach (var cat in _categories)
                    {
                        <MudSelectItem T="long?" Value="cat.Id">@cat.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="_form.Code" Label="รหัสหลักสูตร" /></MudItem>
            <MudItem xs="12"><MudTextField @bind-Value="_form.Title" Label="ชื่อหลักสูตร" /></MudItem>
            <MudItem xs="12"><MudTextField @bind-Value="_form.Description" Label="คำอธิบาย" Lines="3" /></MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="CourseDeliveryType" @bind-Value="_form.DeliveryType" Label="รูปแบบการอบรม">
                    <MudSelectItem T="CourseDeliveryType" Value="CourseDeliveryType.Classroom">Classroom</MudSelectItem>
                    <MudSelectItem T="CourseDeliveryType" Value="CourseDeliveryType.Online">Online</MudSelectItem>
                    <MudSelectItem T="CourseDeliveryType" Value="CourseDeliveryType.Hybrid">Hybrid</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4"><MudNumericField T="decimal" @bind-Value="_form.DurationHours" Label="จำนวนชั่วโมง" Min="0" /></MudItem>
            <MudItem xs="12" sm="4"><MudTextField @bind-Value="_form.InstructorName" Label="วิทยากร (ถ้ามี)" /></MudItem>
            <MudItem xs="12" sm="6"><MudCheckBox T="bool" @bind-Value="_form.RequiresApproval" Label="ต้องอนุมัติก่อนลงทะเบียน" /></MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField T="int?" @bind-Value="_form.PassingScorePercent" Label="เกณฑ์ผ่านแบบทดสอบ (%) — ปล่อยว่าง = ไม่มีแบบทดสอบ" Min="0" Max="100" />
            </MudItem>
            <MudItem xs="12"><MudCheckBox T="bool" @bind-Value="_form.IsActive" Label="ใช้งาน" /></MudItem>
        </MudGrid>

        <MudStack Row="true" Spacing="2" Class="mt-3">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">บันทึก</MudButton>
            <MudButton Variant="Variant.Text" OnClick="@(() => _showForm = false)">ยกเลิก</MudButton>
        </MudStack>
    </MudPaper>

    @if (_editingId is long courseId)
    {
        <MudPaper Class="pa-4 mb-4">
            <MudText Typo="Typo.h6">เอกสารประกอบการสอน</MudText>
            <MudStack Spacing="0" Class="mt-2">
                @foreach (var f in _materials)
                {
                    <MudLink Href="@($"/lms/files/material/{f.id}")" Target="_blank">@f.files</MudLink>
                }
            </MudStack>
            <MudFileUpload T="IBrowserFile" FilesChanged="@(file => UploadMaterialAsync(courseId, file))" Class="mt-2">
                <ActivatorContent>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AttachFile">แนบเอกสาร</MudButton>
                </ActivatorContent>
            </MudFileUpload>
        </MudPaper>

        <MudPaper Class="pa-4 mb-4">
            <MudText Typo="Typo.h6">คำถามแบบทดสอบ (MCQ 4 ตัวเลือก)</MudText>
            <MudTable Items="_questions" Dense="true" Class="mt-2">
                <HeaderContent>
                    <MudTh>คำถาม</MudTh>
                    <MudTh>เฉลย</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.QuestionText</MudTd>
                    <MudTd>@context.CorrectChoice</MudTd>
                    <MudTd><MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => RemoveQuestionAsync(context.Id))" /></MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText Typo="Typo.body2">ยังไม่มีคำถาม</MudText></NoRecordsContent>
            </MudTable>

            <MudGrid Class="mt-3">
                <MudItem xs="12"><MudTextField @bind-Value="_newQ.QuestionText" Label="คำถาม" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField @bind-Value="_newQ.ChoiceA" Label="ตัวเลือก A" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField @bind-Value="_newQ.ChoiceB" Label="ตัวเลือก B" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField @bind-Value="_newQ.ChoiceC" Label="ตัวเลือก C" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField @bind-Value="_newQ.ChoiceD" Label="ตัวเลือก D" /></MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect T="string" @bind-Value="_newQ.CorrectChoice" Label="ข้อที่ถูกต้อง">
                        <MudSelectItem T="string" Value="@("A")">A</MudSelectItem>
                        <MudSelectItem T="string" Value="@("B")">B</MudSelectItem>
                        <MudSelectItem T="string" Value="@("C")">C</MudSelectItem>
                        <MudSelectItem T="string" Value="@("D")">D</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="8"><MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="AddQuestionAsync" Class="mt-2">เพิ่มคำถาม</MudButton></MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Class="pa-4 mb-4">
            <MudText Typo="Typo.h6">บังคับสำหรับ (Mandatory Training)</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                กำหนดว่าใครต้องเรียนหลักสูตรนี้โดยอัตโนมัติ — ตอนเริ่ม Onboarding หรือตอนได้รับมอบหมายตำแหน่งที่ตรงเงื่อนไข ระบบจะมอบหมายให้ทันที (แค่ติดตามว่าเรียนหรือยัง ไม่บังคับปิดกั้นการทำงานอื่น)
            </MudText>

            <MudTable Items="_requirements" Dense="true" Class="mt-2">
                <HeaderContent>
                    <MudTh>เงื่อนไข</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@(context.PositionName ?? "พนักงานใหม่ทุกคน (ทุกตำแหน่ง)")</MudTd>
                    <MudTd><MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => RemoveRequirementAsync(context.Requirement.Id))" /></MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText Typo="Typo.body2">หลักสูตรนี้ยังไม่ถูกตั้งเป็นบังคับสำหรับใคร</MudText></NoRecordsContent>
            </MudTable>

            <MudGrid Class="mt-3">
                <MudItem xs="12" sm="8">
                    <MudAutocomplete T="Pos_ExecType" Label="เฉพาะตำแหน่ง (ปล่อยว่าง = บังคับพนักงานใหม่ทุกคน)" Value="_newReqPosition" ValueChanged="@(p => _newReqPosition = p)"
                        SearchFunc="SearchPositionsAsync" ToStringFunc="@(p => p?.Name ?? "")" ResetValueOnEmptyText="true" Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="4"><MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="AddRequirementAsync" Class="mt-2">เพิ่มเงื่อนไข</MudButton></MudItem>
            </MudGrid>
        </MudPaper>
    }
}

@code {
    private string? _companyId;
    private long _actorUserId;
    private List<Lms_Course> _courses = new();
    private List<Lms_CourseCategory> _categories = new();
    private List<doc_center> _materials = new();
    private List<Lms_QuizQuestion> _questions = new();
    private List<LmsMandatoryTrainingService.RequirementRow> _requirements = new();
    private Pos_ExecType? _newReqPosition;
    private bool _showForm;
    private long? _editingId;
    private string? _error;
    private Lms_Course _form = new() { DeliveryType = CourseDeliveryType.Classroom, IsActive = true };
    private Lms_QuizQuestion _newQ = new() { CorrectChoice = "A" };

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
        _actorUserId = long.Parse(state.User.FindFirst("sc_userid")?.Value ?? "0");
        if (string.IsNullOrWhiteSpace(_companyId)) return;

        await using var context = await DbFactory.CreateDbContextAsync();
        _categories = await context.Lms_CourseCategories.Where(c => c.CompanyId == _companyId && c.IsActive).ToListAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        _courses = await context.Lms_Courses.Where(c => c.CompanyId == _companyId).OrderBy(c => c.Title).ToListAsync();
    }

    private void StartCreate()
    {
        _editingId = null;
        _form = new() { CompanyId = _companyId!, DeliveryType = CourseDeliveryType.Classroom, IsActive = true };
        _materials = new(); _questions = new(); _requirements = new();
        _showForm = true;
        _error = null;
    }

    private async Task SelectAsync(long id)
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var course = await context.Lms_Courses.FirstOrDefaultAsync(c => c.Id == id && c.CompanyId == _companyId);
        if (course is null) return;

        _editingId = id;
        _form = course;
        _materials = await context.doc_centers.Where(d => d.doctypecode == "LMS_MATERIAL" && d.refid == id && d.isActive == true).ToListAsync();
        _questions = await context.Lms_QuizQuestions.Where(q => q.CourseId == id && q.IsActive).OrderBy(q => q.SortOrder).ToListAsync();
        await LoadRequirementsAsync();
        _showForm = true;
        _error = null;
    }

    private async Task LoadRequirementsAsync()
    {
        if (_editingId is not long courseId) return;
        var all = await MandatoryTrainingSvc.GetRequirementsAsync(_companyId!);
        _requirements = all.Where(r => r.Requirement.CourseId == courseId).ToList();
    }

    private async Task<IEnumerable<Pos_ExecType>> SearchPositionsAsync(string term, CancellationToken ct)
    {
        await using var context = await DbFactory.CreateDbContextAsync(ct);
        var query = context.Pos_ExecTypes.Where(p => p.CompanyId == _companyId && p.IsActive);
        if (!string.IsNullOrWhiteSpace(term))
            query = query.Where(p => p.Name.Contains(term));
        return await query.OrderBy(p => p.Name).Take(20).ToListAsync(ct);
    }

    private async Task AddRequirementAsync()
    {
        if (_editingId is not long courseId) return;
        try
        {
            await MandatoryTrainingSvc.AddRequirementAsync(_companyId!, courseId, _newReqPosition?.Id, _actorUserId);
            _newReqPosition = null;
            await LoadRequirementsAsync();
            Snackbar.Add("เพิ่มเงื่อนไขบังคับเรียนเรียบร้อย", Severity.Success);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
    }

    private async Task RemoveRequirementAsync(long requirementId)
    {
        await MandatoryTrainingSvc.RemoveRequirementAsync(requirementId);
        await LoadRequirementsAsync();
    }

    private async Task SaveAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_form.Code) || string.IsNullOrWhiteSpace(_form.Title))
        {
            _error = "กรุณากรอกรหัสและชื่อหลักสูตร";
            return;
        }

        await using var context = await DbFactory.CreateDbContextAsync();
        if (_editingId is long id)
        {
            var existing = await context.Lms_Courses.FirstOrDefaultAsync(c => c.Id == id && c.CompanyId == _companyId);
            if (existing is null) return;
            existing.CategoryId = _form.CategoryId;
            existing.Code = _form.Code;
            existing.Title = _form.Title;
            existing.Description = _form.Description;
            existing.DeliveryType = _form.DeliveryType;
            existing.DurationHours = _form.DurationHours;
            existing.InstructorName = _form.InstructorName;
            existing.RequiresApproval = _form.RequiresApproval;
            existing.PassingScorePercent = _form.PassingScorePercent;
            existing.IsActive = _form.IsActive;
        }
        else
        {
            _form.CompanyId = _companyId!;
            context.Lms_Courses.Add(_form);
        }
        await context.SaveChangesAsync();

        Snackbar.Add("บันทึกหลักสูตรเรียบร้อย", Severity.Success);
        _editingId ??= _form.Id;
        await LoadAsync();
    }

    private async Task UploadMaterialAsync(long courseId, IBrowserFile file)
    {
        const long maxSize = 20 * 1024 * 1024;
        await using var stream = file.OpenReadStream(maxSize);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        var bytes = ms.ToArray();

        var storedFileName = $"{courseId}_{Guid.NewGuid():N}_{file.Name}";
        var (relativePath, _) = await FileStorage.SaveAsync("lms-materials", storedFileName, bytes);

        await using var context = await DbFactory.CreateDbContextAsync();
        context.doc_centers.Add(new doc_center
        {
            refid = courseId,
            doctypecode = "LMS_MATERIAL",
            files = file.Name,
            path = relativePath,
            isActive = true,
            moddate = DateTime.Now,
        });
        await context.SaveChangesAsync();

        _materials = await context.doc_centers.Where(d => d.doctypecode == "LMS_MATERIAL" && d.refid == courseId && d.isActive == true).ToListAsync();
        Snackbar.Add("แนบเอกสารเรียบร้อย", Severity.Success);
    }

    private async Task AddQuestionAsync()
    {
        if (_editingId is not long courseId) return;
        if (string.IsNullOrWhiteSpace(_newQ.QuestionText) || string.IsNullOrWhiteSpace(_newQ.ChoiceA)
            || string.IsNullOrWhiteSpace(_newQ.ChoiceB) || string.IsNullOrWhiteSpace(_newQ.ChoiceC) || string.IsNullOrWhiteSpace(_newQ.ChoiceD))
        {
            Snackbar.Add("กรุณากรอกคำถามและตัวเลือกให้ครบ", Severity.Warning);
            return;
        }

        await using var context = await DbFactory.CreateDbContextAsync();
        var sortOrder = await context.Lms_QuizQuestions.CountAsync(q => q.CourseId == courseId && q.IsActive);
        context.Lms_QuizQuestions.Add(new Lms_QuizQuestion
        {
            CourseId = courseId,
            QuestionText = _newQ.QuestionText,
            ChoiceA = _newQ.ChoiceA,
            ChoiceB = _newQ.ChoiceB,
            ChoiceC = _newQ.ChoiceC,
            ChoiceD = _newQ.ChoiceD,
            CorrectChoice = _newQ.CorrectChoice,
            SortOrder = sortOrder,
        });
        await context.SaveChangesAsync();

        _questions = await context.Lms_QuizQuestions.Where(q => q.CourseId == courseId && q.IsActive).OrderBy(q => q.SortOrder).ToListAsync();
        _newQ = new() { CorrectChoice = "A" };
    }

    private async Task RemoveQuestionAsync(long questionId)
    {
        if (_editingId is not long courseId) return;
        await using var context = await DbFactory.CreateDbContextAsync();
        var q = await context.Lms_QuizQuestions.FirstOrDefaultAsync(x => x.Id == questionId);
        if (q is null) return;
        q.IsActive = false;
        await context.SaveChangesAsync();
        _questions = await context.Lms_QuizQuestions.Where(x => x.CourseId == courseId && x.IsActive).OrderBy(x => x.SortOrder).ToListAsync();
    }

    private static string DeliveryLabel(CourseDeliveryType t) => t switch
    {
        CourseDeliveryType.Classroom => "Classroom",
        CourseDeliveryType.Online => "Online",
        CourseDeliveryType.Hybrid => "Hybrid",
        _ => t.ToString(),
    };
}
