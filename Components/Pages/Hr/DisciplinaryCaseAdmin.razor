@page "/hr/disciplinary"
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Hr
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject DisciplinaryActionService CaseService
@inject NavigationManager Nav
@attribute [Authorize(Policy = "Menu:HR_DISCIPLINE_ADMIN")]

<PageTitle>วินัยพนักงาน</PageTitle>

<MudPaper Class="pa-4 mb-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudText Typo="Typo.h5">วินัยพนักงาน (Disciplinary Actions)</MudText>
        <MudChip T="string" Size="Size.Small" Color="Color.Warning">PDPA</MudChip>
    </MudStack>

    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" OnClick="@(() => Nav.NavigateTo("/hr/disciplinary/new"))">
        เปิดกรณีใหม่
    </MudButton>

    <MudTable Items="_cases" Dense="true" Hover="true" Class="mt-4">
        <HeaderContent>
            <MudTh>เลขที่</MudTh>
            <MudTh>พนักงาน</MudTh>
            <MudTh>วันที่เกิดเหตุ</MudTh>
            <MudTh>ประเภท</MudTh>
            <MudTh>สถานะ</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>#@context.Id</MudTd>
            <MudTd>@(_employeeNames.GetValueOrDefault(context.HremployeeId, context.EmpNo ?? "-"))</MudTd>
            <MudTd>@context.IncidentDate.ToString("dd/MM/yyyy")</MudTd>
            <MudTd>@DisciplinaryActionService.ActionTypeLabel(context.ActionType)</MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Color="@StatusColor(_statuses.GetValueOrDefault(context.Id, "-"))">
                    @StatusLabel(_statuses.GetValueOrDefault(context.Id, "-"))
                </MudChip>
            </MudTd>
            <MudTd>
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => Nav.NavigateTo($"/hr/disciplinary/{context.Id}"))">ดูรายละเอียด</MudButton>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>ยังไม่มีกรณีวินัย</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private List<Hr_DisciplinaryCase> _cases = new();
    private Dictionary<long, string> _statuses = new();
    private Dictionary<long, string> _employeeNames = new();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        var companyId = state.User.FindFirstValue("payroll_company");
        if (string.IsNullOrWhiteSpace(companyId)) return;

        _cases = await CaseService.GetCasesAsync(companyId);
        _statuses = await CaseService.GetJobStatusesAsync(_cases.Select(c => c.Id));

        await using var context = await DbFactory.CreateDbContextAsync();
        var empIds = _cases.Select(c => c.HremployeeId).Distinct().ToList();
        _employeeNames = await context.Hremployee.Where(e => empIds.Contains(e.id))
            .ToDictionaryAsync(e => e.id, e => $"{e.EmpName} {e.EmpSurname} ({e.EmpNo})");
    }

    private static string StatusLabel(string status) => status switch
    {
        "-" => "ร่าง",
        "COMPLETED" => "อนุมัติแล้ว",
        "REJECTED" or "RETURNED" => "ไม่อนุมัติ",
        _ => "รออนุมัติ",
    };

    private static Color StatusColor(string status) => status switch
    {
        "-" => Color.Default,
        "COMPLETED" => Color.Success,
        "REJECTED" or "RETURNED" => Color.Error,
        _ => Color.Warning,
    };
}
