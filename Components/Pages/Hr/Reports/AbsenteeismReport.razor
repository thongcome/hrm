@page "/hr/reports/absenteeism"
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Att
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@inject AbsenteeismReportService ReportService
@inject AuthenticationStateProvider AuthProvider
@attribute [Authorize(Policy = "Menu:HR_ANALYTICS")]

<PageTitle>รายงานการขาดงาน (Absenteeism)</PageTitle>

<MudPaper Class="pa-4 mb-4">
    <MudText Typo="Typo.h5">รายงานการขาดงาน (Absenteeism)</MudText>

    @if (string.IsNullOrEmpty(_companyId))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">บัญชีของคุณยังไม่ได้ผูกกับบริษัทใดๆ — ติดต่อแอดมินให้ตั้งค่า empid ก่อน</MudAlert>
        return;
    }

    <MudAlert Severity="Severity.Info" Class="mt-3">
        "ขาดงาน" นับเฉพาะวันทำงานที่คาดว่าพนักงานต้องมา (ไม่ใช่วันหยุดบริษัท) แล้วไม่มีการสแกน/บันทึกเวลาเลย และไม่มีใบลาที่อนุมัติแล้วคลุมวันนั้น —
        ถ้าบริษัทตั้งค่าเป็นโหมด "รายกะ (Shift-based)" จะนับเฉพาะวันที่มีการมอบหมายกะจริง แต่ถ้าเป็นโหมด "เข้า-ออกอย่างเดียว (Simple In/Out)"
        ระบบยังไม่มีการตั้งค่าวันทำงานต่อสัปดาห์ของบริษัท จึงใช้ค่าคงที่ จันทร์-ศุกร์ เป็นวันทำงานที่คาดหวังเสมอ (อาจไม่ตรงกับบริษัทที่ทำงานวันเสาร์ด้วย)
    </MudAlert>

    <MudGrid Class="mt-3">
        <MudItem xs="12" sm="3">
            <MudDatePicker Label="จากวันที่" Date="@_fromDate.ToDateTime(TimeOnly.MinValue)" DateChanged="@(d => _fromDate = d.HasValue ? DateOnly.FromDateTime(d.Value) : _fromDate)" />
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudDatePicker Label="ถึงวันที่" Date="@_toDate.ToDateTime(TimeOnly.MinValue)" DateChanged="@(d => _toDate = d.HasValue ? DateOnly.FromDateTime(d.Value) : _toDate)" />
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="LoadAsync" Class="mt-2">โหลดข้อมูล</MudButton>
        </MudItem>
    </MudGrid>

    @if (_loaded && _summary is null)
    {
        <MudAlert Severity="Severity.Warning" Class="mt-4">บริษัทนี้ยังไม่ได้เปิดใช้งานระบบบันทึกเวลาเข้างาน (Time Attendance) จึงไม่มีข้อมูลให้คำนวณ</MudAlert>
    }
    else if (_summary is not null)
    {
        <MudGrid Class="mt-4">
            <MudItem xs="12" sm="4">
                <MudPaper Class="pa-3" Outlined="true"><MudText Typo="Typo.h4">@_summary.AbsenteeismRatePercent.ToString("N2")%</MudText><MudText Typo="Typo.caption">อัตราการขาดงาน</MudText></MudPaper>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudPaper Class="pa-3" Outlined="true"><MudText Typo="Typo.h4">@_summary.AbsentDayCount</MudText><MudText Typo="Typo.caption">วัน-คน ที่ขาดงาน</MudText></MudPaper>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudPaper Class="pa-3" Outlined="true"><MudText Typo="Typo.h4">@_summary.ExpectedWorkDayCount</MudText><MudText Typo="Typo.caption">วัน-คน ที่คาดว่าต้องมาทำงาน</MudText></MudPaper>
            </MudItem>
        </MudGrid>

        @if (_summary.DailyTrend.Count > 0)
        {
            <MudChart ChartType="ChartType.Line" ChartSeries="@_series" XAxisLabels="@_labels" Width="100%" Height="300px" Class="mt-4" />
        }

        <MudText Typo="Typo.h6" Class="mt-6">พนักงานที่ขาดงานมากที่สุด (10 อันดับ)</MudText>
        @if (_summary.TopAbsentees.Count > 0)
        {
            <MudSimpleTable Dense="true" Class="mt-2">
                <thead><tr><th>รหัสพนักงาน</th><th>ชื่อ</th><th>จำนวนวันที่ขาด</th></tr></thead>
                <tbody>
                    @foreach (var a in _summary.TopAbsentees)
                    {
                        <tr><td>@a.EmpNo</td><td>@a.EmpName</td><td>@a.AbsentDays</td></tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mt-2" Style="opacity:.7;">ไม่พบวันขาดงานในช่วงที่เลือก</MudText>
        }
    }
</MudPaper>

@code {
    private string? _companyId;
    private DateOnly _fromDate = new DateOnly(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateOnly _toDate = DateOnly.FromDateTime(DateTime.Today);
    private bool _loaded;

    private AbsenteeismReportService.AbsenteeismSummary? _summary;
    private List<ChartSeries> _series = new();
    private string[] _labels = Array.Empty<string>();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");
        if (string.IsNullOrWhiteSpace(_companyId)) return;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (string.IsNullOrWhiteSpace(_companyId)) return;
        if (_toDate < _fromDate) return;

        _summary = await ReportService.GetSummaryAsync(_companyId, _fromDate, _toDate);

        if (_summary is not null)
        {
            _labels = _summary.DailyTrend.Select(d => d.Date.ToString("dd/MM")).ToArray();
            _series = new List<ChartSeries>
            {
                new ChartSeries { Name = "จำนวนคนขาดงาน", Data = _summary.DailyTrend.Select(d => (double)d.AbsentCount).ToArray() },
            };
        }

        _loaded = true;
    }
}
