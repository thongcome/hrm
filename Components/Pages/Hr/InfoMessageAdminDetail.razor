@page "/hr/announcements/admin/{Id:long}"
@using System.Security.Claims
@using HRM.Models
@using HRM.Services.Hr
@using HRM.Services.Pay
@using HRM.Services.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<HRMContext> DbFactory
@inject InfoMessageService InfoService
@inject PrivateFileStorage FileStorage
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@attribute [Authorize(Policy = "Menu:HR_ANNOUNCE_ADMIN")]

<PageTitle>@(Id == 0 ? "เพิ่มประกาศใหม่" : "แก้ไขประกาศ")</PageTitle>

<MudPaper Class="pa-4 mb-4">
    <MudText Typo="Typo.h5">@(Id == 0 ? "เพิ่มประกาศใหม่" : "แก้ไขประกาศ")</MudText>

    @if (!_loaded)
    {
        <MudProgressCircular Indeterminate="true" Class="mt-4" />
        return;
    }

    @if (!string.IsNullOrEmpty(_error))
    {
        <MudAlert Severity="Severity.Warning" Class="mt-4">@_error</MudAlert>
    }

    <MudGrid Class="mt-2">
        <MudItem xs="12" sm="8">
            <MudTextField @bind-Value="_message.subject" Label="หัวข้อประกาศ" Required="true" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudSelect T="InfoMessagePriority" @bind-Value="_message.PriorityLevel" Label="ระดับความสำคัญ">
                <MudSelectItem Value="InfoMessagePriority.Normal">ทั่วไป</MudSelectItem>
                <MudSelectItem Value="InfoMessagePriority.Important">สำคัญ</MudSelectItem>
                <MudSelectItem Value="InfoMessagePriority.Urgent">ด่วนมาก</MudSelectItem>
            </MudSelect>
        </MudItem>

        <MudItem xs="12">
            <MudTextField @bind-Value="_message.message" Label="เนื้อหาประกาศ" Lines="8" />
        </MudItem>

        <MudItem xs="12" sm="4">
            <MudDatePicker Label="วันเริ่มแสดง" Date="@(_message.startdate?.ToDateTime(TimeOnly.MinValue))"
                DateChanged="@(d => _message.startdate = d.HasValue ? DateOnly.FromDateTime(d.Value) : null)" Clearable="true" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudDatePicker Label="วันสิ้นสุดการแสดง" Date="@(_message.enddate?.ToDateTime(TimeOnly.MinValue))"
                DateChanged="@(d => _message.enddate = d.HasValue ? DateOnly.FromDateTime(d.Value) : null)" Clearable="true" />
        </MudItem>
        <MudItem xs="12" sm="4" Class="d-flex align-center">
            <MudStack>
                <MudCheckBox T="bool" Value="@(_message.isactive ?? true)" ValueChanged="@(v => _message.isactive = v)" Label="ใช้งาน (ปิดเพื่อระงับชั่วคราว)" />
                <MudCheckBox @bind-Value="_message.IsPinned" Label="ปักหมุดที่หน้า Home" />
                <MudCheckBox @bind-Value="_message.IsPublicAnonymous" Label="เผยแพร่ก่อน login (สาธารณะ)" Color="Color.Warning" />
            </MudStack>
        </MudItem>
        @if (_message.IsPublicAnonymous)
        {
            <MudItem xs="12">
                <MudAlert Severity="Severity.Warning" Dense="true">
                    ประกาศนี้ (และไฟล์แนบ) จะแสดงให้ใครก็ได้เห็นบนอินเทอร์เน็ต โดยไม่ต้อง login — อย่าใส่ข้อมูลภายในหรือข้อมูลส่วนบุคคล
                </MudAlert>
            </MudItem>
        }

        <MudItem xs="12">
            <MudDivider Class="my-2" />
            <MudText Typo="Typo.subtitle1">ผู้รับประกาศ</MudText>
            <MudText Typo="Typo.body2" Class="mb-2" Style="opacity:.7;">ไม่เลือกอะไรเลย = เห็นได้ทุกคนโดยอัตโนมัติ หรือจะเลือก "ทั้งหมด" / หน่วยงาน (รวมหน่วยงานย่อย) / รายบุคคล ผสมกันได้หลายรายการ</MudText>

            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-2">
                <MudSelect T="InfoMessageTargetType" @bind-Value="_newTargetType" Label="เพิ่มผู้รับ" Style="min-width:180px;">
                    <MudSelectItem Value="InfoMessageTargetType.All">ทั้งหมด</MudSelectItem>
                    <MudSelectItem Value="InfoMessageTargetType.Organization">หน่วยงาน</MudSelectItem>
                    <MudSelectItem Value="InfoMessageTargetType.Employee">รายบุคคล</MudSelectItem>
                </MudSelect>

                @if (_newTargetType == InfoMessageTargetType.Organization)
                {
                    <MudAutocomplete T="com_organization" Label="หน่วยงาน" Value="_newTargetOrg" ValueChanged="v => _newTargetOrg = v"
                        SearchFunc="SearchOrganizationsAsync" ToStringFunc="@(o => o == null ? null : $"{o.code} — {o.name}")"
                        ResetValueOnEmptyText="true" CoerceText="true" MinCharacters="0" Style="min-width:260px;" />
                }
                else if (_newTargetType == InfoMessageTargetType.Employee)
                {
                    <MudAutocomplete T="Hremployee" Label="พนักงาน (รหัสหรือชื่อ)" Value="_newTargetEmployee" ValueChanged="v => _newTargetEmployee = v"
                        SearchFunc="SearchEmployeesAsync" ToStringFunc="@(e => e == null ? null : $"{e.EmpNo} — {e.EmpName} {e.EmpSurname}")"
                        ResetValueOnEmptyText="true" CoerceText="true" MinCharacters="0" Style="min-width:260px;" />
                }

                <MudButton Variant="Variant.Outlined" OnClick="AddTarget">เพิ่ม</MudButton>
            </MudStack>

            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
                @foreach (var t in _targets)
                {
                    <MudChip T="string" OnClose="@(() => _targets.Remove(t))">@TargetLabel(t)</MudChip>
                }
            </MudStack>
        </MudItem>

        <MudItem xs="12">
            <MudDivider Class="my-2" />
            <MudText Typo="Typo.subtitle1">ไฟล์แนบ</MudText>
            <MudStack Spacing="1" Class="mb-2">
                @foreach (var f in _attachments)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudLink Href="@($"/hr/files/announcement/{f.id}")" Target="_blank">@f.files</MudLink>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="@(() => RemoveAttachmentAsync(f.id))" />
                    </MudStack>
                }
            </MudStack>
            <MudFileUpload T="IReadOnlyList<IBrowserFile>" FilesChanged="UploadAttachmentsAsync" MaximumFileCount="10">
                <ActivatorContent>
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AttachFile">แนบไฟล์ (เลือกได้หลายไฟล์)</MudButton>
                </ActivatorContent>
            </MudFileUpload>
        </MudItem>

        @if (Id != 0 && _stats is not null)
        {
            <MudItem xs="12">
                <MudDivider Class="my-2" />
                <MudText Typo="Typo.subtitle1">สถิติการอ่าน</MudText>
                <MudStack Row="true" Spacing="4" Class="mt-1">
                    <MudText Typo="Typo.body2">กลุ่มเป้าหมาย: @_stats.TargetEmployeeCount คน</MudText>
                    <MudText Typo="Typo.body2">อ่านแล้ว: @_stats.ViewedCount คน</MudText>
                    <MudText Typo="Typo.body2">ดาวน์โหลดไฟล์แนบรวม: @_stats.DownloadedCount ครั้ง</MudText>
                </MudStack>
                @if (_stats.NotYetViewed.Count > 0)
                {
                    <MudText Typo="Typo.body2" Class="mt-2" Style="opacity:.7;">ยังไม่อ่าน (@_stats.NotYetViewed.Count คน): @string.Join(", ", _stats.NotYetViewed.Take(15).Select(e => $"{e.EmpNo}"))@(_stats.NotYetViewed.Count > 15 ? " ..." : "")</MudText>
                }
            </MudItem>
        }

        <MudItem xs="12" Class="mt-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">บันทึก</MudButton>
            <MudButton Variant="Variant.Text" Href="/hr/announcements/admin" Class="ml-2">กลับ</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@code {
    [Parameter] public long Id { get; set; }

    private bool _loaded;
    private string? _error;
    private string? _companyId;
    private info_message _message = new();
    private List<Info_MessageTarget> _targets = new();
    private List<doc_center> _attachments = new();
    private InfoMessageService.ReadStats? _stats;

    private InfoMessageTargetType _newTargetType = InfoMessageTargetType.All;
    private com_organization? _newTargetOrg;
    private Hremployee? _newTargetEmployee;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _companyId = state.User.FindFirstValue("payroll_company");

        if (Id == 0)
        {
            _message = new info_message { CompanyId = _companyId ?? "001", isactive = true };
            _loaded = true;
            return;
        }

        await using var context = await DbFactory.CreateDbContextAsync();
        var existing = await context.info_messages.FirstOrDefaultAsync(m => m.Id == Id);
        if (existing is null)
        {
            _error = "ไม่พบประกาศนี้แล้ว";
            _loaded = true;
            return;
        }
        _message = existing;
        _targets = await context.Info_MessageTargets.Where(t => t.InfoMessageId == Id).ToListAsync();
        await EnrichTargetLabelsAsync(context, _targets);
        _attachments = await InfoService.GetAttachmentsAsync(Id);
        _stats = await InfoService.GetReadStatsAsync(Id);
        _loaded = true;
    }

    private static async Task EnrichTargetLabelsAsync(HRMContext context, List<Info_MessageTarget> targets)
    {
        var orgIds = targets.Where(t => t.TargetOrganizationId != null).Select(t => t.TargetOrganizationId!.Value).Distinct().ToList();
        var empIds = targets.Where(t => t.TargetHremployeeId != null).Select(t => t.TargetHremployeeId!.Value).Distinct().ToList();

        var orgsById = orgIds.Count == 0 ? new() : (await context.com_organizations.Where(o => orgIds.Contains(o.id)).ToListAsync()).ToDictionary(o => o.id);
        var empsById = empIds.Count == 0 ? new() : (await context.Hremployee.Where(e => empIds.Contains(e.id)).ToListAsync()).ToDictionary(e => e.id);

        foreach (var t in targets)
        {
            if (t.TargetOrganizationId is long orgId && orgsById.TryGetValue(orgId, out var org))
                t.TargetOrgCache = $"{org.code} — {org.name}";
            else if (t.TargetHremployeeId is long empId && empsById.TryGetValue(empId, out var emp))
                t.TargetEmpCache = $"{emp.EmpNo} — {emp.EmpName} {emp.EmpSurname}";
        }
    }

    private void AddTarget()
    {
        switch (_newTargetType)
        {
            case InfoMessageTargetType.All:
                if (_targets.Any(t => t.TargetType == InfoMessageTargetType.All)) return;
                _targets.Add(new Info_MessageTarget { TargetType = InfoMessageTargetType.All });
                break;
            case InfoMessageTargetType.Organization:
                if (_newTargetOrg is null) { _error = "กรุณาเลือกหน่วยงาน"; return; }
                if (_targets.Any(t => t.TargetType == InfoMessageTargetType.Organization && t.TargetOrganizationId == _newTargetOrg.id)) return;
                _targets.Add(new Info_MessageTarget { TargetType = InfoMessageTargetType.Organization, TargetOrganizationId = _newTargetOrg.id, TargetOrgCache = $"{_newTargetOrg.code} — {_newTargetOrg.name}" });
                _newTargetOrg = null;
                break;
            case InfoMessageTargetType.Employee:
                if (_newTargetEmployee is null) { _error = "กรุณาเลือกพนักงาน"; return; }
                if (_targets.Any(t => t.TargetType == InfoMessageTargetType.Employee && t.TargetHremployeeId == _newTargetEmployee.id)) return;
                _targets.Add(new Info_MessageTarget { TargetType = InfoMessageTargetType.Employee, TargetHremployeeId = _newTargetEmployee.id, TargetEmpCache = $"{_newTargetEmployee.EmpNo} — {_newTargetEmployee.EmpName} {_newTargetEmployee.EmpSurname}" });
                _newTargetEmployee = null;
                break;
        }
        _error = null;
    }

    private static string TargetLabel(Info_MessageTarget t) => t.TargetType switch
    {
        InfoMessageTargetType.All => "ทั้งหมด",
        InfoMessageTargetType.Organization => t.TargetOrgCache ?? $"หน่วยงาน #{t.TargetOrganizationId}",
        InfoMessageTargetType.Employee => t.TargetEmpCache ?? $"พนักงาน #{t.TargetHremployeeId}",
        _ => "-",
    };

    private async Task<IEnumerable<com_organization>> SearchOrganizationsAsync(string search, CancellationToken ct)
    {
        await using var context = await DbFactory.CreateDbContextAsync(ct);
        var query = context.com_organizations.Where(o => o.isActive);
        query = EntitySearchHelper.ApplyTextSearch(query, search, nameof(com_organization.code), nameof(com_organization.name));
        return await query.OrderBy(o => o.code).Take(20).ToListAsync(ct);
    }

    private async Task<IEnumerable<Hremployee>> SearchEmployeesAsync(string search, CancellationToken ct)
    {
        await using var context = await DbFactory.CreateDbContextAsync(ct);
        var query = context.Hremployee.Where(e => e.companyid == _companyId && e.ResignDate == null);
        if (!string.IsNullOrWhiteSpace(search))
        {
            query = query.Where(e => e.EmpNo.Contains(search)
                || (e.EmpName != null && e.EmpName.Contains(search))
                || (e.EmpSurname != null && e.EmpSurname.Contains(search)));
        }
        return await query.OrderBy(e => e.EmpNo).Take(20).ToListAsync(ct);
    }

    private async Task UploadAttachmentsAsync(IReadOnlyList<IBrowserFile> files)
    {
        if (Id == 0)
        {
            _error = "กรุณาบันทึกประกาศก่อน แล้วค่อยแนบไฟล์";
            return;
        }
        const long maxSize = 10 * 1024 * 1024;
        foreach (var file in files)
        {
            await using var stream = file.OpenReadStream(maxSize);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var bytes = ms.ToArray();

            var storedFileName = $"{Id}_{Guid.NewGuid():N}_{file.Name}";
            var (relativePath, _) = await FileStorage.SaveAsync("hr-announcements", storedFileName, bytes);
            await InfoService.AddAttachmentAsync(Id, file.Name, relativePath);
        }
        _attachments = await InfoService.GetAttachmentsAsync(Id);
        Snackbar.Add("แนบไฟล์แล้ว", Severity.Success);
    }

    private async Task RemoveAttachmentAsync(long docCenterId)
    {
        await InfoService.RemoveAttachmentAsync(docCenterId);
        _attachments = await InfoService.GetAttachmentsAsync(Id);
    }

    private async Task SaveAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_message.subject))
        {
            _error = "กรุณากรอกหัวข้อประกาศ";
            return;
        }

        var state = await AuthProvider.GetAuthenticationStateAsync();
        var actorUserId = long.TryParse(state.User.FindFirstValue("sc_userid"), out var uid) ? uid : 0;
        _message.CompanyId = _companyId ?? _message.CompanyId;

        var saved = await InfoService.SaveAsync(_message, _targets, actorUserId);
        Snackbar.Add("บันทึกประกาศแล้ว", Severity.Success);

        if (Id == 0)
        {
            Nav.NavigateTo($"/hr/announcements/admin/{saved.Id}", replace: true);
        }
        else
        {
            _attachments = await InfoService.GetAttachmentsAsync(Id);
            _stats = await InfoService.GetReadStatsAsync(Id);
        }
    }
}
