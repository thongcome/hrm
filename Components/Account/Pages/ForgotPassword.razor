@page "/Account/ForgotPassword"

@using System.ComponentModel.DataAnnotations
@using System.Text
@using System.Text.Encodings.Web
@using HRM.Services
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Identity.UI.Services
@using Microsoft.AspNetCore.WebUtilities
@using HRM.Data
@using Microsoft.Extensions.Logging

@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
@inject IEmailSender EmailSender

<PageTitle>Forgot your password?</PageTitle>

<h1>Forgot your password?</h1>
<h2>Enter your email.</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        @if (!string.IsNullOrEmpty(EmailStatusMessage))
        {
            <div class="alert alert-@EmailStatusMessageClass" role="alert">
                <strong>@EmailStatusMessage</strong>
            </div>
        }

        <EditForm Model="Input" FormName="forgot-password" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />

            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <label for="email" class="form-label">Email</label>
                <ValidationMessage For="() => Input.Email" class="text-danger" />
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Reset password</button>
          
        </EditForm>
       @*  <button id="resendConfirm" type="button" class="btn btn-danger btn-sm mt-3" @onclick="ResendConfirmationEmail">Resend Confirmation Email</button>
        <button id="resendConfirm" type="button" class="btn btn-danger btn-sm mt-3" @onclick="TestClick">Test Click</button>
 *@
@* 
        <button type="button" class="btn btn-danger btn-sm mt-3" @onclick="ResendConfirmationEmail">Resend Confirmation Email</button>
        <button type="button" class="btn btn-secondary btn-sm mt-3" @onclick="TestClick">Test Click</button>
        <a href="/Account/ResendConfirmation">Resend Confirmation Email</a>
 *@
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    private string? EmailStatusMessage { get; set; }
    private string EmailStatusMessageClass { get; set; } = "info"; // Bootstrap alert class (e.g., success, danger)

    private async Task OnValidSubmitAsync()
    {
        try
        {
            var user = await UserManager.FindByEmailAsync(Input.Email);
            if (user is null)
            {
                EmailStatusMessage = "Email not existing / ไม่พบอีเมล์นี้";
                EmailStatusMessageClass = "info";
                return;
            }

            if (!await UserManager.IsEmailConfirmedAsync(user))
            {
                EmailStatusMessage = "You have not confirmed your email. Please confirm it from your inbox.";
                EmailStatusMessageClass = "info";
                return;
            }

            var code = await UserManager.GeneratePasswordResetTokenAsync(user);
            code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));

            var callbackUrl = NavigationManager.GetUriWithQueryParameters(
                NavigationManager.ToAbsoluteUri("Account/ResetPassword").AbsoluteUri,
                new Dictionary<string, object?> { ["code"] = code });

            await EmailSender.SendEmailAsync(Input.Email, "Reset Password",
                $"Please reset your password by <a href='{HtmlEncoder.Default.Encode(callbackUrl)}'>clicking here</a>.");

            EmailStatusMessage = "A password reset link has been sent to your email.";
            EmailStatusMessageClass = "success";
        }
        catch (Exception ex)
        {
            EmailStatusMessage = "An error occurred while sending the email. Please try again.";
            EmailStatusMessageClass = "danger";
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

    private void TestClick()
    {
        Console.WriteLine("Button clicked!");
        EmailStatusMessage = "Button click confirmed!";
        EmailStatusMessageClass = "success";
    }
    private async Task ResendConfirmationEmail()
    {
        EmailStatusMessage = string.Empty;
        try
        {
            var user = await UserManager.FindByEmailAsync(Input.Email);
            if (user is null || await UserManager.IsEmailConfirmedAsync(user))
            {
                EmailStatusMessage = "This email is already confirmed or does not exist.";
                EmailStatusMessageClass = "info";
                return;
            }

            var code = await UserManager.GenerateEmailConfirmationTokenAsync(user);
            code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));
            var callbackUrl = NavigationManager.GetUriWithQueryParameters(
                NavigationManager.ToAbsoluteUri("/Account/ResendConfirmation").AbsoluteUri,
                new Dictionary<string, object?> { ["userId"] = await UserManager.GetUserIdAsync(user), ["code"] = code });

            await EmailSender.SendEmailAsync(Input.Email, "Confirm Your Email",
                $"Please confirm your account by <a href='{HtmlEncoder.Default.Encode(callbackUrl)}'>clicking here</a>.");

            EmailStatusMessage = "A confirmation email has been resent. Please check your inbox.";
            EmailStatusMessageClass = "success";
        }
        catch (Exception ex)
        {
            EmailStatusMessage = "An error occurred while resending the confirmation email. Please try again.";
            EmailStatusMessageClass = "danger";
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

  
    private sealed class InputModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = string.Empty;
    }
}
