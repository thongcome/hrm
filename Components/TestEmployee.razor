@page "/employee"
@using MudBlazor

<MudPaper Class="p-4">
    <MudText Typo="Typo.h5">รายชื่อพนักงาน</MudText>

    <MudTable Items="@employees">
        <HeaderContent>
            <MudTh>รหัส</MudTh>
            <MudTh>ชื่อ</MudTh>
            <MudTh>ตำแหน่ง</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="รหัส">@context.Id</MudTd>
            <MudTd DataLabel="ชื่อ">@context.Name</MudTd>
            <MudTd DataLabel="ตำแหน่ง">@context.Position</MudTd>
        </RowTemplate>
    </MudTable>
</MudPaper>


<MudButton Variant="Variant.Filled">Default</MudButton>
<MudButton Variant="Variant.Filled" Color="Color.Primary">Primary</MudButton>
<MudButton Variant="Variant.Filled" Color="Color.Secondary">Secondary</MudButton>
<MudButton Variant="Variant.Filled" Disabled="true">Disabled</MudButton>

<MudAvatar Color="Color.Primary">M</MudAvatar>
<MudAvatar Color="Color.Secondary">U</MudAvatar>
<MudAvatar Color="Color.Tertiary">D</MudAvatar>

<MudTreeView T="string" ReadOnly>
    <MudTreeViewItem Text="Getting Started">
        <MudTreeViewItem Text="Installation" />
    </MudTreeViewItem>
    <MudTreeViewItem Value='"Components"'>
        <MudTreeViewItem Text="Avatar" Value='"MudAvatar"' />
        <MudTreeViewItem Text="Button" Value='"MudButton"' />
    </MudTreeViewItem>
</MudTreeView>
@code {
    private List<Employee> employees = new()
    {
        new() { Id = 1, Name = "สมชาย", Position = "HR Manager" },
        new() { Id = 2, Name = "สมหญิง", Position = "Dev" },
        new() { Id = 3, Name = "เจน", Position = "Tester" }
    };

    public class Employee
    {
        public int Id { get; set; }
        public string? Name { get; set; }
        public string? Position { get; set; }
    }
}
