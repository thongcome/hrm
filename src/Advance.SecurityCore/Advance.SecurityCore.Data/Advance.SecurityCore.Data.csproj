      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Advance.SecurityCore.Domain\Advance.SecurityCore.Domain.csproj" />
  </ItemGroup>

</Project>
