<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Advance.SecurityCore.Domain</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- ApplicationUser : IdentityUser needs this; everything else here is
         plain EF-Core-attributed POCOs with no other package dependency. -->
    <PackageReference Include="Microsoft.Extensions.Identity.Stores" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
  </ItemGroup>

</Project>
