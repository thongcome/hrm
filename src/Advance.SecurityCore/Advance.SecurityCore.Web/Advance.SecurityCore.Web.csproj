<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Advance.SecurityCore.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Razor class library, but its code (LoginEndpoints, WebApplication
         extension methods, RateLimiter, minimal APIs) needs full ASP.NET
         Core hosting APIs, not just the Components subset Sdk.Razor implies
         on its own. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="10.0.0" />
    <PackageReference Include="MudBlazor" Version="8.14.0" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="System.DirectoryServices.Protocols" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Advance.SecurityCore.Domain\Advance.SecurityCore.Domain.csproj" />
    <ProjectReference Include="..\Advance.SecurityCore.Data\Advance.SecurityCore.Data.csproj" />
    <ProjectReference Include="..\Advance.SecurityCore.Services\Advance.SecurityCore.Services.csproj" />
  </ItemGroup>

</Project>
