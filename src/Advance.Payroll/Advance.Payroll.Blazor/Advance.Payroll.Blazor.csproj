<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    Razor Class Library — ported pages resolve MudBlazor/localization/etc. through the
    HOST app's DI (same requirement HRM.csproj already satisfies), per plan section 7's
    risk note: "หน้า Blazor ใน Razor Class Library — MudBlazor/Radzen/localization ต้องส่งผ่าน
    DI ของ host; ลองกับ Workflow (28 หน้า) ก่อนจึงรู้แนวทางสำหรับ Payroll (41 หน้า)".

    Phase 0 status: PayrollRunList.razor is ported here as the ONE proof-of-pattern page
    (adjusted to call Advance.Payroll.Engine services through the new interfaces instead of
    HRMContext). It is NOT expected to compile/run standalone — a Razor Class Library has
    no host to resolve MudBlazor's services, layout, or `_Imports.razor` conventions from;
    proving it actually renders requires wiring it into a host project (HRM itself, or a
    throwaway test host), which is out of scope for this prep-only worktree. See
    EXTRACTION-PLAN.md "Blazor page porting" for why only 1 of the planned 3-4 pages was
    ported given the time available, and the concrete plan for the rest.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Advance.Payroll.Blazor</RootNamespace>
    <AssemblyName>Advance.Payroll.Blazor</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" Version="8.14.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Advance.Payroll.Contracts\Advance.Payroll.Contracts.csproj" />
    <ProjectReference Include="..\Advance.Payroll.Engine\Advance.Payroll.Engine.csproj" />
  </ItemGroup>

</Project>
