<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The 7 seam interfaces from docs/Plan_Split_Payroll_Workflow_v1.1.md section 3
    (HRM.Adapters row) — everything Advance.Payroll.Engine needs from "the rest of HRM"
    (Hremployee, Att_DailyAttendance, HrwOt, Kptempreceive*, Wel_*/Pos_PositionSlot,
    Lve_CompanySetting/Lve_CompanyHoliday, wf_workflow/job_master) goes through one of
    these instead of a direct EF query. HRM implements all seven against its own tables;
    Advance.Payroll Lite (SaaS) implements them against its own data-entry screens /
    Excel import. No EF Core reference here on purpose — same reasoning as Core.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Advance.Payroll.Contracts</RootNamespace>
    <AssemblyName>Advance.Payroll.Contracts</AssemblyName>
  </PropertyGroup>

</Project>
