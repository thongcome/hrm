<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Advance.Host.Data</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned to the same major/minor EF Core version HRM.csproj already
         uses (Microsoft.EntityFrameworkCore.SqlServer 10.0.0) so a consuming
         product's Data project (PayrollDbContext, WorkflowDbContext) can sit
         on the same EF version without a conflict. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Advance.Host.Domain\Advance.Host.Domain.csproj" />
  </ItemGroup>

</Project>
