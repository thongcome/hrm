<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Domain is the bottom layer of the X.Domain / X.Data / X.Web shape
         (see D:\GitWorkspace\ADVANCE-ARCHITECTURE.md section 1/3): plain
         POCOs and interfaces only, zero package references, so both
         Advance.Payroll.Web and Advance.Workflow.Web (and their own
         Domain/Data/Web projects) can reference it without pulling in
         EF Core, ASP.NET, or anything else. -->
    <RootNamespace>Advance.Host.Domain</RootNamespace>
  </PropertyGroup>

</Project>
