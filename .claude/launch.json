{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "hrm-dev",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "watch",
        "run",
        "--launch-profile",
        "http",
        "--non-interactive"
      ],
      "port": 5052
    },
    {
      "name": "hrm-run",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--no-build",
        "-p:UseAppHost=false",
        "--launch-profile",
        "http"
      ],
      "port": 5052
    },
    {
      "name": "jobbecome-web",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "D:/GitWorkspace/JobBecome/src/JobBecome.Web",
        "--launch-profile",
        "http"
      ],
      "port": 5080
    },
    {
      "name": "jobbecome-web-5081",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "D:/GitWorkspace/JobBecome/src/JobBecome.Web",
        "--launch-profile",
        "http",
        "--urls",
        "http://localhost:5081"
      ],
      "port": 5081
    },
    {
      "name": "pis-legacy-reference",
      "port": 8011,
      "url": "http://localhost:8011"
    }
  ]
