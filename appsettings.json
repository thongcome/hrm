{
  // ConnectionStrings:DefaultConnection intentionally NOT stored here — it
  // contains a DB password. Local dev: `dotnet user-secrets set
  // "ConnectionStrings:DefaultConnection" "..."` (already set for this
  // project's UserSecretsId). Production/deployment: set the
  // ConnectionStrings__DefaultConnection environment variable (or a proper
  // secret store) — user secrets are Development-only and are NOT read
  // outside that environment.

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Mail.SmtpClient": "Trace"
    }
  },

  "profiles": {
    "IIS Express": {
      "environmentVariables": {
        //    "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_ENVIRONMENT": "Production"
      }
    }
  },

  // SmtpSettings:Password intentionally NOT stored here — see
  // ConnectionStrings comment above for the same reasoning (user secrets
  // locally, SmtpSettings__Password env var in production).
  "SmtpSettings": {
    "Host": "mail.selfleadedlearning.com",
    "Port": 8889,
    "EnableSSL": true,
    "Username": "admin@selfleadedlearning.com",
    "SenderEmail": "admin@selfleadedlearning.com"
  },

  // ExternalApiAuth: resource-server config for the ecosystem-wide central
  // AI chatbot (and any future HumanOk module) once that OAuth2/OIDC
  // authorization server exists. Authority is intentionally blank — fill
  // it in with the central auth server's issuer URL once it's built; no
  // code changes needed, this uses standard OIDC discovery
  // (.well-known/openid-configuration). Until then, Development falls
  // back to a local HS256 signing key so this wiring is testable now —
  // see ExternalApiAuth:DevSigningKey in user-secrets (NEVER stored here,
  // and NEVER honored outside Development regardless of its value).
  "ExternalApiAuth": {
    "Authority": "",
    "Audience": "humanok-hrm",
    "RequireHttpsMetadata": true
  },

  // HRM as OIDC Identity Provider for downstream HumanOk apps (see
  // Endpoints/OidcEndpoints.cs + Program.cs's AddOpenIddict() block, and
  // the handoff doc that specified this — HRM-SSO-Handoff.md). Each
  // registered client (currently just ERP) needs its own redirect URIs
  // here since they're only known per-deployment, not at build time.
  "Sso": {
    "ErpClient": {
      "RedirectUri": "https://localhost:7000/signin-hr",
      "PostLogoutRedirectUri": "https://localhost:7000/"
    }
  },

  // AD/SSO scaffold — the OPPOSITE direction from "Sso" above: here HRM is
  // the one CONSUMING a customer's own Active Directory or SSO/OIDC
  // provider to log their employees straight into HRM with the right
  // permissions (CEO, 2026-09-07: "design for both, prepare structure
  // first — no real customer AD/IdP yet"). Both stay off/empty by default,
  // so this section changes nothing about how anyone signs in today —
  // turning either on for a real customer is a config change (per-customer
  // deployment), never a code change. Which accounts actually use AD or an
  // Sso provider is set per-user on sc_user.AuthProvider (Admin > ผู้ใช้ระบบ).
  "ExternalAuth": {
    "Ldap": {
      // Set true only once Server (and, for a real deployment, Domain) are
      // filled in for that customer's AD — see Services/Auth/LdapAuthService.cs.
      "Enabled": false,
      "Server": "",
      "Port": 389,
      "Domain": "",
      "UseSsl": false
    },
    // One entry per SSO/OIDC identity provider a customer connects — see
    // Services/Auth/SsoProviderConfig.cs. ClientSecret should live in user
    // secrets / an environment variable per deployment, same reasoning as
    // ConnectionStrings:DefaultConnection above, once a real entry exists.
    "Sso": {
      "Providers": []
    }
  },

  // Password policy — the three rules the original JSP system enforced in
  // solar.SecurityBean and this app had stopped enforcing (sc_user's
  // isforcechanged / pwdexpdate / invalidpwcount were written by several
  // screens and read by nobody). See Services/Security/PasswordPolicyOptions.
  //
  // MaxAgeDays is 0 = passwords never expire, i.e. exactly today's behaviour,
  // so nothing changes for the existing accounts until a deployment turns it
  // on. Force-change (isforcechanged) and lockout ARE active with these
  // defaults, because both are per-account states nobody had to opt into.
  "PasswordPolicy": {
    "MaxAgeDays": 0,
    "ExpiryWarningDays": 7,
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15
  },

  // Audit-log archiving (CEO, 8 ก.ย. 2569) — AuditLog was 445 MB of a 912 MB
  // database. Whole months older than KeepDaysInDatabase are written to a
  // compressed file on the file server (with a SHA-256 manifest) and then
  // removed from the table. See Services/Audit/AuditArchiveService.
  //
  // Path set by CEO 8 ก.ย. 2569 to \hrm\audit (root of the drive the app runs
  // on). Point it at a UNC share on the customer's file server per deployment
  // — e.g. \\\\fileserver\\hrm\\audit — the service only needs a writable
  // folder. Setting it back to "" disables archiving entirely: nothing is
  // ever deleted while the path is empty.
  // KeepDaysInDatabase is floored at 90 in code regardless of what is set
  // here, because พ.ร.บ. คอมพิวเตอร์ มาตรา 26 requires that retention.
  "AuditArchive": {
    "Path": "\\hrm\\audit",
    "KeepDaysInDatabase": 90,
    "BatchSize": 5000
  },

  "AllowedHosts": "*"
}
