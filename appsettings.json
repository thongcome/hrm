{
  // ConnectionStrings:DefaultConnection intentionally NOT stored here — it
  // contains a DB password. Local dev: `dotnet user-secrets set
  // "ConnectionStrings:DefaultConnection" "..."` (already set for this
  // project's UserSecretsId). Production/deployment: set the
  // ConnectionStrings__DefaultConnection environment variable (or a proper
  // secret store) — user secrets are Development-only and are NOT read
  // outside that environment.

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Mail.SmtpClient": "Trace"
    }
  },

  "profiles": {
    "IIS Express": {
      "environmentVariables": {
        //    "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_ENVIRONMENT": "Production"
      }
    }
  },

  // SmtpSettings:Password intentionally NOT stored here — see
  // ConnectionStrings comment above for the same reasoning (user secrets
  // locally, SmtpSettings__Password env var in production).
  "SmtpSettings": {
    "Host": "mail.selfleadedlearning.com",
    "Port": 8889,
    "EnableSSL": true,
    "Username": "admin@selfleadedlearning.com",
    "SenderEmail": "admin@selfleadedlearning.com"
  },

  "AllowedHosts": "*"
}
